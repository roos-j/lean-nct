  exact Metric.mem_closedBall.mpr
    ((Metric.mem_ball.mp hyz).le.trans (by linarith))

/-- The volume-packing estimate behind the sharp Euclidean radius comparison. -/
theorem aux_card_le_sharp_packing {d : ℕ} {r s : ℝ}
    (hr : 0 < r) (hrs : r ≤ s)
    (t : Finset (EuclideanSpace ℝ (Fin d)))
    (ht : ∀ c ∈ t, ‖c‖ ≤ s)
    (htsep : ∀ c ∈ t, ∀ e ∈ t, c ≠ e → r ≤ ‖c - e‖) :
    (t.card : ℝ) ≤ (3 * s / r) ^ d := by
  let E := EuclideanSpace ℝ (Fin d)
  let μ : Measure E := Measure.addHaar
  let δ : ℝ := r / 2
  let ρ : ℝ := s + r / 2
  have hδ : 0 < δ := by
    dsimp [δ]
    positivity
  have hρ : 0 < ρ := by
    dsimp [ρ]
    linarith
  set A : Set E := ⋃ c ∈ t, ball c δ with hA
  have D : Set.Pairwise (t : Set E) (Disjoint on fun c ↦ ball c δ) := by
    rintro c hc e he hce
    apply Metric.ball_disjoint_ball
    rw [dist_eq_norm]
    convert htsep c hc e he hce using 1
    all_goals
      dsimp [δ]
      ring
  have A_subset : A ⊆ ball (0 : E) ρ := by
    refine iUnion₂_subset fun c hc ↦ ?_
    apply ball_subset_ball'
    calc
      δ + dist c 0 ≤ δ + s := by
        rw [dist_zero_right]
        exact add_le_add le_rfl (ht c hc)
      _ = ρ := by
        dsimp [δ, ρ]
        ring
  have I :
      (t.card : ℝ≥0∞) * ENNReal.ofReal (δ ^ Module.finrank ℝ E) * μ (ball 0 1) ≤
        ENNReal.ofReal (ρ ^ Module.finrank ℝ E) * μ (ball 0 1) := by
    calc
      (t.card : ℝ≥0∞) * ENNReal.ofReal (δ ^ Module.finrank ℝ E) * μ (ball 0 1) = μ A := by
        rw [hA, measure_biUnion_finset D fun c _ ↦ measurableSet_ball]
        simp only [μ.addHaar_ball_of_pos _ hδ]
        simp only [Finset.sum_const, nsmul_eq_mul, mul_assoc]
      _ ≤ μ (ball (0 : E) ρ) := measure_mono A_subset
      _ = ENNReal.ofReal (ρ ^ Module.finrank ℝ E) * μ (ball 0 1) := by
        simp only [μ.addHaar_ball_of_pos _ hρ]
  have J : (t.card : ℝ≥0∞) * ENNReal.ofReal (δ ^ Module.finrank ℝ E) ≤
      ENNReal.ofReal (ρ ^ Module.finrank ℝ E) :=
    (ENNReal.mul_le_mul_iff_left (measure_ball_pos _ _ zero_lt_one).ne'
      measure_ball_lt_top.ne).1 I
  have K : (t.card : ℝ) ≤ (ρ / δ) ^ Module.finrank ℝ E := by
    have h := ENNReal.toReal_le_of_le_ofReal (pow_nonneg hρ.le _) J
    have hδpow : 0 < δ ^ Module.finrank ℝ E := pow_pos hδ _
    rw [ENNReal.toReal_mul, ENNReal.toReal_natCast,
      ENNReal.toReal_ofReal (pow_nonneg hδ.le _)] at h
    rw [div_pow]
    exact (le_div_iff₀ hδpow).2 h
  have hratio : ρ / δ ≤ 3 * s / r := by
    dsimp [ρ, δ]
    field_simp
    nlinarith
  calc
    (t.card : ℝ) ≤ (ρ / δ) ^ Module.finrank ℝ E := K
    _ ≤ (3 * s / r) ^ Module.finrank ℝ E :=
      pow_le_pow_left₀ (div_nonneg (by dsimp [ρ]; linarith) hδ.le) hratio _
    _ = (3 * s / r) ^ d := by simp [E]

/-- A closed Euclidean ball has a finite `r`-cover with the sharp packing count from the draft. -/
theorem aux_exists_finset_cover_closedBall_card_le {d : ℕ} {r s : ℝ}
    (hr : 0 < r) (hrs : r ≤ s) :
    ∃ t : Finset (EuclideanSpace ℝ (Fin d)),
      ((closedBall (0 : EuclideanSpace ℝ (Fin d)) s : Set _) ⊆
        ⋃ c ∈ t, closedBall c r) ∧
      (t.card : ℝ) ≤ (3 * s / r) ^ d := by
  let E := EuclideanSpace ℝ (Fin d)
  let A : Set E := closedBall 0 s
  let ε : NNReal := r.toNNReal / 2
  have hε : ε ≠ 0 := by
    dsimp [ε]
    exact div_ne_zero (ne_of_gt (Real.toNNReal_pos.mpr hr)) (by norm_num)
  obtain ⟨C, hCA, hCfin, hCcover⟩ :=
    Metric.exists_finite_isCover_of_isCompact hε (isCompact_closedBall (0 : E) s)
  have htwo : 2 * ε = r.toNNReal := by
    dsimp [ε]
    field_simp
  have hpack : Metric.packingNumber r.toNNReal A ≤ C.encard := by
    rw [← htwo]
    exact (Metric.packingNumber_two_mul_le_externalCoveringNumber ε A).trans
      hCcover.externalCoveringNumber_le_encard
  have hpack_lt : Metric.packingNumber r.toNNReal A < ⊤ :=
    hpack.trans_lt hCfin.encard_lt_top
  have hpack_ne : Metric.packingNumber r.toNNReal A ≠ ⊤ := ne_of_lt hpack_lt
  let S : Set E := Metric.maximalSeparatedSet r.toNNReal A
  have hSfin : S.Finite := by
    apply Set.encard_lt_top_iff.mp
    rw [show S = Metric.maximalSeparatedSet r.toNNReal A from rfl,
      Metric.encard_maximalSeparatedSet hpack_ne]
    exact hpack_lt
  refine ⟨hSfin.toFinset, ?_, ?_⟩
  · intro x hx
    obtain ⟨c, hcS, hxc⟩ := Metric.isCover_maximalSeparatedSet hpack_ne hx
    refine Set.mem_iUnion₂.2 ⟨c, hSfin.mem_toFinset.mpr hcS, ?_⟩
    rw [Metric.mem_closedBall]
    simpa only [coe_nndist, Real.coe_toNNReal r hr.le] using
      (NNReal.coe_le_coe.mpr (edist_le_coe.mp hxc))
  · apply aux_card_le_sharp_packing hr hrs
    · intro c hc
      have hcA : c ∈ A := Metric.maximalSeparatedSet_subset (hSfin.mem_toFinset.mp hc)
      simpa [A, Metric.mem_closedBall, dist_zero_right] using hcA
    · intro c hc e he hce
      have hsep : (r.toNNReal : ℝ≥0∞) < edist c e :=
        Metric.isSeparated_maximalSeparatedSet
          (hSfin.mem_toFinset.mp hc) (hSfin.mem_toFinset.mp he) hce
      rw [edist_nndist] at hsep
      have hsepNN : r.toNNReal < nndist c e := ENNReal.coe_lt_coe.mp hsep
      simpa only [coe_nndist, Real.coe_toNNReal r hr.le, dist_eq_norm] using
        le_of_lt (NNReal.coe_lt_coe.mpr hsepNN)

/-- A finite cover of the large ball converts its local supremum into a finite sum of translates
of the small-radius local supremum. -/
theorem aux_wienerEnvelope_le_sum_of_cover {E F : Type*} [NormedAddCommGroup E] [ProperSpace E]
    [NormedAddCommGroup F] {f : E → F} (hf : Continuous f) {r s : ℝ}
    (hr : 0 ≤ r) (hs : 0 ≤ s) (t : Finset E)
    (hcover : ∀ y ∈ closedBall (0 : E) s, ∃ z ∈ t, y ∈ closedBall z r) (x : E) :
    wienerEnvelope f s x ≤ ∑ z ∈ t, wienerEnvelope f r (x + z) := by
  unfold wienerEnvelope
  apply csSup_le ((Metric.nonempty_closedBall.mpr hs).image _)
  rintro _ ⟨y, hy, rfl⟩
  obtain ⟨z, hzt, hyz⟩ := hcover y hy
  calc
    ‖f (x + y)‖ ≤ wienerEnvelope f r (x + z) := by
      unfold wienerEnvelope
      let h : Continuous (fun w : E ↦ ‖f ((x + z) + w)‖) := by fun_prop
      apply le_csSup
      · exact (isCompact_closedBall (0 : E) r).bddAbove_image h.continuousOn
      · refine ⟨y - z, ?_, ?_⟩
        · simpa [Metric.mem_closedBall, dist_eq_norm] using hyz
        · abel_nf
    _ ≤ ∑ z ∈ t, wienerEnvelope f r (x + z) :=
      Finset.single_le_sum (fun w hw ↦ aux_wienerEnvelope_nonneg hf hr _) hzt

/-- Radius-independence of envelope integrability on any proper normed additive group equipped
with a translation-invariant volume. -/
theorem aux_integrable_wienerEnvelope_of_integrable' {E F : Type*} [NormedAddCommGroup E]
    [ProperSpace E] [MeasureSpace E] [BorelSpace E]
    [Measure.IsAddRightInvariant (volume : Measure E)] [NormedAddCommGroup F]
    {f : E → F} (hf : Continuous f) {r s : ℝ} (hr : 0 < r) (hs : 0 ≤ s)
    (hfr : Integrable (wienerEnvelope f r)) :
    Integrable (wienerEnvelope f s) := by
  classical
  obtain ⟨t, ht⟩ := aux_exists_finite_closedBall_cover (E := E) r hr s
  have hsum : Integrable (fun x ↦ ∑ z ∈ t, wienerEnvelope f r (x + z)) := by
    apply integrable_finsetSum
    intro z hz
    exact hfr.comp_add_right z
  refine hsum.mono_nonneg (continuous_wienerEnvelope hf s).aestronglyMeasurable
    (ae_of_all _ fun x ↦ aux_wienerEnvelope_nonneg hf hs x) (ae_of_all _ fun x ↦ ?_)
  exact aux_wienerEnvelope_le_sum_of_cover hf (le_of_lt hr) hs t ht x

/-- The finite-cover radius comparison is valid on every proper finite-dimensional Haar space.
This is the version used when an injective map is straightened to its range. -/
theorem aux_integral_wienerEnvelope_le_card_mul_of_addHaar {E F : Type*}
    [NormedAddCommGroup E] [ProperSpace E] [MeasureSpace E] [BorelSpace E]
    [Measure.IsAddRightInvariant (volume : Measure E)] [NormedAddCommGroup F]
    {f : E → F} (hf : Continuous f) {r s : ℝ} (hr : 0 < r)
    (hs : 0 ≤ s) (hfr : Integrable (wienerEnvelope f r)) (t : Finset E)
    (hcover : ∀ y ∈ closedBall (0 : E) s, ∃ z ∈ t, y ∈ closedBall z r) :
    (∫ x, wienerEnvelope f s x) ≤ (t.card : ℝ) * ∫ x, wienerEnvelope f r x := by
  have hsint : Integrable (wienerEnvelope f s) :=
    aux_integrable_wienerEnvelope_of_integrable' hf hr hs hfr
  have hsum : Integrable (fun x : E => ∑ z ∈ t, wienerEnvelope f r (x + z)) := by
    exact integrable_finsetSum t fun z hz => hfr.comp_add_right z
  calc
    (∫ x, wienerEnvelope f s x) ≤ ∫ x, ∑ z ∈ t, wienerEnvelope f r (x + z) :=
      integral_mono hsint hsum (fun x =>
        aux_wienerEnvelope_le_sum_of_cover hf (le_of_lt hr) hs t hcover x)
    _ = ∑ z ∈ t, ∫ x, wienerEnvelope f r (x + z) :=
      integral_finsetSum t fun z hz => hfr.comp_add_right z
    _ = ∑ _z ∈ t, ∫ x, wienerEnvelope f r x := by
      simp_rw [integral_add_right_eq_self]
    _ = (t.card : ℝ) * ∫ x, wienerEnvelope f r x := by simp

/-- An invertible finite-dimensional linear change of variables has a uniform Wiener-integral
bound.  The constant depends only on the change of coordinates (through its Haar scalar and a
finite cover of its operator-norm ball). -/
theorem aux_exists_wienerEnvelope_comp_continuousLinearEquiv_bound {E F K : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] [ProperSpace E]
    [MeasureSpace E] [BorelSpace E] [Measure.IsAddHaarMeasure (volume : Measure E)]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F] [ProperSpace F]
    [MeasureSpace F] [BorelSpace F] [Measure.IsAddHaarMeasure (volume : Measure F)]
    [NormedAddCommGroup K] (e : E ≃L[ℝ] F) :
    ∃ C : ℝ, 0 < C ∧ ∀ f : F → K, MemW0 f →
      (∫ x, wienerEnvelope (f ∘ e) 1 x) ≤ C * ∫ y, wienerEnvelope f 1 y := by
  classical
  obtain ⟨t, ht⟩ :=
    aux_exists_finite_closedBall_cover (E := F) 1 zero_lt_one ‖(e : E →L[ℝ] F)‖
  let a : ℝ := (Measure.addHaarScalarFactor (Measure.map (e : E → F) volume) volume : ℝ)
  refine ⟨max 1 (a * (t.card : ℝ)),
    lt_of_lt_of_le zero_lt_one (le_max_left _ _), ?_⟩
  intro f hf
  have ha : 0 ≤ a := by
    dsimp [a]
    positivity
  have hrad : Integrable (wienerEnvelope f ‖(e : E →L[ℝ] F)‖) :=
    aux_integrable_wienerEnvelope_of_integrable' hf.1 zero_lt_one (norm_nonneg _) hf.2
  have hrad_bound :
      (∫ y, wienerEnvelope f ‖(e : E →L[ℝ] F)‖ y) ≤
        (t.card : ℝ) * ∫ y, wienerEnvelope f 1 y :=
    aux_integral_wienerEnvelope_le_card_mul_of_addHaar hf.1 zero_lt_one (norm_nonneg _) hf.2 t ht
  have hcomp : Integrable (wienerEnvelope f ‖(e : E →L[ℝ] F)‖ ∘ e) :=
    aux_integrable_comp_continuousLinearEquiv_between hrad e
  have hleft : Integrable (wienerEnvelope (f ∘ e) 1) := by
    refine hcomp.mono_nonneg
      (continuous_wienerEnvelope (hf.1.comp e.continuous) 1).aestronglyMeasurable
      (ae_of_all _ fun x => aux_wienerEnvelope_nonneg (hf.1.comp e.continuous) zero_le_one x)
      (ae_of_all _ fun x => ?_)
    exact aux_wienerEnvelope_comp_continuousLinearMap_le e.toContinuousLinearMap hf.1 x
  have hmap : (∫ x, wienerEnvelope f ‖(e : E →L[ℝ] F)‖ (e x)) =
      a * ∫ y, wienerEnvelope f ‖(e : E →L[ℝ] F)‖ y := by
    simpa [a] using aux_integral_comp_continuousLinearEquiv_eq e
      (continuous_wienerEnvelope hf.1 ‖(e : E →L[ℝ] F)‖)
  have hnon : 0 ≤ ∫ y, wienerEnvelope f 1 y :=
    integral_nonneg fun y => aux_wienerEnvelope_nonneg hf.1 zero_le_one y
  calc
    (∫ x, wienerEnvelope (f ∘ e) 1 x) ≤
        ∫ x, wienerEnvelope f ‖(e : E →L[ℝ] F)‖ (e x) :=
      integral_mono hleft hcomp (fun x =>
        aux_wienerEnvelope_comp_continuousLinearMap_le e.toContinuousLinearMap hf.1 x)
    _ = a * ∫ y, wienerEnvelope f ‖(e : E →L[ℝ] F)‖ y := hmap
    _ ≤ a * ((t.card : ℝ) * ∫ y, wienerEnvelope f 1 y) :=
      mul_le_mul_of_nonneg_left hrad_bound ha
    _ = (a * (t.card : ℝ)) * ∫ y, wienerEnvelope f 1 y := by ring
    _ ≤ max 1 (a * (t.card : ℝ)) * ∫ y, wienerEnvelope f 1 y :=
      mul_le_mul_of_nonneg_right (le_max_right _ _) hnon

/-- Positive-radius local envelopes of a Wiener-space function are themselves in `W₀`. -/
theorem MemW0.aux_mem_wienerEnvelope {E F : Type*} [NormedAddCommGroup E] [ProperSpace E]
    [MeasureSpace E] [BorelSpace E] [Measure.IsAddRightInvariant (volume : Measure E)]
    [NormedAddCommGroup F] {f : E → F} (hf : MemW0 f) {r : ℝ} (hr : 0 ≤ r) :
    MemW0 (wienerEnvelope f r) := by
  have hcont : Continuous (wienerEnvelope f r) := continuous_wienerEnvelope hf.1 r
  refine ⟨hcont, ?_⟩
  have hinter : Integrable (wienerEnvelope f (r + 1)) :=
    aux_integrable_wienerEnvelope_of_integrable' hf.1 zero_lt_one (by linarith) hf.2
  refine hinter.mono_nonneg (continuous_wienerEnvelope hcont 1).aestronglyMeasurable
    (ae_of_all _ fun x ↦ aux_wienerEnvelope_nonneg hcont zero_le_one x)
    (ae_of_all _ fun x ↦ ?_)
  exact aux_wienerEnvelope_wienerEnvelope_le hf.1 hr zero_le_one x

/-- Integrability of the local envelope is independent of its positive radius.  The finite cover
of a compact ball gives the comparison, and translation-invariance of Lebesgue measure makes each
summand integrable. -/
theorem aux_integrable_wienerEnvelope_of_integrable {d : ℕ} {𝕜 : Type*} [NormedAddCommGroup 𝕜]
    {f : EuclideanSpace ℝ (Fin d) → 𝕜} (hf : Continuous f) {r s : ℝ} (hr : 0 < r)
    (hs : 0 ≤ s) (hfr : Integrable (wienerEnvelope f r)) :
    Integrable (wienerEnvelope f s) := by
  classical
  obtain ⟨t, ht⟩ :=
    aux_exists_finite_closedBall_cover (E := EuclideanSpace ℝ (Fin d)) r hr s
  have hsum : Integrable (fun x ↦ ∑ z ∈ t, wienerEnvelope f r (x + z)) := by
    apply integrable_finsetSum
    intro z hz
    exact hfr.comp_add_right z
  refine hsum.mono_nonneg (continuous_wienerEnvelope hf s).aestronglyMeasurable
    (ae_of_all _ fun x ↦ aux_wienerEnvelope_nonneg hf hs x) (ae_of_all _ fun x ↦ ?_)
  exact aux_wienerEnvelope_le_sum_of_cover hf (le_of_lt hr) hs t ht x

/-- In particular, for every $0<r<\infty$, a continuous
$f:\R^d\to \mathbb{K}$ is in $W_0$ if and only if $\|f\|_{W_0,r}<\infty$. -/
theorem integrable_wienerEnvelope_iff {d : ℕ} {𝕜 : Type*} [NormedAddCommGroup 𝕜]
    {f : EuclideanSpace ℝ (Fin d) → 𝕜} (hf : Continuous f) {r s : ℝ} (hr : 0 < r)
    (hs : 0 < s) :
    Integrable (wienerEnvelope f r) ↔ Integrable (wienerEnvelope f s) := by
  constructor
  · exact aux_integrable_wienerEnvelope_of_integrable hf hr (le_of_lt hs)
  · exact aux_integrable_wienerEnvelope_of_integrable hf hs (le_of_lt hr)

/-- The quantitative finite-cover form of radius comparison.  The source's particular sharp
packing count can be recovered after choosing a separated cover; this statement isolates exactly
the analytic part, which only uses the indicated cover. -/
theorem aux_integral_wienerEnvelope_le_card_mul {d : ℕ} {𝕜 : Type*} [NormedAddCommGroup 𝕜]
    {f : EuclideanSpace ℝ (Fin d) → 𝕜} (hf : Continuous f) {r s : ℝ} (hr : 0 < r)
    (hs : 0 ≤ s) (hfr : Integrable (wienerEnvelope f r))
    (t : Finset (EuclideanSpace ℝ (Fin d)))
    (hcover : ∀ y ∈ closedBall (0 : EuclideanSpace ℝ (Fin d)) s,
      ∃ z ∈ t, y ∈ closedBall z r) :
    (∫ x, wienerEnvelope f s x) ≤ (t.card : ℝ) * ∫ x, wienerEnvelope f r x := by
  have hsint : Integrable (wienerEnvelope f s) :=
    aux_integrable_wienerEnvelope_of_integrable hf hr hs hfr
  have hsum : Integrable (fun x : EuclideanSpace ℝ (Fin d) ↦
      ∑ z ∈ t, wienerEnvelope f r (x + z)) := by
    exact integrable_finsetSum t fun z hz ↦ hfr.comp_add_right z
  calc
    (∫ x, wienerEnvelope f s x) ≤ ∫ x, ∑ z ∈ t, wienerEnvelope f r (x + z) :=
      integral_mono hsint hsum (fun x ↦
        aux_wienerEnvelope_le_sum_of_cover hf (le_of_lt hr) hs t hcover x)
    _ = ∑ z ∈ t, ∫ x, wienerEnvelope f r (x + z) :=
      integral_finsetSum t fun z hz ↦ hfr.comp_add_right z
    _ = ∑ _z ∈ t, ∫ x, wienerEnvelope f r x := by
      simp_rw [integral_add_right_eq_self]
    _ = (t.card : ℝ) * ∫ x, wienerEnvelope f r x := by simp

/-- The sharp radius comparison from the draft. -/
theorem aux_integral_wienerEnvelope_le_max_one_three_mul_div_pow_mul {d : ℕ} {𝕜 : Type*}
    [NormedAddCommGroup 𝕜] {f : EuclideanSpace ℝ (Fin d) → 𝕜} (hf : Continuous f)
    {r s : ℝ} (hr : 0 < r) (hs : 0 < s) (hfr : Integrable (wienerEnvelope f r)) :
    (∫ x, wienerEnvelope f s x) ≤
      max 1 ((3 * s / r) ^ d) * ∫ x, wienerEnvelope f r x := by
  have hnon : 0 ≤ ∫ x, wienerEnvelope f r x :=
    integral_nonneg fun x ↦ aux_wienerEnvelope_nonneg hf (le_of_lt hr) x
  by_cases hsr : s ≤ r
  · have hsint : Integrable (wienerEnvelope f s) :=
      aux_integrable_wienerEnvelope_of_integrable hf hr (le_of_lt hs) hfr
    calc
      (∫ x, wienerEnvelope f s x) ≤ ∫ x, wienerEnvelope f r x :=
        integral_mono hsint hfr
          (fun x ↦ aux_wienerEnvelope_mono_radius hf (le_of_lt hs) hsr x)
      _ = 1 * ∫ x, wienerEnvelope f r x := (one_mul _).symm
      _ ≤ max 1 ((3 * s / r) ^ d) * ∫ x, wienerEnvelope f r x :=
        mul_le_mul_of_nonneg_right (le_max_left _ _) hnon
  · have hrs : r ≤ s := le_of_not_ge hsr
    obtain ⟨t, htcover, htcard⟩ := aux_exists_finset_cover_closedBall_card_le hr hrs
    have hcover : ∀ y ∈ closedBall (0 : EuclideanSpace ℝ (Fin d)) s,
        ∃ z ∈ t, y ∈ closedBall z r := by
      intro y hy
      obtain ⟨z, hzt, hyz⟩ := Set.mem_iUnion₂.mp (htcover hy)
      exact ⟨z, hzt, hyz⟩
    calc
      (∫ x, wienerEnvelope f s x) ≤ (t.card : ℝ) * ∫ x, wienerEnvelope f r x :=
        aux_integral_wienerEnvelope_le_card_mul hf hr (le_of_lt hs) hfr t hcover
      _ ≤ (3 * s / r) ^ d * ∫ x, wienerEnvelope f r x :=
        mul_le_mul_of_nonneg_right htcard hnon
      _ ≤ max 1 ((3 * s / r) ^ d) * ∫ x, wienerEnvelope f r x :=
        mul_le_mul_of_nonneg_right (le_max_right _ _) hnon

/-- Constant specified in Proposition \ref{W_0 radius independence}, formalized
by `wienerNorm_le_max_one_three_mul_div_pow_mul`. -/
noncomputable def C_wienerNormRadiusIndependence (d : ℕ) (r s : ℝ) : ℝ :=
  max 1 ((3 * s / r) ^ d)

/-- Let $d\in \N$.
Let $0<r,s<\infty$ and set
\begin{equation}
    C_{\ref{W_0 radius independence},d,r,s}:=\max(1,(3s/r)^d)\, .
\end{equation}

Then for all continuous
$f:\R^d\to \mathbb{K}$ we have
\begin{equation}
    \|f\|_{W_0,s}\le C_{\ref{W_0 radius independence},d,r,s}\|f\|_{W_0,r}\, .
\end{equation}
-/
theorem wienerNorm_le_max_one_three_mul_div_pow_mul {d : ℕ} {𝕜 : Type*}
    [NormedAddCommGroup 𝕜] {f : EuclideanSpace ℝ (Fin d) → 𝕜} (hf : Continuous f)
    {r s : ℝ} (hr : 0 < r) (hs : 0 < s) :
    wienerNorm f s ≤ ENNReal.ofReal (C_wienerNormRadiusIndependence d r s) * wienerNorm f r := by
  let C : ℝ := C_wienerNormRadiusIndependence d r s
  have hCpos : 0 < C := lt_of_lt_of_le zero_lt_one (le_max_left _ _)
  by_cases htop : wienerNorm f r = ∞
  · change wienerNorm f s ≤ ENNReal.ofReal C * wienerNorm f r
    rw [htop]
    rw [ENNReal.mul_top (ENNReal.ofReal_ne_zero_iff.mpr hCpos)]
    exact le_top
  · have hfr : Integrable (wienerEnvelope f r) :=
      (lintegral_ofReal_ne_top_iff_integrable
        (continuous_wienerEnvelope hf r).aestronglyMeasurable
        (ae_of_all _ fun x => aux_wienerEnvelope_nonneg hf (le_of_lt hr) x)).mp (by
          simpa [wienerNorm] using htop)
    have hfs : Integrable (wienerEnvelope f s) :=
      aux_integrable_wienerEnvelope_of_integrable hf hr (le_of_lt hs) hfr
    have hreal := aux_integral_wienerEnvelope_le_max_one_three_mul_div_pow_mul hf hr hs hfr
    have hwr : wienerNorm f r = ENNReal.ofReal (∫ x, wienerEnvelope f r x) := by
      unfold wienerNorm
      symm
      exact ofReal_integral_eq_lintegral_ofReal hfr
        (ae_of_all _ fun x => aux_wienerEnvelope_nonneg hf (le_of_lt hr) x)
    have hws : wienerNorm f s = ENNReal.ofReal (∫ x, wienerEnvelope f s x) := by
      unfold wienerNorm
      symm
      exact ofReal_integral_eq_lintegral_ofReal hfs
        (ae_of_all _ fun x => aux_wienerEnvelope_nonneg hf (le_of_lt hs) x)
    calc
      wienerNorm f s = ENNReal.ofReal (∫ x, wienerEnvelope f s x) := hws
      _ ≤ ENNReal.ofReal (C * ∫ x, wienerEnvelope f r x) :=
          ENNReal.ofReal_le_ofReal (by simpa [C, C_wienerNormRadiusIndependence] using hreal)
      _ = ENNReal.ofReal C * wienerNorm f r := by
        rw [ENNReal.ofReal_mul hCpos.le, ← hwr]

/-- In particular, for every $0<r<\infty$, a continuous
$f:\R^d\to \mathbb{K}$ is in $W_0$ if and only if $\|f\|_{W_0,r}<\infty$. -/
theorem memW0_iff_integrable_wienerEnvelope {d : ℕ} {𝕜 : Type*} [NormedAddCommGroup 𝕜]
    {f : EuclideanSpace ℝ (Fin d) → 𝕜} (hf : Continuous f) {r : ℝ} (hr : 0 < r) :
    MemW0 f ↔ Integrable (wienerEnvelope f r) := by
  simp only [MemW0]
  constructor
  · rintro ⟨-, h⟩
    exact (integrable_wienerEnvelope_iff hf zero_lt_one hr).mp h
  · intro h
    exact ⟨hf, (integrable_wienerEnvelope_iff hf hr zero_lt_one).mp h⟩

/-- The `L¹` part of the Wiener-space embedding. -/
theorem MemW0.aux_integrable {d : ℕ} {𝕜 : Type*} [NormedAddCommGroup 𝕜]
    {f : EuclideanSpace ℝ (Fin d) → 𝕜} (hf : MemW0 f) : Integrable f := by
  refine hf.aux_integrable_envelope.mono hf.aux_continuous.aestronglyMeasurable
    (ae_of_all _ fun x ↦ ?_)
  simpa only [Real.norm_eq_abs,
    abs_of_nonneg (aux_wienerEnvelope_nonneg hf.aux_continuous zero_le_one x)]
    using aux_norm_le_wienerEnvelope hf.aux_continuous zero_le_one x

/-- Consequently, `W₀` continuously embeds into `L¹`. -/
theorem MemW0.aux_memLp_one {d : ℕ} {𝕜 : Type*} [NormedAddCommGroup 𝕜]
    {f : EuclideanSpace ℝ (Fin d) → 𝕜} (hf : MemW0 f) : MemLp f 1 volume :=
  memLp_one_iff_integrable.mpr hf.aux_integrable

/-- The elementary `L¹` estimate from the draft. -/
theorem aux_integral_norm_le_integral_wienerEnvelope {d : ℕ} {𝕜 : Type*} [NormedAddCommGroup 𝕜]
    {f : EuclideanSpace ℝ (Fin d) → 𝕜} (hf : MemW0 f) :
    (∫ x, ‖f x‖) ≤ ∫ x, wienerEnvelope f 1 x := by
  exact integral_mono hf.aux_integrable.norm hf.aux_integrable_envelope
    (fun x ↦ aux_norm_le_wienerEnvelope hf.aux_continuous zero_le_one x)

/-- A pointwise value is controlled by the Wiener integral times the volume of the unit ball.
This is the geometric core of the `L∞` embedding. -/
theorem aux_norm_mul_unitClosedBallVolume_le_integral_wienerEnvelope {d : ℕ} {𝕜 : Type*}
    [NormedAddCommGroup 𝕜] {f : EuclideanSpace ℝ (Fin d) → 𝕜} (hf : MemW0 f)
    (x : EuclideanSpace ℝ (Fin d)) :
    ‖f x‖ * volume.real (closedBall (0 : EuclideanSpace ℝ (Fin d)) 1) ≤
      ∫ y, wienerEnvelope f 1 y := by
  let E := EuclideanSpace ℝ (Fin d)
  let s : Set E := closedBall x 1
  have hs : MeasurableSet s := measurableSet_closedBall
  have hs_fin : volume s ≠ ∞ := measure_closedBall_lt_top.ne
  have hbound : ∀ y ∈ s, ‖f x‖ ≤ wienerEnvelope f 1 y := by
    intro y hy
    apply aux_norm_le_wienerEnvelope_of_mem_closedBall hf.aux_continuous
    simpa [s, Metric.mem_closedBall, dist_comm] using hy
  have hset : ‖f x‖ * volume.real s ≤ ∫ y in s, wienerEnvelope f 1 y :=
    setIntegral_ge_of_const_le_real hs hs_fin hbound hf.aux_integrable_envelope.integrableOn
  calc
    ‖f x‖ * volume.real (closedBall (0 : E) 1) = ‖f x‖ * volume.real s := by
      rw [show volume.real s = volume.real (closedBall (0 : E) 1) by
        simpa [s] using MeasureTheory.Measure.addHaar_real_closedBall_center volume x 1]
    _ ≤ ∫ y in s, wienerEnvelope f 1 y := hset
    _ ≤ ∫ y, wienerEnvelope f 1 y :=
      setIntegral_le_integral hf.aux_integrable_envelope
        (ae_of_all _ fun y ↦ aux_wienerEnvelope_nonneg hf.aux_continuous zero_le_one y)

/-- The unit-ball volume is strictly positive. -/
theorem aux_unitClosedBallVolume_pos {d : ℕ} :
    0 < volume.real (closedBall (0 : EuclideanSpace ℝ (Fin d)) 1) := by
  exact ENNReal.toReal_pos (measure_closedBall_pos volume 0 zero_lt_one).ne'
    measure_closedBall_lt_top.ne

/-- Mathlib's Euclidean-ball formula identifies the unit-ball constant with the gamma-function
constant used in the draft (for positive dimension). -/
theorem aux_unitClosedBallVolume_eq_gamma {d : ℕ} (hd : 0 < d) :
    volume.real (closedBall (0 : EuclideanSpace ℝ (Fin d)) 1) =
      (Real.sqrt Real.pi) ^ d / Real.Gamma ((d : ℝ) / 2 + 1) := by
  let : Nonempty (Fin d) := Fin.pos_iff_nonempty.mp hd
  change (volume (closedBall (0 : EuclideanSpace ℝ (Fin d)) 1)).toReal = _
  rw [EuclideanSpace.volume_closedBall]
  simp only [ENNReal.ofReal_one, Fintype.card_fin, one_pow, one_mul,
    ENNReal.toReal_ofReal_eq_iff]
  positivity

/-- The `L∞` estimate, stated with the (mathlib) Lebesgue volume of the Euclidean unit ball.
For positive dimensions this volume is the gamma-function constant displayed in the draft. -/
theorem aux_norm_le_integral_wienerEnvelope_div_unitClosedBallVolume {d : ℕ} {𝕜 : Type*}
    [NormedAddCommGroup 𝕜] {f : EuclideanSpace ℝ (Fin d) → 𝕜} (hf : MemW0 f)
    (x : EuclideanSpace ℝ (Fin d)) :
    ‖f x‖ ≤ (∫ y, wienerEnvelope f 1 y) /
      volume.real (closedBall (0 : EuclideanSpace ℝ (Fin d)) 1) := by
  rw [le_div_iff₀ (aux_unitClosedBallVolume_pos (d := d))]
  exact aux_norm_mul_unitClosedBallVolume_le_integral_wienerEnvelope hf x

/-- Consequently, `W₀` continuously embeds into `L∞`. -/
theorem MemW0.aux_memLp_top {d : ℕ} {𝕜 : Type*} [NormedAddCommGroup 𝕜]
    {f : EuclideanSpace ℝ (Fin d) → 𝕜} (hf : MemW0 f) : MemLp f ∞ volume := by
  apply memLp_top_of_bound hf.aux_continuous.aestronglyMeasurable
    ((∫ y, wienerEnvelope f 1 y) /
      volume.real (closedBall (0 : EuclideanSpace ℝ (Fin d)) 1))
  exact ae_of_all _ fun x ↦ aux_norm_le_integral_wienerEnvelope_div_unitClosedBallVolume hf x

/-- If $f\in W_0(d)$ and $1\le p\le \infty$, then $f\in L^p(\R^d)$. -/
theorem MemW0.memLp {d : ℕ} {𝕜 : Type*} [NormedAddCommGroup 𝕜]
    {f : EuclideanSpace ℝ (Fin d) → 𝕜} (hf : MemW0 f) {p : ℝ≥0∞} (hp : 1 ≤ p) :
    MemLp f p volume := by
  rcases eq_or_ne p ∞ with rfl | hp_top
  · exact hf.aux_memLp_top
  have hp_zero : p ≠ 0 := by
    intro hp_zero
    rw [hp_zero] at hp
    norm_num at hp
  apply (integrable_norm_rpow_iff hf.aux_continuous.aestronglyMeasurable hp_zero hp_top).mp
  let C : ℝ := max 1 ((∫ y, wienerEnvelope f 1 y) /
    volume.real (closedBall (0 : EuclideanSpace ℝ (Fin d)) 1))
  have hC : ∀ x, ‖f x‖ ≤ C := by
    intro x
    exact (aux_norm_le_integral_wienerEnvelope_div_unitClosedBallVolume hf x).trans
      (le_max_right _ _)
  have hp_real : 1 ≤ p.toReal := by
    simpa using ENNReal.toReal_mono hp_top hp
  have hp_sub : 0 ≤ p.toReal - 1 := sub_nonneg.mpr hp_real
  refine (hf.aux_integrable.norm.const_mul (C ^ (p.toReal - 1))).mono' ?_ ?_
  · exact ((Real.continuous_rpow_const ENNReal.toReal_nonneg).comp hf.aux_continuous.norm)
      |>.aestronglyMeasurable
  · filter_upwards [] with x
    rw [Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _)]
    calc
      ‖f x‖ ^ p.toReal = ‖f x‖ ^ (p.toReal - 1) * ‖f x‖ := by
        calc
          ‖f x‖ ^ p.toReal = ‖f x‖ ^ ((p.toReal - 1) + 1) := by
            congr 1
            linarith
          _ = ‖f x‖ ^ (p.toReal - 1) * ‖f x‖ ^ 1 :=
            Real.rpow_add_of_nonneg (norm_nonneg _) hp_sub zero_le_one
          _ = ‖f x‖ ^ (p.toReal - 1) * ‖f x‖ := by simp
      _ ≤ C ^ (p.toReal - 1) * ‖f x‖ :=
        mul_le_mul_of_nonneg_right (Real.rpow_le_rpow (norm_nonneg _) (hC x) hp_sub)
          (norm_nonneg _)

/-- An `L¹` estimate in the extended seminorm convention. -/
theorem aux_eLpNorm_one_le_of_integral_norm_le
    {E 𝕜 : Type*} [MeasurableSpace E] [NormedAddCommGroup 𝕜] {μ : Measure E}
    {f : E → 𝕜} (hf : Integrable f μ) {I : ℝ} (hI : (∫ x, ‖f x‖ ∂μ) ≤ I) :
    eLpNorm f 1 μ ≤ ENNReal.ofReal I := by
  rw [eLpNorm_one_eq_lintegral_enorm]
  have htop : (∫⁻ x, ‖f x‖ₑ ∂μ) ≠ ∞ := by
    simpa only [eLpNorm_one_eq_lintegral_enorm] using
      (memLp_one_iff_integrable.mpr hf).eLpNorm_ne_top
  rw [← ENNReal.ofReal_toReal htop, ← integral_norm_eq_lintegral_enorm hf.1]
  exact ENNReal.ofReal_le_ofReal hI

/-- A pointwise norm bound is an extended `L∞` estimate. -/
theorem aux_eLpNorm_top_le_of_bound
    {E 𝕜 : Type*} [MeasurableSpace E] [NormedAddCommGroup 𝕜] {μ : Measure E}
    {f : E → 𝕜} {B : ℝ} (hB : ∀ᵐ x ∂μ, ‖f x‖ ≤ B) :
    eLpNorm f ∞ μ ≤ ENNReal.ofReal B := by
  rw [eLpNorm_exponent_top]
  exact eLpNormEssSup_le_of_ae_bound hB

/-- The elementary interpolation estimate between `L¹` and `L∞`. -/
theorem aux_eLpNorm_interpolation_one_top_of_one_lt
    {E 𝕜 : Type*} [MeasurableSpace E] [NormedAddCommGroup 𝕜] {μ : Measure E}
    {f : E → 𝕜} (hf : AEStronglyMeasurable f μ) {q : ℝ} (hq : 1 < q) :
    eLpNorm f (ENNReal.ofReal q) μ ≤
      (eLpNorm f 1 μ) ^ q⁻¹ * (eLpNorm f ∞ μ) ^ (1 - q⁻¹) := by
  let a : E → ℝ := fun x ↦ ‖f x‖
  let b : E → ℝ := fun x ↦ ‖f x‖ ^ (q - 1)
  have hq0 : 0 < q := zero_lt_one.trans hq
  have hqsub : 0 < q - 1 := sub_pos.mpr hq
  have ha : AEStronglyMeasurable a μ := hf.norm
  have hmul :
      eLpNorm (fun x ↦ a x * b x) 1 μ ≤
        (1 : ℝ≥0∞) * eLpNorm a 1 μ * eLpNorm b ∞ μ := by
    apply eLpNorm_le_eLpNorm_mul_eLpNorm_top 1 ha b (· * ·) 1
    filter_upwards with x
    simp
  have hab : (fun x ↦ a x * b x) = fun x ↦ ‖f x‖ ^ q := by
    funext x
    dsimp [a, b]
    by_cases hx : ‖f x‖ = 0
    · simp [hx, Real.zero_rpow hq0.ne']
    · have hfx : f x ≠ 0 := by
        intro hfx
        apply hx
        simp [hfx]
      have hpos : 0 < (‖f x‖ : ℝ) := norm_pos_iff.mpr hfx
      calc
        ‖f x‖ * ‖f x‖ ^ (q - 1) = ‖f x‖ ^ (1 : ℝ) * ‖f x‖ ^ (q - 1) := by
          rw [Real.rpow_one]
        _ = ‖f x‖ ^ ((1 : ℝ) + (q - 1)) :=
          (@Real.rpow_add ‖f x‖ hpos 1 (q - 1)).symm
        _ = ‖f x‖ ^ q := by
          congr 1
          ring
  have hpow : eLpNorm f (ENNReal.ofReal q) μ ^ q ≤
      eLpNorm f 1 μ * eLpNorm f ∞ μ ^ (q - 1) := by
    have hqsub0 : ENNReal.ofReal (q - 1) ≠ 0 :=
      ne_of_gt (ENNReal.ofReal_pos.mpr hqsub)
    calc
      eLpNorm f (ENNReal.ofReal q) μ ^ q =
          eLpNorm (fun x ↦ ‖f x‖ ^ q) 1 μ := by
        symm
        simpa using (eLpNorm_norm_rpow (p := (1 : ℝ≥0∞)) f hq0)
      _ = eLpNorm (fun x ↦ a x * b x) 1 μ := by rw [hab]
      _ ≤ (1 : ℝ≥0∞) * eLpNorm a 1 μ * eLpNorm b ∞ μ := hmul
      _ = eLpNorm f 1 μ * eLpNorm f ∞ μ ^ (q - 1) := by
        rw [show a = fun x ↦ ‖f x‖ by rfl, eLpNorm_norm]
        rw [show b = fun x ↦ ‖f x‖ ^ (q - 1) by rfl,
          eLpNorm_norm_rpow f hqsub]
        rw [ENNReal.top_mul hqsub0, eLpNorm_exponent_top]
        simp
  have hpow' := ENNReal.rpow_le_rpow hpow (inv_nonneg.mpr hq0.le)
  rw [← ENNReal.rpow_mul, mul_inv_cancel₀ hq0.ne', ENNReal.rpow_one] at hpow'
  rw [ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr hq0.le), ← ENNReal.rpow_mul] at hpow'
  convert hpow' using 1
  congr 3
  field_simp

/-- Quantitative `L¹`--`L∞` interpolation, including the endpoint `q = 1`. -/
theorem aux_eLpNorm_interpolation_one_top_of_one_le
    {E 𝕜 : Type*} [MeasurableSpace E] [NormedAddCommGroup 𝕜] {μ : Measure E}
    {f : E → 𝕜} (hf : AEStronglyMeasurable f μ) {q : ℝ} (hq : 1 ≤ q) :
    eLpNorm f (ENNReal.ofReal q) μ ≤
      (eLpNorm f 1 μ) ^ q⁻¹ * (eLpNorm f ∞ μ) ^ (1 - q⁻¹) := by
  rcases hq.eq_or_lt with rfl | hq
  · norm_num
  exact aux_eLpNorm_interpolation_one_top_of_one_lt hf hq

/-- Substituting explicit `L¹` and `L∞` bounds into interpolation. -/
theorem aux_eLpNorm_le_of_l1_linf_bounds
    {E 𝕜 : Type*} [MeasurableSpace E] [NormedAddCommGroup 𝕜] {μ : Measure E}
    {f : E → 𝕜} (hf : AEStronglyMeasurable f μ) {q : ℝ} (hq : 1 ≤ q)
    {A B : ℝ≥0∞} (hA : eLpNorm f 1 μ ≤ A) (hB : eLpNorm f ∞ μ ≤ B) :
    eLpNorm f (ENNReal.ofReal q) μ ≤ A ^ q⁻¹ * B ^ (1 - q⁻¹) := by
  have hq0 : 0 < q := zero_lt_one.trans_le hq
  have hqinv : 0 ≤ q⁻¹ := inv_nonneg.mpr hq0.le
  have hqcomp : 0 ≤ 1 - q⁻¹ := by
    rw [sub_nonneg]
    exact inv_le_one_of_one_le₀ hq
  calc
    eLpNorm f (ENNReal.ofReal q) μ ≤
        (eLpNorm f 1 μ) ^ q⁻¹ * (eLpNorm f ∞ μ) ^ (1 - q⁻¹) :=
      aux_eLpNorm_interpolation_one_top_of_one_le hf hq
    _ ≤ A ^ q⁻¹ * B ^ (1 - q⁻¹) :=
      mul_le_mul (ENNReal.rpow_le_rpow hA hqinv) (ENNReal.rpow_le_rpow hB hqcomp)
        bot_le bot_le

/-- The real-valued form of the preceding estimate. -/
theorem aux_eLpNorm_toReal_le_of_l1_linf_bounds
    {E 𝕜 : Type*} [MeasurableSpace E] [NormedAddCommGroup 𝕜] {μ : Measure E}
    {f : E → 𝕜} (hf : AEStronglyMeasurable f μ) {q : ℝ} (hq : 1 ≤ q)
    {A B : ℝ} (hA0 : 0 ≤ A) (hB0 : 0 ≤ B)
    (hA : eLpNorm f 1 μ ≤ ENNReal.ofReal A)
    (hB : eLpNorm f ∞ μ ≤ ENNReal.ofReal B) :
    (eLpNorm f (ENNReal.ofReal q) μ).toReal ≤ A ^ q⁻¹ * B ^ (1 - q⁻¹) := by
  have hq0 : 0 < q := zero_lt_one.trans_le hq
  have hqinv : 0 ≤ q⁻¹ := inv_nonneg.mpr hq0.le
  have hqcomp : 0 ≤ 1 - q⁻¹ := by
    rw [sub_nonneg]
    exact inv_le_one_of_one_le₀ hq
  have hbound := aux_eLpNorm_le_of_l1_linf_bounds hf hq hA hB
  have htop : (ENNReal.ofReal A) ^ q⁻¹ * (ENNReal.ofReal B) ^ (1 - q⁻¹) ≠ ∞ :=
    ENNReal.mul_ne_top
      (ENNReal.rpow_ne_top_of_nonneg hqinv ENNReal.ofReal_ne_top)
      (ENNReal.rpow_ne_top_of_nonneg hqcomp ENNReal.ofReal_ne_top)
  have hreal := ENNReal.toReal_mono htop hbound
  simpa only [ENNReal.toReal_mul, ← ENNReal.toReal_rpow,
    ENNReal.toReal_ofReal hA0, ENNReal.toReal_ofReal hB0] using hreal

/-- Algebraic normalization of the interpolation constant to the form in the source draft. -/
theorem aux_rpow_interpolation_constant {I V q : ℝ} (hI : 0 ≤ I) (hV : 0 < V)
    (hq : 1 ≤ q) :
    I ^ q⁻¹ * (I / V) ^ (1 - q⁻¹) = V ^ (q⁻¹ - 1) * I := by
  have hq0 : 0 < q := zero_lt_one.trans_le hq
  have hqinv : 0 < q⁻¹ := inv_pos.mpr hq0
  by_cases hI0 : I = 0
  · simp [hI0, Real.zero_rpow hqinv.ne']
  · have hIpos : 0 < I := lt_of_le_of_ne hI (Ne.symm hI0)
    rw [Real.div_rpow hI hV.le]
    calc
      I ^ q⁻¹ * (I ^ (1 - q⁻¹) / V ^ (1 - q⁻¹)) =
          (I ^ q⁻¹ * I ^ (1 - q⁻¹)) / V ^ (1 - q⁻¹) := by ring
      _ = I ^ (q⁻¹ + (1 - q⁻¹)) / V ^ (1 - q⁻¹) := by
        rw [← Real.rpow_add hIpos]
      _ = I / V ^ (1 - q⁻¹) := by
        rw [show q⁻¹ + (1 - q⁻¹) = 1 by ring, Real.rpow_one]
      _ = V ^ (-(1 - q⁻¹)) * I := by
        rw [Real.rpow_neg hV.le]
        simp only [div_eq_mul_inv]
        ac_rfl
      _ = V ^ (q⁻¹ - 1) * I := by
        congr 2
        ring

/-- The source-form interpolation estimate after inserting an `L¹` bound `I` and the
pointwise bound `I / V`. -/
theorem aux_eLpNorm_toReal_le_interpolation_constant
    {E 𝕜 : Type*} [MeasurableSpace E] [NormedAddCommGroup 𝕜] {μ : Measure E}
    {f : E → 𝕜} (hf : AEStronglyMeasurable f μ) {q I V : ℝ} (hq : 1 ≤ q)
    (hI : 0 ≤ I) (hV : 0 < V) (hL1 : eLpNorm f 1 μ ≤ ENNReal.ofReal I)
    (hLinf : eLpNorm f ∞ μ ≤ ENNReal.ofReal (I / V)) :
    (eLpNorm f (ENNReal.ofReal q) μ).toReal ≤ V ^ (q⁻¹ - 1) * I := by
  calc
    (eLpNorm f (ENNReal.ofReal q) μ).toReal ≤
        I ^ q⁻¹ * (I / V) ^ (1 - q⁻¹) :=
      aux_eLpNorm_toReal_le_of_l1_linf_bounds hf hq hI (div_nonneg hI hV.le) hL1 hLinf
    _ = V ^ (q⁻¹ - 1) * I := aux_rpow_interpolation_constant hI hV hq

/-- The quantitative `L¹` endpoint in the Wiener-space estimate. -/
theorem MemW0.aux_eLpNorm_one_le_wienerEnvelope {d : ℕ} {𝕜 : Type*} [NormedAddCommGroup 𝕜]
    {f : EuclideanSpace ℝ (Fin d) → 𝕜} (hf : MemW0 f) :
    eLpNorm f 1 volume ≤ ENNReal.ofReal (∫ x, wienerEnvelope f 1 x) :=
  aux_eLpNorm_one_le_of_integral_norm_le hf.aux_integrable
    (aux_integral_norm_le_integral_wienerEnvelope hf)

/-- The quantitative `L∞` endpoint in the Wiener-space estimate. -/
theorem MemW0.aux_eLpNorm_top_le_wienerEnvelope {d : ℕ} {𝕜 : Type*} [NormedAddCommGroup 𝕜]
    {f : EuclideanSpace ℝ (Fin d) → 𝕜} (hf : MemW0 f) :
    eLpNorm f ∞ volume ≤ ENNReal.ofReal ((∫ x, wienerEnvelope f 1 x) /
      volume.real (closedBall (0 : EuclideanSpace ℝ (Fin d)) 1)) :=
  aux_eLpNorm_top_le_of_bound (ae_of_all _ fun x ↦
    aux_norm_le_integral_wienerEnvelope_div_unitClosedBallVolume hf x)

/-- If $f\in W_0(d)$ and $1\le p\le \infty$, then
\begin{equation}
\|f\|_p\le C_{\ref{P:lp-embedding},d}^{\frac 1p -1}\|f\|_{W_0}    \, .
\end{equation} -/
theorem MemW0.eLpNorm_toReal_le_wienerEnvelope {d : ℕ} {𝕜 : Type*}
    [NormedAddCommGroup 𝕜] {f : EuclideanSpace ℝ (Fin d) → 𝕜} (hf : MemW0 f)
    {q : ℝ} (hq : 1 ≤ q) :
    (eLpNorm f (ENNReal.ofReal q) volume).toReal ≤
      volume.real (closedBall (0 : EuclideanSpace ℝ (Fin d)) 1) ^ (q⁻¹ - 1) *
        ∫ x, wienerEnvelope f 1 x := by
  apply aux_eLpNorm_toReal_le_interpolation_constant hf.aux_continuous.aestronglyMeasurable hq
  · exact integral_nonneg fun x ↦ aux_wienerEnvelope_nonneg hf.aux_continuous zero_le_one x
  · exact aux_unitClosedBallVolume_pos
  · exact hf.aux_eLpNorm_one_le_wienerEnvelope
  · exact hf.aux_eLpNorm_top_le_wienerEnvelope

/-- The preceding estimate with the unit-ball volume written in the gamma-function form used
in the draft. -/
theorem MemW0.aux_eLpNorm_toReal_le_wienerEnvelope_gamma {d : ℕ} {𝕜 : Type*}
    [NormedAddCommGroup 𝕜] {f : EuclideanSpace ℝ (Fin d) → 𝕜} (hf : MemW0 f)
    {q : ℝ} (hq : 1 ≤ q) (hd : 0 < d) :
    (eLpNorm f (ENNReal.ofReal q) volume).toReal ≤
      ((Real.sqrt Real.pi) ^ d / Real.Gamma ((d : ℝ) / 2 + 1)) ^ (q⁻¹ - 1) *
        ∫ x, wienerEnvelope f 1 x := by
  rw [← aux_unitClosedBallVolume_eq_gamma hd]
  exact hf.eLpNorm_toReal_le_wienerEnvelope hq

/-- An integrable nonnegative continuous function on a Euclidean product has integrable
coordinate slices when its unit-ball Wiener envelope is integrable.  The proof uses Fubini on
the envelope and then moves to a nearby good slice; this avoids the unjustified
supremum-to-average step in the draft. -/
theorem aux_integrable_slice_wienerEnvelope {m l : ℕ}
    {G : EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l) → ℝ}
    (hG : Continuous G) (hGnonneg : ∀ q, 0 ≤ G q)
    (hK : Integrable (wienerEnvelope G 1)) (u : EuclideanSpace ℝ (Fin m)) :
    Integrable (fun v ↦ G (u, v)) := by
  have hgood_ae :
      ∀ᵐ u' ∂(volume : Measure (EuclideanSpace ℝ (Fin m))),
        Integrable (fun v ↦ wienerEnvelope G 1 (u', v)) := by
    exact hK.prod_right_ae
  obtain ⟨u', hu', hu'good⟩ := Measure.exists_mem_of_measure_ne_zero_of_ae
    (s := ball u 1)
    ((measure_ball_pos (volume : Measure (EuclideanSpace ℝ (Fin m))) u zero_lt_one).ne')
    (ae_restrict_of_ae hgood_ae)
  refine hu'good.mono_nonneg ?_ (ae_of_all _ fun v ↦ hGnonneg (u, v))
    (ae_of_all _ fun v ↦ ?_)
  · fun_prop
  · have hmem : (u, v) ∈ closedBall (u', v) 1 := by
      apply Metric.mem_closedBall.mpr
      simpa only [dist_prod_same_right] using
        (le_of_lt (by simpa [dist_comm] using (Metric.mem_ball.mp hu')))
    simpa [Real.norm_eq_abs, abs_of_nonneg (hGnonneg (u, v))] using
      (aux_norm_le_wienerEnvelope_of_mem_closedBall hG hmem)

/-- Translation preserves integrability for the product Lebesgue measure.  The product type
does not expose the additive Haar invariance instance directly, so we obtain it from the two
coordinate translations. -/
theorem Integrable.aux_comp_add_right_prod {m l : ℕ} {𝕜 : Type*} [NormedAddCommGroup 𝕜]
    {f : EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l) → 𝕜}
    (hf : Integrable f) (z : EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l)) :
    Integrable (fun x ↦ f (x + z)) := by
  rw [Measure.volume_eq_prod] at hf ⊢
  have htrans : MeasurePreserving (fun x : EuclideanSpace ℝ (Fin m) ×
      EuclideanSpace ℝ (Fin l) ↦ x + z) (volume.prod volume) (volume.prod volume) := by
    convert MeasurePreserving.prod
      (measurePreserving_add_right (volume : Measure (EuclideanSpace ℝ (Fin m))) z.1)
      (measurePreserving_add_right (volume : Measure (EuclideanSpace ℝ (Fin l))) z.2) using 1
    ext x <;> rfl
  simpa only [Function.comp_def] using htrans.integrable_comp_of_integrable hf

/-- Radius-independence of envelope integrability for a product of Euclidean spaces. -/
theorem aux_integrable_wienerEnvelope_prod_of_integrable {m l : ℕ} {𝕜 : Type*}
    [NormedAddCommGroup 𝕜]
    {f : EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l) → 𝕜}
    (hf : Continuous f) {r s : ℝ} (hr : 0 < r) (hs : 0 ≤ s)
    (hfr : Integrable (wienerEnvelope f r)) :
    Integrable (wienerEnvelope f s) := by
  classical
  obtain ⟨t, ht⟩ :=
    aux_exists_finite_closedBall_cover
      (E := EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l)) r hr s
  have hsum : Integrable (fun x ↦ ∑ z ∈ t, wienerEnvelope f r (x + z)) := by
    apply integrable_finsetSum
    intro z hz
    exact Integrable.aux_comp_add_right_prod hfr z
  refine hsum.mono_nonneg (continuous_wienerEnvelope hf s).aestronglyMeasurable
    (ae_of_all _ fun x ↦ aux_wienerEnvelope_nonneg hf hs x) (ae_of_all _ fun x ↦ ?_)
  exact aux_wienerEnvelope_le_sum_of_cover hf (le_of_lt hr) hs t ht x

/-- Positive-radius local envelopes of a Wiener-space function on a Euclidean product are again
in `W₀`. -/
theorem MemW0.aux_mem_wienerEnvelope_prod {m l : ℕ} {𝕜 : Type*} [NormedAddCommGroup 𝕜]
    {f : EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l) → 𝕜}
    (hf : MemW0 f) {r : ℝ} (hr : 0 ≤ r) :
    MemW0 (wienerEnvelope f r) := by
  have hcont : Continuous (wienerEnvelope f r) := continuous_wienerEnvelope hf.1 r
  refine ⟨hcont, ?_⟩
  have hinter : Integrable (wienerEnvelope f (r + 1)) :=
    aux_integrable_wienerEnvelope_prod_of_integrable hf.1 zero_lt_one (by linarith) hf.2
  refine hinter.mono_nonneg (continuous_wienerEnvelope hcont 1).aestronglyMeasurable
    (ae_of_all _ fun x ↦ aux_wienerEnvelope_nonneg hcont zero_le_one x)
    (ae_of_all _ fun x ↦ ?_)
  exact aux_wienerEnvelope_wienerEnvelope_le hf.1 hr zero_le_one x

/-- The `L¹` consequence of `MemW0` on a Euclidean product. -/
theorem MemW0.aux_integrable_prod {m l : ℕ} {𝕜 : Type*} [NormedAddCommGroup 𝕜]
    {f : EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l) → 𝕜}
    (hf : MemW0 f) : Integrable f := by
  refine hf.2.mono hf.1.aestronglyMeasurable (ae_of_all _ fun x ↦ ?_)
  simpa only [Real.norm_eq_abs, abs_of_nonneg (aux_wienerEnvelope_nonneg hf.1 zero_le_one x)]
    using aux_norm_le_wienerEnvelope hf.1 zero_le_one x

/-- Restricting a Wiener-space function on a Euclidean product to any coordinate fibre again
gives a Wiener-space function. -/
theorem MemW0.aux_memW0_slice {m l : ℕ} {𝕜 : Type*} [NormedAddCommGroup 𝕜]
    {f : EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l) → 𝕜}
    (hf : MemW0 f) (u : EuclideanSpace ℝ (Fin m)) :
    MemW0 (fun v ↦ f (u, v)) := by
  have hgood_ae :
      ∀ᵐ u' ∂(volume : Measure (EuclideanSpace ℝ (Fin m))),
        Integrable (fun v ↦ wienerEnvelope f 1 (u', v)) := by
    exact hf.2.prod_right_ae
  obtain ⟨u', hu', hu'good⟩ := Measure.exists_mem_of_measure_ne_zero_of_ae
    (s := ball u 1)
    ((measure_ball_pos (volume : Measure (EuclideanSpace ℝ (Fin m))) u zero_lt_one).ne')
    (ae_restrict_of_ae hgood_ae)
  have hslice : Continuous (fun v ↦ f (u, v)) :=
    hf.1.comp (continuous_const.prodMk continuous_id)
  refine ⟨hslice, hu'good.mono_nonneg
    (continuous_wienerEnvelope hslice 1).aestronglyMeasurable
    (ae_of_all _ fun v ↦ aux_wienerEnvelope_nonneg hslice zero_le_one v)
    (ae_of_all _ fun v ↦ ?_)⟩
  unfold wienerEnvelope
  apply csSup_le ((Metric.nonempty_closedBall.mpr zero_le_one).image _)
  rintro _ ⟨z, hz, rfl⟩
  apply aux_norm_le_wienerEnvelope_of_mem_closedBall hf.1
  apply Metric.mem_closedBall.mpr
  rw [Prod.dist_eq]
  apply max_le
  · exact le_of_lt (by simpa [dist_comm] using (Metric.mem_ball.mp hu'))
  · simpa [Metric.mem_closedBall, dist_eq_norm] using hz

/-- The coordinate-slice argument works on arbitrary finite-dimensional real Haar spaces as
well.  This form is used for orthogonal range decompositions of an injective map. -/
theorem MemW0.aux_memW0_slice_of_addHaar {E F K : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] [ProperSpace E]
    [MeasureSpace E] [BorelSpace E] [SFinite (volume : Measure E)]
    [Measure.IsAddHaarMeasure (volume : Measure E)]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F] [ProperSpace F]
    [MeasureSpace F] [BorelSpace F] [SFinite (volume : Measure F)]
    [Measure.IsAddHaarMeasure (volume : Measure F)]
    [NormedAddCommGroup K] {f : E × F → K} (hf : MemW0 f) (u : E) :
    MemW0 (fun v ↦ f (u, v)) := by
  have hgood_ae :
      ∀ᵐ u' ∂(volume : Measure E),
        Integrable (fun v ↦ wienerEnvelope f 1 (u', v)) := by
    exact hf.2.prod_right_ae
  obtain ⟨u', hu', hu'good⟩ := Measure.exists_mem_of_measure_ne_zero_of_ae
    (s := ball u 1) ((measure_ball_pos (volume : Measure E) u zero_lt_one).ne')
    (ae_restrict_of_ae hgood_ae)
  have hslice : Continuous (fun v ↦ f (u, v)) :=
    hf.1.comp (continuous_const.prodMk continuous_id)
  refine ⟨hslice, hu'good.mono_nonneg
    (continuous_wienerEnvelope hslice 1).aestronglyMeasurable
    (ae_of_all _ fun v ↦ aux_wienerEnvelope_nonneg hslice zero_le_one v)
    (ae_of_all _ fun v ↦ ?_)⟩
  unfold wienerEnvelope
  apply csSup_le ((Metric.nonempty_closedBall.mpr zero_le_one).image _)
  rintro _ ⟨z, hz, rfl⟩
  apply aux_norm_le_wienerEnvelope_of_mem_closedBall hf.1
  apply Metric.mem_closedBall.mpr
  rw [Prod.dist_eq]
  apply max_le
  · exact le_of_lt (by simpa [dist_comm] using (Metric.mem_ball.mp hu'))
  · simpa [Metric.mem_closedBall, dist_eq_norm] using hz

/-- The symmetric version of `MemW0.aux_memW0_slice_of_addHaar`. -/
theorem MemW0.aux_memW0_slice_snd_of_addHaar {E F K : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] [ProperSpace E]
    [MeasureSpace E] [BorelSpace E] [SFinite (volume : Measure E)]
    [Measure.IsAddHaarMeasure (volume : Measure E)]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F] [ProperSpace F]
    [MeasureSpace F] [BorelSpace F] [SFinite (volume : Measure F)]
    [Measure.IsAddHaarMeasure (volume : Measure F)]
    [NormedAddCommGroup K] {f : E × F → K} (hf : MemW0 f) (v : F) :
    MemW0 (fun u ↦ f (u, v)) := by
  have hgood_ae :
      ∀ᵐ v' ∂(volume : Measure F),
        Integrable (fun u ↦ wienerEnvelope f 1 (u, v')) := by
    exact hf.2.prod_left_ae
  obtain ⟨v', hv', hv'good⟩ := Measure.exists_mem_of_measure_ne_zero_of_ae
    (s := ball v 1) ((measure_ball_pos (volume : Measure F) v zero_lt_one).ne')
    (ae_restrict_of_ae hgood_ae)
  have hslice : Continuous (fun u ↦ f (u, v)) :=
    hf.1.comp (continuous_id.prodMk continuous_const)
  refine ⟨hslice, hv'good.mono_nonneg
    (continuous_wienerEnvelope hslice 1).aestronglyMeasurable
    (ae_of_all _ fun u ↦ aux_wienerEnvelope_nonneg hslice zero_le_one u)
    (ae_of_all _ fun u ↦ ?_)⟩
  unfold wienerEnvelope
  apply csSup_le ((Metric.nonempty_closedBall.mpr zero_le_one).image _)
  rintro _ ⟨z, hz, rfl⟩
  apply aux_norm_le_wienerEnvelope_of_mem_closedBall hf.1
  apply Metric.mem_closedBall.mpr
  rw [Prod.dist_eq]
  apply max_le
  · simpa [Metric.mem_closedBall, dist_eq_norm] using hz
  · exact le_of_lt (by simpa [dist_comm] using (Metric.mem_ball.mp hv'))

/-! ### Quantitative restriction to a coordinate factor -/

/-- Averaging over a unit ball gives a uniform bound for restriction to the second coordinate
slice on an arbitrary finite-dimensional additive Haar product. -/
theorem aux_quantitative_slice_average_addHaar_snd {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] [ProperSpace E]
    [MeasureSpace E] [BorelSpace E] [SFinite (volume : Measure E)]
    [Measure.IsAddHaarMeasure (volume : Measure E)]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F] [ProperSpace F]
    [MeasureSpace F] [BorelSpace F] [SFinite (volume : Measure F)]
    [Measure.IsAddHaarMeasure (volume : Measure F)]
    {H : E × F → ℝ} {G : E → ℝ} (hH : Integrable H (volume.prod volume))
    (hHnonneg : ∀ p, 0 ≤ H p) (hG : Continuous G) (hGnonneg : ∀ u, 0 ≤ G u)
    (v : F) (hpoint : ∀ v' ∈ closedBall v 1, ∀ u, G u ≤ H (u, v')) :
    (volume : Measure F).real (closedBall 0 1) * ∫ u, G u ≤ ∫ p, H p ∂(volume.prod volume) := by
  let A : Set F := closedBall v 1
  let I : E × F → ℝ := (Set.univ ×ˢ A).indicator (fun p => G p.1)
  have hA : MeasurableSet A := measurableSet_closedBall
  have hIAE : AEStronglyMeasurable I (volume.prod volume) := by
    exact ((hG.comp continuous_fst).stronglyMeasurable.aestronglyMeasurable)
      |>.indicator (MeasurableSet.univ.prod hA)
  have hIpoint (p : E × F) : ‖I p‖ ≤ H p := by
    by_cases hp : p.2 ∈ A
    · rw [show I p = G p.1 by simp [I, hp]]
      simpa [Real.norm_eq_abs, abs_of_nonneg (hGnonneg p.1)] using hpoint p.2 hp p.1
    · rw [show I p = 0 by simp [I, hp]]
      simpa using hHnonneg p
  have hI : Integrable I (volume.prod volume) := hH.mono' hIAE (ae_of_all _ hIpoint)
  have hIleH : I ≤ H := by
    intro p
    by_cases hp : p.2 ∈ A
    · rw [show I p = G p.1 by simp [I, hp]]
      exact hpoint p.2 hp p.1
    · rw [show I p = 0 by simp [I, hp]]
      exact hHnonneg p
  have hinter (v' : F) :
      (∫ u, I (u, v')) = A.indicator (fun _ => ∫ u, G u) v' := by
    by_cases hv : v' ∈ A <;> simp [I, hv]
  have hmain : (volume : Measure F).real A * ∫ u, G u ≤ ∫ p, H p ∂(volume.prod volume) := by
    calc
      (volume : Measure F).real A * ∫ u, G u = ∫ v' in A, ∫ u, G u := by
        rw [setIntegral_const, smul_eq_mul]
      _ = ∫ v', A.indicator (fun _ => ∫ u, G u) v' := (integral_indicator hA).symm
      _ = ∫ v', ∫ u, I (u, v') := by
        apply integral_congr_ae
        filter_upwards [] with v'
        rw [hinter v']
      _ = ∫ p, I p ∂(volume.prod volume) := (integral_prod_symm _ hI).symm
      _ ≤ ∫ p, H p ∂(volume.prod volume) := integral_mono hI hH hIleH
  have htrans : MeasurePreserving (fun x : F => x + v) (volume : Measure F) volume :=
    measurePreserving_add_right volume v
  have hpreimage : (fun x : F => x + v) ⁻¹' A = closedBall 0 1 := by
    ext x
    change dist (x + v) v ≤ 1 ↔ dist x 0 ≤ 1
    simp [dist_eq_norm]
  have hmeasure : (volume : Measure F) A = (volume : Measure F) (closedBall (0 : F) 1) := by
    calc
      (volume : Measure F) A = (volume : Measure F) ((fun x : F => x + v) ⁻¹' A) :=
        (htrans.measure_preimage hA.nullMeasurableSet).symm
      _ = (volume : Measure F) (closedBall 0 1) := congrArg volume hpreimage
  have hmeasure_real : (volume : Measure F).real A =
      (volume : Measure F).real (closedBall (0 : F) 1) := by
    simp only [measureReal_def, hmeasure]
  rw [hmeasure_real] at hmain
  exact hmain

/-- A local envelope on a second-coordinate slice is bounded by the ambient envelope at every
nearby second-coordinate point. -/
theorem aux_wienerEnvelope_slice_snd_le_of_mem_closedBall_addHaar {E F K : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] [ProperSpace E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F] [ProperSpace F]
    [NormedAddCommGroup K] {f : E × F → K} (hf : Continuous f)
    {v v' : F} (hv' : v' ∈ closedBall v 1) (u : E) :
    wienerEnvelope (fun u => f (u, v)) 1 u ≤ wienerEnvelope f 1 (u, v') := by
  unfold wienerEnvelope
  apply csSup_le ((Metric.nonempty_closedBall.mpr zero_le_one).image _)
  rintro _ ⟨z, hz, rfl⟩
  apply aux_norm_le_wienerEnvelope_of_mem_closedBall hf
  apply Metric.mem_closedBall.mpr
  rw [Prod.dist_eq]
  apply max_le
  · simpa [Metric.mem_closedBall, dist_eq_norm] using hz
  · simpa [dist_comm] using Metric.mem_closedBall.mp hv'

/-- The Wiener integral of a second-coordinate slice is bounded uniformly by the ambient Wiener
integral on an arbitrary finite-dimensional additive Haar product. -/
theorem aux_integral_wienerEnvelope_slice_snd_le_unitClosedBallVolume_inv_mul_addHaar
    {E F K : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] [ProperSpace E]
    [MeasureSpace E] [BorelSpace E] [SFinite (volume : Measure E)]
    [Measure.IsAddHaarMeasure (volume : Measure E)]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F] [ProperSpace F]
    [MeasureSpace F] [BorelSpace F] [SFinite (volume : Measure F)]
    [Measure.IsAddHaarMeasure (volume : Measure F)]
    [NormedAddCommGroup K] {f : E × F → K} (hf : MemW0 f) (v : F) :
    (∫ u, wienerEnvelope (fun u => f (u, v)) 1 u) ≤
      ((volume : Measure F).real (closedBall 0 1))⁻¹ * ∫ p, wienerEnvelope f 1 p := by
  let G : E × F → ℝ := wienerEnvelope f 1
  let H : E → ℝ := wienerEnvelope (fun u => f (u, v)) 1
  have hfin : Integrable G (volume.prod volume) := by
    change Integrable (wienerEnvelope f 1) (volume.prod volume)
    rw [← Measure.volume_eq_prod E F]
    exact hf.2
  have hmain : (volume : Measure F).real (closedBall 0 1) * ∫ u, H u ≤
      ∫ p, G p ∂(volume.prod volume) := by
    apply aux_quantitative_slice_average_addHaar_snd hfin
      (fun p => aux_wienerEnvelope_nonneg hf.1 zero_le_one p)
      (continuous_wienerEnvelope (hf.1.comp (continuous_id.prodMk continuous_const)) 1)
      (fun u => aux_wienerEnvelope_nonneg
        (hf.1.comp (continuous_id.prodMk continuous_const)) zero_le_one u)
      v
    intro v' hv' u
    exact aux_wienerEnvelope_slice_snd_le_of_mem_closedBall_addHaar hf.1 hv' u
  have hVpos : 0 < (volume : Measure F).real (closedBall (0 : F) 1) := by
    apply ENNReal.toReal_pos
    · exact (measure_ball_pos (volume : Measure F) 0 zero_lt_one).trans_le
        (measure_mono ball_subset_closedBall) |>.ne'
    · exact measure_closedBall_lt_top.ne
  let V : ℝ := (volume : Measure F).real (closedBall 0 1)
  have hVne : V ≠ 0 := ne_of_gt (by simpa only [V] using hVpos)
  have hmain' : V * ∫ u, H u ≤ ∫ p, G p := by
    simpa only [V, Measure.volume_eq_prod] using hmain
  change (∫ u, H u) ≤ V⁻¹ * ∫ p, G p
  calc
    (∫ u, H u) = V⁻¹ * (V * ∫ u, H u) := by
      field_simp [hVne]
    _ ≤ V⁻¹ * ∫ p, G p :=
      mul_le_mul_of_nonneg_left hmain' (inv_nonneg.mpr (le_of_lt hVpos))

/-- Pullback along an injective linear map between finite-dimensional Euclidean spaces preserves
`W₀`.  The proof identifies the range with a coordinate factor through an orthogonal
decomposition, restricts to that factor, and then changes coordinates on the domain. -/
theorem MemW0.aux_comp_injective_continuousLinearMap {k n : ℕ} {𝕜 : Type*}
    [NormedAddCommGroup 𝕜] {f : EuclideanSpace ℝ (Fin n) → 𝕜} (hf : MemW0 f)
    (π : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin n))
    (hπ : Function.Injective π) :
    MemW0 (f ∘ π) := by
  let s : Submodule ℝ (EuclideanSpace ℝ (Fin n)) := π.range
  let e : EuclideanSpace ℝ (Fin n) ≃L[ℝ] s × sᗮ :=
    s.orthogonalDecomposition.toContinuousLinearEquiv.trans
      (WithLp.prodContinuousLinearEquiv 2 ℝ s sᗮ)
  let F : s × sᗮ → 𝕜 := f ∘ e.symm
  have hF : MemW0 F := by
    have he : MeasurePreserving e := by
      let e₁ : EuclideanSpace ℝ (Fin n) ≃ₗᵢ[ℝ] WithLp 2 (s × sᗮ) :=
        s.orthogonalDecomposition
      let e₂ : WithLp 2 (s × sᗮ) ≃L[ℝ] s × sᗮ :=
        WithLp.prodContinuousLinearEquiv 2 ℝ s sᗮ
      change MeasurePreserving (e₂ ∘ e₁)
      exact (WithLp.volume_preserving_ofLp s sᗮ).comp e₁.measurePreserving
    have he_symm : MeasurePreserving e.symm :=
      MeasurePreserving.symm e.toHomeomorph.toMeasurableEquiv he
    apply hf.aux_comp_continuousLinearMap_of_measurePreserving e.symm.toContinuousLinearMap he_symm
    exact aux_integrable_wienerEnvelope_of_integrable hf.1 zero_lt_one
      (norm_nonneg e.symm.toContinuousLinearMap) hf.2
  have hS : MemW0 (fun q : s ↦ F (q, 0)) :=
    hF.aux_memW0_slice_snd_of_addHaar 0
  let q : EuclideanSpace ℝ (Fin k) ≃L[ℝ] s :=
    π.equivRange hπ π.range.closed_of_finiteDimensional
  have hq : MemW0 (fun x : EuclideanSpace ℝ (Fin k) ↦ F (q x, 0)) := by
    apply hS.aux_comp_continuousLinearEquiv_between_of_integrable_radius q
    exact aux_integrable_wienerEnvelope_of_integrable' hS.1 zero_lt_one
      (norm_nonneg q.toContinuousLinearMap) hS.2
  have hfun : (fun x : EuclideanSpace ℝ (Fin k) ↦ F (q x, 0)) = f ∘ π := by
    funext x
    have hcoord : e (π x) = (q x, 0) := by
      rw [aux_orthogonalDecomposition_range_apply π x]
      apply Prod.ext
      · change π.rangeRestrict x = (π.equivRange hπ π.range.closed_of_finiteDimensional) x
        exact congrFun (π.coe_equivRange hπ π.range.closed_of_finiteDimensional).symm x
      · rfl
    change f (e.symm (q x, 0)) = f (π x)
    rw [← hcoord, e.symm_apply_apply]
  rwa [hfun] at hq

/-- The quantitative form of injective pullback.  Its positive constant is obtained by
straightening the range of the map, applying the uniform slice estimate, and changing
coordinates on the source. -/
theorem aux_exists_wienerEnvelope_comp_injective_continuousLinearMap_bound
    {k n : ℕ} {K : Type*} [NormedAddCommGroup K]
    (π : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin n))
    (hπ : Function.Injective π) :
    ∃ C : ℝ, 0 < C ∧ ∀ f : EuclideanSpace ℝ (Fin n) → K, MemW0 f →
      (∫ x, wienerEnvelope (f ∘ π) 1 x) ≤ C * ∫ y, wienerEnvelope f 1 y := by
  classical
  let s : Submodule ℝ (EuclideanSpace ℝ (Fin n)) := π.range
  let : MeasureSpace (s × sᗮ) :=
    ⟨(volume : Measure s).prod (volume : Measure sᗮ)⟩
  let : Measure.IsAddHaarMeasure (volume : Measure (s × sᗮ)) := by
    change Measure.IsAddHaarMeasure ((volume : Measure s).prod (volume : Measure sᗮ))
    infer_instance
  let e : EuclideanSpace ℝ (Fin n) ≃L[ℝ] s × sᗮ :=
    s.orthogonalDecomposition.toContinuousLinearEquiv.trans
      (WithLp.prodContinuousLinearEquiv 2 ℝ s sᗮ)
  let q : EuclideanSpace ℝ (Fin k) ≃L[ℝ] s :=
    π.equivRange hπ π.range.closed_of_finiteDimensional
  obtain ⟨Cq, hCq_pos, hCq⟩ :=
    aux_exists_wienerEnvelope_comp_continuousLinearEquiv_bound (K := K) q
  obtain ⟨Ce, hCe_pos, hCe⟩ :=
    aux_exists_wienerEnvelope_comp_continuousLinearEquiv_bound (K := K) e.symm
  let V : ℝ := ((volume : Measure sᗮ).real (closedBall 0 1))⁻¹
  have hV_pos : 0 < V := by
    have hball_pos : 0 < (volume : Measure sᗮ).real (closedBall (0 : sᗮ) 1) := by
      apply ENNReal.toReal_pos
      · exact (measure_ball_pos (volume : Measure sᗮ) 0 zero_lt_one).trans_le
          (measure_mono ball_subset_closedBall) |>.ne'
      · exact measure_closedBall_lt_top.ne
    exact inv_pos.mpr (by simpa only [V] using hball_pos)
  refine ⟨Cq * V * Ce, mul_pos (mul_pos hCq_pos hV_pos) hCe_pos, ?_⟩
  intro f hf
  let F : s × sᗮ → K := f ∘ e.symm
  have hF : MemW0 F := by
    have he : MeasurePreserving e := by
      let e₁ : EuclideanSpace ℝ (Fin n) ≃ₗᵢ[ℝ] WithLp 2 (s × sᗮ) :=
        s.orthogonalDecomposition
      let e₂ : WithLp 2 (s × sᗮ) ≃L[ℝ] s × sᗮ :=
        WithLp.prodContinuousLinearEquiv 2 ℝ s sᗮ
      change MeasurePreserving (e₂ ∘ e₁)
      exact (WithLp.volume_preserving_ofLp s sᗮ).comp e₁.measurePreserving
    have he_symm : MeasurePreserving e.symm :=
      MeasurePreserving.symm e.toHomeomorph.toMeasurableEquiv he
    apply hf.aux_comp_continuousLinearMap_of_measurePreserving e.symm.toContinuousLinearMap he_symm
    exact aux_integrable_wienerEnvelope_of_integrable hf.1 zero_lt_one
      (norm_nonneg e.symm.toContinuousLinearMap) hf.2
  have hS : MemW0 (fun u : s => F (u, 0)) :=
    hF.aux_memW0_slice_snd_of_addHaar 0
  have hslice : (∫ u, wienerEnvelope (fun u : s => F (u, 0)) 1 u) ≤
      V * ∫ p, wienerEnvelope F 1 p := by
    simpa only [V] using
      aux_integral_wienerEnvelope_slice_snd_le_unitClosedBallVolume_inv_mul_addHaar hF 0
  have hq_bound := hCq (fun u : s => F (u, 0)) hS
  have he_bound : (∫ p, wienerEnvelope F 1 p) ≤ Ce * ∫ y, wienerEnvelope f 1 y := by
    simpa only [F] using hCe f hf
  have hfun : (fun x : EuclideanSpace ℝ (Fin k) => F (q x, 0)) = f ∘ π := by
    funext x
    have hcoord : e (π x) = (q x, 0) := by
      rw [aux_orthogonalDecomposition_range_apply π x]
      apply Prod.ext
      · change π.rangeRestrict x = (π.equivRange hπ π.range.closed_of_finiteDimensional) x
        exact congrFun (π.coe_equivRange hπ π.range.closed_of_finiteDimensional).symm x
      · rfl
    change f (e.symm (q x, 0)) = f (π x)
    rw [← hcoord, e.symm_apply_apply]
  calc
    (∫ x, wienerEnvelope (f ∘ π) 1 x) =
        ∫ x, wienerEnvelope ((fun u : s => F (u, 0)) ∘ q) 1 x := by
      simpa only [Function.comp_def] using
        congrArg (fun g : EuclideanSpace ℝ (Fin k) → K => ∫ x, wienerEnvelope g 1 x) hfun.symm
    _ ≤ Cq * ∫ u, wienerEnvelope (fun u : s => F (u, 0)) 1 u := hq_bound
    _ ≤ Cq * (V * ∫ p, wienerEnvelope F 1 p) :=
      mul_le_mul_of_nonneg_left hslice hCq_pos.le
    _ ≤ Cq * (V * (Ce * ∫ y, wienerEnvelope f 1 y)) := by
      gcongr
    _ = (Cq * V * Ce) * ∫ y, wienerEnvelope f 1 y := by ring

/-- A coordinate fibre has a uniform Wiener-integral bound.  Averaging the local envelope over
a unit ball in the transverse coordinate repairs the non-uniform supremum-to-average step in the
draft's proof. -/
theorem aux_integral_wienerEnvelope_slice_le_unitClosedBallVolume_inv_mul
    {m l : ℕ} {𝕜 : Type*} [NormedAddCommGroup 𝕜]
    {f : EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l) → 𝕜}
    (hf : MemW0 f) (u : EuclideanSpace ℝ (Fin m)) :
    (∫ v, wienerEnvelope (fun v => f (u, v)) 1 v) ≤
      (volume.real (closedBall (0 : EuclideanSpace ℝ (Fin m)) 1))⁻¹ *
        ∫ p, wienerEnvelope f 1 p := by
  let E := EuclideanSpace ℝ (Fin m)
  let F := EuclideanSpace ℝ (Fin l)
  let H : F → ℝ := fun v => wienerEnvelope (fun v => f (u, v)) 1 v
  let G : E × F → ℝ := wienerEnvelope f 1
  let B : Set E := closedBall u 1
  have hH : Integrable H := by
    simpa [H] using (hf.aux_memW0_slice u).2
  have hG : Integrable G := by
    simpa [G] using hf.2
  have hGW : MemW0 G := by
    simpa [G] using hf.aux_mem_wienerEnvelope_prod zero_le_one
  have hGslice (v : F) : Integrable (fun x : E => G (x, v)) :=
    (hGW.aux_memW0_slice_snd_of_addHaar v).aux_integrable
  have hBmeas : MeasurableSet B := measurableSet_closedBall
  have hBfin : volume B ≠ ∞ := measure_closedBall_lt_top.ne
  have hpoint (v : F) :
      H v * volume.real B ≤ ∫ x in B, G (x, v) := by
    apply setIntegral_ge_of_const_le_real hBmeas hBfin
    · intro x hx
      change wienerEnvelope (fun v => f (u, v)) 1 v ≤ wienerEnvelope f 1 (x, v)
      unfold wienerEnvelope
      apply csSup_le ((Metric.nonempty_closedBall.mpr zero_le_one).image _)
      rintro _ ⟨z, hz, rfl⟩
      apply aux_norm_le_wienerEnvelope_of_mem_closedBall hf.1
      apply Metric.mem_closedBall.mpr
      rw [Prod.dist_eq]
      apply max_le
      · change dist u x ≤ 1
        simpa [B, Metric.mem_closedBall, dist_comm] using hx
      · simpa [Metric.mem_closedBall, dist_eq_norm] using hz
    · exact (hGslice v).integrableOn
  let GI : E × F → ℝ := (B ×ˢ (univ : Set F)).indicator G
  have hGI : Integrable GI := by
    apply IntegrableOn.integrable_indicator hG.integrableOn
    exact hBmeas.prod MeasurableSet.univ
  have hGI_slice : Integrable (fun v : F => ∫ x : E, GI (x, v)) :=
    hGI.integral_prod_right
  have hGI_eq (v : F) : (∫ x : E, GI (x, v)) = ∫ x in B, G (x, v) := by
    change (∫ x : E, (B ×ˢ (univ : Set F)).indicator G (x, v)) = _
    have hfun : (fun x : E => (B ×ˢ (univ : Set F)).indicator G (x, v)) =
        B.indicator (fun x => G (x, v)) := by
      funext x
      by_cases hx : x ∈ B <;> simp [Set.indicator, hx]
    rw [hfun, integral_indicator hBmeas]
  have hmain : volume.real B * (∫ v, H v) ≤ ∫ p, G p := by
    calc
      volume.real B * (∫ v, H v) = ∫ v, H v * volume.real B := by
        rw [integral_mul_const]
        exact mul_comm _ _
      _ ≤ ∫ v, ∫ x in B, G (x, v) :=
        integral_mono (hH.mul_const _) (by simpa only [hGI_eq] using hGI_slice) hpoint
      _ = ∫ v, ∫ x : E, GI (x, v) := by
        congr with v
        exact (hGI_eq v).symm
      _ = ∫ p, GI p := (integral_prod_symm _ hGI).symm
      _ ≤ ∫ p, G p := by
        apply integral_mono hGI hG
        intro p
        by_cases hp : p ∈ B ×ˢ (univ : Set F)
        · simp [GI, hp]
        · change (B ×ˢ (univ : Set F)).indicator G p ≤ G p
          rw [Set.indicator_of_notMem hp]
          exact aux_wienerEnvelope_nonneg hf.1 zero_le_one p
  have hvol : volume.real B =
      volume.real (closedBall (0 : EuclideanSpace ℝ (Fin m)) 1) := by
    simpa [B] using MeasureTheory.Measure.addHaar_real_closedBall_center volume u 1
  let V : ℝ := volume.real (closedBall (0 : EuclideanSpace ℝ (Fin m)) 1)
  have hVpos : 0 < V := aux_unitClosedBallVolume_pos
  have hVne : V ≠ 0 := ne_of_gt hVpos
  have hmain' : V * (∫ v, H v) ≤ ∫ p, G p := by
    simpa [V, hvol] using hmain
  change (∫ v, H v) ≤ V⁻¹ * ∫ p, G p
  calc
    (∫ v, H v) = V⁻¹ * (V * ∫ v, H v) := by
      field_simp
    _ ≤ V⁻¹ * ∫ p, G p :=
      mul_le_mul_of_nonneg_left hmain' (inv_nonneg.mpr (le_of_lt hVpos))

/-- The unit-envelope of a Wiener-space function is integrable on every coordinate fibre. -/
theorem MemW0.aux_integrable_wienerEnvelope_slice {m l : ℕ} {𝕜 : Type*}
    [NormedAddCommGroup 𝕜]
    {f : EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l) → 𝕜}
    (hf : MemW0 f) (u : EuclideanSpace ℝ (Fin m)) :
    Integrable (fun v ↦ wienerEnvelope f 1 (u, v)) :=
  MemW0.aux_integrable (MemW0.aux_memW0_slice (hf.aux_mem_wienerEnvelope_prod zero_le_one) u)

/-- Integration along the second coordinate is continuous on `W₀`. -/
theorem aux_continuous_integral_slice {m l : ℕ} {𝕜 : Type*}
    [NormedAddCommGroup 𝕜] [NormedSpace ℝ 𝕜]
    {f : EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l) → 𝕜}
    (hf : MemW0 f) :
    Continuous (fun u ↦ ∫ v, f (u, v)) := by
  rw [continuous_iff_continuousAt]
  intro u₀
  have hgood_ae :
      ∀ᵐ u' ∂(volume : Measure (EuclideanSpace ℝ (Fin m))),
        Integrable (fun v ↦ wienerEnvelope f 1 (u', v)) := by
    exact hf.2.prod_right_ae
  obtain ⟨u', hu', hu'good⟩ := Measure.exists_mem_of_measure_ne_zero_of_ae
    (s := ball u₀ (1 / 2))
    ((measure_ball_pos (volume : Measure (EuclideanSpace ℝ (Fin m))) u₀ (by norm_num)).ne')
    (ae_restrict_of_ae hgood_ae)
  apply tendsto_integral_filter_of_dominated_convergence
    (fun v ↦ wienerEnvelope f 1 (u', v))
  · filter_upwards [] with u
    exact (hf.1.comp (continuous_const.prodMk continuous_id)).aestronglyMeasurable
  · filter_upwards [Metric.ball_mem_nhds u₀ (by norm_num : 0 < (1 / 2 : ℝ))] with u hu
    filter_upwards [] with v
    apply aux_norm_le_wienerEnvelope_of_mem_closedBall hf.1
    apply Metric.mem_closedBall.mpr
    rw [Prod.dist_eq]
    apply max_le
    · change dist u u' ≤ 1
      apply le_of_lt
      calc
        dist u u' ≤ dist u u₀ + dist u₀ u' := dist_triangle _ _ _
        _ < 1 / 2 + 1 / 2 := add_lt_add (Metric.mem_ball.mp hu)
          (by simpa [dist_comm] using (Metric.mem_ball.mp hu'))
        _ = 1 := by norm_num
    · change dist v v ≤ 1
      simp
  · exact hu'good
  · filter_upwards [] with v
    exact hf.1.continuousAt.tendsto.comp
      (continuous_id.prodMk continuous_const).continuousAt

/-- The coordinate fibre-integral theorem from the draft.  It is the case of the source's
injective map `π` given by the canonical product coordinates. -/
theorem MemW0.aux_integral_slice {m l : ℕ} {𝕜 : Type*}
    [NormedAddCommGroup 𝕜] [NormedSpace ℝ 𝕜]
    {f : EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l) → 𝕜}
    (hf : MemW0 f) :
    MemW0 (fun u ↦ ∫ v, f (u, v)) := by
  let F : EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l) → ℝ :=
    wienerEnvelope f 1
  have hF : MemW0 F := hf.aux_mem_wienerEnvelope_prod zero_le_one
  have hF_slice (u : EuclideanSpace ℝ (Fin m)) : Integrable (fun v ↦ F (u, v)) :=
    (hF.aux_memW0_slice u).aux_integrable
  have hf_slice (u : EuclideanSpace ℝ (Fin m)) : Integrable (fun v ↦ f (u, v)) :=
    (hf.aux_memW0_slice u).aux_integrable
  have hcont : Continuous (fun u ↦ ∫ v, f (u, v)) := aux_continuous_integral_slice hf
  refine ⟨hcont, ?_⟩
  have hH : Integrable (fun u ↦ ∫ v, F (u, v)) := hf.2.integral_prod_left
  refine hH.mono_nonneg (continuous_wienerEnvelope hcont 1).aestronglyMeasurable
    (ae_of_all _ fun u ↦ aux_wienerEnvelope_nonneg hcont zero_le_one u)
    (ae_of_all _ fun u ↦ ?_)
  unfold wienerEnvelope
  apply csSup_le ((Metric.nonempty_closedBall.mpr zero_le_one).image _)
  rintro _ ⟨w, hw, rfl⟩
  change ‖∫ v, f (u + w, v)‖ ≤ ∫ v, F (u, v)
  calc
    ‖∫ v, f (u + w, v)‖ ≤ ∫ v, ‖f (u + w, v)‖ := norm_integral_le_integral_norm _
    _ ≤ ∫ v, F (u, v) := by
      apply integral_mono (hf_slice (u + w)).norm (hF_slice u)
      intro v
      change ‖f (u + w, v)‖ ≤ wienerEnvelope f 1 (u, v)
      apply aux_norm_le_wienerEnvelope_of_mem_closedBall hf.1
      apply Metric.mem_closedBall.mpr
      rw [Prod.dist_eq]
      apply max_le
      · simpa [Metric.mem_closedBall, dist_eq_norm] using hw
      · simp

/-- The quantitative estimate for the coordinate fibre integral: its unit Wiener integral is at
most that of the original function. -/
theorem aux_integral_wienerEnvelope_integral_slice_le {m l : ℕ} {𝕜 : Type*}
    [NormedAddCommGroup 𝕜] [NormedSpace ℝ 𝕜]
    {f : EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l) → 𝕜}
    (hf : MemW0 f) :
    (∫ u, wienerEnvelope (fun u ↦ ∫ v, f (u, v)) 1 u) ≤
      ∫ p, wienerEnvelope f 1 p := by
  let F : EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l) → ℝ :=
    wienerEnvelope f 1
  have hF : MemW0 F := hf.aux_mem_wienerEnvelope_prod zero_le_one
  have hF_slice (u : EuclideanSpace ℝ (Fin m)) : Integrable (fun v ↦ F (u, v)) :=
    (hF.aux_memW0_slice u).aux_integrable
  have hf_slice (u : EuclideanSpace ℝ (Fin m)) : Integrable (fun v ↦ f (u, v)) :=
    (hf.aux_memW0_slice u).aux_integrable
  have hcont : Continuous (fun u ↦ ∫ v, f (u, v)) := aux_continuous_integral_slice hf
  have hH : Integrable (fun u ↦ ∫ v, F (u, v)) := hf.2.integral_prod_left
  have hpoint : ∀ u, wienerEnvelope (fun u ↦ ∫ v, f (u, v)) 1 u ≤ ∫ v, F (u, v) := by
    intro u
    unfold wienerEnvelope
    apply csSup_le ((Metric.nonempty_closedBall.mpr zero_le_one).image _)
    rintro _ ⟨w, hw, rfl⟩
    change ‖∫ v, f (u + w, v)‖ ≤ ∫ v, F (u, v)
    calc
      ‖∫ v, f (u + w, v)‖ ≤ ∫ v, ‖f (u + w, v)‖ :=
        norm_integral_le_integral_norm _
      _ ≤ ∫ v, F (u, v) := by
        apply integral_mono (hf_slice (u + w)).norm (hF_slice u)
        intro v
        change ‖f (u + w, v)‖ ≤ wienerEnvelope f 1 (u, v)
        apply aux_norm_le_wienerEnvelope_of_mem_closedBall hf.1
        apply Metric.mem_closedBall.mpr
        rw [Prod.dist_eq]
        apply max_le
        · simpa [Metric.mem_closedBall, dist_eq_norm] using hw
        · simp
  calc
    (∫ u, wienerEnvelope (fun u ↦ ∫ v, f (u, v)) 1 u) ≤ ∫ u, ∫ v, F (u, v) :=
      integral_mono (MemW0.aux_integral_slice hf).2 hH hpoint
    _ = ∫ p, F p := integral_integral hf.2
    _ = ∫ p, wienerEnvelope f 1 p := rfl

/-- \begin{proposition}\label{P:schwartz-into-wiener}
We have $\mathcal{S}(\R^n)\subset W_0(\R^n)$.
\end{proposition} -/
theorem SchwartzMap.memW0 {d : ℕ} {𝕜 : Type*} [NormedAddCommGroup 𝕜] [NormedSpace ℝ 𝕜]
    (f : SchwartzMap (EuclideanSpace ℝ (Fin d)) 𝕜) :
    MemW0 f := by
  refine ⟨f.continuous, ?_⟩
  let C : ℝ := 2 ^ (d + 1) *
    (Finset.Iic (d + 1, 0)).sup (fun m => SchwartzMap.seminorm ℝ m.1 m.2) f
  have hC : ∀ y : EuclideanSpace ℝ (Fin d),
      (1 + ‖y‖) ^ (d + 1) * ‖f y‖ ≤ C := by
    intro y
    simpa [C] using
      (SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := (d + 1, 0))
        le_rfl le_rfl f y)
  have hC_nonneg : 0 ≤ C := by
    dsimp [C]
    positivity
  have hbound : ∀ x : EuclideanSpace ℝ (Fin d),
      wienerEnvelope f 1 x ≤ C * 2 ^ (d + 1) / (1 + ‖x‖) ^ (d + 1) := by
    intro x
    unfold wienerEnvelope
    apply csSup_le ((Metric.nonempty_closedBall.mpr zero_le_one).image _)
    rintro _ ⟨z, hz, rfl⟩
    have hz' : ‖z‖ ≤ 1 := by
      simpa [Metric.mem_closedBall, dist_eq_norm] using hz
    have hxy : 1 + ‖x‖ ≤ 2 * (1 + ‖x + z‖) := by
      calc
        1 + ‖x‖ ≤ 1 + (‖x + z‖ + ‖z‖) := by
          gcongr
          simpa using norm_sub_le (x + z) z
        _ ≤ 1 + (‖x + z‖ + 1) := by gcongr
        _ ≤ 2 * (1 + ‖x + z‖) := by nlinarith [norm_nonneg (x + z)]
    have hpow : (1 + ‖x‖) ^ (d + 1) ≤
        2 ^ (d + 1) * (1 + ‖x + z‖) ^ (d + 1) := by
      calc
        (1 + ‖x‖) ^ (d + 1) ≤ (2 * (1 + ‖x + z‖)) ^ (d + 1) :=
          pow_le_pow_left₀ (by positivity) hxy _
        _ = 2 ^ (d + 1) * (1 + ‖x + z‖) ^ (d + 1) := by rw [mul_pow]
    have hy : ‖f (x + z)‖ ≤ C / (1 + ‖x + z‖) ^ (d + 1) := by
      apply (le_div_iff₀ (pow_pos (by positivity) _)).mpr
      simpa [mul_comm] using hC (x + z)
    calc
      ‖f (x + z)‖ ≤ C / (1 + ‖x + z‖) ^ (d + 1) := hy
      _ = C * (1 / (1 + ‖x + z‖) ^ (d + 1)) := by ring
      _ ≤ C * (2 ^ (d + 1) / (1 + ‖x‖) ^ (d + 1)) := by
        apply mul_le_mul_of_nonneg_left _ hC_nonneg
        apply (div_le_div_iff₀ (pow_pos (by positivity) _) (pow_pos (by positivity) _)).mpr
        simpa [mul_comm] using hpow
      _ = C * 2 ^ (d + 1) / (1 + ‖x‖) ^ (d + 1) := by ring
  have hrad : Integrable (fun x : EuclideanSpace ℝ (Fin d) ↦
      (1 + ‖x‖) ^ (-((d + 1 : ℕ) : ℝ))) := by
    apply integrable_one_add_norm
    simp
  refine (hrad.const_mul (C * 2 ^ (d + 1))).mono_nonneg
    (continuous_wienerEnvelope f.continuous 1).aestronglyMeasurable
    (ae_of_all _ fun x ↦ aux_wienerEnvelope_nonneg f.continuous zero_le_one x)
    (ae_of_all _ fun x ↦ ?_)
  rw [Real.rpow_neg (by positivity), Real.rpow_natCast]
  exact hbound x

/-- The local envelope of a tensor product is bounded by the product of the local envelopes.
The ambient product has its standard max metric.
Thus, a unit ball is a product of unit balls. -/
theorem aux_wienerEnvelope_mul_prod_le {E F 𝕜 : Type*} [NormedAddCommGroup E] [ProperSpace E]
    [NormedAddCommGroup F] [ProperSpace F] [NormedField 𝕜] {f : E → 𝕜} {g : F → 𝕜}
    (hf : Continuous f) (hg : Continuous g) (x : E × F) :
    wienerEnvelope (fun p : E × F ↦ f p.1 * g p.2) 1 x ≤
      wienerEnvelope f 1 x.1 * wienerEnvelope g 1 x.2 := by
  unfold wienerEnvelope
  apply csSup_le ((Metric.nonempty_closedBall.mpr zero_le_one).image _)
  rintro _ ⟨z, hz, rfl⟩
  have hz' : z ∈ closedBall (0 : E) 1 ×ˢ closedBall (0 : F) 1 := by
    have hnorm : ‖z‖ ≤ 1 := by simpa using Metric.mem_closedBall.mp hz
    exact ⟨by simpa [Metric.mem_closedBall, dist_eq_norm] using (norm_fst_le z).trans hnorm,
      by simpa [Metric.mem_closedBall, dist_eq_norm] using (norm_snd_le z).trans hnorm⟩
  have hfx : ‖f (x.1 + z.1)‖ ≤ wienerEnvelope f 1 x.1 := by
    apply aux_norm_le_wienerEnvelope_of_mem_closedBall hf
    simpa [Metric.mem_closedBall, dist_eq_norm] using hz'.1
  have hgz : ‖g (x.2 + z.2)‖ ≤ wienerEnvelope g 1 x.2 := by
    apply aux_norm_le_wienerEnvelope_of_mem_closedBall hg
    simpa [Metric.mem_closedBall, dist_eq_norm] using hz'.2
  change ‖f (x.1 + z.1) * g (x.2 + z.2)‖ ≤ _
  rw [norm_mul]
  exact mul_le_mul hfx hgz (norm_nonneg _) (aux_wienerEnvelope_nonneg hf zero_le_one _)

/-- A product of two integrable nonnegative local envelopes is integrable on the product. -/
theorem aux_integrable_wienerEnvelope_mul_prod {E F 𝕜 : Type*} [NormedAddCommGroup E]
    [ProperSpace E] [MeasureSpace E] [BorelSpace E] [SFinite (volume : Measure E)]
    [NormedAddCommGroup F] [ProperSpace F] [MeasureSpace F] [BorelSpace F]
    [SFinite (volume : Measure F)]
    [NormedField 𝕜] {f : E → 𝕜} {g : F → 𝕜} (hf : Continuous f) (hg : Continuous g)
    (hfi : Integrable (wienerEnvelope f 1)) (hgi : Integrable (wienerEnvelope g 1)) :
    Integrable (fun x : E × F ↦ wienerEnvelope f 1 x.1 * wienerEnvelope g 1 x.2) := by
  rw [Measure.volume_eq_prod]
  let h : E × F → ℝ := fun x ↦ wienerEnvelope f 1 x.1 * wienerEnvelope g 1 x.2
  have hh : AEStronglyMeasurable h (volume.prod volume) := by
    change AEStronglyMeasurable (fun x : E × F ↦
      wienerEnvelope f 1 x.1 * wienerEnvelope g 1 x.2) (volume.prod volume)
    exact ((continuous_wienerEnvelope hf 1).comp continuous_fst).mul
      ((continuous_wienerEnvelope hg 1).comp continuous_snd) |>.aestronglyMeasurable
  refine (integrable_prod_iff hh).mpr ⟨?_, ?_⟩
  · filter_upwards [] with x
    exact hgi.const_mul (wienerEnvelope f 1 x)
  · have hformula : ∀ x : E,
        (∫ y, ‖wienerEnvelope f 1 x * wienerEnvelope g 1 y‖) =
          wienerEnvelope f 1 x * ∫ y, wienerEnvelope g 1 y := by
      intro x
      calc
        (∫ y, ‖wienerEnvelope f 1 x * wienerEnvelope g 1 y‖) =
            ∫ y, wienerEnvelope f 1 x * wienerEnvelope g 1 y := by
          apply integral_congr_ae
          filter_upwards [] with y
          rw [Real.norm_eq_abs,
            abs_of_nonneg (mul_nonneg (aux_wienerEnvelope_nonneg hf zero_le_one _)
              (aux_wienerEnvelope_nonneg hg zero_le_one _))]
        _ = wienerEnvelope f 1 x * ∫ y, wienerEnvelope g 1 y :=
          integral_const_mul _ _
    change Integrable (fun x : E ↦
      ∫ y, ‖wienerEnvelope f 1 x * wienerEnvelope g 1 y‖) volume
    convert hfi.mul_const (∫ y, wienerEnvelope g 1 y) using 1
    ext x
    exact hformula x

/-- Binary tensor products preserve `W₀`.  This is the finite-product assertion from the draft,
written for the canonical product coordinates supplied by mathlib. -/
theorem MemW0.aux_mul_prod {E F 𝕜 : Type*} [NormedAddCommGroup E] [ProperSpace E]
    [MeasureSpace E] [BorelSpace E] [SFinite (volume : Measure E)] [NormedAddCommGroup F]
    [ProperSpace F] [MeasureSpace F] [BorelSpace F] [SFinite (volume : Measure F)] [NormedField 𝕜]
    {f : E → 𝕜} {g : F → 𝕜} (hf : MemW0 f) (hg : MemW0 g) :
    MemW0 (fun x : E × F ↦ f x.1 * g x.2) := by
  have hfg : Continuous (fun x : E × F ↦ f x.1 * g x.2) :=
    (hf.1.comp continuous_fst).mul (hg.1.comp continuous_snd)
  refine ⟨hfg, ?_⟩
  refine (aux_integrable_wienerEnvelope_mul_prod hf.1 hg.1 hf.2 hg.2).mono_nonneg
    (continuous_wienerEnvelope hfg 1).aestronglyMeasurable
    (ae_of_all _ fun x ↦ aux_wienerEnvelope_nonneg hfg zero_le_one x)
    (ae_of_all _ fun x ↦ ?_)
  exact aux_wienerEnvelope_mul_prod_le hf.1 hg.1 x

/-- The quantitative binary tensor-product estimate for the extended Wiener integrals. -/
theorem aux_wienerNormOne_mul_prod_le {E F 𝕜 : Type*} [NormedAddCommGroup E] [ProperSpace E]
    [MeasureSpace E] [BorelSpace E] [NormedAddCommGroup F] [ProperSpace F]
    [MeasureSpace F] [BorelSpace F] [SFinite (volume : Measure F)] [NormedField 𝕜]
    {f : E → 𝕜} {g : F → 𝕜}
    (hf : Continuous f) (hg : Continuous g) :
    wienerNormOne (fun x : E × F ↦ f x.1 * g x.2) ≤ wienerNormOne f * wienerNormOne g := by
  unfold wienerNormOne wienerNorm
  rw [Measure.volume_eq_prod]
  calc
    (∫⁻ x : E × F, ENNReal.ofReal (wienerEnvelope (fun x : E × F ↦ f x.1 * g x.2) 1 x)) ≤
        ∫⁻ x : E × F, ENNReal.ofReal
          (wienerEnvelope f 1 x.1 * wienerEnvelope g 1 x.2) := by
      apply lintegral_mono
      intro x
      exact ENNReal.ofReal_le_ofReal (aux_wienerEnvelope_mul_prod_le hf hg x)
    _ = (∫⁻ x : E, ENNReal.ofReal (wienerEnvelope f 1 x)) *
        ∫⁻ y : F, ENNReal.ofReal (wienerEnvelope g 1 y) := by
      simp_rw [ENNReal.ofReal_mul (aux_wienerEnvelope_nonneg hf zero_le_one _)]
      exact lintegral_prod_mul
        (f := fun x : E ↦ ENNReal.ofReal (wienerEnvelope f 1 x))
        (g := fun y : F ↦ ENNReal.ofReal (wienerEnvelope g 1 y))
        (ENNReal.continuous_ofReal.measurable.comp_aemeasurable
          (measurable_wienerEnvelope hf 1).aemeasurable)
        (ENNReal.continuous_ofReal.measurable.comp_aemeasurable
          (measurable_wienerEnvelope hg 1).aemeasurable)

/-- The canonical splitting of Euclidean coordinates into two blocks preserves Lebesgue volume. -/
theorem aux_finAdd_measurePreserving (n m : ℕ) :
    MeasurePreserving (EuclideanSpace.finAddEquivProd :
      EuclideanSpace ℝ (Fin (n + m)) →
        EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin m)) := by
  let e₁ : EuclideanSpace ℝ (Fin (n + m)) ≃ₗᵢ[ℝ]
      EuclideanSpace ℝ (Fin n ⊕ Fin m) :=
    LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ finSumFinEquiv.symm
  let e₂ : EuclideanSpace ℝ (Fin n ⊕ Fin m) ≃ₗᵢ[ℝ]
      WithLp 2 (EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin m)) :=
    PiLp.sumPiLpEquivProdLpPiLp 2 (fun _ : Fin n ⊕ Fin m ↦ ℝ)
  let e₃ : WithLp 2 (EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin m)) ≃L[ℝ]
      EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin m) :=
    WithLp.prodContinuousLinearEquiv 2 ℝ _ _
  have h₁ : MeasurePreserving e₁ := e₁.measurePreserving
  have h₂ : MeasurePreserving e₂ := e₂.measurePreserving
  have h₃ : MeasurePreserving e₃ := WithLp.volume_preserving_ofLp _ _
  change MeasurePreserving (e₃ ∘ e₂ ∘ e₁)
  exact h₃.comp (h₂.comp h₁)

/-- Transport a Wiener-space function from Euclidean coordinates to the corresponding product
coordinates. -/
theorem aux_memW0_comp_finAddEquivProd_symm {n m : ℕ} {𝕜 : Type*}
    [NormedAddCommGroup 𝕜] {f : EuclideanSpace ℝ (Fin (n + m)) → 𝕜}
    (hf : MemW0 f) :
    MemW0 (fun p : EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin m) =>
      f (EuclideanSpace.finAddEquivProd.symm p)) := by
  let E := EuclideanSpace ℝ (Fin (n + m))
  let P := EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin m)
  let e : E ≃L[ℝ] P := EuclideanSpace.finAddEquivProd
  let g : P →L[ℝ] E := e.symm.toContinuousLinearMap
  let F : P → 𝕜 := fun p => f (g p)
  have hF : Continuous F := hf.1.comp g.continuous
  change MemW0 F
  refine ⟨hF, ?_⟩
  have hrad : Integrable (wienerEnvelope f ‖g‖) :=
    aux_integrable_wienerEnvelope_of_integrable hf.1 zero_lt_one (norm_nonneg _) hf.2
  have hgmp : MeasurePreserving g := by
    dsimp [g, e]
    exact MeasurePreserving.symm
      (EuclideanSpace.finAddEquivProd (𝕜 := ℝ)).toHomeomorph.toMeasurableEquiv
      (aux_finAdd_measurePreserving n m)
  have hcomp : Integrable (wienerEnvelope f ‖g‖ ∘ g) :=
    hgmp.integrable_comp_of_integrable hrad
  refine hcomp.mono_nonneg (continuous_wienerEnvelope hF 1).aestronglyMeasurable
    (ae_of_all _ fun p => aux_wienerEnvelope_nonneg hF zero_le_one p)
    (ae_of_all _ fun p => ?_)
  exact aux_wienerEnvelope_comp_continuousLinearMap_le g hf.1 p

/-- Pullback along an injective linear map with a product Euclidean domain preserves `W₀`. -/
theorem MemW0.aux_comp_injective_continuousLinearMap_prod
    {m l n : ℕ} {𝕜 : Type*} [NormedAddCommGroup 𝕜]
    {f : EuclideanSpace ℝ (Fin n) → 𝕜} (hf : MemW0 f)
    (π : (EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l)) →L[ℝ]
      EuclideanSpace ℝ (Fin n))
    (hπ : Function.Injective π) :
    MemW0 (fun uv => f (π uv)) := by
  let e : EuclideanSpace ℝ (Fin (m + l)) ≃L[ℝ]
      (EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l)) :=
    EuclideanSpace.finAddEquivProd
  let A : EuclideanSpace ℝ (Fin (m + l)) →L[ℝ]
      EuclideanSpace ℝ (Fin n) := π.comp e.toContinuousLinearMap
  have hAinj : Function.Injective A := hπ.comp e.injective
  have hA : MemW0 (f ∘ A) := hf.aux_comp_injective_continuousLinearMap A hAinj
  have hP := aux_memW0_comp_finAddEquivProd_symm hA
  simpa [A, e, Function.comp_def] using hP

/-- \begin{proposition}\label{W_0 fiber integrals}
For every injective linear map $\pi:\R^{m}\times \R^{l}\to \R^n$ with $m,l\in\N$, $1\le m+l\le n$
there are $0<C_{\ref{W_0 fiber integrals},\pi,1},
C_{\ref{W_0 fiber integrals},\pi,2}<\infty$ such that the following holds.
For every $f\in W_0(n)$ and $u\in\R^m$, the function $h_u$ defined by
\begin{equation}
    h_u(v)=f(\pi(u,v))
\end{equation}
is in $W_0(l)$ with
\begin{equation}\label{W_0 on fiber}
    \|h_u\|_{W_0}\le C_{\ref{W_0 fiber integrals},\pi,1} \|f\|_{W_0}\, .
\end{equation}
The function $g:\Rm\to \C$ defined by
\[ g(u) := \int_{\R^l} f(\pi(u,v)) \,dv= \int_{\R^l} h_u(v) \,dv \]
is in $W_0(m)$ with
\begin{equation}\label{W_0 across fibers}
    \|g\|_{W_0}\le C_{\ref{W_0 fiber integrals},\pi,2}  \|f\|_{W_0}\, .
\end{equation}
\end{proposition} -/
theorem exists_wienerEnvelope_fiber_and_integral_comp_injective_continuousLinearMap_bound
    {m l n : ℕ} {K : Type*} [NormedAddCommGroup K] [NormedSpace ℝ K]
    (π : (EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l)) →L[ℝ]
      EuclideanSpace ℝ (Fin n))
    (hπ : Function.Injective π) :
    ∃ C₁ C₂ : ℝ, 0 < C₁ ∧ 0 < C₂ ∧ ∀ f : EuclideanSpace ℝ (Fin n) → K, MemW0 f →
      (∀ u : EuclideanSpace ℝ (Fin m),
        MemW0 (fun v : EuclideanSpace ℝ (Fin l) => f (π (u, v))) ∧
        (∫ v, wienerEnvelope (fun v : EuclideanSpace ℝ (Fin l) => f (π (u, v))) 1 v) ≤
          C₁ * ∫ y, wienerEnvelope f 1 y) ∧
      MemW0 (fun u : EuclideanSpace ℝ (Fin m) => ∫ v, f (π (u, v))) ∧
      (∫ u, wienerEnvelope (fun u : EuclideanSpace ℝ (Fin m) => ∫ v, f (π (u, v))) 1 u) ≤
        C₂ * ∫ y, wienerEnvelope f 1 y := by
  classical
  let : MeasureSpace (EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l)) :=
    ⟨(volume : Measure (EuclideanSpace ℝ (Fin m))).prod
      (volume : Measure (EuclideanSpace ℝ (Fin l)))⟩
  let : Measure.IsAddHaarMeasure
      (volume : Measure (EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l))) := by
    change Measure.IsAddHaarMeasure
      ((volume : Measure (EuclideanSpace ℝ (Fin m))).prod
        (volume : Measure (EuclideanSpace ℝ (Fin l))))
    infer_instance
  let e : EuclideanSpace ℝ (Fin (m + l)) ≃L[ℝ]
      EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l) :=
    EuclideanSpace.finAddEquivProd
  let g : EuclideanSpace ℝ (Fin (m + l)) →L[ℝ] EuclideanSpace ℝ (Fin n) :=
    π.comp e.toContinuousLinearMap
  have hg : Function.Injective g := hπ.comp e.injective
  obtain ⟨Cg, hCg_pos, hCg⟩ :=
    aux_exists_wienerEnvelope_comp_injective_continuousLinearMap_bound (K := K) g hg
  obtain ⟨Ce, hCe_pos, hCe⟩ :=
    aux_exists_wienerEnvelope_comp_continuousLinearEquiv_bound (K := K) e.symm
  let B : ℝ := (volume.real (closedBall (0 : EuclideanSpace ℝ (Fin m)) 1))⁻¹
  have hB_pos : 0 < B := by
    have hball_pos : 0 < volume.real (closedBall (0 : EuclideanSpace ℝ (Fin m)) 1) := by
      apply ENNReal.toReal_pos
      · exact
          (measure_ball_pos (volume : Measure (EuclideanSpace ℝ (Fin m))) 0 zero_lt_one).trans_le
            (measure_mono ball_subset_closedBall) |>.ne'
      · exact measure_closedBall_lt_top.ne
    exact inv_pos.mpr (by simpa only [B] using hball_pos)
  refine ⟨B * (Ce * Cg), Ce * Cg, mul_pos hB_pos (mul_pos hCe_pos hCg_pos),
    mul_pos hCe_pos hCg_pos, ?_⟩
  intro f hf
  let P : EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l) → K := fun uv => f (π uv)
  have hP : MemW0 P := by
    simpa only [P] using hf.aux_comp_injective_continuousLinearMap_prod π hπ
  have hH : MemW0 (f ∘ g) := hf.aux_comp_injective_continuousLinearMap g hg
  have hP_eq : ((f ∘ g) ∘ e.symm) = P := by
    funext uv
    simp only [Function.comp_apply, g, P, ContinuousLinearMap.comp_apply]
    change f (π (e (e.symm uv))) = f (π uv)
    rw [e.apply_symm_apply]
  have hP_bound : (∫ uv, wienerEnvelope P 1 uv) ≤
      (Ce * Cg) * ∫ y, wienerEnvelope f 1 y := by
    calc
      (∫ uv, wienerEnvelope P 1 uv) = ∫ uv, wienerEnvelope ((f ∘ g) ∘ e.symm) 1 uv := by
        rw [hP_eq]
      _ ≤ Ce * ∫ z, wienerEnvelope (f ∘ g) 1 z := hCe (f ∘ g) hH
      _ ≤ Ce * (Cg * ∫ y, wienerEnvelope f 1 y) :=
        mul_le_mul_of_nonneg_left (hCg f hf) hCe_pos.le
      _ = (Ce * Cg) * ∫ y, wienerEnvelope f 1 y := by ring
  have hG : MemW0 (fun u : EuclideanSpace ℝ (Fin m) => ∫ v, f (π (u, v))) := by
    simpa only [P] using hP.aux_integral_slice
  refine ⟨?_, hG, ?_⟩
  · intro u
    have hslice_mem : MemW0 (fun v : EuclideanSpace ℝ (Fin l) => f (π (u, v))) := by
      simpa only [P] using hP.aux_memW0_slice u
    refine ⟨hslice_mem, ?_⟩
    calc
      (∫ v, wienerEnvelope (fun v : EuclideanSpace ℝ (Fin l) => f (π (u, v))) 1 v) ≤
          B * ∫ uv, wienerEnvelope P 1 uv := by
        simpa only [B, P] using
          aux_integral_wienerEnvelope_slice_le_unitClosedBallVolume_inv_mul hP u
      _ ≤ B * ((Ce * Cg) * ∫ y, wienerEnvelope f 1 y) :=
        mul_le_mul_of_nonneg_left hP_bound hB_pos.le
      _ = (B * (Ce * Cg)) * ∫ y, wienerEnvelope f 1 y := by ring
  · calc
      (∫ u, wienerEnvelope (fun u : EuclideanSpace ℝ (Fin m) => ∫ v, f (π (u, v))) 1 u) ≤
          ∫ uv, wienerEnvelope P 1 uv := by
        simpa only [P] using aux_integral_wienerEnvelope_integral_slice_le hP
      _ ≤ (Ce * Cg) * ∫ y, wienerEnvelope f 1 y := hP_bound

/-- Each coordinate block has norm at most the norm of the whole Euclidean vector. -/
theorem aux_norm_finAdd_fst_le {n m : ℕ} (w : EuclideanSpace ℝ (Fin (n + m))) :
    ‖(EuclideanSpace.finAddEquivProd w).1‖ ≤ ‖w‖ := by
  let e₁ : EuclideanSpace ℝ (Fin (n + m)) ≃ₗᵢ[ℝ]
      EuclideanSpace ℝ (Fin n ⊕ Fin m) :=
    LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ finSumFinEquiv.symm
  let e₂ : EuclideanSpace ℝ (Fin n ⊕ Fin m) ≃ₗᵢ[ℝ]
      WithLp 2 (EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin m)) :=
    PiLp.sumPiLpEquivProdLpPiLp 2 (fun _ : Fin n ⊕ Fin m ↦ ℝ)
  let e₃ : WithLp 2 (EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin m)) ≃L[ℝ]
      EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin m) :=
    WithLp.prodContinuousLinearEquiv 2 ℝ _ _
  change ‖((e₂ (e₁ w)).ofLp).1‖ ≤ ‖w‖
  change ‖(e₂ (e₁ w)).fst‖ ≤ ‖w‖
  calc
    ‖(e₂ (e₁ w)).fst‖ ≤ ‖e₂ (e₁ w)‖ :=
      WithLp.norm_fst_le (EuclideanSpace ℝ (Fin n)) (e₂ (e₁ w))
    _ = ‖e₁ w‖ := e₂.norm_map _
    _ = ‖w‖ := e₁.norm_map _

/-- Each coordinate block has norm at most the norm of the whole Euclidean vector. -/
theorem aux_norm_finAdd_snd_le {n m : ℕ} (w : EuclideanSpace ℝ (Fin (n + m))) :
    ‖(EuclideanSpace.finAddEquivProd w).2‖ ≤ ‖w‖ := by
  let e₁ : EuclideanSpace ℝ (Fin (n + m)) ≃ₗᵢ[ℝ]
      EuclideanSpace ℝ (Fin n ⊕ Fin m) :=
    LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ finSumFinEquiv.symm
  let e₂ : EuclideanSpace ℝ (Fin n ⊕ Fin m) ≃ₗᵢ[ℝ]
      WithLp 2 (EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin m)) :=
    PiLp.sumPiLpEquivProdLpPiLp 2 (fun _ : Fin n ⊕ Fin m ↦ ℝ)
  let e₃ : WithLp 2 (EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin m)) ≃L[ℝ]
      EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin m) :=
    WithLp.prodContinuousLinearEquiv 2 ℝ _ _
  change ‖((e₂ (e₁ w)).ofLp).2‖ ≤ ‖w‖
  change ‖(e₂ (e₁ w)).snd‖ ≤ ‖w‖
  calc
    ‖(e₂ (e₁ w)).snd‖ ≤ ‖e₂ (e₁ w)‖ :=
      WithLp.norm_snd_le (EuclideanSpace ℝ (Fin n)) (e₂ (e₁ w))
    _ = ‖e₁ w‖ := e₂.norm_map _
    _ = ‖w‖ := e₁.norm_map _

/-- The coordinate splitting does not increase norm. -/
theorem aux_norm_finAdd_le {n m : ℕ} (w : EuclideanSpace ℝ (Fin (n + m))) :
    ‖EuclideanSpace.finAddEquivProd w‖ ≤ ‖w‖ := by
  rw [Prod.norm_def]
  exact max_le (aux_norm_finAdd_fst_le w) (aux_norm_finAdd_snd_le w)

/-- Pulling a binary tensor product back along the Euclidean coordinate splitting can only
decrease its local envelope. -/
theorem aux_wienerEnvelope_finAdd_tensor_le {n m : ℕ} {𝕜 : Type*} [NormedField 𝕜]
    {f : EuclideanSpace ℝ (Fin n) → 𝕜} {g : EuclideanSpace ℝ (Fin m) → 𝕜}
    (hf : Continuous f) (hg : Continuous g) (z : EuclideanSpace ℝ (Fin (n + m))) :
    wienerEnvelope (fun w : EuclideanSpace ℝ (Fin (n + m)) ↦
      f (EuclideanSpace.finAddEquivProd w).1 * g (EuclideanSpace.finAddEquivProd w).2) 1 z ≤
      wienerEnvelope (fun p : EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin m) ↦
        f p.1 * g p.2) 1 (EuclideanSpace.finAddEquivProd z) := by
  let e : EuclideanSpace ℝ (Fin (n + m)) ≃L[ℝ]
      EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin m) :=
    EuclideanSpace.finAddEquivProd
  let H : EuclideanSpace ℝ (Fin (n + m)) → 𝕜 := fun w ↦ f (e w).1 * g (e w).2
  let P : EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin m) → 𝕜 := fun p ↦ f p.1 * g p.2
  have hP : Continuous P := (hf.comp continuous_fst).mul (hg.comp continuous_snd)
  change wienerEnvelope H 1 z ≤ wienerEnvelope P 1 (e z)
  unfold wienerEnvelope
  apply csSup_le ((Metric.nonempty_closedBall.mpr zero_le_one).image _)
  rintro _ ⟨w, hw, rfl⟩
  change ‖H (z + w)‖ ≤ _
  have hw' : e w ∈ closedBall (0 : EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin m)) 1 := by
    simpa [Metric.mem_closedBall, dist_eq_norm, e] using (aux_norm_finAdd_le w).trans
      (by simpa [Metric.mem_closedBall, dist_eq_norm] using hw)
  have headd : e (z + w) = e z + e w := by
    exact (EuclideanSpace.finAddEquivProd :
      EuclideanSpace ℝ (Fin (n + m)) ≃L[ℝ]
        EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin m)).map_add z w
  rw [show H (z + w) = P (e (z + w)) by rfl, headd]
  apply aux_norm_le_wienerEnvelope_of_mem_closedBall hP
  simpa [Metric.mem_closedBall, dist_eq_norm] using hw'

/-- The Euclidean binary tensor product belongs to `W₀` once its product-coordinate version does. -/
theorem aux_memW0_finAdd_tensor_of_memW0_prod {n m : ℕ} {𝕜 : Type*} [NormedField 𝕜]
    {f : EuclideanSpace ℝ (Fin n) → 𝕜} {g : EuclideanSpace ℝ (Fin m) → 𝕜}
    (hf : Continuous f) (hg : Continuous g)
    (hprod : MemW0 (fun p : EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin m) ↦
      f p.1 * g p.2)) :
    MemW0 (fun z : EuclideanSpace ℝ (Fin (n + m)) ↦
      f (EuclideanSpace.finAddEquivProd z).1 * g (EuclideanSpace.finAddEquivProd z).2) := by
  let e : EuclideanSpace ℝ (Fin (n + m)) ≃L[ℝ]
      EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin m) :=
    EuclideanSpace.finAddEquivProd
  let H : EuclideanSpace ℝ (Fin (n + m)) → 𝕜 := fun z ↦ f (e z).1 * g (e z).2
  let P : EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin m) → 𝕜 := fun p ↦ f p.1 * g p.2
  have hH : Continuous H := (hf.comp (e.continuous.fst)).mul (hg.comp (e.continuous.snd))
  have hP : Continuous P := (hf.comp continuous_fst).mul (hg.comp continuous_snd)
  change MemW0 H
  refine ⟨hH, ?_⟩
  have hcomp : Integrable (wienerEnvelope P 1 ∘ e) :=
    (aux_finAdd_measurePreserving n m).integrable_comp_emb
      e.toHomeomorph.measurableEmbedding |>.mpr hprod.2
  refine hcomp.mono_nonneg (continuous_wienerEnvelope hH 1).aestronglyMeasurable
    (ae_of_all _ fun z ↦ aux_wienerEnvelope_nonneg hH zero_le_one z) (ae_of_all _ fun z ↦ ?_)
  exact aux_wienerEnvelope_finAdd_tensor_le hf hg z

/-- The finite-dimensional tensor-product property in Euclidean coordinates. -/
theorem MemW0.aux_mul_finAdd {n m : ℕ} {𝕜 : Type*} [NormedField 𝕜]
    {f : EuclideanSpace ℝ (Fin n) → 𝕜} {g : EuclideanSpace ℝ (Fin m) → 𝕜}
    (hf : MemW0 f) (hg : MemW0 g) :
    MemW0 (fun z : EuclideanSpace ℝ (Fin (n + m)) ↦
      f (EuclideanSpace.finAddEquivProd z).1 * g (EuclideanSpace.finAddEquivProd z).2) :=
  aux_memW0_finAdd_tensor_of_memW0_prod hf.1 hg.1 (hf.aux_mul_prod hg)

/-- The Euclidean-coordinate tensor product obeys the same Wiener-integral estimate. -/
theorem aux_wienerNormOne_finAdd_tensor_le {n m : ℕ} {𝕜 : Type*} [NormedField 𝕜]
    {f : EuclideanSpace ℝ (Fin n) → 𝕜} {g : EuclideanSpace ℝ (Fin m) → 𝕜}
    (hf : Continuous f) (hg : Continuous g) :
    wienerNormOne (fun z : EuclideanSpace ℝ (Fin (n + m)) ↦
      f (EuclideanSpace.finAddEquivProd z).1 * g (EuclideanSpace.finAddEquivProd z).2) ≤
      wienerNormOne f * wienerNormOne g := by
  let e : EuclideanSpace ℝ (Fin (n + m)) ≃L[ℝ]
      EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin m) :=
    EuclideanSpace.finAddEquivProd
  let H : EuclideanSpace ℝ (Fin (n + m)) → 𝕜 := fun z ↦ f (e z).1 * g (e z).2
  let P : EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin m) → 𝕜 := fun p ↦ f p.1 * g p.2
  have hP : Continuous P := (hf.comp continuous_fst).mul (hg.comp continuous_snd)
  change wienerNormOne H ≤ wienerNormOne f * wienerNormOne g
  calc
    wienerNormOne H ≤ wienerNormOne P := by
      unfold wienerNormOne wienerNorm
      calc
        (∫⁻ z, ENNReal.ofReal (wienerEnvelope H 1 z)) ≤
            ∫⁻ z, ENNReal.ofReal (wienerEnvelope P 1 (e z)) := by
          apply lintegral_mono
          intro z
          exact ENNReal.ofReal_le_ofReal (aux_wienerEnvelope_finAdd_tensor_le hf hg z)
        _ = ∫⁻ p, ENNReal.ofReal (wienerEnvelope P 1 p) :=
          (aux_finAdd_measurePreserving n m).lintegral_comp
            (ENNReal.continuous_ofReal.measurable.comp (continuous_wienerEnvelope hP 1).measurable)
    _ ≤ wienerNormOne f * wienerNormOne g := aux_wienerNormOne_mul_prod_le hf hg

/-- A finite tensor product of continuous functions is continuous. -/
theorem aux_continuous_fintype_tensor {ι : Type*} [Fintype ι]
    {d : ι → ℕ} {𝕜 : Type*} [NormedField 𝕜]
    {f : ∀ i, EuclideanSpace ℝ (Fin (d i)) → 𝕜} (hf : ∀ i, Continuous (f i)) :
    Continuous (fun x : ∀ i, EuclideanSpace ℝ (Fin (d i)) ↦ ∏ i, f i (x i)) := by
  classical
  exact continuous_finsetProd Finset.univ fun i _ ↦ (hf i).comp (continuous_apply i)

/-- The local envelope of a finite tensor product is at most the product of the individual
local envelopes. -/
theorem aux_wienerEnvelope_fintype_tensor_le {ι : Type*} [Fintype ι]
    {d : ι → ℕ} {𝕜 : Type*} [NormedField 𝕜]
    {f : ∀ i, EuclideanSpace ℝ (Fin (d i)) → 𝕜} (hf : ∀ i, Continuous (f i))
    (x : ∀ i, EuclideanSpace ℝ (Fin (d i))) :
    wienerEnvelope (fun y : ∀ i, EuclideanSpace ℝ (Fin (d i)) ↦ ∏ i, f i (y i)) 1 x ≤
      ∏ i, wienerEnvelope (f i) 1 (x i) := by
  classical
  unfold wienerEnvelope
  apply csSup_le ((Metric.nonempty_closedBall.mpr zero_le_one).image _)
  rintro _ ⟨z, hz, rfl⟩
  change ‖∏ i, f i ((x + z) i)‖ ≤ ∏ i, wienerEnvelope (f i) 1 (x i)
  rw [norm_prod]
  refine Finset.prod_le_prod ?_ ?_
  · intro i _
    exact norm_nonneg _
  · intro i _
    apply aux_norm_le_wienerEnvelope_of_mem_closedBall (hf i)
    have hz_norm : ‖z‖ ≤ 1 := by
      simpa [Metric.mem_closedBall, dist_eq_norm] using hz
    have hzi : ‖z i‖ ≤ 1 := (norm_le_pi_norm z i).trans hz_norm
    simpa [Metric.mem_closedBall, dist_eq_norm] using hzi

/--
Then $f\in W_0(|I|)$.
-/
theorem MemW0.fintype_tensor {ι : Type*} [Fintype ι]
    {d : ι → ℕ} {𝕜 : Type*} [NormedField 𝕜]
    {f : ∀ i, EuclideanSpace ℝ (Fin (d i)) → 𝕜} (hf : ∀ i, MemW0 (f i)) :
    MemW0 (fun x : ∀ i, EuclideanSpace ℝ (Fin (d i)) ↦ ∏ i, f i (x i)) := by
  classical
  have hcont : Continuous (fun x : ∀ i, EuclideanSpace ℝ (Fin (d i)) ↦
      ∏ i, f i (x i)) :=
    aux_continuous_fintype_tensor fun i ↦ (hf i).1
  refine ⟨hcont, ?_⟩
  have hprod : Integrable (fun x : ∀ i, EuclideanSpace ℝ (Fin (d i)) ↦
      ∏ i, wienerEnvelope (f i) 1 (x i)) := by
    exact Integrable.fintype_prod_dep fun i ↦ (hf i).2
  refine hprod.mono_nonneg (continuous_wienerEnvelope hcont 1).aestronglyMeasurable
    (ae_of_all _ fun x ↦ aux_wienerEnvelope_nonneg hcont zero_le_one x)
    (ae_of_all _ fun x ↦ ?_)
  exact aux_wienerEnvelope_fintype_tensor_le (fun i ↦ (hf i).1) x

/--
\begin{equation}\label{product W_0}
    \|f\|_{W_0}\le \prod_{j\in [J)}\|f_j\|_{W_0}\, .
\end{equation}
-/
theorem fintype_tensor_wienerNorm_le {ι : Type*} [Fintype ι]
    {d : ι → ℕ} {𝕜 : Type*} [NormedField 𝕜]
    {f : ∀ i, EuclideanSpace ℝ (Fin (d i)) → 𝕜} (hf : ∀ i, MemW0 (f i)) :
    (∫ x : ∀ i, EuclideanSpace ℝ (Fin (d i)),
      wienerEnvelope (fun y : ∀ i, EuclideanSpace ℝ (Fin (d i)) ↦ ∏ i, f i (y i)) 1 x) ≤
      ∏ i, ∫ x, wienerEnvelope (f i) 1 x := by
  classical
  have hTensor := MemW0.fintype_tensor hf
  have hprod : Integrable (fun x : ∀ i, EuclideanSpace ℝ (Fin (d i)) ↦
      ∏ i, wienerEnvelope (f i) 1 (x i)) := by
    exact Integrable.fintype_prod_dep fun i ↦ (hf i).2
  calc
    (∫ x : ∀ i, EuclideanSpace ℝ (Fin (d i)),
      wienerEnvelope (fun y : ∀ i, EuclideanSpace ℝ (Fin (d i)) ↦ ∏ i, f i (y i)) 1 x) ≤
        ∫ x : ∀ i, EuclideanSpace ℝ (Fin (d i)), ∏ i, wienerEnvelope (f i) 1 (x i) :=
      integral_mono hTensor.2 hprod
        (fun x ↦ aux_wienerEnvelope_fintype_tensor_le (fun i ↦ (hf i).1) x)
    _ = ∏ i, ∫ x, wienerEnvelope (f i) 1 x :=
      integral_fintype_prod_volume_eq_prod (fun i ↦ wienerEnvelope (f i) 1)

/-- An injective simultaneous linear pullback of a finite tensor product belongs to `W₀`. -/
theorem MemW0.aux_fintype_tensor_comp_injective
    {ι : Type*} [Fintype ι] {m l : ℕ} {d : ι → ℕ}
    {𝕜 : Type*} [NormedField 𝕜]
    {f : ∀ i, EuclideanSpace ℝ (Fin (d i)) → 𝕜} (hf : ∀ i, MemW0 (f i))
    (π : ∀ i, (EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l)) →L[ℝ]
      EuclideanSpace ℝ (Fin (d i)))
    (hπ : Function.Injective (ContinuousLinearMap.pi π)) :
    MemW0 (fun uv : EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l) ↦
      ∏ i, f i (π i uv)) := by
  classical
  let eIdx : Fin (Fintype.card (Σ i, Fin (d i))) ≃ Σ i, Fin (d i) :=
    (Fintype.equivFin (Σ i, Fin (d i))).symm
  let e₁ : EuclideanSpace ℝ (Fin (Fintype.card (Σ i, Fin (d i)))) ≃ₗᵢ[ℝ]
      EuclideanSpace ℝ (Σ i, Fin (d i)) :=
    LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ eIdx
  let e₂ : EuclideanSpace ℝ (Σ i, Fin (d i)) ≃ₗᵢ[ℝ]
      WithLp 2 (∀ i, EuclideanSpace ℝ (Fin (d i))) :=
    LinearIsometryEquiv.piLpCurry ℝ 2 (fun i => fun _ : Fin (d i) => ℝ)
  let e₃ : WithLp 2 (∀ i, EuclideanSpace ℝ (Fin (d i))) ≃L[ℝ]
      (∀ i, EuclideanSpace ℝ (Fin (d i))) :=
    (WithLp.linearEquiv 2 ℝ _).toContinuousLinearEquiv
  let e : EuclideanSpace ℝ (Fin (Fintype.card (Σ i, Fin (d i)))) ≃L[ℝ]
      (∀ i, EuclideanSpace ℝ (Fin (d i))) :=
    e₁.toContinuousLinearEquiv.trans (e₂.toContinuousLinearEquiv.trans e₃)
  let H : (∀ i, EuclideanSpace ℝ (Fin (d i))) → 𝕜 := fun x ↦ ∏ i, f i (x i)
  have hH : MemW0 H := MemW0.fintype_tensor hf
  have hF : MemW0 (H ∘ e) := by
    apply hH.aux_comp_continuousLinearEquiv_between_of_integrable_radius e
    exact aux_integrable_wienerEnvelope_of_integrable' hH.1 zero_lt_one (norm_nonneg _) hH.2
  let A : (EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l)) →L[ℝ]
      EuclideanSpace ℝ (Fin (Fintype.card (Σ i, Fin (d i)))) :=
    e.symm.toContinuousLinearMap.comp (ContinuousLinearMap.pi π)
  have hA : Function.Injective A := e.symm.injective.comp hπ
  have hFA := hF.aux_comp_injective_continuousLinearMap_prod A hA
  simpa [H, A, Function.comp_def] using hFA

/-- The kernel condition in the Brascamp--Lieb corollary says precisely that the combined
coordinate map is injective. -/
theorem aux_continuousLinearMap_pi_injective_of_iInf_ker_eq_bot
    {ι : Type*} {m l : ℕ} {d : ι → ℕ}
    (pi : ∀ i, (EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l)) →L[ℝ]
      EuclideanSpace ℝ (Fin (d i)))
    (hker : ⨅ i, LinearMap.ker (pi i).toLinearMap = ⊥) :
    Function.Injective (ContinuousLinearMap.pi pi) := by
  let A : (EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l)) →ₗ[ℝ]
      (∀ i, EuclideanSpace ℝ (Fin (d i))) :=
    LinearMap.pi (fun i ↦ (pi i).toLinearMap)
  have hA : Function.Injective A := LinearMap.ker_eq_bot.mp (by
    rw [LinearMap.ker_pi]
    exact hker)
  intro x y hxy
  apply hA
  change (fun i ↦ pi i x) = fun i ↦ pi i y
  exact hxy

/-- The kernel-intersection hypothesis in the Brascamp--Lieb consequence yields the required
injectivity of its simultaneous pullback. -/
theorem MemW0.aux_fintype_tensor_comp_of_iInf_ker_eq_bot
    {ι : Type*} [Fintype ι] {m l : ℕ} {d : ι → ℕ}
    {𝕜 : Type*} [NormedField 𝕜]
    {f : ∀ i, EuclideanSpace ℝ (Fin (d i)) → 𝕜} (hf : ∀ i, MemW0 (f i))
    (π : ∀ i, (EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l)) →L[ℝ]
      EuclideanSpace ℝ (Fin (d i)))
    (hker : ⨅ i, LinearMap.ker (π i).toLinearMap = ⊥) :
    MemW0 (fun uv : EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l) ↦
      ∏ i, f i (π i uv)) :=
  MemW0.aux_fintype_tensor_comp_injective hf π
    (aux_continuousLinearMap_pi_injective_of_iInf_ker_eq_bot π hker)

/-- \begin{proposition}\label{W_0 Brascamp Lieb}
 Let $m,l\in\N$, $m+l\le n$ and assume $l\neq 0$.
Let $J\in \N_{\ge 1}$. For $j\in [J)$, let $l_j\in \N$ and let $\Pi_j:\R^m\times \R^l \to \R^{l_j}$
be a linear map such that
\begin{equation}\label{pi injective}
    \bigcap_{j\in [J)} {\rm ker}\Pi_j=\{0\}\, .
\end{equation}
Then there is $0<C_{\ref{W_0 Brascamp Lieb},(\Pi_j)_{j\in [J)}}<\infty$ such that
the following holds.
For $j\in [J)$, let $f_j\in W_0(\R^{l_j})$. Then for each
 $u\in \R^m$, the function
 \begin{equation}
     v\to \prod_{j\in [J)}f_j(\Pi_{j}(u,v))
 \end{equation}
 is in $W_0(\R^l)$ and with $f$ defined by
    \begin{equation}
        f(u):=\int_{\R^l}\prod_{j\in [J)}f_j(\Pi_{j}(u,v))\, dv \, ,
    \end{equation}
    we have $f\in W_0(\R^{m})$ and
    \begin{equation}
        \|f\|_{W_0}\le C_{\ref{W_0 Brascamp Lieb},(\Pi_j)_{j\in [J)}}
          \prod_{j\in [J)}\|f_j\|_{W_0}\, .
    \end{equation}
\end{proposition} -/
theorem exists_brascamp_lieb_memW0
    {ι : Type*} [Fintype ι] {m l : ℕ} {d : ι → ℕ}
    {K : Type*} [NormedField K] [NormedSpace ℝ K]
    (π : ∀ i, (EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l)) →L[ℝ]
      EuclideanSpace ℝ (Fin (d i)))
    (hker : ⨅ i, LinearMap.ker (π i).toLinearMap = ⊥) :
    ∃ C : ℝ, 0 < C ∧ ∀ f : ∀ i, EuclideanSpace ℝ (Fin (d i)) → K,
      (∀ i, MemW0 (f i)) →
      (∀ u : EuclideanSpace ℝ (Fin m),
        MemW0 (fun v : EuclideanSpace ℝ (Fin l) => ∏ i, f i (π i (u, v)))) ∧
      MemW0 (fun u : EuclideanSpace ℝ (Fin m) =>
        ∫ v, ∏ i, f i (π i (u, v))) ∧
      (∫ u, wienerEnvelope
        (fun u : EuclideanSpace ℝ (Fin m) => ∫ v, ∏ i, f i (π i (u, v))) 1 u) ≤
        C * ∏ i, ∫ x, wienerEnvelope (f i) 1 x := by
  classical
  let eIdx : Fin (Fintype.card (Σ i, Fin (d i))) ≃ Σ i, Fin (d i) :=
    (Fintype.equivFin (Σ i, Fin (d i))).symm
  let e₁ : EuclideanSpace ℝ (Fin (Fintype.card (Σ i, Fin (d i)))) ≃ₗᵢ[ℝ]
      EuclideanSpace ℝ (Σ i, Fin (d i)) :=
    LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ eIdx
  let e₂ : EuclideanSpace ℝ (Σ i, Fin (d i)) ≃ₗᵢ[ℝ]
      WithLp 2 (∀ i, EuclideanSpace ℝ (Fin (d i))) :=
    LinearIsometryEquiv.piLpCurry ℝ 2 (fun i => fun _ : Fin (d i) => ℝ)
  let e₃ : WithLp 2 (∀ i, EuclideanSpace ℝ (Fin (d i))) ≃L[ℝ]
      (∀ i, EuclideanSpace ℝ (Fin (d i))) :=
    (WithLp.linearEquiv 2 ℝ _).toContinuousLinearEquiv
  let e : EuclideanSpace ℝ (Fin (Fintype.card (Σ i, Fin (d i)))) ≃L[ℝ]
      (∀ i, EuclideanSpace ℝ (Fin (d i))) :=
    e₁.toContinuousLinearEquiv.trans (e₂.toContinuousLinearEquiv.trans e₃)
  let A : (EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l)) →L[ℝ]
      EuclideanSpace ℝ (Fin (Fintype.card (Σ i, Fin (d i)))) :=
    e.symm.toContinuousLinearMap.comp (ContinuousLinearMap.pi π)
  have hπ : Function.Injective (ContinuousLinearMap.pi π) :=
    aux_continuousLinearMap_pi_injective_of_iInf_ker_eq_bot π hker
  have hA : Function.Injective A := e.symm.injective.comp hπ
  obtain ⟨C₁, C₂, hC₁_pos, hC₂_pos, hA_bound⟩ :=
    exists_wienerEnvelope_fiber_and_integral_comp_injective_continuousLinearMap_bound (K := K) A hA
  obtain ⟨Ce, hCe_pos, hCe⟩ :=
    aux_exists_wienerEnvelope_comp_continuousLinearEquiv_bound (K := K) e
  refine ⟨C₂ * Ce, mul_pos hC₂_pos hCe_pos, ?_⟩
  intro f hf
  let H : (∀ i, EuclideanSpace ℝ (Fin (d i))) → K := fun x => ∏ i, f i (x i)
  let F : EuclideanSpace ℝ (Fin (Fintype.card (Σ i, Fin (d i)))) → K := H ∘ e
  let P : EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l) → K :=
    fun uv => ∏ i, f i (π i uv)
  have hH : MemW0 H := MemW0.fintype_tensor hf
  have hF : MemW0 F := by
    apply hH.aux_comp_continuousLinearEquiv_between_of_integrable_radius e
    exact aux_integrable_wienerEnvelope_of_integrable' hH.1 zero_lt_one
      (norm_nonneg e.toContinuousLinearMap) hH.2
  have hfun : (fun uv => F (A uv)) = P := by
    funext uv
    change H (e (e.symm ((ContinuousLinearMap.pi π) uv))) = _
    rw [e.apply_symm_apply]
    rfl
  obtain ⟨hSlices, hG, hGbound⟩ := hA_bound F hF
  have hFbound : (∫ z, wienerEnvelope F 1 z) ≤
      Ce * ∫ x, wienerEnvelope H 1 x := by
    simpa [F] using hCe H hH
  have hHbound : (∫ x, wienerEnvelope H 1 x) ≤
      ∏ i, ∫ x, wienerEnvelope (f i) 1 x := by
    simpa [H] using fintype_tensor_wienerNorm_le hf
  have hGfun : (fun u : EuclideanSpace ℝ (Fin m) => ∫ v, F (A (u, v))) =
      fun u => ∫ v, P (u, v) := by
    funext u
    congr with v
    exact congrFun hfun (u, v)
  refine ⟨?_, ?_, ?_⟩
  · intro u
    have hs := hSlices u
    have hslice_eq : (fun v : EuclideanSpace ℝ (Fin l) => F (A (u, v))) =
        fun v => P (u, v) := by
      funext v
      exact congrFun hfun (u, v)
    rw [hslice_eq] at hs
    simpa only [P] using hs.1
  · rw [hGfun] at hG
    simpa only [P] using hG
  · calc
      (∫ u, wienerEnvelope (fun u : EuclideanSpace ℝ (Fin m) =>
          ∫ v, ∏ i, f i (π i (u, v))) 1 u) =
          ∫ u, wienerEnvelope (fun u : EuclideanSpace ℝ (Fin m) =>
            ∫ v, F (A (u, v))) 1 u := by rw [hGfun]
      _ ≤ C₂ * ∫ z, wienerEnvelope F 1 z := hGbound
      _ ≤ C₂ * (Ce * ∫ x, wienerEnvelope H 1 x) :=
        mul_le_mul_of_nonneg_left hFbound hC₂_pos.le
      _ ≤ C₂ * (Ce * ∏ i, ∫ x, wienerEnvelope (f i) 1 x) := by
        gcongr
      _ = (C₂ * Ce) * ∏ i, ∫ x, wienerEnvelope (f i) 1 x := by ring

/-- The compositional Brascamp--Lieb step from the draft.  The two pullback hypotheses are
exactly the analytic content of the preceding fibre-integral proposition for the combined
injective map; keeping them explicit avoids concealing that geometric estimate. -/
theorem aux_brascamp_lieb_of_memW0_pullback
    {ι : Type*} [Fintype ι] {m l : ℕ} {d : ι → ℕ}
    {𝕜 : Type*} [NormedField 𝕜] [NormedSpace ℝ 𝕜]
    (f : ∀ i, EuclideanSpace ℝ (Fin (d i)) → 𝕜) (hf : ∀ i, MemW0 (f i))
    (pi : ∀ i, (EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l)) →L[ℝ]
      EuclideanSpace ℝ (Fin (d i)))
    (hPullback : MemW0 (fun uv : EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l) ↦
      ∏ i, f i (pi i uv)))
    {C : ℝ} (hC : 0 ≤ C)
    (hPullback_bound :
      (∫ uv : EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l),
        wienerEnvelope (fun uv ↦ ∏ i, f i (pi i uv)) 1 uv) ≤
        C * ∫ x : ∀ i, EuclideanSpace ℝ (Fin (d i)),
          wienerEnvelope (fun y ↦ ∏ i, f i (y i)) 1 x) :
    MemW0 (fun x : ∀ i, EuclideanSpace ℝ (Fin (d i)) ↦ ∏ i, f i (x i)) ∧
      (∀ u : EuclideanSpace ℝ (Fin m),
        MemW0 (fun v : EuclideanSpace ℝ (Fin l) ↦ ∏ i, f i (pi i (u, v)))) ∧
      MemW0 (fun u : EuclideanSpace ℝ (Fin m) ↦ ∫ v, ∏ i, f i (pi i (u, v))) ∧
      (∫ u : EuclideanSpace ℝ (Fin m),
        wienerEnvelope (fun u ↦ ∫ v, ∏ i, f i (pi i (u, v))) 1 u) ≤
        C * ∏ i, ∫ x, wienerEnvelope (f i) 1 x := by
  classical
  let H : (∀ i, EuclideanSpace ℝ (Fin (d i))) → 𝕜 := fun x ↦ ∏ i, f i (x i)
  let P : EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin l) → 𝕜 :=
    fun uv ↦ ∏ i, f i (pi i uv)
  let G : EuclideanSpace ℝ (Fin m) → 𝕜 := fun u ↦ ∫ v, ∏ i, f i (pi i (u, v))
  have hH : MemW0 H := MemW0.fintype_tensor hf
  have hP : MemW0 P := by simpa [P] using hPullback
  have hG : MemW0 G := by simpa [G, P] using hP.aux_integral_slice
  refine ⟨?_, ?_, ?_, ?_⟩
  · simpa [H] using hH
  · intro u
    simpa [P] using hP.aux_memW0_slice u
  · simpa [G] using hG
  · calc
      (∫ u : EuclideanSpace ℝ (Fin m),
          wienerEnvelope (fun u ↦ ∫ v, ∏ i, f i (pi i (u, v))) 1 u) =
          ∫ u, wienerEnvelope G 1 u := by rfl
      _ ≤ ∫ uv, wienerEnvelope P 1 uv :=
        aux_integral_wienerEnvelope_integral_slice_le hP
      _ ≤ C * ∫ x : ∀ i, EuclideanSpace ℝ (Fin (d i)), wienerEnvelope H 1 x := by
        simpa [P, H] using hPullback_bound
      _ ≤ C * ∏ i, ∫ x, wienerEnvelope (f i) 1 x :=
        mul_le_mul_of_nonneg_left (fintype_tensor_wienerNorm_le hf) hC

end Codex
