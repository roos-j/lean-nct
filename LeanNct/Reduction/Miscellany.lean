  unfold twistedAverage
  exact (aux_normASum_E1_integral_eq_real (fun t : ℝ => chi t * ∏ i,
    f i (x + t • WithLp.toLp 2 (Pi.single i (1 : ℝ))))).symm

private theorem aux_normASum_twistedAverage_add_of_memLp {n : ℕ}
    (f : Fin n → SchwartzMap (EuclideanSpace ℝ (Fin n)) ℝ)
    (K : EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin 1) → ℝ)
    (hK0 : MemW0 K)
    (u v : ℝ → ℝ) (hu : MemLp u 2 volume) (hv : MemLp v 2 volume)
    (hK : ∀ x s, K (x, s) = ∏ i,
      f i (x + (s 0) • WithLp.toLp 2 (Pi.single i (1 : ℝ)))) :
    twistedAverage (u + v) (fun i x ↦ f i x) =
      twistedAverage u (fun i x ↦ f i x) + twistedAverage v (fun i x ↦ f i x) := by
  funext x
  simp only [Pi.add_apply]
  rw [aux_normASum_twistedAverage_eq_E1Kernel (u + v) f x,
    aux_normASum_twistedAverage_eq_E1Kernel u f x,
    aux_normASum_twistedAverage_eq_E1Kernel v f x]
  let E1 := EuclideanSpace ℝ (Fin 1)
  let u1 : E1 → ℝ := fun s => u (s 0)
  let v1 : E1 → ℝ := fun s => v (s 0)
  have hu1 : MemLp u1 2 volume := by
    have h := hu.comp_measurePreserving aux_normASum_E1_to_real_measurePreserving
    simpa [u1, Function.comp_def] using h
  have hv1 : MemLp v1 2 volume := by
    have h := hv.comp_measurePreserving aux_normASum_E1_to_real_measurePreserving
    simpa [v1, Function.comp_def] using h
  have hKslice : MemLp (fun s : E1 => K (x, s)) 2 volume :=
    (hK0.aux_memW0_slice x).memLp (by norm_num)
  have huInt : Integrable (fun s : E1 => u1 s * K (x, s)) :=
    hu1.integrable_mul hKslice
  have hvInt : Integrable (fun s : E1 => v1 s * K (x, s)) :=
    hv1.integrable_mul hKslice
  have hleft : (∫ s : E1, (u + v) (s 0) *
      ∏ i, f i (x + (s 0) • WithLp.toLp 2 (Pi.single i (1 : ℝ)))) =
      ∫ s : E1, (u1 s + v1 s) * K (x, s) := by
    apply integral_congr_ae
    filter_upwards [] with s
    rw [hK]
    dsimp [u1, v1]
  rw [hleft]
  calc
    (∫ s : E1, (u1 s + v1 s) * K (x, s)) =
        ∫ s : E1, (u1 s * K (x, s) + v1 s * K (x, s)) := by
          apply integral_congr_ae
          filter_upwards [] with s
          ring
    _ = (∫ s : E1, u1 s * K (x, s)) + ∫ s : E1, v1 s * K (x, s) :=
      integral_add huInt hvInt
    _ = _ := by
      congr 1
      · apply integral_congr_ae
        filter_upwards [] with s
        rw [hK]
      · apply integral_congr_ae
        filter_upwards [] with s
        rw [hK]

private theorem aux_normASum_twistedAverage_memLp {n : ℕ} (hn : 2 ≤ n)
    (f : Fin n → SchwartzMap (EuclideanSpace ℝ (Fin n)) ℝ)
    (chi : ℝ → ℝ) (hchi : MemLp chi 2 volume) :
    MemLp (twistedAverage chi (fun i x ↦ f i x)) 2 volume := by
  let K : EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin 1) → ℝ := fun uv =>
    ∏ i, f i (uv.1 + (uv.2 0) • WithLp.toLp 2 (Pi.single i (1 : ℝ)))
  have hK0 : MemW0 K := by
    simpa [K] using aux_normASum_kernel_memW0 hn f
  have hK2 : MemLp K 2 volume := by
    simpa [K] using aux_normASum_kernel_memLp_two hn f
  have h := aux_normASum_kernel_operator_memLp K hK0 hK2 chi hchi
  convert h using 1
  funext x
  simpa [K] using aux_normASum_twistedAverage_eq_E1Kernel chi f x

/-- A twisted average of a square-integrable scalar kernel against a Schwartz
tuple is square-integrable.  This public interface is used by the final
short/long-variation reduction. -/
theorem aux_twistedAverage_memLp {n : ℕ} (hn : 2 ≤ n)
    (f : Fin n → SchwartzMap (EuclideanSpace ℝ (Fin n)) ℝ)
    (chi : ℝ → ℝ) (hchi : MemLp chi 2 volume) :
    MemLp (twistedAverage chi (fun i x ↦ f i x)) 2 volume :=
  aux_normASum_twistedAverage_memLp hn f chi hchi

/-- Twisted averaging is additive for square-integrable scalar kernels. -/
theorem aux_twistedAverage_add_of_memLp {n : ℕ} (hn : 2 ≤ n)
    (f : Fin n → SchwartzMap (EuclideanSpace ℝ (Fin n)) ℝ)
    (u v : ℝ → ℝ) (hu : MemLp u 2 volume) (hv : MemLp v 2 volume) :
    twistedAverage (u + v) (fun i x ↦ f i x) =
      twistedAverage u (fun i x ↦ f i x) + twistedAverage v (fun i x ↦ f i x) := by
  let K : EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin 1) → ℝ := fun uv =>
    ∏ i, f i (uv.1 + (uv.2 0) • WithLp.toLp 2 (Pi.single i (1 : ℝ)))
  have hK : MemW0 K := by
    simpa [K] using aux_normASum_kernel_memW0 hn f
  exact aux_normASum_twistedAverage_add_of_memLp f K hK u v hu hv
    (by intro x s; simp [K])

/-- Twisted averaging commutes with negation. -/
theorem aux_twistedAverage_neg {n : ℕ}
    (f : Fin n → SchwartzMap (EuclideanSpace ℝ (Fin n)) ℝ)
    (u : ℝ → ℝ) :
    twistedAverage (-u) (fun i x ↦ f i x) =
      -twistedAverage u (fun i x ↦ f i x) := by
  funext x
  unfold twistedAverage
  change (∫ s : ℝ, (-u s) * ∏ i,
      f i (x + s • WithLp.toLp 2 (Pi.single i (1 : ℝ)))) =
    -(∫ s : ℝ, u s * ∏ i,
      f i (x + s • WithLp.toLp 2 (Pi.single i (1 : ℝ))))
  rw [← integral_neg]
  apply integral_congr_ae
  filter_upwards [] with s
  simp

/-- Twisted averaging respects subtraction of square-integrable scalar kernels. -/
theorem aux_twistedAverage_sub_of_memLp {n : ℕ} (hn : 2 ≤ n)
    (f : Fin n → SchwartzMap (EuclideanSpace ℝ (Fin n)) ℝ)
    (u v : ℝ → ℝ) (hu : MemLp u 2 volume) (hv : MemLp v 2 volume) :
    twistedAverage (u - v) (fun i x ↦ f i x) =
      twistedAverage u (fun i x ↦ f i x) - twistedAverage v (fun i x ↦ f i x) := by
  rw [sub_eq_add_neg, aux_twistedAverage_add_of_memLp hn f u (-v) hu hv.neg,
    aux_twistedAverage_neg]
  rfl

private theorem aux_normASum_twistedAverage_sq_integral_bound {n : ℕ} (hn : 2 ≤ n)
    (f : Fin n → SchwartzMap (EuclideanSpace ℝ (Fin n)) ℝ)
    (chi : ℝ → ℝ) (hchi : MemLp chi 2 volume) :
    (∫ x : EuclideanSpace ℝ (Fin n),
      twistedAverage chi (fun i x ↦ f i x) x ^ 2) ≤
      (∫ s : ℝ, chi s ^ 2) *
        (∫ uv : EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin 1),
          (∏ i, f i (uv.1 + (uv.2 0) • WithLp.toLp 2 (Pi.single i (1 : ℝ)))) ^ 2) := by
  let K : EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin 1) → ℝ := fun uv =>
    ∏ i, f i (uv.1 + (uv.2 0) • WithLp.toLp 2 (Pi.single i (1 : ℝ)))
  have hK0 : MemW0 K := by
    simpa [K] using aux_normASum_kernel_memW0 hn f
  have hK2 : MemLp K 2 volume := by
    simpa [K] using aux_normASum_kernel_memLp_two hn f
  have h := aux_normASum_kernel_operator_sq_integral_bound K hK0 hK2 chi hchi
  convert h using 1
  · apply integral_congr_ae
    filter_upwards [] with x
    rw [aux_normASum_twistedAverage_eq_E1Kernel chi f x]

private theorem aux_normASum_twistedAverage_tendsto_L2 {n : ℕ} (hn : 2 ≤ n)
    (f : Fin n → SchwartzMap (EuclideanSpace ℝ (Fin n)) ℝ)
    (chi : ℕ → ℝ → ℝ) (hchi : ∀ N, MemLp (chi N) 2 volume)
    (hconv : Tendsto (fun N ↦ eLpNorm (chi N) 2 volume) atTop (nhds 0)) :
    Tendsto (fun N ↦ eLpNorm (twistedAverage (chi N) (fun i x ↦ f i x)) 2 volume)
      atTop (nhds 0) := by
  let K : EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin 1) → ℝ := fun uv =>
    ∏ i, f i (uv.1 + (uv.2 0) • WithLp.toLp 2 (Pi.single i (1 : ℝ)))
  let A : ℕ → EuclideanSpace ℝ (Fin n) → ℝ := fun N x =>
    ∫ s : EuclideanSpace ℝ (Fin 1), chi N (s 0) * K (x, s)
  have hK0 : MemW0 K := by
    simpa [K] using aux_normASum_kernel_memW0 hn f
  have hK2 : MemLp K 2 volume := by
    simpa [K] using aux_normASum_kernel_memLp_two hn f
  have hA (N : ℕ) : MemLp (A N) 2 volume := by
    simpa [A] using aux_normASum_kernel_operator_memLp K hK0 hK2 (chi N) (hchi N)
  have hbound (N : ℕ) : (∫ x : EuclideanSpace ℝ (Fin n), A N x ^ 2) ≤
      (∫ uv : EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin 1), K uv ^ 2) *
        (∫ s : ℝ, chi N s ^ 2) := by
    have h := aux_normASum_kernel_operator_sq_integral_bound K hK0 hK2 (chi N) (hchi N)
    rw [mul_comm]
    exact h
  have hC : 0 ≤ ∫ uv : EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin 1), K uv ^ 2 := by
    apply integral_nonneg
    intro uv
    exact sq_nonneg _
  have hmain := aux_normASum_eLpNorm_two_tendsto_zero_of_sq_integral_bound chi A hchi hA
    (∫ uv : EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin 1), K uv ^ 2) hC hbound hconv
  apply Tendsto.congr' ?_ hmain
  filter_upwards [] with N
  apply eLpNorm_congr_ae
  filter_upwards [] with x
  simpa [A, K] using (aux_normASum_twistedAverage_eq_E1Kernel (chi N) f x).symm

private theorem aux_normASum_normASumLeSum {n : ℕ} (hn : 2 ≤ n) (phi : ℝ → ℝ)
    (phiJ : ℕ → ℝ → ℝ)
    (f : Fin n → SchwartzMap (EuclideanSpace ℝ (Fin n)) ℝ)
    (hphi : MemLp phi 2 volume) (hphiJ : ∀ j, MemLp (phiJ j) 2 volume)
    (hconv : Tendsto (fun N ↦ eLpNorm
      (phi - ∑ j ∈ Finset.range N, phiJ j) 2 volume) atTop (nhds 0)) :
    eLpNorm (twistedAverage phi (fun i x ↦ f i x)) 2 volume ≤
      ∑' j, eLpNorm (twistedAverage (phiJ j) (fun i x ↦ f i x)) 2 volume := by
  classical
  let K : EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin 1) → ℝ := fun uv =>
    ∏ i, f i (uv.1 + (uv.2 0) • WithLp.toLp 2 (Pi.single i (1 : ℝ)))
  have hK0 : MemW0 K := by
    simpa [K] using aux_normASum_kernel_memW0 hn f
  have hsumMem (N : ℕ) : MemLp (∑ j ∈ Finset.range N, phiJ j) 2 volume := by
    exact memLp_finsetSum' (Finset.range N) (fun j _ ↦ hphiJ j)
  have hresMem (N : ℕ) : MemLp
      (phi - ∑ j ∈ Finset.range N, phiJ j) 2 volume :=
    hphi.sub (hsumMem N)
  have hsumA (N : ℕ) :
      twistedAverage (∑ j ∈ Finset.range N, phiJ j) (fun i x ↦ f i x) =
        ∑ j ∈ Finset.range N, twistedAverage (phiJ j) (fun i x ↦ f i x) := by
    induction N with
    | zero =>
        simp only [Finset.range_zero, Finset.sum_empty]
        funext x
        simp [twistedAverage]
    | succ N ih =>
        rw [Finset.sum_range_succ, Finset.sum_range_succ]
        calc
          twistedAverage ((∑ j ∈ Finset.range N, phiJ j) + phiJ N)
              (fun i x ↦ f i x) =
              twistedAverage (∑ j ∈ Finset.range N, phiJ j) (fun i x ↦ f i x) +
                twistedAverage (phiJ N) (fun i x ↦ f i x) :=
            aux_normASum_twistedAverage_add_of_memLp f K hK0
              (∑ j ∈ Finset.range N, phiJ j) (phiJ N) (hsumMem N) (hphiJ N)
              (by intro x s; simp [K])
          _ = _ := by rw [ih]
  have hconvA : Tendsto (fun N ↦ eLpNorm
      (twistedAverage (phi - ∑ j ∈ Finset.range N, phiJ j)
        (fun i x ↦ f i x)) 2 volume) atTop (nhds 0) :=
    aux_normASum_twistedAverage_tendsto_L2 hn f
      (fun N ↦ phi - ∑ j ∈ Finset.range N, phiJ j) hresMem hconv
  have hbound (N : ℕ) :
      eLpNorm (twistedAverage phi (fun i x ↦ f i x)) 2 volume ≤
        (∑ j ∈ Finset.range N,
          eLpNorm (twistedAverage (phiJ j) (fun i x ↦ f i x)) 2 volume) +
          eLpNorm (twistedAverage (phi - ∑ j ∈ Finset.range N, phiJ j)
            (fun i x ↦ f i x)) 2 volume := by
    have hdecomp : phi = (∑ j ∈ Finset.range N, phiJ j) +
        (phi - ∑ j ∈ Finset.range N, phiJ j) := by
      funext x
      simp
    have hrewrite := congrArg (fun q =>
      twistedAverage q (fun i x ↦ f i x)) hdecomp
    rw [hrewrite, aux_normASum_twistedAverage_add_of_memLp f K hK0
      (∑ j ∈ Finset.range N, phiJ j)
      (phi - ∑ j ∈ Finset.range N, phiJ j) (hsumMem N) (hresMem N)
      (by intro x s; simp [K]), hsumA]
    calc
      eLpNorm ((∑ j ∈ Finset.range N, twistedAverage (phiJ j) (fun i x ↦ f i x)) +
          twistedAverage (phi - ∑ j ∈ Finset.range N, phiJ j)
            (fun i x ↦ f i x)) 2 volume ≤
          eLpNorm (∑ j ∈ Finset.range N,
            twistedAverage (phiJ j) (fun i x ↦ f i x)) 2 volume +
            eLpNorm (twistedAverage (phi - ∑ j ∈ Finset.range N, phiJ j)
              (fun i x ↦ f i x)) 2 volume := by
            have hsumOutMeas : AEStronglyMeasurable
                (∑ j ∈ Finset.range N,
                  twistedAverage (phiJ j) (fun i x ↦ f i x)) volume := by
              exact (memLp_finsetSum' (Finset.range N)
                (fun j _ ↦
                  aux_normASum_twistedAverage_memLp hn f _ (hphiJ j))).aestronglyMeasurable
            exact eLpNorm_add_le hsumOutMeas
              (aux_normASum_twistedAverage_memLp hn f _ (hresMem N)).aestronglyMeasurable
              (by norm_num)
      _ ≤ (∑ j ∈ Finset.range N,
            eLpNorm (twistedAverage (phiJ j) (fun i x ↦ f i x)) 2 volume) +
            eLpNorm (twistedAverage (phi - ∑ j ∈ Finset.range N, phiJ j)
              (fun i x ↦ f i x)) 2 volume := by
            gcongr
            exact eLpNorm_sum_le (s := Finset.range N)
              (f := fun j ↦ twistedAverage (phiJ j) (fun i x ↦ f i x))
              (fun j _ ↦
                (aux_normASum_twistedAverage_memLp hn f _ (hphiJ j)).aestronglyMeasurable)
              (by norm_num)
  let S : ℝ≥0∞ := ∑' j,
    eLpNorm (twistedAverage (phiJ j) (fun i x ↦ f i x)) 2 volume
  have hfinal (N : ℕ) : eLpNorm (twistedAverage phi (fun i x ↦ f i x)) 2 volume ≤
      S + eLpNorm (twistedAverage (phi - ∑ j ∈ Finset.range N, phiJ j)
        (fun i x ↦ f i x)) 2 volume := by
    calc
      eLpNorm (twistedAverage phi (fun i x ↦ f i x)) 2 volume ≤
          (∑ j ∈ Finset.range N,
            eLpNorm (twistedAverage (phiJ j) (fun i x ↦ f i x)) 2 volume) +
            eLpNorm (twistedAverage (phi - ∑ j ∈ Finset.range N, phiJ j)
              (fun i x ↦ f i x)) 2 volume := hbound N
      _ ≤ S + eLpNorm (twistedAverage (phi - ∑ j ∈ Finset.range N, phiJ j)
            (fun i x ↦ f i x)) 2 volume := by
          gcongr
          exact ENNReal.sum_le_tsum (Finset.range N)
  have hlim : Tendsto (fun N ↦ S + eLpNorm
      (twistedAverage (phi - ∑ j ∈ Finset.range N, phiJ j)
        (fun i x ↦ f i x)) 2 volume) atTop (nhds S) := by
    simpa using (tendsto_const_nhds.add hconvA)
  change eLpNorm (twistedAverage phi (fun i x ↦ f i x)) 2 volume ≤ S
  exact ge_of_tendsto' hlim hfinal


/--
\begin{lemma}\label{lem:norm_A_sum_le_sum}
If $\phi=\sum_{j=1}^\infty \phi_j$ holds in $L^2$ (with $L^2$ functions $\phi, \phi_j$), then
\begin{equation}\label{auto:twisted-average-series-triangle}
\|A(\phi, \mathbf{f})\|_{L^2(\mathbb{R}^n)} \le
\sum_{j=1}^\infty \|A({\phi_j}, \mathbf{f})\|_{L^2(\mathbb{R}^n)}.
\end{equation}
\end{lemma}
-/
theorem normASumLeSum {n : ℕ} (hn : 2 ≤ n) (phi : ℝ → ℝ) (phiJ : ℕ → ℝ → ℝ)
    (f : Fin n → SchwartzMap (EuclideanSpace ℝ (Fin n)) ℝ)
    (_hphi : MemLp phi 2 volume) (_hphiJ : ∀ j, MemLp (phiJ j) 2 volume)
    (_hconv : Tendsto (fun N ↦ eLpNorm
      (phi - ∑ j ∈ Finset.range N, phiJ j) 2 volume) atTop (nhds 0)) :
    eLpNorm (twistedAverage phi (fun i x ↦ f i x)) 2 volume ≤
      ∑' j, eLpNorm (twistedAverage (phiJ j) (fun i x ↦ f i x)) 2 volume := by
  exact aux_normASum_normASumLeSum hn phi phiJ f _hphi _hphiJ _hconv

/-- The one-dimensional fibre test function used in `formPos`. -/
def aux_formPosFiber (d : ℕ)
    (F : Fin (d + 1) → SchwartzMap (RealVector (d + 1)) ℝ)
    (x : RealVector (d + 1)) (r : ℝ) : ℝ :=
  ∏ i : Fin (d + 1),
    F (prismIndex (n := d + 1) (k := 1) (by omega) (by omega) i)
      (concatVector (d + 1) 1 (by omega)
        (fun _ : Fin 1 =>
          r - Codex.Preliminaries.KKernels.coordinateSum x)
        (eraseVector i x))

theorem aux_formPosFiber_bounded (d : ℕ)
    (F : Fin (d + 1) → SchwartzMap (RealVector (d + 1)) ℝ)
    (x : RealVector (d + 1)) :
    Codex.Reduction.BumpFunctions.aux_bounded (aux_formPosFiber d F x) := by
  classical
  constructor
  · unfold aux_formPosFiber
    apply Finset.measurable_fun_prod Finset.univ
    intro i _
    apply (F (prismIndex (n := d + 1) (k := 1) (by omega) (by omega) i)).continuous.measurable.comp
    apply Continuous.measurable
    apply continuous_pi
    intro j
    by_cases hj : j.1 < 1
    · have hfun : (fun a : ℝ =>
          concatVector (d + 1) 1 (by omega)
            (fun _ : Fin 1 =>
              a - Codex.Preliminaries.KKernels.coordinateSum x)
            (eraseVector i x) j) =
          fun a : ℝ => a - Codex.Preliminaries.KKernels.coordinateSum x := by
          funext a
          simp [concatVector, hj]
      rw [hfun]
      exact continuous_id.sub continuous_const
    · simpa [concatVector, hj] using (continuous_const : Continuous fun _ : ℝ =>
        eraseVector i x ⟨j.1 - 1, by omega⟩)
  · apply (isBounded_iff_forall_norm_le (s := Set.range (aux_formPosFiber d F x))).mpr
    let C : ℝ := ∏ i : Fin (d + 1),
      SchwartzMap.seminorm ℝ 0 0 (F (prismIndex (n := d + 1) (k := 1) (by omega) (by omega) i))
    refine ⟨C, ?_⟩
    rintro z ⟨r, rfl⟩
    unfold aux_formPosFiber
    calc
      ‖∏ i : Fin (d + 1),
          F (prismIndex (n := d + 1) (k := 1) (by omega) (by omega) i)
            (concatVector (d + 1) 1 (by omega)
              (fun _ : Fin 1 =>
                r - Codex.Preliminaries.KKernels.coordinateSum x)
              (eraseVector i x))‖ ≤
          ∏ i : Fin (d + 1),
            ‖F (prismIndex (n := d + 1) (k := 1) (by omega) (by omega) i)
              (concatVector (d + 1) 1 (by omega)
                (fun _ : Fin 1 =>
                  r - Codex.Preliminaries.KKernels.coordinateSum x)
                (eraseVector i x))‖ := Finset.norm_prod_le _ _
      _ ≤ C := by
        dsimp [C]
        apply Finset.prod_le_prod
        · intro i _
          exact norm_nonneg (F (prismIndex (n := d + 1) (k := 1) (by omega) (by omega) i)
            (concatVector (d + 1) 1 (by omega)
              (fun _ : Fin 1 =>
                r - Codex.Preliminaries.KKernels.coordinateSum x)
              (eraseVector i x)))
        · intro i _
          exact
            (F (prismIndex (n := d + 1) (k := 1) (by omega) (by omega) i)).norm_le_seminorm ℝ _

theorem aux_formPosFiber_add_coordinateSum (d : ℕ)
    (F : Fin (d + 1) → SchwartzMap (RealVector (d + 1)) ℝ)
    (x : RealVector (d + 1)) (r : ℝ) :
    aux_formPosFiber d F x (r + Codex.Preliminaries.KKernels.coordinateSum x) =
      ∏ i : Fin (d + 1),
        F (prismIndex (n := d + 1) (k := 1) (by omega) (by omega) i)
          (concatVector (d + 1) 1 (by omega) (fun _ : Fin 1 => r)
            (eraseVector i x)) := by
  unfold aux_formPosFiber
  apply Finset.prod_congr rfl
  intro i _
  congr 2
  funext j
  simp

/-- The `k = 1` expansion of `mToK` used in `formPos`. -/
theorem aux_formPos_mToK_one (Psi : MKernel 1) (u : RealVector 1 × ℝ) :
    mToK 1 (by omega) Psi u =
      Psi ((fun _ : Fin 1 => u.1 0 + u.2), fun _ : Fin 1 => u.2) := by
  unfold mToK
  rw [aux_integral_realVector_zero]
  congr 1
  apply Prod.ext
  · funext i
    have hi : i = (0 : Fin 1) := Fin.eq_zero i
    subst i
    simp [mToKPoint, lastIndex, Codex.Preliminaries.KKernels.coordinateSum]
  · funext i
    have hi : i = (0 : Fin 1) := Fin.eq_zero i
    subst i
    simp [mToKPoint, lastIndex, Codex.Preliminaries.KKernels.coordinateSum]

/-- The one-prism product expanded into its two corners. -/
theorem aux_formPos_prism_product (d : ℕ)
    (F : Fin (d + 1) → SchwartzMap (RealVector (d + 1)) ℝ)
    (p : (RealVector 1 × RealVector 1) × RealVector (d + 1)) :
    (∏ h : Fin 1 → Fin 2, ∏ i : Fin (d + 1),
      F (prismIndex (n := d + 1) (k := 1) (by omega) (by omega) i)
        (prismPoint (n := d + 1) (k := 1) (by omega) (by omega) p.1 p.2 h i)) =
      (∏ i : Fin (d + 1),
        F (prismIndex (n := d + 1) (k := 1) (by omega) (by omega) i)
          (concatVector (d + 1) 1 (by omega) (fun _ : Fin 1 => p.1.1 0)
            (eraseVector i p.2))) *
      (∏ i : Fin (d + 1),
        F (prismIndex (n := d + 1) (k := 1) (by omega) (by omega) i)
          (concatVector (d + 1) 1 (by omega) (fun _ : Fin 1 => p.1.2 0)
            (eraseVector i p.2))) := by
  have hcorner0 : cubeCorner p.1 (Fin.snoc (default : Fin 0 → Fin 2) (0 : Fin 2)) =
      (fun _ : Fin 1 => p.1.1 0) := by
    funext j
    fin_cases j
    simp [Fin.snoc_zero, cubeCorner]
  have hcorner1 : cubeCorner p.1 (Fin.snoc (default : Fin 0 → Fin 2) (1 : Fin 2)) =
      (fun _ : Fin 1 => p.1.2 0) := by
    funext j
    fin_cases j
    simp [Fin.snoc_zero, cubeCorner]
  rw [aux_prod_cubeCorners_snoc_two]
  simp only [Fintype.prod_unique]
  congr 1
  · apply Finset.prod_congr rfl
    intro i _
    rw [prismPoint]
    congr 2
  · apply Finset.prod_congr rfl
    intro i _
    rw [prismPoint]
    congr 2

/-- The determinant-one fibre coordinate change used in `formPos`. -/
def aux_formPosShear (d : ℕ) :
    RealVector (d + 1) × (ℝ × ℝ) → RealVector (d + 1) × (ℝ × ℝ) :=
  fun q => (q.1, (q.2.2 + Codex.Preliminaries.KKernels.coordinateSum q.1,
    q.2.1 + Codex.Preliminaries.KKernels.coordinateSum q.1))

/-- The inverse determinant-one fibre coordinate change used in `formPos`. -/
def aux_formPosShearInv (d : ℕ) :
    RealVector (d + 1) × (ℝ × ℝ) → RealVector (d + 1) × (ℝ × ℝ) :=
  fun q => (q.1, (q.2.2 - Codex.Preliminaries.KKernels.coordinateSum q.1,
    q.2.1 - Codex.Preliminaries.KKernels.coordinateSum q.1))

theorem aux_formPosShearInv_shear (d : ℕ)
    (q : RealVector (d + 1) × (ℝ × ℝ)) :
    aux_formPosShearInv d (aux_formPosShear d q) = q := by
  rcases q with ⟨x, a, b⟩
  simp [aux_formPosShear, aux_formPosShearInv]

theorem aux_formPosShear_shearInv (d : ℕ)
    (q : RealVector (d + 1) × (ℝ × ℝ)) :
    aux_formPosShear d (aux_formPosShearInv d q) = q := by
  rcases q with ⟨x, a, b⟩
  simp [aux_formPosShear, aux_formPosShearInv]

/-- The measurable equivalence underlying the `formPos` shear. -/
noncomputable def aux_formPosShearEquiv (d : ℕ) :
    RealVector (d + 1) × (ℝ × ℝ) ≃ᵐ RealVector (d + 1) × (ℝ × ℝ) where
  toFun := aux_formPosShear d
  invFun := aux_formPosShearInv d
  left_inv := aux_formPosShearInv_shear d
  right_inv := aux_formPosShear_shearInv d
  measurable_toFun := by
    convert (continuous_fst.prodMk
      (((continuous_snd.comp continuous_snd).add
        ((aux_continuous_coordinateSum (d + 1)).comp continuous_fst)).prodMk
        ((continuous_fst.comp continuous_snd).add
          ((aux_continuous_coordinateSum (d + 1)).comp continuous_fst)))).measurable using 1
    funext q
    rfl
  measurable_invFun := by
    convert (continuous_fst.prodMk
      (((continuous_snd.comp continuous_snd).sub
        ((aux_continuous_coordinateSum (d + 1)).comp continuous_fst)).prodMk
        ((continuous_fst.comp continuous_snd).sub
          ((aux_continuous_coordinateSum (d + 1)).comp continuous_fst)))).measurable using 1
    funext q
    rfl

theorem aux_formPosShear_measurePreserving (d : ℕ) :
    MeasurePreserving (aux_formPosShear d) volume volume := by
  let A := RealVector (d + 1)
  have hpair (x : A) : MeasurePreserving
      (fun y : ℝ × ℝ => (y.2 + Codex.Preliminaries.KKernels.coordinateSum x,
        y.1 + Codex.Preliminaries.KKernels.coordinateSum x)) volume volume := by
    have hswap : MeasurePreserving (Prod.swap : ℝ × ℝ → ℝ × ℝ) volume volume := by
      simpa only [Measure.volume_eq_prod] using
        (aux_volume_preserving_prod_swap (volume : Measure ℝ) (volume : Measure ℝ))
    have htranslate : MeasurePreserving
        (fun r : ℝ => r + Codex.Preliminaries.KKernels.coordinateSum x) volume volume :=
      measurePreserving_add_right (volume : Measure ℝ)
        (Codex.Preliminaries.KKernels.coordinateSum x)
    have hproduct : MeasurePreserving
        (Prod.map (fun r : ℝ => r + Codex.Preliminaries.KKernels.coordinateSum x)
          (fun r : ℝ => r + Codex.Preliminaries.KKernels.coordinateSum x)) volume volume := by
      simpa only [Measure.volume_eq_prod] using htranslate.prod htranslate
    have hcomp := hproduct.comp hswap
    change MeasurePreserving (fun y : ℝ × ℝ =>
      (y.2 + Codex.Preliminaries.KKernels.coordinateSum x,
        y.1 + Codex.Preliminaries.KKernels.coordinateSum x)) volume volume
    convert hcomp using 1
    funext y
    rfl
  refine MeasurePreserving.skew_product
    (μa := (volume : Measure A)) (μb := (volume : Measure A))
    (μc := (volume : Measure (ℝ × ℝ))) (μd := (volume : Measure (ℝ × ℝ)))
    (f := id) (g := fun x y =>
      (y.2 + Codex.Preliminaries.KKernels.coordinateSum x,
        y.1 + Codex.Preliminaries.KKernels.coordinateSum x))
    (MeasurePreserving.id (volume : Measure A)) ?_ ?_
  · exact (((continuous_snd.comp continuous_snd).add
      ((aux_continuous_coordinateSum (d + 1)).comp continuous_fst)).prodMk
      ((continuous_fst.comp continuous_snd).add
        ((aux_continuous_coordinateSum (d + 1)).comp continuous_fst))).measurable
  · filter_upwards [] with x
    exact (hpair x).map_eq

theorem aux_formPosShearEquiv_measurePreserving (d : ℕ) :
    MeasurePreserving (aux_formPosShearEquiv d) volume volume := by
  change MeasurePreserving (aux_formPosShear d) volume volume
  exact aux_formPosShear_measurePreserving d

/-- The original integrand in the `formPos` coordinate calculation. -/
def aux_formPosRaw (d : ℕ) (Psi : MKernel 1)
    (F : Fin (d + 1) → SchwartzMap (RealVector (d + 1)) ℝ)
    (p : (RealVector 1 × RealVector 1) × RealVector (d + 1)) : ℝ :=
  mToK 1 (by omega) Psi
      (p.1.2 - p.1.1, Codex.Preliminaries.KKernels.coordinateSum p.1.1 +
        Codex.Preliminaries.KKernels.coordinateSum p.2) *
    ∏ h : Fin 1 → Fin 2, ∏ i : Fin (d + 1),
      F (prismIndex (n := d + 1) (k := 1) (by omega) (by omega) i)
        (prismPoint (n := d + 1) (k := 1) (by omega) (by omega) p.1 p.2 h i)

/-- The separated integrand in the `formPos` coordinate calculation. -/
def aux_formPosTarget (d : ℕ) (Psi : MKernel 1)
    (F : Fin (d + 1) → SchwartzMap (RealVector (d + 1)) ℝ)
    (q : RealVector (d + 1) × (ℝ × ℝ)) : ℝ :=
  Psi ((fun _ : Fin 1 => q.2.1), fun _ : Fin 1 => q.2.2) *
    aux_formPosFiber d F q.1 q.2.1 * aux_formPosFiber d F q.1 q.2.2

theorem aux_formPosRaw_eq_target (d : ℕ) (Psi : MKernel 1)
    (F : Fin (d + 1) → SchwartzMap (RealVector (d + 1)) ℝ)
    (p : (RealVector 1 × RealVector 1) × RealVector (d + 1)) :
    aux_formPosRaw d Psi F p =
      aux_formPosTarget d Psi F (aux_formPosShear d (aux_baseReorderOne (d + 1) p)) := by
  unfold aux_formPosRaw aux_formPosTarget
  rw [aux_formPos_mToK_one, aux_formPos_prism_product]
  rw [aux_baseReorderOne_apply]
  dsimp [aux_formPosShear]
  rw [aux_formPosFiber_add_coordinateSum d F p.2 (p.1.2 0)]
  rw [aux_formPosFiber_add_coordinateSum d F p.2 (p.1.1 0)]
  rw [aux_coordinateSum_finOne]
  ring_nf

theorem aux_formPosTarget_piUnique (d : ℕ) (Psi : MKernel 1)
    (F : Fin (d + 1) → SchwartzMap (RealVector (d + 1)) ℝ)
    (x : RealVector (d + 1)) (u : RealVector 1 × RealVector 1) :
    aux_formPosTarget d Psi F
      (x, ((MeasurableEquiv.piUnique (fun _ : Fin 1 => ℝ)).prodCongr
        (MeasurableEquiv.piUnique (fun _ : Fin 1 => ℝ)) u)) =
      Psi u * aux_formPosFiber d F x (u.1 0) * aux_formPosFiber d F x (u.2 0) := by
  apply congrArg (fun z : RealVector 1 × RealVector 1 =>
    Psi z * aux_formPosFiber d F x (z.1 0) * aux_formPosFiber d F x (z.2 0))
  apply Prod.ext <;> funext i
  all_goals
    fin_cases i
    rfl

/--
\begin{lemma}\label{lem:form_pos}
(i) Let $\Psi\in W_0(\R^2)$ be real-valued and assume that
\begin{equation}\label{eqn:hyp_form_pos}
\int_{\R^2}g(u_0)g(u_1)\Psi(u)\,du\ge0
\end{equation}
for every bounded measurable $g:\R\to\R$. Then, for every $\F\in\mathfrak F$,
\begin{equation}\label{auto:distributional-prism-positivity}
\Lambda_1(\Psi)(\F)\ge0.
\end{equation}

(ii) In particular, for every real-valued $\psi\in W_0(\R)$ and every $\F\in\mathfrak F$,
\begin{equation}\label{form_pos_psipsi}
\Lambda_1(\psi^{\otimes2})(\F)\ge0.
\end{equation}
\end{lemma}
-/
theorem formPos {n : ℕ} (hn : 1 ≤ n) (Psi : MKernel 1) (hPsi : MemW0 Psi)
    (hquad : ∀ g : ℝ → ℝ,
      Codex.Reduction.BumpFunctions.aux_bounded g →
      0 ≤ ∫ u : RealVector 1 × RealVector 1, g (u.1 0) * g (u.2 0) * Psi u)
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    0 ≤ prismForm n 1 (by omega) hn Psi (fun i x ↦ F i x) := by
  cases n with
  | zero => omega
  | succ d =>
    have hhn : hn = (by omega : 1 ≤ d + 1) := Subsingleton.elim _ _
    cases hhn
    let K : KKernel 1 := mToK 1 (by omega) Psi
    have hK : MemW0 K := by
      dsimp [K]
      exact mToK_memW0 (d + 1) 1 (by omega) (by omega) Psi hPsi
    let H : ((RealVector 1 × RealVector 1) × RealVector (d + 1)) → ℝ :=
      aux_formPosRaw d Psi F
    have hH : Integrable H := by
      dsimp [H]
      change Integrable (fun p :
          (RealVector 1 × RealVector 1) × RealVector (d + 1) =>
        K (p.1.2 - p.1.1, Codex.Preliminaries.KKernels.coordinateSum p.1.1 +
          Codex.Preliminaries.KKernels.coordinateSum p.2) *
        ∏ h : Fin 1 → Fin 2, ∏ i : Fin (d + 1),
          F (prismIndex (n := d + 1) (k := 1) (by omega) (by omega) i)
            (prismPoint (n := d + 1) (k := 1) (by omega) (by omega) p.1 p.2 h i))
      simpa [K] using
        aux_integrable_prismIntegrand (d + 1) 1 (by omega) (by omega) K hK F
    let Q : RealVector (d + 1) × (ℝ × ℝ) → ℝ := aux_formPosTarget d Psi F
    let e := aux_baseReorderOne (d + 1)
    let s := aux_formPosShearEquiv d
    let T := e.trans s
    have hT : MeasurePreserving T volume volume := by
      change MeasurePreserving ((aux_formPosShear d) ∘ aux_baseReorderOne (d + 1)) volume volume
      exact (aux_formPosShearEquiv_measurePreserving d).comp
        (aux_measurePreserving_baseReorderOne (d + 1))
    have hpoint (p : (RealVector 1 × RealVector 1) × RealVector (d + 1)) :
        H p = Q (T p) := by
      change aux_formPosRaw d Psi F p =
        aux_formPosTarget d Psi F (aux_formPosShear d (aux_baseReorderOne (d + 1) p))
      exact aux_formPosRaw_eq_target d Psi F p
    have hHcomp : Integrable (Q ∘ T) := by
      refine hH.congr ?_
      filter_upwards [] with p
      exact hpoint p
    have hQ : Integrable Q := by
      have hTinv : MeasurePreserving T.symm volume volume := hT.symm T
      have h := hTinv.integrable_comp_of_integrable hHcomp
      refine h.congr ?_
      filter_upwards [] with q
      change Q (T (T.symm q)) = Q q
      simp
    let e1 : RealVector 1 ≃ᵐ ℝ := MeasurableEquiv.piUnique (fun _ : Fin 1 => ℝ)
    let E : (RealVector 1 × RealVector 1) ≃ᵐ (ℝ × ℝ) := e1.prodCongr e1
    have he1 : MeasurePreserving e1 volume volume := by
      simpa [e1] using volume_preserving_piUnique (fun _ : Fin 1 => ℝ)
    have hE : MeasurePreserving E volume volume := by
      change MeasurePreserving (Prod.map e1 e1) volume volume
      simpa only [Measure.volume_eq_prod] using he1.prod he1
    have hQpi (x : RealVector (d + 1)) (u : RealVector 1 × RealVector 1) :
        Q (x, E u) =
          Psi u * aux_formPosFiber d F x (u.1 0) * aux_formPosFiber d F x (u.2 0) := by
      change aux_formPosTarget d Psi F
        (x, ((MeasurableEquiv.piUnique (fun _ : Fin 1 => ℝ)).prodCongr
          (MeasurableEquiv.piUnique (fun _ : Fin 1 => ℝ)) u)) = _
      exact aux_formPosTarget_piUnique d Psi F x u
    have hinner (x : RealVector (d + 1)) :
        0 ≤ ∫ y : ℝ × ℝ, Q (x, y) := by
      calc
        0 ≤ ∫ u : RealVector 1 × RealVector 1,
            aux_formPosFiber d F x (u.1 0) * aux_formPosFiber d F x (u.2 0) * Psi u :=
          hquad (aux_formPosFiber d F x) (aux_formPosFiber_bounded d F x)
        _ = ∫ u : RealVector 1 × RealVector 1, Q (x, E u) := by
          apply integral_congr_ae
          filter_upwards [] with u
          rw [hQpi x u]
          ring
        _ = ∫ y : ℝ × ℝ, Q (x, y) := hE.integral_comp' (fun y : ℝ × ℝ => Q (x, y))
    have hQprod : Integrable Q
        ((volume : Measure (RealVector (d + 1))).prod volume) := by
      simpa only [Measure.volume_eq_prod] using hQ
    have hnonneg : 0 ≤ ∫ q : RealVector (d + 1) × (ℝ × ℝ), Q q := by
      calc
        0 ≤ ∫ x : RealVector (d + 1), ∫ y : ℝ × ℝ, Q (x, y) :=
          integral_nonneg fun x => hinner x
        _ = ∫ q : RealVector (d + 1) × (ℝ × ℝ), Q q := by
          simpa only [Measure.volume_eq_prod] using (integral_prod Q hQprod).symm
    change 0 ≤ ∫ y : RealVector 1 × RealVector 1,
      ∫ x : RealVector (d + 1), H (y, x)
    calc
      (∫ y : RealVector 1 × RealVector 1,
        ∫ x : RealVector (d + 1), H (y, x)) =
          ∫ p : (RealVector 1 × RealVector 1) × RealVector (d + 1), H p := by
            simpa only [Measure.volume_eq_prod] using (integral_prod H hH).symm
      _ = ∫ p : (RealVector 1 × RealVector 1) × RealVector (d + 1), Q (T p) := by
            apply integral_congr_ae
            filter_upwards [] with p
            exact hpoint p
      _ = ∫ q : RealVector (d + 1) × (ℝ × ℝ), Q q := hT.integral_comp' Q
      _ ≥ 0 := hnonneg

/-- The tensor-square specialization in Lemma [`Codex.Reduction.Miscellany.formPos`]. -/
theorem aux_formPos_tensorSquare {n : ℕ} (hn : 1 ≤ n) (psi : ℝ → ℝ)
    (hpsi : MemW0 psi) (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    0 ≤ prismForm n 1 (by omega) hn
      (fun u ↦ psi (u.1 0) * psi (u.2 0)) (fun i x ↦ F i x) := by
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector 1)) :=
    isAddHaarMeasure_volume_pi (Fin 1)
  let : Measure.IsAddHaarMeasure (volume : Measure (ℝ × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector 1 × RealVector 1)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let e : RealVector 1 ≃L[ℝ] ℝ :=
    ContinuousLinearEquiv.piUnique ℝ (fun _ : Fin 1 => ℝ)
  let E : (RealVector 1 × RealVector 1) ≃L[ℝ] (ℝ × ℝ) := e.prodCongr e
  have htensor : MemW0 (tensorSquare psi) := aux_memW0_tensorSquare psi hpsi
  have hPsi : MemW0 (fun u : RealVector 1 × RealVector 1 => psi (u.1 0) * psi (u.2 0)) := by
    have hraw := aux_memW0_comp_continuousLinearEquiv htensor E
    convert hraw using 1
    funext u
    simp [E, e, tensorSquare]
  apply formPos hn _ hPsi ?_ F
  intro g _
  let e1 : RealVector 1 ≃ᵐ ℝ := MeasurableEquiv.piUnique (fun _ : Fin 1 => ℝ)
  let E1 : (RealVector 1 × RealVector 1) ≃ᵐ (ℝ × ℝ) := e1.prodCongr e1
  have he1 : MeasurePreserving e1 volume volume := by
    simpa [e1] using volume_preserving_piUnique (fun _ : Fin 1 => ℝ)
  have hE1 : MeasurePreserving E1 volume volume := by
    change MeasurePreserving (Prod.map e1 e1) volume volume
    simpa only [Measure.volume_eq_prod] using he1.prod he1
  let a : ℝ → ℝ := fun r => g r * psi r
  calc
    (∫ u : RealVector 1 × RealVector 1,
        g (u.1 0) * g (u.2 0) * (psi (u.1 0) * psi (u.2 0))) =
        ∫ u : RealVector 1 × RealVector 1, a ((E1 u).1) * a ((E1 u).2) := by
          apply integral_congr_ae
          filter_upwards [] with u
          rw [show E1 u = (u.1 0, u.2 0) by rfl]
          dsimp [a]
          ring
    _ = ∫ q : ℝ × ℝ, a q.1 * a q.2 :=
      hE1.integral_comp' (fun q : ℝ × ℝ => a q.1 * a q.2)
    _ = (∫ r : ℝ, a r) ^ 2 := by
      rw [show (∫ q : ℝ × ℝ, a q.1 * a q.2) =
          (∫ r : ℝ, a r) * ∫ r : ℝ, a r by
            simpa only [Measure.volume_eq_prod] using integral_prod_mul a a]
      ring
    _ ≥ 0 := sq_nonneg _

private theorem aux_tBump_eq (phi : SchwartzMap ℝ ℝ) (u : ℝ) :
    aux_tBump phi u = phi u + u * deriv (fun z : ℝ ↦ phi z) u := by
  unfold aux_tBump
  change deriv (id * (phi : ℝ → ℝ)) u = _
  have h := ((hasDerivAt_id u).mul (phi.hasDerivAt u)).deriv
  simpa [id, Pi.mul_apply] using h

private theorem scaleKernel_hasDerivAt (phi : SchwartzMap ℝ ℝ) (s t : ℝ) (ht : t ≠ 0) :
    HasDerivAt (fun r : ℝ ↦ r⁻¹ * phi (r⁻¹ * s))
      (-t⁻¹ ^ 2 * aux_tBump phi (t⁻¹ * s)) t := by
  have hinv : HasDerivAt (fun r : ℝ ↦ r⁻¹) (-(t ^ 2)⁻¹) t := hasDerivAt_inv ht
  have harg : HasDerivAt (fun r : ℝ ↦ r⁻¹ * s) ((-(t ^ 2)⁻¹) * s) t := hinv.mul_const s
  have hphi : HasDerivAt (fun r : ℝ ↦ phi (r⁻¹ * s))
      (deriv (fun z : ℝ ↦ phi z) (t⁻¹ * s) * ((-(t ^ 2)⁻¹) * s)) t :=
    (phi.hasDerivAt (t⁻¹ * s)).comp t harg
  have h := hinv.mul hphi
  have h' : HasDerivAt (fun r : ℝ ↦ r⁻¹ * phi (r⁻¹ * s))
      ((-(t ^ 2)⁻¹) * phi (t⁻¹ * s) +
        t⁻¹ * (deriv (fun z : ℝ ↦ phi z) (t⁻¹ * s) * ((-(t ^ 2)⁻¹) * s))) t := by
    change HasDerivAt (fun r : ℝ ↦ r⁻¹ * phi (r⁻¹ * s)) _ t at h
    exact h
  convert h' using 1
  rw [aux_tBump_eq]
  field_simp
  ring

private theorem tBump_eq_schwartz (phi : SchwartzMap ℝ ℝ) :
    ∃ tau : SchwartzMap ℝ ℝ, (tau : ℝ → ℝ) = aux_tBump phi := by
  let psi : SchwartzMap ℝ ℝ :=
    SchwartzMap.smulLeftCLM ℝ (fun u : ℝ ↦ u) phi
  let tau : SchwartzMap ℝ ℝ := SchwartzMap.derivCLM ℝ ℝ psi
  refine ⟨tau, ?_⟩
  funext u
  change SchwartzMap.derivCLM ℝ ℝ psi u = aux_tBump phi u
  simp only [SchwartzMap.derivCLM_apply, aux_tBump]
  congr 1
  funext z
  rw [SchwartzMap.smulLeftCLM_apply_apply (by fun_prop)]
  simp only [smul_eq_mul]

private theorem schwartz_abs_le_inv_one_add_sq (tau : SchwartzMap ℝ ℝ) :
    ∀ u : ℝ, |tau u| ≤
      (SchwartzMap.seminorm ℝ 0 0 tau + SchwartzMap.seminorm ℝ 2 0 tau) *
        (1 + u ^ 2)⁻¹ := by
  intro u
  have h0 : |tau u| ≤ SchwartzMap.seminorm ℝ 0 0 tau := by
    simpa [Real.norm_eq_abs] using SchwartzMap.norm_le_seminorm ℝ tau u
  have h2 : |u| ^ 2 * |tau u| ≤ SchwartzMap.seminorm ℝ 2 0 tau := by
    simpa [Real.norm_eq_abs] using SchwartzMap.norm_pow_mul_le_seminorm ℝ tau 2 u
  have hden : 0 < 1 + u ^ 2 := by positivity
  apply (le_div_iff₀ hden).mpr
  have hsquare : |u| ^ 2 = u ^ 2 := sq_abs u
  rw [hsquare] at h2
  nlinarith

private theorem rescaled_schwartz_local_bound (tau : SchwartzMap ℝ ℝ)
    (a r s : ℝ) (ha : 0 < a) (hr : r ∈ Set.Ioo (a / 2) (3 * a / 2)) :
    |-(r⁻¹ ^ 2) * tau (r⁻¹ * s)| ≤
      ((2 / a) ^ 2 *
        (SchwartzMap.seminorm ℝ 0 0 tau + SchwartzMap.seminorm ℝ 2 0 tau) *
          (1 + (3 * a / 2) ^ 2)) * (1 + s ^ 2)⁻¹ := by
  have hrpos : 0 < r := lt_trans (by linarith) hr.1
  have hrle : r ≤ 3 * a / 2 := hr.2.le
  have hscale : r⁻¹ ^ 2 ≤ (2 / a) ^ 2 := by
    have hri : r⁻¹ ≤ (a / 2)⁻¹ := by
      exact (inv_le_inv₀ (by positivity) (by positivity)).mpr hr.1.le
    have hri0 : 0 ≤ r⁻¹ := inv_nonneg.mpr hrpos.le
    have hai0 : 0 ≤ (a / 2)⁻¹ := inv_nonneg.mpr (by positivity)
    calc
      r⁻¹ ^ 2 ≤ (a / 2)⁻¹ ^ 2 := (sq_le_sq₀ hri0 hai0).mpr hri
      _ = (2 / a) ^ 2 := by field_simp [ha.ne']
  have hden : 1 + s ^ 2 ≤ (1 + (3 * a / 2) ^ 2) * (1 + (r⁻¹ * s) ^ 2) := by
    have hsq : r ^ 2 ≤ (3 * a / 2) ^ 2 :=
      (sq_le_sq₀ hrpos.le (by positivity)).mpr hrle
    have hleft : s ^ 2 ≤ (3 * a / 2) ^ 2 * (r⁻¹ * s) ^ 2 := by
      have hpos : 0 < r ^ 2 := sq_pos_of_pos hrpos
      field_simp [hrpos.ne']
      nlinarith [sq_nonneg s]
    nlinarith [sq_nonneg (3 * a / 2), sq_nonneg (r⁻¹ * s)]
  have hdenpos : 0 < 1 + (r⁻¹ * s) ^ 2 := by positivity
  have hden' : (1 + (r⁻¹ * s) ^ 2)⁻¹ ≤
      (1 + (3 * a / 2) ^ 2) * (1 + s ^ 2)⁻¹ := by
    calc
      (1 + (r⁻¹ * s) ^ 2)⁻¹ = 1 / (1 + (r⁻¹ * s) ^ 2) := by rw [one_div]
      _ ≤ (1 + (3 * a / 2) ^ 2) / (1 + s ^ 2) := by
        apply (div_le_div_iff₀ hdenpos (by positivity : 0 < 1 + s ^ 2)).mpr
        nlinarith
      _ = (1 + (3 * a / 2) ^ 2) * (1 + s ^ 2)⁻¹ := by rw [div_eq_mul_inv]
  have hTau := schwartz_abs_le_inv_one_add_sq tau (r⁻¹ * s)
  have hnonneg : 0 ≤ SchwartzMap.seminorm ℝ 0 0 tau + SchwartzMap.seminorm ℝ 2 0 tau := by
    positivity
  calc
    |-(r⁻¹ ^ 2) * tau (r⁻¹ * s)| = r⁻¹ ^ 2 * |tau (r⁻¹ * s)| := by
      rw [abs_mul, abs_neg, abs_of_nonneg (sq_nonneg _)]
    _ ≤ r⁻¹ ^ 2 *
        ((SchwartzMap.seminorm ℝ 0 0 tau + SchwartzMap.seminorm ℝ 2 0 tau) *
          (1 + (r⁻¹ * s) ^ 2)⁻¹) :=
      mul_le_mul_of_nonneg_left hTau (sq_nonneg _)
    _ ≤ (2 / a) ^ 2 *
        ((SchwartzMap.seminorm ℝ 0 0 tau + SchwartzMap.seminorm ℝ 2 0 tau) *
          (1 + (r⁻¹ * s) ^ 2)⁻¹) :=
      mul_le_mul_of_nonneg_right hscale
        (mul_nonneg hnonneg (inv_nonneg.mpr (by positivity)))
    _ ≤ (2 / a) ^ 2 *
        ((SchwartzMap.seminorm ℝ 0 0 tau + SchwartzMap.seminorm ℝ 2 0 tau) *
          ((1 + (3 * a / 2) ^ 2) * (1 + s ^ 2)⁻¹)) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hden' hnonneg)
        (sq_nonneg _)
    _ = ((2 / a) ^ 2 *
        (SchwartzMap.seminorm ℝ 0 0 tau + SchwartzMap.seminorm ℝ 2 0 tau) *
          (1 + (3 * a / 2) ^ 2)) * (1 + s ^ 2)⁻¹ := by ring

private theorem twistedProduct_abs_le (n : ℕ)
    (f : Fin n → SchwartzMap (EuclideanSpace ℝ (Fin n)) ℝ)
    (x : EuclideanSpace ℝ (Fin n)) (s : ℝ) :
    |∏ i, f i (x + s • WithLp.toLp 2 (Pi.single i (1 : ℝ)) )| ≤
      ∏ i, SchwartzMap.seminorm ℝ 0 0 (f i) := by
  rw [Finset.abs_prod]
  apply Finset.prod_le_prod
  · intro i hi
    positivity
  · intro i hi
    simpa [Real.norm_eq_abs] using SchwartzMap.norm_le_seminorm ℝ (f i)
      (x + s • WithLp.toLp 2 (Pi.single i (1 : ℝ)))

private theorem twistedAverageAtScale_hasDerivAt
    {n : ℕ} (phi : SchwartzMap ℝ ℝ)
    (f : Fin n → SchwartzMap (EuclideanSpace ℝ (Fin n)) ℝ)
    (x : EuclideanSpace ℝ (Fin n)) (t : ℝ) (ht : 0 < t) :
    HasDerivAt
      (fun r ↦ twistedAverageAtScale r (fun u ↦ phi u) (fun i y ↦ f i y) x)
      (-t⁻¹ * twistedAverageAtScale t (aux_tBump phi) (fun i y ↦ f i y) x) t := by
  obtain ⟨tau, htau⟩ := tBump_eq_schwartz phi
  let P : ℝ → ℝ := fun s ↦
    ∏ i, f i (x + s • WithLp.toLp 2 (Pi.single i (1 : ℝ)))
  let B : ℝ := ∏ i, SchwartzMap.seminorm ℝ 0 0 (f i)
  have hPcont : Continuous P := by
    dsimp [P]
    fun_prop
  have hPbound : ∀ s : ℝ, ‖P s‖ ≤ B := by
    intro s
    change |∏ i, f i (x + s • WithLp.toLp 2 (Pi.single i (1 : ℝ)))| ≤ B
    simpa [B] using twistedProduct_abs_le n f x s
  have hBnonneg : 0 ≤ B := by
    dsimp [B]
    positivity
  let C : ℝ := (2 / t) ^ 2 *
    (SchwartzMap.seminorm ℝ 0 0 tau + SchwartzMap.seminorm ℝ 2 0 tau) *
      (1 + (3 * t / 2) ^ 2)
  have hCnonneg : 0 ≤ C := by
    dsimp [C]
    positivity
  let F : ℝ → ℝ → ℝ := fun r s ↦ aux_oneRescaled r (fun u ↦ phi u) s * P s
  let F' : ℝ → ℝ → ℝ := fun r s ↦ -r⁻¹ * aux_oneRescaled r tau s * P s
  have hFmeas : ∀ r : ℝ, AEStronglyMeasurable (F r) volume := by
    intro r
    apply ((continuous_const.mul
      (phi.continuous.comp (continuous_const.mul continuous_id))).mul hPcont).aestronglyMeasurable
  have hFint : Integrable (F t) := by
    have hscale : Integrable (fun s : ℝ ↦ aux_oneRescaled t (fun u ↦ phi u) s) := by
      unfold aux_oneRescaled
      convert (phi.integrable.comp_mul_left' (inv_ne_zero ht.ne')).const_mul t⁻¹ using 1
    simpa [F, mul_comm] using
      hscale.bdd_mul hPcont.aestronglyMeasurable (ae_of_all _ hPbound)
  have hF'derivMeas : AEStronglyMeasurable (F' t) volume := by
    apply ((continuous_const.mul
      (continuous_const.mul (tau.continuous.comp (continuous_const.mul continuous_id)))).mul
        hPcont).aestronglyMeasurable
  have hboundInt : Integrable (fun s : ℝ ↦ (C * B) * (1 + s ^ 2)⁻¹) :=
    integrable_inv_one_add_sq.const_mul (C * B)
  have hbound : ∀ᵐ s : ℝ ∂volume, ∀ r ∈ Set.Ioo (t / 2) (3 * t / 2),
      ‖F' r s‖ ≤ (C * B) * (1 + s ^ 2)⁻¹ := by
    filter_upwards [] with s r hr
    have hscale := rescaled_schwartz_local_bound tau t r s ht hr
    have hweightnonneg : 0 ≤ (1 + s ^ 2)⁻¹ := inv_nonneg.mpr (by positivity)
    have hfac : -r⁻¹ * (r⁻¹ * tau (r⁻¹ * s)) =
        -r⁻¹ ^ 2 * tau (r⁻¹ * s) := by ring
    calc
      ‖F' r s‖ = |-(r⁻¹ ^ 2) * tau (r⁻¹ * s)| * ‖P s‖ := by
        change |(-r⁻¹ * (r⁻¹ * tau (r⁻¹ * s))) * P s| = _
        rw [abs_mul, hfac, Real.norm_eq_abs]
      _ ≤ (C * (1 + s ^ 2)⁻¹) * B :=
        mul_le_mul hscale (hPbound s) (norm_nonneg _) (by positivity)
      _ = (C * B) * (1 + s ^ 2)⁻¹ := by ring
  have hdiff : ∀ᵐ s : ℝ ∂volume, ∀ r ∈ Set.Ioo (t / 2) (3 * t / 2),
      HasDerivAt (F · s) (F' r s) r := by
    filter_upwards [] with s r hr
    have hrne : r ≠ 0 := by
      have : 0 < r := lt_trans (by linarith) hr.1
      exact this.ne'
    have h := scaleKernel_hasDerivAt phi s r hrne
    rw [← htau] at h
    convert h.mul_const (P s) using 1
    all_goals first | rfl | (dsimp [F, F', aux_oneRescaled]; ring)
  obtain ⟨_, hderiv⟩ := hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := volume) (F := F) (F' := F') (bound := fun s : ℝ ↦ (C * B) * (1 + s ^ 2)⁻¹)
    (s := Set.Ioo (t / 2) (3 * t / 2)) (x₀ := t)
    (Ioo_mem_nhds (by linarith) (by linarith))
    (Filter.Eventually.of_forall hFmeas) hFint hF'derivMeas hbound hboundInt hdiff
  rw [← htau]
  let L : ℝ → ℝ := fun r ↦ ∫ s : ℝ, F r s
  let R : ℝ := ∫ s : ℝ, F' t s
  have hraw : HasDerivAt L R t := hderiv
  have hleft :
      (fun r ↦ twistedAverageAtScale r (fun u ↦ phi u) (fun i y ↦ f i y) x) = L := by
    funext r
    simp [L, F, P, twistedAverageAtScale, twistedAverage, aux_oneRescaled]
  have hright :
      -t⁻¹ * twistedAverageAtScale t (tau : ℝ → ℝ) (fun i y ↦ f i y) x = R := by
    simp [R, F', P, twistedAverageAtScale, twistedAverage, aux_oneRescaled,
      integral_neg, integral_const_mul, mul_assoc]
  rw [hleft, hright]
  exact hraw

/-- The scale derivative of a twisted average.  This is the differentiability
interface used by the final short/long-variation argument. -/
theorem aux_twistedAverageAtScale_hasDerivAt
    {n : ℕ} (phi : SchwartzMap ℝ ℝ)
    (f : Fin n → SchwartzMap (EuclideanSpace ℝ (Fin n)) ℝ)
    (x : EuclideanSpace ℝ (Fin n)) (t : ℝ) (ht : 0 < t) :
    HasDerivAt
      (fun r ↦ twistedAverageAtScale r (fun u ↦ phi u) (fun i y ↦ f i y) x)
      (-t⁻¹ * twistedAverageAtScale t (aux_tBump phi) (fun i y ↦ f i y) x) t :=
  twistedAverageAtScale_hasDerivAt phi f x t ht

private theorem logarithmic_setIntegral_rescale (a : ℝ) (ha : 0 < a)
    (g : ℝ → ℝ) :
    (∫ t : ℝ in Set.Icc a (a * 2), |g t| ^ 2 * t⁻¹) =
      ∫ t : ℝ in Set.Icc 1 2, |g (a * t)| ^ 2 * t⁻¹ := by
  let h : ℝ → ℝ := fun u => |g u| ^ 2 * u⁻¹
  have hinterval :
      (∫ t : ℝ in Set.Icc a (a * 2), h t) =
        a * ∫ t : ℝ in Set.Icc 1 2, h (a * t) := by
    have hcomp := intervalIntegral.integral_comp_mul_left h ha.ne'
      (a := (1 : ℝ)) (b := 2)
    rw [MeasureTheory.integral_Icc_eq_integral_Ioc,
      ← intervalIntegral.integral_of_le (by nlinarith)]
    calc
      (∫ t : ℝ in a..a * 2, h t) = a * (a⁻¹ * ∫ t : ℝ in a..a * 2, h t) := by
        field_simp [ha.ne']
      _ = a * ∫ t : ℝ in 1..2, h (a * t) := by
        rw [hcomp]
        simp only [smul_eq_mul]
        ring_nf
      _ = a * ∫ t : ℝ in Set.Icc 1 2, h (a * t) := by
        congr 1
        rw [MeasureTheory.integral_Icc_eq_integral_Ioc,
          ← intervalIntegral.integral_of_le (by norm_num)]
  change (∫ t : ℝ in Set.Icc a (a * 2), h t) = _
  rw [hinterval]
  rw [← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [] with t
  dsimp [h]
  field_simp [ha.ne']

/--
\begin{lemma} \label{lem:ftc_ATphi}
Let $x\in \R^n$, $\phi$ a Schwartz function,  $t\in [2^k, 2^{k+1}]$, $k\in \Z$.
Let $a(t)=A_t(\phi)(x)$. Then
\begin{equation}\label{auto:average-logarithmic-derivative-identity}
\|ta'(t)\|_{L^2(t\in [2^k, 2^{k+1}],\tfrac{dt}{t})}^2 =
\int_{1}^2 |A_{2^k t}(T\phi)(x)|^2\,\tfrac{dt}{t}.
\end{equation}
\end{lemma}
-/
theorem ftcATphi {n : ℕ} (phi : SchwartzMap ℝ ℝ)
    (f : Fin n → SchwartzMap (EuclideanSpace ℝ (Fin n)) ℝ)
    (x : EuclideanSpace ℝ (Fin n)) (k : ℤ) :
    (∫ t : ℝ in Set.Icc ((2 : ℝ) ^ k) ((2 : ℝ) ^ (k + 1)),
      |t * deriv (fun s ↦
        twistedAverageAtScale s (fun u ↦ phi u) (fun i y ↦ f i y) x) t| ^ 2 * t⁻¹) =
      ∫ t : ℝ in Set.Icc 1 2,
        |twistedAverageAtScale ((2 : ℝ) ^ k * t) (aux_tBump phi)
          (fun i y ↦ f i y) x| ^ 2 * t⁻¹ := by
  let a : ℝ := (2 : ℝ) ^ k
  have ha : 0 < a := by
    dsimp [a]
    exact zpow_pos (by norm_num) _
  have hpow : (2 : ℝ) ^ (k + 1) = a * 2 := by
    dsimp [a]
    rw [zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_one]
  let g : ℝ → ℝ := fun t ↦
    twistedAverageAtScale t (aux_tBump phi) (fun i y ↦ f i y) x
  have hderiv : ∀ t ∈ Set.Icc a (a * 2),
      t * deriv (fun s ↦
        twistedAverageAtScale s (fun u ↦ phi u) (fun i y ↦ f i y) x) t = -g t := by
    intro t ht
    have htpos : 0 < t := lt_of_lt_of_le ha ht.1
    have h := twistedAverageAtScale_hasDerivAt phi f x t htpos
    rw [h.deriv]
    dsimp [g]
    field_simp [htpos.ne']
  rw [hpow]
  calc
    (∫ t : ℝ in Set.Icc a (a * 2),
        |t * deriv (fun s ↦ twistedAverageAtScale s (fun u ↦ phi u)
          (fun i y ↦ f i y) x) t| ^ 2 * t⁻¹) =
        ∫ t : ℝ in Set.Icc a (a * 2), |g t| ^ 2 * t⁻¹ := by
      apply setIntegral_congr_fun measurableSet_Icc
      intro t ht
      change |t * deriv (fun s ↦ twistedAverageAtScale s (fun u ↦ phi u)
        (fun i y ↦ f i y) x) t| ^ 2 * t⁻¹ = |g t| ^ 2 * t⁻¹
      rw [hderiv t ht, abs_neg]
    _ = ∫ t : ℝ in Set.Icc 1 2, |g (a * t)| ^ 2 * t⁻¹ :=
      logarithmic_setIntegral_rescale a ha g
    _ = ∫ t : ℝ in Set.Icc 1 2,
        |twistedAverageAtScale ((2 : ℝ) ^ k * t) (aux_tBump phi)
          (fun i y ↦ f i y) x| ^ 2 * t⁻¹ := by
      apply setIntegral_congr_fun measurableSet_Icc
      intro t ht
      rfl

/-- The fixed constant in Lemma [`Codex.Reduction.Miscellany.phiJProperties`]. -/
noncomputable def C_phiJProperties : ℝ := 2 ^ 12 * C_uniPair

/- Private Fourier-profile infrastructure for `phiJProperties`. -/
private def aux_phiJ_profile (phi : SchwartzMap ℝ ℝ) : ℝ → ℂ :=
  FourierTransform.fourier (fun x : ℝ => (phi x : ℂ))

private def aux_phiJ_theta (phi0 phi1 : SchwartzMap ℝ ℝ) : ℝ → ℂ :=
  fun xi => aux_phiJ_profile phi0 ((2 : ℝ) ^ (-5 : ℤ) * xi) -
    aux_phiJ_profile phi1 ((2 : ℝ) ^ (5 : ℤ) * xi)

private theorem aux_phiJ_fourier_neg_conj (phi : ℝ → ℝ) (w : ℝ) :
    FourierTransform.fourier (fun u => (phi u : ℂ)) (-w) =
      (starRingEnd ℂ) (FourierTransform.fourier (fun u => (phi u : ℂ)) w) := by
  rw [Real.fourier_eq, Real.fourier_eq, ← integral_conj]
  change (∫ v : ℝ, 𝐞 (-inner ℝ v (-w)) • (phi v : ℂ)) =
    ∫ v : ℝ, star (𝐞 (-inner ℝ v w) • (phi v : ℂ))
  apply integral_congr_ae
  filter_upwards [] with u
  rw [Circle.smul_def, Circle.smul_def, Real.fourierChar_apply,
    Real.fourierChar_apply]
  change Complex.exp (↑(2 * Real.pi * (-inner ℝ u (-w))) * Complex.I) * (phi u : ℂ) =
    (starRingEnd ℂ) (Complex.exp (↑(2 * Real.pi * (-inner ℝ u w)) * Complex.I) *
      (phi u : ℂ))
  rw [map_mul]
  congr 1
  · rw [← Complex.exp_conj]
    rw [inner_neg_right]
    simp only [map_mul, Complex.conj_I, Complex.conj_ofReal]
    congr 1
    push_cast
    ring
  · simp

private theorem aux_phiJ_profile_even_of_window (phi : SchwartzMap ℝ ℝ)
    (hwin : cnWindow C_uniPair N_uniPair phi) (xi : ℝ) :
    aux_phiJ_profile phi (-xi) = aux_phiJ_profile phi xi := by
  rw [aux_phiJ_profile, aux_phiJ_fourier_neg_conj]
  rcases hwin.2.1 xi with ⟨r, hr, hEq⟩
  rw [hEq]
  simp

private theorem aux_phiJ_theta_even (phi0 phi1 : SchwartzMap ℝ ℝ)
    (hpair : uniPair phi0 phi1) (xi : ℝ) :
    aux_phiJ_theta phi0 phi1 (-xi) = aux_phiJ_theta phi0 phi1 xi := by
  unfold aux_phiJ_theta
  rw [show (2 : ℝ) ^ (-5 : ℤ) * -xi = -((2 : ℝ) ^ (-5 : ℤ) * xi) by ring,
    show (2 : ℝ) ^ (5 : ℤ) * -xi = -((2 : ℝ) ^ (5 : ℤ) * xi) by ring,
    aux_phiJ_profile_even_of_window phi0 hpair.1,
    aux_phiJ_profile_even_of_window phi1 hpair.2.1]

private theorem aux_phiJ_profile_eq_one_of_abs_le_half (phi : SchwartzMap ℝ ℝ)
    (hwin : cnWindow C_uniPair N_uniPair phi) (x : ℝ) (hx : |x| ≤ 1 / 2) :
    aux_phiJ_profile phi x = 1 := by
  exact hwin.2.2.2.1 x (abs_le.mp hx)

private theorem aux_phiJ_profile_eq_zero_of_one_lt_abs (phi : SchwartzMap ℝ ℝ)
    (hwin : cnWindow C_uniPair N_uniPair phi) (x : ℝ) (hx : 1 < |x|) :
    aux_phiJ_profile phi x = 0 := by
  apply Function.notMem_support.mp
  intro hsupp
  have hmem := hwin.2.2.1 hsupp
  have habs : |x| ≤ 1 := abs_le.mpr hmem
  linarith

private theorem aux_phiJ_theta_eq_zero_small (phi0 phi1 : SchwartzMap ℝ ℝ)
    (hpair : uniPair phi0 phi1) (xi : ℝ) (hxi : |xi| ≤ 1 / 64) :
    aux_phiJ_theta phi0 phi1 xi = 0 := by
  have h0 : cnWindow C_uniPair N_uniPair phi0 := hpair.1
  have h1 : cnWindow C_uniPair N_uniPair phi1 := hpair.2.1
  have hleft : |(2 : ℝ) ^ (-5 : ℤ) * xi| ≤ 1 / 2 := by
    rw [abs_mul, abs_of_pos (zpow_pos (by norm_num) _)]
    norm_num
    linarith
  have hright : |(2 : ℝ) ^ (5 : ℤ) * xi| ≤ 1 / 2 := by
    rw [abs_mul, abs_of_pos (zpow_pos (by norm_num) _)]
    norm_num
    linarith
  unfold aux_phiJ_theta
  rw [aux_phiJ_profile_eq_one_of_abs_le_half phi0 h0 _ hleft,
    aux_phiJ_profile_eq_one_of_abs_le_half phi1 h1 _ hright]
  ring

private theorem aux_phiJ_theta_eq_one_mid (phi0 phi1 : SchwartzMap ℝ ℝ)
    (hpair : uniPair phi0 phi1) (xi : ℝ)
    (hlow : 1 / 16 ≤ |xi|) (hhigh : |xi| ≤ 16) :
    aux_phiJ_theta phi0 phi1 xi = 1 := by
  have h0 : cnWindow C_uniPair N_uniPair phi0 := hpair.1
  have h1 : cnWindow C_uniPair N_uniPair phi1 := hpair.2.1
  have hleft : |(2 : ℝ) ^ (-5 : ℤ) * xi| ≤ 1 / 2 := by
    rw [abs_mul, abs_of_pos (zpow_pos (by norm_num) _)]
    norm_num
    linarith
  have hright : 1 < |(2 : ℝ) ^ (5 : ℤ) * xi| := by
    rw [abs_mul, abs_of_pos (zpow_pos (by norm_num) _)]
    norm_num
    linarith
  unfold aux_phiJ_theta
  rw [aux_phiJ_profile_eq_one_of_abs_le_half phi0 h0 _ hleft,
    aux_phiJ_profile_eq_zero_of_one_lt_abs phi1 h1 _ hright]
  ring

private theorem aux_phiJ_theta_eq_zero_large (phi0 phi1 : SchwartzMap ℝ ℝ)
    (hpair : uniPair phi0 phi1) (xi : ℝ) (hxi : 64 < |xi|) :
    aux_phiJ_theta phi0 phi1 xi = 0 := by
  have h0 : cnWindow C_uniPair N_uniPair phi0 := hpair.1
  have h1 : cnWindow C_uniPair N_uniPair phi1 := hpair.2.1
  have hleft : 1 < |(2 : ℝ) ^ (-5 : ℤ) * xi| := by
    rw [abs_mul, abs_of_pos (zpow_pos (by norm_num) _)]
    norm_num
    linarith
  have hright : 1 < |(2 : ℝ) ^ (5 : ℤ) * xi| := by
    rw [abs_mul, abs_of_pos (zpow_pos (by norm_num) _)]
    norm_num
    linarith
  unfold aux_phiJ_theta
  rw [aux_phiJ_profile_eq_zero_of_one_lt_abs phi0 h0 _ hleft,
    aux_phiJ_profile_eq_zero_of_one_lt_abs phi1 h1 _ hright]
  ring

private theorem aux_phiJ_theta_support (phi0 phi1 : SchwartzMap ℝ ℝ)
    (hpair : uniPair phi0 phi1) :
    Function.support (aux_phiJ_theta phi0 phi1) ⊆
      Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 6) := by
  intro xi hxi
  rw [Codex.Reduction.BumpFunctions.aux_annulusOne]
  constructor
  · by_contra hnot
    push Not at hnot
    have hsmall : |xi| ≤ 1 / 64 := by
      norm_num at hnot ⊢
      exact hnot.le
    exact (Function.mem_support.mp hxi)
      (aux_phiJ_theta_eq_zero_small phi0 phi1 hpair xi hsmall)
  · by_contra hnot
    push Not at hnot
    have hlarge : 64 < |xi| := by
      norm_num at hnot ⊢
      exact hnot
    exact (Function.mem_support.mp hxi)
      (aux_phiJ_theta_eq_zero_large phi0 phi1 hpair xi hlarge)

private theorem aux_phiJ_theta_one_on_annulus (phi0 phi1 : SchwartzMap ℝ ℝ)
    (hpair : uniPair phi0 phi1) (xi : ℝ)
    (hxi : xi ∈ Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 4)) :
    aux_phiJ_theta phi0 phi1 xi = 1 := by
  rw [Codex.Reduction.BumpFunctions.aux_annulusOne] at hxi
  have hlow : 1 / 16 ≤ |xi| := by
    norm_num at hxi ⊢
    exact hxi.1
  have hhigh : |xi| ≤ 16 := by
    norm_num at hxi ⊢
    exact hxi.2
  exact aux_phiJ_theta_eq_one_mid phi0 phi1 hpair xi hlow hhigh

private theorem aux_phiJ_theta_real_nonneg (phi0 phi1 : SchwartzMap ℝ ℝ)
    (hpair : uniPair phi0 phi1) (xi : ℝ) :
    ∃ r : ℝ, 0 ≤ r ∧ aux_phiJ_theta phi0 phi1 xi = r := by
  have h0 : cnWindow C_uniPair N_uniPair phi0 := hpair.1
  have h1 : cnWindow C_uniPair N_uniPair phi1 := hpair.2.1
  by_cases hsmall : |xi| ≤ 1 / 64
  · refine ⟨0, le_rfl, ?_⟩
    simpa using aux_phiJ_theta_eq_zero_small phi0 phi1 hpair xi hsmall
  have hsmall' : 1 / 64 < |xi| := lt_of_not_ge hsmall
  by_cases hmid : |xi| ≤ 16
  · rcases h1.2.1 ((2 : ℝ) ^ (5 : ℤ) * xi) with ⟨r, hr, hEq⟩
    have hEq' : aux_phiJ_profile phi1 ((2 : ℝ) ^ (5 : ℤ) * xi) = r := by
      simpa [aux_phiJ_profile] using hEq
    refine ⟨1 - r, sub_nonneg.mpr hr.2, ?_⟩
    have hleft : |(2 : ℝ) ^ (-5 : ℤ) * xi| ≤ 1 / 2 := by
      rw [abs_mul, abs_of_pos (zpow_pos (by norm_num) _)]
      norm_num
      linarith
    unfold aux_phiJ_theta
    rw [aux_phiJ_profile_eq_one_of_abs_le_half phi0 h0 _ hleft, hEq']
    push_cast
    ring
  have hmid' : 16 < |xi| := lt_of_not_ge hmid
  by_cases hlarge : |xi| ≤ 64
  · rcases h0.2.1 ((2 : ℝ) ^ (-5 : ℤ) * xi) with ⟨r, hr, hEq⟩
    have hEq' : aux_phiJ_profile phi0 ((2 : ℝ) ^ (-5 : ℤ) * xi) = r := by
      simpa [aux_phiJ_profile] using hEq
    refine ⟨r, hr.1, ?_⟩
    have hright : 1 < |(2 : ℝ) ^ (5 : ℤ) * xi| := by
      rw [abs_mul, abs_of_pos (zpow_pos (by norm_num) _)]
      norm_num
      linarith
    unfold aux_phiJ_theta
    rw [hEq', aux_phiJ_profile_eq_zero_of_one_lt_abs phi1 h1 _ hright]
    ring
  · refine ⟨0, le_rfl, ?_⟩
    have hlarge' : 64 < |xi| := lt_of_not_ge hlarge
    simpa using aux_phiJ_theta_eq_zero_large phi0 phi1 hpair xi hlarge'

private theorem aux_phiJ_profile_smooth (phi : SchwartzMap ℝ ℝ) :
    ContDiff ℝ (⊤ : ℕ∞) (aux_phiJ_profile phi) := by
  let phiC : SchwartzMap ℝ ℂ :=
    phi.postcompCLM (𝕜 := ℝ) Complex.ofRealCLM
  have hs : ContDiff ℝ (⊤ : ℕ∞) (FourierTransform.fourier phiC : ℝ → ℂ) :=
    (FourierTransform.fourier phiC).smooth (⊤ : ℕ∞)
  have hphiC : (phiC : ℝ → ℂ) = fun x : ℝ => (phi x : ℂ) := by
    funext x
    simp [phiC, SchwartzMap.postcompCLM_apply]
  rw [SchwartzMap.fourier_coe, hphiC] at hs
  exact hs

private theorem aux_phiJ_profile_deriv_bound (c : ℝ) (N : ℕ)
    (phi : SchwartzMap ℝ ℝ) (hwin : cnWindow c N phi)
    (m : ℕ) (hm : m ≤ N) (xi : ℝ) :
    ‖iteratedDeriv m (aux_phiJ_profile phi) xi‖ ≤ c := by
  have hFsupp : Function.support (aux_phiJ_profile phi) ⊆ Set.Icc (-1 : ℝ) 1 := by
    simpa [aux_phiJ_profile] using hwin.2.2.1
  have hFtsupp : tsupport (aux_phiJ_profile phi) ⊆ Set.Icc (-1 : ℝ) 1 :=
    closure_minimal hFsupp isClosed_Icc
  by_cases hxi : xi ∈ Set.Icc (-1 : ℝ) 1
  · change ‖iteratedDeriv m (fun x : ℝ =>
        FourierTransform.fourier (fun y : ℝ => (phi y : ℂ)) x) xi‖ ≤ c
    exact hwin.2.2.2.2 xi hxi m hm
  · have hderivSupp : Function.support (iteratedDeriv m (aux_phiJ_profile phi)) ⊆
        Set.Icc (-1 : ℝ) 1 :=
      (subset_tsupport _).trans
        ((Codex.Preliminaries.BumpsAndEstimates.aux_tsupport_iteratedDeriv_subset
          (aux_phiJ_profile phi) m).trans hFtsupp)
    have hzero : iteratedDeriv m (aux_phiJ_profile phi) xi = 0 := by
      apply Function.notMem_support.mp
      intro hsupp
      exact hxi (hderivSupp hsupp)
    rw [hzero, norm_zero]
    exact hwin.1.le

private theorem aux_phiJ_theta_smooth (phi0 phi1 : SchwartzMap ℝ ℝ) :
    ContDiff ℝ (⊤ : ℕ∞) (aux_phiJ_theta phi0 phi1) := by
  unfold aux_phiJ_theta
  exact ((aux_phiJ_profile_smooth phi0).comp (contDiff_const.mul contDiff_id)).sub
    ((aux_phiJ_profile_smooth phi1).comp (contDiff_const.mul contDiff_id))

private theorem aux_phiJ_theta_deriv_formula (phi0 phi1 : SchwartzMap ℝ ℝ)
    (m : ℕ) (xi : ℝ) :
    iteratedDeriv m (aux_phiJ_theta phi0 phi1) xi =
      ((2 : ℝ) ^ (-5 : ℤ)) ^ m •
        iteratedDeriv m (aux_phiJ_profile phi0) ((2 : ℝ) ^ (-5 : ℤ) * xi) -
      ((2 : ℝ) ^ (5 : ℤ)) ^ m •
        iteratedDeriv m (aux_phiJ_profile phi1) ((2 : ℝ) ^ (5 : ℤ) * xi) := by
  have hF0 : ContDiff ℝ m (aux_phiJ_profile phi0) :=
    (aux_phiJ_profile_smooth phi0).of_le
      (show (m : WithTop ℕ∞) ≤ (↑(⊤ : ℕ∞) : WithTop ℕ∞) by
        exact WithTop.coe_le_coe.mpr le_top)
  have hF1 : ContDiff ℝ m (aux_phiJ_profile phi1) :=
    (aux_phiJ_profile_smooth phi1).of_le
      (show (m : WithTop ℕ∞) ≤ (↑(⊤ : ℕ∞) : WithTop ℕ∞) by
        exact WithTop.coe_le_coe.mpr le_top)
  have hcomp0 : ContDiff ℝ m
      (fun x : ℝ => aux_phiJ_profile phi0 ((2 : ℝ) ^ (-5 : ℤ) * x)) :=
    hF0.comp (contDiff_const.mul contDiff_id)
  have hcomp1 : ContDiff ℝ m
      (fun x : ℝ => aux_phiJ_profile phi1 ((2 : ℝ) ^ (5 : ℤ) * x)) :=
    hF1.comp (contDiff_const.mul contDiff_id)
  change iteratedDeriv m
    ((fun x : ℝ => aux_phiJ_profile phi0 ((2 : ℝ) ^ (-5 : ℤ) * x)) -
      (fun x : ℝ => aux_phiJ_profile phi1 ((2 : ℝ) ^ (5 : ℤ) * x))) xi = _
  rw [iteratedDeriv_sub hcomp0.contDiffAt hcomp1.contDiffAt,
    congrFun (iteratedDeriv_comp_const_smul hF0 ((2 : ℝ) ^ (-5 : ℤ))) xi,
    congrFun (iteratedDeriv_comp_const_smul hF1 ((2 : ℝ) ^ (5 : ℤ))) xi]

private theorem aux_phiJ_theta_deriv_bound (phi0 phi1 : SchwartzMap ℝ ℝ)
    (hpair : uniPair phi0 phi1) (m : ℕ) (hm : m < 3) (xi : ℝ) :
    ‖iteratedDeriv m (aux_phiJ_theta phi0 phi1) xi‖ ≤
      (2 : ℝ) ^ 12 * C_uniPair := by
  have hm3 : m ≤ 3 := by omega
  have h0 : cnWindow C_uniPair N_uniPair phi0 := hpair.1
  have h1 : cnWindow C_uniPair N_uniPair phi1 := hpair.2.1
  have hF0 := aux_phiJ_profile_deriv_bound C_uniPair N_uniPair phi0 h0 m
    (by simpa [N_uniPair] using hm3)
  have hF1 := aux_phiJ_profile_deriv_bound C_uniPair N_uniPair phi1 h1 m
    (by simpa [N_uniPair] using hm3)
  rw [aux_phiJ_theta_deriv_formula]
  calc
    ‖((2 : ℝ) ^ (-5 : ℤ)) ^ m • iteratedDeriv m (aux_phiJ_profile phi0)
          ((2 : ℝ) ^ (-5 : ℤ) * xi) -
        ((2 : ℝ) ^ (5 : ℤ)) ^ m • iteratedDeriv m (aux_phiJ_profile phi1)
          ((2 : ℝ) ^ (5 : ℤ) * xi)‖ ≤
        ‖((2 : ℝ) ^ (-5 : ℤ)) ^ m • iteratedDeriv m (aux_phiJ_profile phi0)
          ((2 : ℝ) ^ (-5 : ℤ) * xi)‖ +
        ‖((2 : ℝ) ^ (5 : ℤ)) ^ m • iteratedDeriv m (aux_phiJ_profile phi1)
          ((2 : ℝ) ^ (5 : ℤ) * xi)‖ := norm_sub_le _ _
    _ = ((2 : ℝ) ^ (-5 : ℤ)) ^ m *
          ‖iteratedDeriv m (aux_phiJ_profile phi0) ((2 : ℝ) ^ (-5 : ℤ) * xi)‖ +
        ((2 : ℝ) ^ (5 : ℤ)) ^ m *
          ‖iteratedDeriv m (aux_phiJ_profile phi1) ((2 : ℝ) ^ (5 : ℤ) * xi)‖ := by
      rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs,
        abs_of_nonneg (pow_nonneg (zpow_nonneg (by norm_num) _) _),
        abs_of_nonneg (pow_nonneg (zpow_nonneg (by norm_num) _) _)]
    _ ≤ ((2 : ℝ) ^ (-5 : ℤ)) ^ m * C_uniPair +
        ((2 : ℝ) ^ (5 : ℤ)) ^ m * C_uniPair := by
      apply add_le_add
      · exact mul_le_mul_of_nonneg_left (hF0 _)
          (pow_nonneg (zpow_nonneg (by norm_num) _) _)
      · exact mul_le_mul_of_nonneg_left (hF1 _)
          (pow_nonneg (zpow_nonneg (by norm_num) _) _)
    _ ≤ (2 : ℝ) ^ 12 * C_uniPair := by
      interval_cases m <;> norm_num [C_uniPair]

private def aux_phiJ_thetaReal (phi0 phi1 : SchwartzMap ℝ ℝ) : ℝ → ℝ :=
  fun xi => (aux_phiJ_theta phi0 phi1 xi).re

private theorem aux_phiJ_theta_eq_ofReal (phi0 phi1 : SchwartzMap ℝ ℝ)
    (hpair : uniPair phi0 phi1) :
    aux_phiJ_theta phi0 phi1 = fun xi => (aux_phiJ_thetaReal phi0 phi1 xi : ℂ) := by
  funext xi
  rcases aux_phiJ_theta_real_nonneg phi0 phi1 hpair xi with ⟨r, _, hr⟩
  change aux_phiJ_theta phi0 phi1 xi = ((aux_phiJ_theta phi0 phi1 xi).re : ℂ)
  rw [hr]
  norm_num

private theorem aux_phiJ_thetaReal_smooth (phi0 phi1 : SchwartzMap ℝ ℝ) :
    ContDiff ℝ (⊤ : ℕ∞) (aux_phiJ_thetaReal phi0 phi1) := by
  exact Complex.reCLM.contDiff.comp (aux_phiJ_theta_smooth phi0 phi1)

private theorem aux_phiJ_theta_deriv_bound_sharp (phi0 phi1 : SchwartzMap ℝ ℝ)
    (hpair : uniPair phi0 phi1) (m : ℕ) (hm : m < 3) (xi : ℝ) :
    ‖iteratedDeriv m (aux_phiJ_theta phi0 phi1) xi‖ ≤
      (2 : ℝ) ^ (5 * m + 1) * C_uniPair := by
  have hm3 : m ≤ 3 := by omega
  have h0 : cnWindow C_uniPair N_uniPair phi0 := hpair.1
  have h1 : cnWindow C_uniPair N_uniPair phi1 := hpair.2.1
  have hF0 := aux_phiJ_profile_deriv_bound C_uniPair N_uniPair phi0 h0 m
    (by simpa [N_uniPair] using hm3)
  have hF1 := aux_phiJ_profile_deriv_bound C_uniPair N_uniPair phi1 h1 m
    (by simpa [N_uniPair] using hm3)
  rw [aux_phiJ_theta_deriv_formula]
  calc
    ‖((2 : ℝ) ^ (-5 : ℤ)) ^ m • iteratedDeriv m (aux_phiJ_profile phi0)
          ((2 : ℝ) ^ (-5 : ℤ) * xi) -
        ((2 : ℝ) ^ (5 : ℤ)) ^ m • iteratedDeriv m (aux_phiJ_profile phi1)
          ((2 : ℝ) ^ (5 : ℤ) * xi)‖ ≤
        ‖((2 : ℝ) ^ (-5 : ℤ)) ^ m • iteratedDeriv m (aux_phiJ_profile phi0)
          ((2 : ℝ) ^ (-5 : ℤ) * xi)‖ +
        ‖((2 : ℝ) ^ (5 : ℤ)) ^ m • iteratedDeriv m (aux_phiJ_profile phi1)
          ((2 : ℝ) ^ (5 : ℤ) * xi)‖ := norm_sub_le _ _
    _ = ((2 : ℝ) ^ (-5 : ℤ)) ^ m *
          ‖iteratedDeriv m (aux_phiJ_profile phi0) ((2 : ℝ) ^ (-5 : ℤ) * xi)‖ +
        ((2 : ℝ) ^ (5 : ℤ)) ^ m *
          ‖iteratedDeriv m (aux_phiJ_profile phi1) ((2 : ℝ) ^ (5 : ℤ) * xi)‖ := by
      rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs,
        abs_of_nonneg (pow_nonneg (zpow_nonneg (by norm_num) _) _),
        abs_of_nonneg (pow_nonneg (zpow_nonneg (by norm_num) _) _)]
    _ ≤ ((2 : ℝ) ^ (-5 : ℤ)) ^ m * C_uniPair +
        ((2 : ℝ) ^ (5 : ℤ)) ^ m * C_uniPair := by
      apply add_le_add
      · exact mul_le_mul_of_nonneg_left (hF0 _)
          (pow_nonneg (zpow_nonneg (by norm_num) _) _)
      · exact mul_le_mul_of_nonneg_left (hF1 _)
          (pow_nonneg (zpow_nonneg (by norm_num) _) _)
    _ ≤ (2 : ℝ) ^ (5 * m + 1) * C_uniPair := by
      interval_cases m <;> norm_num [C_uniPair]

private theorem aux_phiJ_thetaReal_deriv_bound_sharp (phi0 phi1 : SchwartzMap ℝ ℝ)
    (hpair : uniPair phi0 phi1) (m : ℕ) (hm : m < 3) (xi : ℝ) :
    |iteratedDeriv m (aux_phiJ_thetaReal phi0 phi1) xi| ≤
      (2 : ℝ) ^ (5 * m + 1) * C_uniPair := by
  have hsmooth : ContDiff ℝ (m + 1) (aux_phiJ_thetaReal phi0 phi1) :=
    (aux_phiJ_thetaReal_smooth phi0 phi1).of_le
      (show (m + 1 : WithTop ℕ∞) ≤ (↑(⊤ : ℕ∞) : WithTop ℕ∞) by
        exact WithTop.coe_le_coe.mpr le_top)
  have hreal := Codex.Preliminaries.BumpsAndEstimates.aux_gaussianBumpEstimate_iteratedDeriv_ofReal
    m (aux_phiJ_thetaReal phi0 phi1) hsmooth xi
  calc
    |iteratedDeriv m (aux_phiJ_thetaReal phi0 phi1) xi| =
        ‖((iteratedDeriv m (aux_phiJ_thetaReal phi0 phi1) xi : ℝ) : ℂ)‖ := by
          rw [Complex.norm_real, Real.norm_eq_abs]
    _ = ‖iteratedDeriv m (fun y : ℝ => (aux_phiJ_thetaReal phi0 phi1 y : ℂ)) xi‖ := by
          rw [hreal]
    _ = ‖iteratedDeriv m (aux_phiJ_theta phi0 phi1) xi‖ := by
          rw [aux_phiJ_theta_eq_ofReal phi0 phi1 hpair]
    _ ≤ _ := aux_phiJ_theta_deriv_bound_sharp phi0 phi1 hpair m hm xi

private def aux_phiJ_q (theta p : ℝ → ℝ) : ℝ → ℝ :=
  fun x => √(2 * theta x ^ 2 - p x)

private theorem aux_phiJ_q_eq_inner (theta p : ℝ → ℝ) (B : Set ℝ)
    (htheta_one : ∀ x ∈ B, theta x = 1) :
    Set.EqOn (aux_phiJ_q theta p) (fun x => √(2 - p x)) B := by
  intro x hx
  unfold aux_phiJ_q
  rw [htheta_one x hx]
  congr 1
  ring

private theorem aux_phiJ_q_eq_outer (theta p : ℝ → ℝ) (A : Set ℝ)
    (htheta_nonneg : ∀ x, 0 ≤ theta x)
    (hp_off : ∀ x ∉ A, p x = 0) :
    Set.EqOn (aux_phiJ_q theta p) (fun x => √2 * theta x) Aᶜ := by
  intro x hx
  unfold aux_phiJ_q
  rw [hp_off x hx]
  calc
    √(2 * theta x ^ 2 - 0) = √(2 * theta x ^ 2) := by ring_nf
    _ = √2 * √(theta x ^ 2) := Real.sqrt_mul (by norm_num) _
    _ = √2 * theta x := by rw [Real.sqrt_sq (htheta_nonneg x)]

private theorem aux_phiJ_q_contDiff
    (A B : Set ℝ) (theta p : ℝ → ℝ)
    (htheta : ContDiff ℝ (⊤ : ℕ∞) theta)
    (hp : ContDiff ℝ (⊤ : ℕ∞) p)
    (hAclosed : IsClosed A)
    (hAB : A ⊆ interior B)
    (htheta_one : ∀ x ∈ B, theta x = 1)
    (htheta_nonneg : ∀ x, 0 ≤ theta x)
    (hp_off : ∀ x ∉ A, p x = 0)
    (hp_le_one : ∀ x, p x ≤ 1) :
    ContDiff ℝ (⊤ : ℕ∞) (aux_phiJ_q theta p) := by
  rw [contDiff_iff_contDiffAt]
  intro x
  by_cases hx : x ∈ A
  · have hxB : x ∈ interior B := hAB hx
    have hBnhds : B ∈ nhds x := mem_interior_iff_mem_nhds.mp hxB
    have heq : aux_phiJ_q theta p =ᶠ[nhds x] (fun y => √(2 - p y)) := by
      filter_upwards [hBnhds] with y hy
      exact aux_phiJ_q_eq_inner theta p B htheta_one hy
    have hinside : ContDiffAt ℝ (⊤ : ℕ∞) (fun y : ℝ => 2 - p y) x :=
      (contDiff_const.sub hp).contDiffAt
    apply (hinside.sqrt (by linarith [hp_le_one x])).congr_of_eventuallyEq heq
  · have hAn : Aᶜ ∈ nhds x := hAclosed.isOpen_compl.mem_nhds hx
    have heq : aux_phiJ_q theta p =ᶠ[nhds x] (fun y => √2 * theta y) := by
      filter_upwards [hAn] with y hy
      exact aux_phiJ_q_eq_outer theta p A htheta_nonneg hp_off hy
    exact (contDiff_const.mul htheta).contDiffAt.congr_of_eventuallyEq heq

private theorem aux_phiJ_q_zero_outside
    (A K : Set ℝ) (theta p : ℝ → ℝ)
    (hAK : A ⊆ K) (htheta_zero : ∀ x ∉ K, theta x = 0)
    (hp_off : ∀ x ∉ A, p x = 0) (x : ℝ) (hx : x ∉ K) :
    aux_phiJ_q theta p x = 0 := by
  unfold aux_phiJ_q
  rw [htheta_zero x hx, hp_off x (fun hxA => hx (hAK hxA))]
  norm_num

private theorem aux_phiJ_q_hasCompactSupport
    (A K : Set ℝ) (theta p : ℝ → ℝ)
    (hKcompact : IsCompact K) (hAK : A ⊆ K)
    (htheta_zero : ∀ x ∉ K, theta x = 0)
    (hp_off : ∀ x ∉ A, p x = 0) :
    HasCompactSupport (aux_phiJ_q theta p) := by
  exact HasCompactSupport.intro hKcompact
    (aux_phiJ_q_zero_outside A K theta p hAK htheta_zero hp_off)

private theorem aux_phiJ_q_even (theta p : ℝ → ℝ)
    (htheta : ∀ x, theta (-x) = theta x)
    (hp : ∀ x, p (-x) = p x) :
    ∀ x, aux_phiJ_q theta p (-x) = aux_phiJ_q theta p x := by
  intro x
  unfold aux_phiJ_q
  rw [htheta x, hp x]

private theorem aux_phiJ_sqrt_comp_second_deriv_bound {f : ℝ → ℝ} (hf : ContDiff ℝ 2 f)
    (h0 : ∀ x, 1 ≤ f x) (h1 : ∀ x, |deriv f x| ≤ 1)
    (h2 : ∀ x, |iteratedDeriv 2 f x| ≤ 1) (x : ℝ) :
    |iteratedDeriv 2 (fun y => √(f y)) x| ≤ 1 := by
  have hfx : 0 < f x := lt_of_lt_of_le zero_lt_one (h0 x)
  have hsqrt : 1 ≤ √(f x) := by
    rw [← Real.sqrt_one]
    exact Real.sqrt_le_sqrt (h0 x)
  have hcomp : ContDiffAt ℝ 2 (√·) (f x) := Real.contDiffAt_sqrt hfx.ne'
  rw [show (fun y => √(f y)) = (√·) ∘ f by rfl,
    iteratedDeriv_comp_two hcomp hf.contDiffAt]
  have htwo : iteratedDeriv 2 (√·) (f x) = -(1 / (4 * f x * √(f x))) := by
    have htwo' : iteratedDeriv 2 (√·) = deriv (deriv (√·)) := by
      simpa only [iteratedDeriv_one] using
        (iteratedDeriv_succ (n := 1) (f := (√·)))
    rw [htwo']
    have hloc : deriv (√·) =ᶠ[nhds (f x)] fun z : ℝ => 1 / (2 * √z) := by
      filter_upwards [eventually_gt_nhds hfx] with z hz
      exact (Real.hasDerivAt_sqrt hz.ne').deriv
    rw [hloc.deriv_eq]
    rw [deriv_const_div 1 (by
      exact (Real.hasDerivAt_sqrt hfx.ne').differentiableAt.const_mul 2) (by positivity)]
    rw [deriv_const_mul_field, (Real.hasDerivAt_sqrt hfx.ne').deriv]
    have hsq : (√(f x)) ^ 2 = f x := Real.sq_sqrt hfx.le
    field_simp [Real.sqrt_ne_zero'.mpr hfx]
    nlinarith
  rw [htwo, (Real.hasDerivAt_sqrt hfx.ne').deriv]
  calc
    |-(1 / (4 * f x * √(f x))) * deriv f x ^ 2 +
        (1 / (2 * √(f x))) * iteratedDeriv 2 f x| ≤
        |-(1 / (4 * f x * √(f x))) * deriv f x ^ 2| +
          |(1 / (2 * √(f x))) * iteratedDeriv 2 f x| := abs_add_le _ _
    _ ≤ (1 / 4 : ℝ) + 1 / 2 := by
      gcongr
      · rw [abs_mul, abs_neg, abs_div, abs_one]
        have hden : 0 < 4 * f x * √(f x) := by positivity
        rw [abs_of_pos hden]
        have hdenle : 4 ≤ 4 * f x * √(f x) := by nlinarith [h0 x, hsqrt]
        have hinv : (4 * f x * √(f x))⁻¹ ≤ (4 : ℝ)⁻¹ :=
          (inv_le_inv₀ hden (by norm_num)).mpr hdenle
        calc
          (1 / (4 * f x * √(f x))) * |deriv f x ^ 2| ≤
              (1 / (4 * f x * √(f x))) * 1 := by
                gcongr
                rw [abs_pow]
                simpa using (sq_le_sq₀ (abs_nonneg _) (by norm_num)).mpr (h1 x)
          _ = (4 * f x * √(f x))⁻¹ := by ring
          _ ≤ (4 : ℝ)⁻¹ := hinv
          _ = 1 / 4 := by norm_num
      · rw [abs_mul, abs_div, abs_one]
        have hden : 0 < 2 * √(f x) := by positivity
        rw [abs_of_pos hden]
        have hdenle : 2 ≤ 2 * √(f x) := by nlinarith [hsqrt]
        have hinv : (2 * √(f x))⁻¹ ≤ (2 : ℝ)⁻¹ :=
          (inv_le_inv₀ hden (by norm_num)).mpr hdenle
        calc
          (1 / (2 * √(f x))) * |iteratedDeriv 2 f x| ≤
              (1 / (2 * √(f x))) * 1 := by gcongr; exact h2 x
          _ = (2 * √(f x))⁻¹ := by ring
          _ ≤ (2 : ℝ)⁻¹ := hinv
          _ = 1 / 2 := by norm_num
    _ ≤ 1 := by norm_num

private theorem aux_phiJ_inner_sqrt_deriv_bound
    (p : ℝ → ℝ) (hp : ContDiff ℝ (⊤ : ℕ∞) p)
    (hp_nonneg : ∀ x, 0 ≤ p x) (hp_le_one : ∀ x, p x ≤ 1)
    (hp_deriv : ∀ m : ℕ, m < 3 → ∀ x, |iteratedDeriv m p x| ≤ 1)
    (m : ℕ) (hm : m < 3) (x : ℝ) :
    |iteratedDeriv m (fun y => √(2 - p y)) x| ≤ 2 := by
  have hf : ContDiff ℝ 2 (fun y : ℝ => 2 - p y) :=
    (contDiff_const.sub hp).of_le (WithTop.coe_le_coe.mpr le_top)
  have hf0 : ∀ y, 1 ≤ 2 - p y := by
    intro y
    linarith [hp_le_one y]
  have hf1 : ∀ y, |deriv (fun z : ℝ => 2 - p z) y| ≤ 1 := by
    intro y
    rw [deriv_const_sub]
    simpa [iteratedDeriv_one, abs_neg] using hp_deriv 1 (by omega) y
  have hf2 : ∀ y, |iteratedDeriv 2 (fun z : ℝ => 2 - p z) y| ≤ 1 := by
    intro y
    rw [iteratedDeriv_const_sub (by norm_num) (2 : ℝ), iteratedDeriv_neg, abs_neg]
    exact hp_deriv 2 (by omega) y
  interval_cases m
  · rw [iteratedDeriv_zero]
    rw [abs_of_nonneg (Real.sqrt_nonneg _)]
    calc
      √(2 - p x) ≤ √2 := Real.sqrt_le_sqrt (by linarith [hp_nonneg x])
      _ ≤ 2 := by
        rw [Real.sqrt_le_iff]
        norm_num
  · have hfx : 0 < 2 - p x := by linarith [hp_le_one x]
    have hsqrt : 1 ≤ √(2 - p x) := by
      rw [← Real.sqrt_one]
      exact Real.sqrt_le_sqrt (hf0 x)
    have hp' : HasDerivAt p (deriv p x) x :=
      (hp.contDiffAt.differentiableAt (by simp)).hasDerivAt
    have hcomp := (Real.hasDerivAt_sqrt hfx.ne').comp x (hp'.const_sub (2 : ℝ))
    rw [iteratedDeriv_one]
    change |deriv ((fun y : ℝ => √y) ∘ fun y : ℝ => 2 - p y) x| ≤ 2
    rw [hcomp.deriv]
    calc
      |(1 / (2 * √(2 - p x))) * -deriv p x| =
          (1 / (2 * √(2 - p x))) * |deriv p x| := by
            rw [abs_mul, abs_neg, abs_of_pos (by positivity)]
      _ ≤ (1 / (2 * √(2 - p x))) * 1 := by
        gcongr
        simpa [iteratedDeriv_one] using hp_deriv 1 (by omega) x
      _ ≤ 1 / 2 := by
        have hden : 0 < 2 * √(2 - p x) := by positivity
        have hdenle : 2 ≤ 2 * √(2 - p x) := by nlinarith [hsqrt]
        have hinv : (2 * √(2 - p x))⁻¹ ≤ (2 : ℝ)⁻¹ :=
          (inv_le_inv₀ hden (by norm_num)).mpr hdenle
        convert hinv using 1 <;> ring
      _ ≤ 2 := by norm_num
  · exact (aux_phiJ_sqrt_comp_second_deriv_bound hf hf0 hf1 hf2 x).trans (by norm_num)

private theorem aux_phiJ_q_iteratedDeriv_eq_inner
    (A B : Set ℝ) (theta p : ℝ → ℝ)
    (hAB : A ⊆ interior B) (htheta_one : ∀ x ∈ B, theta x = 1)
    {x : ℝ} (hx : x ∈ A) (m : ℕ) :
    iteratedDeriv m (aux_phiJ_q theta p) x = iteratedDeriv m (fun y => √(2 - p y)) x := by
  exact (Set.EqOn.iteratedDeriv_of_isOpen
    ((aux_phiJ_q_eq_inner theta p B htheta_one).mono interior_subset)
    isOpen_interior m) (hAB hx)

private theorem aux_phiJ_q_iteratedDeriv_eq_outer
    (A : Set ℝ) (theta p : ℝ → ℝ) (hAclosed : IsClosed A)
    (htheta_nonneg : ∀ x, 0 ≤ theta x)
    (hp_off : ∀ x ∉ A, p x = 0)
    {x : ℝ} (hx : x ∉ A) (m : ℕ) :
    iteratedDeriv m (aux_phiJ_q theta p) x = iteratedDeriv m (fun y => √2 * theta y) x := by
  exact (Set.EqOn.iteratedDeriv_of_isOpen
    (aux_phiJ_q_eq_outer theta p A htheta_nonneg hp_off)
    hAclosed.isOpen_compl m) hx

private theorem aux_phiJ_q_deriv_bound
    (A B : Set ℝ) (theta p : ℝ → ℝ) (C : ℝ)
    (hAclosed : IsClosed A) (hAB : A ⊆ interior B)
    (htheta_one : ∀ x ∈ B, theta x = 1)
    (htheta_nonneg : ∀ x, 0 ≤ theta x)
    (hp_off : ∀ x ∉ A, p x = 0)
    (hp : ContDiff ℝ (⊤ : ℕ∞) p)
    (hp_nonneg : ∀ x, 0 ≤ p x) (hp_le_one : ∀ x, p x ≤ 1)
    (htheta_deriv : ∀ m : ℕ, m < 3 → ∀ x,
      |iteratedDeriv m theta x| ≤ (2 : ℝ) ^ (5 * m + 1) * C)
    (hp_deriv : ∀ m : ℕ, m < 3 → ∀ x, |iteratedDeriv m p x| ≤ 1)
    (hC : 1 ≤ C) (m : ℕ) (hm : m < 3) (x : ℝ) :
    |iteratedDeriv m (aux_phiJ_q theta p) x| ≤ (2 : ℝ) ^ 12 * C := by
  have hsqrt : √2 ≤ 2 := by
    rw [Real.sqrt_le_iff]
    norm_num
  have hcoeff : 2 * ((2 : ℝ) ^ (5 * m + 1) * C) ≤ (2 : ℝ) ^ 12 * C := by
    interval_cases m <;> norm_num <;> nlinarith [hC]
  by_cases hx : x ∈ A
  · rw [aux_phiJ_q_iteratedDeriv_eq_inner A B theta p hAB htheta_one hx m]
    calc
      |iteratedDeriv m (fun y => √(2 - p y)) x| ≤ 2 :=
        aux_phiJ_inner_sqrt_deriv_bound p hp hp_nonneg hp_le_one hp_deriv m hm x
      _ ≤ (2 : ℝ) ^ 12 * C := by nlinarith [hC]
  · rw [aux_phiJ_q_iteratedDeriv_eq_outer A theta p hAclosed htheta_nonneg hp_off hx m,
      iteratedDeriv_const_mul_field]
    calc
      |√2 * iteratedDeriv m theta x| = √2 * |iteratedDeriv m theta x| := by
        rw [abs_mul, abs_of_nonneg (Real.sqrt_nonneg _)]
      _ ≤ 2 * ((2 : ℝ) ^ (5 * m + 1) * C) := by
        exact mul_le_mul hsqrt (htheta_deriv m hm x) (abs_nonneg _) (by norm_num)
      _ ≤ (2 : ℝ) ^ 12 * C := hcoeff

private def aux_phiJ_qComplex (q : ℝ → ℝ) : ℝ → ℂ := fun x => (q x : ℂ)

private theorem aux_phiJ_qComplex_hasCompactSupport (q : ℝ → ℝ)
    (hq : HasCompactSupport q) :
    HasCompactSupport (aux_phiJ_qComplex q) := by
  exact hq.comp_left rfl

private theorem aux_phiJ_qComplex_support_subset (q : ℝ → ℝ) (K : Set ℝ)
    (hq : Function.support q ⊆ K) :
    Function.support (aux_phiJ_qComplex q) ⊆ K := by
  intro x hx
  apply hq
  apply Function.mem_support.mpr
  intro hz
  exact (Function.mem_support.mp hx) (by simp [aux_phiJ_qComplex, hz])

private theorem aux_phiJ_qComplex_contDiff (q : ℝ → ℝ)
    (hq : ContDiff ℝ (⊤ : ℕ∞) q) :
    ContDiff ℝ (⊤ : ℕ∞) (aux_phiJ_qComplex q) := by
  exact Complex.ofRealCLM.contDiff.comp hq

private theorem aux_phiJ_q_complex_sq (theta p q : ℝ → ℝ)
    (hq : ∀ x, q x = √(2 * theta x ^ 2 - p x))
    (hrad : ∀ x, 0 ≤ 2 * theta x ^ 2 - p x) (x : ℝ) :
    (q x : ℂ) ^ 2 = 2 * (theta x : ℂ) ^ 2 - (p x : ℂ) := by
  rw [hq]
  norm_cast
  exact Real.sq_sqrt (hrad x)

private theorem aux_phiJ_qComplex_iteratedDeriv_bound
    (q : ℝ → ℝ) (hq : ContDiff ℝ (⊤ : ℕ∞) q)
    (C : ℝ) (hbound : ∀ m : ℕ, m < 3 → ∀ x, |iteratedDeriv m q x| ≤ C)
    (m : ℕ) (hm : m < 3) (x : ℝ) :
    ‖iteratedDeriv m (aux_phiJ_qComplex q) x‖ ≤ C := by
  have hqm : ContDiff ℝ (m + 1) q :=
    hq.of_le (show (m + 1 : WithTop ℕ∞) ≤ (↑(⊤ : ℕ∞) : WithTop ℕ∞) by
      exact WithTop.coe_le_coe.mpr le_top)
  rw [show aux_phiJ_qComplex q = fun y : ℝ => (q y : ℂ) by rfl,
    Codex.Preliminaries.BumpsAndEstimates.aux_gaussianBumpEstimate_iteratedDeriv_ofReal m q hqm x,
    Complex.norm_real, Real.norm_eq_abs]
  exact hbound m hm x

private theorem aux_phiJ_profile_to_schwartz
    (theta p q : ℝ → ℝ) (thetaC pC : ℝ → ℂ) (K : Set ℝ) (C : ℝ)
    (hqdef : ∀ x, q x = √(2 * theta x ^ 2 - p x))
    (hrad : ∀ x, 0 ≤ 2 * theta x ^ 2 - p x)
    (hqcompact : HasCompactSupport q)
    (hqsmooth : ContDiff ℝ (⊤ : ℕ∞) q)
    (hqeven : ∀ x, q (-x) = q x)
    (hqsupport : Function.support q ⊆ K)
    (hqderiv : ∀ m : ℕ, m < 3 → ∀ x, |iteratedDeriv m q x| ≤ C)
    (hthetaC : ∀ x, thetaC x = (theta x : ℂ))
    (hpC : ∀ x, pC x = (p x : ℂ)) :
    ∃ psi : SchwartzMap ℝ ℝ,
      (∀ x : ℝ,
        FourierTransform.fourier (fun y : ℝ => (psi y : ℂ)) x ^ 2 =
          2 * thetaC x ^ 2 - pC x) ∧
      (∀ x : ℝ, psi (-x) = psi x) ∧
      Function.support (FourierTransform.fourier (fun y : ℝ => (psi y : ℂ))) ⊆ K ∧
      (∀ m : ℕ, m < 3 → ∀ x : ℝ,
        ‖iteratedDeriv m
          (FourierTransform.fourier (fun y : ℝ => (psi y : ℂ))) x‖ ≤ C) := by
  obtain ⟨psi, hfourier, hpsieven⟩ :=
    exists_real_even_schwartz_fourier_eq (aux_phiJ_qComplex q)
      (aux_phiJ_qComplex_hasCompactSupport q hqcompact)
      (aux_phiJ_qComplex_contDiff q hqsmooth)
      (fun x => ⟨q x, rfl⟩)
      (fun x => by
        change (q (-x) : ℂ) = (q x : ℂ)
        rw [hqeven x])
  refine ⟨psi, ?_, hpsieven, ?_, ?_⟩
  · intro x
    rw [hfourier x]
    change (q x : ℂ) ^ 2 = _
    rw [aux_phiJ_q_complex_sq theta p q hqdef hrad x, hthetaC x, hpC x]
  · intro x hx
    apply aux_phiJ_qComplex_support_subset q K hqsupport
    apply Function.mem_support.mpr
    intro hzero
    exact (Function.mem_support.mp hx) (by rw [hfourier x, hzero])
  · intro m hm x
    have hF : FourierTransform.fourier (fun y : ℝ => (psi y : ℂ)) = aux_phiJ_qComplex q := by
      funext y
      exact hfourier y
    rw [hF]
    exact aux_phiJ_qComplex_iteratedDeriv_bound q hqsmooth C hqderiv m hm x

/- Diagonal Fourier profile infrastructure for the final `phiJProperties` assembly. -/
private noncomputable def aux_phiJ_diagMap : ℝ →L[ℝ] EuclideanSpace ℝ (Fin 2) :=
  ((EuclideanSpace.equiv (Fin 2) ℝ).symm.toLinearMap.comp
    (ContinuousLinearMap.pi (fun i : Fin 2 =>
      if i = 0 then
        (1 : ℝ →L[ℝ] ℝ)
      else
        (-1 : ℝ →L[ℝ] ℝ))).toLinearMap).toContinuousLinearMap

private theorem aux_phiJ_diagMap_apply (xi : ℝ) :
    aux_phiJ_diagMap xi = WithLp.toLp 2 ![xi, -xi] := by
  ext i
  fin_cases i <;> simp [aux_phiJ_diagMap, EuclideanSpace.equiv]

private def aux_phiJ_P (Psi : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℝ) : ℝ → ℂ :=
  fun xi => FourierTransform.fourier
    (fun x : EuclideanSpace ℝ (Fin 2) => (Psi x : ℂ)) (WithLp.toLp 2 ![xi, -xi])

private def aux_phiJ_p (Psi : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℝ) : ℝ → ℝ :=
  fun xi => (aux_phiJ_P Psi xi).re

private theorem aux_phiJ_P_smooth (Psi : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℝ) :
    ContDiff ℝ (⊤ : ℕ∞) (aux_phiJ_P Psi) := by
  let PsiC : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℂ :=
    Psi.postcompCLM (𝕜 := ℝ) Complex.ofRealCLM
  have hs : ContDiff ℝ (⊤ : ℕ∞)
      (FourierTransform.fourier PsiC : EuclideanSpace ℝ (Fin 2) → ℂ) :=
    (FourierTransform.fourier PsiC).smooth (⊤ : ℕ∞)
  have hPsiC : (PsiC : EuclideanSpace ℝ (Fin 2) → ℂ) =
      fun x : EuclideanSpace ℝ (Fin 2) => (Psi x : ℂ) := by
    funext x
    simp [PsiC, SchwartzMap.postcompCLM_apply]
  rw [SchwartzMap.fourier_coe, hPsiC] at hs
  unfold aux_phiJ_P
  have hcomp : ContDiff ℝ (⊤ : ℕ∞)
      (fun xi : ℝ => FourierTransform.fourier
        (fun x : EuclideanSpace ℝ (Fin 2) => (Psi x : ℂ)) (aux_phiJ_diagMap xi)) :=
    hs.comp aux_phiJ_diagMap.contDiff
  simpa only [aux_phiJ_diagMap_apply] using hcomp

private theorem aux_phiJ_p_smooth (Psi : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℝ) :
    ContDiff ℝ (⊤ : ℕ∞) (aux_phiJ_p Psi) := by
  exact Complex.reCLM.contDiff.comp (aux_phiJ_P_smooth Psi)

private theorem aux_phiJ_P_eq_ofReal (Psi : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℝ)
    (hsym : ∀ u : EuclideanSpace ℝ (Fin 2),
      Psi u = Psi (Codex.Reduction.BumpFunctions.aux_swapTwo u)) :
    aux_phiJ_P Psi = fun xi => (aux_phiJ_p Psi xi : ℂ) := by
  funext xi
  obtain ⟨hreal, _⟩ :=
    Codex.Reduction.BumpFunctions.fourierDiagonalRealEven
      (Psi : EuclideanSpace ℝ (Fin 2) → ℝ) hsym
  rcases hreal xi with ⟨r, hr⟩
  change FourierTransform.fourier (fun u => (Psi u : ℂ))
      (WithLp.toLp 2 ![xi, -xi]) =
    ((FourierTransform.fourier (fun u => (Psi u : ℂ))
      (WithLp.toLp 2 ![xi, -xi])).re : ℂ)
  rw [hr]
  norm_num

private theorem aux_phiJ_p_nonneg (Psi : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℝ)
    (hsym : ∀ u : EuclideanSpace ℝ (Fin 2),
      Psi u = Psi (Codex.Reduction.BumpFunctions.aux_swapTwo u))
    (hpos : ∀ g : ℝ → ℝ, Codex.Reduction.BumpFunctions.aux_bounded g →
      0 ≤ ∫ u : EuclideanSpace ℝ (Fin 2), g (u 0) * g (u 1) * Psi u)
    (xi : ℝ) : 0 ≤ aux_phiJ_p Psi xi := by
  exact Codex.Reduction.BumpFunctions.phiPosV2
    (Psi : EuclideanSpace ℝ (Fin 2) → ℝ) hsym hpos xi

private theorem aux_phiJ_p_le_one (Psi : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℝ)
    (hderiv : ∀ m : ℕ, m < 3 → ∀ xi : ℝ,
      ‖iteratedDeriv m (aux_phiJ_P Psi) xi‖ ≤ 1)
    (xi : ℝ) : aux_phiJ_p Psi xi ≤ 1 := by
  have h := hderiv 0 (by omega) xi
  rw [iteratedDeriv_zero] at h
  exact (le_trans (le_abs_self _) (Complex.abs_re_le_norm _)).trans h

private theorem aux_phiJ_P_support (Psi : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℝ)
    (hsupp : Function.support
      (FourierTransform.fourier (fun x : EuclideanSpace ℝ (Fin 2) => (Psi x : ℂ))) ⊆
        Codex.Reduction.BumpFunctions.aux_productSet
          (Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 3))) :
    Function.support (aux_phiJ_P Psi) ⊆
      Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 3) := by
  intro xi hxi
  have hfull : WithLp.toLp 2 ![xi, -xi] ∈ Function.support
      (FourierTransform.fourier (fun x : EuclideanSpace ℝ (Fin 2) => (Psi x : ℂ))) := by
    exact hxi
  exact (hsupp hfull).1

private theorem aux_phiJ_p_zero_of_not_ann3
    (Psi : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℝ)
    (hsupp : Function.support
      (FourierTransform.fourier (fun x : EuclideanSpace ℝ (Fin 2) => (Psi x : ℂ))) ⊆
        Codex.Reduction.BumpFunctions.aux_productSet
          (Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 3)))
    (xi : ℝ) (hx : xi ∉ Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 3)) :
    aux_phiJ_p Psi xi = 0 := by
  have hzero : aux_phiJ_P Psi xi = 0 := by
    apply Function.notMem_support.mp
    intro h
    exact hx (aux_phiJ_P_support Psi hsupp h)
  exact congrArg Complex.re hzero

private theorem aux_phiJ_P_even (Psi : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℝ)
    (hsym : ∀ u : EuclideanSpace ℝ (Fin 2),
      Psi u = Psi (Codex.Reduction.BumpFunctions.aux_swapTwo u)) (xi : ℝ) :
    aux_phiJ_P Psi (-xi) = aux_phiJ_P Psi xi := by
  obtain ⟨_, heven⟩ :=
    Codex.Reduction.BumpFunctions.fourierDiagonalRealEven
      (Psi : EuclideanSpace ℝ (Fin 2) → ℝ) hsym
  simpa only [aux_phiJ_P, neg_neg] using heven xi

private theorem aux_phiJ_p_even (Psi : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℝ)
    (hsym : ∀ u : EuclideanSpace ℝ (Fin 2),
      Psi u = Psi (Codex.Reduction.BumpFunctions.aux_swapTwo u)) (xi : ℝ) :
    aux_phiJ_p Psi (-xi) = aux_phiJ_p Psi xi := by
  exact congrArg Complex.re (aux_phiJ_P_even Psi hsym xi)

private theorem aux_phiJ_p_deriv_bound (Psi : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℝ)
    (hsym : ∀ u : EuclideanSpace ℝ (Fin 2),
      Psi u = Psi (Codex.Reduction.BumpFunctions.aux_swapTwo u))
    (hderiv : ∀ m : ℕ, m < 3 → ∀ xi : ℝ,
      ‖iteratedDeriv m (aux_phiJ_P Psi) xi‖ ≤ 1)
    (m : ℕ) (hm : m < 3) (xi : ℝ) :
    |iteratedDeriv m (aux_phiJ_p Psi) xi| ≤ 1 := by
  have hsmooth : ContDiff ℝ (m + 1) (aux_phiJ_p Psi) :=
    (aux_phiJ_p_smooth Psi).of_le
      (show (m + 1 : WithTop ℕ∞) ≤ (↑(⊤ : ℕ∞) : WithTop ℕ∞) by
        exact WithTop.coe_le_coe.mpr le_top)
  have hreal := Codex.Preliminaries.BumpsAndEstimates.aux_gaussianBumpEstimate_iteratedDeriv_ofReal
    m (aux_phiJ_p Psi) hsmooth xi
  calc
    |iteratedDeriv m (aux_phiJ_p Psi) xi| =
        ‖((iteratedDeriv m (aux_phiJ_p Psi) xi : ℝ) : ℂ)‖ := by
          rw [Complex.norm_real, Real.norm_eq_abs]
    _ = ‖iteratedDeriv m (fun y : ℝ => (aux_phiJ_p Psi y : ℂ)) xi‖ := by rw [hreal]
    _ = ‖iteratedDeriv m (aux_phiJ_P Psi) xi‖ := by
      rw [aux_phiJ_P_eq_ofReal Psi hsym]
    _ ≤ 1 := hderiv m hm xi

private theorem aux_phiJ_ann3_closed :
    IsClosed (Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 3)) := by
  change IsClosed {x : ℝ | 1 / ((2 : ℝ) ^ 3) ≤ |x| ∧ |x| ≤ ((2 : ℝ) ^ 3) * 1}
  exact (isClosed_le continuous_const continuous_abs).inter
    (isClosed_le continuous_abs continuous_const)

private theorem aux_phiJ_ann3_subset_interior_ann4 :
    Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 3) ⊆
      interior (Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 4)) := by
  let O : Set ℝ := {x | (1 / 16 : ℝ) < |x| ∧ |x| < 16}
  have hOopen : IsOpen O :=
    (isOpen_lt continuous_const continuous_abs).inter (isOpen_lt continuous_abs continuous_const)
  have hsub : O ⊆ Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 4) := by
    intro x hx
    change 1 / ((2 : ℝ) ^ (4 : ℕ)) ≤ |x| ∧ |x| ≤ (2 : ℝ) ^ (4 : ℕ) * 1
    norm_num
    exact ⟨le_of_lt hx.1, le_of_lt hx.2⟩
  intro x hx
  apply interior_maximal hsub hOopen
  change (1 : ℝ) / ((2 : ℝ) ^ 3) ≤ |x| ∧ |x| ≤ ((2 : ℝ) ^ 3) * 1 at hx
  norm_num at hx
  exact ⟨lt_of_lt_of_le (by norm_num) hx.1, lt_of_le_of_lt hx.2 (by norm_num)⟩

private theorem aux_phiJ_ann6_compact :
    IsCompact (Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 6)) := by
  apply isCompact_Icc.of_isClosed_subset
  · change IsClosed {x : ℝ | 1 / ((2 : ℝ) ^ 6) ≤ |x| ∧ |x| ≤ ((2 : ℝ) ^ 6) * 1}
    exact (isClosed_le continuous_const continuous_abs).inter
      (isClosed_le continuous_abs continuous_const)
  · intro x hx
    change 1 / ((2 : ℝ) ^ 6) ≤ |x| ∧ |x| ≤ ((2 : ℝ) ^ 6) * 1 at hx
    constructor
    · exact neg_le_of_abs_le (by norm_num at hx ⊢; exact hx.2)
    · exact le_of_abs_le (by norm_num at hx ⊢; exact hx.2)

private theorem aux_phiJ_ann3_subset_ann6 :
    Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 3) ⊆
      Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 6) := by
  intro x hx
  change 1 / ((2 : ℝ) ^ 3) ≤ |x| ∧ |x| ≤ ((2 : ℝ) ^ 3) * 1 at hx
  change 1 / ((2 : ℝ) ^ 6) ≤ |x| ∧ |x| ≤ ((2 : ℝ) ^ 6) * 1
  norm_num at hx ⊢
  constructor
  · nlinarith [hx.1]
  · nlinarith [hx.2]

/--
\begin{lemma}
\label{lem:Phij_prop}
Let $\Psi:\mathbb{R}^2\to\mathbb{R}$ be a non-zero Schwartz function such that
for all $u=(u_0,u_1)\in\R^2$,
\begin{equation}\label{auto:Phij-symmetry-assumption}
\Psi(u_0,u_1)=\Psi(u_1,u_0).
\end{equation}
Assume also that for every bounded measurable $g:\R\to\R$,
\begin{equation}\label{auto:Phij-positivity-assumption}
\int_{\R^2}g(u_0)g(u_1)\Psi(u)\,du\ge0,
\end{equation}
and that
\begin{equation}\label{auto:Phij-Fourier-support-assumption}
\mathrm{supp}(\widehat{\Psi}) \subset \mathrm{Ann}_1(1, 2^3)^2
\end{equation}
and, for $a\in [3)$ and $\xi \in \R$,
\begin{equation}\label{Phij_psi_der}
\Big|\tfrac{d^a}{d\xi^{a}} \widehat{\Psi}(\xi,-\xi)\Big| \leq 1.
\end{equation}
Let $(\phi_0,\phi_1)$ be a universal pair. There exists a real even smooth function
$\psi:\R\to \R$ such that
\begin{enumerate}
\item For all $\xi\in\R$,
\begin{equation}\label{Phij_psi_diag}
\widehat{\psi}(\xi)^2 =
2 (\widehat{\phi_{0,-5}}-\widehat{\phi_{1,5}})(\xi)^2 - \widehat{\Psi}(\xi,-\xi).
\end{equation}
\item $\widehat{\psi}$ is supported in $\textup{Ann}_1(1,2^6)$.
\item For all $a\in [3)$ and $\xi\in \R$,
\begin{equation}\label{psi_decay}
|\widehat{\psi}^{(a)}(\xi)|\le C_{\text{lem:Phij\_prop}},
\end{equation}
where
\begin{equation}\label{auto:Phij-constant-definition}
C_{\text{lem:Phij\_prop}}=2^{12}C_{\text{def:unipair}}.
\end{equation}
\end{enumerate}
\end{lemma}

See also [`Codex.Reduction.Miscellany.phiJProperties`], [`Codex.Reduction.WindowsAndPairs.uniPair`].
-/
theorem phiJProperties (phi0 phi1 : SchwartzMap ℝ ℝ) (hpair : uniPair phi0 phi1)
    (Psi : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℝ) (hPsi : Psi ≠ 0)
    (hsym : ∀ u, Psi u = Psi (WithLp.toLp 2 ![u 1, u 0]))
    (hpos : ∀ g : ℝ → ℝ, Codex.Reduction.BumpFunctions.aux_bounded g →
      0 ≤ ∫ u : EuclideanSpace ℝ (Fin 2), g (u 0) * g (u 1) * Psi u)
    (hsupp : Function.support
      (FourierTransform.fourier (fun x : EuclideanSpace ℝ (Fin 2) ↦ (Psi x : ℂ))) ⊆
        Codex.Reduction.BumpFunctions.aux_productSet
          (Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 3)))
    (hderiv : ∀ m : ℕ, m < 3 → ∀ xi : ℝ,
      ‖iteratedDeriv m
        (fun z : ℝ ↦ FourierTransform.fourier
          (fun x : EuclideanSpace ℝ (Fin 2) ↦ (Psi x : ℂ))
          (WithLp.toLp 2 ![z, -z])) xi‖ ≤ 1) :
    ∃ psi : SchwartzMap ℝ ℝ,
      (∀ xi : ℝ,
        FourierTransform.fourier (fun x : ℝ ↦ (psi x : ℂ)) xi ^ 2 =
          2 * (FourierTransform.fourier (fun x : ℝ ↦ (phi0 x : ℂ)) (2 ^ (-5 : ℤ) * xi) -
            FourierTransform.fourier (fun x : ℝ ↦ (phi1 x : ℂ)) (2 ^ (5 : ℤ) * xi)) ^ 2 -
            FourierTransform.fourier (fun x : EuclideanSpace ℝ (Fin 2) ↦ (Psi x : ℂ))
              (WithLp.toLp 2 ![xi, -xi])) ∧
      (∀ x : ℝ, psi (-x) = psi x) ∧
      Function.support (FourierTransform.fourier (fun x : ℝ ↦ (psi x : ℂ))) ⊆
        Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 6) ∧
      (∀ m : ℕ, m < 3 → ∀ xi : ℝ,
        ‖iteratedDeriv m
          (FourierTransform.fourier (fun x : ℝ ↦ (psi x : ℂ))) xi‖ ≤
            C_phiJProperties) := by
  have _hPsi := hPsi
  have hsym' : ∀ u : EuclideanSpace ℝ (Fin 2),
      Psi u = Psi (Codex.Reduction.BumpFunctions.aux_swapTwo u) := by
    intro u
    simpa [Codex.Reduction.BumpFunctions.aux_swapTwo] using hsym u
  have hPderiv : ∀ m : ℕ, m < 3 → ∀ xi : ℝ,
      ‖iteratedDeriv m (aux_phiJ_P Psi) xi‖ ≤ 1 := by
    intro m hm xi
    change ‖iteratedDeriv m
      (fun z : ℝ => FourierTransform.fourier
        (fun x : EuclideanSpace ℝ (Fin 2) => (Psi x : ℂ))
        (WithLp.toLp 2 ![z, -z])) xi‖ ≤ 1
    exact hderiv m hm xi
  have htheta_nonneg : ∀ x : ℝ, 0 ≤ aux_phiJ_thetaReal phi0 phi1 x := by
    intro x
    rcases aux_phiJ_theta_real_nonneg phi0 phi1 hpair x with ⟨r, hr, hEq⟩
    change 0 ≤ (aux_phiJ_theta phi0 phi1 x).re
    rw [hEq]
    simpa using hr
  have htheta_one : ∀ x ∈ Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 4),
      aux_phiJ_thetaReal phi0 phi1 x = 1 := by
    intro x hx
    have h := aux_phiJ_theta_one_on_annulus phi0 phi1 hpair x hx
    change (aux_phiJ_theta phi0 phi1 x).re = 1
    rw [h]
    norm_num
  have htheta_even : ∀ x : ℝ,
      aux_phiJ_thetaReal phi0 phi1 (-x) = aux_phiJ_thetaReal phi0 phi1 x := by
    intro x
    exact congrArg Complex.re (aux_phiJ_theta_even phi0 phi1 hpair x)
  have hp_nonneg : ∀ x : ℝ, 0 ≤ aux_phiJ_p Psi x := by
    intro x
    exact aux_phiJ_p_nonneg Psi hsym' hpos x
  have hp_le_one : ∀ x : ℝ, aux_phiJ_p Psi x ≤ 1 := by
    intro x
    exact aux_phiJ_p_le_one Psi hPderiv x
  have hp_off : ∀ x : ℝ,
      x ∉ Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 3) →
        aux_phiJ_p Psi x = 0 := by
    intro x hx
    exact aux_phiJ_p_zero_of_not_ann3 Psi hsupp x hx
  have hp_even : ∀ x : ℝ, aux_phiJ_p Psi (-x) = aux_phiJ_p Psi x := by
    intro x
    exact aux_phiJ_p_even Psi hsym' x
  have hp_deriv : ∀ m : ℕ, m < 3 → ∀ x : ℝ,
      |iteratedDeriv m (aux_phiJ_p Psi) x| ≤ 1 := by
    intro m hm x
    exact aux_phiJ_p_deriv_bound Psi hsym' hPderiv m hm x
  have hrad : ∀ x : ℝ,
      0 ≤ 2 * (aux_phiJ_thetaReal phi0 phi1 x) ^ 2 - aux_phiJ_p Psi x := by
    intro x
    by_cases hx : x ∈ Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 3)
    · have hx4 : x ∈ Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 4) :=
        interior_subset (aux_phiJ_ann3_subset_interior_ann4 hx)
      rw [htheta_one x hx4]
      linarith [hp_le_one x]
    · have hp0 : aux_phiJ_p Psi x = 0 := hp_off x hx
      rw [hp0]
      simpa using
        (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2)
          (sq_nonneg (aux_phiJ_thetaReal phi0 phi1 x)))
  have htheta_zero : ∀ x : ℝ,
      x ∉ Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 6) →
        aux_phiJ_thetaReal phi0 phi1 x = 0 := by
    intro x hx
    have hzero : aux_phiJ_theta phi0 phi1 x = 0 := by
      apply Function.notMem_support.mp
      intro hs
      exact hx (aux_phiJ_theta_support phi0 phi1 hpair hs)
    change (aux_phiJ_theta phi0 phi1 x).re = 0
    rw [hzero]
    rfl
  have hqcompact : HasCompactSupport
      (aux_phiJ_q (aux_phiJ_thetaReal phi0 phi1) (aux_phiJ_p Psi)) :=
    aux_phiJ_q_hasCompactSupport
      (Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 3))
      (Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 6))
      (aux_phiJ_thetaReal phi0 phi1) (aux_phiJ_p Psi)
      aux_phiJ_ann6_compact aux_phiJ_ann3_subset_ann6 htheta_zero hp_off
  have hqsmooth : ContDiff ℝ (⊤ : ℕ∞)
      (aux_phiJ_q (aux_phiJ_thetaReal phi0 phi1) (aux_phiJ_p Psi)) :=
    aux_phiJ_q_contDiff
      (Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 3))
      (Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 4))
      (aux_phiJ_thetaReal phi0 phi1) (aux_phiJ_p Psi)
      (aux_phiJ_thetaReal_smooth phi0 phi1) (aux_phiJ_p_smooth Psi)
      aux_phiJ_ann3_closed aux_phiJ_ann3_subset_interior_ann4
      htheta_one htheta_nonneg hp_off hp_le_one
  have hqsupport : Function.support
      (aux_phiJ_q (aux_phiJ_thetaReal phi0 phi1) (aux_phiJ_p Psi)) ⊆
      Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 6) := by
    intro x hx
    by_contra hnot
    exact Function.mem_support.mp hx
      (aux_phiJ_q_zero_outside
        (Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 3))
        (Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 6))
        (aux_phiJ_thetaReal phi0 phi1) (aux_phiJ_p Psi)
        aux_phiJ_ann3_subset_ann6 htheta_zero hp_off x hnot)
  have hqeven : ∀ x : ℝ,
      aux_phiJ_q (aux_phiJ_thetaReal phi0 phi1) (aux_phiJ_p Psi) (-x) =
        aux_phiJ_q (aux_phiJ_thetaReal phi0 phi1) (aux_phiJ_p Psi) x :=
    aux_phiJ_q_even (aux_phiJ_thetaReal phi0 phi1) (aux_phiJ_p Psi) htheta_even hp_even
  have hqderiv : ∀ m : ℕ, m < 3 → ∀ x : ℝ,
      |iteratedDeriv m (aux_phiJ_q (aux_phiJ_thetaReal phi0 phi1) (aux_phiJ_p Psi)) x| ≤
        C_phiJProperties := by
    intro m hm x
    simpa [C_phiJProperties] using
      (aux_phiJ_q_deriv_bound
        (Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 3))
        (Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 4))
        (aux_phiJ_thetaReal phi0 phi1) (aux_phiJ_p Psi) C_uniPair
        aux_phiJ_ann3_closed aux_phiJ_ann3_subset_interior_ann4
        htheta_one htheta_nonneg hp_off (aux_phiJ_p_smooth Psi)
        hp_nonneg hp_le_one
        (fun k hk y => aux_phiJ_thetaReal_deriv_bound_sharp phi0 phi1 hpair k hk y)
        hp_deriv (by norm_num [C_uniPair]) m hm x)
  have hqdef : ∀ x : ℝ,
      aux_phiJ_q (aux_phiJ_thetaReal phi0 phi1) (aux_phiJ_p Psi) x =
        √(2 * (aux_phiJ_thetaReal phi0 phi1 x) ^ 2 - aux_phiJ_p Psi x) := by
    intro x
    rfl
  have hthetaC : ∀ x : ℝ,
      aux_phiJ_theta phi0 phi1 x = (aux_phiJ_thetaReal phi0 phi1 x : ℂ) := by
    intro x
    exact congrFun (aux_phiJ_theta_eq_ofReal phi0 phi1 hpair) x
  have hpC : ∀ x : ℝ, aux_phiJ_P Psi x = (aux_phiJ_p Psi x : ℂ) := by
    intro x
    exact congrFun (aux_phiJ_P_eq_ofReal Psi hsym') x
  simpa [aux_phiJ_theta, aux_phiJ_profile, aux_phiJ_P] using
    (aux_phiJ_profile_to_schwartz
      (aux_phiJ_thetaReal phi0 phi1) (aux_phiJ_p Psi)
      (aux_phiJ_q (aux_phiJ_thetaReal phi0 phi1) (aux_phiJ_p Psi))
      (aux_phiJ_theta phi0 phi1) (aux_phiJ_P Psi)
      (Codex.Reduction.BumpFunctions.aux_annulusOne 1 ((2 : ℝ) ^ 6)) C_phiJProperties
      hqdef hrad hqcompact hqsmooth hqeven hqsupport hqderiv hthetaC hpC)

/--
\begin{lemma}[constant $C_{\text{lem:Phij\_prop}}$ \auto]\label{constant Phij proposition}
\begin{equation}\label{constant Phij proposition bound}
C_{\text{lem:Phij\_prop}}=2^{27}.
\end{equation}
\end{lemma}

See also [`Codex.Reduction.Miscellany.phiJProperties`].
-/
theorem constantPhiJProposition : C_phiJProperties = (2 : ℝ) ^ 27 := by
  unfold C_phiJProperties C_uniPair
  rw [← pow_add]

private theorem aux_bootstrap_average_aestronglyMeasurable {n : ℕ}
    (phi : SchwartzMap ℝ ℝ)
    (f : Fin n → SchwartzMap (EuclideanSpace ℝ (Fin n)) ℝ) (t : ℝ) :
    AEStronglyMeasurable
      (twistedAverageAtScale t (fun s ↦ phi s) (fun i x ↦ f i x)) volume := by
  let E := EuclideanSpace ℝ (Fin n)
  let K : E × ℝ → ℝ := fun z ↦
    t⁻¹ * phi (t⁻¹ * z.2) * ∏ i,
      f i (z.1 + z.2 • WithLp.toLp 2 (Pi.single i (1 : ℝ)))
  have hKcont : Continuous K := by
    dsimp [K]
    fun_prop
  have hKmeas : AEStronglyMeasurable K ((volume : Measure E).prod volume) :=
    hKcont.aestronglyMeasurable
  have hI : AEStronglyMeasurable (fun x : E ↦ ∫ s : ℝ, K (x, s)) volume := by
    simpa only [Measure.volume_eq_prod] using hKmeas.integral_prod_right'
  apply hI.congr
  filter_upwards [] with x
  rfl

private theorem aux_bootstrap_ennreal_add_sq_le (u v : ℝ≥0∞) :
    (u + v) ^ 2 ≤ 2 * (u ^ 2 + v ^ 2) := by
  by_cases hu : u = ∞
  · simp [hu]
  by_cases hv : v = ∞
  · simp [hv]
  have hu2 : u ^ 2 ≠ ∞ := ENNReal.pow_ne_top hu
  have hv2 : v ^ 2 ≠ ∞ := ENNReal.pow_ne_top hv
  have hsum : u ^ 2 + v ^ 2 ≠ ∞ := ENNReal.add_ne_top.mpr ⟨hu2, hv2⟩
  have hrhs : 2 * (u ^ 2 + v ^ 2) ≠ ∞ := ENNReal.mul_ne_top (by simp) hsum
  rw [← ENNReal.toReal_le_toReal (by simp [hu, hv]) hrhs,
    ENNReal.toReal_pow, ENNReal.toReal_add hu hv,
    ENNReal.toReal_mul, ENNReal.toReal_ofNat,
    ENNReal.toReal_add hu2 hv2, ENNReal.toReal_pow,
    ENNReal.toReal_pow]
  nlinarith [sq_nonneg (u.toReal - v.toReal)]

private theorem aux_bootstrap_energy_core {J : ℕ} (a : ℤ → ℝ≥0∞)
    (d : ℤ → ℤ → ℝ≥0∞)
    (hd : ∀ u v, d u v ≤ a u + a v) :
    (⨆ ks : {u : Fin (J + 1) → ℤ // StrictMono u},
      ∑ j : Fin J, d (ks.1 j.succ) (ks.1 j.castSucc) ^ 2) ≤
      4 * ⨆ ks : {u : Fin J → ℤ // StrictMono u},
        ∑ j, a (ks.1 j) ^ 2 := by
  apply iSup_le
  rintro ⟨ks, hks⟩
  let lower : {u : Fin J → ℤ // StrictMono u} :=
    ⟨fun j ↦ ks j.castSucc, by
      intro i j hij
      apply hks
      simpa using hij⟩
  let upper : {u : Fin J → ℤ // StrictMono u} :=
    ⟨fun j ↦ ks j.succ, by
      intro i j hij
      apply hks
      simpa using hij⟩
  let R : ℝ≥0∞ := ⨆ qs : {u : Fin J → ℤ // StrictMono u}, ∑ j, a (qs.1 j) ^ 2
  have hLower : (∑ j : Fin J, a (ks j.castSucc) ^ 2) ≤ R := by
    simpa [lower, R] using
      (le_iSup (fun qs : {u : Fin J → ℤ // StrictMono u} ↦
        ∑ j, a (qs.1 j) ^ 2) lower)
  have hUpper : (∑ j : Fin J, a (ks j.succ) ^ 2) ≤ R := by
    simpa [upper, R] using
      (le_iSup (fun qs : {u : Fin J → ℤ // StrictMono u} ↦
        ∑ j, a (qs.1 j) ^ 2) upper)
  calc
    (∑ j : Fin J, d (ks j.succ) (ks j.castSucc) ^ 2) ≤
        ∑ j : Fin J, 2 * (a (ks j.succ) ^ 2 + a (ks j.castSucc) ^ 2) := by
      apply Finset.sum_le_sum
      intro j _
      calc
        d (ks j.succ) (ks j.castSucc) ^ 2 ≤
            (a (ks j.succ) + a (ks j.castSucc)) ^ 2 := by
              gcongr
              exact hd _ _
        _ ≤ 2 * (a (ks j.succ) ^ 2 + a (ks j.castSucc) ^ 2) :=
          aux_bootstrap_ennreal_add_sq_le _ _
    _ = 2 * (∑ j : Fin J, a (ks j.succ) ^ 2) +
          2 * (∑ j : Fin J, a (ks j.castSucc) ^ 2) := by
      simp only [mul_add, Finset.sum_add_distrib, ← Finset.mul_sum]
    _ ≤ 2 * R + 2 * R := by gcongr
    _ = 4 * R := by ring
    _ = 4 * ⨆ qs : {u : Fin J → ℤ // StrictMono u},
        ∑ j, a (qs.1 j) ^ 2 := by rfl

/--
\begin{lemma}[Bootstrapping]
\label{lem:bootstrap}
Let $\phi:\R\to \R$ be a Schwartz function.
Then
    \begin{equation}\label{auto:dyadic-variation-bootstrap}
    \|A_{t}(\phi)\|^2_{V_{2,J}(t\in 2^{\Z}; L^2)} \le
    4 \cdot \sup \sum_{\ell\in [J)} \|A_{2^{k_{\ell}}}(\phi)\|^2_2
    \end{equation}
    where the supremum is over all sequences of integers $k_0<\cdots <k_{J-1}$.
\end{lemma}
-/
theorem bootstrap {n : ℕ} (hn : 2 ≤ n) (phi : SchwartzMap ℝ ℝ)
    (f : Fin n → SchwartzMap (EuclideanSpace ℝ (Fin n)) ℝ) (J : ℕ) :
    twistedDyadicVariationEnergy (fun x ↦ phi x) (fun i x ↦ f i x) J ≤
      4 * ⨆ ks : {u : Fin J → ℤ // StrictMono u},
        ∑ j, eLpNorm
          (twistedAverageAtScale ((2 : ℝ) ^ (ks.1 j)) (fun x ↦ phi x)
            (fun i x ↦ f i x)) 2 volume ^ 2 := by
  have _hn : 2 ≤ n := hn
  unfold twistedDyadicVariationEnergy twistedDyadicJumpEnergy
  apply aux_bootstrap_energy_core
    (a := fun k ↦ eLpNorm
      (twistedAverageAtScale ((2 : ℝ) ^ k) (fun x ↦ phi x) (fun i x ↦ f i x)) 2 volume)
    (d := fun u v ↦ eLpNorm
      (fun x ↦ twistedAverageAtScale ((2 : ℝ) ^ u) (fun y ↦ phi y) (fun i y ↦ f i y) x -
        twistedAverageAtScale ((2 : ℝ) ^ v) (fun y ↦ phi y) (fun i y ↦ f i y) x) 2 volume)
  intro u v
  exact eLpNorm_sub_le
    (aux_bootstrap_average_aestronglyMeasurable phi f ((2 : ℝ) ^ u))
    (aux_bootstrap_average_aestronglyMeasurable phi f ((2 : ℝ) ^ v))
    (by norm_num)

end

