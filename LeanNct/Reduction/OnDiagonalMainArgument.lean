      _ = scaledBracketBumpReal (7 / 6 : ℝ) lam (w₀ + p) *
          scaledBracketBumpReal (7 / 6 : ℝ) t₀ p * D := by ring
  have hint : (∫ p : ℝ, f p) ≤ ∫ p : ℝ, g p :=
