private theorem aux_reduction_orientation_one_alpha_one (w₀ w₁ lam t₀ t₁ : ℝ)
    (hlam : 0 < lam) (ht₀ : 0 < t₀) (ht₁ : 0 < t₁) (ht₀lam : t₀ ≤ lam) :
