  calc
    s⁻¹ * Real.rpow (1 + |s⁻¹ * x|) (-(7 / 6 : ℝ)) ≤ s⁻¹ * 1 :=
      mul_le_mul_of_nonneg_left hpow (inv_nonneg.mpr hs.le)
