  let g : ℝ → ℝ := fun p =>
    scaledBracketBumpReal (7 / 6 : ℝ) lam (w₀ + p) *
      scaledBracketBumpReal (7 / 6 : ℝ) t₀ p * D
  have hD : 0 ≤ D := by
