    (a : aux_ZVector n → ℝ) (k : aux_ZVector n) (u : aux_RVector n)
    (s : ℝ) (hu : ∀ j, 0 ≤ u j ∧ u j < ε) :
    (∃ m : ℤ, ε - u i ≤ s - (m : ℝ) ∧
        s - (m : ℝ) < ε + δ - u i ∧
        aux_cuboidEmbed ε δ i a
          (aux_translateAxis (fun j ↦ (k j : ℝ) + u j) i s) =
          a (aux_translateAxisInt k i m)) ∨
      (¬ ∃ m : ℤ, ε - u i ≤ s - (m : ℝ) ∧
          s - (m : ℝ) < ε + δ - u i) ∧
        aux_cuboidEmbed ε δ i a
          (aux_translateAxis (fun j ↦ (k j : ℝ) + u j) i s) = 0 := by
  classical
  by_cases hex : ∃ m : ℤ, ε - u i ≤ s - (m : ℝ) ∧
      s - (m : ℝ) < ε + δ - u i
  · left
    obtain ⟨m, hm⟩ := hex
    refine ⟨m, hm.1, hm.2, ?_⟩
    exact aux_cuboidEmbed_translateAxis_eq hε hεδ i a k u m s hu hm
  · right
    refine ⟨hex, ?_⟩
    unfold aux_cuboidEmbed
    rw [if_neg]
    intro hbox
    apply hex
    let y : aux_RVector n :=
      aux_translateAxis (fun j ↦ (k j : ℝ) + u j) i s
    refine ⟨⌊y i⌋ - k i, ?_⟩
    have hcoordinate : ε ≤ y i - (⌊y i⌋ : ℝ) ∧
        y i - (⌊y i⌋ : ℝ) < ε + δ := by
      simpa [y] using hbox i
    dsimp [y] at hcoordinate ⊢
    simp only [aux_translateAxis, if_pos] at hcoordinate ⊢
    push_cast at hcoordinate ⊢
    simp only [Int.fract] at hcoordinate
    constructor <;> linarith [hcoordinate.1, hcoordinate.2]

/--
Different coordinate overlap intervals cannot meet at distinct integer
indices when their total width is less than one.
-/
theorem aux_overlap_index_eq {n : ℕ} {ε δ : ℝ}
    (hwidth : ε + δ < 1) (u : aux_RVector n)
    (hu : ∀ i, 0 ≤ u i ∧ u i < ε) (i j : Fin n) (s : ℝ)
    (m₁ m₂ : ℤ)
    (h₁ : ε - u i ≤ s - (m₁ : ℝ) ∧
      s - (m₁ : ℝ) < ε + δ - u i)
    (h₂ : ε - u j ≤ s - (m₂ : ℝ) ∧
      s - (m₂ : ℝ) < ε + δ - u j) :
    m₁ = m₂ := by
  have hupper : ((m₁ - m₂ : ℤ) : ℝ) < 1 := by
    push_cast
    linarith [h₁.1, h₂.2, (hu i).2, (hu j).1]
  have hlower : (-1 : ℝ) < ((m₁ - m₂ : ℤ) : ℝ) := by
    push_cast
    linarith [h₁.2, h₂.1, (hu i).1, (hu j).2]
  have hupperZ : m₁ - m₂ < 1 := by
    exact_mod_cast hupper
  have hlowerZ : (-1 : ℤ) < m₁ - m₂ := by
    exact_mod_cast hlower
  omega

/--
Outside the common overlap intervals, one cuboid factor vanishes and so
does their product.
-/
theorem aux_cuboidEmbed_product_eq_zero_of_no_common_overlap
    {n : ℕ} (hn : 0 < n) {ε δ : ℝ} (hε : ε < 1)
    (hwidth : ε + δ < 1) (a : Fin n → aux_ZVector n → ℝ)
    (k : aux_ZVector n) (u : aux_RVector n) (s : ℝ)
    (hu : ∀ j, 0 ≤ u j ∧ u j < ε)
    (hno : ¬ ∃ m : ℤ, ∀ i, ε - u i ≤ s - (m : ℝ) ∧
      s - (m : ℝ) < ε + δ - u i) :
    (∏ i, aux_cuboidEmbed ε δ i (a i)
      (aux_translateAxis (fun j ↦ (k j : ℝ) + u j) i s)) = 0 := by
  classical
  have hmissing : ∃ i : Fin n, ¬ ∃ m : ℤ,
      ε - u i ≤ s - (m : ℝ) ∧ s - (m : ℝ) < ε + δ - u i := by
    by_contra hmissing
    push Not at hmissing
    choose M hM using hmissing
    let i₀ : Fin n := ⟨0, hn⟩
    apply hno
    refine ⟨M i₀, ?_⟩
    intro i
    have hEq : M i = M i₀ :=
      aux_overlap_index_eq hwidth u hu i i₀ s (M i) (M i₀) (hM i) (hM i₀)
    simpa [hEq] using hM i
  obtain ⟨i, hi⟩ := hmissing
  have hzero : aux_cuboidEmbed ε δ i (a i)
      (aux_translateAxis (fun j ↦ (k j : ℝ) + u j) i s) = 0 := by
    rcases aux_cuboidEmbed_translateAxis_exists_or_eq_zero hε hwidth i
      (a i) k u s hu with hyes | hno
    · exact False.elim
        (hi ⟨hyes.choose, hyes.choose_spec.1, hyes.choose_spec.2.1⟩)
    · exact hno.2
  exact Finset.prod_eq_zero_iff.mpr ⟨i, Finset.mem_univ i, hzero⟩

/--
The raw-coordinate translation agrees with translation by
`ctCoordinateAxis` after passing to Euclidean space.
-/
theorem aux_toLp_translateAxis {n : ℕ} (x : aux_RVector n)
    (i : Fin n) (s : ℝ) :
    WithLp.toLp 2 (aux_translateAxis x i s) =
      WithLp.toLp 2 x + s • ctCoordinateAxis i := by
  ext j
  simp [aux_translateAxis, ctCoordinateAxis]

/-- Lift a raw-coordinate function to `ctRealVector n`. -/
noncomputable def aux_liftRaw {n : ℕ}
    (F : aux_RVector n → ℝ) : ctRealVector n → ℝ :=
  fun x ↦ F fun j ↦ x j

theorem aux_liftRaw_toLp {n : ℕ} (F : aux_RVector n → ℝ)
    (x : aux_RVector n) :
    aux_liftRaw F (WithLp.toLp 2 x) = F x :=
  rfl

/--
The cuboid lifts have the expected integrand after passing from raw
coordinates to `ctRealVector n`.
-/
theorem aux_cuboidEmbed_integrand_toLp {n : ℕ} {ε δ : ℝ}
    (a : Fin n → aux_ZVector n → ℝ) (k : aux_ZVector n)
    (u : aux_RVector n) (s : ℝ) :
    (∏ i, aux_liftRaw (aux_cuboidEmbed ε δ i (a i))
        (WithLp.toLp 2 (fun j ↦ (k j : ℝ) + u j) + s • ctCoordinateAxis i)) =
      ∏ i, aux_cuboidEmbed ε δ i (a i)
        (aux_translateAxis (fun j ↦ (k j : ℝ) + u j) i s) := by
  apply Finset.prod_congr rfl
  intro i _
  rw [← aux_toLp_translateAxis, aux_liftRaw_toLp]

/--
The common time interval on which all cuboid factors select the same
lattice time.
-/
def aux_commonOverlap {n : ℕ} (ε δ : ℝ) (u : aux_RVector n)
    (m : ℕ) (s : ℝ) : Prop :=
  ∀ i, ε - u i ≤ s - (m : ℝ) ∧ s - (m : ℝ) < ε + δ - u i

/-- The set on which all cuboid factors select the lattice time `m`. -/
def aux_commonOverlapSet {n : ℕ} (ε δ : ℝ) (u : aux_RVector n)
    (m : ℕ) : Set ℝ :=
  {s | aux_commonOverlap ε δ u m s}

theorem aux_fin_univ_nonempty {n : ℕ} (hn : 0 < n) :
    (Finset.univ : Finset (Fin n)).Nonempty := by
  refine ⟨⟨0, hn⟩, Finset.mem_univ _⟩

/-- The left endpoint of a common overlap interval. -/
noncomputable def aux_overlapLower {n : ℕ} (hn : 0 < n) (ε : ℝ)
    (u : aux_RVector n) (m : ℕ) : ℝ :=
  let i₀ : Fin n := ⟨0, hn⟩
  Finset.univ.sup' ⟨i₀, Finset.mem_univ i₀⟩
    (fun i ↦ (m : ℝ) + ε - u i)

/-- The right endpoint of a common overlap interval. -/
noncomputable def aux_overlapUpper {n : ℕ} (hn : 0 < n) (ε δ : ℝ)
    (u : aux_RVector n) (m : ℕ) : ℝ :=
  let i₀ : Fin n := ⟨0, hn⟩
  Finset.univ.inf' ⟨i₀, Finset.mem_univ i₀⟩
    (fun i ↦ (m : ℝ) + ε + δ - u i)

theorem aux_add_inf' {ι : Type*} (q : Finset ι) (hq : q.Nonempty)
    (f : ι → ℝ) (a : ℝ) :
    a + q.inf' hq f = q.inf' hq (fun i ↦ a + f i) :=
  map_finset_inf' (OrderIso.addLeft a) hq f

/-- The common-overlap condition is a half-open interval condition. -/
theorem aux_mem_commonOverlapSet_iff {n : ℕ} (hn : 0 < n)
    {ε δ s : ℝ} (u : aux_RVector n) (m : ℕ) :
    s ∈ aux_commonOverlapSet ε δ u m ↔
      s ∈ Ico (aux_overlapLower hn ε u m) (aux_overlapUpper hn ε δ u m) := by
  let hne : (Finset.univ : Finset (Fin n)).Nonempty := aux_fin_univ_nonempty hn
  simp only [aux_commonOverlapSet, Set.mem_ofPred_eq, mem_Ico]
  change (∀ i, ε - u i ≤ s - (m : ℝ) ∧
      s - (m : ℝ) < ε + δ - u i) ↔
    Finset.univ.sup' hne (fun i ↦ (m : ℝ) + ε - u i) ≤ s ∧
      s < Finset.univ.inf' hne (fun i ↦ (m : ℝ) + ε + δ - u i)
  constructor
  · intro hs
    constructor
    · apply Finset.sup'_le hne
      intro i hi
      linarith [(hs i).1]
    · exact (Finset.lt_inf'_iff _).2 fun i hi ↦ by
        linarith [(hs i).2]
  · rintro ⟨hl, hu⟩ i
    constructor
    · have hli := Finset.le_sup' (s := Finset.univ)
        (fun i ↦ (m : ℝ) + ε - u i) (Finset.mem_univ i)
      linarith
    · have hui := Finset.inf'_le (s := Finset.univ)
        (fun i ↦ (m : ℝ) + ε + δ - u i) (Finset.mem_univ i)
      linarith

/-- On the base cube, every common-overlap interval is nonempty. -/
theorem aux_overlapLower_le_overlapUpper {n : ℕ} (hn : 0 < n)
    {ε δ : ℝ} (u : aux_RVector n) (m : ℕ)
    (hu : ∀ i, 0 ≤ u i ∧ u i ≤ ε) (hεδ : ε ≤ δ) :
    aux_overlapLower hn ε u m ≤ aux_overlapUpper hn ε δ u m := by
  let hne : (Finset.univ : Finset (Fin n)).Nonempty := aux_fin_univ_nonempty hn
  change Finset.univ.sup' hne (fun i ↦ (m : ℝ) + ε - u i) ≤
    Finset.univ.inf' hne (fun i ↦ (m : ℝ) + ε + δ - u i)
  have hsup : Finset.univ.sup' hne (fun i ↦ (m : ℝ) + ε - u i) ≤
      (m : ℝ) + ε := by
    apply Finset.sup'_le hne
    intro i hi
    linarith [(hu i).1]
  have hinf : (m : ℝ) + δ ≤
      Finset.univ.inf' hne (fun i ↦ (m : ℝ) + ε + δ - u i) := by
    apply Finset.le_inf' hne
    intro i hi
    linarith [(hu i).2]
  linarith

/-- Translating the lattice time translates the overlap's left endpoint. -/
theorem aux_overlapLower_eq_add_overlapLower_zero {n : ℕ}
    (hn : 0 < n) (ε : ℝ) (u : aux_RVector n) (m : ℕ) :
    aux_overlapLower hn ε u m = (m : ℝ) + aux_overlapLower hn ε u 0 := by
  let hne : (Finset.univ : Finset (Fin n)).Nonempty := aux_fin_univ_nonempty hn
  unfold aux_overlapLower
  dsimp
  simpa [sub_eq_add_neg, add_assoc] using
    (Finset.add_sup' Finset.univ (fun i ↦ ε - u i) (m : ℝ) hne).symm

/-- Translating the lattice time translates the overlap's right endpoint. -/
theorem aux_overlapUpper_eq_add_overlapUpper_zero {n : ℕ}
    (hn : 0 < n) (ε δ : ℝ) (u : aux_RVector n) (m : ℕ) :
    aux_overlapUpper hn ε δ u m = (m : ℝ) + aux_overlapUpper hn ε δ u 0 := by
  let hne : (Finset.univ : Finset (Fin n)).Nonempty := aux_fin_univ_nonempty hn
  unfold aux_overlapUpper
  dsimp
  simpa [sub_eq_add_neg, add_assoc] using
    (aux_add_inf' Finset.univ hne (fun i ↦ ε + δ - u i) (m : ℝ)).symm

/--
The length of a common overlap interval is independent of its lattice
time.
-/
theorem aux_overlapWidth_invariant {n : ℕ} (hn : 0 < n)
    (ε δ : ℝ) (u : aux_RVector n) (m : ℕ) :
    aux_overlapUpper hn ε δ u m - aux_overlapLower hn ε u m =
      aux_overlapUpper hn ε δ u 0 - aux_overlapLower hn ε u 0 := by
  rw [aux_overlapUpper_eq_add_overlapUpper_zero,
    aux_overlapLower_eq_add_overlapLower_zero]
  ring

/-- The common overlap width normalized at lattice time zero. -/
noncomputable def aux_overlapWidth {n : ℕ} (hn : 0 < n) (ε δ : ℝ)
    (u : aux_RVector n) : ℝ :=
  aux_overlapUpper hn ε δ u 0 - aux_overlapLower hn ε u 0

theorem aux_overlapWidth_eq_translate_width {n : ℕ} (hn : 0 < n)
    (ε δ : ℝ) (u : aux_RVector n) (m : ℕ) :
    aux_overlapWidth hn ε δ u =
      aux_overlapUpper hn ε δ u m - aux_overlapLower hn ε u m := by
  symm
  exact aux_overlapWidth_invariant hn ε δ u m

/-- On the base cube, the common overlap width is at least `δ - ε`. -/
theorem aux_overlapWidth_lower_bound {n : ℕ} (hn : 0 < n)
    {ε δ : ℝ} (u : aux_RVector n) (hu : ∀ i, 0 ≤ u i ∧ u i ≤ ε) :
    δ - ε ≤ aux_overlapWidth hn ε δ u := by
  let hne : (Finset.univ : Finset (Fin n)).Nonempty := aux_fin_univ_nonempty hn
  unfold aux_overlapWidth aux_overlapLower aux_overlapUpper
  dsimp
  have hsup : Finset.univ.sup' hne (fun i ↦ (0 : ℝ) + ε - u i) ≤ ε := by
    apply Finset.sup'_le hne
    intro i hi
    linarith [(hu i).1]
  have hinf : δ ≤ Finset.univ.inf' hne
      (fun i ↦ (0 : ℝ) + ε + δ - u i) := by
    apply Finset.le_inf' hne
    intro i hi
    linarith [(hu i).2]
  norm_num only [Nat.cast_zero, zero_add] at hsup hinf ⊢
  linarith

/--
Every overlap indexed by `range N` lies inside the scale interval
`[0,N)`.
-/
theorem aux_commonOverlapSet_subset_scale {n : ℕ} (hn : 0 < n)
    {ε δ : ℝ} (hwidth : ε + δ < 1) (u : aux_RVector n)
    (hu : ∀ i, 0 ≤ u i ∧ u i < ε) (N : ℕ) (q : Fin N) :
    aux_commonOverlapSet ε δ u q.val ⊆ Ico (0 : ℝ) N := by
  intro s hs
  let i₀ : Fin n := ⟨0, hn⟩
  have hqnonneg : 0 ≤ (q.val : ℝ) := Nat.cast_nonneg q.val
  have hqsucc : q.val + 1 ≤ N := Nat.succ_le_iff.mpr q.isLt
  have hqsuccReal : (q.val : ℝ) + 1 ≤ (N : ℝ) := by
    exact_mod_cast hqsucc
  have hlower := hs i₀ |>.1
  have hupper := hs i₀ |>.2
  rw [mem_Ico]
  constructor
  · have hpositive : 0 < ε - u i₀ := sub_pos.mpr (hu i₀).2
    linarith
  · linarith [hwidth, (hu i₀).1]

/-- One finite-overlap contribution to the cuboid integrand. -/
noncomputable def aux_overlapContribution {n : ℕ} (ε δ : ℝ)
    (a : Fin n → aux_ZVector n → ℝ) (k : aux_ZVector n)
    (u : aux_RVector n) (q : ℕ) (s : ℝ) : ℝ := by
  classical
  exact if aux_commonOverlap ε δ u q s then
    ∏ i, a i (aux_translateAxisInt k i (q : ℤ))
  else 0

/--
An overlap contribution is the indicator of its common half-open
interval times its diagonal lattice coefficient.
-/
theorem aux_overlapContribution_eq_indicator {n : ℕ} (hn : 0 < n)
    (ε δ : ℝ) (a : Fin n → aux_ZVector n → ℝ) (k : aux_ZVector n)
    (u : aux_RVector n) (q : ℕ) (s : ℝ) :
    aux_overlapContribution ε δ a k u q s =
      (Ico (aux_overlapLower hn ε u q) (aux_overlapUpper hn ε δ u q)).indicator
        (fun _ ↦ ∏ i, a i (aux_translateAxisInt k i (q : ℤ))) s := by
  classical
  by_cases h : aux_commonOverlap ε δ u q s
  · rw [aux_overlapContribution]
    simp only [h, if_true]
    rw [Set.indicator_of_mem]
    exact (aux_mem_commonOverlapSet_iff hn u q).mp h
  · rw [aux_overlapContribution]
    simp only [h, if_false]
    rw [Set.indicator_of_notMem]
    intro hmem
    exact h ((aux_mem_commonOverlapSet_iff hn u q).mpr hmem)

/-- Integral of a constant on a half-open real interval. -/
theorem aux_integral_indicator_Ico_const {a b c : ℝ} (hab : a ≤ b) :
    ∫ s : ℝ, (Ico a b).indicator (fun _ ↦ c) s = (b - a) * c := by
  rw [MeasureTheory.integral_indicator measurableSet_Ico]
  rw [MeasureTheory.integral_const]
  simp [hab]

/--
The full scale integral of the finite overlap expansion factors as the
common overlap width times the discrete diagonal sum.
-/
theorem aux_integral_sum_overlapContribution {n : ℕ} (hn : 0 < n)
    {ε δ : ℝ} (hεδ : ε ≤ δ) (a : Fin n → aux_ZVector n → ℝ)
    (k : aux_ZVector n) (u : aux_RVector n) (N : ℕ)
    (hu : ∀ i, 0 ≤ u i ∧ u i < ε) :
    ∫ s : ℝ, ∑ q : Fin N, aux_overlapContribution ε δ a k u q.val s =
      aux_overlapWidth hn ε δ u * ∑ q : Fin N,
        ∏ i, a i (aux_translateAxisInt k i (q.val : ℤ)) := by
  rw [MeasureTheory.integral_finsetSum]
  · calc
      ∑ q ∈ (Finset.univ : Finset (Fin N)),
          ∫ s : ℝ, aux_overlapContribution ε δ a k u q.val s =
          ∑ q ∈ (Finset.univ : Finset (Fin N)),
            (aux_overlapUpper hn ε δ u q.val - aux_overlapLower hn ε u q.val) *
              ∏ i, a i (aux_translateAxisInt k i (q.val : ℤ)) := by
        apply Finset.sum_congr rfl
        intro q hq
        calc
          ∫ s : ℝ, aux_overlapContribution ε δ a k u q.val s =
              ∫ s : ℝ, (Ico (aux_overlapLower hn ε u q.val)
                (aux_overlapUpper hn ε δ u q.val)).indicator
                  (fun _ ↦ ∏ i, a i (aux_translateAxisInt k i (q.val : ℤ))) s := by
            apply MeasureTheory.integral_congr_ae
            filter_upwards [] with s
            exact aux_overlapContribution_eq_indicator hn ε δ a k u q.val s
          _ = _ := aux_integral_indicator_Ico_const
            (aux_overlapLower_le_overlapUpper hn u q.val
              (fun i ↦ ⟨(hu i).1, (hu i).2.le⟩) hεδ)
      _ = _ := by
        simp_rw [← aux_overlapWidth_eq_translate_width hn ε δ u]
        rw [Finset.mul_sum]
  · intro q hq
    change Integrable (fun s ↦ aux_overlapContribution ε δ a k u q.val s) volume
    rw [show (fun s ↦ aux_overlapContribution ε δ a k u q.val s) =
      (fun s ↦ (Ico (aux_overlapLower hn ε u q.val)
        (aux_overlapUpper hn ε δ u q.val)).indicator
          (fun _ ↦ ∏ i, a i (aux_translateAxisInt k i (q.val : ℤ))) s) by
      funext s
      exact aux_overlapContribution_eq_indicator hn ε δ a k u q.val s]
    rw [MeasureTheory.integrable_indicator_iff measurableSet_Ico]
    exact MeasureTheory.integrableOn_const measure_Ico_lt_top.ne

/--
Restricting the finite overlap expansion to its scale interval does not
change its integral.
-/
theorem aux_setIntegral_sum_overlapContribution {n : ℕ}
    (hn : 0 < n) {ε δ : ℝ} (hεδ : ε ≤ δ) (hwidth : ε + δ < 1)
    (a : Fin n → aux_ZVector n → ℝ) (k : aux_ZVector n)
    (u : aux_RVector n) (N : ℕ) (hu : ∀ i, 0 ≤ u i ∧ u i < ε) :
    ∫ s in Ico (0 : ℝ) N, ∑ q : Fin N,
        aux_overlapContribution ε δ a k u q.val s =
      aux_overlapWidth hn ε δ u * ∑ q : Fin N,
        ∏ i, a i (aux_translateAxisInt k i (q.val : ℤ)) := by
  let G : ℝ → ℝ := fun s ↦ ∑ q : Fin N,
    aux_overlapContribution ε δ a k u q.val s
  calc
    ∫ s in Ico (0 : ℝ) N, G s =
        ∫ s : ℝ, (Ico (0 : ℝ) N).indicator G s := by
      rw [MeasureTheory.integral_indicator measurableSet_Ico]
    _ = ∫ s : ℝ, G s := by
      apply MeasureTheory.integral_congr_ae
      filter_upwards [] with s
      by_cases hs : s ∈ Ico (0 : ℝ) N
      · simp [hs]
      · have hzero : G s = 0 := by
          dsimp [G]
          apply Finset.sum_eq_zero
          intro q hq
          rw [aux_overlapContribution_eq_indicator hn ε δ a k u q.val s]
          rw [Set.indicator_of_notMem]
          intro hqmem
          exact hs (aux_commonOverlapSet_subset_scale hn hwidth u hu N q
            ((aux_mem_commonOverlapSet_iff hn u q.val).mpr hqmem))
        simp [hs, hzero]
    _ = _ := aux_integral_sum_overlapContribution hn hεδ a k u N hu

/--
A common overlap contributing to the interval `[0,N)` has an index in
`range N`.  The open upper faces of the cuboids remove endpoint terms.
-/
theorem aux_commonOverlap_index_mem_range {n : ℕ} (hn : 0 < n)
    {ε δ : ℝ} (hwidth : ε + δ < 1) (u : aux_RVector n)
    (hu : ∀ i, 0 ≤ u i ∧ u i < ε) (N : ℕ) {s : ℝ}
    (hs : s ∈ Ico (0 : ℝ) N) (m : ℤ)
    (hm : ∀ i, ε - u i ≤ s - (m : ℝ) ∧
      s - (m : ℝ) < ε + δ - u i) :
    ∃ q : Fin N, (q.val : ℤ) = m := by
  let i₀ : Fin n := ⟨0, hn⟩
  have hmnonneg : 0 ≤ m := by
    by_contra hneg
    have hmle : m ≤ -1 := by omega
    have hupper := (hm i₀).2
    have hge : 1 ≤ s - (m : ℝ) := by
      have hmle' : (m : ℝ) ≤ -1 := by exact_mod_cast hmle
      linarith [hs.1]
    linarith [hupper, hwidth, (hu i₀).1]
  have hmlts : (m : ℝ) < s := by
    have hlower := (hm i₀).1
    have hpos : 0 < ε - u i₀ := by linarith [(hu i₀).2]
    linarith
  have hmltNreal : (m : ℝ) < (N : ℝ) := lt_trans hmlts hs.2
  have hmltN : m < (N : ℤ) := by
    exact_mod_cast hmltNreal
  have htoNat : m.toNat < N := by
    have hcast : (m.toNat : ℤ) < (N : ℤ) := by
      simpa only [Int.toNat_of_nonneg hmnonneg] using hmltN
    exact_mod_cast hcast
  refine ⟨⟨m.toNat, htoNat⟩, ?_⟩
  simp only [Int.toNat_of_nonneg hmnonneg]

/--
On `[0,N)`, the cuboid product is a finite sum of the diagonal discrete
products over its common overlap intervals.
-/
theorem aux_cuboidEmbed_product_eq_overlapSum {n : ℕ}
    (hn : 0 < n) {ε δ : ℝ} (hε : ε < 1)
    (hwidth : ε + δ < 1) (a : Fin n → aux_ZVector n → ℝ)
    (k : aux_ZVector n) (u : aux_RVector n)
    (hu : ∀ i, 0 ≤ u i ∧ u i < ε) (N : ℕ) {s : ℝ}
    (hs : s ∈ Ico (0 : ℝ) N) :
    (∏ i, aux_cuboidEmbed ε δ i (a i)
      (aux_translateAxis (fun j ↦ (k j : ℝ) + u j) i s)) =
      ∑ q : Fin N, aux_overlapContribution ε δ a k u q.val s := by
  classical
  by_cases hcommon : ∃ m : ℤ, ∀ i,
      ε - u i ≤ s - (m : ℝ) ∧ s - (m : ℝ) < ε + δ - u i
  · obtain ⟨m, hm⟩ := hcommon
    obtain ⟨q, hq⟩ :=
      aux_commonOverlap_index_mem_range hn hwidth u hu N hs m hm
    have hqreal : (q.val : ℝ) = (m : ℝ) := by
      exact_mod_cast hq
    have hqcommon : aux_commonOverlap ε δ u q.val s := by
      intro i
      simpa only [hqreal] using hm i
    have hleft : (∏ i, aux_cuboidEmbed ε δ i (a i)
        (aux_translateAxis (fun j ↦ (k j : ℝ) + u j) i s)) =
        ∏ i, a i (aux_translateAxisInt k i m) :=
      aux_cuboidEmbed_product_translateAxis_eq hε hwidth a k u m s hu hm
    rw [hleft]
    symm
    change (∑ q' : Fin N, aux_overlapContribution ε δ a k u q'.val s) =
      ∏ i, a i (aux_translateAxisInt k i m)
    let i₀ : Fin n := ⟨0, hn⟩
    refine (Fintype.sum_eq_single
      (f := fun q' : Fin N ↦ aux_overlapContribution ε δ a k u q'.val s)
      q ?_).trans ?_
    · intro q' hqne
      have hnot : ¬ aux_commonOverlap ε δ u q'.val s := by
        intro hq'
        have hq'int : ∀ i,
            ε - u i ≤ s - ((q'.val : ℤ) : ℝ) ∧
              s - ((q'.val : ℤ) : ℝ) < ε + δ - u i := by
          intro i
          simpa only [Int.cast_natCast] using hq' i
        have hqint : ∀ i,
            ε - u i ≤ s - ((q.val : ℤ) : ℝ) ∧
              s - ((q.val : ℤ) : ℝ) < ε + δ - u i := by
          intro i
          simpa only [Int.cast_natCast] using hqcommon i
        have heq : (q'.val : ℤ) = (q.val : ℤ) :=
          aux_overlap_index_eq hwidth u hu i₀ i₀ s
            (q'.val : ℤ) (q.val : ℤ) (hq'int i₀) (hqint i₀)
        have hval : q'.val = q.val := by
          exact_mod_cast heq
        exact hqne (Fin.ext hval)
      simp only [aux_overlapContribution, hnot, if_false]
    · simp only [aux_overlapContribution, hqcommon, if_true, hq]
  · have hzero : (∏ i, aux_cuboidEmbed ε δ i (a i)
        (aux_translateAxis (fun j ↦ (k j : ℝ) + u j) i s)) = 0 :=
      aux_cuboidEmbed_product_eq_zero_of_no_common_overlap hn hε hwidth
        a k u s hu hcommon
    rw [hzero]
    symm
    apply Fintype.sum_eq_zero
      (f := fun q : Fin N ↦ aux_overlapContribution ε δ a k u q.val s)
    intro q
    rw [aux_overlapContribution, if_neg]
    intro hq
    apply hcommon
    refine ⟨(q.val : ℤ), ?_⟩
    intro i
    simpa only [Int.cast_natCast] using hq i

/--
At a point of the base cuboid, the rescaled continuous average of the
cuboid lift is exactly the common-overlap width times the integer-lattice
discrete average.
-/
theorem aux_twistedAverageAtScale_cuboidLift_eq {n : ℕ}
    (hn : 0 < n) {ε δ : ℝ} (hε : ε < 1) (hεδ : ε ≤ δ)
    (hwidth : ε + δ < 1) (N : ℕ) (hN : 0 < N)
    (a : Fin n → aux_ZVector n → ℝ) (k : aux_ZVector n)
    (u : aux_RVector n) (hu : ∀ i, 0 ≤ u i ∧ u i < ε) :
    ctTwistedAverageAtScale (N : ℝ) ctUnitIntervalKernel
        (fun i ↦ aux_liftRaw (aux_cuboidEmbed ε δ i (a i)))
        (WithLp.toLp 2 (fun j ↦ (k j : ℝ) + u j)) =
      aux_overlapWidth hn ε δ u * aux_integerDiscreteAverage N a k := by
  let P : ℝ → ℝ := fun s ↦
    ∏ i, aux_liftRaw (aux_cuboidEmbed ε δ i (a i))
      (WithLp.toLp 2 (fun j ↦ (k j : ℝ) + u j) + s • ctCoordinateAxis i)
  let Q : ℝ → ℝ := fun s ↦ ∑ q : Fin N,
    aux_overlapContribution ε δ a k u q.val s
  unfold ctTwistedAverageAtScale
  unfold aux_ct_twistedAverageAtScale aux_ct_twistedAverage
  change ∫ s : ℝ, (N : ℝ)⁻¹ * ctUnitIntervalKernel ((N : ℝ)⁻¹ * s) * P s = _
  calc
    ∫ s : ℝ, (N : ℝ)⁻¹ * ctUnitIntervalKernel ((N : ℝ)⁻¹ * s) * P s =
        ∫ s : ℝ, ((N : ℝ)⁻¹ * (Ico (0 : ℝ) N).indicator
          (fun _ ↦ (1 : ℝ)) s) * P s := by
      apply MeasureTheory.integral_congr_ae
      filter_upwards [] with s
      rw [aux_scaled_unitIntervalKernel hN s]
    _ = (N : ℝ)⁻¹ * ∫ s in Ico (0 : ℝ) N, Q s :=
      aux_integral_scaled_Ico_eq_of_pointwise P Q (by
        intro s hs
        dsimp [P, Q]
        rw [aux_cuboidEmbed_integrand_toLp]
        exact aux_cuboidEmbed_product_eq_overlapSum hn hε hwidth a k u hu N hs)
    _ = (N : ℝ)⁻¹ *
        (aux_overlapWidth hn ε δ u * ∑ q : Fin N,
          ∏ i, a i (aux_translateAxisInt k i (q.val : ℤ))) := by
      rw [aux_setIntegral_sum_overlapContribution hn hεδ hwidth a k u N hu]
    _ = aux_overlapWidth hn ε δ u * aux_integerDiscreteAverage N a k := by
      unfold aux_integerDiscreteAverage
      rw [Fin.sum_univ_eq_sum_range
        (fun m ↦ ∏ i, a i (aux_translateAxisInt k i (m : ℤ))) N]
      ring

/--
The discrete data obtained by sampling an ergodic system along the joint
forward orbit based at `x`.
-/
def aux_orbitFunction {X : Type*} [MeasurableSpace X]
    {μ : Measure X} {n : ℕ} (S : ErgodicSystem X μ n)
    (f : Fin n → X → ℝ) (x : X) :
    Fin n → (Fin n → ℕ) → ℝ :=
  fun i k ↦ f i (aux_orbit S.transformation k x)

theorem aux_orbit_add_coordinate_apply {X : Type*}
    [MeasurableSpace X] {μ : Measure X} {n : ℕ}
    (S : ErgodicSystem X μ n) (k : Fin n → ℕ) (i : Fin n)
    (m : ℕ) (x : X) :
    aux_orbit S.transformation (k + aux_coordinate i m) x =
      (S.transformation i)^[m] (aux_orbit S.transformation k x) := by
  have hadd : k + aux_coordinate i m = aux_coordinate i m + k := by
    ext j
    simp only [Pi.add_apply]
    ac_rfl
  rw [hadd, aux_orbit_add S.transformation S.commutes,
    aux_orbit_coordinate]
  rfl

/--
The exact finite identity at the core of the ergodic-to-discrete
reduction.
-/
theorem aux_discreteAverage_orbitFunction {X : Type*}
    [MeasurableSpace X] {μ : Measure X} {n : ℕ}
    (S : ErgodicSystem X μ n) (f : Fin n → X → ℝ) (x : X)
    (k : Fin n → ℕ) (N : ℕ) :
    aux_discreteAverage N (aux_orbitFunction S f x) k =
      realErgodicAverage S N f (aux_orbit S.transformation k x) := by
  apply congrArg (fun z : ℝ ↦ (N : ℝ)⁻¹ * z)
  apply Finset.sum_congr rfl
  intro m hm
  apply Finset.prod_congr rfl
  intro i hi
  exact congrArg (f i) (aux_orbit_add_coordinate_apply S k i m x)

/--
The discrete jump energy of orbit data is exactly the lattice sum of the
corresponding ergodic jump functions.
-/
theorem aux_discreteJumpEnergy_orbitFunction {X : Type*}
    [MeasurableSpace X] {μ : Measure X} {n J : ℕ}
    (S : ErgodicSystem X μ n) (N : Fin (J + 1) → ℕ)
    (f : Fin n → X → ℝ) (x : X) :
    aux_discreteJumpEnergy N (aux_orbitFunction S f x) =
      ∑ j : Fin J, eLpNorm
        (fun k ↦ realErgodicAverage S (N j.succ) f
            (aux_orbit S.transformation k x) -
          realErgodicAverage S (N j.castSucc) f
            (aux_orbit S.transformation k x)) 2 Measure.count ^ 2 := by
  unfold aux_discreteJumpEnergy
  apply Finset.sum_congr rfl
  intro j hj
  congr 1
  apply congrArg (fun h ↦ eLpNorm h 2 Measure.count)
  funext k
  rw [aux_discreteAverage_orbitFunction]
  rw [aux_discreteAverage_orbitFunction]

/--
A nonnegative measurable integral is invariant under a joint forward
orbit.
-/
theorem aux_lintegral_orbit_comp {X : Type*} [MeasurableSpace X]
    {μ : Measure X} {n : ℕ} (S : ErgodicSystem X μ n) (k : Fin n → ℕ)
    {F : X → ℝ≥0∞} (hF : Measurable F) :
    ∫⁻ x, F (aux_orbit S.transformation k x) ∂μ = ∫⁻ x, F x ∂μ :=
  (aux_orbit_measurePreserving S.transformation k S.measurePreserving).lintegral_comp hF

/-- `Lᵖ` norms are invariant under joint forward orbits. -/
theorem aux_eLpNorm_orbit_comp {X : Type*} [MeasurableSpace X]
    {μ : Measure X} {n : ℕ} (S : ErgodicSystem X μ n) (k : Fin n → ℕ)
    {E : Type*} [TopologicalSpace E] [ContinuousENorm E]
    (F : X → E) (p : ℝ≥0∞) (hF : AEStronglyMeasurable F μ) :
    eLpNorm (F ∘ aux_orbit S.transformation k) p μ = eLpNorm F p μ :=
  eLpNorm_comp_measurePreserving hF
    (aux_orbit_measurePreserving S.transformation k S.measurePreserving)

/-- Membership in `Lᵖ` is stable under joint forward orbits. -/
theorem aux_memLp_orbit_comp {X : Type*} [MeasurableSpace X]
    {μ : Measure X} {n : ℕ} (S : ErgodicSystem X μ n) (k : Fin n → ℕ)
    {E : Type*} [TopologicalSpace E] [ContinuousENorm E]
    {F : X → E} {p : ℝ≥0∞} (hF : MemLp F p μ) :
    MemLp (F ∘ aux_orbit S.transformation k) p μ :=
  hF.comp_measurePreserving
    (aux_orbit_measurePreserving S.transformation k S.measurePreserving)

/-- The finite squared `L²` jump energy of real multiple ergodic averages. -/
noncomputable def realErgodicJumpEnergy {X : Type*} [MeasurableSpace X]
    {μ : Measure X} {n J : ℕ} (S : ErgodicSystem X μ n)
    (N : Fin (J + 1) → ℕ) (f : Fin n → X → ℝ) : ℝ≥0∞ :=
  ∑ j : Fin J, eLpNorm
    (fun x ↦ realErgodicAverage S (N j.succ) f x -
      realErgodicAverage S (N j.castSucc) f x) 2 μ ^ 2

/-- The real-variable hypothesis in the Calderón transference principle. -/
def realVariableJumpBound {n : ℕ} (p : Fin n → ℝ≥0∞)
    (C : ℝ) (g : ℕ → ℝ) : Prop :=
  ∀ (J : ℕ), 0 < J → ∀ (t : Fin (J + 1) → ℝ),
    StrictMono t → (∀ j, 0 < t j) →
      ∀ f : Fin n → ctRealVector n → ℝ,
        (∀ i, MemLp (f i) (p i) volume) →
          ctEndpointEnergy J t ctUnitIntervalKernel f ≤
            ENNReal.ofReal C * ENNReal.ofReal (g J) *
              ∏ i, eLpNorm (f i) (p i) volume ^ 2

/-- The real ergodic conclusion in the Calderón transference principle. -/
def realErgodicJumpBound {n : ℕ} (p : Fin n → ℝ≥0∞)
    (C : ℝ) (g : ℕ → ℝ) : Prop :=
  ∀ (X : Type u) [MeasurableSpace X] (μ : Measure X)
    (S : ErgodicSystem X μ n) (J : ℕ) (_hJ : 0 < J)
    (N : Fin (J + 1) → ℕ) (_hN : StrictMono N) (_hNpos : ∀ j, 0 < N j)
    (f : Fin n → X → ℝ), (∀ i, MemLp (f i) (p i) μ) →
      realErgodicJumpEnergy S N f ≤
        ENNReal.ofReal C * ENNReal.ofReal (g J) *
          ∏ i, eLpNorm (f i) (p i) μ ^ 2

/--
The application-facing name of the copied real-variable hypothesis from
`RealToErgodic`.
-/
abbrev aux_ct_realVariableJumpBound {n : ℕ} (p : Fin n → ℝ≥0∞)
    (C : ℝ) (g : ℕ → ℝ) : Prop :=
  realVariableJumpBound p C g

/--
The application-facing name of the copied ergodic conclusion from
`RealToErgodic`.
-/
abbrev aux_ct_realErgodicJumpBound.{v} {n : ℕ} (p : Fin n → ℝ≥0∞)
    (C : ℝ) (g : ℕ → ℝ) : Prop :=
  realErgodicJumpBound.{v} p C g

/-! ### Finite-support norm identities for the cuboid lift -/

namespace aux_CuboidNorm

abbrev RVector (n : ℕ) := aux_RVector n

abbrev ZVector (n : ℕ) := aux_ZVector n

def cuboid {n : ℕ} (l u : RVector n) : Set (RVector n) :=
  Set.pi Set.univ fun j ↦ Ico (l j) (u j)

theorem measurableSet_cuboid {n : ℕ} (l u : RVector n) :
    MeasurableSet (cuboid l u) := by
  unfold cuboid
  exact MeasurableSet.univ_pi fun _ ↦ measurableSet_Ico

theorem volume_cuboid {n : ℕ} (l u : RVector n) :
    volume (cuboid l u) = ∏ j, ENNReal.ofReal (u j - l j) :=
  Real.volume_pi_Ico

def axisLower {n : ℕ} (ε : ℝ) (i : Fin n)
    (k : RVector n) : RVector n :=
  fun j ↦ k j + if j = i then ε else 0

def axisUpper {n : ℕ} (ε δ : ℝ) (i : Fin n)
    (k : RVector n) : RVector n :=
  fun j ↦ k j + if j = i then ε + δ else ε

def axisCuboid {n : ℕ} (ε δ : ℝ) (i : Fin n)
    (k : RVector n) : Set (RVector n) :=
  cuboid (axisLower ε i k) (axisUpper ε δ i k)

def latticeAxisCuboid {n : ℕ} (ε δ : ℝ) (i : Fin n)
    (k : ZVector n) : Set (RVector n) :=
  axisCuboid ε δ i fun j ↦ (k j : ℝ)

/--
The floor description of the cuboid lift agrees with the corresponding
half-open translated cuboid.
-/
theorem mem_latticeAxisCuboid_iff {n : ℕ} {ε δ : ℝ}
    (hε0 : 0 ≤ ε) (hε : ε < 1) (hεδ : ε + δ < 1)
    (i : Fin n) (k : ZVector n) (y : RVector n) :
    y ∈ latticeAxisCuboid ε δ i k ↔
      (∀ j,
        if j = i then
          ε ≤ y j - (⌊y j⌋ : ℝ) ∧ y j - (⌊y j⌋ : ℝ) < ε + δ
        else
          0 ≤ y j - (⌊y j⌋ : ℝ) ∧ y j - (⌊y j⌋ : ℝ) < ε) ∧
        (fun j ↦ ⌊y j⌋) = k := by
  constructor
  · intro hy
    have hfloor : ∀ j, ⌊y j⌋ = k j := by
      intro j
      have hyj : y j ∈ Ico ((k j : ℝ) + if j = i then ε else 0)
          ((k j : ℝ) + if j = i then ε + δ else ε) := by
        simpa [latticeAxisCuboid, axisCuboid, cuboid, axisLower, axisUpper]
          using hy j (by simp)
      rcases hyj with ⟨hlow, hupp⟩
      by_cases hji : j = i
      · subst j
        simp only [eq_self, if_true] at hlow hupp
        have hyrewrite : y i = (k i : ℝ) + (y i - (k i : ℝ)) := by ring
        rw [hyrewrite]
        exact aux_floor_intCast_add_of_mem_Ico (k i) (by linarith) (by linarith)
      · simp only [if_neg hji] at hlow hupp
        have hyrewrite : y j = (k j : ℝ) + (y j - (k j : ℝ)) := by ring
        rw [hyrewrite]
        exact aux_floor_intCast_add_of_mem_Ico (k j) (by linarith) (by linarith)
    refine ⟨?_, funext hfloor⟩
    intro j
    have hyj : y j ∈ Ico ((k j : ℝ) + if j = i then ε else 0)
        ((k j : ℝ) + if j = i then ε + δ else ε) := by
      simpa [latticeAxisCuboid, axisCuboid, cuboid, axisLower, axisUpper]
        using hy j (by simp)
    rcases hyj with ⟨hlow, hupp⟩
    by_cases hji : j = i
    · subst j
      simp only [eq_self, if_true] at hlow hupp
      simp only [eq_self, if_true]
      rw [hfloor i]
      constructor <;> linarith
    · simp only [if_neg hji] at hlow hupp ⊢
      rw [hfloor j]
      constructor <;> linarith
  · rintro ⟨hcond, hfloor⟩
    intro j _
    specialize hcond j
    by_cases hji : j = i
    · subst j
      simp only [axisLower, axisUpper, Set.mem_Ico, eq_self, if_true]
      rw [← congrFun hfloor i]
      simp only [eq_self, if_true] at hcond
      constructor <;> linarith
    · simp only [axisLower, axisUpper, Set.mem_Ico, if_neg hji]
      rw [← congrFun hfloor j]
      simp only [if_neg hji] at hcond
      constructor <;> linarith

theorem volume_axisCuboid {n : ℕ} {ε δ : ℝ} (i : Fin n)
    (k : RVector n) :
    volume (axisCuboid ε δ i k) =
      ∏ j, ENNReal.ofReal (if j = i then δ else ε) := by
  rw [axisCuboid, volume_cuboid]
  apply Finset.prod_congr rfl
  intro j _
  simp only [axisUpper, axisLower]
  by_cases hji : j = i <;> simp [hji]

theorem disjoint_Ico_int_shift {c w : ℝ} (hw : w ≤ 1)
    {k l : ℤ} (hkl : k ≠ l) :
    Disjoint (Ico ((k : ℝ) + c) ((k : ℝ) + c + w))
      (Ico ((l : ℝ) + c) ((l : ℝ) + c + w)) := by
  apply Set.disjoint_left.2
  intro x hxk hxl
  rcases hxk with ⟨hxk₁, hxk₂⟩
  rcases hxl with ⟨hxl₁, hxl₂⟩
  rcases lt_or_gt_of_ne hkl with hlt | hgt
  · have hgapZ : k + 1 ≤ l := by omega
    have hgap : (k : ℝ) + 1 ≤ (l : ℝ) := by exact_mod_cast hgapZ
    linarith
  · have hgapZ : l + 1 ≤ k := by omega
    have hgap : (l : ℝ) + 1 ≤ (k : ℝ) := by exact_mod_cast hgapZ
    linarith

theorem latticeAxisCuboid_pairwise_disjoint {n : ℕ}
    {ε δ : ℝ} (hε : ε ≤ 1) (hδ : δ ≤ 1) (i : Fin n)
    {k l : ZVector n} (hkl : k ≠ l) :
    Disjoint (latticeAxisCuboid ε δ i k) (latticeAxisCuboid ε δ i l) := by
  apply Set.disjoint_left.2
  intro x hxk hxl
  have hcoordinate : ∃ j : Fin n, k j ≠ l j := by
    by_contra h
    push Not at h
    exact hkl (funext h)
  obtain ⟨j, hj⟩ := hcoordinate
  have hxkj : x j ∈ Ico ((k j : ℝ) + if j = i then ε else 0)
      ((k j : ℝ) + if j = i then ε + δ else ε) := by
    simpa [latticeAxisCuboid, axisCuboid, cuboid, axisLower, axisUpper]
      using hxk j (by simp)
  have hxlj : x j ∈ Ico ((l j : ℝ) + if j = i then ε else 0)
      ((l j : ℝ) + if j = i then ε + δ else ε) := by
    simpa [latticeAxisCuboid, axisCuboid, cuboid, axisLower, axisUpper]
      using hxl j (by simp)
  by_cases hji : j = i
  · subst j
    have h := disjoint_Ico_int_shift (c := ε) (w := δ) hδ hj
    have hxkj' : x i ∈ Ico ((k i : ℝ) + ε) ((k i : ℝ) + ε + δ) := by
      simpa [add_assoc] using hxkj
    have hxlj' : x i ∈ Ico ((l i : ℝ) + ε) ((l i : ℝ) + ε + δ) := by
      simpa [add_assoc] using hxlj
    exact Set.disjoint_left.1 h hxkj' hxlj'
  · have h := disjoint_Ico_int_shift (c := 0) (w := ε) hε hj
    have hxkj' : x j ∈ Ico ((k j : ℝ) + 0) ((k j : ℝ) + 0 + ε) := by
      simpa [hji, add_assoc] using hxkj
    have hxlj' : x j ∈ Ico ((l j : ℝ) + 0) ((l j : ℝ) + 0 + ε) := by
      simpa [hji, add_assoc] using hxlj
    exact Set.disjoint_left.1 h hxkj' hxlj'

variable {α κ : Type*} [MeasurableSpace α] [DecidableEq κ]

def finiteStep (A : Finset κ) (s : κ → Set α) (a : κ → ℝ) :
    α → ℝ :=
  fun x ↦ ∑ k ∈ A, (s k).indicator (fun _ ↦ a k) x

omit [MeasurableSpace α] [DecidableEq κ] in
theorem finiteStep_apply_of_mem (A : Finset κ) (s : κ → Set α)
    (a : κ → ℝ)
    (hdisj : ∀ ⦃k⦄, k ∈ A → ∀ ⦃l⦄, l ∈ A → k ≠ l → Disjoint (s k) (s l))
    {k : κ} (hk : k ∈ A) {x : α} (hx : x ∈ s k) :
    finiteStep A s a x = a k := by
  classical
  unfold finiteStep
  rw [Finset.sum_eq_single k]
  · simp [hx]
  · intro l hl hne
    have hxl : x ∉ s l := by
      intro hxl
      exact Set.disjoint_left.1 (hdisj hk hl hne.symm) hx hxl
    simp [hxl]
  · simp [hk]

omit [MeasurableSpace α] [DecidableEq κ] in
theorem finiteStep_apply_eq_zero (A : Finset κ) (s : κ → Set α)
    (a : κ → ℝ) {x : α} (hx : ∀ k ∈ A, x ∉ s k) :
    finiteStep A s a x = 0 := by
  classical
  unfold finiteStep
  apply Finset.sum_eq_zero
  intro k hk
  simp [hx k hk]

omit [MeasurableSpace α] [DecidableEq κ] in
theorem finiteStep_enorm_rpow (A : Finset κ) (s : κ → Set α)
    (a : κ → ℝ) (q : ℝ) (hq : 0 < q)
    (hdisj : ∀ ⦃k⦄, k ∈ A → ∀ ⦃l⦄, l ∈ A → k ≠ l → Disjoint (s k) (s l))
    (x : α) :
    ‖finiteStep A s a x‖ₑ ^ q =
      ∑ k ∈ A, (s k).indicator (fun _ ↦ ‖a k‖ₑ ^ q) x := by
  classical
  by_cases hx : ∃ k ∈ A, x ∈ s k
  · obtain ⟨k, hk, hxk⟩ := hx
    have hstep := finiteStep_apply_of_mem A s a hdisj hk hxk
    rw [hstep]
    rw [Finset.sum_eq_single k]
    · simp [hxk]
    · intro l hl hne
      have hxl : x ∉ s l := by
        intro hxl
        exact Set.disjoint_left.1 (hdisj hk hl hne.symm) hxk hxl
      simp [hxl]
    · simp [hk]
  · have hzero : finiteStep A s a x = 0 :=
      finiteStep_apply_eq_zero A s a (by
        simpa only [not_exists, not_and] using hx)
    rw [hzero]
    simp only [enorm_zero, ENNReal.zero_rpow_of_pos hq]
    apply Eq.symm
    apply Finset.sum_eq_zero
    intro k hk
    have hxk : x ∉ s k := by
      intro hxk
      exact hx ⟨k, hk, hxk⟩
    simp [hxk]

omit [DecidableEq κ] in
theorem lintegral_finiteStep_enorm_rpow (μ : Measure α) (A : Finset κ)
    (s : κ → Set α) (a : κ → ℝ) (q : ℝ) (hq : 0 < q)
    (hmeas : ∀ k ∈ A, MeasurableSet (s k))
    (hdisj : ∀ ⦃k⦄, k ∈ A → ∀ ⦃l⦄, l ∈ A → k ≠ l → Disjoint (s k) (s l)) :
    (∫⁻ x, ‖finiteStep A s a x‖ₑ ^ q ∂μ) =
      ∑ k ∈ A, ‖a k‖ₑ ^ q * μ (s k) := by
  simp_rw [finiteStep_enorm_rpow A s a q hq hdisj]
  rw [lintegral_finsetSum A]
  · apply Finset.sum_congr rfl
    intro k hk
    rw [lintegral_indicator_const (hmeas k hk)]
  · intro k hk
    exact measurable_const.indicator (hmeas k hk)

theorem measurableSet_latticeAxisCuboid {n : ℕ} (ε δ : ℝ)
    (i : Fin n) (k : ZVector n) :
    MeasurableSet (latticeAxisCuboid ε δ i k) :=
  measurableSet_cuboid _ _

def finiteLatticeStep {n : ℕ} (ε δ : ℝ) (i : Fin n)
    (A : Finset (ZVector n)) (a : ZVector n → ℝ) : RVector n → ℝ :=
  finiteStep A (latticeAxisCuboid ε δ i) a

/--
A finite-support floor cuboid lift is a finite sum of disjoint
half-open cuboid steps.
-/
theorem cuboidEmbed_eq_finiteLatticeStep_apply {n : ℕ}
    {ε δ : ℝ} (hε0 : 0 ≤ ε) (hε : ε < 1) (hεδ : ε + δ < 1)
    (i : Fin n) (A : Finset (ZVector n)) (a : ZVector n → ℝ)
    (hsupport : ∀ k, k ∉ A → a k = 0) (y : RVector n) :
    aux_cuboidEmbed ε δ i a y = finiteLatticeStep ε δ i A a y := by
  classical
  have hεle : ε ≤ 1 := hε.le
  have hδle : δ ≤ 1 := by linarith
  by_cases hactive : ∃ k ∈ A, y ∈ latticeAxisCuboid ε δ i k
  · obtain ⟨k, hk, hy⟩ := hactive
    have hmem := (mem_latticeAxisCuboid_iff hε0 hε hεδ i k y).mp hy
    calc
      aux_cuboidEmbed ε δ i a y = a k := by
        unfold aux_cuboidEmbed
        rw [if_pos hmem.1]
        exact congrArg a hmem.2
      _ = finiteLatticeStep ε δ i A a y := by
        unfold finiteLatticeStep
        exact (finiteStep_apply_of_mem A (latticeAxisCuboid ε δ i) a
          (fun k hk l hl hkl ↦ latticeAxisCuboid_pairwise_disjoint hεle hδle i hkl)
          hk hy).symm
  · have hstepzero : finiteLatticeStep ε δ i A a y = 0 := by
      unfold finiteLatticeStep
      apply finiteStep_apply_eq_zero
      intro k hk hy
      exact hactive ⟨k, hk, hy⟩
    unfold aux_cuboidEmbed
    split_ifs with hcond
    · have hy : y ∈ latticeAxisCuboid ε δ i (fun j ↦ ⌊y j⌋) :=
        (mem_latticeAxisCuboid_iff hε0 hε hεδ i (fun j ↦ ⌊y j⌋) y).mpr
          ⟨hcond, rfl⟩
      have hnot : (fun j ↦ ⌊y j⌋) ∉ A := by
        intro hk
        exact hactive ⟨_, hk, hy⟩
      rw [hstepzero]
      exact hsupport _ hnot
    · exact hstepzero.symm

theorem lintegral_finiteLatticeStep_enorm_rpow {n : ℕ}
    {ε δ : ℝ} (hε : ε ≤ 1) (hδ : δ ≤ 1) (i : Fin n)
    (A : Finset (ZVector n)) (a : ZVector n → ℝ) (q : ℝ) (hq : 0 < q) :
    (∫⁻ x, ‖finiteLatticeStep ε δ i A a x‖ₑ ^ q ∂volume) =
      ∑ k ∈ A, ‖a k‖ₑ ^ q * volume (latticeAxisCuboid ε δ i k) := by
  apply lintegral_finiteStep_enorm_rpow volume A
    (latticeAxisCuboid ε δ i) a q hq
  · intro k hk
    exact measurableSet_latticeAxisCuboid ε δ i k
  · intro k hk l hl hkl
    exact latticeAxisCuboid_pairwise_disjoint hε hδ i hkl

/-- The finite-support `L^q` integral formula for the cuboid lift. -/
theorem lintegral_cuboidEmbed_enorm_rpow {n : ℕ}
    {ε δ : ℝ} (hε0 : 0 ≤ ε) (hε : ε < 1) (hεδ : ε + δ < 1)
    (i : Fin n) (A : Finset (ZVector n)) (a : ZVector n → ℝ)
    (hsupport : ∀ k, k ∉ A → a k = 0) (q : ℝ) (hq : 0 < q) :
    (∫⁻ y, ‖aux_cuboidEmbed ε δ i a y‖ₑ ^ q ∂volume) =
      ∑ k ∈ A, ‖a k‖ₑ ^ q *
        ∏ j, ENNReal.ofReal (if j = i then δ else ε) := by
  have hεle : ε ≤ 1 := hε.le
  have hδle : δ ≤ 1 := by linarith
  calc
    (∫⁻ y, ‖aux_cuboidEmbed ε δ i a y‖ₑ ^ q ∂volume) =
        ∫⁻ y, ‖finiteLatticeStep ε δ i A a y‖ₑ ^ q ∂volume := by
          congr with y
          rw [cuboidEmbed_eq_finiteLatticeStep_apply hε0 hε hεδ i A a hsupport y]
    _ = ∑ k ∈ A, ‖a k‖ₑ ^ q * volume (latticeAxisCuboid ε δ i k) :=
      lintegral_finiteLatticeStep_enorm_rpow hεle hδle i A a q hq
    _ = ∑ k ∈ A, ‖a k‖ₑ ^ q *
        ∏ j, ENNReal.ofReal (if j = i then δ else ε) := by
      apply Finset.sum_congr rfl
      intro k hk
      rw [latticeAxisCuboid, volume_axisCuboid]

theorem eLpNorm_cuboidEmbed_eq {n : ℕ}
    {ε δ : ℝ} (hε0 : 0 ≤ ε) (hε : ε < 1) (hεδ : ε + δ < 1)
    (i : Fin n) (A : Finset (ZVector n)) (a : ZVector n → ℝ)
    (hsupport : ∀ k, k ∉ A → a k = 0) (p : ℝ≥0∞)
    (hp0 : p ≠ 0) (hptop : p ≠ ∞) :
    eLpNorm (aux_cuboidEmbed ε δ i a) p volume =
      (∑ k ∈ A, ‖a k‖ₑ ^ p.toReal *
        ∏ j, ENNReal.ofReal (if j = i then δ else ε)) ^ (1 / p.toReal) := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop]
  congr 1
  exact lintegral_cuboidEmbed_enorm_rpow hε0 hε hεδ i A a hsupport
    p.toReal (ENNReal.toReal_pos hp0 hptop)

theorem lintegral_count_enorm_rpow_eq_finset {κ : Type*}
    [MeasurableSpace κ] [MeasurableSingletonClass κ]
    (A : Finset κ) (a : κ → ℝ) (q : ℝ) (hq : 0 < q)
    (hsupport : ∀ k, k ∉ A → a k = 0) :
    (∫⁻ k, ‖a k‖ₑ ^ q ∂Measure.count) = ∑ k ∈ A, ‖a k‖ₑ ^ q := by
  classical
  rw [lintegral_count]
  exact tsum_eq_sum fun k hk ↦ by
    rw [hsupport k hk]
    simp [ENNReal.zero_rpow_of_pos hq]

/--
The cuboid lift has the original counting norm times its box-volume
factor.
-/
theorem eLpNorm_cuboidEmbed_eq_count_mul {n : ℕ}
    {ε δ : ℝ} (hε0 : 0 ≤ ε) (hε : ε < 1) (hεδ : ε + δ < 1)
    (i : Fin n) (A : Finset (ZVector n)) (a : ZVector n → ℝ)
    (hsupport : ∀ k, k ∉ A → a k = 0) (p : ℝ≥0∞)
    (hp0 : p ≠ 0) (hptop : p ≠ ∞) :
    eLpNorm (aux_cuboidEmbed ε δ i a) p volume =
      eLpNorm a p Measure.count *
        (∏ j, ENNReal.ofReal (if j = i then δ else ε)) ^ (1 / p.toReal) := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop,
    eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop]
  rw [lintegral_cuboidEmbed_enorm_rpow hε0 hε hεδ i A a hsupport
    p.toReal (ENNReal.toReal_pos hp0 hptop)]
  rw [← Finset.sum_mul, ← lintegral_count_enorm_rpow_eq_finset A a p.toReal
    (ENNReal.toReal_pos hp0 hptop) hsupport]
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity)]

theorem measurable_cuboidEmbed {n : ℕ}
    {ε δ : ℝ} (hε0 : 0 ≤ ε) (hε : ε < 1) (hεδ : ε + δ < 1)
    (i : Fin n) (A : Finset (ZVector n)) (a : ZVector n → ℝ)
    (hsupport : ∀ k, k ∉ A → a k = 0) :
    Measurable (aux_cuboidEmbed ε δ i a) := by
  have hEq : aux_cuboidEmbed ε δ i a = finiteLatticeStep ε δ i A a := by
    funext y
    exact cuboidEmbed_eq_finiteLatticeStep_apply hε0 hε hεδ i A a hsupport y
  rw [hEq]
  unfold finiteLatticeStep finiteStep
  apply Finset.measurable_sum A
  intro k hk
  exact measurable_const.indicator (measurableSet_latticeAxisCuboid ε δ i k)

theorem memLp_cuboidEmbed {n : ℕ}
    {ε δ : ℝ} (hε0 : 0 ≤ ε) (hε : ε < 1) (hεδ : ε + δ < 1)
    (i : Fin n) (A : Finset (ZVector n)) (a : ZVector n → ℝ)
    (hsupport : ∀ k, k ∉ A → a k = 0) (p : ℝ≥0∞)
    (hp0 : p ≠ 0) (hptop : p ≠ ∞) :
    MemLp (aux_cuboidEmbed ε δ i a) p volume := by
  refine ⟨(measurable_cuboidEmbed hε0 hε hεδ i A a hsupport).aestronglyMeasurable, ?_⟩
  rw [eLpNorm_cuboidEmbed_eq hε0 hε hεδ i A a hsupport p hp0 hptop]
  apply ENNReal.rpow_lt_top_of_nonneg (by positivity)
  apply (ENNReal.sum_lt_top.mpr fun k hk ↦ ?_).ne
  apply ENNReal.mul_lt_top
  · exact ENNReal.rpow_lt_top_of_nonneg ENNReal.toReal_nonneg (by simp)
  · apply ENNReal.prod_lt_top
    intro j hj
    exact ENNReal.ofReal_lt_top

theorem measurable_liftRaw {n : ℕ} {F : RVector n → ℝ}
    (hF : Measurable F) :
    Measurable (aux_liftRaw F) := by
  change Measurable (F ∘ WithLp.ofLp)
  exact hF.comp (PiLp.volume_preserving_ofLp (ι := Fin n)).measurable

theorem eLpNorm_liftRaw_eq {n : ℕ} (F : RVector n → ℝ)
    (p : ℝ≥0∞) (hF : Measurable F) :
    eLpNorm (aux_liftRaw F) p volume = eLpNorm F p volume := by
  have h := eLpNorm_comp_measurePreserving (p := p)
    (measurable_liftRaw hF).aestronglyMeasurable
    (PiLp.volume_preserving_toLp (Fin n))
  have hcomp : aux_liftRaw F ∘ WithLp.toLp 2 = F := by
    funext x
    exact aux_liftRaw_toLp F x
  rw [hcomp] at h
  exact h.symm

/--
The coordinate `WithLp` equivalence preserves `eLpNorm` without an
additional measurability assumption.  This form is useful for jump
functions, whose measurability is not part of the real-variable hypothesis.
-/
theorem eLpNorm_liftRaw_eq_any {n : ℕ} (F : RVector n → ℝ)
    (p : ℝ≥0∞) (hp0 : p ≠ 0) (hptop : p ≠ ∞) :
    eLpNorm (aux_liftRaw F) p volume = eLpNorm F p volume := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop,
    eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop]
  congr 1
  have h := (PiLp.volume_preserving_toLp (Fin n)).lintegral_comp_emb
    (MeasurableEquiv.toLp 2 (Fin n → ℝ)).measurableEmbedding
    (fun x : ctRealVector n ↦ ‖aux_liftRaw F x‖ₑ ^ p.toReal)
  have hcomp : (fun x : Fin n → ℝ ↦
      ‖aux_liftRaw F (WithLp.toLp 2 x)‖ₑ ^ p.toReal) =
      fun x ↦ ‖F x‖ₑ ^ p.toReal := by
    funext x
    rw [aux_liftRaw_toLp]
  rw [hcomp] at h
  exact h.symm

/--
Pulling a function back along the coordinate `WithLp` equivalence leaves
its `eLpNorm` unchanged, without a measurability side condition.
-/
theorem eLpNorm_toLp_comp_eq {n : ℕ} {E : Type*}
    [TopologicalSpace E] [ENorm E] (F : ctRealVector n → E)
    (p : ℝ≥0∞) (hp0 : p ≠ 0) (hptop : p ≠ ∞) :
    eLpNorm (fun x : RVector n ↦ F (WithLp.toLp 2 x)) p volume =
      eLpNorm F p volume := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop,
    eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop]
  congr 1
  exact (PiLp.volume_preserving_toLp (Fin n)).lintegral_comp_emb
    (MeasurableEquiv.toLp 2 (Fin n → ℝ)).measurableEmbedding
    (fun x ↦ ‖F x‖ₑ ^ p.toReal)

/--
The Euclidean cuboid lift has the corresponding counting norm times its
fixed box-volume factor.
-/
theorem eLpNorm_liftedCuboidEmbed_eq_count_mul {n : ℕ}
    {ε δ : ℝ} (hε0 : 0 ≤ ε) (hε : ε < 1) (hεδ : ε + δ < 1)
    (i : Fin n) (A : Finset (ZVector n)) (a : ZVector n → ℝ)
    (hsupport : ∀ k, k ∉ A → a k = 0) (p : ℝ≥0∞)
    (hp0 : p ≠ 0) (hptop : p ≠ ∞) :
    eLpNorm (aux_liftRaw (aux_cuboidEmbed ε δ i a)) p volume =
      eLpNorm a p Measure.count *
        (∏ j, ENNReal.ofReal (if j = i then δ else ε)) ^ (1 / p.toReal) := by
  rw [eLpNorm_liftRaw_eq _ p
    (measurable_cuboidEmbed hε0 hε hεδ i A a hsupport),
    eLpNorm_cuboidEmbed_eq_count_mul hε0 hε hεδ i A a hsupport p hp0 hptop]

theorem memLp_liftedCuboidEmbed {n : ℕ}
    {ε δ : ℝ} (hε0 : 0 ≤ ε) (hε : ε < 1) (hεδ : ε + δ < 1)
    (i : Fin n) (A : Finset (ZVector n)) (a : ZVector n → ℝ)
    (hsupport : ∀ k, k ∉ A → a k = 0) (p : ℝ≥0∞)
    (hp0 : p ≠ 0) (hptop : p ≠ ∞) :
    MemLp (aux_liftRaw (aux_cuboidEmbed ε δ i a)) p volume := by
  refine ⟨(measurable_liftRaw
    (measurable_cuboidEmbed hε0 hε hεδ i A a hsupport)).aestronglyMeasurable, ?_⟩
  rw [eLpNorm_liftRaw_eq _ p
    (measurable_cuboidEmbed hε0 hε hεδ i A a hsupport)]
  exact (memLp_cuboidEmbed hε0 hε hεδ i A a hsupport p hp0 hptop).2

theorem eLpNorm_liftedCuboidEmbed_le_count {n : ℕ}
    {ε δ : ℝ} (hε0 : 0 ≤ ε) (hε : ε < 1) (hεδ : ε + δ < 1)
    (i : Fin n) (A : Finset (ZVector n)) (a : ZVector n → ℝ)
    (hsupport : ∀ k, k ∉ A → a k = 0) (p : ℝ≥0∞)
    (hp0 : p ≠ 0) (hptop : p ≠ ∞)
    (hvolume : ∏ j, ENNReal.ofReal (if j = i then δ else ε) ≤ 1) :
    eLpNorm (aux_liftRaw (aux_cuboidEmbed ε δ i a)) p volume ≤
      eLpNorm a p Measure.count := by
  rw [eLpNorm_liftedCuboidEmbed_eq_count_mul hε0 hε hεδ i A a hsupport
    p hp0 hptop]
  calc
    eLpNorm a p Measure.count *
        (∏ j, ENNReal.ofReal (if j = i then δ else ε)) ^ (1 / p.toReal) ≤
        eLpNorm a p Measure.count * 1 :=
      by
        simpa [mul_comm] using mul_le_mul_left
          (ENNReal.rpow_le_one hvolume (by positivity)) (eLpNorm a p Measure.count)
    _ = eLpNorm a p Measure.count := mul_one _

/-! #### Finite base-cube energy lower bounds -/

def latticeCuboid {n : ℕ} (ε : ℝ) (k : ZVector n) :
    Set (RVector n) :=
  cuboid (fun j ↦ (k j : ℝ)) (fun j ↦ (k j : ℝ) + ε)

theorem measurableSet_latticeCuboid {n : ℕ} (ε : ℝ)
    (k : ZVector n) :
    MeasurableSet (latticeCuboid ε k) :=
  measurableSet_cuboid _ _

theorem volume_latticeCuboid {n : ℕ} (ε : ℝ) (k : ZVector n) :
    volume (latticeCuboid ε k) = ∏ _ : Fin n, ENNReal.ofReal ε := by
  rw [latticeCuboid, volume_cuboid]
  apply Finset.prod_congr rfl
  intro j _
  simp

theorem latticeCuboid_pairwise_disjoint {n : ℕ} {ε : ℝ} (hε : ε ≤ 1)
    {k l : ZVector n} (hkl : k ≠ l) :
    Disjoint (latticeCuboid ε k) (latticeCuboid ε l) := by
  apply Set.disjoint_left.2
  intro x hxk hxl
  have hcoordinate : ∃ j : Fin n, k j ≠ l j := by
    by_contra h
    push Not at h
    exact hkl (funext h)
  obtain ⟨j, hj⟩ := hcoordinate
  have hxkj : x j ∈ Ico ((k j : ℝ) + 0) ((k j : ℝ) + 0 + ε) := by
    simpa [latticeCuboid, cuboid, add_assoc] using hxk j (by simp)
  have hxlj : x j ∈ Ico ((l j : ℝ) + 0) ((l j : ℝ) + 0 + ε) := by
    simpa [latticeCuboid, cuboid, add_assoc] using hxl j (by simp)
  exact Set.disjoint_left.1 (disjoint_Ico_int_shift (c := 0) (w := ε) hε hj)
    hxkj hxlj

def finiteLatticeCubeStep {n : ℕ} (ε : ℝ) (A : Finset (ZVector n))
    (a : ZVector n → ℝ) : RVector n → ℝ :=
  finiteStep A (latticeCuboid ε) a

theorem lintegral_finiteLatticeCubeStep_enorm_rpow {n : ℕ}
    {ε : ℝ} (hε : ε ≤ 1) (A : Finset (ZVector n)) (a : ZVector n → ℝ)
    (q : ℝ) (hq : 0 < q) :
    (∫⁻ x, ‖finiteLatticeCubeStep ε A a x‖ₑ ^ q ∂volume) =
      ∑ k ∈ A, ‖a k‖ₑ ^ q * volume (latticeCuboid ε k) := by
  apply lintegral_finiteStep_enorm_rpow volume A (latticeCuboid ε) a q hq
  · intro k hk
    exact measurableSet_latticeCuboid ε k
  · intro k hk l hl hkl
    exact latticeCuboid_pairwise_disjoint hε hkl

theorem lintegral_finiteLatticeCubeStep_eq_count_mul {n : ℕ}
    {ε : ℝ} (hε : ε ≤ 1) (A : Finset (ZVector n)) (a : ZVector n → ℝ)
    (hsupport : ∀ k, k ∉ A → a k = 0) (q : ℝ) (hq : 0 < q) :
    (∫⁻ x, ‖finiteLatticeCubeStep ε A a x‖ₑ ^ q ∂volume) =
      (∫⁻ k, ‖a k‖ₑ ^ q ∂Measure.count) *
        ∏ _ : Fin n, ENNReal.ofReal ε := by
  rw [lintegral_finiteLatticeCubeStep_enorm_rpow hε A a q hq]
  calc
    (∑ k ∈ A, ‖a k‖ₑ ^ q * volume (latticeCuboid ε k)) =
        (∑ k ∈ A, ‖a k‖ₑ ^ q) * ∏ _ : Fin n, ENNReal.ofReal ε := by
          simp_rw [volume_latticeCuboid]
          rw [← Finset.sum_mul]
    _ = (∫⁻ k, ‖a k‖ₑ ^ q ∂Measure.count) *
        ∏ _ : Fin n, ENNReal.ofReal ε := by
          rw [lintegral_count_enorm_rpow_eq_finset A a q hq hsupport]

theorem finiteLatticeCubeStep_enorm_le_of_cube_dom {n : ℕ}
    {ε c : ℝ} (hε : ε ≤ 1) (A : Finset (ZVector n))
    (a : ZVector n → ℝ) (G : RVector n → ℝ)
    (hdom : ∀ k, k ∈ A → ∀ x, x ∈ latticeCuboid ε k →
      ‖c * a k‖ₑ ≤ ‖G x‖ₑ) :
    ∀ x, ‖finiteLatticeCubeStep ε A (fun k ↦ c * a k) x‖ₑ ≤ ‖G x‖ₑ := by
  intro x
  by_cases hx : ∃ k ∈ A, x ∈ latticeCuboid ε k
  · obtain ⟨k, hk, hxk⟩ := hx
    have hstep : finiteLatticeCubeStep ε A (fun k ↦ c * a k) x = c * a k := by
      unfold finiteLatticeCubeStep
      exact finiteStep_apply_of_mem A (latticeCuboid ε) (fun k ↦ c * a k)
        (fun k hk l hl hkl ↦ latticeCuboid_pairwise_disjoint hε hkl) hk hxk
    rw [hstep]
    exact hdom k hk x hxk
  · have hstep : finiteLatticeCubeStep ε A (fun k ↦ c * a k) x = 0 := by
      unfold finiteLatticeCubeStep
      apply finiteStep_apply_eq_zero
      intro k hk hxk
      exact hx ⟨k, hk, hxk⟩
    rw [hstep, enorm_zero]
    exact bot_le

theorem count_energy_mul_le_lintegral_of_cube_dom {n : ℕ}
    {ε c : ℝ} (hε : ε ≤ 1) (A : Finset (ZVector n))
    (a : ZVector n → ℝ) (G : RVector n → ℝ)
    (hsupport : ∀ k, k ∉ A → c * a k = 0)
    (hdom : ∀ k, k ∈ A → ∀ x, x ∈ latticeCuboid ε k →
      ‖c * a k‖ₑ ≤ ‖G x‖ₑ) :
    (∫⁻ k, ‖c * a k‖ₑ ^ (2 : ℝ) ∂Measure.count) *
        ∏ _ : Fin n, ENNReal.ofReal ε ≤
      ∫⁻ x, ‖G x‖ₑ ^ (2 : ℝ) ∂volume := by
  rw [← lintegral_finiteLatticeCubeStep_eq_count_mul hε A (fun k ↦ c * a k)
    hsupport 2 (by norm_num)]
  apply lintegral_mono
  intro x
  exact ENNReal.rpow_le_rpow
    (finiteLatticeCubeStep_enorm_le_of_cube_dom hε A a G hdom x) (by norm_num)

theorem eLpNorm_two_sq_nat {α E : Type*} [MeasurableSpace α]
    [TopologicalSpace E] [ENorm E] (μ : Measure α) (f : α → E) :
    eLpNorm f 2 μ ^ 2 = ∫⁻ x, ‖f x‖ₑ ^ (2 : ℕ) ∂μ := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num)]
  rw [show (2 : ℝ≥0∞).toReal = 2 by norm_num]
  rw [← ENNReal.rpow_natCast]
  rw [← ENNReal.rpow_mul]
  norm_num

theorem count_energy_mul_le_eLpNorm_two_sq_of_cube_dom {n : ℕ}
    {ε c : ℝ} (hε : ε ≤ 1) (A : Finset (ZVector n))
    (a : ZVector n → ℝ) (G : RVector n → ℝ)
    (hsupport : ∀ k, k ∉ A → c * a k = 0)
    (hdom : ∀ k, k ∈ A → ∀ x, x ∈ latticeCuboid ε k →
      ‖c * a k‖ₑ ≤ ‖G x‖ₑ) :
    (∫⁻ k, ‖c * a k‖ₑ ^ (2 : ℝ) ∂Measure.count) *
        ∏ _ : Fin n, ENNReal.ofReal ε ≤
      eLpNorm G (2 : ℝ≥0∞) volume ^ (2 : ℕ) := by
  rw [eLpNorm_two_sq_nat]
  have h := count_energy_mul_le_lintegral_of_cube_dom hε A a G hsupport hdom
  convert h using 1
  norm_num [ENNReal.rpow_natCast]

/--
A nonnegative lower coefficient can be moved through a real scalar
multiple inside the extended norm.
-/
theorem enorm_mul_le_enorm_mul_of_nonneg_le {c w h : ℝ}
    (hc : 0 ≤ c) (hcw : c ≤ w) :
    ‖c * h‖ₑ ≤ ‖w * h‖ₑ := by
  rw [Real.enorm_eq_ofReal_abs, Real.enorm_eq_ofReal_abs]
  apply ENNReal.ofReal_le_ofReal
  rw [abs_mul, abs_mul, abs_of_nonneg hc,
    abs_of_nonneg (le_trans hc hcw)]
  exact mul_le_mul_of_nonneg_right hcw (abs_nonneg h)

/--
The overlap formula gives the pointwise endpoint-jump domination needed
for the finite base-cube energy comparison.
-/
theorem endpointJump_cube_dom_of_overlap_formula {n J : ℕ}
    {ε δ : ℝ} (hεδ : ε ≤ δ)
    (N : Fin (J + 1) → ℕ) (T : ℕ → RVector n → ℝ)
    (D : ℕ → ZVector n → ℝ) (W : RVector n → ℝ)
    (hW : ∀ u, (∀ i, 0 ≤ u i ∧ u i ≤ ε) → δ - ε ≤ W u)
    (hT : ∀ (M : ℕ) (k : ZVector n) (u : RVector n),
      (∀ i, 0 ≤ u i ∧ u i < ε) →
      0 < M →
      T M (fun i ↦ (k i : ℝ) + u i) = W u * D M k)
    (hNpos : ∀ q, 0 < N q)
    (j : Fin J) (k : ZVector n) (x : RVector n)
    (hx : x ∈ latticeCuboid ε k) :
    ‖(δ - ε) * (D (N j.succ) k - D (N j.castSucc) k)‖ₑ ≤
      ‖(T (N j.succ) x - T (N j.castSucc) x)‖ₑ := by
  let u : RVector n := fun i ↦ x i - (k i : ℝ)
  have hu : ∀ i, 0 ≤ u i ∧ u i < ε := by
    intro i
    have hxi : x i ∈ Ico ((k i : ℝ)) ((k i : ℝ) + ε) := by
      simpa [latticeCuboid, cuboid] using hx i (by simp)
    exact ⟨by dsimp [u]; linarith [hxi.1], by dsimp [u]; linarith [hxi.2]⟩
  have hx_eq : x = fun i ↦ (k i : ℝ) + u i := by
    funext i
    dsimp [u]
    ring
  have hTsucc := hT (N j.succ) k u hu (hNpos j.succ)
  have hTprev := hT (N j.castSucc) k u hu (hNpos j.castSucc)
  rw [hx_eq, hTsucc, hTprev]
  rw [← mul_sub]
  exact enorm_mul_le_enorm_mul_of_nonneg_le (sub_nonneg.mpr hεδ)
    (hW u (fun i ↦ ⟨(hu i).1, (hu i).2.le⟩))

theorem finite_energy_factor {n : ℕ} (A : Finset (ZVector n))
    (ε c : ℝ) (hc : 0 ≤ c) (a : ZVector n → ℝ) :
    (∑ k ∈ A, ‖c * a k‖ₑ ^ (2 : ℝ)) *
        ∏ _ : Fin n, ENNReal.ofReal ε =
      (ENNReal.ofReal c ^ (2 : ℝ) * ENNReal.ofReal ε ^ n) *
        ∑ k ∈ A, ‖a k‖ₑ ^ (2 : ℝ) := by
  have hmul (x y : ℝ) :
      ‖x * y‖ₑ ^ (2 : ℝ) = ‖x‖ₑ ^ (2 : ℝ) * ‖y‖ₑ ^ (2 : ℝ) := by
    rw [enorm_mul, ENNReal.mul_rpow_of_nonneg]
    norm_num
  have hsum : ∑ k ∈ A, ‖c * a k‖ₑ ^ (2 : ℝ) =
      ‖c‖ₑ ^ (2 : ℝ) * ∑ k ∈ A, ‖a k‖ₑ ^ (2 : ℝ) := by
    simp_rw [hmul]
    rw [Finset.mul_sum]
  rw [hsum, Real.enorm_eq_ofReal_abs, abs_of_nonneg hc]
  simp only [Finset.prod_const]
  rw [Finset.card_fin]
  ac_rfl

/-- Sum the finite base-cube lower bound over all adjacent scale pairs. -/
theorem finite_jump_energy_lower_of_cube_dom {n J : ℕ}
    {ε c : ℝ} (hε : ε ≤ 1) (hc : 0 ≤ c)
    (A : Finset (ZVector n)) (d : Fin J → ZVector n → ℝ)
    (G : Fin J → RVector n → ℝ)
    (hsupport : ∀ j k, k ∉ A → c * d j k = 0)
    (hdom : ∀ j k, k ∈ A → ∀ x, x ∈ latticeCuboid ε k →
      ‖c * d j k‖ₑ ≤ ‖G j x‖ₑ) :
    (ENNReal.ofReal c ^ (2 : ℝ) * ENNReal.ofReal ε ^ n) *
        ∑ j : Fin J, ∑ k ∈ A, ‖d j k‖ₑ ^ (2 : ℝ) ≤
      ∑ j : Fin J, eLpNorm (G j) (2 : ℝ≥0∞) volume ^ (2 : ℕ) := by
  calc
    (ENNReal.ofReal c ^ (2 : ℝ) * ENNReal.ofReal ε ^ n) *
        ∑ j : Fin J, ∑ k ∈ A, ‖d j k‖ₑ ^ (2 : ℝ) =
        ∑ j : Fin J,
          ((ENNReal.ofReal c ^ (2 : ℝ) * ENNReal.ofReal ε ^ n) *
            ∑ k ∈ A, ‖d j k‖ₑ ^ (2 : ℝ)) := by
          rw [Finset.mul_sum]
    _ = ∑ j : Fin J,
          ((∫⁻ k, ‖c * d j k‖ₑ ^ (2 : ℝ) ∂Measure.count) *
            ∏ _ : Fin n, ENNReal.ofReal ε) := by
          apply Finset.sum_congr rfl
          intro j hj
          rw [lintegral_count_enorm_rpow_eq_finset A (fun k ↦ c * d j k) 2
            (by norm_num) (hsupport j)]
          exact (finite_energy_factor A ε c hc (d j)).symm
    _ ≤ ∑ j : Fin J, eLpNorm (G j) (2 : ℝ≥0∞) volume ^ (2 : ℕ) := by
          apply Finset.sum_le_sum
          intro j hj
          exact count_energy_mul_le_eLpNorm_two_sq_of_cube_dom hε A (d j) (G j)
            (hsupport j) (hdom j)

/--
The exact cuboid-overlap formula controls every finite portion of the
integer-lattice jump energy by the corresponding continuous jump energy.
-/
theorem finite_jump_energy_lower_on_of_overlap_formula {n J : ℕ}
    (hn : 0 < n) {ε δ : ℝ} (hε : ε < 1) (hεδ : ε ≤ δ)
    (hwidth : ε + δ < 1) (N : Fin (J + 1) → ℕ)
    (hNpos : ∀ q, 0 < N q) (a : Fin n → ZVector n → ℝ)
    (A : Finset (ZVector n)) :
    (ENNReal.ofReal (δ - ε) ^ (2 : ℝ) * ENNReal.ofReal ε ^ n) *
        ∑ j : Fin J, ∑ k ∈ A,
          ‖aux_integerDiscreteAverage (N j.succ) a k -
            aux_integerDiscreteAverage (N j.castSucc) a k‖ₑ ^ (2 : ℝ) ≤
      ∑ j : Fin J, eLpNorm
        (fun x ↦ ctTwistedAverageAtScale (N j.succ : ℝ) ctUnitIntervalKernel
            (fun i ↦ aux_liftRaw (aux_cuboidEmbed ε δ i (a i)))
            (WithLp.toLp 2 x) -
          ctTwistedAverageAtScale (N j.castSucc : ℝ) ctUnitIntervalKernel
            (fun i ↦ aux_liftRaw (aux_cuboidEmbed ε δ i (a i)))
            (WithLp.toLp 2 x)) 2 volume ^ 2 := by
  let d : Fin J → ZVector n → ℝ := fun j k ↦
    if k ∈ A then
      aux_integerDiscreteAverage (N j.succ) a k -
        aux_integerDiscreteAverage (N j.castSucc) a k
    else 0
  let G : Fin J → RVector n → ℝ := fun j x ↦
    ctTwistedAverageAtScale (N j.succ : ℝ) ctUnitIntervalKernel
        (fun i ↦ aux_liftRaw (aux_cuboidEmbed ε δ i (a i)))
        (WithLp.toLp 2 x) -
      ctTwistedAverageAtScale (N j.castSucc : ℝ) ctUnitIntervalKernel
        (fun i ↦ aux_liftRaw (aux_cuboidEmbed ε δ i (a i)))
        (WithLp.toLp 2 x)
  have hlower := finite_jump_energy_lower_of_cube_dom (n := n) (J := J)
    (ε := ε) (c := δ - ε) hε.le (sub_nonneg.mpr hεδ) A d G
    (by
      intro j k hk
      simp [d, hk])
    (by
      intro j k hk x hx
      dsimp [d, G]
      simp only [if_pos hk]
      apply endpointJump_cube_dom_of_overlap_formula hεδ N
        (fun M x ↦ ctTwistedAverageAtScale (M : ℝ) ctUnitIntervalKernel
          (fun i ↦ aux_liftRaw (aux_cuboidEmbed ε δ i (a i)))
          (WithLp.toLp 2 x))
        (fun M k ↦ aux_integerDiscreteAverage M a k)
        (aux_overlapWidth hn ε δ)
      · intro u hu
        exact aux_overlapWidth_lower_bound hn u hu
      · intro M k u hu hM
        exact aux_twistedAverageAtScale_cuboidLift_eq hn hε hεδ hwidth M hM
          a k u hu
      · exact hNpos
      · exact hx
      )
  have hsum : ∑ j : Fin J, ∑ k ∈ A, ‖d j k‖ₑ ^ (2 : ℝ) =
      ∑ j : Fin J, ∑ k ∈ A,
        ‖aux_integerDiscreteAverage (N j.succ) a k -
          aux_integerDiscreteAverage (N j.castSucc) a k‖ₑ ^ (2 : ℝ) := by
    apply Finset.sum_congr rfl
    intro j hj
    apply Finset.sum_congr rfl
    intro k hk
    simp [d, hk]
  rw [hsum] at hlower
  simpa [G] using hlower

set_option maxHeartbeats 800000 in
-- Expanding the two `ctEndpointEnergy` expressions exposes nested Bochner
-- integrals and exceeds Lean's default elaboration budget.
/--
Re-express the raw-coordinate jump energy used by the cuboid calculation
as the `ctEndpointEnergy` of its Euclidean lifts.
-/
theorem raw_cuboid_jumpEnergy_eq_endpointEnergy {n J : ℕ}
    (N : Fin (J + 1) → ℕ) (a : Fin n → ZVector n → ℝ)
    (ε δ : ℝ) :
    (∑ j : Fin J, eLpNorm
      (fun x ↦ ctTwistedAverageAtScale (N j.succ : ℝ) ctUnitIntervalKernel
          (fun i ↦ aux_liftRaw (aux_cuboidEmbed ε δ i (a i)))
          (WithLp.toLp 2 x) -
        ctTwistedAverageAtScale (N j.castSucc : ℝ) ctUnitIntervalKernel
          (fun i ↦ aux_liftRaw (aux_cuboidEmbed ε δ i (a i)))
          (WithLp.toLp 2 x)) 2 volume ^ 2) =
      ctEndpointEnergy J (fun q ↦ (N q : ℝ)) ctUnitIntervalKernel
        (fun i ↦ aux_liftRaw (aux_cuboidEmbed ε δ i (a i))) := by
  unfold ctEndpointEnergy
  apply Finset.sum_congr rfl
  intro j hj
  let H : ctRealVector n → ℝ := fun x ↦
    ctTwistedAverageAtScale (N j.succ : ℝ) ctUnitIntervalKernel
        (fun i ↦ aux_liftRaw (aux_cuboidEmbed ε δ i (a i))) x -
      ctTwistedAverageAtScale (N j.castSucc : ℝ) ctUnitIntervalKernel
        (fun i ↦ aux_liftRaw (aux_cuboidEmbed ε δ i (a i))) x
  change eLpNorm (fun x : RVector n ↦ H (WithLp.toLp 2 x)) 2 volume ^ 2 =
    eLpNorm H 2 volume ^ 2
  rw [eLpNorm_toLp_comp_eq H 2 (by norm_num) (by norm_num)]

/-! #### Zero extension from the forward lattice -/

def natToIntEmbedding {n : ℕ} : (Fin n → ℕ) ↪ ZVector n where
  toFun k := fun i ↦ (k i : ℤ)
  inj' := by
    intro k l h
    funext i
    exact Int.ofNat.inj (congrFun h i)

theorem natToInt_apply_of_nonneg {n : ℕ}
    (F : (Fin n → ℕ) → ℝ) (k : ZVector n) (hk : ∀ i, 0 ≤ k i) :
    aux_natToInt F k = F fun i ↦ (k i).toNat := by
  simp [aux_natToInt, hk]

theorem natToInt_apply_of_not_nonneg {n : ℕ}
    (F : (Fin n → ℕ) → ℝ) (k : ZVector n) (hk : ¬ ∀ i, 0 ≤ k i) :
    aux_natToInt F k = 0 := by
  simp [aux_natToInt, hk]

theorem natToInt_eq_of_embedding {n : ℕ}
    (F : (Fin n → ℕ) → ℝ) (k : Fin n → ℕ) :
    aux_natToInt F (natToIntEmbedding k) = F k := by
  have hnonneg : ∀ i, 0 ≤ natToIntEmbedding k i := by
    intro i
    change 0 ≤ (k i : ℤ)
    omega
  rw [natToInt_apply_of_nonneg F (natToIntEmbedding k) hnonneg]
  apply congrArg F
  funext i
  change ((k i : ℤ).toNat) = k i
  apply Int.ofNat.inj
  exact Int.toNat_of_nonneg (by omega)

theorem natToInt_support_map {n : ℕ} (A : Finset (Fin n → ℕ))
    (F : (Fin n → ℕ) → ℝ) (hsupport : ∀ k, k ∉ A → F k = 0) :
    ∀ z, z ∉ A.map natToIntEmbedding → aux_natToInt F z = 0 := by
  intro z hz
  by_cases hnonneg : ∀ i, 0 ≤ z i
  · rw [natToInt_apply_of_nonneg F z hnonneg]
    have hnot : (fun i ↦ (z i).toNat) ∉ A := by
      intro hm
      apply hz
      rw [Finset.mem_map]
      refine ⟨(fun i ↦ (z i).toNat), hm, ?_⟩
      ext i
      change ((z i).toNat : ℤ) = z i
      exact Int.toNat_of_nonneg (hnonneg i)
    exact hsupport _ hnot
  · exact natToInt_apply_of_not_nonneg F z hnonneg

theorem lintegral_count_natToInt_enorm_rpow_eq {n : ℕ}
    (A : Finset (Fin n → ℕ)) (F : (Fin n → ℕ) → ℝ)
    (hsupport : ∀ k, k ∉ A → F k = 0) (q : ℝ) (hq : 0 < q) :
    (∫⁻ z, ‖aux_natToInt F z‖ₑ ^ q ∂Measure.count) =
      ∫⁻ k, ‖F k‖ₑ ^ q ∂Measure.count := by
  rw [lintegral_count_enorm_rpow_eq_finset (A.map natToIntEmbedding)
    (aux_natToInt F) q hq (natToInt_support_map A F hsupport)]
  rw [lintegral_count_enorm_rpow_eq_finset A F q hq hsupport]
  rw [Finset.sum_map]
  apply Finset.sum_congr rfl
  intro k hk
  rw [natToInt_eq_of_embedding]

theorem eLpNorm_natToInt_eq_count {n : ℕ}
    (A : Finset (Fin n → ℕ)) (F : (Fin n → ℕ) → ℝ)
    (hsupport : ∀ k, k ∉ A → F k = 0) (p : ℝ≥0∞)
    (hp0 : p ≠ 0) (hptop : p ≠ ∞) :
    eLpNorm (aux_natToInt F) p Measure.count = eLpNorm F p Measure.count := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop,
    eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop,
    lintegral_count_natToInt_enorm_rpow_eq A F hsupport p.toReal
      (ENNReal.toReal_pos hp0 hptop)]

end aux_CuboidNorm

/-! ### Finite localization of discrete data -/

/-- Restrict a forward-lattice function to a finite set. -/
noncomputable def aux_truncate {n : ℕ} (A : Finset (Fin n → ℕ))
    (F : (Fin n → ℕ) → ℝ) : (Fin n → ℕ) → ℝ :=
  fun k ↦ if k ∈ A then F k else 0

/--
The finite set of all sites sampled by averages of length at most `L` at
points in `B`.
-/
noncomputable def aux_localInputSupport {n : ℕ}
    (B : Finset (Fin n → ℕ)) (L : ℕ) : Finset (Fin n → ℕ) :=
  B.biUnion fun k ↦
    (Finset.univ : Finset (Fin n)).biUnion fun i ↦
      (Finset.range L).image fun m ↦ k + aux_coordinate i m

theorem aux_mem_localInputSupport {n : ℕ}
    {B : Finset (Fin n → ℕ)} {L : ℕ} {k : Fin n → ℕ} (hk : k ∈ B)
    (i : Fin n) {m : ℕ} (hm : m < L) :
    k + aux_coordinate i m ∈ aux_localInputSupport B L := by
  classical
  simp only [aux_localInputSupport, Finset.mem_biUnion, Finset.mem_univ,
    true_and, Finset.mem_image, Finset.mem_range]
  exact ⟨k, hk, i, m, hm, rfl⟩

theorem aux_truncate_eq_self_of_mem {n : ℕ}
    (A : Finset (Fin n → ℕ)) (F : (Fin n → ℕ) → ℝ)
    {k : Fin n → ℕ} (hk : k ∈ A) :
    aux_truncate A F k = F k := by
  simp [aux_truncate, hk]

theorem aux_truncate_eq_zero_of_not_mem {n : ℕ}
    (A : Finset (Fin n → ℕ)) (F : (Fin n → ℕ) → ℝ)
    {k : Fin n → ℕ} (hk : k ∉ A) :
    aux_truncate A F k = 0 := by
  simp [aux_truncate, hk]

theorem aux_discreteAverage_congr_on {n : ℕ} (N : ℕ)
    (F G : Fin n → (Fin n → ℕ) → ℝ) (k : Fin n → ℕ)
    (h : ∀ i m, m ∈ Finset.range N →
      F i (k + aux_coordinate i m) = G i (k + aux_coordinate i m)) :
    aux_discreteAverage N F k = aux_discreteAverage N G k := by
  unfold aux_discreteAverage
  congr 1
  apply Finset.sum_congr rfl
  intro m hm
  apply Finset.prod_congr rfl
  intro i hi
  exact h i m hm

/--
Truncation to the sites relevant for a finite output set preserves all
averages whose scale does not exceed the chosen cutoff.
-/
theorem aux_discreteAverage_truncate_eq_of_mem {n : ℕ}
    {B : Finset (Fin n → ℕ)} {L N : ℕ} (hNL : N ≤ L)
    (F : Fin n → (Fin n → ℕ) → ℝ) {k : Fin n → ℕ} (hk : k ∈ B) :
    aux_discreteAverage N
        (fun i ↦ aux_truncate (aux_localInputSupport B L) (F i)) k =
      aux_discreteAverage N F k := by
  apply aux_discreteAverage_congr_on
  intro i m hm
  apply aux_truncate_eq_self_of_mem
  exact aux_mem_localInputSupport hk i
    (lt_of_lt_of_le (Finset.mem_range.mp hm) hNL)

theorem aux_eLpNorm_truncate_le {n : ℕ} (A : Finset (Fin n → ℕ))
    (F : (Fin n → ℕ) → ℝ) (p : ℝ≥0∞) :
    eLpNorm (aux_truncate A F) p Measure.count ≤ eLpNorm F p Measure.count := by
  apply eLpNorm_mono_enorm
  intro k
  by_cases hk : k ∈ A <;> simp [aux_truncate, hk]

theorem aux_memLp_truncate {n : ℕ} (A : Finset (Fin n → ℕ))
    (F : (Fin n → ℕ) → ℝ) (p : ℝ≥0∞) (hF : MemLp F p Measure.count) :
    MemLp (aux_truncate A F) p Measure.count := by
  refine ⟨(measurable_of_countable _).aestronglyMeasurable, ?_⟩
  exact (aux_eLpNorm_truncate_le A F p).trans_lt hF.2

/-! ### The finite continuous-to-discrete reduction -/

set_option maxHeartbeats 800000 in
-- The cuboid lift expands two nested finite jump sums and needs a larger
-- elaboration budget than Lean's default heartbeat limit.
theorem aux_finite_forward_jump_energy_lower {n J : ℕ}
    (hn : 0 < n) {ε δ : ℝ} (hε : ε < 1) (hεδ : ε ≤ δ)
    (hwidth : ε + δ < 1) (N : Fin (J + 1) → ℕ)
    (hN : StrictMono N) (hNpos : ∀ q, 0 < N q)
    (F : Fin n → (Fin n → ℕ) → ℝ) (A : Finset (Fin n → ℕ)) :
    (ENNReal.ofReal (δ - ε) ^ (2 : ℝ) * ENNReal.ofReal ε ^ n) *
        ∑ j : Fin J, ∑ k ∈ A,
          ‖aux_discreteAverage (N j.succ) F k -
            aux_discreteAverage (N j.castSucc) F k‖ₑ ^ (2 : ℝ) ≤
      ctEndpointEnergy J (fun q ↦ (N q : ℝ)) ctUnitIntervalKernel
        (fun i ↦ aux_liftRaw (aux_cuboidEmbed ε δ i
          (aux_natToInt (aux_truncate
            (aux_localInputSupport A (N (Fin.last J))) (F i))))) := by
  let L : ℕ := N (Fin.last J)
  let B : Finset (Fin n → ℕ) := aux_localInputSupport A L
  let F' : Fin n → (Fin n → ℕ) → ℝ := fun i ↦ aux_truncate B (F i)
  let a : Fin n → aux_ZVector n → ℝ := fun i ↦ aux_natToInt (F' i)
  have hscale : ∀ q : Fin (J + 1), N q ≤ L := by
    intro q
    exact hN.monotone (Fin.le_last q)
  have hsupport : ∀ i z, z ∉ B.map aux_CuboidNorm.natToIntEmbedding → a i z = 0 := by
    intro i z hz
    exact aux_CuboidNorm.natToInt_support_map B (F' i) (by
      intro k hk
      simp [F', aux_truncate, hk]) z hz
  have havg : ∀ (q : Fin (J + 1)) (k : Fin n → ℕ), k ∈ A →
      aux_integerDiscreteAverage (N q) a (aux_CuboidNorm.natToIntEmbedding k) =
        aux_discreteAverage (N q) F k := by
    intro q k hk
    calc
      aux_integerDiscreteAverage (N q) a (aux_CuboidNorm.natToIntEmbedding k) =
          aux_discreteAverage (N q) F' k := by
        exact aux_integerDiscreteAverage_natToInt (N q) F' k
      _ = aux_discreteAverage (N q) F k := by
        exact aux_discreteAverage_truncate_eq_of_mem (hscale q) F hk
  have hlower := aux_CuboidNorm.finite_jump_energy_lower_on_of_overlap_formula
    hn hε hεδ hwidth N hNpos a (A.map aux_CuboidNorm.natToIntEmbedding)
  have hsum :
      ∑ j : Fin J, ∑ z ∈ A.map aux_CuboidNorm.natToIntEmbedding,
          ‖aux_integerDiscreteAverage (N j.succ) a z -
            aux_integerDiscreteAverage (N j.castSucc) a z‖ₑ ^ (2 : ℝ) =
        ∑ j : Fin J, ∑ k ∈ A,
          ‖aux_discreteAverage (N j.succ) F k -
            aux_discreteAverage (N j.castSucc) F k‖ₑ ^ (2 : ℝ) := by
    apply Finset.sum_congr rfl
    intro j hj
    rw [Finset.sum_map]
    apply Finset.sum_congr rfl
    intro k hk
    rw [havg j.succ k hk, havg j.castSucc k hk]
  rw [hsum, aux_CuboidNorm.raw_cuboid_jumpEnergy_eq_endpointEnergy] at hlower
  simpa only [L, B, F', a] using hlower

theorem aux_cuboid_factor_mul_dyadic (n : ℕ) :
    (ENNReal.ofReal ((1 : ℝ) / 8) ^ (2 : ℝ) *
      ENNReal.ofReal ((1 : ℝ) / 8) ^ n) *
      ((2 : ℝ≥0∞) ^ (3 * n + 6)) = 1 := by
  norm_num [ENNReal.ofReal_div_of_pos]
  have h8 : (8 : ℝ≥0∞) = (2 : ℝ≥0∞) ^ 3 := by norm_num
  rw [h8, ENNReal.inv_pow]
  rw [← pow_mul, ← pow_mul, ← pow_add]
  have hexp : 3 * 2 + 3 * n = 3 * n + 6 := by omega
  rw [hexp, ← ENNReal.inv_pow]
  exact ENNReal.inv_mul_cancel (by norm_num) (by norm_num)

theorem aux_ofReal_dyadic_power (n : ℕ) :
    ENNReal.ofReal ((2 : ℝ) ^ (3 * n + 6)) =
      ((2 : ℝ≥0∞) ^ (3 * n + 6)) := by
  norm_num

/-- Cancel the positive-volume cuboid factor in the finite lower estimate. -/
theorem aux_finite_continuous_to_discrete_constant_bridge {n : ℕ}
    (C g : ℝ) (D E : ℝ≥0∞) (L F : Fin n → ℝ≥0∞)
    (hlower :
      (ENNReal.ofReal ((1 : ℝ) / 8) ^ (2 : ℝ) *
        ENNReal.ofReal ((1 : ℝ) / 8) ^ n) * D ≤ E)
    (hupper : E ≤ ENNReal.ofReal C * ENNReal.ofReal g *
      ∏ i, L i ^ (2 : ℕ))
    (hL : ∀ i, L i ≤ F i) :
    D ≤ ENNReal.ofReal (((2 : ℝ) ^ (3 * n + 6)) * C) *
      ENNReal.ofReal g * ∏ i, F i ^ (2 : ℕ) := by
  let K : ℝ≥0∞ := (2 : ℝ≥0∞) ^ (3 * n + 6)
  have hK :
      (ENNReal.ofReal ((1 : ℝ) / 8) ^ (2 : ℝ) *
        ENNReal.ofReal ((1 : ℝ) / 8) ^ n) * K = 1 := by
    exact aux_cuboid_factor_mul_dyadic n
  have hDE : D ≤ K * E := by
    calc
      D =
          ((ENNReal.ofReal ((1 : ℝ) / 8) ^ (2 : ℝ) *
            ENNReal.ofReal ((1 : ℝ) / 8) ^ n) * K) * D := by
              rw [hK, one_mul]
      _ = K *
          ((ENNReal.ofReal ((1 : ℝ) / 8) ^ (2 : ℝ) *
            ENNReal.ofReal ((1 : ℝ) / 8) ^ n) * D) := by
              ac_rfl
      _ ≤ K * E := mul_le_mul_right hlower K
  have hprod : ∏ i, L i ^ (2 : ℕ) ≤ ∏ i, F i ^ (2 : ℕ) := by
    apply Finset.prod_le_prod'
    intro i hi
    exact pow_le_pow_left' (hL i) 2
  calc
    D ≤ K * E := hDE
    _ ≤ K * (ENNReal.ofReal C * ENNReal.ofReal g *
        ∏ i, L i ^ (2 : ℕ)) := mul_le_mul_right hupper K
    _ = ENNReal.ofReal (((2 : ℝ) ^ (3 * n + 6)) * C) *
        ENNReal.ofReal g * ∏ i, L i ^ (2 : ℕ) := by
          have hp : 0 ≤ (2 : ℝ) ^ (3 * n + 6) := by positivity
          have hcast : ENNReal.ofReal ((2 : ℝ) ^ (3 * n + 6)) *
              ENNReal.ofReal C =
              ENNReal.ofReal (((2 : ℝ) ^ (3 * n + 6) * C)) :=
            (ENNReal.ofReal_mul hp).symm
          dsimp [K]
          rw [← aux_ofReal_dyadic_power n]
          rw [show ENNReal.ofReal ((2 : ℝ) ^ (3 * n + 6)) *
              (ENNReal.ofReal C * ENNReal.ofReal g *
                ∏ i, L i ^ (2 : ℕ)) =
              (ENNReal.ofReal ((2 : ℝ) ^ (3 * n + 6)) * ENNReal.ofReal C) *
                ENNReal.ofReal g * ∏ i, L i ^ (2 : ℕ) by ac_rfl,
            hcast]
    _ ≤ ENNReal.ofReal (((2 : ℝ) ^ (3 * n + 6)) * C) *
        ENNReal.ofReal g * ∏ i, F i ^ (2 : ℕ) :=
      mul_le_mul_right hprod _

set_option maxHeartbeats 800000 in
-- The local cuboid lift carries several nested finite sums through the
-- real-variable endpoint estimate.
/--
The continuous real-variable hypothesis bounds every finite portion of a
forward-lattice jump sum.  The data are first truncated only at sites read by
the finitely many output points under consideration.
-/
theorem aux_finite_forward_jump_bound_of_realVariable {n J : ℕ}
    (hn : 0 < n) (p : Fin n → ℝ≥0∞) (C : ℝ) (g : ℕ → ℝ)
    (hreal : realVariableJumpBound p C g) (hJ : 0 < J)
    (N : Fin (J + 1) → ℕ) (hN : StrictMono N)
    (hNpos : ∀ q, 0 < N q) (F : Fin n → (Fin n → ℕ) → ℝ)
    (A : Finset (Fin n → ℕ))
    (hp0 : ∀ i, p i ≠ 0) (hptop : ∀ i, p i ≠ ∞) :
    ∑ j : Fin J, ∑ k ∈ A,
      ‖aux_discreteAverage (N j.succ) F k -
        aux_discreteAverage (N j.castSucc) F k‖ₑ ^ (2 : ℝ) ≤
      ENNReal.ofReal (((2 : ℝ) ^ (3 * n + 6)) * C) *
        ENNReal.ofReal (g J) *
          ∏ i, eLpNorm (F i) (p i) Measure.count ^ (2 : ℕ) := by
  let ε : ℝ := (1 : ℝ) / 8
  let δ : ℝ := (1 : ℝ) / 4
  let L : ℕ := N (Fin.last J)
  let B : Finset (Fin n → ℕ) := aux_localInputSupport A L
  let F' : Fin n → (Fin n → ℕ) → ℝ := fun i ↦ aux_truncate B (F i)
  let a : Fin n → aux_ZVector n → ℝ := fun i ↦ aux_natToInt (F' i)
  let f : Fin n → ctRealVector n → ℝ :=
    fun i ↦ aux_liftRaw (aux_cuboidEmbed ε δ i (a i))
  let D : ℝ≥0∞ := ∑ j : Fin J, ∑ k ∈ A,
    ‖aux_discreteAverage (N j.succ) F k -
      aux_discreteAverage (N j.castSucc) F k‖ₑ ^ (2 : ℝ)
  let E : ℝ≥0∞ := ctEndpointEnergy J (fun q ↦ (N q : ℝ))
    ctUnitIntervalKernel f
  have hε0 : 0 ≤ ε := by dsimp [ε]; norm_num
  have hε : ε < 1 := by dsimp [ε]; norm_num
  have hεδ : ε ≤ δ := by dsimp [ε, δ]; norm_num
  have hwidth : ε + δ < 1 := by dsimp [ε, δ]; norm_num
  have ht : StrictMono (fun q : Fin (J + 1) ↦ (N q : ℝ)) := by
    intro q r hqr
    change (N q : ℝ) < (N r : ℝ)
    exact_mod_cast hN hqr
  have hsupportF' : ∀ i k, k ∉ B → F' i k = 0 := by
    intro i k hk
    simp [F', aux_truncate, hk]
  have hsupport : ∀ i z, z ∉ B.map aux_CuboidNorm.natToIntEmbedding →
      a i z = 0 := by
    intro i z hz
    exact aux_CuboidNorm.natToInt_support_map B (F' i) (hsupportF' i) z hz
  have htlower :
      (ENNReal.ofReal ((1 : ℝ) / 8) ^ (2 : ℝ) *
        ENNReal.ofReal ((1 : ℝ) / 8) ^ n) * D ≤ E := by
    have hlow := aux_finite_forward_jump_energy_lower hn hε hεδ hwidth
      N hN hNpos F A
    rw [show δ - ε = (1 : ℝ) / 8 by dsimp [ε, δ]; norm_num] at hlow
    simpa only [D, E, ε, δ, L, B, F', a, f] using hlow
  have hmem : ∀ i, MemLp (f i) (p i) volume := by
    intro i
    dsimp [f]
    apply aux_CuboidNorm.memLp_liftedCuboidEmbed hε0 hε hwidth i
      (B.map aux_CuboidNorm.natToIntEmbedding) (a i) (hsupport i)
      (p i) (hp0 i) (hptop i)
  have hreal' := hreal J hJ (fun q ↦ (N q : ℝ)) ht
    (fun q ↦ by exact_mod_cast hNpos q) f hmem
  have hvolume : ∀ i : Fin n,
      ∏ j, ENNReal.ofReal (if j = i then δ else ε) ≤ 1 := by
    intro i
    apply Finset.prod_le_one'
    intro j hj
    rw [ENNReal.ofReal_le_one]
    by_cases hji : j = i <;> simp [hji, ε, δ] <;> norm_num
  have hnorm : ∀ i, eLpNorm (f i) (p i) volume ≤
      eLpNorm (F i) (p i) Measure.count := by
    intro i
    calc
      eLpNorm (f i) (p i) volume ≤ eLpNorm (a i) (p i) Measure.count := by
        dsimp [f]
        exact aux_CuboidNorm.eLpNorm_liftedCuboidEmbed_le_count hε0 hε
          hwidth i (B.map aux_CuboidNorm.natToIntEmbedding) (a i)
          (hsupport i) (p i) (hp0 i) (hptop i) (hvolume i)
      _ = eLpNorm (F' i) (p i) Measure.count := by
        exact aux_CuboidNorm.eLpNorm_natToInt_eq_count B (F' i)
          (hsupportF' i) (p i) (hp0 i) (hptop i)
      _ ≤ eLpNorm (F i) (p i) Measure.count :=
        aux_eLpNorm_truncate_le B (F i) (p i)
  apply aux_finite_continuous_to_discrete_constant_bridge C (g J) D E
    (fun i ↦ eLpNorm (f i) (p i) volume)
    (fun i ↦ eLpNorm (F i) (p i) Measure.count) htlower
  · exact hreal'
  · exact hnorm

namespace aux_ErgodicBox

open MeasureTheory Set
open scoped ENNReal BigOperators

def box (n L : ℕ) : Finset (Fin n → ℕ) :=
  Fintype.piFinset fun _ : Fin n => Finset.range L

theorem mem_box {n L : ℕ} (k : Fin n → ℕ) :
    k ∈ box n L ↔ ∀ i, k i < L := by
  simp [box]

theorem card_box (n L : ℕ) : (box n L).card = L ^ n := by
  simp [box]

theorem box_subset_double (n M : ℕ) :
    box n M ⊆ box n (M + M) := by
  intro k hk
  rw [mem_box] at hk ⊢
  intro i
  exact lt_of_lt_of_le (hk i) (Nat.le_add_right _ _)

theorem card_box_double (n M : ℕ) :
    (box n (M + M)).card = 2 ^ n * (box n M).card := by
  rw [card_box, card_box]
  rw [show M + M = 2 * M by omega, Nat.mul_pow]

/--
Cancels the inner-box cardinality after enlarging a side length from
`M` to `2M`.  This is the sole cardinality loss in the finite-box
ergodic-to-discrete reduction.
-/
theorem cancel_box_ratio {n M : ℕ} (hM : 0 < M)
    {E A P : ℝ≥0∞}
    (h : ((box n M).card : ℝ≥0∞) * E ≤
      A * ((box n (M + M)).card : ℝ≥0∞) * P) :
    E ≤ A * ((2 ^ n : ℕ) : ℝ≥0∞) * P := by
  have hcard : ((box n (M + M)).card : ℝ≥0∞) =
      ((2 ^ n : ℕ) : ℝ≥0∞) * ((box n M).card : ℝ≥0∞) := by
    rw [card_box_double]
    norm_cast
  have hb0 : ((box n M).card : ℝ≥0∞) ≠ 0 := by
    rw [card_box]
    apply ENNReal.coe_ne_zero.mpr
    norm_cast
    exact pow_ne_zero _ (Nat.ne_of_gt hM)
  have hbtop : ((box n M).card : ℝ≥0∞) ≠ ∞ := ENNReal.coe_ne_top
  apply (ENNReal.mul_le_mul_iff_right hb0 hbtop).mp
  calc
    ((box n M).card : ℝ≥0∞) * E ≤
        A * ((box n (M + M)).card : ℝ≥0∞) * P := h
    _ = ((box n M).card : ℝ≥0∞) *
        (A * ((2 ^ n : ℕ) : ℝ≥0∞) * P) := by
      rw [hcard]
      ac_rfl

theorem aemeasurable_enorm_rpow {X : Type*} [MeasurableSpace X]
    {μ : Measure X} (f : X → ℝ) (hf : AEStronglyMeasurable f μ) (p : ℝ) :
    AEMeasurable (fun x ↦ ‖f x‖ₑ ^ p) μ := by
  exact ENNReal.continuous_rpow_const.aemeasurable.comp_aemeasurable hf.enorm

theorem lintegral_enorm_rpow_comp_measurePreserving
    {X : Type*} [MeasurableSpace X] {μ : Measure X}
    (T : X → X) (hT : MeasurePreserving T μ μ)
    (f : X → ℝ) (hf : AEStronglyMeasurable f μ) (p : ℝ) :
    ∫⁻ x, ‖f (T x)‖ₑ ^ p ∂μ = ∫⁻ x, ‖f x‖ₑ ^ p ∂μ := by
  change ∫⁻ x, ((fun y ↦ ‖f y‖ₑ ^ p) ∘ T) x ∂μ = _
  rw [lintegral_comp'
    (by simpa only [hT.map_eq] using aemeasurable_enorm_rpow f hf p)
    hT.aemeasurable, hT.map_eq]

noncomputable def orbitPowerSum {X κ : Type*} [MeasurableSpace X]
    (B : Finset κ) (T : κ → X → X) (f : X → ℝ) (p : ℝ) : X → ℝ≥0∞ :=
  fun x ↦ ∑ k ∈ B, ‖f (T k x)‖ₑ ^ p

theorem aemeasurable_orbitPowerSum
    {X κ : Type*} [MeasurableSpace X] {μ : Measure X}
    (B : Finset κ) (T : κ → X → X)
    (hT : ∀ k ∈ B, MeasurePreserving (T k) μ μ)
    (f : X → ℝ) (hf : AEStronglyMeasurable f μ) (p : ℝ) :
    AEMeasurable (orbitPowerSum B T f p) μ := by
  unfold orbitPowerSum
  simpa only [Finset.sum_fn, Function.comp_apply] using Finset.aemeasurable_sum B
    (fun k hk ↦ aemeasurable_enorm_rpow (f ∘ T k)
      (hf.comp_quasiMeasurePreserving (hT k hk).quasiMeasurePreserving) p)

theorem lintegral_orbitPowerSum
    {X κ : Type*} [MeasurableSpace X] {μ : Measure X}
    (B : Finset κ) (T : κ → X → X)
    (hT : ∀ k ∈ B, MeasurePreserving (T k) μ μ)
    (f : X → ℝ) (hf : AEStronglyMeasurable f μ) (p : ℝ) :
    ∫⁻ x, orbitPowerSum B T f p x ∂μ =
      B.card * ∫⁻ x, ‖f x‖ₑ ^ p ∂μ := by
  unfold orbitPowerSum
  rw [lintegral_finsetSum' B]
  · calc
      ∑ k ∈ B, ∫⁻ x, ‖f (T k x)‖ₑ ^ p ∂μ =
          ∑ k ∈ B, ∫⁻ x, ‖f x‖ₑ ^ p ∂μ := by
        apply Finset.sum_congr rfl
        intro k hk
        exact lintegral_enorm_rpow_comp_measurePreserving (T k) (hT k hk) f hf p
      _ = B.card * ∫⁻ x, ‖f x‖ₑ ^ p ∂μ := by
        rw [Finset.sum_const]
        simp only [nsmul_eq_mul]
  · intro k hk
    exact aemeasurable_enorm_rpow (f ∘ T k)
      (hf.comp_quasiMeasurePreserving (hT k hk).quasiMeasurePreserving) p

theorem eLpNorm_count_sq_eq_finset_sum_rpow
    {κ : Type*} [MeasurableSpace κ] [Countable κ] [MeasurableSingletonClass κ]
    (B : Finset κ) (F : κ → ℝ) (p : ℝ≥0∞)
    (hp0 : p ≠ 0) (hptop : p ≠ ∞) (hpreal : 0 < p.toReal)
    (hF : ∀ k, k ∉ B → F k = 0) :
    eLpNorm F p Measure.count ^ 2 =
      (∑ k ∈ B, ‖F k‖ₑ ^ p.toReal) ^ (2 / p.toReal) := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop]
  rw [← ENNReal.rpow_natCast]
  rw [← ENNReal.rpow_mul]
  have hexp : (1 / p.toReal) * (↑(2 : ℕ) : ℝ) = 2 / p.toReal := by ring
  rw [hexp]
  rw [lintegral_count]
  rw [tsum_eq_sum]
  intro k hk
  rw [hF k hk]
  simp [ENNReal.zero_rpow_of_pos hpreal]

theorem eLpNorm_sq_eq_lintegral_rpow
    {X E : Type*} [MeasurableSpace X] [TopologicalSpace E] [ENorm E]
    (μ : Measure X) (F : X → E) (p : ℝ≥0∞)
    (hp0 : p ≠ 0) (hptop : p ≠ ∞) :
    eLpNorm F p μ ^ 2 =
      (∫⁻ x, ‖F x‖ₑ ^ p.toReal ∂μ) ^ (2 / p.toReal) := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop]
  rw [← ENNReal.rpow_natCast]
  rw [← ENNReal.rpow_mul]
  have hexp : (1 / p.toReal) * (↑(2 : ℕ) : ℝ) = 2 / p.toReal := by ring
  rw [hexp]

theorem prod_rpow_eq_rpow_sum_of_nonneg
    {ι : Type*} (s : Finset ι) (B : ℝ≥0∞) (q : ι → ℝ)
    (hq : ∀ i ∈ s, 0 ≤ q i) :
    ∏ i ∈ s, B ^ q i = B ^ (∑ i ∈ s, q i) := by
  classical
  induction s using Finset.induction with
  | empty => simp
  | insert a s ha ih =>
      rw [Finset.prod_insert ha, Finset.sum_insert ha,
        ih (fun i hi ↦ hq i (Finset.mem_insert_of_mem hi))]
      exact (ENNReal.rpow_add_of_nonneg (q a) (∑ i ∈ s, q i)
        (hq a (Finset.mem_insert_self _ _))
        (Finset.sum_nonneg fun i hi ↦ hq i (Finset.mem_insert_of_mem hi))).symm

theorem prod_mul_rpow_eq_mul_prod_rpow
    {ι : Type*} (s : Finset ι) (B : ℝ≥0∞) (I : ι → ℝ≥0∞)
    (q : ι → ℝ) (hq : ∀ i ∈ s, 0 ≤ q i)
    (hqsum : ∑ i ∈ s, q i = 1) :
    ∏ i ∈ s, (B * I i) ^ q i = B * ∏ i ∈ s, I i ^ q i := by
  calc
    ∏ i ∈ s, (B * I i) ^ q i = ∏ i ∈ s, (B ^ q i * I i ^ q i) := by
      apply Finset.prod_congr rfl
      intro i hi
      rw [ENNReal.mul_rpow_of_nonneg _ _ (hq i hi)]
    _ = (∏ i ∈ s, B ^ q i) * ∏ i ∈ s, I i ^ q i := Finset.prod_mul_distrib
    _ = B * ∏ i ∈ s, I i ^ q i := by
      rw [prod_rpow_eq_rpow_sum_of_nonneg s B q hq, hqsum, ENNReal.rpow_one]

noncomputable def truncOrbit {X κ : Type*} [MeasurableSpace X]
    (B : Finset κ) (T : κ → X → X) (f : X → ℝ) (x : X) : κ → ℝ :=
  (B : Set κ).indicator fun k ↦ f (T k x)

theorem eLpNorm_truncOrbit_sq
    {X κ : Type*} [MeasurableSpace X] [MeasurableSpace κ]
    [Countable κ] [MeasurableSingletonClass κ]
    (B : Finset κ) (T : κ → X → X) (f : X → ℝ) (x : X)
    (p : ℝ≥0∞) (hp0 : p ≠ 0) (hptop : p ≠ ∞)
    (hpreal : 0 < p.toReal) :
    eLpNorm (truncOrbit B T f x) p Measure.count ^ 2 =
      orbitPowerSum B T f p.toReal x ^ (2 / p.toReal) := by
  rw [eLpNorm_count_sq_eq_finset_sum_rpow B (truncOrbit B T f x) p hp0 hptop hpreal]
  · congr 1
    unfold orbitPowerSum truncOrbit
    apply Finset.sum_congr rfl
    intro k hk
    rw [Set.indicator_of_mem (by simpa using hk)]
  · intro k hk
    unfold truncOrbit
    rw [Set.indicator_of_notMem (by simpa using hk)]

theorem holder_truncOrbit_norms
    {X κ : Type*} [MeasurableSpace X] [MeasurableSpace κ]
    [Countable κ] [MeasurableSingletonClass κ] {μ : Measure X}
    {n : ℕ} (B : Finset κ) (T : κ → X → X)
    (hT : ∀ k ∈ B, MeasurePreserving (T k) μ μ)
    (f : Fin n → X → ℝ) (hf : ∀ i, AEStronglyMeasurable (f i) μ)
    (p : Fin n → ℝ≥0∞) (hp0 : ∀ i, p i ≠ 0) (hptop : ∀ i, p i ≠ ∞)
    (hpreal : ∀ i, 0 < (p i).toReal)
    (hqsum : ∑ i, 2 / (p i).toReal = 1) :
    ∫⁻ x, ∏ i, eLpNorm (truncOrbit B T (f i) x) (p i) Measure.count ^ 2 ∂μ ≤
      B.card * ∏ i, eLpNorm (f i) (p i) μ ^ 2 := by
  let q : Fin n → ℝ := fun i ↦ 2 / (p i).toReal
  have hqnonneg : ∀ i, 0 ≤ q i := by
    intro i
    dsimp [q]
    positivity
  have hholder0 :
      ∫⁻ x, ∏ i, orbitPowerSum B T (f i) (p i).toReal x ^ q i ∂μ ≤
        ∏ i, (∫⁻ x, orbitPowerSum B T (f i) (p i).toReal x ∂μ) ^ q i := by
    apply ENNReal.lintegral_prod_norm_pow_le Finset.univ
    · intro i _
      exact aemeasurable_orbitPowerSum B T hT (f i) (hf i) (p i).toReal
    · simpa only [q] using hqsum
    · intro i _
      exact hqnonneg i
  have hholder :
      ∫⁻ x, ∏ i, orbitPowerSum B T (f i) (p i).toReal x ^ q i ∂μ ≤
        ∏ i, (B.card * ∫⁻ x, ‖f i x‖ₑ ^ (p i).toReal ∂μ) ^ q i := by
    calc
      ∫⁻ x, ∏ i, orbitPowerSum B T (f i) (p i).toReal x ^ q i ∂μ ≤
          ∏ i, (∫⁻ x, orbitPowerSum B T (f i) (p i).toReal x ∂μ) ^ q i := hholder0
      _ = ∏ i, (B.card * ∫⁻ x, ‖f i x‖ₑ ^ (p i).toReal ∂μ) ^ q i := by
        apply Finset.prod_congr rfl
        intro i _
        rw [lintegral_orbitPowerSum B T hT (f i) (hf i) (p i).toReal]
  calc
    ∫⁻ x, ∏ i, eLpNorm (truncOrbit B T (f i) x) (p i) Measure.count ^ 2 ∂μ =
        ∫⁻ x, ∏ i, orbitPowerSum B T (f i) (p i).toReal x ^ q i ∂μ := by
      congr with x
      apply Finset.prod_congr rfl
      intro i hi
      exact eLpNorm_truncOrbit_sq B T (f i) x (p i) (hp0 i) (hptop i) (hpreal i)
    _ ≤ ∏ i, (B.card * ∫⁻ x, ‖f i x‖ₑ ^ (p i).toReal ∂μ) ^ q i := hholder
    _ = B.card * ∏ i, eLpNorm (f i) (p i) μ ^ 2 := by
      rw [prod_mul_rpow_eq_mul_prod_rpow Finset.univ B.card
        (fun i ↦ ∫⁻ x, ‖f i x‖ₑ ^ (p i).toReal ∂μ) q
        (fun i _ ↦ hqnonneg i) (by simpa only [q] using hqsum)]
      apply congrArg (fun z : ℝ≥0∞ ↦ (B.card : ℝ≥0∞) * z)
      apply Finset.prod_congr rfl
      intro i hi
      symm
      exact eLpNorm_sq_eq_lintegral_rpow μ (f i) (p i) (hp0 i) (hptop i)

theorem eLpNorm_two_sq_nat {α E : Type*} [MeasurableSpace α]
    [TopologicalSpace E] [ENorm E] (μ : Measure α) (f : α → E) :
    eLpNorm f 2 μ ^ 2 = ∫⁻ x, ‖f x‖ₑ ^ (2 : ℕ) ∂μ := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num)]
  rw [show (2 : ℝ≥0∞).toReal = 2 by norm_num]
  rw [← ENNReal.rpow_natCast]
  rw [← ENNReal.rpow_mul]
  norm_num

theorem lintegral_finite_orbit_sum
    {X κ : Type*} [MeasurableSpace X] (μ : Measure X)
    (B : Finset κ) (T : κ → X → X)
    (hT : ∀ k ∈ B, MeasurePreserving (T k) μ μ)
    {J : ℕ} (d : Fin J → X → ℝ)
    (hd : ∀ j, AEStronglyMeasurable (d j) μ) :
    ∫⁻ x, ∑ j : Fin J, ∑ k ∈ B, ‖d j (T k x)‖ₑ ^ (2 : ℕ) ∂μ =
      B.card * ∑ j : Fin J, ∫⁻ x, ‖d j x‖ₑ ^ (2 : ℕ) ∂μ := by
  have hmeas : ∀ j : Fin J, ∀ k ∈ B,
      AEMeasurable (fun x ↦ ‖d j (T k x)‖ₑ ^ (2 : ℕ)) μ := by
    intro j k hk
    exact (((hd j).comp_quasiMeasurePreserving
      (hT k hk).quasiMeasurePreserving).enorm.pow measurable_const.aemeasurable)
  have hterm : ∀ (j : Fin J) (k : κ), k ∈ B →
      ∫⁻ x, ‖d j (T k x)‖ₑ ^ (2 : ℕ) ∂μ =
        ∫⁻ x, ‖d j x‖ₑ ^ (2 : ℕ) ∂μ := by
    intro j k hk
    rw [← eLpNorm_two_sq_nat]
    change eLpNorm (d j ∘ T k) 2 μ ^ 2 = _
    rw [eLpNorm_comp_measurePreserving (hd j) (hT k hk)]
    exact eLpNorm_two_sq_nat μ (d j)
  rw [lintegral_finsetSum' Finset.univ]
  · calc
      ∑ j, ∫⁻ x, ∑ k ∈ B, ‖d j (T k x)‖ₑ ^ (2 : ℕ) ∂μ =
          ∑ j, ∑ k ∈ B, ∫⁻ x, ‖d j (T k x)‖ₑ ^ (2 : ℕ) ∂μ := by
        apply Finset.sum_congr rfl
        intro j _
        exact lintegral_finsetSum' B (hmeas j)
      _ = ∑ j, ∑ k ∈ B, ∫⁻ x, ‖d j x‖ₑ ^ (2 : ℕ) ∂μ := by
        apply Finset.sum_congr rfl
        intro j _
        apply Finset.sum_congr rfl
        intro k hk
        exact hterm j k hk
      _ = B.card * ∑ j : Fin J, ∫⁻ x, ‖d j x‖ₑ ^ (2 : ℕ) ∂μ := by
        calc
          ∑ j, ∑ k ∈ B, ∫⁻ x, ‖d j x‖ₑ ^ (2 : ℕ) ∂μ =
              ∑ j, B.card • ∫⁻ x, ‖d j x‖ₑ ^ (2 : ℕ) ∂μ := by
            apply Finset.sum_congr rfl
            intro j _
            exact Finset.sum_const _
          _ = B.card * ∑ j : Fin J, ∫⁻ x, ‖d j x‖ₑ ^ (2 : ℕ) ∂μ := by
            simp only [nsmul_eq_mul]
            rw [Finset.mul_sum]
  · intro j _
    simpa only [Finset.sum_fn] using Finset.aemeasurable_sum B (hmeas j)

/--
Converts a pointwise finite-box lower bound into the integrated lower
bound required by the transference assembly step.
-/
theorem finite_box_orbit_lower_bound
    {X κ : Type*} [MeasurableSpace X] {μ : Measure X}
    (B : Finset κ) (T : κ → X → X)
    (hT : ∀ k ∈ B, MeasurePreserving (T k) μ μ)
    {J : ℕ} (d : Fin J → X → ℝ)
    (hd : ∀ j, AEStronglyMeasurable (d j) μ)
    (D : X → ℝ≥0∞)
    (hpoint : ∀ x, ∑ j : Fin J, ∑ k ∈ B,
      ‖d j (T k x)‖ₑ ^ (2 : ℕ) ≤ D x) :
    (B.card : ℝ≥0∞) * ∑ j : Fin J, eLpNorm (d j) 2 μ ^ 2 ≤
      ∫⁻ x, D x ∂μ := by
  calc
    (B.card : ℝ≥0∞) * ∑ j : Fin J, eLpNorm (d j) 2 μ ^ 2 =
        (B.card : ℝ≥0∞) * ∑ j : Fin J,
          ∫⁻ x, ‖d j x‖ₑ ^ (2 : ℕ) ∂μ := by
      apply congrArg (fun z : ℝ≥0∞ ↦ (B.card : ℝ≥0∞) * z)
      apply Finset.sum_congr rfl
      intro j _
      exact eLpNorm_two_sq_nat μ (d j)
    _ = ∫⁻ x, ∑ j : Fin J, ∑ k ∈ B,
        ‖d j (T k x)‖ₑ ^ (2 : ℕ) ∂μ :=
      (lintegral_finite_orbit_sum μ B T hT d hd).symm
    _ ≤ ∫⁻ x, D x ∂μ := lintegral_mono hpoint

/--
Generic finite-box ergodic-to-discrete transfer.  The input `hpoint` is
the local discrete-energy lower bound, `hdiscrete` is the discrete estimate,
and `hright` is the finite-box Hölder estimate for its norm product.
-/
theorem finite_box_ergodic_to_discrete
    {X κ : Type*} [MeasurableSpace X] {μ : Measure X}
    (B B' : Finset κ) (T : κ → X → X)
    (hT : ∀ k ∈ B, MeasurePreserving (T k) μ μ)
    {J : ℕ} (d : Fin J → X → ℝ)
    (hd : ∀ j, AEStronglyMeasurable (d j) μ)
    (A P : ℝ≥0∞) (D Q : X → ℝ≥0∞)
    (hpoint : ∀ x, ∑ j : Fin J, ∑ k ∈ B,
      ‖d j (T k x)‖ₑ ^ (2 : ℕ) ≤ D x)
    (hdiscrete : ∀ x, D x ≤ A * Q x)
    (hQmeas : AEMeasurable Q μ)
    (hright : ∫⁻ x, Q x ∂μ ≤ (B'.card : ℝ≥0∞) * P) :
    (B.card : ℝ≥0∞) * ∑ j : Fin J, eLpNorm (d j) 2 μ ^ 2 ≤
      A * ((B'.card : ℝ≥0∞) * P) := by
  calc
    (B.card : ℝ≥0∞) * ∑ j : Fin J, eLpNorm (d j) 2 μ ^ 2 ≤
        ∫⁻ x, D x ∂μ :=
      finite_box_orbit_lower_bound B T hT d hd D hpoint
    _ ≤ ∫⁻ x, A * Q x ∂μ := lintegral_mono hdiscrete
    _ = A * ∫⁻ x, Q x ∂μ := lintegral_const_mul'' A hQmeas
    _ ≤ A * ((B'.card : ℝ≥0∞) * P) := mul_le_mul_right hright A

/-- The exponent normalization used by the finite-box Hölder estimate. -/
theorem holder_exponents_of_inverse_sum {n : ℕ} (p : Fin n → ℝ≥0∞)
    (hp : ∀ i, 1 < p i ∧ p i < ∞)
    (hsum : (∑ i, ((p i)⁻¹).toReal) = 1 / 2) :
    (∀ i, p i ≠ 0) ∧ (∀ i, p i ≠ ∞) ∧
      (∀ i, 0 < (p i).toReal) ∧
      ∑ i, 2 / (p i).toReal = 1 := by
  have hp0 : ∀ i, p i ≠ 0 := by
    intro i hi
    have := (hp i).1
    simp [hi] at this
  have hptop : ∀ i, p i ≠ ∞ := by
    intro i
    exact ne_of_lt (hp i).2
  refine ⟨hp0, hptop, ?_, ?_⟩
  · intro i
    exact ENNReal.toReal_pos (hp0 i) (hptop i)
  · calc
      ∑ i, 2 / (p i).toReal = 2 * ∑ i, ((p i)⁻¹).toReal := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro i _
        rw [ENNReal.toReal_inv]
        ring
      _ = 1 := by rw [hsum]; norm_num

/--
Measurability of the discrete norm product for finite orbit truncations.
The pointwise norm formula is the same one used in the finite-box Hölder
estimate.
-/
theorem aemeasurable_truncOrbit_normProduct
    {X κ : Type*} [MeasurableSpace X] [MeasurableSpace κ]
    [Countable κ] [MeasurableSingletonClass κ] {μ : Measure X}
    {n : ℕ} (B : Finset κ) (T : κ → X → X)
    (hT : ∀ k ∈ B, MeasurePreserving (T k) μ μ)
    (f : Fin n → X → ℝ) (hf : ∀ i, AEStronglyMeasurable (f i) μ)
    (p : Fin n → ℝ≥0∞) (hp0 : ∀ i, p i ≠ 0) (hptop : ∀ i, p i ≠ ∞)
    (hpreal : ∀ i, 0 < (p i).toReal) :
    AEMeasurable (fun x ↦
      ∏ i, eLpNorm (truncOrbit B T (f i) x) (p i) Measure.count ^ 2) μ := by
  simpa only [Finset.prod_fn] using Finset.aemeasurable_prod Finset.univ
    (fun i _ ↦ by
      let q : ℝ := 2 / (p i).toReal
      have heq : (fun x ↦ eLpNorm (truncOrbit B T (f i) x) (p i)
          Measure.count ^ 2) =
          fun x ↦ orbitPowerSum B T (f i) (p i).toReal x ^ q := by
        funext x
        dsimp [q]
        exact eLpNorm_truncOrbit_sq B T (f i) x (p i) (hp0 i) (hptop i) (hpreal i)
      rw [heq]
      exact ENNReal.continuous_rpow_const.aemeasurable.comp_aemeasurable
        (aemeasurable_orbitPowerSum B T hT (f i) (hf i) (p i).toReal))

/--
The last member of a strictly increasing finite scale tuple bounds all
of its scales.
-/
theorem scale_le_last {J : ℕ} (N : Fin (J + 1) → ℕ)
    (hN : StrictMono N) (q : Fin (J + 1)) :
    N q ≤ N (Fin.last J) :=
  hN.monotone (Fin.le_last q)

/--
Most local finite-box form of the ergodic-to-discrete reduction.  The
input is only the finite inner-box sum of discrete jumps; no global discrete
jump energy and no finite-support theorem for that energy are used.
-/
theorem finite_box_bound_of_finite_sum_cancelled
    {X : Type*} [MeasurableSpace X] {μ : Measure X} {n J M : ℕ}
    (hM : 0 < M)
    (T : (Fin n → ℕ) → X → X)
    (hT : ∀ k ∈ box n (M + M),
      MeasurePreserving (T k) μ μ)
    (p : Fin n → ℝ≥0∞) (N : Fin (J + 1) → ℕ)
    (f : Fin n → X → ℝ) (hf : ∀ i, MemLp (f i) (p i) μ)
    (hp0 : ∀ i, p i ≠ 0) (hptop : ∀ i, p i ≠ ∞)
    (hpreal : ∀ i, 0 < (p i).toReal)
    (hqsum : ∑ i, 2 / (p i).toReal = 1)
    (a : Fin (J + 1) → X → ℝ) (d : Fin J → X → ℝ)
    (hd : ∀ j, AEStronglyMeasurable (d j) μ)
    (hjump : ∀ j x, d j x = a j.succ x - a j.castSucc x)
    (A : ℝ≥0∞)
    (hlocal : ∀ x, ∑ j : Fin J, ∑ k ∈ box n M,
      ‖aux_discreteAverage (N j.succ)
          (fun i ↦ truncOrbit (box n (M + M)) T (f i) x) k -
        aux_discreteAverage (N j.castSucc)
          (fun i ↦ truncOrbit (box n (M + M)) T (f i) x) k‖ₑ
        ^ (2 : ℕ) ≤
        A * ∏ i, eLpNorm
          (truncOrbit (box n (M + M)) T (f i) x)
            (p i) Measure.count ^ 2)
    (haverage : ∀ (x : X) (k : Fin n → ℕ) (q : Fin (J + 1)),
      k ∈ box n M →
      aux_discreteAverage (N q)
          (fun i ↦ truncOrbit (box n (M + M)) T (f i) x) k =
        a q (T k x)) :
    ∑ j, eLpNorm (d j) 2 μ ^ 2 ≤
      A * ((2 ^ n : ℕ) : ℝ≥0∞) * ∏ i, eLpNorm (f i) (p i) μ ^ 2 := by
  let B : Finset (Fin n → ℕ) := box n M
  let B' : Finset (Fin n → ℕ) := box n (M + M)
  let F : X → Fin n → (Fin n → ℕ) → ℝ :=
    fun x i ↦ truncOrbit B' T (f i) x
  let Q : X → ℝ≥0∞ := fun x ↦
    ∏ i, eLpNorm (F x i) (p i) Measure.count ^ 2
  have hTinner : ∀ k ∈ B, MeasurePreserving (T k) μ μ := by
    intro k hk
    exact hT k (by simpa only [B, B'] using box_subset_double n M hk)
  have hQmeas : AEMeasurable Q μ := by
    dsimp only [Q]
    simpa only [F, B'] using aemeasurable_truncOrbit_normProduct B' T hT f
      (fun i ↦ (hf i).aestronglyMeasurable) p hp0 hptop hpreal
  have hright : ∫⁻ x, Q x ∂μ ≤
      (B'.card : ℝ≥0∞) * ∏ i, eLpNorm (f i) (p i) μ ^ 2 := by
    dsimp only [Q]
    simpa only [F, B'] using holder_truncOrbit_norms B' T hT f
      (fun i ↦ (hf i).aestronglyMeasurable) p hp0 hptop hpreal hqsum
  have hpoint : ∀ x, ∑ j : Fin J, ∑ k ∈ B,
      ‖d j (T k x)‖ₑ ^ (2 : ℕ) ≤ A * Q x := by
    intro x
    calc
      ∑ j : Fin J, ∑ k ∈ B, ‖d j (T k x)‖ₑ ^ (2 : ℕ) =
          ∑ j : Fin J, ∑ k ∈ B,
            ‖aux_discreteAverage (N j.succ) (F x) k -
              aux_discreteAverage (N j.castSucc) (F x) k‖ₑ ^ (2 : ℕ) := by
        apply Finset.sum_congr rfl
        intro j _
        apply Finset.sum_congr rfl
        intro k hk
        rw [hjump, haverage x k j.succ (by simpa only [B] using hk),
          haverage x k j.castSucc (by simpa only [B] using hk)]
      _ ≤ A * Q x := by
        simpa only [B, B', F, Q] using hlocal x
  have hbox := finite_box_ergodic_to_discrete B B' T hTinner d hd A
    (∏ i, eLpNorm (f i) (p i) μ ^ 2) (fun x ↦ A * Q x) Q hpoint
    (fun _ ↦ le_rfl) hQmeas hright
  have hcancel := cancel_box_ratio hM (by
    simpa only [B, B', mul_assoc] using hbox)
  simpa only [B] using hcancel


/-! ### Concrete finite-inner-sum ergodic reduction -/

theorem add_coordinate_mem_box {n L M : ℕ} (k : Fin n → ℕ)
    (hk : k ∈ box n L) (i : Fin n) (m : ℕ) (hm : m < M) :
    k + aux_coordinate i m ∈ box n (L + M) := by
  rw [mem_box]
  intro j
  by_cases hji : j = i
  · subst j
    have hki : k i < L := (mem_box k).mp hk i
    simp [Pi.add_apply, aux_coordinate]
    omega
  · simp [Pi.add_apply, aux_coordinate, hji]
    have hkj : k j < L := (mem_box k).mp hk j
    omega

theorem discreteAverage_truncated_orbit_eq {X : Type*}
    [MeasurableSpace X] {μ : Measure X} {n L M N : ℕ}
    (S : ErgodicSystem X μ n) (f : Fin n → X → ℝ) (x : X)
    (k : Fin n → ℕ) (hk : k ∈ box n L) (hN : N ≤ M) :
    aux_discreteAverage N
      (fun i ↦ truncOrbit
        (box n (L + M)) (aux_orbit S.transformation) (f i) x) k =
      aux_discreteAverage N (aux_orbitFunction S f x) k := by
  unfold aux_discreteAverage
  change (N : ℝ)⁻¹ * ∑ m ∈ Finset.range N,
    ∏ i, truncOrbit
      (box n (L + M)) (aux_orbit S.transformation) (f i) x
      (k + aux_coordinate i m) =
      (N : ℝ)⁻¹ * ∑ m ∈ Finset.range N,
        ∏ i, aux_orbitFunction S f x i (k + aux_coordinate i m)
  apply congrArg (fun z : ℝ ↦ (N : ℝ)⁻¹ * z)
  apply Finset.sum_congr rfl
  intro m hm
  apply Finset.prod_congr rfl
  intro i hi
  rw [truncOrbit, Set.indicator_of_mem]
  · rfl
  · apply add_coordinate_mem_box k hk i m
    exact Finset.mem_range.mp hm |>.trans_le hN

theorem realErgodicAverage_aestronglyMeasurable {X : Type*}
    [MeasurableSpace X] {μ : Measure X} {n : ℕ}
    (S : ErgodicSystem X μ n) (N : ℕ) (f : Fin n → X → ℝ)
    (hf : ∀ i, AEStronglyMeasurable (f i) μ) :
    AEStronglyMeasurable (realErgodicAverage S N f) μ := by
  unfold realErgodicAverage
  change AEStronglyMeasurable ((N : ℝ)⁻¹ • fun x ↦
    ∑ m ∈ Finset.range N, ∏ i, f i ((S.transformation i)^[m] x)) μ
  apply (Finset.aestronglyMeasurable_fun_sum (Finset.range N) ?_).const_smul
  intro m _
  apply Finset.aestronglyMeasurable_fun_prod Finset.univ
  intro i _
  change AEStronglyMeasurable (f i ∘ (S.transformation i)^[m]) μ
  exact (hf i).comp_quasiMeasurePreserving
    ((S.measurePreserving i).iterate m).quasiMeasurePreserving

theorem realErgodicAverage_sub_aestronglyMeasurable {X : Type*}
    [MeasurableSpace X] {μ : Measure X} {n : ℕ}
    (S : ErgodicSystem X μ n) (N M : ℕ) (f : Fin n → X → ℝ)
    (hf : ∀ i, AEStronglyMeasurable (f i) μ) :
    AEStronglyMeasurable (fun x ↦ realErgodicAverage S N f x -
      realErgodicAverage S M f x) μ := by
  exact (realErgodicAverage_aestronglyMeasurable S N f hf).sub
    (realErgodicAverage_aestronglyMeasurable S M f hf)

theorem realErgodicJumpEnergy_of_finite_sum
    {X : Type*} [MeasurableSpace X] {μ : Measure X} {n J : ℕ}
    (p : Fin n → ℝ≥0∞)
    (hp : ∀ i, 1 < p i ∧ p i < ∞)
    (hsum : (∑ i, ((p i)⁻¹).toReal) = 1 / 2)
    (S : ErgodicSystem X μ n) (N : Fin (J + 1) → ℕ)
    (hN : StrictMono N) (hNpos : ∀ j, 0 < N j)
    (f : Fin n → X → ℝ) (hf : ∀ i, MemLp (f i) (p i) μ)
    (A : ℝ≥0∞)
    (hlocal : ∀ x, ∑ j : Fin J,
      ∑ k ∈ box n (N (Fin.last J)),
        ‖aux_discreteAverage (N j.succ)
            (fun i ↦ truncOrbit
              (box n (N (Fin.last J) + N (Fin.last J)))
              (aux_orbit S.transformation) (f i) x) k -
          aux_discreteAverage (N j.castSucc)
            (fun i ↦ truncOrbit
              (box n (N (Fin.last J) + N (Fin.last J)))
              (aux_orbit S.transformation) (f i) x) k‖ₑ ^ (2 : ℝ) ≤
        A * ∏ i, eLpNorm
          (truncOrbit
            (box n (N (Fin.last J) + N (Fin.last J)))
            (aux_orbit S.transformation) (f i) x)
          (p i) Measure.count ^ 2) :
    realErgodicJumpEnergy S N f ≤
      A * ((2 ^ n : ℕ) : ℝ≥0∞) * ∏ i, eLpNorm (f i) (p i) μ ^ 2 := by
  rcases holder_exponents_of_inverse_sum p hp hsum with
    ⟨hp0, hptop, hpreal, hqsum⟩
  let M : ℕ := N (Fin.last J)
  have hM : 0 < M := by
    dsimp [M]
    exact hNpos (Fin.last J)
  let a : Fin (J + 1) → X → ℝ := fun q ↦ realErgodicAverage S (N q) f
  let d : Fin J → X → ℝ := fun j x ↦ a j.succ x - a j.castSucc x
  have hd : ∀ j, AEStronglyMeasurable (d j) μ := by
    intro j
    dsimp [d, a]
    exact realErgodicAverage_sub_aestronglyMeasurable S
      (N j.succ) (N j.castSucc) f (fun i ↦ (hf i).aestronglyMeasurable)
  have hjump : ∀ j x, d j x = a j.succ x - a j.castSucc x := by
    intro j x
    rfl
  have haverage : ∀ (x : X) (k : Fin n → ℕ) (q : Fin (J + 1)),
      k ∈ box n M →
      aux_discreteAverage (N q)
          (fun i ↦ truncOrbit
            (box n (M + M)) (aux_orbit S.transformation) (f i) x) k =
        a q (aux_orbit S.transformation k x) := by
    intro x k q hk
    calc
      aux_discreteAverage (N q)
          (fun i ↦ truncOrbit
            (box n (M + M)) (aux_orbit S.transformation) (f i) x) k =
          aux_discreteAverage (N q) (aux_orbitFunction S f x) k :=
        discreteAverage_truncated_orbit_eq S f x k hk (scale_le_last N hN q)
      _ = realErgodicAverage S (N q) f (aux_orbit S.transformation k x) :=
        aux_discreteAverage_orbitFunction S f x k (N q)
      _ = a q (aux_orbit S.transformation k x) := rfl
  have hbox := finite_box_bound_of_finite_sum_cancelled
    hM (aux_orbit S.transformation)
    (fun k _ ↦ aux_orbit_measurePreserving
      S.transformation k S.measurePreserving)
    p N f hf hp0 hptop hpreal hqsum a d hd hjump A (by
      intro x
      simpa only [M, ENNReal.rpow_two] using hlocal x) haverage
  unfold realErgodicJumpEnergy
  change ∑ j, eLpNorm (d j) 2 μ ^ 2 ≤
    A * ((2 ^ n : ℕ) : ℝ≥0∞) * ∏ i, eLpNorm (f i) (p i) μ ^ 2
  exact hbox

end aux_ErgodicBox

theorem aux_ofReal_two_pow_mul (n : ℕ) (C : ℝ) :
    ENNReal.ofReal ((2 : ℝ) ^ n * C) =
      ((2 ^ n : ℕ) : ℝ≥0∞) * ENNReal.ofReal C := by
  rw [ENNReal.ofReal_mul (pow_nonneg (by norm_num) _)]
  rw [ENNReal.ofReal_pow (by norm_num)]
  norm_num

/--
The fully internal combination of the finite cuboid reduction and the
finite-box orbit reduction.
-/
theorem aux_realErgodicJumpBound_of_realVariable {n : ℕ}
    (hn : 0 < n) (p : Fin n → ℝ≥0∞) (C : ℝ) (g : ℕ → ℝ)
    (hp : ∀ i, 1 < p i ∧ p i < ∞)
    (hsum : (∑ i, ((p i)⁻¹).toReal) = 1 / 2)
    (hreal : realVariableJumpBound p C g) :
    realErgodicJumpBound.{u} p
      ((2 : ℝ) ^ n * ((2 : ℝ) ^ (3 * n + 6) * C)) g := by
  intro X _ μ S J hJ N hN hNpos f hf
  rcases aux_ErgodicBox.holder_exponents_of_inverse_sum p hp hsum with
    ⟨hp0, hptop, _hpreal, _hqsum⟩
  let Cd : ℝ := (2 : ℝ) ^ (3 * n + 6) * C
  have hbox := aux_ErgodicBox.realErgodicJumpEnergy_of_finite_sum
    p hp hsum S N hN hNpos f hf
    (ENNReal.ofReal Cd * ENNReal.ofReal (g J)) (by
      intro x
      exact aux_finite_forward_jump_bound_of_realVariable hn p C g hreal hJ
        N hN hNpos
        (fun i ↦ aux_ErgodicBox.truncOrbit
          (aux_ErgodicBox.box n
            (N (Fin.last J) + N (Fin.last J)))
          (aux_orbit S.transformation) (f i) x)
        (aux_ErgodicBox.box n (N (Fin.last J))) hp0 hptop)
  have hconstant :
      ENNReal.ofReal ((2 : ℝ) ^ n * Cd) =
        ((2 ^ n : ℕ) : ℝ≥0∞) * ENNReal.ofReal Cd :=
    aux_ofReal_two_pow_mul n Cd
  change realErgodicJumpEnergy S N f ≤
    ENNReal.ofReal ((2 : ℝ) ^ n * Cd) * ENNReal.ofReal (g J) *
      ∏ i, eLpNorm (f i) (p i) μ ^ 2
  rw [hconstant]
  simpa only [mul_assoc, mul_left_comm, mul_comm] using hbox

/-- The explicit factor in the Calderón transference bound. -/
def calderonTransferenceConstant (n : ℕ) : ℝ :=
  (2 : ℝ) ^ (4 * n + 6)

/--
Calderón transference for the multilinear averages defined in this
Mathlib-only module.  The explicit transference factor is
`calderonTransferenceConstant n = 2 ^ (4 * n + 6)`; thus an input constant
`C` is transferred with constant `C * calderonTransferenceConstant n`.
-/
theorem ct_calderon_transference_external {n : ℕ} (hn : 2 ≤ n)
    (p : Fin n → ℝ≥0∞) (hp : ∀ i, 1 < p i ∧ p i < ∞)
    (hsum : (∑ i, ((p i)⁻¹).toReal) = 1 / 2) (C : ℝ) (_hC : 0 < C) :
    0 < calderonTransferenceConstant n ∧ ∀ g : ℕ → ℝ,
      (∀ J, 0 < J → 1 ≤ g J) →
      realVariableJumpBound p C g →
        realErgodicJumpBound.{u} p (calderonTransferenceConstant n * C) g := by
  refine ⟨by dsimp [calderonTransferenceConstant]; positivity, ?_⟩
  intro g _hg hreal
  have h := aux_realErgodicJumpBound_of_realVariable (by omega) p C g hp hsum hreal
  have hconstant : calderonTransferenceConstant n * C =
      (2 : ℝ) ^ n * ((2 : ℝ) ^ (3 * n + 6) * C) := by
    dsimp [calderonTransferenceConstant]
    calc
      (2 : ℝ) ^ (4 * n + 6) * C =
          (2 : ℝ) ^ (n + (3 * n + 6)) * C := by
            congr 1
            ring
      _ = ((2 : ℝ) ^ n * (2 : ℝ) ^ (3 * n + 6)) * C := by
            rw [pow_add]
      _ = (2 : ℝ) ^ n * ((2 : ℝ) ^ (3 * n + 6) * C) := by ring
  rw [hconstant]
  exact h

end

