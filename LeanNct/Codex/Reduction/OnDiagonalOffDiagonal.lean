theorem reduction_scale_conditions (D : ReductionData) (h : ℕ) (j : ℤ) :
    0 < rhoLowerScale D.a h j ∧ 0 < rhoUpperScale D.a h j ∧
      2 * ((2 : ℝ) ^ h * D.a (j - 1)) ≤ 2 * rhoLowerScale D.a h j ∧
      2 * rhoLowerScale D.a h j ≤ rhoUpperScale D.a h j ∧
      rhoUpperScale D.a h j ≤ (2 : ℝ) ^ h * D.a j := by
  have hprev : 0 < D.a (j - 1) := (D.a_spaced (j - 1)).1
  have hj : 0 < D.a j := (D.a_spaced j).1
  have hstep : 2 * D.a (j - 1) ≤ D.a j := by
    convert (D.a_spaced (j - 1)).2 using 1; ring_nf
  cases h with
  | zero =>
      have hraw :
          0 < D.a (j - 1) ∧ 0 < D.a j ∧
            2 * D.a (j - 1) ≤ 2 * D.a (j - 1) ∧
            2 * D.a (j - 1) ≤ D.a j ∧ D.a j ≤ D.a j :=
        ⟨hprev, hj, le_rfl, hstep, le_rfl⟩
      simpa [rhoLowerScale, rhoUpperScale] using hraw
  | succ h =>
      have hpow : (2 : ℝ) ^ Nat.succ h = 2 * (2 : ℝ) ^ h := by
        rw [pow_succ]
        ring
      simp only [rhoLowerScale, rhoUpperScale, if_neg (Nat.succ_ne_zero _),
        Nat.succ_sub_one]
      refine ⟨mul_pos (pow_pos (by norm_num) _) hj,
        mul_pos (pow_pos (by norm_num) _) hj, ?_, ?_, le_rfl⟩
      · calc
          2 * ((2 : ℝ) ^ Nat.succ h * D.a (j - 1)) =
              (2 : ℝ) ^ Nat.succ h * (2 * D.a (j - 1)) := by ring
          _ ≤ (2 : ℝ) ^ Nat.succ h * D.a j :=
            mul_le_mul_of_nonneg_left hstep (by positivity)
          _ = 2 * ((2 : ℝ) ^ h * D.a j) := by rw [hpow]; ring
      · rw [hpow]
        apply le_of_eq
        ring

