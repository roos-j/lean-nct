      (smul_mem_A D.a_spaced (by positivity)) j
  funext v
  unfold aux_diagonalBandKernel aux_diagonalConvolution reductionNKernel
  rw [aux_diagonalConvolution_assoc (D.kernel j) (rhoKernel n D.a h j)
    (reductionSigma D h j) (D.kernel_memW0 j) hrho hsigma v]
  rw [reduction_rho_sigma_reconstruct hn D h j]

theorem diagonalBand_factorization_endpoint
    (D : ReductionData) (h : ℕ) (j : ℤ) :
    aux_diagonalBandKernel D.kernel D.a h j =
      fun v => ∫ p : ℝ,
        reductionNKernel 2 D h j (v.1 - p, v.2 - p) *
          realConvolution (reductionSigma D h j) (reductionSigma D h j) p := by
  have hrho : MemW0 (rhoKernel 2 D.a h j) :=
    (rhoKernelsReduction (by omega) D.a D.a_spaced h j).1
  have hsigma : MemW0 (reductionSigma D h j) := by
    simpa [reductionSigma] using squareRootGaussianDifference_memW0
      (smul_mem_A D.a_spaced (by positivity)) j
  have hsigmaSq : MemW0 (realConvolution (reductionSigma D h j)
      (reductionSigma D h j)) :=
    aux_realConvolution_memW0 _ _ hsigma hsigma
  funext v
  unfold aux_diagonalBandKernel aux_diagonalConvolution reductionNKernel
  rw [aux_diagonalConvolution_assoc (D.kernel j) (rhoKernel 2 D.a h j)
    (realConvolution (reductionSigma D h j) (reductionSigma D h j))
    (D.kernel_memW0 j) hrho hsigmaSq v]
  rw [reduction_rho_sigmaSq_reconstruct D h j]

noncomputable def liftPlaneEquiv :
    (RealVector 1 × RealVector 1) ≃L[ℝ] RealPlane :=
  (ContinuousLinearEquiv.piUnique ℝ (fun _ : Fin 1 => ℝ)).prodCongr
    (ContinuousLinearEquiv.piUnique ℝ (fun _ : Fin 1 => ℝ))

theorem liftPlaneEquiv_measurePreserving :
    MeasurePreserving liftPlaneEquiv volume volume := by
  change MeasurePreserving
    (Prod.map (MeasurableEquiv.piUnique (fun _ : Fin 1 => ℝ))
      (MeasurableEquiv.piUnique (fun _ : Fin 1 => ℝ))) volume volume
  simpa only [Measure.volume_eq_prod] using
    (volume_preserving_piUnique (fun _ : Fin 1 => ℝ)).prod
      (volume_preserving_piUnique (fun _ : Fin 1 => ℝ))

theorem eLpNorm_liftPlaneKernel (M : RealPlane → ℝ) (hM : MemW0 M) :
    eLpNorm (aux_liftPlaneKernel M) 1 volume = eLpNorm M 1 volume := by
  change eLpNorm (M ∘ liftPlaneEquiv) 1 volume = eLpNorm M 1 volume
  exact eLpNorm_comp_measurePreserving hM.1.aestronglyMeasurable
    liftPlaneEquiv_measurePreserving

theorem rho_cmean_nonneg (N : ℕ) :
    0 ≤ C_meanFourScaleGaussianKernel N := by
  unfold C_meanFourScaleGaussianKernel
  apply add_nonneg
  · apply mul_nonneg
    · apply mul_nonneg
      · norm_num
      · unfold C_meanValueBumpEstimate
        positivity
    · exact (aux_C_gaussianBumpEstimate_nonneg 0).trans
        (aux_le_maxUpTo C_gaussianBumpEstimate (Nat.zero_le _))
  · apply mul_nonneg
    · apply mul_nonneg
      · norm_num
      · unfold C_meanValueBumpEstimate
        positivity
    · have hzero : 0 ≤ (2 : ℝ) ^ 0 * C_secondGaussianEstimate 0 := by
        simpa using aux_C_secondGaussianEstimate_nonneg 0
      exact hzero.trans
        (aux_le_maxUpTo (fun l => (2 : ℝ) ^ l * C_secondGaussianEstimate l)
          (Nat.zero_le _))

theorem rho_cfour_nonneg (N : ℕ) :
    0 ≤ C_fourScaleGaussianKernel N := by
  unfold C_fourScaleGaussianKernel C_smoothDecay2
  apply add_nonneg
  · apply mul_nonneg
    · apply mul_nonneg <;> positivity
    · exact (aux_C_gaussianBumpEstimate_nonneg 0).trans (le_max_left _ _)
  · apply mul_nonneg
    · positivity
    · exact (aux_C_secondGaussianEstimate_nonneg 0).trans (le_max_left _ _)

theorem CrhoReduction_nonneg : 0 ≤ C_rhoKernelsReduction := by
  unfold C_rhoKernelsReduction
  exact mul_nonneg (by positivity)
    (add_nonneg (rho_cmean_nonneg 2) (rho_cfour_nonneg 2))

theorem CnReduction_nonneg : 0 ≤ C_nReduction := by
  unfold C_nReduction
  exact mul_nonneg (by positivity) CrhoReduction_nonneg

theorem CincreaseDataGaussianExpansion_nonneg :
    0 ≤ C_increaseDataGaussianExpansion := by
  unfold C_increaseDataGaussianExpansion C_increaseDataBracketDomination
  exact mul_nonneg (mul_nonneg (by positivity) (sq_nonneg _))
    (mul_nonneg (by positivity) CrhoReduction_nonneg)

theorem CincreaseDataReduction_nonneg : 0 ≤ C_increaseDataReduction := by
  unfold C_increaseDataReduction
  exact mul_nonneg (mul_nonneg (mul_nonneg (by positivity)
    aux_C_inductPositiveTermsTheorem_pos.le) CincreaseDataGaussianExpansion_nonneg)
    (by positivity)

/-- The reduction increase-data constant is nonnegative.  This public form is
used when reduction constants are assembled in the final argument. -/
theorem aux_CincreaseDataReduction_nonneg : 0 ≤ C_increaseDataReduction :=
  CincreaseDataReduction_nonneg

theorem liftPlaneKernel_memW0 (M : RealPlane → ℝ) (hM : MemW0 M) :
    MemW0 (aux_liftPlaneKernel M) := by
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector 1 × RealVector 1)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure (volume : Measure RealPlane) :=
    Measure.prod.instIsAddHaarMeasure _ _
  have hcomp : MemW0 (M ∘ liftPlaneEquiv) :=
    aux_memW0_comp_continuousLinearEquiv hM liftPlaneEquiv
  convert hcomp using 1
  funext x
  rfl

theorem lift_reductionN_memW0 {n : ℕ} (hn : 2 ≤ n)
    (D : ReductionData) (h : ℕ) (j : ℤ) :
    MemW0 (aux_liftPlaneKernel (reductionNKernel n D h j)) :=
  liftPlaneKernel_memW0 _ (nReduction hn D h j).1

theorem eLpNorm_lift_reductionN_toReal_le {n : ℕ} (hn : 2 ≤ n)
    (D : ReductionData) (h : ℕ) (j : ℤ) :
    (eLpNorm (aux_liftPlaneKernel (reductionNKernel n D h j)) 1 volume).toReal ≤
      C_nReduction := by
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector 1 × RealVector 1)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  have hbound :
      eLpNorm (aux_liftPlaneKernel (reductionNKernel n D h j)) 1 volume ≤
        ENNReal.ofReal C_nReduction := by
    rw [eLpNorm_liftPlaneKernel _ (nReduction hn D h j).1]
    exact (nReduction hn D h j).2
  calc
    (eLpNorm (aux_liftPlaneKernel (reductionNKernel n D h j)) 1 volume).toReal ≤
        (ENNReal.ofReal C_nReduction).toReal :=
      ENNReal.toReal_mono ENNReal.ofReal_ne_top hbound
    _ = C_nReduction := ENNReal.toReal_ofReal CnReduction_nonneg

theorem sum_eLpNorm_lift_reductionN_toReal_le {n : ℕ} (hn : 2 ≤ n)
    (D : ReductionData) (h : ℕ) (J : ℕ) :
    (∑ l : Fin J,
      (eLpNorm (aux_liftPlaneKernel (reductionNKernel n D h (l : ℤ))) 1 volume).toReal) ≤
        C_nReduction * J := by
  calc
    (∑ l : Fin J,
      (eLpNorm (aux_liftPlaneKernel (reductionNKernel n D h (l : ℤ))) 1 volume).toReal) ≤
        ∑ _ : Fin J, C_nReduction := by
      exact Finset.sum_le_sum fun l _ =>
        eLpNorm_lift_reductionN_toReal_le hn D h (l : ℤ)
    _ = C_nReduction * J := by simp [mul_comm]

theorem cauchySchwarzLift_reduction_eq {n : ℕ} (D : ReductionData)
    (h : ℕ) (J : ℕ) :
    (fun y => ∑ j ∈ Finset.range J,
      reductionMajorantKernel n D h (j : ℤ) y) =
      cauchySchwarzLift
        (fun l : Fin J => aux_liftPlaneKernel (reductionNKernel n D h (l.1 : ℤ)))
        (fun l : Fin J => reductionSigma D h (l.1 : ℤ)) := by
  funext y
  unfold cauchySchwarzLift reductionMajorantKernel aux_liftPlaneKernel tensorSquare
  rw [Finset.sum_fin_eq_sum_range]
  apply Finset.sum_congr rfl
  intro l hl
  simp [Finset.mem_range.mp hl]
  ring

theorem cauchySchwarzKernel_diagonalBand_eq {n : ℕ} (hn : 2 < n)
    (D : ReductionData) (h : ℕ) (J : ℕ) :
    (fun y => ∑ j ∈ Finset.range J, aux_diagonalBandSequence D h (j : ℤ) y) =
      cauchySchwarzKernel
        (fun l : Fin J => aux_liftPlaneKernel (reductionNKernel n D h (l.1 : ℤ)))
        (fun l : Fin J => reductionSigma D h (l.1 : ℤ)) (0 : Fin 1) := by
  funext y
  unfold cauchySchwarzKernel
  rw [Finset.sum_fin_eq_sum_range]
  apply Finset.sum_congr rfl
  intro l hl
  rw [show aux_diagonalBandSequence D h (l : ℤ) =
      aux_liftPlaneKernel (aux_diagonalBandKernel D.kernel D.a h (l : ℤ)) by rfl]
  rw [diagonalBand_factorization_interior hn D h (l : ℤ)]
  simp [diagonalConvolution, aux_liftPlaneKernel, aux_diagonalShift,
    Finset.mem_range.mp hl]

theorem doublyCauchySchwarzKernel_diagonalBand_eq
    (D : ReductionData) (h : ℕ) (J : ℕ) :
    (fun y => ∑ j ∈ Finset.range J, aux_diagonalBandSequence D h (j : ℤ) y) =
      doublyCauchySchwarzKernel
        (fun l : Fin J => aux_liftPlaneKernel (reductionNKernel 2 D h (l.1 : ℤ)))
        (fun l : Fin J => reductionSigma D h (l.1 : ℤ)) (0 : Fin 1) := by
  funext y
  unfold doublyCauchySchwarzKernel
  rw [Finset.sum_fin_eq_sum_range]
  apply Finset.sum_congr rfl
  intro l hl
  rw [show aux_diagonalBandSequence D h (l : ℤ) =
      aux_liftPlaneKernel (aux_diagonalBandKernel D.kernel D.a h (l : ℤ)) by rfl]
  rw [diagonalBand_factorization_endpoint D h (l : ℤ)]
  simp [diagonalConvolution, aux_liftPlaneKernel, aux_diagonalShift,
    Finset.mem_range.mp hl]

theorem seminorm_diagonalBand_interior_raw {n : ℕ} (hn : 2 < n)
    (D : ReductionData) (h : ℕ) :
    kernelSequenceSeminorm n 1 (by omega) (by omega)
      (aux_diagonalBandSequence D h) ≤
      ENNReal.ofReal (Real.sqrt C_nReduction *
        Real.sqrt (C_increaseDataReduction * Real.rpow 2 (-(h : ℝ) / 4))) := by
  let T : KernelSequence 2 := fun j => reductionMajorantKernel n D h j
  refine aux_kernelSequenceSeminorm_one_le_of_cauchySchwarz (n := n) hn
    (aux_diagonalBandSequence D h) T
    (C := C_nReduction)
    (U := C_increaseDataReduction * Real.rpow 2 (-(h : ℝ) / 4))
    CnReduction_nonneg ?_ ?_ ?_
  · exact mul_nonneg CincreaseDataReduction_nonneg (Real.rpow_nonneg (by norm_num) _)
  · simpa [T] using increaseDataReduction (show 2 ≤ n by omega) D h
  · intro J F
    let rho : Fin J.1 → MKernel 1 := fun l =>
      aux_liftPlaneKernel (reductionNKernel n D h (l.1 : ℤ))
    let phi : Fin J.1 → ℝ → ℝ := fun l => reductionSigma D h (l.1 : ℤ)
    have hrho (l : Fin J.1) : MemW0 (rho l) := by
      dsimp [rho]
      exact lift_reductionN_memW0 (show 2 ≤ n by omega) D h (l.1 : ℤ)
    have hphi (l : Fin J.1) : MemW0 (phi l) := by
      dsimp [phi, reductionSigma]
      exact squareRootGaussianDifference_memW0
        (smul_mem_A D.a_spaced (by positivity)) (l.1 : ℤ)
    have hkernel :
        (fun y => ∑ j ∈ Finset.range J.1, aux_diagonalBandSequence D h (j : ℤ) y) =
          cauchySchwarzKernel rho phi (0 : Fin 1) := by
      simpa [rho, phi] using cauchySchwarzKernel_diagonalBand_eq hn D h J.1
    have hlift :
        (fun y => ∑ j ∈ Finset.range J.1, T (j : ℤ) y) =
          cauchySchwarzLift rho phi := by
      simpa [T, rho, phi] using cauchySchwarzLift_reduction_eq (n := n) D h J.1
    have hmass : (∑ l : Fin J.1, (eLpNorm (rho l) 1 volume).toReal) ≤
        C_nReduction * (J.1 : ℝ) := by
      simpa [rho] using sum_eLpNorm_lift_reductionN_toReal_le
        (show 2 ≤ n by omega) D h J.1
    have hCS := cauchySchwarzAtK_bound n 1 J.1 (by omega) (by omega) (by omega)
      rho phi hrho hphi (0 : Fin 1) F.1 F.2
    calc
      |prismForm n 1 (by omega) (by omega)
          (fun y => ∑ j ∈ Finset.range J.1, aux_diagonalBandSequence D h (j : ℤ) y)
          (fun r => F.1 r)| =
          |prismForm n 1 (by omega) (by omega)
            (cauchySchwarzKernel rho phi (0 : Fin 1)) (fun r => F.1 r)| := by
            rw [hkernel]
      _ ≤ Real.sqrt |prismForm n 2 (by omega) (by omega)
          (cauchySchwarzLift rho phi) (fun r => F.1 r)| *
          Real.sqrt (∑ l : Fin J.1, (eLpNorm (rho l) 1 volume).toReal) := hCS
      _ ≤ Real.sqrt |prismForm n 2 (by omega) (by omega)
          (cauchySchwarzLift rho phi) (fun r => F.1 r)| *
          Real.sqrt (C_nReduction * (J.1 : ℝ)) :=
        mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt hmass) (Real.sqrt_nonneg _)
      _ = Real.sqrt |prismForm n 2 (by omega) (by omega)
          (fun y => ∑ j ∈ Finset.range J.1, T (j : ℤ) y)
          (fun r => F.1 r)| * Real.sqrt (C_nReduction * (J.1 : ℝ)) := by
        rw [← hlift]

theorem sqrt_decay_eighth {C D : ℝ} (hC : 0 ≤ C) (hD : 0 ≤ D) (h : ℕ) :
    Real.sqrt C * Real.sqrt (D * Real.rpow 2 (-(h : ℝ) / 4)) =
      Real.sqrt (C * D) * Real.rpow 2 (-(h : ℝ) / 8) := by
  let r : ℝ := Real.rpow 2 (-(h : ℝ) / 4)
  let q : ℝ := Real.rpow 2 (-(h : ℝ) / 8)
  have hr : 0 ≤ r := by
    dsimp [r]
    exact Real.rpow_nonneg (by norm_num) _
  have hq : 0 ≤ q := by
    dsimp [q]
    exact Real.rpow_nonneg (by norm_num) _
  have hq_sq : q ^ 2 = r := by
    dsimp [q, r]
    calc
      (Real.rpow 2 (-(h : ℝ) / 8)) ^ 2 =
          Real.rpow 2 ((-(h : ℝ) / 8) * (2 : ℝ)) :=
        (Real.rpow_mul_natCast (by norm_num : (0 : ℝ) ≤ 2) (-(h : ℝ) / 8) 2).symm
      _ = Real.rpow 2 (-(h : ℝ) / 4) := by congr 1; ring
  have hleft0 : 0 ≤ Real.sqrt C * Real.sqrt (D * r) := by positivity
  have hright0 : 0 ≤ Real.sqrt (C * D) * q := by positivity
  have hleftsq : (Real.sqrt C * Real.sqrt (D * r)) ^ 2 = C * D * r := by
    rw [mul_pow, Real.sq_sqrt hC, Real.sq_sqrt (mul_nonneg hD hr)]
    ring
  have hrightsq : (Real.sqrt (C * D) * q) ^ 2 = C * D * r := by
    rw [mul_pow, Real.sq_sqrt (mul_nonneg hC hD), hq_sq]
  dsimp [r, q] at hleft0 hright0 hleftsq hrightsq ⊢
  nlinarith

theorem seminorm_diagonalBand_interior {n : ℕ} (hn : 2 < n)
    (D : ReductionData) (h : ℕ) :
    kernelSequenceSeminorm n 1 (by omega) (by omega)
      (aux_diagonalBandSequence D h) ≤
      ENNReal.ofReal (Real.sqrt (C_nReduction * C_increaseDataReduction) *
        Real.rpow 2 (-(h : ℝ) / 8)) := by
  rw [← sqrt_decay_eighth CnReduction_nonneg CincreaseDataReduction_nonneg h]
  exact seminorm_diagonalBand_interior_raw hn D h

theorem seminorm_diagonalBand_endpoint (D : ReductionData) (h : ℕ) :
    kernelSequenceSeminorm 2 1 (by omega) (by omega)
      (aux_diagonalBandSequence D h) ≤
      ENNReal.ofReal (C_increaseDataReduction * Real.rpow 2 (-(h : ℝ) / 4)) := by
  classical
  let T : KernelSequence 2 := fun j => reductionMajorantKernel 2 D h j
  let U : ℝ := C_increaseDataReduction * Real.rpow 2 (-(h : ℝ) / 4)
  have hU : 0 ≤ U := by
    dsimp [U]
    exact mul_nonneg CincreaseDataReduction_nonneg (Real.rpow_nonneg (by norm_num) _)
  have hT : kernelSequenceSeminorm 2 2 (by omega) (by omega) T ≤ ENNReal.ofReal U := by
    simpa [T, U] using increaseDataReduction (n := 2) (by omega) D h
  unfold kernelSequenceSeminorm
  refine iSup_le fun J => ?_
  refine iSup_le fun F => ?_
  let rho : Fin J.1 → MKernel 1 := fun l =>
    aux_liftPlaneKernel (reductionNKernel 2 D h (l.1 : ℤ))
  let phi : Fin J.1 → ℝ → ℝ := fun l => reductionSigma D h (l.1 : ℤ)
  have hrho (l : Fin J.1) : MemW0 (rho l) := by
    dsimp [rho]
    exact lift_reductionN_memW0 (by omega) D h (l.1 : ℤ)
  have hphi (l : Fin J.1) : MemW0 (phi l) := by
    dsimp [phi, reductionSigma]
    exact squareRootGaussianDifference_memW0
      (smul_mem_A D.a_spaced (by positivity)) (l.1 : ℤ)
  have hkernel :
      (fun y => ∑ j ∈ Finset.range J.1, aux_diagonalBandSequence D h (j : ℤ) y) =
        doublyCauchySchwarzKernel rho phi (0 : Fin 1) := by
    simpa [rho, phi] using doublyCauchySchwarzKernel_diagonalBand_eq D h J.1
  have hlift :
      (fun y => ∑ j ∈ Finset.range J.1, T (j : ℤ) y) =
        cauchySchwarzLift rho phi := by
    simpa [T, rho, phi] using cauchySchwarzLift_reduction_eq (n := 2) D h J.1
  have hnormal : min 1 (Real.rpow (J.1 : ℝ)
      (-1 + (2 : ℝ) ^ (((1 : ℕ) : ℤ) - ((2 : ℕ) : ℤ) + 1))) = 1 := by
    norm_num
  have hnormalTop : min 1 (Real.rpow (J.1 : ℝ)
      (-1 + (2 : ℝ) ^ (((2 : ℕ) : ℤ) - ((2 : ℕ) : ℤ) + 1))) = 1 := by
    norm_num
    exact_mod_cast (show 1 ≤ J.1 by omega)
  have hsup : sSup (Set.range (fun G : NormalizedFunctionTuple 2 =>
      |prismForm 2 2 (by omega) le_rfl
        (cauchySchwarzLift rho phi) (fun a x => G.1 a x)|)) ≤ U := by
    apply csSup_le
    · exact ⟨_, ⟨F, rfl⟩⟩
    rintro _ ⟨G, rfl⟩
    apply (ENNReal.ofReal_le_ofReal_iff hU).mp
    have hterm : ENNReal.ofReal
        |prismForm 2 2 (by omega) (by omega)
          (cauchySchwarzLift rho phi) (fun a x => G.1 a x)| ≤
        kernelSequenceSeminorm 2 2 (by omega) (by omega) T := by
      unfold kernelSequenceSeminorm
      apply le_iSup_of_le J
      apply le_iSup_of_le G
      rw [hnormalTop, one_mul, hlift]
    exact hterm.trans hT
  have hCS := cauchySchwarzAtNMinusOne_bound 1 J.1 (by omega) (by omega)
    rho phi hrho hphi (0 : Fin 1) F.1 F.2
  have hreal :
      |prismForm 2 1 (by omega) (by omega)
        (fun y => ∑ j ∈ Finset.range J.1, aux_diagonalBandSequence D h (j : ℤ) y)
        (fun r => F.1 r)| ≤ U := by
    calc
      |prismForm 2 1 (by omega) (by omega)
          (fun y => ∑ j ∈ Finset.range J.1, aux_diagonalBandSequence D h (j : ℤ) y)
          (fun r => F.1 r)| =
          |prismForm 2 1 (by omega) (by omega)
            (doublyCauchySchwarzKernel rho phi (0 : Fin 1)) (fun r => F.1 r)| := by
            rw [hkernel]
      _ ≤ sSup (Set.range (fun G : NormalizedFunctionTuple 2 =>
          |prismForm 2 2 (by omega) le_rfl
            (cauchySchwarzLift rho phi) (fun a x => G.1 a x)|)) := hCS
      _ ≤ U := hsup
  simpa [hnormal, U] using ENNReal.ofReal_le_ofReal hreal

theorem eighth_height_tsum (C : ℝ) (hC : 0 ≤ C) :
    (∑' h : ℕ, ENNReal.ofReal (C * Real.rpow 2 (-((h : ℝ) / 8)))) ≤
      ENNReal.ofReal ((2 : ℝ) ^ 4 * C) := by
  let q : ℝ := Real.rpow 2 (-(1 / 8 : ℝ))
  let r : ℝ := 15 / 16
  have hrnonneg : 0 ≤ r := by
    dsimp [r]
    norm_num
  have hrlt : ‖r‖ < 1 := by
    dsimp [r]
    norm_num [Real.norm_eq_abs]
  have hqnonneg : 0 ≤ q := by
    dsimp [q]
    exact Real.rpow_nonneg (by norm_num) _
  have hqle : q ≤ r := by
    dsimp [q, r]
    apply le_of_pow_le_pow_left₀ (by norm_num : (8 : ℕ) ≠ 0) (by norm_num)
    have hpow : (Real.rpow 2 (-(1 / 8 : ℝ))) ^ 8 =
        Real.rpow 2 (-(1 / 8 : ℝ) * 8) := by
      exact (Real.rpow_mul_natCast (x := 2) (by norm_num : (0 : ℝ) ≤ 2)
        (-(1 / 8 : ℝ)) 8).symm
    change (Real.rpow 2 (-(1 / 8 : ℝ))) ^ 8 ≤ (15 / 16 : ℝ) ^ 8
    rw [hpow]
    norm_num [Real.rpow_neg]
  have hqlt : ‖q‖ < 1 := by
    rw [Real.norm_eq_abs, abs_of_nonneg hqnonneg]
    exact lt_of_le_of_lt hqle (by
      dsimp [r]
      norm_num)
  have hqsum : Summable (fun h : ℕ => q ^ h) :=
    summable_geometric_of_norm_lt_one hqlt
  have hrsum : Summable (fun h : ℕ => r ^ h) :=
    summable_geometric_of_norm_lt_one hrlt
  have hterm (h : ℕ) : q ^ h = Real.rpow 2 (-((h : ℝ) / 8)) := by
    dsimp [q]
    rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
    congr 1
    ring
  have hactual : Summable (fun h : ℕ => C * Real.rpow 2 (-((h : ℝ) / 8))) := by
    simpa only [← hterm] using hqsum.mul_left C
  have hmajor : Summable (fun h : ℕ => C * r ^ h) := hrsum.mul_left C
  have hpoint (h : ℕ) : C * Real.rpow 2 (-((h : ℝ) / 8)) ≤ C * r ^ h := by
    rw [← hterm]
    gcongr
  have hsum : (∑' h : ℕ, C * Real.rpow 2 (-((h : ℝ) / 8))) ≤
      (2 : ℝ) ^ 4 * C := by
    calc
      (∑' h : ℕ, C * Real.rpow 2 (-((h : ℝ) / 8))) ≤ ∑' h : ℕ, C * r ^ h :=
        Summable.tsum_le_tsum hpoint hactual hmajor
      _ = C * (∑' h : ℕ, r ^ h) := by rw [tsum_mul_left]
      _ = C * ((1 - r)⁻¹) := by rw [tsum_geometric_of_norm_lt_one hrlt]
      _ = (2 : ℝ) ^ 4 * C := by
        dsimp [r]
        norm_num
        ring
  have hnonneg (h : ℕ) : 0 ≤ C * Real.rpow 2 (-((h : ℝ) / 8)) :=
    mul_nonneg hC (Real.rpow_nonneg (by norm_num) _)
  calc
    (∑' h : ℕ, ENNReal.ofReal (C * Real.rpow 2 (-((h : ℝ) / 8)))) =
        ENNReal.ofReal (∑' h : ℕ, C * Real.rpow 2 (-((h : ℝ) / 8))) :=
      (ENNReal.ofReal_tsum_of_nonneg hnonneg hactual).symm
    _ ≤ ENNReal.ofReal ((2 : ℝ) ^ 4 * C) := ENNReal.ofReal_le_ofReal hsum

theorem quarter_height_tsum (C : ℝ) (hC : 0 ≤ C) :
    (∑' h : ℕ, ENNReal.ofReal (C * Real.rpow 2 (-((h : ℝ) / 4)))) ≤
      ENNReal.ofReal ((2 : ℝ) ^ 3 * C) := by
  let q : ℝ := Real.rpow 2 (-(1 / 4 : ℝ))
  let r : ℝ := 7 / 8
  have hrnonneg : 0 ≤ r := by
    dsimp [r]
    norm_num
  have hrlt : ‖r‖ < 1 := by
    dsimp [r]
    norm_num [Real.norm_eq_abs]
  have hqnonneg : 0 ≤ q := by
    dsimp [q]
    exact Real.rpow_nonneg (by norm_num) _
  have hqle : q ≤ r := by
    dsimp [q, r]
    apply le_of_pow_le_pow_left₀ (by norm_num : (4 : ℕ) ≠ 0) (by norm_num)
    have hpow : (Real.rpow 2 (-(1 / 4 : ℝ))) ^ 4 =
        Real.rpow 2 (-(1 / 4 : ℝ) * 4) := by
      exact (Real.rpow_mul_natCast (x := 2) (by norm_num : (0 : ℝ) ≤ 2)
        (-(1 / 4 : ℝ)) 4).symm
    change (Real.rpow 2 (-(1 / 4 : ℝ))) ^ 4 ≤ (7 / 8 : ℝ) ^ 4
    rw [hpow]
    norm_num [Real.rpow_neg]
  have hqlt : ‖q‖ < 1 := by
    rw [Real.norm_eq_abs, abs_of_nonneg hqnonneg]
    exact lt_of_le_of_lt hqle (by
      dsimp [r]
      norm_num)
  have hqsum : Summable (fun h : ℕ => q ^ h) :=
    summable_geometric_of_norm_lt_one hqlt
  have hrsum : Summable (fun h : ℕ => r ^ h) :=
    summable_geometric_of_norm_lt_one hrlt
  have hterm (h : ℕ) : q ^ h = Real.rpow 2 (-((h : ℝ) / 4)) := by
    dsimp [q]
    rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
    congr 1
    ring
  have hactual : Summable (fun h : ℕ => C * Real.rpow 2 (-((h : ℝ) / 4))) := by
    simpa only [← hterm] using hqsum.mul_left C
  have hmajor : Summable (fun h : ℕ => C * r ^ h) := hrsum.mul_left C
  have hpoint (h : ℕ) : C * Real.rpow 2 (-((h : ℝ) / 4)) ≤ C * r ^ h := by
    rw [← hterm]
    gcongr
  have hsum : (∑' h : ℕ, C * Real.rpow 2 (-((h : ℝ) / 4))) ≤
      (2 : ℝ) ^ 3 * C := by
    calc
      (∑' h : ℕ, C * Real.rpow 2 (-((h : ℝ) / 4))) ≤ ∑' h : ℕ, C * r ^ h :=
        Summable.tsum_le_tsum hpoint hactual hmajor
      _ = C * (∑' h : ℕ, r ^ h) := by rw [tsum_mul_left]
      _ = C * ((1 - r)⁻¹) := by rw [tsum_geometric_of_norm_lt_one hrlt]
      _ = (2 : ℝ) ^ 3 * C := by
        dsimp [r]
        norm_num
        ring
  have hnonneg (h : ℕ) : 0 ≤ C * Real.rpow 2 (-((h : ℝ) / 4)) :=
    mul_nonneg hC (Real.rpow_nonneg (by norm_num) _)
  calc
    (∑' h : ℕ, ENNReal.ofReal (C * Real.rpow 2 (-((h : ℝ) / 4)))) =
        ENNReal.ofReal (∑' h : ℕ, C * Real.rpow 2 (-((h : ℝ) / 4))) :=
      (ENNReal.ofReal_tsum_of_nonneg hnonneg hactual).symm
    _ ≤ ENNReal.ofReal ((2 : ℝ) ^ 3 * C) := ENNReal.ofReal_le_ofReal hsum

/-- The ENNReal geometric tail of a quarter-power dyadic decay is at most eight
    times its nonnegative coefficient. -/
theorem quarterHeightTsum (C : ℝ) (hC : 0 ≤ C) :
    (∑' h : ℕ, ENNReal.ofReal (C * Real.rpow 2 (-((h : ℝ) / 4)))) ≤
      ENNReal.ofReal ((2 : ℝ) ^ 3 * C) :=
  quarter_height_tsum C hC


/--
\begin{proposition}[diagonal band - reduction variant]
\label{P:diagonal-band-reduction}
Let $a\in A$ and let $\mathcal P$, $(M_j)_{j\in \Z}$ be as in Proposition~
[`Codex.Reduction.OnDiagonalMainArgument.increaseDataReduction`]. For $h\in\N$ with
$h\ge1$ and $j\in\Z$, define
\begin{equation}\label{auto:diagonal-band-positive-scale}
L_{h,j}= M_j \ast_{(1,1)} (\Phi_{(2^{h-1}a(j))}-\Phi_{(2^{h}a(j))}),
\end{equation}
and for $j\in \Z$,
\begin{equation}\label{auto:diagonal-band-zero-scale}
L_{0,j}=M_j \ast_{(1,1)} (\Phi_{(a(j-1))}-\Phi_{(a(j))}).
\end{equation}
Let $\mathbf{L}_h=(L_{h,j})_{j\in \Z}$. Then
\begin{equation}\label{auto:diagonal-band-sum-bound}
\sum_{h\in \N} \|\mathbf{L}_h\|_{\rm M(1)} \leq C_{\text{P:diagonal-band-reduction}}
\end{equation}
with  $C_{\text{P:diagonal-band-reduction}} = 2^4(
    C_{\text{lem:N-reduction}}
    C_{\text{P:increase-data-reduction}}
  )^{1/2} + 2^3 C_{\text{P:increase-data-reduction}}$.
\end{proposition}

See also [`Codex.Reduction.OnDiagonalOffDiagonal.diagonalBandReduction`],
[`Codex.Reduction.OnDiagonalMainArgument.nReduction`],
[`Codex.Reduction.OnDiagonalMainArgument.increaseDataReduction`].
-/
theorem diagonalBandReduction {n : ℕ} (hn : 2 ≤ n) (D : ReductionData) :
    ∑' h : ℕ,
      kernelSequenceSeminorm n 1 (by omega) (by omega)
        (aux_diagonalBandSequence D h) ≤ ENNReal.ofReal C_diagonalBandReduction := by
  rcases (show n = 2 ∨ 2 < n by omega) with rfl | hn
  · calc
      ∑' h : ℕ,
          kernelSequenceSeminorm 2 1 (by omega) (by omega)
            (aux_diagonalBandSequence D h) ≤
          ∑' h : ℕ, ENNReal.ofReal
            (C_increaseDataReduction * Real.rpow 2 (-((h : ℝ) / 4))) :=
        ENNReal.tsum_le_tsum fun h => by
          simpa [neg_div] using seminorm_diagonalBand_endpoint D h
      _ ≤ ENNReal.ofReal ((2 : ℝ) ^ 3 * C_increaseDataReduction) :=
        quarter_height_tsum C_increaseDataReduction CincreaseDataReduction_nonneg
      _ ≤ ENNReal.ofReal C_diagonalBandReduction := by
        apply ENNReal.ofReal_le_ofReal
        unfold C_diagonalBandReduction
        have hleft : 0 ≤ (2 : ℝ) ^ 4 *
            Real.sqrt (C_nReduction * C_increaseDataReduction) := by positivity
        linarith
  · calc
      ∑' h : ℕ,
          kernelSequenceSeminorm n 1 (by omega) (by omega)
            (aux_diagonalBandSequence D h) ≤
          ∑' h : ℕ, ENNReal.ofReal
            (Real.sqrt (C_nReduction * C_increaseDataReduction) *
              Real.rpow 2 (-((h : ℝ) / 8))) :=
        ENNReal.tsum_le_tsum fun h => by
          simpa [neg_div] using seminorm_diagonalBand_interior hn D h
      _ ≤ ENNReal.ofReal ((2 : ℝ) ^ 4 *
          Real.sqrt (C_nReduction * C_increaseDataReduction)) :=
        eighth_height_tsum _ (Real.sqrt_nonneg _)
      _ ≤ ENNReal.ofReal C_diagonalBandReduction := by
        apply ENNReal.ofReal_le_ofReal
        unfold C_diagonalBandReduction
        have hright : 0 ≤ (2 : ℝ) ^ 3 * C_increaseDataReduction :=
          mul_nonneg (by positivity) CincreaseDataReduction_nonneg
        linarith


-- The explicit numerical calculation below contains powers through `2^552`.
set_option exponentiation.threshold 600 in
/--
\begin{lemma}[constant $C_{\text{P:diagonal-band-reduction}}$ \auto]
\label{constant diagonal band reduction}
\begin{equation}\label{constant diagonal band reduction bound}
C_{\text{P:diagonal-band-reduction}}
<\tfrac{63}{64}2^{480}<2^{480}.
\end{equation}
\end{lemma}

See also [`Codex.Reduction.OnDiagonalOffDiagonal.diagonalBandReduction`].
-/
theorem constantDiagonalBandReduction :
    C_diagonalBandReduction < (63 / 64 : ℝ) * (2 : ℝ) ^ 480 := by
  have hn0 : 0 ≤ C_nReduction := CnReduction_nonneg
  have hn := constantNReduction
  have hi := constantIncreaseDataReduction
  have hn' : C_nReduction < (2 : ℝ) ^ 75 := by
    exact hn.trans (by norm_num)
  have hi' : C_increaseDataReduction < (2 : ℝ) ^ 477 := by
    exact hi.trans (by norm_num)
  have hprod : C_nReduction * C_increaseDataReduction < (2 : ℝ) ^ 552 := by
    calc
      C_nReduction * C_increaseDataReduction ≤ C_nReduction * (2 : ℝ) ^ 477 :=
        mul_le_mul_of_nonneg_left (le_of_lt hi') hn0
      _ < (2 : ℝ) ^ 75 * (2 : ℝ) ^ 477 :=
        mul_lt_mul_of_pos_right hn' (by positivity)
      _ = (2 : ℝ) ^ 552 := by rw [← pow_add]
  have hsqrt : Real.sqrt (C_nReduction * C_increaseDataReduction) < (2 : ℝ) ^ 276 := by
    apply (Real.sqrt_lt' (by positivity)).2
    calc
      C_nReduction * C_increaseDataReduction < (2 : ℝ) ^ 552 := hprod
      _ = ((2 : ℝ) ^ 276) ^ 2 := by rw [← pow_mul]
  have hfirst : (2 : ℝ) ^ 4 * Real.sqrt (C_nReduction * C_increaseDataReduction) <
      (2 : ℝ) ^ 280 := by
    calc
      (2 : ℝ) ^ 4 * Real.sqrt (C_nReduction * C_increaseDataReduction) <
          (2 : ℝ) ^ 4 * (2 : ℝ) ^ 276 := by gcongr
      _ = (2 : ℝ) ^ 280 := by rw [← pow_add]
  have hdiv280 : (2 : ℝ) ^ 480 / 64 = (2 : ℝ) ^ 474 := by
    apply (div_eq_iff (by norm_num : (64 : ℝ) ≠ 0)).mpr
    rw [show (64 : ℝ) = (2 : ℝ) ^ 6 by norm_num, ← pow_add]
  have hfirst' : (2 : ℝ) ^ 4 * Real.sqrt (C_nReduction * C_increaseDataReduction) <
      (1 / 64 : ℝ) * (2 : ℝ) ^ 480 := by
    calc
      (2 : ℝ) ^ 4 * Real.sqrt (C_nReduction * C_increaseDataReduction) <
          (2 : ℝ) ^ 280 := hfirst
      _ < (2 : ℝ) ^ 474 := pow_lt_pow_right₀ (by norm_num) (by norm_num)
      _ = (1 / 64 : ℝ) * (2 : ℝ) ^ 480 := by
        rw [show (1 / 64 : ℝ) * (2 : ℝ) ^ 480 = (2 : ℝ) ^ 480 / 64 by ring, hdiv280]
  have hdiv477 : (2 : ℝ) ^ 480 / 8 = (2 : ℝ) ^ 477 := by
    apply (div_eq_iff (by norm_num : (8 : ℝ) ≠ 0)).mpr
    rw [show (8 : ℝ) = (2 : ℝ) ^ 3 by norm_num, ← pow_add]
  have hsecond : (2 : ℝ) ^ 3 * C_increaseDataReduction <
      (31 / 32 : ℝ) * (2 : ℝ) ^ 480 := by
    calc
      (2 : ℝ) ^ 3 * C_increaseDataReduction <
          (2 : ℝ) ^ 3 * ((31 / 32 : ℝ) * (2 : ℝ) ^ 477) := by gcongr
      _ = (31 / 32 : ℝ) * (2 : ℝ) ^ 480 := by
        rw [show (2 : ℝ) ^ 477 = (2 : ℝ) ^ 480 / 8 by rw [hdiv477]]
        ring
  unfold C_diagonalBandReduction
  calc
    (2 : ℝ) ^ 4 * Real.sqrt (C_nReduction * C_increaseDataReduction) +
        (2 : ℝ) ^ 3 * C_increaseDataReduction <
        (1 / 64 : ℝ) * (2 : ℝ) ^ 480 + (31 / 32 : ℝ) * (2 : ℝ) ^ 480 :=
      add_lt_add hfirst' hsecond
    _ = (63 / 64 : ℝ) * (2 : ℝ) ^ 480 := by ring

/-- The large-scale standard-bump smoothing used in `lOneReduction`. -/
noncomputable def aux_largeScaleSmoothing (M : RealPlane → ℝ) (t : ℝ) : RealPlane → ℝ :=
  aux_diagonalConvolution M (standardBumpRescale t)

/-- Diagonal Fourier cancellation makes the large-scale smoothing integral vanish. -/
theorem aux_largeScaleSmoothing_tendsto_integral_norm_atTop
    (M : RealPlane → ℝ) (hM : MemW0 M)
    (hcancel : ∀ ξ : ℝ, aux_fourierPlane M (ξ, -ξ) = 0) :
    Tendsto (fun t : ℝ => ∫ v : RealPlane, |aux_largeScaleSmoothing M t v|)
      atTop (nhds 0) := by
  let F : RealPlane → ℝ := fun xq => M (xq.1 + xq.2, xq.2)
  have hF : MemW0 F := by
    change MemW0 (M ∘ aux_diagonalShear)
    exact aux_memW0_comp_continuousLinearEquiv hM aux_diagonalShear
  have hzero (x : ℝ) : (∫ q : ℝ, F (x, q)) = 0 := by
    exact affineDiagonalCancellationReduction M hM hcancel x
  let g : ℝ → ℝ := fun q => ∫ x : ℝ, ‖F (x, q)‖
  have hFint : Integrable F :=
    aux_memW0_integrable_of_addHaar hF
  have hg : Integrable g := by
    simpa [g] using hFint.integral_norm_prod_right
  have hg_nonneg (q : ℝ) : 0 ≤ g q := by
    dsimp [g]
    exact integral_nonneg fun _ => abs_nonneg _
  have houter := aux_weighted_standardBump_translation_tendsto g hg hg_nonneg
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le'
    (tendsto_const_nhds : Tendsto (fun _ : ℝ => (0 : ℝ)) atTop (nhds 0)) houter
  · filter_upwards [] with t
    exact integral_nonneg fun _ => abs_nonneg _
  · filter_upwards [eventually_gt_atTop (0 : ℝ)] with t ht
    have hcoord (xy : RealPlane) :
        aux_largeScaleSmoothing M t (aux_diagonalShear xy) =
          ∫ q : ℝ, F (xy.1, q) * standardBumpRescale t (xy.2 - q) := by
      rcases xy with ⟨x, y⟩
      let A : ℝ → ℝ := fun p =>
        M (x + y - p, y - p) * standardBumpRescale t p
      calc
        aux_largeScaleSmoothing M t (aux_diagonalShear (x, y)) = ∫ p : ℝ, A p := by
          apply integral_congr_ae
          filter_upwards [] with p
          dsimp [A, aux_largeScaleSmoothing, aux_diagonalConvolution, aux_diagonalShear]
        _ = ∫ q : ℝ, A (y - q) :=
          (integral_sub_left_eq_self A volume y).symm
        _ = ∫ q : ℝ, F (x, q) * standardBumpRescale t (y - q) := by
          apply integral_congr_ae
          filter_upwards [] with q
          dsimp [A, F]
          ring_nf
    have hmeasure :
        (∫ xy : RealPlane, |aux_largeScaleSmoothing M t (aux_diagonalShear xy)|) =
          ∫ v : RealPlane, |aux_largeScaleSmoothing M t v| :=
      aux_measurePreserving_diagonalShear.integral_comp
        aux_diagonalShear.toHomeomorph.measurableEmbedding
        (fun v : RealPlane => |aux_largeScaleSmoothing M t v|)
    calc
      (∫ v : RealPlane, |aux_largeScaleSmoothing M t v|) =
          ∫ xy : RealPlane, |aux_largeScaleSmoothing M t (aux_diagonalShear xy)| :=
            hmeasure.symm
      _ = ∫ xy : RealPlane, |∫ q : ℝ,
          F (xy.1, q) * standardBumpRescale t (xy.2 - q)| := by
            apply integral_congr_ae
            filter_upwards [] with xy
            rw [hcoord xy]
      _ ≤ ∫ q : ℝ, (∫ x : ℝ, ‖F (x, q)‖) *
          (∫ z : ℝ, ‖standardBump (z - q / t) - standardBump z‖) :=
            aux_lMultiplierAtScale_largeScaleConvolution_bound hF hzero t ht
      _ = ∫ q : ℝ,
          (∫ z : ℝ, ‖standardBump (z - q / t) - standardBump z‖) * g q := by
            apply integral_congr_ae
            filter_upwards [] with q
            dsimp [g]
            ring

/-- The cancellation estimate implies convergence of the smoothing in `L¹`. -/
theorem aux_largeScaleSmoothing_tendsto_zero
    (M : RealPlane → ℝ) (hM : MemW0 M)
    (hcancel : ∀ ξ : ℝ, aux_fourierPlane M (ξ, -ξ) = 0) :
    Tendsto (fun t : ℝ => eLpNorm (aux_largeScaleSmoothing M t) 1 volume)
      atTop (nhds 0) := by
  have hraw := aux_largeScaleSmoothing_tendsto_integral_norm_atTop M hM hcancel
  have hraw' : Tendsto (fun t : ℝ => ENNReal.ofReal
      (∫ v : RealPlane, |aux_largeScaleSmoothing M t v|)) atTop (nhds 0) := by
    simpa using ENNReal.tendsto_ofReal hraw
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le'
    (tendsto_const_nhds : Tendsto (fun _ : ℝ => (0 : ℝ≥0∞)) atTop (nhds 0)) hraw'
  · exact Filter.Eventually.of_forall fun _ => bot_le
  · filter_upwards [eventually_gt_atTop (0 : ℝ)] with t ht
    have hL : Integrable (aux_largeScaleSmoothing M t) := by
      have hconv := aux_memW0_convolutionAlong M hM
        (standardBumpRescale t) (aux_standardBumpRescale_memW0 ht) (1, 1)
      convert aux_memW0_integrable_of_addHaar hconv using 1
      funext v
      apply integral_congr_ae
      filter_upwards [] with q
      have harg : (v.1 - q, v.2 - q) = v - q • (1, 1) := by
        apply Prod.ext <;> dsimp <;> ring
      rw [harg]
    refine aux_eLpNorm_one_le_of_integral_norm_le hL ?_
    simp only [Real.norm_eq_abs]
    exact le_rfl

/--
\begin{lemma}\label{lem:L1-reduction}
Let $a\in A$ and suppose that $(M_j)_{j\in\Z}\subset W_0(\R^2)$ satisfies for all
$\xi \in \R$ and $j\in \Z$
\begin{equation}\label{auto:vanishing-diagonal-assumption}
\widehat{M_j}(\xi,-\xi)=0.
\end{equation}
Then
\begin{equation}\label{auto:vanishing-diagonal-large-scale-limit}    \lim_{t\to\infty}
    \| M_j\ast_{(1,1)}\Phi_{(t)} \|_1
    =0
    \end{equation}
\end{lemma}
-/
theorem lOneReduction (M : RealPlane → ℝ) (hM : MemW0 M)
    (hcancel : ∀ ξ : ℝ, aux_fourierPlane M (ξ, -ξ) = 0) :
    Tendsto (fun t : ℝ => eLpNorm (aux_largeScaleSmoothing M t) 1 volume)
      atTop (nhds 0) := by
  exact aux_largeScaleSmoothing_tendsto_zero M hM hcancel

/-- The Fourier transform of a planar kernel, transported to the canonical Euclidean model. -/
noncomputable def aux_planeFourier (M : RealPlane → ℝ) :
    EuclideanSpace ℝ (Fin 2) → ℂ :=
  FourierTransform.fourier
    (fun v : EuclideanSpace ℝ (Fin 2) => (M (v 0, v 1) : ℂ))

/-- The Fourier support hypothesis in Proposition
[`Codex.Reduction.OnDiagonalOffDiagonal.vanishingDiagonalReduction`]. -/
def aux_frequencyDiagonalBound (D : ReductionData) : Prop :=
  ∀ j : ℤ,
    Function.support
      (aux_planeFourier (D.kernel j)) ⊆
        {z : EuclideanSpace ℝ (Fin 2) |
          |z 0 + z 1| ≤ (2 : ℝ)⁻¹ * (D.a (j - 1))⁻¹}

theorem aux_initialSmoothing_fourier_factor
    (D : ReductionData) (hsupport : aux_frequencyDiagonalBound D)
    (j : ℤ) (xi : EuclideanSpace ℝ (Fin 2)) :
    aux_planeFourier (D.kernel j) xi *
        FourierTransform.fourier (fun x : ℝ => (standardBump x : ℂ))
          (D.a (j - 1) * (xi 0 + xi 1)) =
      aux_planeFourier (D.kernel j) xi := by
  by_cases hzero : aux_planeFourier (D.kernel j) xi = 0
  · rw [hzero, zero_mul]
  have hmem : xi ∈ Function.support (aux_planeFourier (D.kernel j)) :=
    Function.mem_support.mpr hzero
  have hstrip := hsupport j hmem
  have ha : 0 < D.a (j - 1) := aux_spacedSequence_pos D.a_spaced _
  have hstrip' : |xi 0 + xi 1| ≤ (2 : ℝ)⁻¹ * (D.a (j - 1))⁻¹ := by
    simpa using hstrip
  have habs : |D.a (j - 1) * (xi 0 + xi 1)| ≤ (1 / 2 : ℝ) := by
    calc
      |D.a (j - 1) * (xi 0 + xi 1)| =
          D.a (j - 1) * |xi 0 + xi 1| := by rw [abs_mul, abs_of_pos ha]
      _ ≤ D.a (j - 1) * ((2 : ℝ)⁻¹ * (D.a (j - 1))⁻¹) :=
        mul_le_mul_of_nonneg_left hstrip' ha.le
      _ = (1 / 2 : ℝ) := by field_simp [ne_of_gt ha]
  have harg : D.a (j - 1) * (xi 0 + xi 1) ∈
      Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) :=
    abs_le.mp (by simpa [abs_of_nonneg] using habs)
  rw [aux_fourier_standardBump_eq_one_on _ harg, mul_one]

noncomputable def aux_vanishingDiagonalDirection :
    EuclideanSpace ℝ (Fin 2) :=
  WithLp.toLp 2 ![1, 1]

theorem aux_inner_vanishingDiagonalDirection
    (xi : EuclideanSpace ℝ (Fin 2)) :
    inner ℝ aux_vanishingDiagonalDirection xi = xi 0 + xi 1 := by
  rw [PiLp.inner_apply]
  simp [aux_vanishingDiagonalDirection, Fin.sum_univ_two]

theorem aux_memW0_complex_ofReal_vanishing {E : Type*}
    [NormedAddCommGroup E] [ProperSpace E] [MeasureSpace E] [BorelSpace E]
    (f : E → ℝ) (hf : MemW0 f) : MemW0 (fun x => (f x : ℂ)) := by
  refine ⟨Complex.continuous_ofReal.comp hf.1, ?_⟩
  have henv : wienerEnvelope (fun x => (f x : ℂ)) 1 = wienerEnvelope f 1 := by
    funext x
    simp [wienerEnvelope, Complex.norm_real, Real.norm_eq_abs]
  rw [henv]
  exact hf.2

theorem aux_fourier_sub_euclidean_vanishing
    (f g : EuclideanSpace ℝ (Fin 2) → ℂ)
    (hf : Integrable f) (hg : Integrable g) (xi : EuclideanSpace ℝ (Fin 2)) :
    FourierTransform.fourier (fun z => f z - g z) xi =
      FourierTransform.fourier f xi - FourierTransform.fourier g xi := by
  rw [Real.fourier_eq, Real.fourier_eq, Real.fourier_eq]
  calc
    (∫ z, 𝐞 (-⟪z, xi⟫) • (f z - g z)) =
        ∫ z, (𝐞 (-⟪z, xi⟫) • f z - 𝐞 (-⟪z, xi⟫) • g z) := by
          apply integral_congr_ae
          filter_upwards [] with z
          rw [smul_sub]
    _ = (∫ z, 𝐞 (-⟪z, xi⟫) • f z) -
        ∫ z, 𝐞 (-⟪z, xi⟫) • g z := by
          rw [integral_sub]
          · exact (Real.fourierIntegral_convergent_iff xi).mpr hf
          · exact (Real.fourierIntegral_convergent_iff xi).mpr hg

theorem aux_vanishingDiagonalDirection_coords (v : RealPlane) (q : ℝ) :
    ((WithLp.toLp 2 ![v.1, v.2] : EuclideanSpace ℝ (Fin 2)) -
      q • aux_vanishingDiagonalDirection) 0 = v.1 - q ∧
    ((WithLp.toLp 2 ![v.1, v.2] : EuclideanSpace ℝ (Fin 2)) -
      q • aux_vanishingDiagonalDirection) 1 = v.2 - q := by
  constructor <;> simp [aux_vanishingDiagonalDirection]

theorem aux_initialSmoothing_eq
    (D : ReductionData) (hsupport : aux_frequencyDiagonalBound D) (j : ℤ) :
    aux_largeScaleSmoothing (D.kernel j) (D.a (j - 1)) = D.kernel j := by
  let f : EuclideanSpace ℝ (Fin 2) → ℂ :=
    fun z => (D.kernel j (z 0, z 1) : ℂ)
  let phi : ℝ → ℂ := fun q => (standardBumpRescale (D.a (j - 1)) q : ℂ)
  let conv : EuclideanSpace ℝ (Fin 2) → ℂ :=
    Codex.Preliminaries.ConvolutionAlongVector.convolutionAlongVector f phi
      aux_vanishingDiagonalDirection
  have ha : 0 < D.a (j - 1) := aux_spacedSequence_pos D.a_spaced _
  have hfre : MemW0 (fun z : EuclideanSpace ℝ (Fin 2) => D.kernel j (z 0, z 1)) := by
    let e : EuclideanSpace ℝ (Fin 2) ≃L[ℝ] RealPlane :=
      (EuclideanSpace.equiv (Fin 2) ℝ).trans (ContinuousLinearEquiv.finTwoArrow ℝ ℝ)
    have hcomp : MemW0 (D.kernel j ∘ e) :=
      aux_memW0_comp_continuousLinearEquiv (D.kernel_memW0 j) e
    simpa [e, Function.comp_def] using hcomp
  have hf : MemW0 f := by
    simpa [f] using aux_memW0_complex_ofReal_vanishing _ hfre
  have hphire : MemW0 (standardBumpRescale (D.a (j - 1))) :=
    aux_standardBumpRescale_memW0 ha
  have hphi : MemW0 phi := by
    simpa [phi] using aux_memW0_complex_ofReal_vanishing _ hphire
  have hconv : MemW0 conv :=
    Codex.Preliminaries.ConvolutionAlongVector.memW0_convolutionAlongVector hf hphi
      aux_vanishingDiagonalDirection
  have hfourier (xi : EuclideanSpace ℝ (Fin 2)) :
      FourierTransform.fourier conv xi = FourierTransform.fourier f xi := by
    calc
      FourierTransform.fourier conv xi =
          FourierTransform.fourier f xi * FourierTransform.fourier phi
            (inner ℝ aux_vanishingDiagonalDirection xi) :=
        Codex.Preliminaries.ConvolutionAlongVector.fourier_convolutionAlongVector hf hphi
          aux_vanishingDiagonalDirection xi
      _ = aux_planeFourier (D.kernel j) xi *
          FourierTransform.fourier (fun x : ℝ => (standardBump x : ℂ))
            (D.a (j - 1) * (xi 0 + xi 1)) := by
        rw [show FourierTransform.fourier f xi = aux_planeFourier (D.kernel j) xi by rfl]
        rw [show phi = fun x : ℝ =>
              (standardBumpRescale (D.a (j - 1)) x : ℂ) by rfl]
        rw [← aux_fourierReal_eq_fourier,
          aux_fourierReal_standardBumpRescale _ ha,
          aux_inner_vanishingDiagonalDirection]
      _ = FourierTransform.fourier f xi := by
        exact aux_initialSmoothing_fourier_factor D hsupport j xi
  have hr : Continuous (fun z => f z - conv z) := hf.1.sub hconv.1
  have hrfint : Integrable f := aux_memW0_integrable_of_addHaar hf
  have hrcint : Integrable conv := aux_memW0_integrable_of_addHaar hconv
  have hrint : Integrable (fun z => f z - conv z) := hrfint.sub hrcint
  have hrhat (xi : EuclideanSpace ℝ (Fin 2)) :
      FourierTransform.fourier (fun z => f z - conv z) xi = 0 := by
    rw [aux_fourier_sub_euclidean_vanishing f conv hrfint hrcint xi, hfourier]
    ring
  have hrhatint : Integrable (FourierTransform.fourier (fun z => f z - conv z)) := by
    apply (integrable_zero _ _ volume).congr
    filter_upwards [] with xi
    exact (hrhat xi).symm
  have hrzero : (fun z => f z - conv z) = 0 := by
    rw [← hr.fourierInv_fourier_eq hrint hrhatint]
    have hzero : FourierTransform.fourier (fun z => f z - conv z) = 0 := by
      funext xi
      exact hrhat xi
    rw [hzero]
    funext z
    rw [Real.fourierInv_eq]
    simp
  funext v
  let z : EuclideanSpace ℝ (Fin 2) := WithLp.toLp 2 ![v.1, v.2]
  have hconv_eval : conv z =
      (aux_largeScaleSmoothing (D.kernel j) (D.a (j - 1)) v : ℂ) := by
    change (∫ q : ℝ,
      (D.kernel j ((z - q • aux_vanishingDiagonalDirection) 0,
        (z - q • aux_vanishingDiagonalDirection) 1) : ℂ) *
        (standardBumpRescale (D.a (j - 1)) q : ℂ)) = _
    change (∫ q : ℝ,
      (D.kernel j ((z - q • aux_vanishingDiagonalDirection) 0,
        (z - q • aux_vanishingDiagonalDirection) 1) : ℂ) *
        (standardBumpRescale (D.a (j - 1)) q : ℂ)) =
      ((∫ q : ℝ, D.kernel j (v.1 - q, v.2 - q) *
        standardBumpRescale (D.a (j - 1)) q : ℝ) : ℂ)
    calc
      (∫ q : ℝ,
        (D.kernel j ((z - q • aux_vanishingDiagonalDirection) 0,
          (z - q • aux_vanishingDiagonalDirection) 1) : ℂ) *
          (standardBumpRescale (D.a (j - 1)) q : ℂ)) =
          ∫ q : ℝ, ((D.kernel j (v.1 - q, v.2 - q) *
            standardBumpRescale (D.a (j - 1)) q : ℝ) : ℂ) := by
              apply integral_congr_ae
              filter_upwards [] with q
              rcases aux_vanishingDiagonalDirection_coords v q with ⟨h0, h1⟩
              rw [h0, h1]
              exact (Complex.ofReal_mul _ _).symm
      _ = ((∫ q : ℝ, D.kernel j (v.1 - q, v.2 - q) *
          standardBumpRescale (D.a (j - 1)) q : ℝ) : ℂ) :=
        integral_ofReal (𝕜 := ℂ) (μ := volume)
          (f := fun q : ℝ => D.kernel j (v.1 - q, v.2 - q) *
            standardBumpRescale (D.a (j - 1)) q)
  have hz := congrFun hrzero z
  have hz' : f z = conv z := sub_eq_zero.mp hz
  have hcast : (D.kernel j v : ℂ) =
      (aux_largeScaleSmoothing (D.kernel j) (D.a (j - 1)) v : ℂ) := by
    calc
      (D.kernel j v : ℂ) = f z := by simp [f, z]
      _ = conv z := hz'
      _ = (aux_largeScaleSmoothing (D.kernel j) (D.a (j - 1)) v : ℂ) := hconv_eval
  exact_mod_cast hcast.symm

theorem aux_largeScaleSmoothing_memW0 (M : RealPlane → ℝ) (hM : MemW0 M)
    {t : ℝ} (ht : 0 < t) : MemW0 (aux_largeScaleSmoothing M t) := by
  have hphi : MemW0 (standardBumpRescale t) := aux_standardBumpRescale_memW0 ht
  have hconv := aux_memW0_convolutionAlong M hM (standardBumpRescale t) hphi (1, 1)
  change MemW0 (fun v : RealPlane => ∫ q : ℝ,
    M (v.1 - q, v.2 - q) * standardBumpRescale t q)
  convert hconv using 1
  funext v
  rcases v with ⟨v₀, v₁⟩
  simp [smul_eq_mul, sub_eq_add_neg]

theorem aux_diagonalTranslate_integrable
    (M : RealPlane → ℝ) (hM : MemW0 M) (v : RealPlane) :
    Integrable (fun p : ℝ => M (v.1 - p, v.2 - p)) := by
  let S : RealPlane → ℝ := M ∘ aux_diagonalShear
  have hS : MemW0 S :=
    aux_memW0_comp_continuousLinearEquiv hM aux_diagonalShear
  have hG : MemW0 (fun q : ℝ => M ((v.1 - v.2) + q, q)) := by
    simpa [S, Function.comp_def, aux_diagonalShear] using
      hS.aux_memW0_slice_of_addHaar (v.1 - v.2)
  have hGint : Integrable (fun q : ℝ => M ((v.1 - v.2) + q, q)) :=
    aux_memW0_integrable_of_addHaar hG
  have hmp : MeasurePreserving (fun p : ℝ => v.2 - p) volume volume := by
    convert (Measure.measurePreserving_neg (volume : Measure ℝ)).comp
      (measurePreserving_sub_right (volume : Measure ℝ) v.2) using 1
    funext p
    simp only [Function.comp_apply]
    change v.2 - p = -(p - v.2)
    ring
  have hcomp := hmp.integrable_comp_of_integrable hGint
  convert hcomp using 1
  funext p
  dsimp
  ring_nf

theorem aux_diagonalSmoothing_integrand_integrable
    (M : RealPlane → ℝ) (hM : MemW0 M) (v : RealPlane)
    {t : ℝ} (ht : 0 < t) :
    Integrable (fun p : ℝ => M (v.1 - p, v.2 - p) * standardBumpRescale t p) := by
  have hbase := aux_diagonalTranslate_integrable M hM v
  have hphi : MemW0 (standardBumpRescale t) := aux_standardBumpRescale_memW0 ht
  have hmeas : AEStronglyMeasurable (standardBumpRescale t) volume :=
    hphi.1.aestronglyMeasurable
  have hbound : ∀ p : ℝ, ‖standardBumpRescale t p‖ ≤ t⁻¹ * (3 / 2) := by
    intro p
    rw [standardBumpRescale, Real.norm_eq_abs, abs_mul, abs_of_pos (inv_pos.mpr ht)]
    exact mul_le_mul_of_nonneg_left (aux_standardBump_abs_le_threeHalves _)
      (inv_nonneg.mpr ht.le)
  exact hbase.mul_bdd hmeas (Filter.Eventually.of_forall hbound)

theorem aux_diagonalBand_eq_smoothing_sub
    (M : ℤ → RealPlane → ℝ) (hM : ∀ j, MemW0 (M j)) (a : ℤ → ℝ)
    (ha : SpacedSequence a)
    (h : ℕ) (j : ℤ) :
    aux_diagonalBandKernel M a h j =
      aux_largeScaleSmoothing (M j) (rhoLowerScale a h j) -
        aux_largeScaleSmoothing (M j) (rhoUpperScale a h j) := by
  have hlow : 0 < rhoLowerScale a h j := by
    have hprev : 0 < a (j - 1) := aux_spacedSequence_pos ha _
    have hj : 0 < a j := aux_spacedSequence_pos ha _
    cases h with
    | zero => simpa [rhoLowerScale] using hprev
    | succ h =>
        rw [rhoLowerScale, if_neg (Nat.succ_ne_zero _), Nat.succ_sub_one]
        exact mul_pos (pow_pos (by norm_num) _) hj
  have hupper : 0 < rhoUpperScale a h j := by
    have hj : 0 < a j := aux_spacedSequence_pos ha _
    exact mul_pos (pow_pos (by norm_num) _) hj
  funext v
  rw [Pi.sub_apply]
  change (∫ q : ℝ, M j (v.1 - q, v.2 - q) *
      (standardBumpRescale (rhoLowerScale a h j) q -
        standardBumpRescale (rhoUpperScale a h j) q)) =
    (∫ q : ℝ, M j (v.1 - q, v.2 - q) * standardBumpRescale (rhoLowerScale a h j) q) -
      ∫ q : ℝ, M j (v.1 - q, v.2 - q) * standardBumpRescale (rhoUpperScale a h j) q
  rw [← integral_sub
    (aux_diagonalSmoothing_integrand_integrable (M j) (hM j) v hlow)
    (aux_diagonalSmoothing_integrand_integrable (M j) (hM j) v hupper)]
  apply integral_congr_ae
  filter_upwards [] with p
  ring

theorem aux_diagonalBand_partialSum
    (D : ReductionData) (hsupport : aux_frequencyDiagonalBound D) (H : ℕ) (j : ℤ) :
    (∑ h ∈ Finset.range (H + 1), aux_diagonalBandKernel D.kernel D.a h j) =
      D.kernel j - aux_largeScaleSmoothing (D.kernel j) ((2 : ℝ) ^ H * D.a j) := by
  induction H with
  | zero =>
      simp only [zero_add, Finset.sum_range_succ, Finset.sum_range_zero, zero_add]
      rw [aux_diagonalBand_eq_smoothing_sub D.kernel D.kernel_memW0 D.a D.a_spaced 0 j]
      simpa [rhoLowerScale, rhoUpperScale] using congrArg
        (fun f => f - aux_largeScaleSmoothing (D.kernel j) (D.a j))
        (aux_initialSmoothing_eq D hsupport j)
  | succ H ih =>
      have hindex : Nat.succ H + 1 = Nat.succ (H + 1) := by omega
      rw [hindex, Finset.sum_range_succ, ih,
        aux_diagonalBand_eq_smoothing_sub D.kernel D.kernel_memW0 D.a D.a_spaced
          (H + 1) j]
      simp only [rhoLowerScale, if_neg (Nat.succ_ne_zero _), Nat.succ_sub_one,
        rhoUpperScale]
      ring

theorem aux_diagonalBand_memW0 (D : ReductionData) (h : ℕ) (j : ℤ) :
    MemW0 (aux_diagonalBandSequence D h j) := by
  rcases reduction_scale_conditions D h j with ⟨hlow, hupper, _, _, _⟩
  have hphi : MemW0 (fun q : ℝ =>
      standardBumpRescale (rhoLowerScale D.a h j) q -
        standardBumpRescale (rhoUpperScale D.a h j) q) :=
    aux_memW0_sub (aux_standardBumpRescale_memW0 hlow)
      (aux_standardBumpRescale_memW0 hupper)
  have hconv := aux_memW0_convolutionAlong (D.kernel j) (D.kernel_memW0 j)
    (fun q : ℝ => standardBumpRescale (rhoLowerScale D.a h j) q -
      standardBumpRescale (rhoUpperScale D.a h j) q) hphi (1, 1)
  apply liftPlaneKernel_memW0
  change MemW0 (fun v : RealPlane => ∫ q : ℝ,
    D.kernel j (v.1 - q, v.2 - q) *
      (standardBumpRescale (rhoLowerScale D.a h j) q -
        standardBumpRescale (rhoUpperScale D.a h j) q))
  convert hconv using 1
  funext v
  rcases v with ⟨v₀, v₁⟩
  simp [smul_eq_mul, sub_eq_add_neg]

theorem aux_liftLargeScaleSmoothing_tendsto_zero
    (D : ReductionData) (j : ℤ) :
    Tendsto (fun H : ℕ => eLpNorm
      (aux_liftPlaneKernel
        (aux_largeScaleSmoothing (D.kernel j) ((2 : ℝ) ^ H * D.a j))) 1 volume)
      atTop (nhds 0) := by
  have hscale : Tendsto (fun H : ℕ => (2 : ℝ) ^ H * D.a j) atTop atTop :=
    (tendsto_pow_atTop_atTop_of_one_lt (by norm_num : (1 : ℝ) < 2)).atTop_mul_const
      (aux_spacedSequence_pos D.a_spaced j)
  have hraw := (lOneReduction (D.kernel j) (D.kernel_memW0 j)
    (D.diagonal_cancellation j)).comp hscale
  convert hraw using 1
  funext H
  rw [eLpNorm_liftPlaneKernel _
    (aux_largeScaleSmoothing_memW0 (D.kernel j) (D.kernel_memW0 j)
      (mul_pos (pow_pos (by norm_num) _) (aux_spacedSequence_pos D.a_spaced j)))]
  rfl

theorem aux_diagonalBand_prefix_tendsto
    (D : ReductionData) (hsupport : aux_frequencyDiagonalBound D)
    (J : {J : ℕ // 0 < J}) :
    Tendsto (fun H : ℕ => eLpNorm (fun y =>
      (∑ j ∈ Finset.range J.1,
        (∑ h ∈ Finset.range (H + 1), aux_diagonalBandSequence D h (j : ℤ) y)) -
        ∑ j ∈ Finset.range J.1, aux_liftPlaneKernel (D.kernel (j : ℤ)) y) 1 volume)
      atTop (nhds 0) := by
  let P : ℕ → KernelSequence 1 := fun H j y =>
    ∑ h ∈ Finset.range (H + 1), aux_diagonalBandSequence D h j y
  let R : ℕ → KernelSequence 1 := fun H j =>
    aux_liftPlaneKernel
      (aux_largeScaleSmoothing (D.kernel j) ((2 : ℝ) ^ H * D.a j))
  have htel (H : ℕ) (j : ℤ) :
      P H j = aux_liftPlaneKernel (D.kernel j) - R H j := by
    funext y
    change (∑ h ∈ Finset.range (H + 1),
      aux_diagonalBandKernel D.kernel D.a h j (y.1 0, y.2 0)) =
        D.kernel j (y.1 0, y.2 0) -
          aux_largeScaleSmoothing (D.kernel j) ((2 : ℝ) ^ H * D.a j) (y.1 0, y.2 0)
    simpa only [Finset.sum_apply, Pi.sub_apply] using
      congrFun (aux_diagonalBand_partialSum D hsupport H j) (y.1 0, y.2 0)
  have hRmem (H : ℕ) (j : ℤ) : MemW0 (R H j) := by
    dsimp [R]
    apply liftPlaneKernel_memW0
    apply aux_largeScaleSmoothing_memW0 (D.kernel j) (D.kernel_memW0 j)
    exact mul_pos (pow_pos (by norm_num) _) (aux_spacedSequence_pos D.a_spaced j)
  have hdiff (H : ℕ) :
      (fun y =>
        (∑ j ∈ Finset.range J.1, P H (j : ℤ) y) -
          ∑ j ∈ Finset.range J.1, aux_liftPlaneKernel (D.kernel (j : ℤ)) y) =
        - (fun y => ∑ j ∈ Finset.range J.1, R H (j : ℤ) y) := by
    funext y
    simp_rw [htel]
    simp only [Pi.sub_apply, Pi.neg_apply, Finset.sum_sub_distrib]
    ring
  have hsum : Tendsto (fun H : ℕ =>
      ∑ j ∈ Finset.range J.1, eLpNorm (R H (j : ℤ)) 1 volume)
      atTop (nhds 0) := by
    simpa using tendsto_finsetSum (Finset.range J.1)
      (fun j _ => aux_liftLargeScaleSmoothing_tendsto_zero D (j : ℤ))
  have hnorm (H : ℕ) : eLpNorm (fun y =>
      (∑ j ∈ Finset.range J.1, P H (j : ℤ) y) -
        ∑ j ∈ Finset.range J.1, aux_liftPlaneKernel (D.kernel (j : ℤ)) y) 1 volume ≤
      ∑ j ∈ Finset.range J.1, eLpNorm (R H (j : ℤ)) 1 volume := by
    rw [hdiff H, eLpNorm_neg]
    have hsum_le := eLpNorm_sum_le (p := (1 : ℝ≥0∞)) (μ := volume)
      (f := fun j : ℕ => R H (j : ℤ))
      (s := Finset.range J.1)
      (fun j _ => (hRmem H (j : ℤ)).1.aestronglyMeasurable) (by norm_num)
    have hfun : (∑ j ∈ Finset.range J.1, R H (j : ℤ)) =
        (fun y => ∑ j ∈ Finset.range J.1, R H (j : ℤ) y) := by
      funext y
      simp only [Finset.sum_apply]
    rw [← hfun]
    exact hsum_le
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le'
    (tendsto_const_nhds : Tendsto (fun _ : ℕ => (0 : ℝ≥0∞)) atTop (nhds 0)) hsum
  · exact Filter.Eventually.of_forall fun _ => bot_le
  · filter_upwards [] with H
    exact hnorm H

theorem aux_diagonalBand_target_mem (D : ReductionData) :
    MemKernelSequence 1 (fun j => aux_liftPlaneKernel (D.kernel j)) := by
  intro j
  exact liftPlaneKernel_memW0 _ (D.kernel_memW0 j)

theorem aux_diagonalBand_prefix_mem (D : ReductionData) (H : ℕ) :
    MemKernelSequence 1 (fun j y =>
      ∑ h ∈ Finset.range (H + 1), aux_diagonalBandSequence D h j y) := by
  intro j
  apply aux_memW0_finset_sum
  intro h hh
  exact aux_diagonalBand_memW0 D h j

theorem aux_diagonalBand_prefix_bound {n : ℕ} (hn : 2 ≤ n)
    (D : ReductionData) (H : ℕ) :
    kernelSequenceSeminorm n 1 (by omega) (by omega)
      (fun j y => ∑ h ∈ Finset.range (H + 1), aux_diagonalBandSequence D h j y) ≤
      ENNReal.ofReal C_diagonalBandReduction := by
  calc
    kernelSequenceSeminorm n 1 (by omega) (by omega)
        (fun j y => ∑ h ∈ Finset.range (H + 1), aux_diagonalBandSequence D h j y) ≤
        ∑ h ∈ Finset.range (H + 1),
          kernelSequenceSeminorm n 1 (by omega) (by omega)
            (aux_diagonalBandSequence D h) := by
          exact aux_kernelSequenceSeminorm_finset_sum_le (by omega) (by omega)
            (Finset.range (H + 1)) (aux_diagonalBandSequence D)
            (fun h _ => fun j => aux_diagonalBand_memW0 D h j)
    _ ≤ ∑' h : ℕ,
        kernelSequenceSeminorm n 1 (by omega) (by omega)
          (aux_diagonalBandSequence D h) := ENNReal.sum_le_tsum _
    _ ≤ ENNReal.ofReal C_diagonalBandReduction := diagonalBandReduction hn D

/--
\begin{proposition}[vanishing diagonal - reduction variant]
\label{P:vanishing-diagonal-reduction}
Let $a\in A$ and let $\mathcal P$, $(M_j)_{j\in \Z}$ be as in Proposition~
[`Codex.Reduction.OnDiagonalMainArgument.increaseDataReduction`]. In addition, assume that
$\widehat{M_j}(\xi,\eta)$ is supported where $|\xi+\eta| \leq 2^{-1} (a(j-1))^{-1}$.
Let $\mathbf{M}=(M_j)_{j\in \Z}$. Then
\begin{equation}\label{auto:vanishing-diagonal-M-bound}
\|\mathbf{M}\|_{\rm M(1)} \leq C_{\text{P:diagonal-band-reduction}}
\end{equation}
\end{proposition}

See also [`Codex.Reduction.OnDiagonalOffDiagonal.diagonalBandReduction`].
-/
theorem vanishingDiagonalReduction {n : ℕ} (hn : 2 ≤ n) (D : ReductionData)
    (hsupport : aux_frequencyDiagonalBound D) :
    kernelSequenceSeminorm n 1 (by omega) (by omega)
      (fun j => aux_liftPlaneKernel (D.kernel j)) ≤
        ENNReal.ofReal C_diagonalBandReduction := by
  let P : ℕ → KernelSequence 1 := fun H j y =>
    ∑ h ∈ Finset.range (H + 1), aux_diagonalBandSequence D h j y
  apply Codex.MainArgument.MainInduction.aux_kernelSequenceSeminorm_le_of_prefix_tendsto_eLpNorm
    (by omega) (by omega)
    (fun j => aux_liftPlaneKernel (D.kernel j)) P
      (ENNReal.ofReal C_diagonalBandReduction)
  · exact aux_diagonalBand_target_mem D
  · intro H
    exact aux_diagonalBand_prefix_mem D H
  · intro H
    exact aux_diagonalBand_prefix_bound hn D H
  · intro J
    simpa [P] using aux_diagonalBand_prefix_tendsto D hsupport J

/-- The (L^1)-normalized rescaling of a window component. -/
noncomputable def aux_windowRescale (phi : SchwartzMap ℝ ℝ) (t : ℝ) : ℝ → ℝ :=
  fun x => t⁻¹ * phi (t⁻¹ * x)

/-- The telescoping window kernel from Proposition
[`Codex.Reduction.OnDiagonalOffDiagonal.oneScaleEstimateWindow`]. -/
noncomputable def aux_oneScaleWindowKernel (phi : SchwartzMap ℝ ℝ) (a : ℤ → ℝ)
    (j : ℤ) : RealPlane → ℝ :=
  fun v => tensorSquare (aux_windowRescale phi (a (j - 1))) v -
    tensorSquare (aux_windowRescale phi (a j)) v

/-- The sequence of telescoping window kernels. -/
noncomputable def aux_oneScaleWindowSequence (phi : SchwartzMap ℝ ℝ) (a : ℤ → ℝ) :
    KernelSequence 1 :=
  fun j => aux_liftPlaneKernel (aux_oneScaleWindowKernel phi a j)

/-- The constant in Proposition [`Codex.Reduction.OnDiagonalOffDiagonal.oneScaleEstimateWindow`]. -/
noncomputable def C_oneScaleEstimateWindow : ℝ :=
  (2 : ℝ) ^ 9 * C_uniPair ^ 2

theorem aux_schwartzMap_memW0_real (phi : SchwartzMap ℝ ℝ) : MemW0 phi := by
  let e : EuclideanSpace ℝ (Fin 1) ≃L[ℝ] ℝ :=
    PiLp.equivOfUnique 2 ℝ (fun _ : Fin 1 => ℝ)
  let Phi : SchwartzMap (EuclideanSpace ℝ (Fin 1)) ℝ :=
    SchwartzMap.compCLMOfContinuousLinearEquiv ℝ e phi
  have hPhi : MemW0 Phi := SchwartzMap.memW0 Phi
  have hraw := aux_memW0_comp_continuousLinearEquiv hPhi e.symm
  convert hraw using 1
  funext x
  change phi x = phi (e (e.symm x))
  rw [e.apply_symm_apply]

theorem aux_windowRescale_memW0 (phi : SchwartzMap ℝ ℝ) {t : ℝ} (ht : 0 < t) :
    MemW0 (aux_windowRescale phi t) := by
  let e : ℝ ≃L[ℝ] ℝ :=
    ContinuousLinearEquiv.smulLeft (Units.mk0 t⁻¹ (inv_ne_zero ht.ne'))
  let Phi : SchwartzMap ℝ ℝ :=
    t⁻¹ • SchwartzMap.compCLMOfContinuousLinearEquiv ℝ e phi
  have hPhi : MemW0 Phi := aux_schwartzMap_memW0_real Phi
  convert hPhi using 1
  funext x
  simp [Phi, e, aux_windowRescale, ContinuousLinearEquiv.smulLeft_apply_apply]

theorem aux_window_decay (phi : SchwartzMap ℝ ℝ)
    (hwin : cnWindow C_uniPair N_uniPair phi) (x : ℝ) :
    |phi x| ≤ 8 * C_uniPair * bracketBump x ^ 2 := by
  let q : ℝ → ℂ := FourierTransform.fourier (fun y : ℝ => (phi y : ℂ))
  have hqCont : ContDiff ℝ 2 q := by
    let phiC : SchwartzMap ℝ ℂ :=
      phi.postcompCLM (𝕜 := ℝ) Complex.ofRealCLM
    have hs : ContDiff ℝ 2 (FourierTransform.fourier phiC : ℝ → ℂ) :=
      (FourierTransform.fourier phiC).smooth 2
    have hphiC : (phiC : ℝ → ℂ) = fun y : ℝ => (phi y : ℂ) := by
      funext y
      simp [phiC, SchwartzMap.postcompCLM_apply]
    rw [SchwartzMap.fourier_coe, hphiC] at hs
    exact hs
  have hqSupp : tsupport q ⊆ Set.Icc (-1 : ℝ) 1 := by
    dsimp [q]
    exact closure_minimal hwin.2.2.1 isClosed_Icc
  have hqzero : ∀ xi : ℝ, ‖q xi‖ ≤ C_uniPair := by
    intro xi
    by_cases hxi : xi ∈ Set.Icc (-1 : ℝ) 1
    · exact hwin.2.2.2.2 xi hxi 0 (by omega)
    · have hqSupp' : Function.support q ⊆ Set.Icc (-1 : ℝ) 1 :=
        (subset_tsupport _).trans hqSupp
      have hzero : q xi = 0 := by
        apply Function.notMem_support.mp
        intro hqxi
        exact hxi (hqSupp' hqxi)
      rw [hzero, norm_zero]
      norm_num [C_uniPair]
  have hfac : ((2 * Real.pi)⁻¹ : ℝ) ^ 2 ≤ 1 := by
    have hbase : (2 * Real.pi)⁻¹ ≤ 1 := by
      exact (le_of_lt aux_inv_two_pi_lt_sixth).trans (by norm_num)
    exact pow_le_one₀ (by positivity) hbase
  have hqNth : ∀ xi : ℝ,
      ((2 * Real.pi)⁻¹ : ℝ) ^ 2 * ‖iteratedDeriv 2 q xi‖ ≤ C_uniPair := by
    intro xi
    have hderiv : ‖iteratedDeriv 2 q xi‖ ≤ C_uniPair := by
      by_cases hxi : xi ∈ Set.Icc (-1 : ℝ) 1
      · exact hwin.2.2.2.2 xi hxi 2 (by norm_num [N_uniPair])
      · have hderivSupp : Function.support (iteratedDeriv 2 q) ⊆ Set.Icc (-1 : ℝ) 1 :=
          (subset_tsupport _).trans
            ((aux_tsupport_iteratedDeriv_subset q 2).trans hqSupp)
        have hzero : iteratedDeriv 2 q xi = 0 := by
          apply Function.notMem_support.mp
          intro hqxi
          exact hxi (hderivSupp hqxi)
        rw [hzero, norm_zero]
        norm_num [C_uniPair]
    calc
      ((2 * Real.pi)⁻¹ : ℝ) ^ 2 * ‖iteratedDeriv 2 q xi‖ ≤
          1 * ‖iteratedDeriv 2 q xi‖ :=
        mul_le_mul_of_nonneg_right hfac (norm_nonneg _)
      _ = ‖iteratedDeriv 2 q xi‖ := one_mul _
      _ ≤ C_uniPair := hderiv
  have hphiCont : Continuous (fun y : ℝ => (phi y : ℂ)) :=
    Complex.ofRealCLM.continuous.comp phi.continuous
  have hphiInt : Integrable (fun y : ℝ => (phi y : ℂ)) := phi.integrable.ofReal
  have hqCompact : HasCompactSupport q :=
    isCompact_Icc.of_isClosed_subset isClosed_closure hqSupp
  have hqInt : Integrable q := hqCont.continuous.integrable_of_hasCompactSupport hqCompact
  have hinv : FourierTransformInv.fourierInv q = fun y : ℝ => (phi y : ℂ) := by
    dsimp [q]
    exact hphiCont.fourierInv_fourier_eq hphiInt hqInt
  have hdecay := aux_fourScaleGaussian_rescaledSmoothDecay2 2 (by norm_num)
    q hqCont hqSupp C_uniPair C_uniPair (1 : ℝ)
    (by norm_num [C_uniPair]) (by norm_num [C_uniPair]) hqzero hqNth (by norm_num)
  have hqone : (fun xi : ℝ => q ((1 : ℝ) * xi)) = q := by
    funext xi
    simp
  rw [hqone, hinv] at hdecay
  have hpoint := hdecay.2 x
  change ‖(phi x : ℂ)‖ ≤ _ at hpoint
  rw [Complex.norm_real] at hpoint
  norm_num [C_smoothDecay2, scaledBracketBump, bracketBump, inv_pow] at hpoint ⊢
  exact hpoint

theorem aux_bracket_integral_two :
    (∫ x : ℝ, bracketBump x ^ 2) = 2 := by
  calc
    (∫ x : ℝ, bracketBump x ^ 2) =
        ∫ x : ℝ, (1 + |x|) ^ (-(2 : ℝ)) := by
      congr 1
      funext x
      rw [bracketBump, inv_pow]
      rw [Real.rpow_neg (by positivity)]
      congr 1
      exact (Real.rpow_natCast (1 + |x|) 2).symm
    _ = 2 := by
      rw [aux_twoBump_baseIntegral 2 (by norm_num)]
      norm_num

theorem aux_bracket_integrable_two : Integrable (fun x : ℝ => bracketBump x ^ 2) := by
  convert aux_twoBump_baseIntegrable 2 (by norm_num) using 1
  funext x
  rw [bracketBump, inv_pow]
  rw [Real.rpow_neg (by positivity)]
  congr 1
  exact (Real.rpow_natCast (1 + |x|) 2).symm

theorem aux_window_l1_bound (phi : SchwartzMap ℝ ℝ)
    (hwin : cnWindow C_uniPair N_uniPair phi) :
    (∫ x : ℝ, ‖phi x‖) ≤ 16 * C_uniPair := by
  have hpoint : ∀ x : ℝ, ‖phi x‖ ≤ 8 * C_uniPair * bracketBump x ^ 2 := by
    intro x
    rw [Real.norm_eq_abs]
    exact aux_window_decay phi hwin x
  have hmajor : Integrable (fun x : ℝ => 8 * C_uniPair * bracketBump x ^ 2) := by
    exact aux_bracket_integrable_two.const_mul _
  calc
    (∫ x : ℝ, ‖phi x‖) ≤ ∫ x : ℝ, 8 * C_uniPair * bracketBump x ^ 2 := by
      exact integral_mono phi.integrable.norm hmajor (fun x => hpoint x)
    _ = 8 * C_uniPair * (∫ x : ℝ, bracketBump x ^ 2) := by
      rw [integral_const_mul]
    _ = 16 * C_uniPair := by rw [aux_bracket_integral_two]; ring

theorem aux_windowRescale_integral_norm_eq (phi : SchwartzMap ℝ ℝ)
    {t : ℝ} (ht : 0 < t) :
    (∫ x : ℝ, ‖aux_windowRescale phi t x‖) = ∫ y : ℝ, ‖phi y‖ := by
  unfold aux_windowRescale
  calc
    (∫ x : ℝ, ‖t⁻¹ * phi (t⁻¹ * x)‖) =
        t⁻¹ * ∫ x : ℝ, ‖phi (t⁻¹ * x)‖ := by
      rw [show (fun x : ℝ => ‖t⁻¹ * phi (t⁻¹ * x)‖) =
          fun x : ℝ => t⁻¹ * ‖phi (t⁻¹ * x)‖ by
            funext x
            rw [norm_mul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr ht)],
        integral_const_mul]
    _ = t⁻¹ * (|t| * ∫ y : ℝ, ‖phi y‖) := by
      rw [MeasureTheory.Measure.integral_comp_inv_mul_left (fun y : ℝ => ‖phi y‖) t,
        smul_eq_mul]
    _ = ∫ y : ℝ, ‖phi y‖ := by
      rw [abs_of_pos ht]
      field_simp

theorem aux_windowRescale_l1_bound (phi : SchwartzMap ℝ ℝ)
    (hwin : cnWindow C_uniPair N_uniPair phi) {t : ℝ} (ht : 0 < t) :
    (∫ x : ℝ, ‖aux_windowRescale phi t x‖) ≤ 16 * C_uniPair := by
  rw [aux_windowRescale_integral_norm_eq phi ht]
  exact aux_window_l1_bound phi hwin

theorem aux_window_boundary_l1 (phi : SchwartzMap ℝ ℝ)
    (hwin : cnWindow C_uniPair N_uniPair phi) {t : ℝ} (ht : 0 < t) :
    eLpNorm (aux_liftPlaneKernel (tensorSquare (aux_windowRescale phi t))) 1 volume ≤
      ENNReal.ofReal (256 * C_uniPair ^ 2) := by
  let f : ℝ → ℝ := aux_windowRescale phi t
  have hf : MemW0 f := by
    dsimp [f]
    exact aux_windowRescale_memW0 phi ht
  have hT : MemW0 (tensorSquare f) := aux_memW0_tensorSquare f hf
  have hTint : Integrable (tensorSquare f) := aux_memW0_integrable_of_addHaar hT
  have hL1 : (∫ x : ℝ, ‖f x‖) ≤ 16 * C_uniPair := by
    dsimp [f]
    exact aux_windowRescale_l1_bound phi hwin ht
  have hprodint : (∫ v : RealPlane, ‖tensorSquare f v‖) ≤ 256 * C_uniPair ^ 2 := by
    have hI0 : 0 ≤ ∫ x : ℝ, ‖f x‖ := integral_nonneg fun x => norm_nonneg _
    have hC0 : 0 ≤ 16 * C_uniPair := by norm_num [C_uniPair]
    calc
      (∫ v : RealPlane, ‖tensorSquare f v‖) =
          ∫ v : ℝ × ℝ, ‖f v.1‖ * ‖f v.2‖ := by
        congr 1
        funext v
        simp only [tensorSquare, norm_mul]
      _ = (∫ x : ℝ, ‖f x‖) * ∫ y : ℝ, ‖f y‖ := by
        simpa only [Measure.volume_eq_prod] using
          integral_prod_mul (fun x : ℝ => ‖f x‖) (fun y : ℝ => ‖f y‖)
      _ ≤ (16 * C_uniPair) * (16 * C_uniPair) :=
        mul_le_mul hL1 hL1 hI0 hC0
      _ = 256 * C_uniPair ^ 2 := by ring
  calc
    eLpNorm (aux_liftPlaneKernel (tensorSquare f)) 1 volume =
        eLpNorm (tensorSquare f) 1 volume := eLpNorm_liftPlaneKernel _ hT
    _ ≤ ENNReal.ofReal (256 * C_uniPair ^ 2) :=
      aux_eLpNorm_one_le_of_integral_norm_le hTint hprodint

theorem aux_oneScale_telescope (phi : SchwartzMap ℝ ℝ) (a : ℤ → ℝ) :
    ∀ J y, (∑ j ∈ Finset.range J,
      aux_oneScaleWindowSequence phi a (j : ℤ) y) =
        aux_liftPlaneKernel (tensorSquare (aux_windowRescale phi (a (-1)))) y -
          aux_liftPlaneKernel (tensorSquare (aux_windowRescale phi (a ((J : ℤ) - 1)))) y := by
  intro J y
  have htel := Finset.sum_range_sub'
    (fun i : ℕ => aux_liftPlaneKernel
      (tensorSquare (aux_windowRescale phi (a ((i : ℤ) - 1)))) y) J
  convert htel using 1 <;>
    simp only [aux_oneScaleWindowSequence, aux_oneScaleWindowKernel,
      aux_liftPlaneKernel] <;>
    push_cast <;> ring_nf

/--
\begin{proposition}\label{P:one-scale-estimate-window}
Let $a\in A$. For $j\in \Z$, we set
\begin{equation}\label{auto:one-scale-window-kernel}
M_j=(\phi_{0,a(j-1)})^{\otimes 2} - (\phi_{0,a(j)})^{\otimes 2}
\end{equation}
and $\mathbf{M}=(M_j)_{j\in \Z}$. Then
\begin{equation}\label{E:telescoping-estimate}
\|\mathbf{M}\|_{\rm M(1)} \leq C_{\text{P:one-scale-estimate-window}},
\end{equation}
where $C_{\text{P:one-scale-estimate-window}}=2^9C_{\text{def:unipair}}^2$.


\end{proposition}

See also [`Codex.Reduction.OnDiagonalOffDiagonal.oneScaleEstimateWindow`],
[`Codex.Reduction.WindowsAndPairs.uniPair`].
-/
theorem oneScaleEstimateWindow {n : ℕ} (hn : 2 ≤ n) (a : ℤ → ℝ)
    (ha : SpacedSequence a) (phi0 phi1 : SchwartzMap ℝ ℝ)
    (hpair : uniPair phi0 phi1) :
    kernelSequenceSeminorm n 1 (by omega) (by omega)
      (aux_oneScaleWindowSequence phi0 a) ≤ ENNReal.ofReal C_oneScaleEstimateWindow := by
  let B : ℤ → MKernel 1 := fun j =>
    aux_liftPlaneKernel (tensorSquare (aux_windowRescale phi0 (a j)))
  have hB : ∀ j, MemW0 (B j) := by
    intro j
    dsimp [B]
    exact liftPlaneKernel_memW0 _
      (aux_memW0_tensorSquare _ (aux_windowRescale_memW0 phi0 (ha j).1))
  have hBnorm : ∀ j, eLpNorm (B j) 1 volume ≤
      ENNReal.ofReal (256 * C_uniPair ^ 2) := by
    intro j
    dsimp [B]
    exact aux_window_boundary_l1 phi0 hpair.1 (ha j).1
  have htel : ∀ J y, (∑ j ∈ Finset.range J,
      aux_oneScaleWindowSequence phi0 a (j : ℤ) y) =
      B (-1) y - B ((J : ℤ) - 1) y := by
    intro J y
    simpa only [B] using aux_oneScale_telescope phi0 a J y
  have hmain := aux_kernelSequenceSeminorm_le_of_telescope
    (n := n) (k := 1) (by omega) (by omega) (256 * C_uniPair ^ 2)
    (by norm_num [C_uniPair]) B (aux_oneScaleWindowSequence phi0 a) hB hBnorm htel
  calc
    kernelSequenceSeminorm n 1 (by omega) (by omega)
        (aux_oneScaleWindowSequence phi0 a) ≤
        ENNReal.ofReal (2 * (256 * C_uniPair ^ 2)) := hmain
    _ = ENNReal.ofReal C_oneScaleEstimateWindow := by
      congr 1
      unfold C_oneScaleEstimateWindow
      ring

/--
\begin{lemma}[constant $C_{\text{P:one-scale-estimate-window}}$ \auto]
\label{auto:constant-one-scale-window}
\begin{equation}\label{auto:constant-one-scale-window-bound}
C_{\text{P:one-scale-estimate-window}}=2^{39}.
\end{equation}
\end{lemma}

See also [`Codex.Reduction.OnDiagonalOffDiagonal.oneScaleEstimateWindow`].
-/
theorem constantOneScaleWindow : C_oneScaleEstimateWindow = (2 : ℝ) ^ 39 := by
  norm_num [C_oneScaleEstimateWindow, C_uniPair]

/-- The `L¹`-normalized rescaling of a Schwartz window is integrable. -/
theorem aux_windowRescale_integrable (phi : SchwartzMap ℝ ℝ)
    (t : ℝ) (ht : 0 < t) :
    Integrable (aux_windowRescale phi t) := by
  unfold aux_windowRescale
  convert (phi.integrable.comp_mul_left' (inv_ne_zero ht.ne')).const_mul t⁻¹ using 1

/-- Fourier transform commutes with subtraction for integrable real-valued functions. -/
theorem aux_fourier_sub_of_integrable (f g : ℝ → ℝ)
    (hf : Integrable f) (hg : Integrable g) (xi : ℝ) :
    FourierTransform.fourier (fun x : ℝ => ((f x - g x : ℝ) : ℂ)) xi =
      FourierTransform.fourier (fun x : ℝ => (f x : ℂ)) xi -
        FourierTransform.fourier (fun x : ℝ => (g x : ℂ)) xi := by
  let e : ℝ → ℂ := fun x => Complex.exp (↑(-2 * Real.pi * x * xi) * Complex.I)
  have he : Continuous e := by
    dsimp [e]
    fun_prop
  have he_bound : ∀ x, ‖e x‖ ≤ (1 : ℝ) := by
    intro x
    rw [show e x = Complex.exp (((-2 * Real.pi * x * xi : ℝ) : ℂ) * Complex.I) by rfl,
      Complex.norm_exp]
    norm_num
  have hf' : Integrable (fun x : ℝ => e x * (f x : ℂ)) :=
    hf.ofReal.bdd_mul he.aestronglyMeasurable (ae_of_all _ he_bound)
  have hg' : Integrable (fun x : ℝ => e x * (g x : ℂ)) :=
    hg.ofReal.bdd_mul he.aestronglyMeasurable (ae_of_all _ he_bound)
  rw [Real.fourier_real_eq_integral_exp_smul,
    Real.fourier_real_eq_integral_exp_smul,
    Real.fourier_real_eq_integral_exp_smul]
  change (∫ x : ℝ, e x * ((f x - g x : ℝ) : ℂ)) = _
  calc
    (∫ x : ℝ, e x * ((f x - g x : ℝ) : ℂ)) =
        ∫ x : ℝ, (e x * (f x : ℂ) - e x * (g x : ℂ)) := by
          apply integral_congr_ae
          filter_upwards [] with x
          push_cast
          ring
    _ = (∫ x : ℝ, e x * (f x : ℂ)) - ∫ x : ℝ, e x * (g x : ℂ) :=
      integral_sub hf' hg'
    _ = _ := by rfl

/-- Fourier transform converts a positive `L¹`-normalized window rescaling
into frequency rescaling. -/
theorem aux_windowRescale_fourier (t : ℝ) (ht : 0 < t)
    (phi : SchwartzMap ℝ ℝ) (xi : ℝ) :
    FourierTransform.fourier (fun x : ℝ => (aux_windowRescale phi t x : ℂ)) xi =
      FourierTransform.fourier (fun x : ℝ => (phi x : ℂ)) (t * xi) := by
  rw [Real.fourier_real_eq_integral_exp_smul,
    Real.fourier_real_eq_integral_exp_smul]
  let g : ℝ → ℂ := fun q => (phi q : ℂ) *
    Complex.exp (-((2 : ℂ) * Real.pi * Complex.I * (q : ℂ) * ((t * xi : ℝ) : ℂ)))
  calc
    (∫ x : ℝ, Complex.exp (↑(-2 * Real.pi * x * xi) * Complex.I) •
        (aux_windowRescale phi t x : ℂ)) = ∫ x : ℝ, (t⁻¹ : ℂ) * g (t⁻¹ * x) := by
      apply integral_congr_ae
      filter_upwards [] with x
      dsimp [g, aux_windowRescale]
      have hphase : Complex.exp (↑(-2 * Real.pi * x * xi) * Complex.I) =
          Complex.exp (-((2 : ℂ) * Real.pi * Complex.I * ((t⁻¹ * x : ℝ) : ℂ) *
            ((t * xi : ℝ) : ℂ))) := by
        congr 1
        push_cast
        field_simp [ne_of_gt ht]
      rw [hphase]
      push_cast
      ring
    _ = (t⁻¹ : ℂ) * ∫ x : ℝ, g (t⁻¹ * x) := by rw [integral_const_mul]
    _ = (t⁻¹ : ℂ) * (|t| • ∫ y : ℝ, g y) := by
      rw [Measure.integral_comp_inv_mul_left]
    _ = ∫ y : ℝ, g y := by
      rw [abs_of_pos ht]
      field_simp [ne_of_gt ht]
      rw [Complex.real_smul]
    _ = ∫ x : ℝ, Complex.exp (↑(-2 * Real.pi * x * (t * xi)) * Complex.I) •
        (phi x : ℂ) := by
      apply integral_congr_ae
      filter_upwards [] with x
      dsimp [g]
      push_cast
      ring_nf

/-- The elementary square rearrangement used in `fourierTransformWindow`. -/
theorem aux_window_square_fourier_algebra (A B C : ℂ)
    (hAB : A * B = B) (hBC : C ^ 2 + (1 - B) ^ 2 = 1) :
    (A - B) ^ 2 = A ^ 2 - C ^ 2 := by
  calc
    (A - B) ^ 2 = A ^ 2 - 2 * (A * B) + B ^ 2 := by ring
    _ = A ^ 2 - 2 * B + B ^ 2 := by rw [hAB]
    _ = A ^ 2 + (1 - B) ^ 2 - 1 := by ring
    _ = A ^ 2 - C ^ 2 := by linear_combination hBC

/--
\begin{lemma}\label{L:fourier-transform-window}
Let $a\in A$. Then for any $j\in \Z$,
\begin{equation}\label{auto:window-square-Fourier-identity}
\mathcal F({\phi}_{0,a(j-1)}-{\phi}_{1,a(j)})^2=
(\widehat{{\phi}_{0,a(j-1)}})^2-(\widehat{{\phi}_{0,a(j)}})^2.
\end{equation}
\end{lemma}
-/
theorem fourierTransformWindow (a : ℤ → ℝ) (ha : SpacedSequence a)
    (phi0 phi1 : SchwartzMap ℝ ℝ) (hpair : uniPair phi0 phi1)
    (j : ℤ) (xi : ℝ) :
    FourierTransform.fourier
        (fun x : ℝ =>
          (aux_windowRescale phi0 (a (j - 1)) x - aux_windowRescale phi1 (a j) x : ℂ)) xi ^ 2 =
      FourierTransform.fourier
          (fun x : ℝ => (aux_windowRescale phi0 (a (j - 1)) x : ℂ)) xi ^ 2 -
        FourierTransform.fourier
          (fun x : ℝ => (aux_windowRescale phi0 (a j) x : ℂ)) xi ^ 2 := by
  have hs : 0 < a (j - 1) := aux_spacedSequence_pos ha _
  have ht : 0 < a j := aux_spacedSequence_pos ha _
  have hscale : 2 * a (j - 1) ≤ a j := by
    convert (ha (j - 1)).2 using 1; ring_nf
  have hres0 : Integrable (aux_windowRescale phi0 (a (j - 1))) :=
    aux_windowRescale_integrable phi0 _ hs
  have hres1 : Integrable (aux_windowRescale phi1 (a j)) :=
    aux_windowRescale_integrable phi1 _ ht
  have hcross :
      FourierTransform.fourier (fun x : ℝ => (phi0 x : ℂ)) (a (j - 1) * xi) *
        FourierTransform.fourier (fun x : ℝ => (phi1 x : ℂ)) (a j * xi) =
      FourierTransform.fourier (fun x : ℝ => (phi1 x : ℂ)) (a j * xi) := by
    by_cases hzero : FourierTransform.fourier (fun x : ℝ => (phi1 x : ℂ)) (a j * xi) = 0
    · rw [hzero, mul_zero]
    · have hmem : a j * xi ∈
          Function.support (FourierTransform.fourier (fun x : ℝ => (phi1 x : ℂ))) :=
        Function.mem_support.mpr hzero
      have hbound : a j * xi ∈ Set.Icc (-1 : ℝ) 1 := hpair.2.1.2.2.1 hmem
      have hhalf : |a (j - 1) * xi| ≤ 1 / 2 := by
        have hcoef : a (j - 1) ≤ a j / 2 := by linarith
        have hlarge : |a j * xi| ≤ 1 := abs_le.mpr hbound
        calc
          |a (j - 1) * xi| = a (j - 1) * |xi| := by
            rw [abs_mul, abs_of_pos hs]
          _ ≤ (a j / 2) * |xi| :=
            mul_le_mul_of_nonneg_right hcoef (abs_nonneg _)
          _ = (1 / 2 : ℝ) * |a j * xi| := by
            rw [abs_mul, abs_of_pos ht]
            ring
          _ ≤ (1 / 2 : ℝ) * 1 :=
            mul_le_mul_of_nonneg_left hlarge (by norm_num)
          _ = 1 / 2 := by ring
      have hunit : FourierTransform.fourier (fun x : ℝ => (phi0 x : ℂ))
          (a (j - 1) * xi) = 1 :=
        hpair.1.2.2.2.1 _ (abs_le.mp hhalf)
      rw [hunit, one_mul]
  have hcast : (fun x : ℝ =>
      (aux_windowRescale phi0 (a (j - 1)) x - aux_windowRescale phi1 (a j) x : ℂ)) =
      (fun x : ℝ =>
        ((aux_windowRescale phi0 (a (j - 1)) x - aux_windowRescale phi1 (a j) x : ℝ) : ℂ)) := by
    funext x
    push_cast
    rfl
  rw [hcast, aux_fourier_sub_of_integrable _ _ hres0 hres1 xi,
    aux_windowRescale_fourier _ hs phi0 xi,
    aux_windowRescale_fourier _ ht phi1 xi,
    aux_windowRescale_fourier _ ht phi0 xi]
  exact aux_window_square_fourier_algebra _ _ _ hcross (hpair.2.2 _)

/--
\begin{lemma} \label{lem:scaleest}
For any $x\in \R$ and $\lambda, s>0$,
    \begin{equation}\label{auto:scaled-bracket-comparison}
    \langle x \rangle^2_{(\lambda s)} \le
    \max\{\lambda,\lambda^{-1}\}\langle x \rangle^2_{(s)}
    \end{equation}
\end{lemma}
-/
theorem scaleEstimate (x lambda s : ℝ) (hlambda : 0 < lambda) (hs : 0 < s) :
    scaledBracketBump 2 (lambda * s) x ≤
      max lambda lambda⁻¹ * scaledBracketBump 2 s x := by
  have hformula (t : ℝ) (ht : 0 < t) :
      scaledBracketBump 2 t x = t / (t + |x|) ^ 2 := by
    unfold scaledBracketBump
    have htne : t ≠ 0 := ne_of_gt ht
    have hsumne : t + |x| ≠ 0 := ne_of_gt
      (add_pos_of_pos_of_nonneg ht (abs_nonneg x))
    have hinnerne : 1 + t⁻¹ * |x| ≠ 0 := ne_of_gt (by positivity)
    rw [abs_mul, abs_inv, abs_of_pos ht]
    field_simp [htne, hsumne, hinnerne]
  by_cases hlambda_one : 1 ≤ lambda
  · have hscale : s ≤ lambda * s := by nlinarith
    have hsum : s + |x| ≤ lambda * s + |x| := by linarith
    have hsum_pos : 0 < s + |x| := by positivity
    have hden : (s + |x|) ^ 2 ≤ (lambda * s + |x|) ^ 2 :=
      pow_le_pow_left₀ hsum_pos.le hsum 2
    rw [hformula (lambda * s) (mul_pos hlambda hs), hformula s hs]
    calc
      lambda * s / (lambda * s + |x|) ^ 2 ≤
          lambda * s / (s + |x|) ^ 2 :=
        div_le_div_of_nonneg_left (mul_nonneg hlambda.le hs.le) (pow_pos hsum_pos _) hden
      _ = lambda * (s / (s + |x|) ^ 2) := by ring
      _ ≤ max lambda lambda⁻¹ * (s / (s + |x|) ^ 2) :=
        mul_le_mul_of_nonneg_right (le_max_left _ _) (by positivity)
  · have hlambda_le : lambda ≤ 1 := le_of_not_ge hlambda_one
    have hscale : lambda * s ≤ s := by nlinarith
    have hAeq : lambda⁻¹ * (lambda * s) = s := by
      field_simp [ne_of_gt hlambda]
    have hcomp := aux_scaledBracketBump_scale_le 2
      (s := lambda * s) (t := s) (A := lambda⁻¹) (x := x)
      (mul_pos hlambda hs) hs hscale (inv_nonneg.mpr hlambda.le) (by rw [hAeq])
    calc
      scaledBracketBump 2 (lambda * s) x ≤ lambda⁻¹ * scaledBracketBump 2 s x := hcomp
      _ ≤ max lambda lambda⁻¹ * scaledBracketBump 2 s x :=
        mul_le_mul_of_nonneg_right (le_max_right _ _)
          (aux_scaledBracketBump_nonneg 2 hs x)

/-- The non-Whitney window difference kernel. -/
noncomputable def aux_nonWhitneyKernel (phi0 phi1 : SchwartzMap ℝ ℝ) (a : ℤ → ℝ)
    (j : ℤ) : RealPlane → ℝ :=
  tensorSquare (fun x => aux_windowRescale phi0 (a (j - 1)) x -
    aux_windowRescale phi1 (a j) x)

/-- The non-Whitney kernel sequence. -/
noncomputable def aux_nonWhitneySequence (phi0 phi1 : SchwartzMap ℝ ℝ) (a : ℤ → ℝ) :
    KernelSequence 1 :=
  fun j => aux_liftPlaneKernel (aux_nonWhitneyKernel phi0 phi1 a j)

/-- The constant in the non-Whitney reduction estimate. -/
noncomputable def C_inductPositiveTermsReductionNonWhitney : ℝ :=
  C_oneScaleEstimateWindow +
    128 * max 1 ((C_uniPair / (2 * Real.pi)) ^ 4) * C_smoothDecay2 2 ^ 2 *
      C_diagonalBandReduction

/-- The part of the non-Whitney window kernel not accounted for by the
one-scale telescoping window sequence. -/
noncomputable def aux_nonWhitneyCorrection (phi0 phi1 : SchwartzMap ℝ ℝ)
    (a : ℤ → ℝ) (j : ℤ) : RealPlane → ℝ :=
  aux_nonWhitneyKernel phi0 phi1 a j - aux_oneScaleWindowKernel phi0 a j

/-- The correction is a Wiener kernel, so it can be used as reduction data. -/
theorem aux_nonWhitneyCorrection_memW0 (a : ℤ → ℝ) (ha : SpacedSequence a)
    (phi0 phi1 : SchwartzMap ℝ ℝ) (j : ℤ) :
    MemW0 (aux_nonWhitneyCorrection phi0 phi1 a j) := by
  apply aux_memW0_sub
  · apply aux_memW0_tensorSquare
    apply aux_memW0_sub
    · exact aux_windowRescale_memW0 phi0 (ha _).1
    · exact aux_windowRescale_memW0 phi1 (ha _).1
  · apply aux_memW0_sub
    · apply aux_memW0_tensorSquare
      exact aux_windowRescale_memW0 phi0 (ha _).1
    · apply aux_memW0_tensorSquare
      exact aux_windowRescale_memW0 phi0 (ha _).1

/-- The original non-Whitney sequence splits into its telescoping and
transverse components. -/
theorem aux_nonWhitney_decompose (phi0 phi1 : SchwartzMap ℝ ℝ)
    (a : ℤ → ℝ) :
    aux_nonWhitneySequence phi0 phi1 a =
      fun j => aux_oneScaleWindowSequence phi0 a j +
        aux_liftPlaneKernel (aux_nonWhitneyCorrection phi0 phi1 a j) := by
  funext j y
  change aux_nonWhitneyKernel phi0 phi1 a j (y.1 0, y.2 0) =
    aux_oneScaleWindowKernel phi0 a j (y.1 0, y.2 0) +
      aux_nonWhitneyCorrection phi0 phi1 a j (y.1 0, y.2 0)
  change aux_nonWhitneyKernel phi0 phi1 a j (y.1 0, y.2 0) =
    aux_oneScaleWindowKernel phi0 a j (y.1 0, y.2 0) +
      (aux_nonWhitneyKernel phi0 phi1 a j (y.1 0, y.2 0) -
        aux_oneScaleWindowKernel phi0 a j (y.1 0, y.2 0))
  ring

/-- The base scale used to package the four correction profiles as reduction data. -/
noncomputable def aux_nonWhitneyBase (a : ℤ → ℝ) : ℤ → ℝ :=
  fun j => (4 : ℝ)⁻¹ * a j

noncomputable def aux_nonWhitneyPrev (a : ℤ → ℝ) : ℤ → ℝ :=
  fun j => aux_nonWhitneyBase a (j - 1)

theorem aux_nonWhitneyBase_spaced (a : ℤ → ℝ) (ha : SpacedSequence a) :
    SpacedSequence (aux_nonWhitneyBase a) := by
  change SpacedSequence (fun j => (4 : ℝ)⁻¹ * a j)
  exact smul_mem_A ha (by norm_num)

theorem aux_nonWhitneyPrev_spaced (a : ℤ → ℝ) (ha : SpacedSequence a) :
    SpacedSequence (aux_nonWhitneyPrev a) := by
  have h := shift_mem_A (aux_nonWhitneyBase_spaced a ha) (-1)
  convert h using 1
  funext j
  simp only [aux_nonWhitneyPrev]
  congr 1

theorem aux_nonWhitneyPrev_distance (a : ℤ → ℝ) (ha : SpacedSequence a) :
    SequenceDistance (aux_nonWhitneyBase a) (aux_nonWhitneyPrev a) ≤
      (1 : WithTop ℕ) := by
  apply aux_sequenceDistance_le_of_within
  intro j
  constructor
  · change aux_nonWhitneyBase a (j - (1 : ℕ)) ≤ aux_nonWhitneyBase a (j - 1)
    rfl
  · change aux_nonWhitneyBase a (j - 1) ≤ aux_nonWhitneyBase a (j + (1 : ℕ))
    apply aux_spacedSequence_monotone (aux_nonWhitneyBase_spaced a ha)
    omega

theorem aux_nonWhitneyBase_distance (a : ℤ → ℝ) (ha : SpacedSequence a) :
    SequenceDistance (aux_nonWhitneyBase a) (aux_nonWhitneyBase a) ≤
      (1 : WithTop ℕ) := by
  apply aux_sequenceDistance_le_of_within
  intro j
  constructor
  · apply aux_spacedSequence_monotone (aux_nonWhitneyBase_spaced a ha)
    omega
  · apply aux_spacedSequence_monotone (aux_nonWhitneyBase_spaced a ha)
    omega

noncomputable def aux_nonWhitneyTriple (a : ℤ → ℝ) (ha : SpacedSequence a)
    (u : Fin 2 × Fin 2) : ReductionScaleTriple (aux_nonWhitneyBase a) where
  left := if u.1 = 0 then aux_nonWhitneyPrev a else aux_nonWhitneyBase a
  right := if u.2 = 0 then aux_nonWhitneyPrev a else aux_nonWhitneyBase a
  orientation := 0
  left_spaced := by
    split
    · exact aux_nonWhitneyPrev_spaced a ha
    · exact aux_nonWhitneyBase_spaced a ha
  right_spaced := by
    split
    · exact aux_nonWhitneyPrev_spaced a ha
    · exact aux_nonWhitneyBase_spaced a ha
  left_distance := by
    split
    · exact aux_nonWhitneyPrev_distance a ha
    · exact aux_nonWhitneyBase_distance a ha
  right_distance := by
    split
    · exact aux_nonWhitneyPrev_distance a ha
    · exact aux_nonWhitneyBase_distance a ha
  left_le_base := by
    intro j
    split
    · change aux_nonWhitneyBase a (j - 1) ≤ aux_nonWhitneyBase a j
      apply aux_spacedSequence_monotone (aux_nonWhitneyBase_spaced a ha)
      omega
    · rfl
  right_le_base := by
    intro j
    split
    · change aux_nonWhitneyBase a (j - 1) ≤ aux_nonWhitneyBase a j
      apply aux_spacedSequence_monotone (aux_nonWhitneyBase_spaced a ha)
      omega
    · rfl

noncomputable def aux_nonWhitneyTriples (a : ℤ → ℝ) (ha : SpacedSequence a) :
    Finset (ReductionScaleTriple (aux_nonWhitneyBase a)) := by
  classical
  exact Finset.univ.image (aux_nonWhitneyTriple a ha)

theorem aux_nonWhitneyBase_prev_ne (a : ℤ → ℝ) (ha : SpacedSequence a) :
    aux_nonWhitneyPrev a ≠ aux_nonWhitneyBase a := by
  intro h
  have hzero := congrFun h (0 : ℤ)
  have hstep := (aux_nonWhitneyBase_spaced a ha (-1)).2
  have hpos := (aux_nonWhitneyBase_spaced a ha (-1)).1
  change aux_nonWhitneyBase a (-1) = aux_nonWhitneyBase a 0 at hzero
  have hstep' : 2 * aux_nonWhitneyBase a (-1) ≤ aux_nonWhitneyBase a 0 := by
    convert hstep using 1; ring_nf
  nlinarith

theorem aux_nonWhitneyTriple_injective (a : ℤ → ℝ) (ha : SpacedSequence a) :
    Function.Injective (aux_nonWhitneyTriple a ha) := by
  intro u w huw
  rcases u with ⟨u0, u1⟩
  rcases w with ⟨w0, w1⟩
  have hleft := congrArg ReductionScaleTriple.left huw
  have hright := congrArg ReductionScaleTriple.right huw
  have hu0 : u0 = w0 := by
    fin_cases u0 <;> fin_cases w0 <;> try rfl
    all_goals exfalso
    · apply aux_nonWhitneyBase_prev_ne a ha
      simpa [aux_nonWhitneyTriple] using hleft
    · apply aux_nonWhitneyBase_prev_ne a ha
      simpa [aux_nonWhitneyTriple] using hleft.symm
  have hu1 : u1 = w1 := by
    fin_cases u1 <;> fin_cases w1 <;> try rfl
    all_goals exfalso
    · apply aux_nonWhitneyBase_prev_ne a ha
      simpa [aux_nonWhitneyTriple] using hright
    · apply aux_nonWhitneyBase_prev_ne a ha
      simpa [aux_nonWhitneyTriple] using hright.symm
  exact Prod.ext hu0 hu1

theorem aux_nonWhitneyTriples_card (a : ℤ → ℝ) (ha : SpacedSequence a) :
    (aux_nonWhitneyTriples a ha).card ≤ 5 := by
  classical
  unfold aux_nonWhitneyTriples
  calc
    (aux_nonWhitneyTriples a ha).card ≤ (Finset.univ : Finset (Fin 2 × Fin 2)).card :=
      Finset.card_image_le
    _ = 4 := by simp
    _ ≤ 5 := by norm_num

/-- The window decay estimate after an `L¹`-normalized rescaling. -/
theorem aux_nonWhitney_windowRescale_decay (phi : SchwartzMap ℝ ℝ)
    (hwin : cnWindow C_uniPair N_uniPair phi) {t : ℝ} (ht : 0 < t) (x : ℝ) :
    |aux_windowRescale phi t x| ≤
      8 * C_uniPair * scaledBracketBump 2 t x := by
  have h := aux_window_decay phi hwin (t⁻¹ * x)
  unfold aux_windowRescale
  rw [abs_mul, abs_of_pos (inv_pos.mpr ht)]
  calc
    t⁻¹ * |phi (t⁻¹ * x)| ≤
        t⁻¹ * (8 * C_uniPair * bracketBump (t⁻¹ * x) ^ 2) :=
      mul_le_mul_of_nonneg_left h (inv_nonneg.mpr ht.le)
    _ = 8 * C_uniPair * scaledBracketBump 2 t x := by
      unfold scaledBracketBump bracketBump
      ring

theorem aux_nonWhitney_window_constant_bound :
    8 * C_uniPair ≤
      2 * C_smoothDecay2 2 * max 1 ((C_uniPair / (2 * Real.pi)) ^ 2) := by
  have hp : 0 < 2 * Real.pi := by positivity
  have hp_le : 2 * Real.pi ≤ 8 := by
    nlinarith [Real.pi_lt_four]
  have hratio : (4096 : ℝ) ≤ C_uniPair / (2 * Real.pi) := by
    apply (le_div_iff₀ hp).2
    norm_num [C_uniPair]
    nlinarith
  have hsq : C_uniPair ≤ (C_uniPair / (2 * Real.pi)) ^ 2 := by
    have hmul := mul_self_le_mul_self (by norm_num : (0 : ℝ) ≤ 4096) hratio
    norm_num [C_uniPair, pow_two] at hmul ⊢
    nlinarith
  calc
    8 * C_uniPair ≤ 8 * max 1 ((C_uniPair / (2 * Real.pi)) ^ 2) :=
      mul_le_mul_of_nonneg_left (hsq.trans (le_max_right _ _)) (by norm_num)
    _ = 2 * C_smoothDecay2 2 * max 1 ((C_uniPair / (2 * Real.pi)) ^ 2) := by
      norm_num [C_smoothDecay2]

theorem aux_nonWhitney_windowRescale_decay' (phi : SchwartzMap ℝ ℝ)
    (hwin : cnWindow C_uniPair N_uniPair phi) {t : ℝ} (ht : 0 < t) (x : ℝ) :
    |aux_windowRescale phi t x| ≤
      (2 * C_smoothDecay2 2 * max 1 ((C_uniPair / (2 * Real.pi)) ^ 2)) *
        scaledBracketBump 2 t x := by
  exact (aux_nonWhitney_windowRescale_decay phi hwin ht x).trans
    (mul_le_mul_of_nonneg_right aux_nonWhitney_window_constant_bound
      (aux_scaledBracketBump_nonneg 2 ht x))

theorem aux_nonWhitney_tensor_correction_decay
    (f g h : ℝ → ℝ) (K P0 P1 Q0 Q1 : ℝ)
    (hK : 0 ≤ K) (hP0 : 0 ≤ P0) (hP1 : 0 ≤ P1)
    (hQ0 : 0 ≤ Q0) (hQ1 : 0 ≤ Q1) (v : RealPlane)
    (hf0 : |f v.1| ≤ K * P0) (hf1 : |f v.2| ≤ K * P1)
    (hg0 : |g v.1| ≤ K * Q0) (hg1 : |g v.2| ≤ K * Q1)
    (hh0 : |h v.1| ≤ K * Q0) (hh1 : |h v.2| ≤ K * Q1) :
    |tensorSquare (fun x => f x - g x) v -
        (tensorSquare f v - tensorSquare h v)| ≤
      K ^ 2 * ((P0 + Q0) * (P1 + Q1) + P0 * P1 + Q0 * Q1) := by
  have hKP0 : 0 ≤ K * P0 := mul_nonneg hK hP0
  have hKP1 : 0 ≤ K * P1 := mul_nonneg hK hP1
  have hKQ0 : 0 ≤ K * Q0 := mul_nonneg hK hQ0
  have hKQ1 : 0 ≤ K * Q1 := mul_nonneg hK hQ1
  have hfg₁ : |f v.1 - g v.1| ≤ |f v.1| + |g v.1| := by
    simpa using (abs_sub_le (f v.1) 0 (g v.1))
  have hfg₂ : |f v.2 - g v.2| ≤ |f v.2| + |g v.2| := by
    simpa using (abs_sub_le (f v.2) 0 (g v.2))
  have hfh : |f v.1 * f v.2 - h v.1 * h v.2| ≤
      |f v.1| * |f v.2| + |h v.1| * |h v.2| := by
    calc
      |f v.1 * f v.2 - h v.1 * h v.2| ≤
          |f v.1 * f v.2| + |h v.1 * h v.2| := by
        simpa using (abs_sub_le (f v.1 * f v.2) 0 (h v.1 * h v.2))
      _ = |f v.1| * |f v.2| + |h v.1| * |h v.2| := by
        rw [abs_mul, abs_mul]
  have hsum₁ : |f v.1| + |g v.1| ≤ K * P0 + K * Q0 :=
    add_le_add hf0 hg0
  have hsum₂ : |f v.2| + |g v.2| ≤ K * P1 + K * Q1 :=
    add_le_add hf1 hg1
  have hprod₀ : (|f v.1| + |g v.1|) * (|f v.2| + |g v.2|) ≤
      (K * P0 + K * Q0) * (K * P1 + K * Q1) :=
    mul_le_mul hsum₁ hsum₂ (add_nonneg (abs_nonneg _) (abs_nonneg _))
      (add_nonneg hKP0 hKQ0)
  have hprod₁ : |f v.1| * |f v.2| ≤ (K * P0) * (K * P1) :=
    mul_le_mul hf0 hf1 (abs_nonneg _) hKP0
  have hprod₂ : |h v.1| * |h v.2| ≤ (K * Q0) * (K * Q1) :=
    mul_le_mul hh0 hh1 (abs_nonneg _) hKQ0
  unfold tensorSquare
  calc
    |(f v.1 - g v.1) * (f v.2 - g v.2) -
        (f v.1 * f v.2 - h v.1 * h v.2)| ≤
        |(f v.1 - g v.1) * (f v.2 - g v.2)| +
          |f v.1 * f v.2 - h v.1 * h v.2| := by
      calc
        _ ≤ |(f v.1 - g v.1) * (f v.2 - g v.2)| +
            |(0 : ℝ) - (f v.1 * f v.2 - h v.1 * h v.2)| :=
          by simpa using
            (abs_sub_le ((f v.1 - g v.1) * (f v.2 - g v.2)) (0 : ℝ)
              (f v.1 * f v.2 - h v.1 * h v.2))
        _ = _ := by rw [zero_sub, abs_neg]
    _ ≤ (|f v.1| + |g v.1|) * (|f v.2| + |g v.2|) +
          (|f v.1| * |f v.2| + |h v.1| * |h v.2|) := by
      rw [abs_mul]
      exact add_le_add
        (mul_le_mul hfg₁ hfg₂ (abs_nonneg _) (add_nonneg (abs_nonneg _) (abs_nonneg _)))
        hfh
    _ ≤ (K * P0 + K * Q0) * (K * P1 + K * Q1) +
          ((K * P0) * (K * P1) + (K * Q0) * (K * Q1)) := by
      exact add_le_add hprod₀ (add_le_add hprod₁ hprod₂)
    _ = K ^ 2 * ((P0 + Q0) * (P1 + Q1) + P0 * P1 + Q0 * Q1) := by ring

noncomputable def aux_nonWhitneyDecayConstant : ℝ :=
  2 * C_smoothDecay2 2 * max 1 ((C_uniPair / (2 * Real.pi)) ^ 2)

theorem aux_nonWhitneyDecayConstant_nonneg :
    0 ≤ aux_nonWhitneyDecayConstant := by
  unfold aux_nonWhitneyDecayConstant
  exact mul_nonneg (mul_nonneg (by norm_num) (by norm_num [C_smoothDecay2]))
    ((by norm_num : (0 : ℝ) ≤ 1).trans (le_max_left _ _))

theorem aux_nonWhitneyCorrection_decay_two
    (a : ℤ → ℝ) (ha : SpacedSequence a) (phi0 phi1 : SchwartzMap ℝ ℝ)
    (hpair : uniPair phi0 phi1) (j : ℤ) (v : RealPlane) :
    |aux_nonWhitneyCorrection phi0 phi1 a j v| ≤
      aux_nonWhitneyDecayConstant ^ 2 *
        ((scaledBracketBump 2 (a (j - 1)) v.1 + scaledBracketBump 2 (a j) v.1) *
          (scaledBracketBump 2 (a (j - 1)) v.2 + scaledBracketBump 2 (a j) v.2) +
          scaledBracketBump 2 (a (j - 1)) v.1 * scaledBracketBump 2 (a (j - 1)) v.2 +
          scaledBracketBump 2 (a j) v.1 * scaledBracketBump 2 (a j) v.2) := by
  change |tensorSquare (fun x =>
      aux_windowRescale phi0 (a (j - 1)) x - aux_windowRescale phi1 (a j) x) v -
      (tensorSquare (aux_windowRescale phi0 (a (j - 1))) v -
        tensorSquare (aux_windowRescale phi0 (a j)) v)| ≤ _
  apply aux_nonWhitney_tensor_correction_decay
  · exact aux_nonWhitneyDecayConstant_nonneg
  · exact aux_scaledBracketBump_nonneg 2 (aux_spacedSequence_pos ha _) _
  · exact aux_scaledBracketBump_nonneg 2 (aux_spacedSequence_pos ha _) _
  · exact aux_scaledBracketBump_nonneg 2 (aux_spacedSequence_pos ha _) _
  · exact aux_scaledBracketBump_nonneg 2 (aux_spacedSequence_pos ha _) _
  · exact aux_nonWhitney_windowRescale_decay' phi0 hpair.1
      (aux_spacedSequence_pos ha (j - 1)) v.1
  · exact aux_nonWhitney_windowRescale_decay' phi0 hpair.1
      (aux_spacedSequence_pos ha (j - 1)) v.2
  · exact aux_nonWhitney_windowRescale_decay' phi1 hpair.2.1
      (aux_spacedSequence_pos ha j) v.1
  · exact aux_nonWhitney_windowRescale_decay' phi1 hpair.2.1
      (aux_spacedSequence_pos ha j) v.2
  · exact aux_nonWhitney_windowRescale_decay' phi0 hpair.1
      (aux_spacedSequence_pos ha j) v.1
  · exact aux_nonWhitney_windowRescale_decay' phi0 hpair.1
      (aux_spacedSequence_pos ha j) v.2

theorem aux_nonWhitney_scale_to_base (a : ℤ → ℝ) (ha : SpacedSequence a)
    (j : ℤ) (x : ℝ) :
    scaledBracketBump 2 (a j) x ≤
      4 * scaledBracketBumpReal (3 / 2 : ℝ) (aux_nonWhitneyBase a j) x := by
  have hb : 0 < aux_nonWhitneyBase a j :=
    aux_spacedSequence_pos (aux_nonWhitneyBase_spaced a ha) _
  have heq : 4 * aux_nonWhitneyBase a j = a j := by
    unfold aux_nonWhitneyBase
    ring
  calc
    scaledBracketBump 2 (a j) x =
        scaledBracketBump 2 (4 * aux_nonWhitneyBase a j) x := by rw [heq]
    _ ≤ max (4 : ℝ) (4 : ℝ)⁻¹ * scaledBracketBump 2 (aux_nonWhitneyBase a j) x :=
      scaleEstimate x 4 (aux_nonWhitneyBase a j) (by norm_num) hb
    _ = 4 * scaledBracketBump 2 (aux_nonWhitneyBase a j) x := by norm_num
    _ = 4 * scaledBracketBumpReal 2 (aux_nonWhitneyBase a j) x := by
      rw [aux_diagonalSquareRoot_scaledBracketBumpReal_two_eq]
    _ ≤ 4 * scaledBracketBumpReal (3 / 2 : ℝ) (aux_nonWhitneyBase a j) x :=
      mul_le_mul_of_nonneg_left
        (aux_scaledBracketBumpReal_exponent_reduce (3 / 2 : ℝ) 2
          (aux_nonWhitneyBase a j) x hb (by norm_num)) (by norm_num)

theorem aux_CuniPair_over_two_pi_one_le :
    1 ≤ C_uniPair / (2 * Real.pi) := by
  have hp : 0 < 2 * Real.pi := by positivity
  apply (le_div_iff₀ hp).2
  have hp_le : 2 * Real.pi ≤ 8 := by nlinarith [Real.pi_lt_four]
  norm_num [C_uniPair]
  nlinarith

theorem aux_nonWhitneyDecayConstant_sq :
    aux_nonWhitneyDecayConstant ^ 2 =
      4 * C_smoothDecay2 2 ^ 2 *
        max 1 ((C_uniPair / (2 * Real.pi)) ^ 4) := by
  have hr2 : 1 ≤ (C_uniPair / (2 * Real.pi)) ^ 2 :=
    one_le_pow₀ aux_CuniPair_over_two_pi_one_le
  have hr4 : 1 ≤ (C_uniPair / (2 * Real.pi)) ^ 4 :=
    one_le_pow₀ aux_CuniPair_over_two_pi_one_le
  unfold aux_nonWhitneyDecayConstant
  rw [max_eq_right hr2, max_eq_right hr4]
  ring

theorem aux_nonWhitney_four_bracket_terms_le
    (A0 A1 B0 B1 P0 P1 Q0 Q1 : ℝ)
    (_hA0 : 0 ≤ A0) (hA1 : 0 ≤ A1) (_hB0 : 0 ≤ B0) (hB1 : 0 ≤ B1)
    (hP0 : 0 ≤ P0) (hP1 : 0 ≤ P1) (hQ0 : 0 ≤ Q0) (hQ1 : 0 ≤ Q1)
    (hA0' : A0 ≤ 4 * P0) (hA1' : A1 ≤ 4 * P1)
    (hB0' : B0 ≤ 4 * Q0) (hB1' : B1 ≤ 4 * Q1) :
    (A0 + B0) * (A1 + B1) + A0 * A1 + B0 * B1 ≤
      32 * (P0 * P1 + P0 * Q1 + Q0 * P1 + Q0 * Q1) := by
  have hsum0 : A0 + B0 ≤ 4 * P0 + 4 * Q0 := add_le_add hA0' hB0'
  have hsum1 : A1 + B1 ≤ 4 * P1 + 4 * Q1 := add_le_add hA1' hB1'
  have hprod0 : (A0 + B0) * (A1 + B1) ≤
      (4 * P0 + 4 * Q0) * (4 * P1 + 4 * Q1) :=
    mul_le_mul hsum0 hsum1 (add_nonneg hA1 hB1)
      (add_nonneg (mul_nonneg (by norm_num) hP0) (mul_nonneg (by norm_num) hQ0))
  have hprodA : A0 * A1 ≤ (4 * P0) * (4 * P1) :=
    mul_le_mul hA0' hA1' hA1 (mul_nonneg (by norm_num) hP0)
  have hprodB : B0 * B1 ≤ (4 * Q0) * (4 * Q1) :=
    mul_le_mul hB0' hB1' hB1 (mul_nonneg (by norm_num) hQ0)
  have hfour :
      (P0 + Q0) * (P1 + Q1) + P0 * P1 + Q0 * Q1 ≤
        2 * (P0 * P1 + P0 * Q1 + Q0 * P1 + Q0 * Q1) := by
    calc
      (P0 + Q0) * (P1 + Q1) + P0 * P1 + Q0 * Q1 =
          2 * (P0 * P1 + P0 * Q1 + Q0 * P1 + Q0 * Q1) -
            (P0 * Q1 + Q0 * P1) := by ring
      _ ≤ 2 * (P0 * P1 + P0 * Q1 + Q0 * P1 + Q0 * Q1) :=
        sub_le_self _ (add_nonneg (mul_nonneg hP0 hQ1) (mul_nonneg hQ0 hP1))
  calc
    (A0 + B0) * (A1 + B1) + A0 * A1 + B0 * B1 ≤
        (4 * P0 + 4 * Q0) * (4 * P1 + 4 * Q1) +
          (4 * P0) * (4 * P1) + (4 * Q0) * (4 * Q1) := by
      exact add_le_add (add_le_add hprod0 hprodA) hprodB
    _ = 16 * ((P0 + Q0) * (P1 + Q1) + P0 * P1 + Q0 * Q1) := by ring
    _ ≤ 16 * (2 * (P0 * P1 + P0 * Q1 + Q0 * P1 + Q0 * Q1)) :=
      mul_le_mul_of_nonneg_left hfour (by norm_num)
    _ = 32 * (P0 * P1 + P0 * Q1 + Q0 * P1 + Q0 * Q1) := by ring

noncomputable def aux_nonWhitneyCorrectionConstant : ℝ :=
  128 * max 1 ((C_uniPair / (2 * Real.pi)) ^ 4) * C_smoothDecay2 2 ^ 2

theorem aux_nonWhitneyCorrectionConstant_pos :
    0 < aux_nonWhitneyCorrectionConstant := by
  unfold aux_nonWhitneyCorrectionConstant
  have hmax : 0 < max 1 ((C_uniPair / (2 * Real.pi)) ^ 4) :=
    lt_of_lt_of_le zero_lt_one (le_max_left _ _)
  exact mul_pos (mul_pos (by norm_num) hmax) (by norm_num [C_smoothDecay2])

theorem aux_nonWhitneyCorrection_decay
    (a : ℤ → ℝ) (ha : SpacedSequence a) (phi0 phi1 : SchwartzMap ℝ ℝ)
    (hpair : uniPair phi0 phi1) (j : ℤ) (v : RealPlane) :
    |aux_nonWhitneyCorrection phi0 phi1 a j v| ≤
      aux_nonWhitneyCorrectionConstant *
        (scaledBracketBumpReal (3 / 2 : ℝ) (aux_nonWhitneyPrev a j) v.1 *
            scaledBracketBumpReal (3 / 2 : ℝ) (aux_nonWhitneyPrev a j) v.2 +
          scaledBracketBumpReal (3 / 2 : ℝ) (aux_nonWhitneyPrev a j) v.1 *
            scaledBracketBumpReal (3 / 2 : ℝ) (aux_nonWhitneyBase a j) v.2 +
          scaledBracketBumpReal (3 / 2 : ℝ) (aux_nonWhitneyBase a j) v.1 *
            scaledBracketBumpReal (3 / 2 : ℝ) (aux_nonWhitneyPrev a j) v.2 +
          scaledBracketBumpReal (3 / 2 : ℝ) (aux_nonWhitneyBase a j) v.1 *
            scaledBracketBumpReal (3 / 2 : ℝ) (aux_nonWhitneyBase a j) v.2) := by
  let P0 := scaledBracketBumpReal (3 / 2 : ℝ) (aux_nonWhitneyPrev a j) v.1
  let P1 := scaledBracketBumpReal (3 / 2 : ℝ) (aux_nonWhitneyPrev a j) v.2
  let Q0 := scaledBracketBumpReal (3 / 2 : ℝ) (aux_nonWhitneyBase a j) v.1
  let Q1 := scaledBracketBumpReal (3 / 2 : ℝ) (aux_nonWhitneyBase a j) v.2
  let A0 := scaledBracketBump 2 (a (j - 1)) v.1
  let A1 := scaledBracketBump 2 (a (j - 1)) v.2
  let B0 := scaledBracketBump 2 (a j) v.1
  let B1 := scaledBracketBump 2 (a j) v.2
  have hmain := aux_nonWhitneyCorrection_decay_two a ha phi0 phi1 hpair j v
  have hA0 : 0 ≤ A0 := aux_scaledBracketBump_nonneg 2 (aux_spacedSequence_pos ha _) _
  have hA1 : 0 ≤ A1 := aux_scaledBracketBump_nonneg 2 (aux_spacedSequence_pos ha _) _
  have hB0 : 0 ≤ B0 := aux_scaledBracketBump_nonneg 2 (aux_spacedSequence_pos ha _) _
  have hB1 : 0 ≤ B1 := aux_scaledBracketBump_nonneg 2 (aux_spacedSequence_pos ha _) _
  have hP0 : 0 ≤ P0 := aux_scaledBracketBumpReal_nonneg _ _ _
    (aux_spacedSequence_pos (aux_nonWhitneyPrev_spaced a ha) _)
  have hP1 : 0 ≤ P1 := aux_scaledBracketBumpReal_nonneg _ _ _
    (aux_spacedSequence_pos (aux_nonWhitneyPrev_spaced a ha) _)
  have hQ0 : 0 ≤ Q0 := aux_scaledBracketBumpReal_nonneg _ _ _
    (aux_spacedSequence_pos (aux_nonWhitneyBase_spaced a ha) _)
  have hQ1 : 0 ≤ Q1 := aux_scaledBracketBumpReal_nonneg _ _ _
    (aux_spacedSequence_pos (aux_nonWhitneyBase_spaced a ha) _)
  have hbracket : (A0 + B0) * (A1 + B1) + A0 * A1 + B0 * B1 ≤
      32 * (P0 * P1 + P0 * Q1 + Q0 * P1 + Q0 * Q1) := by
    apply aux_nonWhitney_four_bracket_terms_le A0 A1 B0 B1 P0 P1 Q0 Q1
    · exact hA0
    · exact hA1
    · exact hB0
    · exact hB1
    · exact hP0
    · exact hP1
    · exact hQ0
    · exact hQ1
    · simpa [A0, P0, aux_nonWhitneyPrev] using
        aux_nonWhitney_scale_to_base a ha (j - 1) v.1
    · simpa [A1, P1, aux_nonWhitneyPrev] using
        aux_nonWhitney_scale_to_base a ha (j - 1) v.2
    · simpa [B0, Q0] using aux_nonWhitney_scale_to_base a ha j v.1
    · simpa [B1, Q1] using aux_nonWhitney_scale_to_base a ha j v.2
  calc
    |aux_nonWhitneyCorrection phi0 phi1 a j v| ≤
        aux_nonWhitneyDecayConstant ^ 2 * ((A0 + B0) * (A1 + B1) + A0 * A1 + B0 * B1) := by
      simpa [A0, A1, B0, B1] using hmain
    _ ≤ aux_nonWhitneyDecayConstant ^ 2 *
        (32 * (P0 * P1 + P0 * Q1 + Q0 * P1 + Q0 * Q1)) :=
      mul_le_mul_of_nonneg_left hbracket (sq_nonneg _)
    _ = aux_nonWhitneyCorrectionConstant *
        (P0 * P1 + P0 * Q1 + Q0 * P1 + Q0 * Q1) := by
      rw [aux_nonWhitneyDecayConstant_sq]
      unfold aux_nonWhitneyCorrectionConstant
      ring

theorem aux_nonWhitneyTriples_sum
    (a : ℤ → ℝ) (ha : SpacedSequence a) (j : ℤ) (v : RealPlane) :
    (∑ q ∈ aux_nonWhitneyTriples a ha,
      scaledBracketBumpReal (3 / 2 : ℝ) (q.left j) ((W q.orientation v).1) *
        scaledBracketBumpReal (3 / 2 : ℝ) (q.right j) ((W q.orientation v).2)) =
      scaledBracketBumpReal (3 / 2 : ℝ) (aux_nonWhitneyPrev a j) v.1 *
          scaledBracketBumpReal (3 / 2 : ℝ) (aux_nonWhitneyPrev a j) v.2 +
        scaledBracketBumpReal (3 / 2 : ℝ) (aux_nonWhitneyPrev a j) v.1 *
          scaledBracketBumpReal (3 / 2 : ℝ) (aux_nonWhitneyBase a j) v.2 +
        scaledBracketBumpReal (3 / 2 : ℝ) (aux_nonWhitneyBase a j) v.1 *
          scaledBracketBumpReal (3 / 2 : ℝ) (aux_nonWhitneyPrev a j) v.2 +
        scaledBracketBumpReal (3 / 2 : ℝ) (aux_nonWhitneyBase a j) v.1 *
          scaledBracketBumpReal (3 / 2 : ℝ) (aux_nonWhitneyBase a j) v.2 := by
  classical
  unfold aux_nonWhitneyTriples
  rw [Finset.sum_image]
  · simp only [aux_nonWhitneyTriple, Fin.isValue, W, ↓reduceIte]
    rw [Fintype.sum_prod_type]
    simp only [Fin.sum_univ_two]
    simp
    ring
  · intro x _ y _ hxy
    exact aux_nonWhitneyTriple_injective a ha hxy

theorem aux_planeFourier_const_mul (c : ℝ) (M : RealPlane → ℝ)
    (xi : EuclideanSpace ℝ (Fin 2)) :
    aux_planeFourier (fun v => c * M v) xi = c * aux_planeFourier M xi := by
  unfold aux_planeFourier
  rw [Real.fourier_eq, Real.fourier_eq, ← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [] with v
  push_cast
  rw [Circle.smul_def, Circle.smul_def]
  ring

theorem aux_fourierPlane_const_mul (c : ℝ) (M : RealPlane → ℝ)
    (xi : RealPlane) :
    aux_fourierPlane (fun v => c * M v) xi = c * aux_fourierPlane M xi := by
  unfold aux_fourierPlane
  rw [← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [] with v
  push_cast
  ring

/-- The normalized correction data used by vanishing diagonal reduction. -/
noncomputable def aux_nonWhitneyData
    (a : ℤ → ℝ) (ha : SpacedSequence a) (phi0 phi1 : SchwartzMap ℝ ℝ)
    (hpair : uniPair phi0 phi1)
    (hcancel : ∀ (j : ℤ) (xi : ℝ),
      aux_fourierPlane (aux_nonWhitneyCorrection phi0 phi1 a j) (xi, -xi) = 0) :
    ReductionData where
  a := aux_nonWhitneyBase a
  a_spaced := aux_nonWhitneyBase_spaced a ha
  triples := aux_nonWhitneyTriples a ha
  triples_card := aux_nonWhitneyTriples_card a ha
  kernel := fun j v => aux_nonWhitneyCorrectionConstant⁻¹ *
    aux_nonWhitneyCorrection phi0 phi1 a j v
  kernel_memW0 := by
    intro j
    exact aux_memW0_const_mul_nonneg
      (aux_nonWhitneyCorrection_memW0 a ha phi0 phi1 j) _
      (inv_nonneg.mpr aux_nonWhitneyCorrectionConstant_pos.le)
  diagonal_cancellation := by
    intro j xi
    rw [aux_fourierPlane_const_mul]
    rw [hcancel]
    ring
  kernel_decay := by
    intro j v
    have hpoint := aux_nonWhitneyCorrection_decay a ha phi0 phi1 hpair j v
    rw [← aux_nonWhitneyTriples_sum a ha j v] at hpoint
    rw [abs_mul, abs_of_pos (inv_pos.mpr aux_nonWhitneyCorrectionConstant_pos)]
    calc
      aux_nonWhitneyCorrectionConstant⁻¹ *
          |aux_nonWhitneyCorrection phi0 phi1 a j v| ≤
          aux_nonWhitneyCorrectionConstant⁻¹ *
            (aux_nonWhitneyCorrectionConstant *
              ∑ q ∈ aux_nonWhitneyTriples a ha,
                scaledBracketBumpReal (3 / 2 : ℝ) (q.left j) ((W q.orientation v).1) *
                  scaledBracketBumpReal (3 / 2 : ℝ) (q.right j) ((W q.orientation v).2)) :=
        mul_le_mul_of_nonneg_left hpoint
          (inv_nonneg.mpr aux_nonWhitneyCorrectionConstant_pos.le)
      _ = ∑ q ∈ aux_nonWhitneyTriples a ha,
          scaledBracketBumpReal (3 / 2 : ℝ) (q.left j) ((W q.orientation v).1) *
            scaledBracketBumpReal (3 / 2 : ℝ) (q.right j) ((W q.orientation v).2) := by
        field_simp [ne_of_gt aux_nonWhitneyCorrectionConstant_pos]

/-- Coordinate transport of a planar Wiener kernel to the canonical Fourier model. -/
theorem aux_plane_memW0 (M : RealPlane → ℝ) (hM : MemW0 M) :
    MemW0 (fun z : EuclideanSpace ℝ (Fin 2) => M (z 0, z 1)) := by
  let e : EuclideanSpace ℝ (Fin 2) ≃L[ℝ] RealPlane :=
    (EuclideanSpace.equiv (Fin 2) ℝ).trans (ContinuousLinearEquiv.finTwoArrow ℝ ℝ)
  have hcomp : MemW0 (M ∘ e) :=
    aux_memW0_comp_continuousLinearEquiv hM e
  simpa [e, Function.comp_def] using hcomp

theorem aux_planeFourier_tensorSquare (f : ℝ → ℝ)
    (xi : EuclideanSpace ℝ (Fin 2)) :
    aux_planeFourier (tensorSquare f) xi =
      FourierTransform.fourier (fun x : ℝ => (f x : ℂ)) (xi 0) *
        FourierTransform.fourier (fun x : ℝ => (f x : ℂ)) (xi 1) := by
  unfold aux_planeFourier tensorSquare
  simpa using aux_fourier_tensor_two_eq f f xi

theorem aux_planeFourier_sub_of_memW0 (M N : RealPlane → ℝ)
    (hM : MemW0 M) (hN : MemW0 N) (xi : EuclideanSpace ℝ (Fin 2)) :
    aux_planeFourier (fun v => M v - N v) xi =
      aux_planeFourier M xi - aux_planeFourier N xi := by
  let f : EuclideanSpace ℝ (Fin 2) → ℂ := fun z => (M (z 0, z 1) : ℂ)
  let g : EuclideanSpace ℝ (Fin 2) → ℂ := fun z => (N (z 0, z 1) : ℂ)
  have hf : Integrable f := by
    exact aux_memW0_integrable_of_addHaar
      (show MemW0 f by simpa [f] using
        aux_memW0_complex_ofReal_vanishing _ (aux_plane_memW0 M hM))
  have hg : Integrable g := by
    exact aux_memW0_integrable_of_addHaar
      (show MemW0 g by simpa [g] using
        aux_memW0_complex_ofReal_vanishing _ (aux_plane_memW0 N hN))
  simpa [aux_planeFourier, f, g] using
    aux_fourier_sub_euclidean_vanishing f g hf hg xi

theorem aux_planeFourier_nonWhitneyCorrection
    (f g h : ℝ → ℝ) (hf : MemW0 f) (hg : MemW0 g) (hh : MemW0 h)
    (xi : EuclideanSpace ℝ (Fin 2)) :
    aux_planeFourier (fun v => tensorSquare f v -
      (tensorSquare h v - tensorSquare g v)) xi =
      FourierTransform.fourier (fun x : ℝ => (f x : ℂ)) (xi 0) *
          FourierTransform.fourier (fun x : ℝ => (f x : ℂ)) (xi 1) +
        FourierTransform.fourier (fun x : ℝ => (g x : ℂ)) (xi 0) *
          FourierTransform.fourier (fun x : ℝ => (g x : ℂ)) (xi 1) -
        FourierTransform.fourier (fun x : ℝ => (h x : ℂ)) (xi 0) *
          FourierTransform.fourier (fun x : ℝ => (h x : ℂ)) (xi 1) := by
  have hfT : MemW0 (tensorSquare f) := aux_memW0_tensorSquare f hf
  have hgT : MemW0 (tensorSquare g) := aux_memW0_tensorSquare g hg
  have hhT : MemW0 (tensorSquare h) := aux_memW0_tensorSquare h hh
  rw [aux_planeFourier_sub_of_memW0 _ _ hfT (aux_memW0_sub hhT hgT) xi,
    aux_planeFourier_sub_of_memW0 _ _ hhT hgT xi,
    aux_planeFourier_tensorSquare, aux_planeFourier_tensorSquare,
    aux_planeFourier_tensorSquare]
  ring

theorem aux_nonWhitneyCorrection_eq_tensor_form
    (phi0 phi1 : SchwartzMap ℝ ℝ) (a : ℤ → ℝ) (j : ℤ) :
    aux_nonWhitneyCorrection phi0 phi1 a j =
      fun v =>
        tensorSquare (fun x => aux_windowRescale phi0 (a (j - 1)) x -
          aux_windowRescale phi1 (a j) x) v -
        (tensorSquare (aux_windowRescale phi0 (a (j - 1))) v -
          tensorSquare (aux_windowRescale phi0 (a j)) v) := by
  funext v
  simp [aux_nonWhitneyCorrection, aux_nonWhitneyKernel, aux_oneScaleWindowKernel]

theorem aux_nonWhitneyCorrection_planeFourier_formula
    (a : ℤ → ℝ) (ha : SpacedSequence a) (phi0 phi1 : SchwartzMap ℝ ℝ)
    (j : ℤ) (xi : EuclideanSpace ℝ (Fin 2)) :
    aux_planeFourier (aux_nonWhitneyCorrection phi0 phi1 a j) xi =
      FourierTransform.fourier (fun x : ℝ =>
          ((aux_windowRescale phi0 (a (j - 1)) x - aux_windowRescale phi1 (a j) x : ℝ) : ℂ))
          (xi 0) *
        FourierTransform.fourier (fun x : ℝ =>
          ((aux_windowRescale phi0 (a (j - 1)) x - aux_windowRescale phi1 (a j) x : ℝ) : ℂ))
          (xi 1) +
      FourierTransform.fourier (fun x : ℝ => (aux_windowRescale phi0 (a j) x : ℂ))
          (xi 0) *
        FourierTransform.fourier (fun x : ℝ => (aux_windowRescale phi0 (a j) x : ℂ))
          (xi 1) -
      FourierTransform.fourier (fun x : ℝ => (aux_windowRescale phi0 (a (j - 1)) x : ℂ))
          (xi 0) *
        FourierTransform.fourier (fun x : ℝ => (aux_windowRescale phi0 (a (j - 1)) x : ℂ))
          (xi 1) := by
  let f : ℝ → ℝ := fun x => aux_windowRescale phi0 (a (j - 1)) x -
    aux_windowRescale phi1 (a j) x
  let g : ℝ → ℝ := aux_windowRescale phi0 (a j)
  let h : ℝ → ℝ := aux_windowRescale phi0 (a (j - 1))
  have hs : 0 < a (j - 1) := aux_spacedSequence_pos ha _
  have ht : 0 < a j := aux_spacedSequence_pos ha _
  have hf : MemW0 f := by
    dsimp [f]
    exact aux_memW0_sub (aux_windowRescale_memW0 phi0 hs)
      (aux_windowRescale_memW0 phi1 ht)
  have hg : MemW0 g := by
    dsimp [g]
    exact aux_windowRescale_memW0 phi0 ht
  have hh : MemW0 h := by
    dsimp [h]
    exact aux_windowRescale_memW0 phi0 hs
  rw [aux_nonWhitneyCorrection_eq_tensor_form]
  simpa [f, g, h] using
    aux_planeFourier_nonWhitneyCorrection f g h hf hg hh xi

theorem aux_fourier_neg_conj_real (phi : ℝ → ℝ) (w : ℝ) :
    FourierTransform.fourier (fun u => (phi u : ℂ)) (-w) =
      (starRingEnd ℂ) (FourierTransform.fourier (fun u => (phi u : ℂ)) w) := by
  rw [Real.fourier_eq, Real.fourier_eq, ← integral_conj]
  change (∫ v : ℝ, 𝐞 (-inner ℝ v (-w)) • (phi v : ℂ)) =
    ∫ v : ℝ, star (𝐞 (-inner ℝ v w) • (phi v : ℂ))
  apply integral_congr_ae
  filter_upwards [] with u
  rw [Circle.smul_def, Circle.smul_def, Real.fourierChar_apply,
    Real.fourierChar_apply]
  change Complex.exp (↑(2 * Real.pi * (-inner ℝ u (-w))) * Complex.I) * (phi u : ℂ) =
    (starRingEnd ℂ) (Complex.exp (↑(2 * Real.pi * (-inner ℝ u w)) * Complex.I) *
      (phi u : ℂ))
  rw [map_mul]
  congr 1
  · rw [← Complex.exp_conj]
    rw [inner_neg_right]
    simp only [map_mul, Complex.conj_I, Complex.conj_ofReal]
    congr 1
    push_cast
    ring
  · simp

theorem aux_windowRescale_fourier_even (phi : SchwartzMap ℝ ℝ)
    (hwin : cnWindow C_uniPair N_uniPair phi) {t : ℝ} (ht : 0 < t) (xi : ℝ) :
    FourierTransform.fourier (fun x : ℝ => (aux_windowRescale phi t x : ℂ)) (-xi) =
      FourierTransform.fourier (fun x : ℝ => (aux_windowRescale phi t x : ℂ)) xi := by
  rw [aux_windowRescale_fourier t ht phi (-xi),
    aux_windowRescale_fourier t ht phi xi]
  rw [show t * -xi = -(t * xi) by ring, aux_fourier_neg_conj_real]
  rcases hwin.2.1 (t * xi) with ⟨r, hr, hEq⟩
  rw [hEq]
  simp

theorem aux_windowRescale_fourier_zero_of_abs_mul_gt_one
    (phi : SchwartzMap ℝ ℝ) (hwin : cnWindow C_uniPair N_uniPair phi)
    {t : ℝ} (ht : 0 < t) (xi : ℝ) (hxi : 1 < |t * xi|) :
    FourierTransform.fourier (fun x : ℝ => (aux_windowRescale phi t x : ℂ)) xi = 0 := by
  rw [aux_windowRescale_fourier t ht phi xi]
  by_contra hzero
  have hmem : t * xi ∈ Function.support
      (FourierTransform.fourier (fun x : ℝ => (phi x : ℂ))) :=
    Function.mem_support.mpr hzero
  have hbound : t * xi ∈ Set.Icc (-1 : ℝ) 1 := hwin.2.2.1 hmem
  exact (not_lt_of_ge (abs_le.mpr hbound)) hxi

theorem aux_windowRescale_fourier_zero_of_inv_lt_abs
    (phi : SchwartzMap ℝ ℝ) (hwin : cnWindow C_uniPair N_uniPair phi)
    {t : ℝ} (ht : 0 < t) (xi : ℝ) (hxi : t⁻¹ < |xi|) :
    FourierTransform.fourier (fun x : ℝ => (aux_windowRescale phi t x : ℂ)) xi = 0 := by
  apply aux_windowRescale_fourier_zero_of_abs_mul_gt_one phi hwin ht xi
  rw [abs_mul, abs_of_pos ht]
  calc
    1 = t * t⁻¹ := by field_simp [ne_of_gt ht]
    _ < t * |xi| := mul_lt_mul_of_pos_left hxi ht

/-- The Fourier support of the correction lies in the transverse diagonal strip. -/
theorem aux_nonWhitneyCorrection_planeFourier_support
    (a : ℤ → ℝ) (ha : SpacedSequence a) (phi0 phi1 : SchwartzMap ℝ ℝ)
    (hpair : uniPair phi0 phi1) (j : ℤ) :
    Function.support (aux_planeFourier (aux_nonWhitneyCorrection phi0 phi1 a j)) ⊆
      {z : EuclideanSpace ℝ (Fin 2) |
        |z 0 + z 1| ≤ 2 * (a (j - 1))⁻¹} := by
  intro z hz
  have hneq : aux_planeFourier (aux_nonWhitneyCorrection phi0 phi1 a j) z ≠ 0 :=
    Function.mem_support.mp hz
  have hs : 0 < a (j - 1) := aux_spacedSequence_pos ha _
  have ht : 0 < a j := aux_spacedSequence_pos ha _
  have hscale : 2 * a (j - 1) ≤ a j := by
    convert (ha (j - 1)).2 using 1; ring_nf
  have hle : a (j - 1) ≤ a j := by linarith
  have hinv : (a j)⁻¹ ≤ (a (j - 1))⁻¹ := (inv_le_inv₀ ht hs).2 hle
  let f : ℝ → ℝ := fun x => aux_windowRescale phi0 (a (j - 1)) x -
    aux_windowRescale phi1 (a j) x
  let g : ℝ → ℝ := aux_windowRescale phi0 (a j)
  let h : ℝ → ℝ := aux_windowRescale phi0 (a (j - 1))
  have hformula : aux_planeFourier (aux_nonWhitneyCorrection phi0 phi1 a j) z =
      FourierTransform.fourier (fun x : ℝ => (f x : ℂ)) (z 0) *
        FourierTransform.fourier (fun x : ℝ => (f x : ℂ)) (z 1) +
      FourierTransform.fourier (fun x : ℝ => (g x : ℂ)) (z 0) *
        FourierTransform.fourier (fun x : ℝ => (g x : ℂ)) (z 1) -
      FourierTransform.fourier (fun x : ℝ => (h x : ℂ)) (z 0) *
        FourierTransform.fourier (fun x : ℝ => (h x : ℂ)) (z 1) := by
    simpa [f, g, h] using
      aux_nonWhitneyCorrection_planeFourier_formula a ha phi0 phi1 j z
  have hkill (q : Fin 2) (hq : (a (j - 1))⁻¹ < |z q|) :
      FourierTransform.fourier (fun x : ℝ => (f x : ℂ)) (z q) = 0 ∧
        FourierTransform.fourier (fun x : ℝ => (g x : ℂ)) (z q) = 0 ∧
          FourierTransform.fourier (fun x : ℝ => (h x : ℂ)) (z q) = 0 := by
    have hold : FourierTransform.fourier (fun x : ℝ =>
        (aux_windowRescale phi0 (a (j - 1)) x : ℂ)) (z q) = 0 :=
      aux_windowRescale_fourier_zero_of_inv_lt_abs phi0 hpair.1 hs (z q) hq
    have hcurrent : FourierTransform.fourier (fun x : ℝ =>
        (aux_windowRescale phi0 (a j) x : ℂ)) (z q) = 0 :=
      aux_windowRescale_fourier_zero_of_inv_lt_abs phi0 hpair.1 ht (z q)
        (lt_of_le_of_lt hinv hq)
    have hwindowSq := fourierTransformWindow a ha phi0 phi1 hpair j (z q)
    have hdiff : FourierTransform.fourier (fun x : ℝ =>
        (aux_windowRescale phi0 (a (j - 1)) x - aux_windowRescale phi1 (a j) x : ℂ))
        (z q) = 0 := by
      apply sq_eq_zero_iff.mp
      rw [hwindowSq, hold, hcurrent]
      norm_num
    refine ⟨?_, ?_, ?_⟩
    · change FourierTransform.fourier (fun x : ℝ =>
        ((aux_windowRescale phi0 (a (j - 1)) x - aux_windowRescale phi1 (a j) x : ℝ) : ℂ))
        (z q) = 0
      have hcast : (fun x : ℝ =>
          ((aux_windowRescale phi0 (a (j - 1)) x - aux_windowRescale phi1 (a j) x : ℝ) : ℂ)) =
          (fun x : ℝ =>
            (aux_windowRescale phi0 (a (j - 1)) x - aux_windowRescale phi1 (a j) x : ℂ)) := by
        funext x
        push_cast
        rfl
      rw [hcast]
      exact hdiff
    · simpa [g] using hcurrent
    · simpa [h] using hold
  by_contra hstrip
  have hstrip' : 2 * (a (j - 1))⁻¹ < |z 0 + z 1| := lt_of_not_ge hstrip
  have hcoord : (a (j - 1))⁻¹ < |z 0| ∨ (a (j - 1))⁻¹ < |z 1| := by
    by_cases h0 : (a (j - 1))⁻¹ < |z 0|
    · exact Or.inl h0
    · right
      by_contra h1
      have h0le : |z 0| ≤ (a (j - 1))⁻¹ := le_of_not_gt h0
      have h1le : |z 1| ≤ (a (j - 1))⁻¹ := le_of_not_gt h1
      have hsum : |z 0 + z 1| ≤ 2 * (a (j - 1))⁻¹ := by
        calc
          |z 0 + z 1| ≤ |z 0| + |z 1| := abs_add_le _ _
          _ ≤ (a (j - 1))⁻¹ + (a (j - 1))⁻¹ := add_le_add h0le h1le
          _ = 2 * (a (j - 1))⁻¹ := by ring
      exact (not_lt_of_ge hsum) hstrip'
  rcases hcoord with h0 | h1
  · rcases hkill 0 h0 with ⟨hf, hg, hh⟩
    apply hneq
    rw [hformula]
    simp [hf, hg, hh]
  · rcases hkill 1 h1 with ⟨hf, hg, hh⟩
    apply hneq
    rw [hformula]
    simp [hf, hg, hh]

theorem aux_fourierPlane_tensorSquare (f : ℝ → ℝ) (xi eta : ℝ) :
    aux_fourierPlane (tensorSquare f) (xi, eta) =
      aux_fourierReal f xi * aux_fourierReal f eta := by
  change aux_fourierPlane (fun v : RealPlane => f v.1 * f v.2) (xi, eta) = _
  exact aux_fourierPlane_tensor f f xi eta

theorem aux_fourierPlane_nonWhitneyCorrection
    (f g h : ℝ → ℝ) (hf : MemW0 f) (hg : MemW0 g) (hh : MemW0 h)
    (xi eta : ℝ) :
    aux_fourierPlane (fun v => tensorSquare f v -
      (tensorSquare h v - tensorSquare g v)) (xi, eta) =
      aux_fourierReal f xi * aux_fourierReal f eta +
        aux_fourierReal g xi * aux_fourierReal g eta -
        aux_fourierReal h xi * aux_fourierReal h eta := by
  have hfT : MemW0 (tensorSquare f) := aux_memW0_tensorSquare f hf
  have hgT : MemW0 (tensorSquare g) := aux_memW0_tensorSquare g hg
  have hhT : MemW0 (tensorSquare h) := aux_memW0_tensorSquare h hh
  rw [aux_fourierPlane_sub _ _ (aux_memW0_integrable_of_addHaar hfT)
      (aux_memW0_integrable_of_addHaar (aux_memW0_sub hhT hgT)) (xi, eta),
    aux_fourierPlane_sub _ _ (aux_memW0_integrable_of_addHaar hhT)
      (aux_memW0_integrable_of_addHaar hgT) (xi, eta),
    aux_fourierPlane_tensorSquare, aux_fourierPlane_tensorSquare,
    aux_fourierPlane_tensorSquare]
  ring

theorem aux_nonWhitneyCorrection_fourierPlane_formula
    (a : ℤ → ℝ) (ha : SpacedSequence a) (phi0 phi1 : SchwartzMap ℝ ℝ)
    (j : ℤ) (xi eta : ℝ) :
    aux_fourierPlane (aux_nonWhitneyCorrection phi0 phi1 a j) (xi, eta) =
      aux_fourierReal (fun x => aux_windowRescale phi0 (a (j - 1)) x -
        aux_windowRescale phi1 (a j) x) xi *
        aux_fourierReal (fun x => aux_windowRescale phi0 (a (j - 1)) x -
          aux_windowRescale phi1 (a j) x) eta +
      aux_fourierReal (aux_windowRescale phi0 (a j)) xi *
        aux_fourierReal (aux_windowRescale phi0 (a j)) eta -
      aux_fourierReal (aux_windowRescale phi0 (a (j - 1))) xi *
        aux_fourierReal (aux_windowRescale phi0 (a (j - 1))) eta := by
  let f : ℝ → ℝ := fun x => aux_windowRescale phi0 (a (j - 1)) x -
    aux_windowRescale phi1 (a j) x
  let g : ℝ → ℝ := aux_windowRescale phi0 (a j)
  let h : ℝ → ℝ := aux_windowRescale phi0 (a (j - 1))
  have hs : 0 < a (j - 1) := aux_spacedSequence_pos ha _
  have ht : 0 < a j := aux_spacedSequence_pos ha _
  have hf : MemW0 f := by
    dsimp [f]
    exact aux_memW0_sub (aux_windowRescale_memW0 phi0 hs)
      (aux_windowRescale_memW0 phi1 ht)
  have hg : MemW0 g := by
    dsimp [g]
    exact aux_windowRescale_memW0 phi0 ht
  have hh : MemW0 h := by
    dsimp [h]
    exact aux_windowRescale_memW0 phi0 hs
  rw [aux_nonWhitneyCorrection_eq_tensor_form]
  simpa [f, g, h] using
    aux_fourierPlane_nonWhitneyCorrection f g h hf hg hh xi eta

/-- The correction has the anti-diagonal cancellation required by reduction data. -/
theorem aux_nonWhitneyCorrection_fourier_cancel
    (a : ℤ → ℝ) (ha : SpacedSequence a) (phi0 phi1 : SchwartzMap ℝ ℝ)
    (hpair : uniPair phi0 phi1) (j : ℤ) (xi : ℝ) :
    aux_fourierPlane (aux_nonWhitneyCorrection phi0 phi1 a j) (xi, -xi) = 0 := by
  let f : ℝ → ℝ := fun x => aux_windowRescale phi0 (a (j - 1)) x -
    aux_windowRescale phi1 (a j) x
  let g : ℝ → ℝ := aux_windowRescale phi0 (a j)
  let h : ℝ → ℝ := aux_windowRescale phi0 (a (j - 1))
  have hs : 0 < a (j - 1) := aux_spacedSequence_pos ha _
  have ht : 0 < a j := aux_spacedSequence_pos ha _
  have hfeven : FourierTransform.fourier (fun x : ℝ => (f x : ℂ)) (-xi) =
      FourierTransform.fourier (fun x : ℝ => (f x : ℂ)) xi := by
    change FourierTransform.fourier (fun x : ℝ =>
      ((aux_windowRescale phi0 (a (j - 1)) x - aux_windowRescale phi1 (a j) x : ℝ) : ℂ))
        (-xi) = _
    rw [aux_fourier_sub_of_integrable _ _ (aux_windowRescale_integrable phi0 _ hs)
      (aux_windowRescale_integrable phi1 _ ht) (-xi),
      aux_fourier_sub_of_integrable _ _ (aux_windowRescale_integrable phi0 _ hs)
        (aux_windowRescale_integrable phi1 _ ht) xi,
      aux_windowRescale_fourier_even phi0 hpair.1 hs xi,
      aux_windowRescale_fourier_even phi1 hpair.2.1 ht xi]
  have hgeven : FourierTransform.fourier (fun x : ℝ => (g x : ℂ)) (-xi) =
      FourierTransform.fourier (fun x : ℝ => (g x : ℂ)) xi := by
    dsimp [g]
    exact aux_windowRescale_fourier_even phi0 hpair.1 ht xi
  have hheven : FourierTransform.fourier (fun x : ℝ => (h x : ℂ)) (-xi) =
      FourierTransform.fourier (fun x : ℝ => (h x : ℂ)) xi := by
    dsimp [h]
    exact aux_windowRescale_fourier_even phi0 hpair.1 hs xi
  have hcast : (fun x : ℝ => (f x : ℂ)) =
      (fun x : ℝ =>
        (aux_windowRescale phi0 (a (j - 1)) x - aux_windowRescale phi1 (a j) x : ℂ)) := by
    funext x
    dsimp [f]
    push_cast
    rfl
  have hwindow : FourierTransform.fourier (fun x : ℝ => (f x : ℂ)) xi ^ 2 =
      FourierTransform.fourier (fun x : ℝ => (h x : ℂ)) xi ^ 2 -
        FourierTransform.fourier (fun x : ℝ => (g x : ℂ)) xi ^ 2 := by
    rw [hcast]
    simpa [g, h] using fourierTransformWindow a ha phi0 phi1 hpair j xi
  rw [aux_nonWhitneyCorrection_fourierPlane_formula a ha phi0 phi1 j xi (-xi)]
  repeat' rw [aux_fourierReal_eq_fourier]
  rw [hfeven, hgeven, hheven]
  rw [show (FourierTransform.fourier (fun x : ℝ => (f x : ℂ)) xi) *
      FourierTransform.fourier (fun x : ℝ => (f x : ℂ)) xi =
      FourierTransform.fourier (fun x : ℝ => (f x : ℂ)) xi ^ 2 by ring,
    show (FourierTransform.fourier (fun x : ℝ => (g x : ℂ)) xi) *
      FourierTransform.fourier (fun x : ℝ => (g x : ℂ)) xi =
      FourierTransform.fourier (fun x : ℝ => (g x : ℂ)) xi ^ 2 by ring,
    show (FourierTransform.fourier (fun x : ℝ => (h x : ℂ)) xi) *
      FourierTransform.fourier (fun x : ℝ => (h x : ℂ)) xi =
      FourierTransform.fourier (fun x : ℝ => (h x : ℂ)) xi ^ 2 by ring,
    hwindow]
  ring

theorem aux_nonWhitneyCorrection_frequency_support
    (a : ℤ → ℝ) (ha : SpacedSequence a) (phi0 phi1 : SchwartzMap ℝ ℝ)
    (hpair : uniPair phi0 phi1) (j : ℤ) :
    Function.support (aux_planeFourier (aux_nonWhitneyCorrection phi0 phi1 a j)) ⊆
      {z : EuclideanSpace ℝ (Fin 2) |
        |z 0 + z 1| ≤ (2 : ℝ)⁻¹ * (aux_nonWhitneyBase a (j - 1))⁻¹} := by
  have hsource := aux_nonWhitneyCorrection_planeFourier_support a ha phi0 phi1 hpair j
  intro z hz
  have hbound : |z 0 + z 1| ≤ 2 * (a (j - 1))⁻¹ := by
    apply hsource
    exact hz
  calc
    |z 0 + z 1| ≤ 2 * (a (j - 1))⁻¹ := hbound
    _ = (2 : ℝ)⁻¹ * (aux_nonWhitneyBase a (j - 1))⁻¹ := by
      unfold aux_nonWhitneyBase
      field_simp [ne_of_gt (aux_spacedSequence_pos ha (j - 1))]
      ring

theorem aux_nonWhitneyData_frequencyDiagonalBound
    (a : ℤ → ℝ) (ha : SpacedSequence a) (phi0 phi1 : SchwartzMap ℝ ℝ)
    (hpair : uniPair phi0 phi1)
    (hcancel : ∀ (j : ℤ) (xi : ℝ),
      aux_fourierPlane (aux_nonWhitneyCorrection phi0 phi1 a j) (xi, -xi) = 0) :
    aux_frequencyDiagonalBound (aux_nonWhitneyData a ha phi0 phi1 hpair hcancel) := by
  intro j z hz
  have hnonzero : aux_planeFourier
      (fun v => aux_nonWhitneyCorrectionConstant⁻¹ *
        aux_nonWhitneyCorrection phi0 phi1 a j v) z ≠ 0 := by
    exact Function.mem_support.mp hz
  rw [aux_planeFourier_const_mul] at hnonzero
  apply aux_nonWhitneyCorrection_frequency_support a ha phi0 phi1 hpair j
  apply Function.mem_support.mpr
  intro hzero
  exact hnonzero (by rw [hzero, mul_zero])

theorem aux_oneScaleWindowSequence_mem
    (a : ℤ → ℝ) (ha : SpacedSequence a) (phi0 : SchwartzMap ℝ ℝ) :
    MemKernelSequence 1 (aux_oneScaleWindowSequence phi0 a) := by
  intro j
  change MemW0 (aux_liftPlaneKernel (aux_oneScaleWindowKernel phi0 a j))
  apply liftPlaneKernel_memW0
  unfold aux_oneScaleWindowKernel
  exact aux_memW0_sub
    (aux_memW0_tensorSquare _
      (aux_windowRescale_memW0 phi0 (aux_spacedSequence_pos ha (j - 1))))
    (aux_memW0_tensorSquare _
      (aux_windowRescale_memW0 phi0 (aux_spacedSequence_pos ha j)))

theorem aux_nonWhitneyCorrectionSequence_mem
    (a : ℤ → ℝ) (ha : SpacedSequence a) (phi0 phi1 : SchwartzMap ℝ ℝ) :
    MemKernelSequence 1
      (fun j => aux_liftPlaneKernel (aux_nonWhitneyCorrection phi0 phi1 a j)) := by
  intro j
  exact liftPlaneKernel_memW0 _
    (aux_nonWhitneyCorrection_memW0 a ha phi0 phi1 j)

theorem aux_nonWhitneyCorrectionSequence_eq_const_mul_data
    (a : ℤ → ℝ) (ha : SpacedSequence a) (phi0 phi1 : SchwartzMap ℝ ℝ)
    (hpair : uniPair phi0 phi1)
    (hcancel : ∀ (j : ℤ) (xi : ℝ),
      aux_fourierPlane (aux_nonWhitneyCorrection phi0 phi1 a j) (xi, -xi) = 0) :
    (fun j => aux_liftPlaneKernel (aux_nonWhitneyCorrection phi0 phi1 a j)) =
      (fun j y => aux_nonWhitneyCorrectionConstant *
        aux_liftPlaneKernel ((aux_nonWhitneyData a ha phi0 phi1 hpair hcancel).kernel j) y) := by
  funext j y
  change aux_nonWhitneyCorrection phi0 phi1 a j (y.1 0, y.2 0) =
    aux_nonWhitneyCorrectionConstant *
      (aux_nonWhitneyCorrectionConstant⁻¹ *
        aux_nonWhitneyCorrection phi0 phi1 a j (y.1 0, y.2 0))
  field_simp [ne_of_gt aux_nonWhitneyCorrectionConstant_pos]

/--
\begin{proposition}[induct positive terms - reduction variant, non-Whitney]
\label{P:induct-positive-terms-reduction-non-whitney}
Let $a\in A$ and let
\begin{equation}\label{auto:non-Whitney-kernel}
M_j=({\phi}_{0,a(j-1)}-{\phi}_{1,a(j)})^{\otimes 2}.
\end{equation}
Then with $\M=(M_j)_{j\in \Z}$,
\begin{equation}\label{auto:non-Whitney-reduction-bound}
\|\M\|_{\rm M(1)}\le C_{\text{P:induct-positive-terms-reduction-non-whitney}},
\end{equation}
where $C_{\text{P:induct-positive-terms-reduction-non-whitney}}=
C_{\text{P:one-scale-estimate-window}}+
128 \max(1,(C_{\text{def:unipair}}/2\pi)^4)
C_{\text{lem:smoothdecay2},2}^2C_{\text{P:diagonal-band-reduction}}$.
\end{proposition}

See also [`Codex.Reduction.OnDiagonalOffDiagonal.inductPositiveTermsReductionNonWhitney`],
[`Codex.Reduction.OnDiagonalOffDiagonal.oneScaleEstimateWindow`],
[`Codex.Reduction.WindowsAndPairs.uniPair`],
[`Codex.Preliminaries.BumpsAndEstimates.smoothDecay2`],
[`Codex.Reduction.OnDiagonalOffDiagonal.diagonalBandReduction`].
-/
theorem inductPositiveTermsReductionNonWhitney {n : ℕ} (hn : 2 ≤ n)
    (a : ℤ → ℝ) (ha : SpacedSequence a) (phi0 phi1 : SchwartzMap ℝ ℝ)
    (hpair : uniPair phi0 phi1) :
    kernelSequenceSeminorm n 1 (by omega) (by omega)
      (aux_nonWhitneySequence phi0 phi1 a) ≤
        ENNReal.ofReal C_inductPositiveTermsReductionNonWhitney := by
  have hCdiag : 0 ≤ C_diagonalBandReduction := by
    unfold C_diagonalBandReduction
    exact add_nonneg
      (mul_nonneg (by positivity) (Real.sqrt_nonneg _))
      (mul_nonneg (by positivity) CincreaseDataReduction_nonneg)
  let D := aux_nonWhitneyData a ha phi0 phi1 hpair
    (aux_nonWhitneyCorrection_fourier_cancel a ha phi0 phi1 hpair)
  have hDsupport : aux_frequencyDiagonalBound D := by
    dsimp [D]
    exact aux_nonWhitneyData_frequencyDiagonalBound a ha phi0 phi1 hpair _
  have hD := vanishingDiagonalReduction hn D hDsupport
  have hcorr_eq :
      (fun j => aux_liftPlaneKernel (aux_nonWhitneyCorrection phi0 phi1 a j)) =
        (fun j y => aux_nonWhitneyCorrectionConstant * aux_liftPlaneKernel (D.kernel j) y) := by
    dsimp [D]
    exact aux_nonWhitneyCorrectionSequence_eq_const_mul_data a ha phi0 phi1 hpair _
  have hcorr_bound :
      kernelSequenceSeminorm n 1 (by omega) (by omega)
          (fun j => aux_liftPlaneKernel (aux_nonWhitneyCorrection phi0 phi1 a j)) ≤
        ENNReal.ofReal (aux_nonWhitneyCorrectionConstant * C_diagonalBandReduction) := by
    rw [hcorr_eq, aux_kernelSequenceSeminorm_const_mul (by omega) (by omega)
      aux_nonWhitneyCorrectionConstant aux_nonWhitneyCorrectionConstant_pos.le]
    calc
      ENNReal.ofReal aux_nonWhitneyCorrectionConstant *
          kernelSequenceSeminorm n 1 (by omega) (by omega)
            (fun j => aux_liftPlaneKernel (D.kernel j)) ≤
          ENNReal.ofReal aux_nonWhitneyCorrectionConstant *
            ENNReal.ofReal C_diagonalBandReduction :=
        mul_le_mul_of_nonneg_left hD (by positivity)
      _ = ENNReal.ofReal
          (aux_nonWhitneyCorrectionConstant * C_diagonalBandReduction) :=
        (ENNReal.ofReal_mul aux_nonWhitneyCorrectionConstant_pos.le).symm
  have hM0mem := aux_oneScaleWindowSequence_mem a ha phi0
  have hM1mem := aux_nonWhitneyCorrectionSequence_mem a ha phi0 phi1
  have hbase := oneScaleEstimateWindow hn a ha phi0 phi1 hpair
  have hOne : 0 ≤ C_oneScaleEstimateWindow := by
    norm_num [C_oneScaleEstimateWindow, C_uniPair]
  have hprod : 0 ≤ aux_nonWhitneyCorrectionConstant * C_diagonalBandReduction :=
    mul_nonneg aux_nonWhitneyCorrectionConstant_pos.le hCdiag
  rw [aux_nonWhitney_decompose phi0 phi1 a]
  calc
    kernelSequenceSeminorm n 1 (by omega) (by omega)
        (fun j => aux_oneScaleWindowSequence phi0 a j +
          aux_liftPlaneKernel (aux_nonWhitneyCorrection phi0 phi1 a j)) ≤
        kernelSequenceSeminorm n 1 (by omega) (by omega)
          (aux_oneScaleWindowSequence phi0 a) +
          kernelSequenceSeminorm n 1 (by omega) (by omega)
            (fun j => aux_liftPlaneKernel (aux_nonWhitneyCorrection phi0 phi1 a j)) :=
      kernelSequenceSeminorm_add_le (by omega) (by omega) _ _ hM0mem hM1mem
    _ ≤ ENNReal.ofReal C_oneScaleEstimateWindow +
        ENNReal.ofReal (aux_nonWhitneyCorrectionConstant * C_diagonalBandReduction) :=
      add_le_add hbase hcorr_bound
    _ = ENNReal.ofReal
        (C_oneScaleEstimateWindow +
          aux_nonWhitneyCorrectionConstant * C_diagonalBandReduction) :=
      (ENNReal.ofReal_add hOne hprod).symm
    _ = ENNReal.ofReal C_inductPositiveTermsReductionNonWhitney := by
      unfold aux_nonWhitneyCorrectionConstant
        C_inductPositiveTermsReductionNonWhitney
      ring

-- The explicit numerical calculation below contains powers through `2^541`.
set_option exponentiation.threshold 600 in
/--
\begin{lemma}[constant $C_{\text{P:induct-positive-terms-reduction-non-whitney}}$ \auto]
\label{constant non Whitney reduction}
\begin{equation}\label{constant non Whitney reduction bound}
C_{\text{P:induct-positive-terms-reduction-non-whitney}}
<\tfrac89 2^{541}<2^{541}.
\end{equation}
\end{lemma}

See also [`Codex.Reduction.OnDiagonalOffDiagonal.inductPositiveTermsReductionNonWhitney`].
-/
theorem constantNonWhitneyReduction :
    C_inductPositiveTermsReductionNonWhitney <
      (8 / 9 : ℝ) * (2 : ℝ) ^ 541 := by
  have hratio : C_uniPair / (2 * Real.pi) < (2 : ℝ) ^ 15 / 6 := by
    rw [C_uniPair]
    apply (div_lt_div_iff₀ (by positivity) (by norm_num)).2
    nlinarith [Real.pi_gt_three]
  have hratio_nonneg : 0 ≤ C_uniPair / (2 * Real.pi) := by
    rw [C_uniPair]
    positivity
  have hratio_four : (C_uniPair / (2 * Real.pi)) ^ 4 <
      ((2 : ℝ) ^ 15 / 6) ^ 4 := by
    exact pow_lt_pow_left₀ hratio hratio_nonneg (by norm_num)
  have hright_one : (1 : ℝ) ≤ ((2 : ℝ) ^ 15 / 6) ^ 4 := by norm_num
  have hmax : max 1 ((C_uniPair / (2 * Real.pi)) ^ 4) ≤
      ((2 : ℝ) ^ 15 / 6) ^ 4 := by
    exact max_le hright_one hratio_four.le
  have hfirst : C_oneScaleEstimateWindow <
      (1 / 9 : ℝ) * (2 : ℝ) ^ 541 := by
    rw [constantOneScaleWindow]
    have hfactor : (1 : ℝ) < (1 / 9 : ℝ) * (2 : ℝ) ^ 61 := by norm_num
    calc
      (2 : ℝ) ^ 39 < (2 : ℝ) ^ 480 :=
        pow_lt_pow_right₀ (by norm_num) (by norm_num)
      _ = 1 * (2 : ℝ) ^ 480 := by ring
      _ < ((1 / 9 : ℝ) * (2 : ℝ) ^ 61) * (2 : ℝ) ^ 480 :=
        mul_lt_mul_of_pos_right hfactor (by positivity)
      _ = (1 / 9 : ℝ) * ((2 : ℝ) ^ 61 * (2 : ℝ) ^ 480) := by ring
      _ = (1 / 9 : ℝ) * (2 : ℝ) ^ 541 := by rw [← pow_add]
  have hsecond :
      128 * max 1 ((C_uniPair / (2 * Real.pi)) ^ 4) * C_smoothDecay2 2 ^ 2 *
          C_diagonalBandReduction <
        (7 / 9 : ℝ) * (2 : ℝ) ^ 541 := by
    by_cases hdiag : 0 ≤ C_diagonalBandReduction
    · calc
        128 * max 1 ((C_uniPair / (2 * Real.pi)) ^ 4) * C_smoothDecay2 2 ^ 2 *
            C_diagonalBandReduction ≤
            (128 * ((2 : ℝ) ^ 15 / 6) ^ 4 * C_smoothDecay2 2 ^ 2) *
              C_diagonalBandReduction := by gcongr
        _ < (128 * ((2 : ℝ) ^ 15 / 6) ^ 4 * C_smoothDecay2 2 ^ 2) *
            ((63 / 64 : ℝ) * (2 : ℝ) ^ 480) := by
              apply mul_lt_mul_of_pos_left constantDiagonalBandReduction
              norm_num [C_smoothDecay2]
        _ = (7 / 9 : ℝ) * (2 : ℝ) ^ 541 := by
              have hcoeff :
                  (128 : ℝ) * (((2 : ℝ) ^ 15 / 6) ^ 4) * C_smoothDecay2 2 ^ 2 *
                      (63 / 64 : ℝ) =
                    (7 / 9 : ℝ) * (2 : ℝ) ^ 61 := by
                  norm_num [C_smoothDecay2]
              calc
                (128 * ((2 : ℝ) ^ 15 / 6) ^ 4 * C_smoothDecay2 2 ^ 2) *
                    ((63 / 64 : ℝ) * (2 : ℝ) ^ 480) =
                    ((128 : ℝ) * (((2 : ℝ) ^ 15 / 6) ^ 4) * C_smoothDecay2 2 ^ 2 *
                      (63 / 64 : ℝ)) * (2 : ℝ) ^ 480 := by ring
                _ = ((7 / 9 : ℝ) * (2 : ℝ) ^ 61) * (2 : ℝ) ^ 480 := by rw [hcoeff]
                _ = (7 / 9 : ℝ) * ((2 : ℝ) ^ 61 * (2 : ℝ) ^ 480) := by ring
                _ = (7 / 9 : ℝ) * (2 : ℝ) ^ 541 := by rw [← pow_add]
    · have hprefix_nonneg :
          0 ≤ 128 * max 1 ((C_uniPair / (2 * Real.pi)) ^ 4) * C_smoothDecay2 2 ^ 2 := by
          positivity
      have hnonpos :
          128 * max 1 ((C_uniPair / (2 * Real.pi)) ^ 4) * C_smoothDecay2 2 ^ 2 *
              C_diagonalBandReduction ≤ 0 :=
        mul_nonpos_of_nonneg_of_nonpos hprefix_nonneg (le_of_not_ge hdiag)
      exact hnonpos.trans_lt (by positivity)
  unfold C_inductPositiveTermsReductionNonWhitney
  linarith

/-- The skip-terms non-Whitney sequence. -/
noncomputable def aux_nonWhitneySkipSequence (phi0 phi1 : SchwartzMap ℝ ℝ)
    (a : ℤ → ℝ) : KernelSequence 1 :=
  fun j => aux_liftPlaneKernel
    (tensorSquare (fun x => aux_windowRescale phi0 (a (2 * j)) x -
      aux_windowRescale phi1 (a (2 * j + 1)) x))

/-- The constant in the skip-terms non-Whitney reduction. -/
noncomputable def C_inductPositiveTermsReductionNonWhitneySkip (n : ℕ) : ℝ :=
  Real.rpow 2 (1 - Real.rpow 2 (2 - n)) *
    C_inductPositiveTermsReductionNonWhitney

/-- Odd-indexed partial sums of a nonnegative sequence are bounded by the
corresponding doubled prefix. -/
theorem aux_odd_sum_le_double_sum (p : ℕ → ℝ)
    (hpos : ∀ j, 0 ≤ p j) (J : ℕ) :
    (∑ j ∈ Finset.range J, p (2 * j + 1)) ≤
      ∑ r ∈ Finset.range (2 * J), p r := by
  induction J with
  | zero => simp
  | succ J ih =>
      rw [Finset.sum_range_succ]
      have htwo : 2 * (J + 1) = (2 * J + 1) + 1 := by omega
      rw [htwo, Finset.sum_range_succ, Finset.sum_range_succ]
      linarith [hpos (2 * J)]

/-- The odd-subsequence normalization produces the stated dyadic factor. -/
theorem aux_nonWhitneySkip_weight {n J : ℕ} (hn : 2 ≤ n) (hJ : 0 < J) :
    min 1 (Real.rpow (J : ℝ)
      (-1 + (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1))) =
      Real.rpow 2 (1 - Real.rpow 2 (2 - (n : ℝ))) *
        min 1 (Real.rpow ((2 * J : ℕ) : ℝ)
          (-1 + (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1))) := by
  let alpha : ℝ := 1 - Real.rpow 2 (2 - (n : ℝ))
  have hpow : (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1) =
      Real.rpow 2 (2 - (n : ℝ)) := by
    rw [← Real.rpow_intCast]
    congr 1
    push_cast
    ring
  have hexp : -1 + (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1) = -alpha := by
    rw [hpow]
    dsimp [alpha]
    ring
  rw [hexp]
  have hnreal : (2 : ℝ) ≤ n := by exact_mod_cast hn
  have hbase : 2 - (n : ℝ) ≤ 0 := by linarith
  have hpower_le : Real.rpow 2 (2 - (n : ℝ)) ≤ 1 :=
    Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) hbase
  have halpha : 0 ≤ alpha := by
    change 0 ≤ 1 - Real.rpow 2 (2 - (n : ℝ))
    linarith
  have hJone : (1 : ℝ) ≤ J := by
    exact_mod_cast (Nat.succ_le_iff.mpr hJ)
  have htwoJpos : 0 < 2 * J := by omega
  have htwoJone : (1 : ℝ) ≤ (2 * J : ℕ) := by
    exact_mod_cast (Nat.succ_le_iff.mpr htwoJpos)
  have hJpow : Real.rpow (J : ℝ) (-alpha) ≤ 1 :=
    Real.rpow_le_one_of_one_le_of_nonpos hJone (by linarith)
  have htwoJpow : Real.rpow ((2 * J : ℕ) : ℝ) (-alpha) ≤ 1 :=
    Real.rpow_le_one_of_one_le_of_nonpos htwoJone (by linarith)
  rw [min_eq_right hJpow, min_eq_right htwoJpow]
  have hcast : ((2 * J : ℕ) : ℝ) = 2 * (J : ℝ) := by norm_num
  rw [hcast]
  change Real.rpow (J : ℝ) (-alpha) =
    Real.rpow 2 alpha * Real.rpow (2 * (J : ℝ)) (-alpha)
  have hmul : Real.rpow (2 * (J : ℝ)) (-alpha) =
      Real.rpow 2 (-alpha) * Real.rpow (J : ℝ) (-alpha) := by
    exact Real.mul_rpow (by norm_num) (by positivity)
  rw [hmul]
  change Real.rpow (J : ℝ) (-alpha) =
    Real.rpow 2 alpha *
      (Real.rpow 2 (-alpha) * Real.rpow (J : ℝ) (-alpha))
  have hcancel : Real.rpow 2 alpha * Real.rpow 2 (-alpha) = 1 := by
    have hadd : Real.rpow 2 (alpha + -alpha) =
        Real.rpow 2 alpha * Real.rpow 2 (-alpha) := by
      exact Real.rpow_add (by norm_num : (0 : ℝ) < 2) _ _
    rw [← hadd]
    norm_num
  calc
    Real.rpow (J : ℝ) (-alpha) = 1 * Real.rpow (J : ℝ) (-alpha) := by ring
    _ = (Real.rpow 2 alpha * Real.rpow 2 (-alpha)) *
        Real.rpow (J : ℝ) (-alpha) := by rw [hcancel]
    _ = Real.rpow 2 alpha *
        (Real.rpow 2 (-alpha) * Real.rpow (J : ℝ) (-alpha)) := by ring

/-- A pointwise-positive kernel sequence controls its odd-indexed subsequence. -/
theorem aux_kernelSequenceSeminorm_odd_subsequence_le {n : ℕ} (hn : 2 ≤ n)
    (M : KernelSequence 1) (hM : MemKernelSequence 1 M)
    (hpos : ∀ (j : ℤ) (F : NormalizedFunctionTuple n),
      0 ≤ prismForm n 1 (by omega) (by omega) (M j) (fun q => F.1 q))
    (C : ℝ)
    (hbound : kernelSequenceSeminorm n 1 (by omega) (by omega) M ≤ ENNReal.ofReal C) :
    kernelSequenceSeminorm n 1 (by omega) (by omega)
      (fun j => M (2 * j + 1)) ≤
      ENNReal.ofReal
        (Real.rpow 2 (1 - Real.rpow 2 (2 - (n : ℝ))) * C) := by
  classical
  unfold kernelSequenceSeminorm
  refine iSup_le fun J => ?_
  refine iSup_le fun F => ?_
  let p : ℕ → ℝ := fun j =>
    prismForm n 1 (by omega) (by omega) (M (j : ℤ)) (fun q => F.1 q)
  have hp_nonneg (j : ℕ) : 0 ≤ p j := by
    dsimp [p]
    exact hpos (j : ℤ) F
  have hlin (N : ℕ) :
      prismForm n 1 (by omega) (by omega)
        (fun y => ∑ j ∈ Finset.range N, M (j : ℤ) y) (fun q => F.1 q) =
        ∑ j ∈ Finset.range N, p j := by
    simpa [p] using
      (aux_prismForm_finset_sum (n := n) (k := 1) (by omega) (by omega)
        (Finset.range N) (fun j : ℕ => M (j : ℤ))
        (by
          intro j hj
          exact hM (j : ℤ)) F.1)
  have hskiplin :
      prismForm n 1 (by omega) (by omega)
        (fun y => ∑ j ∈ Finset.range J.1, M (2 * (j : ℤ) + 1) y)
        (fun q => F.1 q) =
        ∑ j ∈ Finset.range J.1, p (2 * j + 1) := by
    simpa [p] using
      (aux_prismForm_finset_sum (n := n) (k := 1) (by omega) (by omega)
        (Finset.range J.1) (fun j : ℕ => M (2 * (j : ℤ) + 1))
        (by
          intro j hj
          exact hM (2 * (j : ℤ) + 1)) F.1)
  have hskip_nonneg : 0 ≤ ∑ j ∈ Finset.range J.1, p (2 * j + 1) := by
    apply Finset.sum_nonneg
    intro j hj
    exact hp_nonneg _
  have hsumle : (∑ j ∈ Finset.range J.1, p (2 * j + 1)) ≤
      ∑ r ∈ Finset.range (2 * J.1), p r :=
    aux_odd_sum_le_double_sum p hp_nonneg J.1
  have hfull_nonneg : 0 ≤ ∑ r ∈ Finset.range (2 * J.1), p r := by
    apply Finset.sum_nonneg
    intro r hr
    exact hp_nonneg r
  have hfullENN : ENNReal.ofReal
      (min 1 (Real.rpow ((2 * J.1 : ℕ) : ℝ)
        (-1 + (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1))) *
        |prismForm n 1 (by omega) (by omega)
          (fun y => ∑ j ∈ Finset.range (2 * J.1), M (j : ℤ) y)
          (fun q => F.1 q)|) ≤ ENNReal.ofReal C := by
    calc
      ENNReal.ofReal
          (min 1 (Real.rpow ((2 * J.1 : ℕ) : ℝ)
            (-1 + (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1))) *
            |prismForm n 1 (by omega) (by omega)
              (fun y => ∑ j ∈ Finset.range (2 * J.1), M (j : ℤ) y)
              (fun q => F.1 q)|) ≤
          kernelSequenceSeminorm n 1 (by omega) (by omega) M := by
            unfold kernelSequenceSeminorm
            let J2 : {K : ℕ // 0 < K} := ⟨2 * J.1, by omega⟩
            apply le_iSup_of_le J2
            apply le_iSup_of_le F
            simp [J2]
      _ ≤ ENNReal.ofReal C := hbound
  have hweight := aux_nonWhitneySkip_weight hn J.2
  rw [hskiplin, abs_of_nonneg hskip_nonneg]
  have hreal :
      min 1 (Real.rpow (J.1 : ℝ)
        (-1 + (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1))) *
        (∑ j ∈ Finset.range J.1, p (2 * j + 1)) ≤
      Real.rpow 2 (1 - Real.rpow 2 (2 - (n : ℝ))) *
        (min 1 (Real.rpow ((2 * J.1 : ℕ) : ℝ)
          (-1 + (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1))) *
          (∑ r ∈ Finset.range (2 * J.1), p r)) := by
    calc
      min 1 (Real.rpow (J.1 : ℝ)
        (-1 + (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1))) *
          (∑ j ∈ Finset.range J.1, p (2 * j + 1)) ≤
        min 1 (Real.rpow (J.1 : ℝ)
          (-1 + (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1))) *
          (∑ r ∈ Finset.range (2 * J.1), p r) := by
            exact mul_le_mul_of_nonneg_left hsumle
              (le_min zero_le_one (Real.rpow_nonneg (Nat.cast_nonneg _) _))
      _ = Real.rpow 2 (1 - Real.rpow 2 (2 - (n : ℝ))) *
          (min 1 (Real.rpow ((2 * J.1 : ℕ) : ℝ)
            (-1 + (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1))) *
            (∑ r ∈ Finset.range (2 * J.1), p r)) := by
              rw [hweight]
              ring
  have hfactor_nonneg : 0 ≤ Real.rpow 2 (1 - Real.rpow 2 (2 - (n : ℝ))) :=
    Real.rpow_nonneg (by norm_num) _
  calc
    ENNReal.ofReal
        (min 1 (Real.rpow (J.1 : ℝ)
          (-1 + (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1))) *
          (∑ j ∈ Finset.range J.1, p (2 * j + 1))) ≤
        ENNReal.ofReal
          (Real.rpow 2 (1 - Real.rpow 2 (2 - (n : ℝ))) *
            (min 1 (Real.rpow ((2 * J.1 : ℕ) : ℝ)
              (-1 + (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1))) *
              (∑ r ∈ Finset.range (2 * J.1), p r))) :=
      ENNReal.ofReal_le_ofReal hreal
    _ = ENNReal.ofReal (Real.rpow 2 (1 - Real.rpow 2 (2 - (n : ℝ)))) *
        ENNReal.ofReal
          (min 1 (Real.rpow ((2 * J.1 : ℕ) : ℝ)
            (-1 + (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1))) *
            (∑ r ∈ Finset.range (2 * J.1), p r)) :=
      ENNReal.ofReal_mul hfactor_nonneg
    _ = ENNReal.ofReal (Real.rpow 2 (1 - Real.rpow 2 (2 - (n : ℝ)))) *
        ENNReal.ofReal
          (min 1 (Real.rpow ((2 * J.1 : ℕ) : ℝ)
            (-1 + (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1))) *
            |prismForm n 1 (by omega) (by omega)
              (fun y => ∑ j ∈ Finset.range (2 * J.1), M (j : ℤ) y)
              (fun q => F.1 q)|) := by
        rw [hlin (2 * J.1), abs_of_nonneg hfull_nonneg]
    _ ≤ ENNReal.ofReal (Real.rpow 2 (1 - Real.rpow 2 (2 - (n : ℝ)))) *
        ENNReal.ofReal C := by gcongr
    _ = ENNReal.ofReal
        (Real.rpow 2 (1 - Real.rpow 2 (2 - (n : ℝ))) * C) :=
      (ENNReal.ofReal_mul hfactor_nonneg).symm

/--
\begin{proposition}[induct positive terms - reduction variant, non-Whitney, skip terms]
\label{P:induct-positive-terms-reduction-non-whitney-skip}
Let $a\in A$ and let
\begin{equation}\label{auto:skipped-non-Whitney-kernel}
\tilde{M}_j=({\phi}_{0,a(2j)}-{\phi}_{1,a(2j+1)})^{\otimes 2}.
\end{equation}
Then with $\tilde{\M}=(\tilde{M}_j)_{j\in \Z}$,
\begin{equation}\label{E:est-skipped-terms}
\|\tilde{\M}\|_{\rm M(1)}\le C_{\text{P:induct-positive-terms-reduction-non-whitney-skip}},
\end{equation}
where $C_{\text{P:induct-positive-terms-reduction-non-whitney-skip}}=
2^{1-2^{2-n}} C_{\text{P:induct-positive-terms-reduction-non-whitney}}$.
\end{proposition}

See also [`Codex.Reduction.OnDiagonalOffDiagonal.inductPositiveTermsReductionNonWhitneySkip`],
[`Codex.Reduction.OnDiagonalOffDiagonal.inductPositiveTermsReductionNonWhitney`].
-/
theorem inductPositiveTermsReductionNonWhitneySkip {n : ℕ} (hn : 2 ≤ n)
    (a : ℤ → ℝ) (ha : SpacedSequence a) (phi0 phi1 : SchwartzMap ℝ ℝ)
    (hpair : uniPair phi0 phi1) :
    kernelSequenceSeminorm n 1 (by omega) (by omega)
      (aux_nonWhitneySkipSequence phi0 phi1 a) ≤
        ENNReal.ofReal (C_inductPositiveTermsReductionNonWhitneySkip n) := by
  classical
  let gamma : GeometricParameters n :=
    { k := 1
      one_le_k := by omega
      k_le_n := by omega
      orientation := fun _ => 0
      scales := fun _ _ => a
      scales_spaced := by
        intro i r
        exact ha
      finite_distance := by
        intro i
        have hself : SequenceDistance a a = 0 := by
          apply le_antisymm
          · exact aux_sequenceDistance_le_of_within (a := a) (b := a) (k := 0) (by
              intro j
              constructor <;> simp)
          · exact bot_le
        rw [hself]
        exact WithTop.coe_lt_top _ }
  let i : Fin gamma.k := ⟨0, by dsimp [gamma]; omega⟩
  let X : DoubleSequence gamma.k := fun _ j =>
    tensorSquare (fun x => aux_windowRescale phi0 (a (j - 1)) x -
      aux_windowRescale phi1 (a j) x)
  have hX : MemDoubleSequence gamma.k X := by
    intro q j
    dsimp [X]
    exact aux_memW0_tensorSquare _ (aux_memW0_sub
      (aux_windowRescale_memW0 phi0 (ha _).1)
      (aux_windowRescale_memW0 phi1 (ha _).1))
  have hfactor : ∀ q j, ∃ f : ℝ → ℝ, MemW0 f ∧
      ∀ u v, X q j (u, v) = f u * f v := by
    intro q j
    refine ⟨fun x => aux_windowRescale phi0 (a (j - 1)) x -
        aux_windowRescale phi1 (a j) x, ?_, ?_⟩
    · exact aux_memW0_sub
        (aux_windowRescale_memW0 phi0 (ha _).1)
        (aux_windowRescale_memW0 phi1 (ha _).1)
    · intro u v
      rfl
  have hsandwich (j : ℤ) :
      sandwichKernel gamma X i j = aux_nonWhitneySequence phi0 phi1 a j := by
    have hright : Finset.univ.filter (fun q : Fin gamma.k => i < q) = ∅ := by
      ext q
      simp [gamma, i]
    funext y
    unfold sandwichKernel
    rw [hright]
    simp [gamma, X, i, aux_nonWhitneySequence, aux_nonWhitneyKernel,
      aux_liftPlaneKernel]
  have hskip (j : ℤ) :
      aux_nonWhitneySkipSequence phi0 phi1 a j =
        sandwichKernel gamma X i (2 * j + 1) := by
    rw [hsandwich]
    funext y
    simp [aux_nonWhitneySkipSequence, aux_nonWhitneySequence,
      aux_nonWhitneyKernel, aux_liftPlaneKernel]
  have hmem (j : ℤ) : MemW0 (sandwichKernel gamma X i j) :=
    sandwichKernel_memKernelSequence gamma X hX i j
  have hpos (j : ℤ) (F : NormalizedFunctionTuple n) :
      0 ≤ prismForm n gamma.k gamma.one_le_k gamma.k_le_n
        (sandwichKernel gamma X i j) (fun q => F.1 q) :=
    positiveTerms gamma X hX hfactor i j F.1 F.2
  let M : KernelSequence 1 := fun j => sandwichKernel gamma X i j
  have hM : MemKernelSequence 1 M := by
    intro j
    dsimp [M]
    simpa [gamma] using hmem j
  have hposM (j : ℤ) (F : NormalizedFunctionTuple n) :
      0 ≤ prismForm n 1 (by omega) (by omega) (M j) (fun q => F.1 q) := by
    dsimp [M]
    simpa [gamma] using hpos j F
  have hM_eq : M = aux_nonWhitneySequence phi0 phi1 a := by
    funext j
    exact hsandwich j
  have hbound : kernelSequenceSeminorm n 1 (by omega) (by omega) M ≤
      ENNReal.ofReal C_inductPositiveTermsReductionNonWhitney := by
    rw [hM_eq]
    exact inductPositiveTermsReductionNonWhitney hn a ha phi0 phi1 hpair
  have hmain := aux_kernelSequenceSeminorm_odd_subsequence_le hn M hM hposM
    C_inductPositiveTermsReductionNonWhitney hbound
  have hskip_eq : aux_nonWhitneySkipSequence phi0 phi1 a =
      fun j => M (2 * j + 1) := by
    funext j
    dsimp [M]
    exact hskip j
  rw [hskip_eq]
  simpa [C_inductPositiveTermsReductionNonWhitneySkip] using hmain

/--
\begin{lemma}[constant $C_{\text{P:induct-positive-terms-reduction-non-whitney-skip}}$ \auto]
\label{constant non Whitney skip reduction}
\begin{equation}\label{constant non Whitney skip reduction bound}
C_{\text{P:induct-positive-terms-reduction-non-whitney-skip}}
<\tfrac89 2^{542}<2^{542}.
\end{equation}
\end{lemma}

See also [`Codex.Reduction.OnDiagonalOffDiagonal.inductPositiveTermsReductionNonWhitneySkip`].
-/
theorem constantNonWhitneySkipReduction {n : ℕ} (_hn : 2 ≤ n) :
    C_inductPositiveTermsReductionNonWhitneySkip n <
      (8 / 9 : ℝ) * (2 : ℝ) ^ 542 := by
  have hbeta : 1 - Real.rpow 2 (2 - (n : ℝ)) ≤ 1 := by
    have hnonneg : 0 ≤ Real.rpow 2 (2 - (n : ℝ)) :=
      Real.rpow_nonneg (by norm_num) _
    linarith
  have hfactor_le : Real.rpow 2 (1 - Real.rpow 2 (2 - (n : ℝ))) ≤ 2 := by
    calc
      Real.rpow 2 (1 - Real.rpow 2 (2 - (n : ℝ))) ≤ Real.rpow 2 1 :=
        Real.rpow_le_rpow_of_exponent_le (by norm_num) hbeta
      _ = 2 := by norm_num
  have hfactor_pos : 0 < Real.rpow 2 (1 - Real.rpow 2 (2 - (n : ℝ))) :=
    Real.rpow_pos_of_pos (by norm_num) _
  unfold C_inductPositiveTermsReductionNonWhitneySkip
  calc
    Real.rpow 2 (1 - Real.rpow 2 (2 - (n : ℝ))) *
        C_inductPositiveTermsReductionNonWhitney <
      Real.rpow 2 (1 - Real.rpow 2 (2 - (n : ℝ))) *
        ((8 / 9 : ℝ) * (2 : ℝ) ^ 541) :=
      mul_lt_mul_of_pos_left constantNonWhitneyReduction hfactor_pos
    _ ≤ 2 * ((8 / 9 : ℝ) * (2 : ℝ) ^ 541) :=
      mul_le_mul_of_nonneg_right hfactor_le (by positivity)
    _ = (8 / 9 : ℝ) * (2 : ℝ) ^ 542 := by
      calc
        2 * ((8 / 9 : ℝ) * (2 : ℝ) ^ 541) =
            (8 / 9 : ℝ) * (2 * (2 : ℝ) ^ 541) := by ac_rfl
        _ = (8 / 9 : ℝ) * ((2 : ℝ) ^ 1 * (2 : ℝ) ^ 541) := by
          congr 1
          congr 1
          norm_num
        _ = (8 / 9 : ℝ) * (2 : ℝ) ^ (1 + 541) := by
          rw [pow_add]
        _ = (8 / 9 : ℝ) * (2 : ℝ) ^ 542 := by norm_num

/-- The hypotheses on the base kernel in the Whitney reduction. -/
structure WhitneyKernelData where
  kernel : RealPlane → ℝ
  /-- The Schwartz base kernel assumed in the Whitney reduction. -/
  kernel_schwartz : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℝ
  /-- Its coordinate realization agrees with `kernel`. -/
  kernel_schwartz_eq : ∀ u : EuclideanSpace ℝ (Fin 2),
    kernel_schwartz u = kernel (u 0, u 1)
  kernel_memW0 : MemW0 kernel
  kernel_nonzero : kernel ≠ 0
  symmetric : ∀ v : RealPlane, kernel v = kernel (v.2, v.1)
  positive : ∀ g : ℝ → ℝ, Codex.Reduction.BumpFunctions.aux_bounded g →
    0 ≤ ∫ v : RealPlane, g v.1 * g v.2 * kernel v
  fourier_support :
    Function.support (aux_planeFourier kernel) ⊆
      {v : EuclideanSpace ℝ (Fin 2) | v 0 ∈ aux_annulusOne 1 ((2 : ℝ) ^ 3) ∧
        v 1 ∈ aux_annulusOne 1 ((2 : ℝ) ^ 3)}
  diagonal_derivative : ∀ m : ℕ, m < 3 → ∀ xi : ℝ,
    ‖iteratedDeriv m
      (fun z : ℝ => aux_planeFourier kernel (WithLp.toLp 2 ![z, -z])) xi‖ ≤ 1
  decay : ∀ v : RealPlane, |kernel v| ≤
    ∑ u : Fin 2,
      scaledBracketBumpReal (3 / 2 : ℝ) 1 ((W u v).1) *
        scaledBracketBumpReal (3 / 2 : ℝ) 1 ((W u v).2)

/-- The two-dimensional normalized rescaling of a Whitney kernel. -/
noncomputable def aux_planeRescale (t : ℝ) (Psi : RealPlane → ℝ) : RealPlane → ℝ :=
  fun v => t⁻¹ ^ 2 * Psi (t⁻¹ * v.1, t⁻¹ * v.2)

/-- In plane coordinates, the normalized rescaling of `integralFctKernel` is
the two-dimensional rescaling used by the integral-kernel estimates. -/
theorem planeRescale_integralFctKernel_eq
    (s : ℝ) (psi : ℝ → ℝ) (u : EuclideanSpace ℝ (Fin 2)) :
    aux_planeRescale s
      (fun v : RealPlane => integralFctKernel psi (WithLp.toLp 2 ![v.1, v.2]))
      (u 0, u 1) =
      aux_integralFctKernelAtScale s psi u := by
  unfold aux_planeRescale aux_integralFctKernelAtScale rescaled
  rfl

/-- The preceding coordinate identity remains available after replacing the
physical kernel by any bundled Schwartz representative. -/
theorem planeRescale_schwartzKernel_eq
    (s : ℝ) (psi : ℝ → ℝ) (K : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℝ)
    (hK : ∀ u : EuclideanSpace ℝ (Fin 2), K u = integralFctKernel psi u)
    (u : EuclideanSpace ℝ (Fin 2)) :
    aux_planeRescale s
      (fun v : RealPlane => K (WithLp.toLp 2 ![v.1, v.2]))
      (u 0, u 1) =
      aux_integralFctKernelAtScale s psi u := by
  rw [show aux_planeRescale s
      (fun v : RealPlane => K (WithLp.toLp 2 ![v.1, v.2])) (u 0, u 1) =
      aux_planeRescale s
        (fun v : RealPlane => integralFctKernel psi (WithLp.toLp 2 ![v.1, v.2]))
        (u 0, u 1) by
          unfold aux_planeRescale
          congr 2
          exact hK _]
  exact planeRescale_integralFctKernel_eq s psi u

/-- The interleaved scale sequence used in the Whitney gap reduction. -/
noncomputable def aux_whitneyAlpha (a : ℤ → ℝ) (k : ℤ) : ℝ :=
  if k % 2 = 0 then (2 : ℝ) ^ (-5 : ℤ) * a (k / 2)
  else (2 : ℝ) ^ (5 : ℤ) * a ((k - 1) / 2)

theorem aux_whitneyAlpha_even (a : ℤ → ℝ) (j : ℤ) :
    aux_whitneyAlpha a (2 * j) = (2 : ℝ) ^ (-5 : ℤ) * a j := by
  simp [aux_whitneyAlpha]

theorem aux_whitneyAlpha_odd (a : ℤ → ℝ) (j : ℤ) :
    aux_whitneyAlpha a (2 * j + 1) = (2 : ℝ) ^ (5 : ℤ) * a j := by
  have hmod : (2 * j + 1) % 2 = 1 := by omega
  rw [aux_whitneyAlpha, if_neg (by omega : ¬ (2 * j + 1) % 2 = 0)]
  congr 2
  omega

theorem aux_whitneyAlpha_spaced (a : ℤ → ℝ) (ha : SpacedSequence a)
    (hgap : ∀ j : ℤ, (2 : ℝ) ^ 11 * a (j - 1) ≤ a j) :
    SpacedSequence (aux_whitneyAlpha a) := by
  intro k
  rcases k.even_or_odd with ⟨j, hj⟩ | ⟨j, hj⟩
  · subst k
    constructor
    · rw [show j + j = 2 * j by ring, aux_whitneyAlpha_even]
      exact mul_pos (zpow_pos (by norm_num) _) (ha j).1
    · have h0 : aux_whitneyAlpha a (j + j) = (2 : ℝ) ^ (-5 : ℤ) * a j := by
        rw [show j + j = 2 * j by ring, aux_whitneyAlpha_even]
      have h1 : aux_whitneyAlpha a (j + j + 1) = (2 : ℝ) ^ (5 : ℤ) * a j := by
        rw [show j + j + 1 = 2 * j + 1 by ring, aux_whitneyAlpha_odd]
      rw [h0, h1]
      have hfac : 2 * (2 : ℝ) ^ (-5 : ℤ) ≤ (2 : ℝ) ^ (5 : ℤ) := by
        norm_num [zpow_neg]
      simpa [mul_assoc] using mul_le_mul_of_nonneg_right hfac (ha j).1.le
  · subst k
    constructor
    · rw [aux_whitneyAlpha_odd]
      exact mul_pos (zpow_pos (by norm_num) _) (ha j).1
    · have h0 : aux_whitneyAlpha a (2 * j + 1) = (2 : ℝ) ^ (5 : ℤ) * a j := by
        exact aux_whitneyAlpha_odd a j
      have h1 : aux_whitneyAlpha a (2 * j + 1 + 1) =
          (2 : ℝ) ^ (-5 : ℤ) * a (j + 1) := by
        rw [show 2 * j + 1 + 1 = 2 * (j + 1) by ring, aux_whitneyAlpha_even]
      rw [h0, h1]
      have hg : (2 : ℝ) ^ 11 * a j ≤ a (j + 1) := by
        convert hgap (j + 1) using 1; ring_nf
      have hnonneg : 0 ≤ (2 : ℝ) ^ (-5 : ℤ) :=
        (zpow_pos (by norm_num) _).le
      have hscale := mul_le_mul_of_nonneg_left hg hnonneg
      calc
        2 * ((2 : ℝ) ^ (5 : ℤ) * a j) =
            (2 : ℝ) ^ (-5 : ℤ) * ((2 : ℝ) ^ 11 * a j) := by
              norm_num [zpow_neg]
              ring
        _ ≤ (2 : ℝ) ^ (-5 : ℤ) * a (j + 1) := hscale

theorem aux_whitney_phiJProperties
    (phi0 phi1 : SchwartzMap ℝ ℝ) (hpair : uniPair phi0 phi1)
    (Psi : WhitneyKernelData) :
    ∃ psi : SchwartzMap ℝ ℝ,
      (∀ xi : ℝ,
        FourierTransform.fourier (fun x : ℝ ↦ (psi x : ℂ)) xi ^ 2 =
          2 * (FourierTransform.fourier (fun x : ℝ ↦ (phi0 x : ℂ))
            ((2 : ℝ) ^ (-5 : ℤ) * xi) -
            FourierTransform.fourier (fun x : ℝ ↦ (phi1 x : ℂ))
              ((2 : ℝ) ^ (5 : ℤ) * xi)) ^ 2 -
            FourierTransform.fourier
              (fun x : EuclideanSpace ℝ (Fin 2) ↦ (Psi.kernel_schwartz x : ℂ))
              (WithLp.toLp 2 ![xi, -xi])) ∧
      (∀ x : ℝ, psi (-x) = psi x) ∧
      Function.support (FourierTransform.fourier (fun x : ℝ ↦ (psi x : ℂ))) ⊆
        aux_annulusOne 1 ((2 : ℝ) ^ 6) ∧
      (∀ m : ℕ, m < 3 → ∀ xi : ℝ,
        ‖iteratedDeriv m
          (FourierTransform.fourier (fun x : ℝ ↦ (psi x : ℂ))) xi‖ ≤
            C_phiJProperties) := by
  have hnonzero : Psi.kernel_schwartz ≠ 0 := by
    intro hzero
    apply Psi.kernel_nonzero
    funext v
    have h : Psi.kernel_schwartz (WithLp.toLp 2 ![v.1, v.2]) = 0 := by
      rw [hzero]
      rfl
    rw [Psi.kernel_schwartz_eq] at h
    simpa using h
  have hsym : ∀ u : EuclideanSpace ℝ (Fin 2),
      Psi.kernel_schwartz u = Psi.kernel_schwartz (WithLp.toLp 2 ![u 1, u 0]) := by
    intro u
    rw [Psi.kernel_schwartz_eq, Psi.kernel_schwartz_eq]
    simpa using Psi.symmetric (u 0, u 1)
  have hpos : ∀ g : ℝ → ℝ, aux_bounded g →
      0 ≤ ∫ u : EuclideanSpace ℝ (Fin 2),
        g (u 0) * g (u 1) * Psi.kernel_schwartz u := by
    intro g hg
    let e : EuclideanSpace ℝ (Fin 2) ≃ᵐ (ℝ × ℝ) :=
      (MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.trans MeasurableEquiv.finTwoArrow
    have he : MeasurePreserving e volume volume :=
      (PiLp.volume_preserving_toLp (Fin 2)).symm.trans
        (MeasureTheory.volume_preserving_finTwoArrow ℝ)
    let G : ℝ × ℝ → ℝ := fun v => g v.1 * g v.2 * Psi.kernel v
    have hG : (fun u : EuclideanSpace ℝ (Fin 2) =>
        g (u 0) * g (u 1) * Psi.kernel_schwartz u) = G ∘ e := by
      funext u
      dsimp [G, e]
      rw [Psi.kernel_schwartz_eq]
      simp [MeasurableEquiv.finTwoArrow_apply]
    rw [hG]
    exact (he.integral_comp' G).symm ▸ Psi.positive g hg
  have hsupp : Function.support
      (FourierTransform.fourier (fun x : EuclideanSpace ℝ (Fin 2) ↦
        (Psi.kernel_schwartz x : ℂ))) ⊆
        aux_productSet (aux_annulusOne 1 ((2 : ℝ) ^ 3)) := by
    intro x hx
    have hx' : x ∈ Function.support (aux_planeFourier Psi.kernel) := by
      simpa [aux_planeFourier, Psi.kernel_schwartz_eq] using hx
    simpa [aux_productSet] using Psi.fourier_support hx'
  have hderiv : ∀ m : ℕ, m < 3 → ∀ xi : ℝ,
      ‖iteratedDeriv m
        (fun z : ℝ ↦ FourierTransform.fourier
          (fun x : EuclideanSpace ℝ (Fin 2) ↦ (Psi.kernel_schwartz x : ℂ))
          (WithLp.toLp 2 ![z, -z])) xi‖ ≤ 1 := by
    simpa [aux_planeFourier, Psi.kernel_schwartz_eq] using Psi.diagonal_derivative
  exact phiJProperties phi0 phi1 hpair Psi.kernel_schwartz hnonzero hsym hpos hsupp hderiv

theorem aux_planeRescale_memW0 (Psi : RealPlane → ℝ) (hPsi : MemW0 Psi)
    {t : ℝ} (ht : 0 < t) : MemW0 (aux_planeRescale t Psi) := by
  let e : RealPlane ≃L[ℝ] RealPlane :=
    ContinuousLinearEquiv.smulLeft (Units.mk0 t⁻¹ (inv_ne_zero ht.ne'))
  have hcomp : MemW0 (Psi ∘ e) := aux_memW0_comp_continuousLinearEquiv hPsi e
  have hscale : 0 ≤ t⁻¹ ^ 2 := sq_nonneg _
  have h := aux_memW0_const_mul_nonneg hcomp (t⁻¹ ^ 2) hscale
  convert h using 1
  funext v
  change t⁻¹ ^ 2 * Psi (t⁻¹ * v.1, t⁻¹ * v.2) = t⁻¹ ^ 2 * Psi (t⁻¹ • v)
  congr 2

theorem aux_planeRescale_positive (Psi : RealPlane → ℝ)
    (hpos : ∀ g : ℝ → ℝ, aux_bounded g →
      0 ≤ ∫ v : RealPlane, g v.1 * g v.2 * Psi v)
    {t : ℝ} (ht : 0 < t) :
    ∀ g : ℝ → ℝ, aux_bounded g →
      0 ≤ ∫ v : RealPlane, g v.1 * g v.2 * aux_planeRescale t Psi v := by
  intro g hg
  let gt : ℝ → ℝ := fun x => g (t * x)
  have hgt : aux_bounded gt := by
    constructor
    · exact hg.1.comp (by fun_prop)
    · apply hg.2.subset
      rintro y ⟨x, rfl⟩
      exact ⟨t * x, rfl⟩
  let F : RealPlane → ℝ := fun q => gt q.1 * gt q.2 * Psi q
  have hbase : 0 ≤ ∫ q : RealPlane, F q := by simpa [F] using hpos gt hgt
  have hformula : (fun v : RealPlane => g v.1 * g v.2 * aux_planeRescale t Psi v) =
      fun v : RealPlane => t⁻¹ ^ 2 * F (t⁻¹ • v) := by
    funext v
    have hscalev : t⁻¹ • v = (t⁻¹ * v.1, t⁻¹ * v.2) := rfl
    rw [hscalev]
    dsimp [aux_planeRescale, F, gt]
    field_simp [ne_of_gt ht]
  rw [hformula, integral_const_mul, Measure.integral_comp_inv_smul]
  norm_num [Module.finrank_prod]
  rw [← mul_assoc, inv_mul_cancel₀ (pow_ne_zero _ ht.ne'), one_mul]
  exact hbase

theorem aux_planeRescale_fourierPlane (t : ℝ) (ht : 0 < t)
    (Psi : RealPlane → ℝ) (xi : RealPlane) :
    aux_fourierPlane (aux_planeRescale t Psi) xi =
      aux_fourierPlane Psi (t • xi) := by
  unfold aux_fourierPlane
  let g : RealPlane → ℂ := fun q => (Psi q : ℂ) * Complex.exp
    (-((2 : ℂ) * Real.pi * Complex.I * (q.1 * (t • xi).1 + q.2 * (t • xi).2)))
  calc
    (∫ v : RealPlane, (aux_planeRescale t Psi v : ℂ) * Complex.exp
        (-((2 : ℂ) * Real.pi * Complex.I * (v.1 * xi.1 + v.2 * xi.2)))) =
        ∫ v : RealPlane, (t⁻¹ ^ 2 : ℂ) * g (t⁻¹ • v) := by
      apply integral_congr_ae
      filter_upwards [] with v
      dsimp [aux_planeRescale, g]
      have hsmul : t⁻¹ • v = (t⁻¹ * v.1, t⁻¹ * v.2) := by rfl
      have hphase : Complex.exp
          (-((2 : ℂ) * Real.pi * Complex.I *
            (((t⁻¹ * v.1 : ℝ) : ℂ) * ((t * xi.1 : ℝ) : ℂ) +
              ((t⁻¹ * v.2 : ℝ) : ℂ) * ((t * xi.2 : ℝ) : ℂ)))) =
          Complex.exp (-((2 : ℂ) * Real.pi * Complex.I *
            (v.1 * xi.1 + v.2 * xi.2))) := by
        congr 1
        push_cast
        field_simp [ne_of_gt ht]
      rw [hsmul, hphase]
      push_cast
      ring
    _ = (t⁻¹ ^ 2 : ℂ) * ∫ v : RealPlane, g (t⁻¹ • v) := by
      rw [integral_const_mul]
    _ = (t⁻¹ ^ 2 : ℂ) * (t ^ Module.finrank ℝ RealPlane • ∫ q : RealPlane, g q) := by
      rw [Measure.integral_comp_inv_smul_of_nonneg (μ := volume) g ht.le]
    _ = ∫ q : RealPlane, g q := by
      norm_num
      field_simp [ne_of_gt ht]
    _ = aux_fourierPlane Psi (t • xi) := by rfl

theorem aux_planeRescale_planeFourier (t : ℝ) (ht : 0 < t)
    (Psi : RealPlane → ℝ) (xi : EuclideanSpace ℝ (Fin 2)) :
    aux_planeFourier (aux_planeRescale t Psi) xi =
      aux_planeFourier Psi (t • xi) := by
  change FourierTransform.fourier
      (fun v : EuclideanSpace ℝ (Fin 2) =>
        (aux_planeRescale t Psi (v 0, v 1) : ℂ)) xi =
    FourierTransform.fourier
      (fun v : EuclideanSpace ℝ (Fin 2) => (Psi (v 0, v 1) : ℂ)) (t • xi)
  rw [Real.fourier_eq', Real.fourier_eq']
  let g : EuclideanSpace ℝ (Fin 2) → ℂ := fun q =>
    Complex.exp (↑(-2 * Real.pi * ⟪q, t • xi⟫) * Complex.I) •
      (Psi (q 0, q 1) : ℂ)
  calc
    (∫ v : EuclideanSpace ℝ (Fin 2),
        Complex.exp (↑(-2 * Real.pi * ⟪v, xi⟫) * Complex.I) •
          (aux_planeRescale t Psi (v 0, v 1) : ℂ)) =
        ∫ v : EuclideanSpace ℝ (Fin 2), (t⁻¹ ^ 2 : ℂ) * g (t⁻¹ • v) := by
      apply integral_congr_ae
      filter_upwards [] with v
      dsimp [aux_planeRescale, g]
      have hinner : ⟪t⁻¹ • v, t • xi⟫ = ⟪v, xi⟫ := by
        rw [inner_smul_left, inner_smul_right]
        rw [starRingEnd_apply, star_trivial]
        field_simp [ne_of_gt ht]
      rw [hinner]
      push_cast
      ring
    _ = (t⁻¹ ^ 2 : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2), g (t⁻¹ • v) := by
      rw [integral_const_mul]
    _ = (t⁻¹ ^ 2 : ℂ) *
        (t ^ Module.finrank ℝ (EuclideanSpace ℝ (Fin 2)) •
          ∫ q : EuclideanSpace ℝ (Fin 2), g q) := by
      rw [Measure.integral_comp_inv_smul_of_nonneg (μ := volume) g ht.le]
    _ = ∫ q : EuclideanSpace ℝ (Fin 2), g q := by
      norm_num
      field_simp [ne_of_gt ht]
    _ = _ := by
      simp only [g]

theorem aux_planeFourier_eq_fourierPlane (M : RealPlane → ℝ) (xi eta : ℝ) :
    aux_planeFourier M (WithLp.toLp 2 ![xi, eta]) =
      aux_fourierPlane M (xi, eta) := by
  rw [aux_planeFourier, Real.fourier_eq']
  let e : EuclideanSpace ℝ (Fin 2) ≃ᵐ RealPlane :=
    (MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.trans MeasurableEquiv.finTwoArrow
  have he : MeasurePreserving e volume volume :=
    (PiLp.volume_preserving_toLp (Fin 2)).symm.trans
      (MeasureTheory.volume_preserving_finTwoArrow ℝ)
  let H : RealPlane → ℂ := fun v =>
    (M v : ℂ) * Complex.exp
      (-((2 : ℂ) * Real.pi * Complex.I * (v.1 * xi + v.2 * eta)))
  have hpoint : (fun u : EuclideanSpace ℝ (Fin 2) =>
      Complex.exp (↑(-2 * Real.pi * ⟪u, WithLp.toLp 2 ![xi, eta]⟫) * Complex.I) •
        (M (u 0, u 1) : ℂ)) = H ∘ e := by
    funext u
    dsimp [H, e, Function.comp_def]
    change Complex.exp (↑(-2 * Real.pi * ⟪u, WithLp.toLp 2 ![xi, eta]⟫) * Complex.I) *
        (M (u 0, u 1) : ℂ) = _
    rw [PiLp.inner_apply]
    simp [MeasurableEquiv.finTwoArrow_apply, Fin.sum_univ_two]
    ring_nf
  rw [hpoint]
  exact he.integral_comp' H

theorem aux_planeRescale_decay (Psi : WhitneyKernelData) {t : ℝ} (ht : 0 < t)
    (v : RealPlane) :
    |aux_planeRescale t Psi.kernel v| ≤
      ∑ u : Fin 2,
        scaledBracketBumpReal (3 / 2 : ℝ) t ((W u v).1) *
          scaledBracketBumpReal (3 / 2 : ℝ) t ((W u v).2) := by
  have hW (u : Fin 2) : W u (t⁻¹ • v) = t⁻¹ • W u v := by
    rw [← aux_WContinuousLinearEquiv_apply, ← aux_WContinuousLinearEquiv_apply]
    exact (aux_WContinuousLinearEquiv u).map_smul _ _
  have hbracket (x : ℝ) :
      scaledBracketBumpReal (3 / 2 : ℝ) 1 (t⁻¹ * x) =
        t * scaledBracketBumpReal (3 / 2 : ℝ) t x := by
    have h := Codex.MainArgument.GaussianDomination.aux_scaledBracketBumpReal_simul_rescale
      (3 / 2 : ℝ) t 1 (t⁻¹ * x) ht
    convert h.symm using 1
    field_simp [ne_of_gt ht]
  have hscale : (t⁻¹ * v.1, t⁻¹ * v.2) = t⁻¹ • v := by rfl
  have hbase := Psi.decay (t⁻¹ • v)
  simp_rw [hW] at hbase
  have hcoord0 (u : Fin 2) : (t⁻¹ • W u v).1 = t⁻¹ * (W u v).1 := by rfl
  have hcoord1 (u : Fin 2) : (t⁻¹ • W u v).2 = t⁻¹ * (W u v).2 := by rfl
  simp_rw [hcoord0, hcoord1, hbracket] at hbase
  change |t⁻¹ ^ 2 * Psi.kernel (t⁻¹ * v.1, t⁻¹ * v.2)| ≤ _
  rw [abs_mul, abs_of_nonneg (sq_nonneg _)]
  rw [hscale]
  calc
    t⁻¹ ^ 2 * |Psi.kernel (t⁻¹ • v)| ≤
        t⁻¹ ^ 2 *
          ∑ u : Fin 2,
            (t * scaledBracketBumpReal (3 / 2 : ℝ) t ((W u v).1)) *
              (t * scaledBracketBumpReal (3 / 2 : ℝ) t ((W u v).2)) :=
      mul_le_mul_of_nonneg_left hbase (sq_nonneg _)
    _ = ∑ u : Fin 2,
        scaledBracketBumpReal (3 / 2 : ℝ) t ((W u v).1) *
          scaledBracketBumpReal (3 / 2 : ℝ) t ((W u v).2) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro u hu
      field_simp [ne_of_gt ht]

theorem aux_whitney_inverseFourier_decay
    (q : ℝ → ℂ) (C : ℝ) (hC : 0 ≤ C)
    (hqCont : ContDiff ℝ 2 q)
    (hqSupp : tsupport q ⊆ Set.Icc (-((2 : ℝ) ^ 6)) ((2 : ℝ) ^ 6))
    (hzero : ∀ xi : ℝ, ‖q xi‖ ≤ C)
    (hderiv : ∀ xi : ℝ, ‖iteratedDeriv 2 q xi‖ ≤ C) (x : ℝ) :
    ‖FourierTransformInv.fourierInv q x‖ ≤
      (2 : ℝ) ^ 9 * C * bracketBump x ^ 2 := by
  have hcompact : HasCompactSupport q :=
    isCompact_Icc.of_isClosed_subset isClosed_closure hqSupp
  have hraw := (smoothDecay2 2 (by norm_num) q hqCont hcompact).2 x
  let A : ℝ := sSup (Set.range fun xi : ℝ => ‖q xi‖)
  let D : ℝ := sSup (Set.range fun xi : ℝ => ‖iteratedDeriv 2 q xi‖)
  let S : ℝ := ((2 * Real.pi)⁻¹ : ℝ) ^ 2
  let V : ℝ := (volume (tsupport q)).toReal
  have hAbdd : BddAbove (Set.range fun xi : ℝ => ‖q xi‖) := by
    refine ⟨C, ?_⟩
    rintro _ ⟨xi, rfl⟩
    exact hzero xi
  have hDbdd : BddAbove (Set.range fun xi : ℝ => ‖iteratedDeriv 2 q xi‖) := by
    refine ⟨C, ?_⟩
    rintro _ ⟨xi, rfl⟩
    exact hderiv xi
  have hA : A ≤ C := by
    dsimp [A]
    apply csSup_le
    · exact Set.range_nonempty _
    rintro _ ⟨xi, rfl⟩
    exact hzero xi
  have hD : D ≤ C := by
    dsimp [D]
    apply csSup_le
    · exact Set.range_nonempty _
    rintro _ ⟨xi, rfl⟩
    exact hderiv xi
  have hA0 : 0 ≤ A := by
    dsimp [A]
    exact (norm_nonneg (q 0)).trans (le_csSup hAbdd ⟨0, rfl⟩)
  have hD0 : 0 ≤ D := by
    dsimp [D]
    exact (norm_nonneg (iteratedDeriv 2 q 0)).trans (le_csSup hDbdd ⟨0, rfl⟩)
  have hS : S ≤ 1 := by
    dsimp [S]
    have hbase : (2 * Real.pi)⁻¹ ≤ 1 := by
      exact (le_of_lt aux_inv_two_pi_lt_sixth).trans (by norm_num)
    exact pow_le_one₀ (by positivity) hbase
  have hSD : S * D ≤ C := by
    calc
      S * D ≤ 1 * D := mul_le_mul_of_nonneg_right hS hD0
      _ = D := one_mul _
      _ ≤ C := hD
  have hmax : max A (S * D) ≤ C := max_le hA hSD
  have hmeasure : volume (tsupport q) ≤
      volume (Set.Icc (-((2 : ℝ) ^ 6)) ((2 : ℝ) ^ 6)) :=
    MeasureTheory.measure_mono hqSupp
  have hfinite : volume (Set.Icc (-((2 : ℝ) ^ 6)) ((2 : ℝ) ^ 6)) ≠ ∞ := by
    rw [Real.volume_Icc]
    norm_num
  have hV : V ≤ (2 : ℝ) ^ 7 := by
    dsimp [V]
    calc
      (volume (tsupport q)).toReal ≤
          (volume (Set.Icc (-((2 : ℝ) ^ 6)) ((2 : ℝ) ^ 6))).toReal :=
        ENNReal.toReal_mono hfinite hmeasure
      _ = (2 : ℝ) ^ 7 := by
        rw [Real.volume_Icc]
        norm_num
  have hV0 : 0 ≤ V := ENNReal.toReal_nonneg
  have hmax0 : 0 ≤ max A (S * D) := hA0.trans (le_max_left _ _)
  have hbr : 0 ≤ bracketBump x ^ 2 := by positivity
  have hcsmooth : 0 ≤ C_smoothDecay2 2 := by norm_num [C_smoothDecay2]
  change ‖FourierTransformInv.fourierInv q x‖ ≤
    C_smoothDecay2 2 * max A (S * D) * V * bracketBump x ^ 2 at hraw
  calc
    ‖FourierTransformInv.fourierInv q x‖ ≤
        C_smoothDecay2 2 * max A (S * D) * V * bracketBump x ^ 2 := hraw
    _ ≤ C_smoothDecay2 2 * C * V * bracketBump x ^ 2 := by gcongr
    _ ≤ C_smoothDecay2 2 * C * ((2 : ℝ) ^ 7) * bracketBump x ^ 2 := by gcongr
    _ = (2 : ℝ) ^ 9 * C * bracketBump x ^ 2 := by
      congr 1
      norm_num [C_smoothDecay2]
      ring

theorem aux_whitney_psi_decay
    (psi : SchwartzMap ℝ ℝ) (C : ℝ) (hC : 0 ≤ C)
    (hsupp : Function.support
      (FourierTransform.fourier (fun x : ℝ => (psi x : ℂ))) ⊆
        aux_annulusOne 1 ((2 : ℝ) ^ 6))
    (hderiv : ∀ m : ℕ, m < 3 → ∀ xi : ℝ,
      ‖iteratedDeriv m
        (FourierTransform.fourier (fun x : ℝ => (psi x : ℂ))) xi‖ ≤ C)
    (x : ℝ) :
    |psi x| ≤ (2 : ℝ) ^ 9 * C * bracketBump x ^ 2 := by
  let q : ℝ → ℂ := FourierTransform.fourier (fun y : ℝ => (psi y : ℂ))
  have hqCont : ContDiff ℝ 2 q := by
    let psiC : SchwartzMap ℝ ℂ :=
      psi.postcompCLM (𝕜 := ℝ) Complex.ofRealCLM
    have hs : ContDiff ℝ 2 (FourierTransform.fourier psiC : ℝ → ℂ) :=
      (FourierTransform.fourier psiC).smooth 2
    have hpsiC : (psiC : ℝ → ℂ) = fun y : ℝ => (psi y : ℂ) := by
      funext y
      simp [psiC, SchwartzMap.postcompCLM_apply]
    rw [SchwartzMap.fourier_coe, hpsiC] at hs
    exact hs
  have hqSupp : tsupport q ⊆ Set.Icc (-((2 : ℝ) ^ 6)) ((2 : ℝ) ^ 6) := by
    apply closure_minimal _ isClosed_Icc
    intro z hz
    have hz' := hsupp hz
    change 1 / ((2 : ℝ) ^ 6) ≤ |z| ∧ |z| ≤ ((2 : ℝ) ^ 6) * 1 at hz'
    norm_num at hz' ⊢
    exact abs_le.mp hz'.2
  have hqzero : ∀ xi : ℝ, ‖q xi‖ ≤ C := by
    intro xi
    simpa [q] using hderiv 0 (by omega) xi
  have hqderiv : ∀ xi : ℝ, ‖iteratedDeriv 2 q xi‖ ≤ C := by
    intro xi
    simpa [q] using hderiv 2 (by omega) xi
  have hqCompact : HasCompactSupport q :=
    isCompact_Icc.of_isClosed_subset isClosed_closure hqSupp
  have hpsiCont : Continuous (fun y : ℝ => (psi y : ℂ)) :=
    Complex.ofRealCLM.continuous.comp psi.continuous
  have hpsiInt : Integrable (fun y : ℝ => (psi y : ℂ)) := psi.integrable.ofReal
  have hqInt : Integrable q := hqCont.continuous.integrable_of_hasCompactSupport hqCompact
  have hinv : FourierTransformInv.fourierInv q = fun y : ℝ => (psi y : ℂ) := by
    dsimp [q]
    exact hpsiCont.fourierInv_fourier_eq hpsiInt hqInt
  have hdecay := aux_whitney_inverseFourier_decay q C hC hqCont hqSupp hqzero hqderiv x
  rw [hinv] at hdecay
  simpa [Complex.norm_real] using hdecay

theorem aux_whitneyM3_fourierPlane_formula
    (K : RealPlane → ℝ) (p f : ℝ → ℝ)
    (hK : MemW0 K) (hp : MemW0 p) (hf : MemW0 f)
    (xi eta : ℝ) :
    aux_fourierPlane
      (fun v => K v - (2 * tensorSquare f v - tensorSquare p v)) (xi, eta) =
      aux_fourierPlane K (xi, eta) -
        (2 * (aux_fourierReal f xi * aux_fourierReal f eta) -
          aux_fourierReal p xi * aux_fourierReal p eta) := by
  have hpT : MemW0 (tensorSquare p) := aux_memW0_tensorSquare p hp
  have hfT : MemW0 (tensorSquare f) := aux_memW0_tensorSquare f hf
  have h2fT : MemW0 (fun v => 2 * tensorSquare f v) :=
    aux_memW0_const_mul_nonneg hfT 2 (by norm_num)
  have hfp : aux_fourierPlane (tensorSquare f) (xi, eta) =
      aux_fourierReal f xi * aux_fourierReal f eta := by
    change aux_fourierPlane (fun v : RealPlane => f v.1 * f v.2) (xi, eta) = _
    exact aux_fourierPlane_tensor f f xi eta
  have hpp : aux_fourierPlane (tensorSquare p) (xi, eta) =
      aux_fourierReal p xi * aux_fourierReal p eta := by
    change aux_fourierPlane (fun v : RealPlane => p v.1 * p v.2) (xi, eta) = _
    exact aux_fourierPlane_tensor p p xi eta
  rw [aux_fourierPlane_sub _ _ (aux_memW0_integrable_of_addHaar hK)
      (aux_memW0_integrable_of_addHaar (aux_memW0_sub h2fT hpT)) (xi, eta),
    aux_fourierPlane_sub _ _ (aux_memW0_integrable_of_addHaar h2fT)
      (aux_memW0_integrable_of_addHaar hpT) (xi, eta),
    aux_fourierPlane_const_mul, hfp, hpp]
  norm_num

theorem aux_whitneyM3_planeFourier_formula
    (K : RealPlane → ℝ) (p f : ℝ → ℝ)
    (hK : MemW0 K) (hp : MemW0 p) (hf : MemW0 f)
    (z : EuclideanSpace ℝ (Fin 2)) :
    aux_planeFourier
      (fun v => K v - (2 * tensorSquare f v - tensorSquare p v)) z =
      aux_planeFourier K z -
        (2 * (FourierTransform.fourier (fun x : ℝ => (f x : ℂ)) (z 0) *
              FourierTransform.fourier (fun x : ℝ => (f x : ℂ)) (z 1)) -
          FourierTransform.fourier (fun x : ℝ => (p x : ℂ)) (z 0) *
            FourierTransform.fourier (fun x : ℝ => (p x : ℂ)) (z 1)) := by
  have hpT : MemW0 (tensorSquare p) := aux_memW0_tensorSquare p hp
  have hfT : MemW0 (tensorSquare f) := aux_memW0_tensorSquare f hf
  have h2fT : MemW0 (fun v => 2 * tensorSquare f v) :=
    aux_memW0_const_mul_nonneg hfT 2 (by norm_num)
  rw [aux_planeFourier_sub_of_memW0 _ _ hK (aux_memW0_sub h2fT hpT) z,
    aux_planeFourier_sub_of_memW0 _ _ h2fT hpT z,
    aux_planeFourier_const_mul,
    aux_planeFourier_tensorSquare, aux_planeFourier_tensorSquare]
  norm_num

theorem aux_whitneyM3_cancellation_of_square_identity
    (K : RealPlane → ℝ) (p f : ℝ → ℝ)
    (hK : MemW0 K) (hp : MemW0 p) (hf : MemW0 f)
    (xi : ℝ)
    (hpeven : aux_fourierReal p (-xi) = aux_fourierReal p xi)
    (hfeven : aux_fourierReal f (-xi) = aux_fourierReal f xi)
    (hsquare : aux_fourierReal p xi ^ 2 =
      2 * aux_fourierReal f xi ^ 2 - aux_fourierPlane K (xi, -xi)) :
    aux_fourierPlane
      (fun v => K v - (2 * tensorSquare f v - tensorSquare p v)) (xi, -xi) = 0 := by
  rw [aux_whitneyM3_fourierPlane_formula K p f hK hp hf xi (-xi), hpeven, hfeven]
  rw [show aux_fourierReal f xi * aux_fourierReal f xi = aux_fourierReal f xi ^ 2 by ring,
    show aux_fourierReal p xi * aux_fourierReal p xi = aux_fourierReal p xi ^ 2 by ring,
    hsquare]
  ring

theorem aux_whitney_rawPhiJIdentity
    (phi0 phi1 : SchwartzMap ℝ ℝ) (Psi : WhitneyKernelData)
    (psi : SchwartzMap ℝ ℝ)
    (hpsi : ∀ z : ℝ,
      FourierTransform.fourier (fun x : ℝ => (psi x : ℂ)) z ^ 2 =
        2 * (FourierTransform.fourier (fun x : ℝ => (phi0 x : ℂ))
              ((2 : ℝ) ^ (-5 : ℤ) * z) -
          FourierTransform.fourier (fun x : ℝ => (phi1 x : ℂ))
              ((2 : ℝ) ^ (5 : ℤ) * z)) ^ 2 -
          FourierTransform.fourier
            (fun x : EuclideanSpace ℝ (Fin 2) => (Psi.kernel_schwartz x : ℂ))
            (WithLp.toLp 2 ![z, -z]))
    (z : ℝ) :
    aux_fourierReal psi z ^ 2 =
      2 * (aux_fourierReal phi0 ((2 : ℝ) ^ (-5 : ℤ) * z) -
        aux_fourierReal phi1 ((2 : ℝ) ^ (5 : ℤ) * z)) ^ 2 -
        aux_fourierPlane Psi.kernel (z, -z) := by
  rw [aux_fourierReal_eq_fourier, aux_fourierReal_eq_fourier,
    aux_fourierReal_eq_fourier]
  rw [hpsi]
  have hcoord : FourierTransform.fourier
      (fun x : EuclideanSpace ℝ (Fin 2) => (Psi.kernel_schwartz x : ℂ))
      (WithLp.toLp 2 ![z, -z]) = aux_fourierPlane Psi.kernel (z, -z) := by
    calc
      FourierTransform.fourier
          (fun x : EuclideanSpace ℝ (Fin 2) => (Psi.kernel_schwartz x : ℂ))
          (WithLp.toLp 2 ![z, -z]) =
          aux_planeFourier Psi.kernel (WithLp.toLp 2 ![z, -z]) := by
            unfold aux_planeFourier
            apply congrArg (fun f : EuclideanSpace ℝ (Fin 2) → ℂ =>
              FourierTransform.fourier f (WithLp.toLp 2 ![z, -z]))
            funext x
            rw [Psi.kernel_schwartz_eq]
      _ = aux_fourierPlane Psi.kernel (z, -z) :=
        aux_planeFourier_eq_fourierPlane Psi.kernel z (-z)
  rw [hcoord]

theorem aux_whitneyM3_square_identity
    (a : ℤ → ℝ) (ha : SpacedSequence a)
    (phi0 phi1 psi : SchwartzMap ℝ ℝ) (Psi : WhitneyKernelData)
    (hpsi : ∀ z : ℝ,
      FourierTransform.fourier (fun x : ℝ => (psi x : ℂ)) z ^ 2 =
        2 * (FourierTransform.fourier (fun x : ℝ => (phi0 x : ℂ))
              ((2 : ℝ) ^ (-5 : ℤ) * z) -
          FourierTransform.fourier (fun x : ℝ => (phi1 x : ℂ))
              ((2 : ℝ) ^ (5 : ℤ) * z)) ^ 2 -
          FourierTransform.fourier
            (fun x : EuclideanSpace ℝ (Fin 2) => (Psi.kernel_schwartz x : ℂ))
            (WithLp.toLp 2 ![z, -z]))
    (j : ℤ) (xi : ℝ) :
    aux_fourierReal (aux_windowRescale psi (a j)) xi ^ 2 =
      2 * aux_fourierReal
        (fun x => aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * a j) x -
          aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * a j) x) xi ^ 2 -
        aux_fourierPlane (aux_planeRescale (a j) Psi.kernel) (xi, -xi) := by
  have ht : 0 < a j := (ha j).1
  have ht0 : 0 < (2 : ℝ) ^ (-5 : ℤ) * a j := by positivity
  have ht1 : 0 < (2 : ℝ) ^ (5 : ℤ) * a j := by positivity
  have hp : aux_fourierReal (aux_windowRescale psi (a j)) xi =
      aux_fourierReal psi (a j * xi) := by
    rw [aux_fourierReal_eq_fourier,
      aux_windowRescale_fourier (a j) ht psi xi,
      ← aux_fourierReal_eq_fourier psi]
  have hf : aux_fourierReal
      (fun x => aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * a j) x -
        aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * a j) x) xi =
      aux_fourierReal phi0 ((2 : ℝ) ^ (-5 : ℤ) * (a j * xi)) -
        aux_fourierReal phi1 ((2 : ℝ) ^ (5 : ℤ) * (a j * xi)) := by
    rw [aux_fourierReal_eq_fourier,
      aux_fourier_sub_of_integrable _ _
        (aux_windowRescale_integrable phi0 _ ht0)
        (aux_windowRescale_integrable phi1 _ ht1) xi,
      aux_windowRescale_fourier _ ht0 phi0 xi,
      aux_windowRescale_fourier _ ht1 phi1 xi,
      ← aux_fourierReal_eq_fourier phi0,
      ← aux_fourierReal_eq_fourier phi1]
    congr 2 <;> ring
  have hK : aux_fourierPlane (aux_planeRescale (a j) Psi.kernel) (xi, -xi) =
      aux_fourierPlane Psi.kernel (a j * xi, -(a j * xi)) := by
    rw [aux_planeRescale_fourierPlane (a j) ht Psi.kernel]
    congr 1
    ext <;> dsimp ; ring
  have hraw := aux_whitney_rawPhiJIdentity phi0 phi1 Psi psi hpsi (a j * xi)
  rw [hp, hraw, ← hf, ← hK]

theorem aux_whitney_strip_from_coordinate_kill
    (F : EuclideanSpace ℝ (Fin 2) → ℂ) {s t : ℝ}
    (hs : 0 < s) (ht : 0 < t) (hgap : (2 : ℝ) ^ 11 * s ≤ t)
    (hkill : ∀ (z : EuclideanSpace ℝ (Fin 2)) (q : Fin 2),
      64 * t⁻¹ < |z q| → F z = 0) :
    Function.support F ⊆ {z : EuclideanSpace ℝ (Fin 2) |
      |z 0 + z 1| ≤ (2 : ℝ)⁻¹ * s⁻¹} := by
  intro z hz
  have hneq : F z ≠ 0 := Function.mem_support.mp hz
  have htarget : 128 * t⁻¹ ≤ (2 : ℝ)⁻¹ * s⁻¹ := by
    calc
      128 * t⁻¹ = 128 / t := by rw [div_eq_mul_inv]
      _ ≤ ((2 : ℝ)⁻¹) / s := by
        apply (div_le_div_iff₀ ht hs).2
        norm_num at hgap ⊢
        nlinarith
      _ = (2 : ℝ)⁻¹ * s⁻¹ := by rw [div_eq_mul_inv]
  by_contra hstrip
  have hstrip' : (2 : ℝ)⁻¹ * s⁻¹ < |z 0 + z 1| := lt_of_not_ge hstrip
  have hcoord : 64 * t⁻¹ < |z 0| ∨ 64 * t⁻¹ < |z 1| := by
    by_contra hnone
    push Not at hnone
    have hsum : |z 0 + z 1| ≤ 128 * t⁻¹ := by
      calc
        |z 0 + z 1| ≤ |z 0| + |z 1| := abs_add_le _ _
        _ ≤ 64 * t⁻¹ + 64 * t⁻¹ := add_le_add hnone.1 hnone.2
        _ = 128 * t⁻¹ := by ring
    exact (not_lt_of_ge (hsum.trans htarget)) hstrip'
  rcases hcoord with h0 | h1
  · exact hneq (hkill z 0 h0)
  · exact hneq (hkill z 1 h1)

theorem aux_whitney_windowRescale_zero_of_upper_support
    (phi : SchwartzMap ℝ ℝ) (t R : ℝ) (ht : 0 < t)
    (hrescale : ∀ xi : ℝ,
      FourierTransform.fourier (fun x : ℝ => (aux_windowRescale phi t x : ℂ)) xi =
        FourierTransform.fourier (fun x : ℝ => (phi x : ℂ)) (t * xi))
    (hsupp : ∀ u : ℝ,
      FourierTransform.fourier (fun x : ℝ => (phi x : ℂ)) u ≠ 0 → |u| ≤ R)
    (xi : ℝ) (hxi : R * t⁻¹ < |xi|) :
    FourierTransform.fourier (fun x : ℝ => (aux_windowRescale phi t x : ℂ)) xi = 0 := by
  rw [hrescale]
  apply Function.notMem_support.mp
  intro hmem
  have hupper := hsupp (t * xi) hmem
  have hlower : R < |t * xi| := by
    calc
      R = t * (R * t⁻¹) := by field_simp [ne_of_gt ht]
      _ < t * |xi| := mul_lt_mul_of_pos_left hxi ht
      _ = |t * xi| := by rw [abs_mul, abs_of_pos ht]
  exact (not_lt_of_ge hupper) hlower

theorem aux_whitney_planeRescale_zero_of_coordinate_upper_support
    (K : RealPlane → ℝ) (t R : ℝ) (ht : 0 < t)
    (hrescale : ∀ z : EuclideanSpace ℝ (Fin 2),
      aux_planeFourier (aux_planeRescale t K) z = aux_planeFourier K (t • z))
    (hsupp : ∀ u : EuclideanSpace ℝ (Fin 2),
      aux_planeFourier K u ≠ 0 → ∀ q : Fin 2, |u q| ≤ R)
    (z : EuclideanSpace ℝ (Fin 2)) (q : Fin 2) (hxi : R * t⁻¹ < |z q|) :
    aux_planeFourier (aux_planeRescale t K) z = 0 := by
  rw [hrescale]
  apply Function.notMem_support.mp
  intro hmem
  have hupper := hsupp (t • z) hmem q
  have hcoord : (t • z) q = t * z q := by rfl
  rw [hcoord] at hupper
  have hlower : R < |t * z q| := by
    calc
      R = t * (R * t⁻¹) := by field_simp [ne_of_gt ht]
      _ < t * |z q| := mul_lt_mul_of_pos_left hxi ht
      _ = |t * z q| := by rw [abs_mul, abs_of_pos ht]
  exact (not_lt_of_ge hupper) hlower

theorem aux_whitneyM3_fourier_zero_of_coordinate_kill
    (K : RealPlane → ℝ) (p f : ℝ → ℝ)
    (z : EuclideanSpace ℝ (Fin 2))
    (hformula : aux_planeFourier
      (fun v => K v - (2 * tensorSquare f v - tensorSquare p v)) z =
        aux_planeFourier K z -
          (2 * (FourierTransform.fourier (fun x : ℝ => (f x : ℂ)) (z 0) *
              FourierTransform.fourier (fun x : ℝ => (f x : ℂ)) (z 1)) -
            FourierTransform.fourier (fun x : ℝ => (p x : ℂ)) (z 0) *
              FourierTransform.fourier (fun x : ℝ => (p x : ℂ)) (z 1)))
    (q : Fin 2)
    (hKzero : aux_planeFourier K z = 0)
    (hpzero : FourierTransform.fourier (fun x : ℝ => (p x : ℂ)) (z q) = 0)
    (hfzero : FourierTransform.fourier (fun x : ℝ => (f x : ℂ)) (z q) = 0) :
    aux_planeFourier
      (fun v => K v - (2 * tensorSquare f v - tensorSquare p v)) z = 0 := by
  rw [hformula, hKzero]
  fin_cases q
  · have hp0 : FourierTransform.fourier (fun x : ℝ => (p x : ℂ)) (z 0) = 0 := by
      simpa using hpzero
    have hf0 : FourierTransform.fourier (fun x : ℝ => (f x : ℂ)) (z 0) = 0 := by
      simpa using hfzero
    simp [hp0, hf0]
  · have hp1 : FourierTransform.fourier (fun x : ℝ => (p x : ℂ)) (z 1) = 0 := by
      simpa using hpzero
    have hf1 : FourierTransform.fourier (fun x : ℝ => (f x : ℂ)) (z 1) = 0 := by
      simpa using hfzero
    simp [hp1, hf1]

theorem aux_whitneyM3_support_of_formula_and_kills
    (K : RealPlane → ℝ) (p f : ℝ → ℝ) {s t : ℝ}
    (hs : 0 < s) (ht : 0 < t) (hgap : (2 : ℝ) ^ 11 * s ≤ t)
    (hformula : ∀ z : EuclideanSpace ℝ (Fin 2),
      aux_planeFourier (fun v => K v - (2 * tensorSquare f v - tensorSquare p v)) z =
        aux_planeFourier K z -
          (2 * (FourierTransform.fourier (fun x : ℝ => (f x : ℂ)) (z 0) *
              FourierTransform.fourier (fun x : ℝ => (f x : ℂ)) (z 1)) -
            FourierTransform.fourier (fun x : ℝ => (p x : ℂ)) (z 0) *
              FourierTransform.fourier (fun x : ℝ => (p x : ℂ)) (z 1)))
    (hKkill : ∀ (z : EuclideanSpace ℝ (Fin 2)) (q : Fin 2),
      64 * t⁻¹ < |z q| → aux_planeFourier K z = 0)
    (hpkill : ∀ (z : EuclideanSpace ℝ (Fin 2)) (q : Fin 2),
      64 * t⁻¹ < |z q| →
        FourierTransform.fourier (fun x : ℝ => (p x : ℂ)) (z q) = 0)
    (hfkill : ∀ (z : EuclideanSpace ℝ (Fin 2)) (q : Fin 2),
      64 * t⁻¹ < |z q| →
        FourierTransform.fourier (fun x : ℝ => (f x : ℂ)) (z q) = 0) :
    Function.support (aux_planeFourier
      (fun v => K v - (2 * tensorSquare f v - tensorSquare p v))) ⊆
      {z : EuclideanSpace ℝ (Fin 2) |
        |z 0 + z 1| ≤ (2 : ℝ)⁻¹ * s⁻¹} := by
  apply aux_whitney_strip_from_coordinate_kill _ hs ht hgap
  intro z q hz
  exact aux_whitneyM3_fourier_zero_of_coordinate_kill K p f
    z (hformula z) q (hKkill z q hz) (hpkill z q hz) (hfkill z q hz)

theorem aux_whitneyM3_frequency_support
    (a : ℤ → ℝ) (ha : SpacedSequence a)
    (hgap : ∀ j : ℤ, (2 : ℝ) ^ 11 * a (j - 1) ≤ a j)
    (phi0 phi1 psi : SchwartzMap ℝ ℝ) (hpair : uniPair phi0 phi1)
    (Psi : WhitneyKernelData)
    (hpsi : Function.support
      (FourierTransform.fourier (fun x : ℝ => (psi x : ℂ))) ⊆
        aux_annulusOne 1 ((2 : ℝ) ^ 6))
    (j : ℤ) :
    Function.support (aux_planeFourier (fun v =>
      aux_planeRescale (a j) Psi.kernel v -
        (2 * tensorSquare (fun x =>
            aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * a j) x -
              aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * a j) x) v -
          tensorSquare (aux_windowRescale psi (a j)) v))) ⊆
      {z : EuclideanSpace ℝ (Fin 2) |
        |z 0 + z 1| ≤ (2 : ℝ)⁻¹ * (a (j - 1))⁻¹} := by
  have ht : 0 < a j := (ha j).1
  have ht0 : 0 < (2 : ℝ) ^ (-5 : ℤ) * a j := by positivity
  have ht1 : 0 < (2 : ℝ) ^ (5 : ℤ) * a j := by positivity
  let K : RealPlane → ℝ := aux_planeRescale (a j) Psi.kernel
  let p : ℝ → ℝ := aux_windowRescale psi (a j)
  let f : ℝ → ℝ := fun x =>
    aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * a j) x -
      aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * a j) x
  have hKmem : MemW0 K := by
    dsimp [K]
    exact aux_planeRescale_memW0 _ Psi.kernel_memW0 ht
  have hpmem : MemW0 p := by
    dsimp [p]
    exact aux_windowRescale_memW0 psi ht
  have hfmem : MemW0 f := by
    dsimp [f]
    exact aux_memW0_sub (aux_windowRescale_memW0 phi0 ht0)
      (aux_windowRescale_memW0 phi1 ht1)
  apply aux_whitneyM3_support_of_formula_and_kills K p f
    ((ha (j - 1)).1) ht (hgap j)
  · intro z
    exact aux_whitneyM3_planeFourier_formula K p f hKmem hpmem hfmem z
  · intro z q hq
    dsimp [K]
    apply aux_whitney_planeRescale_zero_of_coordinate_upper_support Psi.kernel (a j) 8 ht
      (fun z => aux_planeRescale_planeFourier (a j) ht Psi.kernel z)
    · intro u hu q
      have hu' := Psi.fourier_support hu
      unfold aux_productSet aux_annulusOne at hu'
      fin_cases q
      · norm_num at hu' ⊢
        exact hu'.1.2
      · norm_num at hu' ⊢
        exact hu'.2.2
    · calc
        8 * (a j)⁻¹ < 64 * (a j)⁻¹ := by nlinarith [inv_pos.mpr ht]
        _ < |z q| := hq
  · intro z q hq
    dsimp [p]
    apply aux_whitney_windowRescale_zero_of_upper_support psi (a j) 64 ht
      (fun xi => aux_windowRescale_fourier (a j) ht psi xi)
    · intro u hu
      have hu' := hpsi hu
      change 1 / ((2 : ℝ) ^ 6) ≤ |u| ∧ |u| ≤ ((2 : ℝ) ^ 6) * 1 at hu'
      norm_num at hu' ⊢
      exact hu'.2
    · exact hq
  · intro z q hq
    dsimp [f]
    rw [aux_fourier_sub_of_integrable _ _
      (aux_windowRescale_integrable phi0 _ ht0)
      (aux_windowRescale_integrable phi1 _ ht1) (z q)]
    have hzero0 : FourierTransform.fourier (fun x : ℝ =>
        (aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * a j) x : ℂ)) (z q) = 0 := by
      apply aux_windowRescale_fourier_zero_of_inv_lt_abs phi0 hpair.1 ht0 (z q)
      have hscale : (((2 : ℝ) ^ (-5 : ℤ) * a j)⁻¹) = 32 * (a j)⁻¹ := by
        field_simp [ne_of_gt ht]
        norm_num
      rw [hscale]
      calc
        32 * (a j)⁻¹ < 64 * (a j)⁻¹ := by nlinarith [inv_pos.mpr ht]
        _ < |z q| := hq
    have hzero1 : FourierTransform.fourier (fun x : ℝ =>
        (aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * a j) x : ℂ)) (z q) = 0 := by
      apply aux_windowRescale_fourier_zero_of_inv_lt_abs phi1 hpair.2.1 ht1 (z q)
      have hscale : (((2 : ℝ) ^ (5 : ℤ) * a j)⁻¹) = (1 / 32 : ℝ) * (a j)⁻¹ := by
        field_simp [ne_of_gt ht]
        norm_num
      rw [hscale]
      calc
        (1 / 32 : ℝ) * (a j)⁻¹ < 64 * (a j)⁻¹ := by nlinarith [inv_pos.mpr ht]
        _ < |z q| := hq
    rw [hzero0, hzero1]
    ring

noncomputable def aux_whitneyTriple (a : ℤ → ℝ) (ha : SpacedSequence a)
    (u : Fin 2) : ReductionScaleTriple a where
  left := a
  right := a
  orientation := u
  left_spaced := ha
  right_spaced := ha
  left_distance := by
    apply aux_sequenceDistance_le_of_within
    intro j
    constructor <;> apply aux_spacedSequence_monotone ha <;> omega
  right_distance := by
    apply aux_sequenceDistance_le_of_within
    intro j
    constructor <;> apply aux_spacedSequence_monotone ha <;> omega
  left_le_base := fun _ => le_rfl
  right_le_base := fun _ => le_rfl

noncomputable def aux_whitneyTriples (a : ℤ → ℝ) (ha : SpacedSequence a) :
    Finset (ReductionScaleTriple a) := by
  classical
  exact Finset.univ.image (aux_whitneyTriple a ha)

theorem aux_whitneyTriples_card (a : ℤ → ℝ) (ha : SpacedSequence a) :
    (aux_whitneyTriples a ha).card ≤ 5 := by
  classical
  unfold aux_whitneyTriples
  calc
    (Finset.univ.image (aux_whitneyTriple a ha)).card ≤
        (Finset.univ : Finset (Fin 2)).card := Finset.card_image_le
    _ = 2 := by simp
    _ ≤ 5 := by omega

theorem aux_whitneyTriple_injective (a : ℤ → ℝ) (ha : SpacedSequence a) :
    Function.Injective (aux_whitneyTriple a ha) := by
  intro u v huv
  exact congrArg ReductionScaleTriple.orientation huv

theorem aux_whitneyTriples_sum (a : ℤ → ℝ) (ha : SpacedSequence a)
    (j : ℤ) (v : RealPlane) :
    (∑ q ∈ aux_whitneyTriples a ha,
      scaledBracketBumpReal (3 / 2 : ℝ) (q.left j) ((W q.orientation v).1) *
        scaledBracketBumpReal (3 / 2 : ℝ) (q.right j) ((W q.orientation v).2)) =
      ∑ u : Fin 2,
        scaledBracketBumpReal (3 / 2 : ℝ) (a j) ((W u v).1) *
          scaledBracketBumpReal (3 / 2 : ℝ) (a j) ((W u v).2) := by
  classical
  unfold aux_whitneyTriples
  rw [Finset.sum_image]
  · simp [aux_whitneyTriple]
  · intro x _ y _ hxy
    exact aux_whitneyTriple_injective a ha hxy

noncomputable def aux_whitneyData
    (a : ℤ → ℝ) (ha : SpacedSequence a) (M : ℤ → RealPlane → ℝ) (c : ℝ)
    (hc : 0 < c)
    (hM : ∀ j, MemW0 (M j))
    (hcancel : ∀ j xi, aux_fourierPlane (M j) (xi, -xi) = 0)
    (hdecay : ∀ j v, |M j v| ≤ c *
      ∑ u : Fin 2,
        scaledBracketBumpReal (3 / 2 : ℝ) (a j) ((W u v).1) *
          scaledBracketBumpReal (3 / 2 : ℝ) (a j) ((W u v).2)) :
    ReductionData where
  a := a
  a_spaced := ha
  triples := aux_whitneyTriples a ha
  triples_card := aux_whitneyTriples_card a ha
  kernel := fun j v => c⁻¹ * M j v
  kernel_memW0 := by
    intro j
    exact aux_memW0_const_mul_nonneg (hM j) _ (inv_nonneg.mpr hc.le)
  diagonal_cancellation := by
    intro j xi
    rw [aux_fourierPlane_const_mul]
    rw [hcancel]
    ring
  kernel_decay := by
    intro j v
    have h := hdecay j v
    rw [aux_whitneyTriples_sum a ha j v]
    rw [abs_mul, abs_of_pos (inv_pos.mpr hc)]
    calc
      c⁻¹ * |M j v| ≤ c⁻¹ * (c *
          ∑ u : Fin 2,
            scaledBracketBumpReal (3 / 2 : ℝ) (a j) ((W u v).1) *
              scaledBracketBumpReal (3 / 2 : ℝ) (a j) ((W u v).2)) :=
        mul_le_mul_of_nonneg_left h (inv_nonneg.mpr hc.le)
      _ = ∑ u : Fin 2,
          scaledBracketBumpReal (3 / 2 : ℝ) (a j) ((W u v).1) *
            scaledBracketBumpReal (3 / 2 : ℝ) (a j) ((W u v).2) := by
        field_simp [ne_of_gt hc]

theorem aux_whitney_windowRescale_decay_of_bracket
    (phi : SchwartzMap ℝ ℝ) (C : ℝ)
    (hphi : ∀ x : ℝ, |phi x| ≤ C * bracketBump x ^ 2)
    {t : ℝ} (ht : 0 < t) (x : ℝ) :
    |aux_windowRescale phi t x| ≤ C * scaledBracketBump 2 t x := by
  have h := hphi (t⁻¹ * x)
  unfold aux_windowRescale
  rw [abs_mul, abs_of_pos (inv_pos.mpr ht)]
  calc
    t⁻¹ * |phi (t⁻¹ * x)| ≤
        t⁻¹ * (C * bracketBump (t⁻¹ * x) ^ 2) :=
      mul_le_mul_of_nonneg_left h (inv_nonneg.mpr ht.le)
    _ = C * scaledBracketBump 2 t x := by
      unfold scaledBracketBump bracketBump
      ring

theorem aux_whitney_f_decay
    (phi0 phi1 : SchwartzMap ℝ ℝ) (hpair : uniPair phi0 phi1)
    {t : ℝ} (ht : 0 < t) (x : ℝ) :
    |aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * t) x -
        aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * t) x| ≤
      (2 : ℝ) ^ 9 * C_uniPair * scaledBracketBump 2 t x := by
  have hsmall : 0 < (2 : ℝ) ^ (-5 : ℤ) * t := by positivity
  have hlarge : 0 < (2 : ℝ) ^ (5 : ℤ) * t := by positivity
  have h0 := aux_nonWhitney_windowRescale_decay phi0 hpair.1 hsmall x
  have h1 := aux_nonWhitney_windowRescale_decay phi1 hpair.2.1 hlarge x
  have hscale0 := scaleEstimate x ((2 : ℝ) ^ (-5 : ℤ)) t (by positivity) ht
  have hscale1 := scaleEstimate x ((2 : ℝ) ^ (5 : ℤ)) t (by positivity) ht
  have hmax0 : max ((2 : ℝ) ^ (-5 : ℤ)) ((2 : ℝ) ^ (-5 : ℤ))⁻¹ = 32 := by
    norm_num
  have hmax1 : max ((2 : ℝ) ^ (5 : ℤ)) ((2 : ℝ) ^ (5 : ℤ))⁻¹ = 32 := by
    norm_num
  have hC : 0 ≤ C_uniPair := by norm_num [C_uniPair]
  have h0' : |aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * t) x| ≤
      256 * C_uniPair * scaledBracketBump 2 t x := by
    calc
      |aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * t) x| ≤
          8 * C_uniPair * scaledBracketBump 2 ((2 : ℝ) ^ (-5 : ℤ) * t) x := h0
      _ ≤ (8 * C_uniPair) *
          (max ((2 : ℝ) ^ (-5 : ℤ)) ((2 : ℝ) ^ (-5 : ℤ))⁻¹ *
            scaledBracketBump 2 t x) :=
        mul_le_mul_of_nonneg_left hscale0 (mul_nonneg (by positivity) hC)
      _ = 256 * C_uniPair * scaledBracketBump 2 t x := by rw [hmax0]; ring
  have h1' : |aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * t) x| ≤
      256 * C_uniPair * scaledBracketBump 2 t x := by
    calc
      |aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * t) x| ≤
          8 * C_uniPair * scaledBracketBump 2 ((2 : ℝ) ^ (5 : ℤ) * t) x := h1
      _ ≤ (8 * C_uniPair) *
          (max ((2 : ℝ) ^ (5 : ℤ)) ((2 : ℝ) ^ (5 : ℤ))⁻¹ *
            scaledBracketBump 2 t x) :=
        mul_le_mul_of_nonneg_left hscale1 (mul_nonneg (by positivity) hC)
      _ = 256 * C_uniPair * scaledBracketBump 2 t x := by rw [hmax1]; ring
  calc
    |aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * t) x -
        aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * t) x| ≤
      |aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * t) x| +
        |aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * t) x| := by
          simpa using (abs_sub_le
            (aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * t) x) 0
            (aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * t) x))
    _ ≤ (256 * C_uniPair * scaledBracketBump 2 t x) +
        (256 * C_uniPair * scaledBracketBump 2 t x) := add_le_add h0' h1'
    _ = (2 : ℝ) ^ 9 * C_uniPair * scaledBracketBump 2 t x := by norm_num; ring

theorem aux_whitney_tensorSquare_decay
    (f : ℝ → ℝ) (C : ℝ) (hC : 0 ≤ C)
    {t : ℝ} (ht : 0 < t)
    (hdecay : ∀ x : ℝ, |f x| ≤ C * scaledBracketBump 2 t x)
    (v : RealPlane) :
    |tensorSquare f v| ≤ C ^ 2 *
      (scaledBracketBumpReal (3 / 2 : ℝ) t v.1 *
        scaledBracketBumpReal (3 / 2 : ℝ) t v.2) := by
  have h0 := hdecay v.1
  have h1 := hdecay v.2
  have hs0 : scaledBracketBump 2 t v.1 ≤
      scaledBracketBumpReal (3 / 2 : ℝ) t v.1 := by
    rw [← aux_diagonalSquareRoot_scaledBracketBumpReal_two_eq]
    exact aux_scaledBracketBumpReal_exponent_reduce (3 / 2 : ℝ) 2 t v.1 ht (by norm_num)
  have hs1 : scaledBracketBump 2 t v.2 ≤
      scaledBracketBumpReal (3 / 2 : ℝ) t v.2 := by
    rw [← aux_diagonalSquareRoot_scaledBracketBumpReal_two_eq]
    exact aux_scaledBracketBumpReal_exponent_reduce (3 / 2 : ℝ) 2 t v.2 ht (by norm_num)
  have hprod0 : |f v.1| * |f v.2| ≤
      (C * scaledBracketBump 2 t v.1) * (C * scaledBracketBump 2 t v.2) :=
    mul_le_mul h0 h1 (abs_nonneg _) (mul_nonneg hC
      (aux_scaledBracketBump_nonneg 2 ht _))
  have hprod1 : scaledBracketBump 2 t v.1 * scaledBracketBump 2 t v.2 ≤
      scaledBracketBumpReal (3 / 2 : ℝ) t v.1 *
        scaledBracketBumpReal (3 / 2 : ℝ) t v.2 :=
    mul_le_mul hs0 hs1 (aux_scaledBracketBump_nonneg 2 ht _)
      (aux_scaledBracketBumpReal_nonneg _ _ _ ht)
  unfold tensorSquare
  rw [abs_mul]
  calc
    |f v.1| * |f v.2| ≤
        (C * scaledBracketBump 2 t v.1) * (C * scaledBracketBump 2 t v.2) := hprod0
    _ = C ^ 2 * (scaledBracketBump 2 t v.1 * scaledBracketBump 2 t v.2) := by ring
    _ ≤ C ^ 2 *
        (scaledBracketBumpReal (3 / 2 : ℝ) t v.1 *
          scaledBracketBumpReal (3 / 2 : ℝ) t v.2) :=
      mul_le_mul_of_nonneg_left hprod1 (sq_nonneg _)

theorem aux_whitneyM3_decay
    (a : ℤ → ℝ) (ha : SpacedSequence a)
    (phi0 phi1 psi : SchwartzMap ℝ ℝ) (hpair : uniPair phi0 phi1)
    (Psi : WhitneyKernelData)
    (hpsiDecay : ∀ x : ℝ,
      |psi x| ≤ (2 : ℝ) ^ 9 * C_phiJProperties * bracketBump x ^ 2)
    (j : ℤ) (v : RealPlane) :
    |aux_planeRescale (a j) Psi.kernel v -
        (2 * tensorSquare (fun x =>
            aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * a j) x -
              aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * a j) x) v -
          tensorSquare (aux_windowRescale psi (a j)) v)| ≤
      (2 : ℝ) ^ 19 * (C_uniPair ^ 2 + C_phiJProperties ^ 2) *
        ∑ u : Fin 2,
          scaledBracketBumpReal (3 / 2 : ℝ) (a j) ((W u v).1) *
            scaledBracketBumpReal (3 / 2 : ℝ) (a j) ((W u v).2) := by
  have ht : 0 < a j := (ha j).1
  let B0 : ℝ := scaledBracketBumpReal (3 / 2 : ℝ) (a j) v.1 *
    scaledBracketBumpReal (3 / 2 : ℝ) (a j) v.2
  let B1 : ℝ := scaledBracketBumpReal (3 / 2 : ℝ) (a j) ((W 1 v).1) *
    scaledBracketBumpReal (3 / 2 : ℝ) (a j) ((W 1 v).2)
  let S : ℝ := B0 + B1
  have hB0 : 0 ≤ B0 := by
    dsimp [B0]
    exact mul_nonneg (aux_scaledBracketBumpReal_nonneg _ _ _ ht)
      (aux_scaledBracketBumpReal_nonneg _ _ _ ht)
  have hB1 : 0 ≤ B1 := by
    dsimp [B1]
    exact mul_nonneg (aux_scaledBracketBumpReal_nonneg _ _ _ ht)
      (aux_scaledBracketBumpReal_nonneg _ _ _ ht)
  have hS : 0 ≤ S := add_nonneg hB0 hB1
  have hK : |aux_planeRescale (a j) Psi.kernel v| ≤ S := by
    have h := aux_planeRescale_decay Psi ht v
    simpa [S, B0, B1, W, Fin.sum_univ_two] using h
  have hCp : 0 ≤ C_phiJProperties := by
    rw [constantPhiJProposition]
    positivity
  have hpwindow : ∀ x : ℝ, |aux_windowRescale psi (a j) x| ≤
      ((2 : ℝ) ^ 9 * C_phiJProperties) * scaledBracketBump 2 (a j) x := by
    intro x
    exact aux_whitney_windowRescale_decay_of_bracket psi
      ((2 : ℝ) ^ 9 * C_phiJProperties) hpsiDecay ht x
  have hpTraw := aux_whitney_tensorSquare_decay (aux_windowRescale psi (a j))
    ((2 : ℝ) ^ 9 * C_phiJProperties)
    (mul_nonneg (by positivity) hCp) ht hpwindow v
  have hpT : |tensorSquare (aux_windowRescale psi (a j)) v| ≤
      (2 : ℝ) ^ 18 * C_phiJProperties ^ 2 * B0 := by
    convert hpTraw using 1; norm_num; ring
  have hCu : 0 ≤ C_uniPair := by norm_num [C_uniPair]
  have hfwindow : ∀ x : ℝ,
      |aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * a j) x -
        aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * a j) x| ≤
        ((2 : ℝ) ^ 9 * C_uniPair) * scaledBracketBump 2 (a j) x := by
    intro x
    exact aux_whitney_f_decay phi0 phi1 hpair ht x
  have hfTraw := aux_whitney_tensorSquare_decay
    (fun x => aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * a j) x -
      aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * a j) x)
    ((2 : ℝ) ^ 9 * C_uniPair)
    (mul_nonneg (by positivity) hCu) ht hfwindow v
  have hfT : |tensorSquare (fun x =>
      aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * a j) x -
        aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * a j) x) v| ≤
      (2 : ℝ) ^ 18 * C_uniPair ^ 2 * B0 := by
    convert hfTraw using 1; norm_num; ring
  have hsub : |2 * tensorSquare (fun x =>
      aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * a j) x -
        aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * a j) x) v -
      tensorSquare (aux_windowRescale psi (a j)) v| ≤
      2 * |tensorSquare (fun x =>
        aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * a j) x -
          aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * a j) x) v| +
        |tensorSquare (aux_windowRescale psi (a j)) v| := by
    calc
      |2 * tensorSquare (fun x =>
          aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * a j) x -
            aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * a j) x) v -
          tensorSquare (aux_windowRescale psi (a j)) v| ≤
        |2 * tensorSquare (fun x =>
          aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * a j) x -
            aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * a j) x) v| +
          |tensorSquare (aux_windowRescale psi (a j)) v| := by
            simpa using (abs_sub_le
              (2 * tensorSquare (fun x =>
                aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * a j) x -
                  aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * a j) x) v) 0
              (tensorSquare (aux_windowRescale psi (a j)) v))
      _ = _ := by rw [abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
  have hcoeff : 1 + (2 : ℝ) ^ 19 * C_uniPair ^ 2 +
      (2 : ℝ) ^ 18 * C_phiJProperties ^ 2 ≤
        (2 : ℝ) ^ 19 * (C_uniPair ^ 2 + C_phiJProperties ^ 2) := by
    rw [constantPhiJProposition]
    norm_num [C_uniPair]
  have hmain : |aux_planeRescale (a j) Psi.kernel v -
      (2 * tensorSquare (fun x =>
          aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * a j) x -
            aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * a j) x) v -
        tensorSquare (aux_windowRescale psi (a j)) v)| ≤
      S + (2 : ℝ) ^ 19 * C_uniPair ^ 2 * B0 +
        (2 : ℝ) ^ 18 * C_phiJProperties ^ 2 * B0 := by
    calc
      |aux_planeRescale (a j) Psi.kernel v -
          (2 * tensorSquare (fun x =>
              aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * a j) x -
                aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * a j) x) v -
            tensorSquare (aux_windowRescale psi (a j)) v)| ≤
        |aux_planeRescale (a j) Psi.kernel v| +
          |2 * tensorSquare (fun x =>
              aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * a j) x -
                aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * a j) x) v -
            tensorSquare (aux_windowRescale psi (a j)) v| := by
              calc
                _ ≤ |aux_planeRescale (a j) Psi.kernel v| +
                    |0 - (2 * tensorSquare (fun x =>
                      aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * a j) x -
                        aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * a j) x) v -
                      tensorSquare (aux_windowRescale psi (a j)) v)| :=
                  by simpa using
                    (abs_sub_le (aux_planeRescale (a j) Psi.kernel v) 0
                      (2 * tensorSquare (fun x =>
                        aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * a j) x -
                          aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * a j) x) v -
                        tensorSquare (aux_windowRescale psi (a j)) v))
                _ = _ := by rw [zero_sub, abs_neg]
      _ ≤ |aux_planeRescale (a j) Psi.kernel v| +
          (2 * |tensorSquare (fun x =>
            aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * a j) x -
              aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * a j) x) v| +
            |tensorSquare (aux_windowRescale psi (a j)) v|) :=
        by simpa [add_comm] using
          (add_le_add_left hsub |aux_planeRescale (a j) Psi.kernel v|)
      _ ≤ S +
          (2 * ((2 : ℝ) ^ 18 * C_uniPair ^ 2 * B0) +
            (2 : ℝ) ^ 18 * C_phiJProperties ^ 2 * B0) :=
        add_le_add hK (add_le_add (mul_le_mul_of_nonneg_left hfT (by norm_num)) hpT)
      _ = S + (2 : ℝ) ^ 19 * C_uniPair ^ 2 * B0 +
          (2 : ℝ) ^ 18 * C_phiJProperties ^ 2 * B0 := by ring
  have hB0le : B0 ≤ S := by
    dsimp [S]
    linarith
  have hqf : 0 ≤ (2 : ℝ) ^ 19 * C_uniPair ^ 2 := by positivity
  have hqp : 0 ≤ (2 : ℝ) ^ 18 * C_phiJProperties ^ 2 := by positivity
  have hterms : S + (2 : ℝ) ^ 19 * C_uniPair ^ 2 * B0 +
      (2 : ℝ) ^ 18 * C_phiJProperties ^ 2 * B0 ≤
        (1 + (2 : ℝ) ^ 19 * C_uniPair ^ 2 +
          (2 : ℝ) ^ 18 * C_phiJProperties ^ 2) * S := by
    calc
      S + (2 : ℝ) ^ 19 * C_uniPair ^ 2 * B0 +
          (2 : ℝ) ^ 18 * C_phiJProperties ^ 2 * B0 ≤
        S + (2 : ℝ) ^ 19 * C_uniPair ^ 2 * S +
          (2 : ℝ) ^ 18 * C_phiJProperties ^ 2 * S := by
            gcongr
      _ = _ := by ring
  calc
    |aux_planeRescale (a j) Psi.kernel v -
        (2 * tensorSquare (fun x =>
            aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * a j) x -
              aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * a j) x) v -
          tensorSquare (aux_windowRescale psi (a j)) v)| ≤
      S + (2 : ℝ) ^ 19 * C_uniPair ^ 2 * B0 +
        (2 : ℝ) ^ 18 * C_phiJProperties ^ 2 * B0 := hmain
    _ ≤ (1 + (2 : ℝ) ^ 19 * C_uniPair ^ 2 +
        (2 : ℝ) ^ 18 * C_phiJProperties ^ 2) * S := hterms
    _ ≤ (2 : ℝ) ^ 19 * (C_uniPair ^ 2 + C_phiJProperties ^ 2) * S :=
      mul_le_mul_of_nonneg_right hcoeff hS
    _ = (2 : ℝ) ^ 19 * (C_uniPair ^ 2 + C_phiJProperties ^ 2) *
        ∑ u : Fin 2,
          scaledBracketBumpReal (3 / 2 : ℝ) (a j) ((W u v).1) *
            scaledBracketBumpReal (3 / 2 : ℝ) (a j) ((W u v).2) := by
      congr 1
      simp [S, B0, B1, W, Fin.sum_univ_two]

/-! The following comparison is the positivity step in the Whitney-gap
reduction.  It is stated for arbitrary plane kernels so that the later
normalization of the correction remains separate from the form argument. -/

theorem aux_whitney_lift_positive (M : RealPlane → ℝ)
    (hquad : ∀ g : ℝ → ℝ, aux_bounded g →
      0 ≤ ∫ v : RealPlane, g v.1 * g v.2 * M v) :
    ∀ g : ℝ → ℝ, aux_bounded g →
      0 ≤ ∫ u : RealVector 1 × RealVector 1,
        g (u.1 0) * g (u.2 0) * aux_liftPlaneKernel M u := by
  intro g hg
  let e1 : RealVector 1 ≃ᵐ ℝ := MeasurableEquiv.piUnique (fun _ : Fin 1 => ℝ)
  let e : (RealVector 1 × RealVector 1) ≃ᵐ RealPlane := e1.prodCongr e1
  have he1 : MeasurePreserving e1 volume volume := by
    simpa [e1] using volume_preserving_piUnique (fun _ : Fin 1 => ℝ)
  have he : MeasurePreserving e volume volume := by
    change MeasurePreserving (Prod.map e1 e1) volume volume
    simpa only [Measure.volume_eq_prod] using he1.prod he1
  let G : RealPlane → ℝ := fun v => g v.1 * g v.2 * M v
  calc
    0 ≤ ∫ v : RealPlane, G v := by simpa [G] using hquad g hg
    _ = ∫ u : RealVector 1 × RealVector 1, G (e u) := (he.integral_comp' G).symm
    _ = ∫ u : RealVector 1 × RealVector 1,
        g (u.1 0) * g (u.2 0) * aux_liftPlaneKernel M u := by
      apply integral_congr_ae
      filter_upwards [] with u
      dsimp [G, e, e1, aux_liftPlaneKernel]
      rfl

theorem aux_whitney_seminorm_le_of_positive_difference {n : ℕ} (hn : 2 ≤ n)
    (M0 M1 : KernelSequence 1)
    (hM0 : ∀ j : ℤ, MemW0 (M0 j))
    (hM1 : ∀ j : ℤ, MemW0 (M1 j))
    (hpos : ∀ (j : ℤ) (F : Fin n → SchwartzMap (RealVector n) ℝ),
      0 ≤ prismForm n 1 (by omega) (by omega)
        (fun y => M0 j y - M1 j y) (fun i => F i))
    (hpos1 : ∀ (j : ℤ) (F : Fin n → SchwartzMap (RealVector n) ℝ),
      0 ≤ prismForm n 1 (by omega) (by omega) (M1 j) (fun i => F i)) :
    kernelSequenceSeminorm n 1 (by omega) (by omega)
      (fun j y => M0 j y - M1 j y) ≤
        kernelSequenceSeminorm n 1 (by omega) (by omega) M0 := by
  classical
  unfold kernelSequenceSeminorm
  refine iSup_le fun J => ?_
  refine iSup_le fun F => ?_
  let w : ℝ := min 1
    (Real.rpow (J.1 : ℝ) (-1 + (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1)))
  have hw : 0 ≤ w := by
    dsimp [w]
    exact le_min zero_le_one (Real.rpow_nonneg (Nat.cast_nonneg _) _)
  let K0 : MKernel 1 := fun y => ∑ j ∈ Finset.range J.1, M0 (j : ℤ) y
  let K1 : MKernel 1 := fun y => ∑ j ∈ Finset.range J.1, M1 (j : ℤ) y
  let K : MKernel 1 := fun y => ∑ j ∈ Finset.range J.1,
    (M0 (j : ℤ) y - M1 (j : ℤ) y)
  have hK0 : MemW0 K0 := by
    dsimp [K0]
    apply aux_memW0_finset_sum
    intro j hj
    exact hM0 j
  have hK1 : MemW0 K1 := by
    dsimp [K1]
    apply aux_memW0_finset_sum
    intro j hj
    exact hM1 j
  have hK : MemW0 K := by
    dsimp [K]
    apply aux_memW0_finset_sum
    intro j hj
    exact aux_memW0_sub (hM0 j) (hM1 j)
  have hlin : prismForm n 1 (by omega) (by omega) K (fun i => F.1 i) =
      ∑ j ∈ Finset.range J.1,
        prismForm n 1 (by omega) (by omega)
          (fun y => M0 (j : ℤ) y - M1 (j : ℤ) y) (fun i => F.1 i) := by
    dsimp [K]
    simpa using
      (aux_prismForm_finset_sum (n := n) (k := 1) (by omega) (by omega)
        (Finset.range J.1) (fun j : ℕ => fun y => M0 (j : ℤ) y - M1 (j : ℤ) y)
        (by
          intro j hj
          exact aux_memW0_sub (hM0 j) (hM1 j)) F.1)
  have hlin1 : prismForm n 1 (by omega) (by omega) K1 (fun i => F.1 i) =
      ∑ j ∈ Finset.range J.1,
        prismForm n 1 (by omega) (by omega) (M1 (j : ℤ)) (fun i => F.1 i) := by
    dsimp [K1]
    simpa using
      (aux_prismForm_finset_sum (n := n) (k := 1) (by omega) (by omega)
        (Finset.range J.1) (fun j : ℕ => M1 (j : ℤ))
        (by
          intro j hj
          exact hM1 j) F.1)
  have hposK : 0 ≤ prismForm n 1 (by omega) (by omega) K (fun i => F.1 i) := by
    rw [hlin]
    apply Finset.sum_nonneg
    intro j hj
    exact hpos j F.1
  have hposK1 : 0 ≤ prismForm n 1 (by omega) (by omega) K1 (fun i => F.1 i) := by
    rw [hlin1]
    apply Finset.sum_nonneg
    intro j hj
    exact hpos1 j F.1
  have hKsub : K = fun y => K0 y - K1 y := by
    funext y
    dsimp [K, K0, K1]
    rw [Finset.sum_sub_distrib]
  have hform : prismForm n 1 (by omega) (by omega) K0 (fun i => F.1 i) -
      prismForm n 1 (by omega) (by omega) K1 (fun i => F.1 i) =
        prismForm n 1 (by omega) (by omega) K (fun i => F.1 i) := by
    rw [hKsub]
    exact aux_prismForm_sub (n := n) (k := 1) (by omega) (by omega)
      K0 K1 hK0 hK1 F.1
  have hle : prismForm n 1 (by omega) (by omega) K (fun i => F.1 i) ≤
      prismForm n 1 (by omega) (by omega) K0 (fun i => F.1 i) := by
    rw [← hform]
    exact sub_le_self _ hposK1
  have htarget : ENNReal.ofReal (w *
      |prismForm n 1 (by omega) (by omega) K (fun i => F.1 i)|) ≤
      ENNReal.ofReal (w *
        |prismForm n 1 (by omega) (by omega) K0 (fun i => F.1 i)|) := by
    apply ENNReal.ofReal_le_ofReal
    rw [abs_of_nonneg hposK, abs_of_nonneg]
    · exact mul_le_mul_of_nonneg_left hle hw
    · exact le_trans hposK hle
  change ENNReal.ofReal (w *
      |prismForm n 1 (by omega) (by omega) K (fun i => F.1 i)|) ≤ _
  calc
    _ ≤ ENNReal.ofReal (w *
        |prismForm n 1 (by omega) (by omega) K0 (fun i => F.1 i)|) := htarget
    _ ≤ ⨆ F : NormalizedFunctionTuple n,
      ENNReal.ofReal (min 1
        (Real.rpow (J.1 : ℝ) (-1 + (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1))) *
          |prismForm n 1 (by omega) (by omega)
            (fun y => ∑ j ∈ Finset.range J.1, M0 (j : ℤ) y)
            (fun i => F.1 i)|) := by
        dsimp [w, K0]
        exact le_iSup (fun F : NormalizedFunctionTuple n =>
          ENNReal.ofReal (min 1
            (Real.rpow (J.1 : ℝ) (-1 + (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1))) *
              |prismForm n 1 (by omega) (by omega)
                (fun y => ∑ j ∈ Finset.range J.1, M0 (j : ℤ) y)
                (fun i => F.1 i)|)) F
    _ ≤ ⨆ J : {J : ℕ // 0 < J}, ⨆ F : NormalizedFunctionTuple n,
      ENNReal.ofReal (min 1
        (Real.rpow (J.1 : ℝ) (-1 + (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1))) *
          |prismForm n 1 (by omega) (by omega)
            (fun y => ∑ j ∈ Finset.range J.1, M0 (j : ℤ) y)
            (fun i => F.1 i)|) := by
      exact le_iSup (fun J : {J : ℕ // 0 < J} => ⨆ F : NormalizedFunctionTuple n,
        ENNReal.ofReal (min 1
          (Real.rpow (J.1 : ℝ) (-1 + (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1))) *
            |prismForm n 1 (by omega) (by omega)
              (fun y => ∑ j ∈ Finset.range J.1, M0 (j : ℤ) y)
              (fun i => F.1 i)|)) J

theorem aux_whitney_positive_comparison {n : ℕ} (hn : 2 ≤ n)
    (K : ℤ → RealPlane → ℝ) (p : ℤ → ℝ → ℝ)
    (hKmem : ∀ j, MemW0 (K j))
    (hpmem : ∀ j, MemW0 (p j))
    (hKpos : ∀ j g, aux_bounded g → 0 ≤ ∫ v : RealPlane,
      g v.1 * g v.2 * K j v) :
    kernelSequenceSeminorm n 1 (by omega) (by omega)
      (fun j => aux_liftPlaneKernel (K j)) ≤
    kernelSequenceSeminorm n 1 (by omega) (by omega)
      (fun j => aux_liftPlaneKernel (fun v => K j v + tensorSquare (p j) v)) := by
  let M0 : KernelSequence 1 := fun j =>
    aux_liftPlaneKernel (fun v => K j v + tensorSquare (p j) v)
  let M1 : KernelSequence 1 := fun j => aux_liftPlaneKernel (tensorSquare (p j))
  have hM0 : ∀ j : ℤ, MemW0 (M0 j) := by
    intro j
    dsimp [M0]
    apply liftPlaneKernel_memW0
    exact aux_memW0_add (hKmem j) (aux_memW0_tensorSquare _ (hpmem j))
  have hM1 : ∀ j : ℤ, MemW0 (M1 j) := by
    intro j
    dsimp [M1]
    exact liftPlaneKernel_memW0 _ (aux_memW0_tensorSquare _ (hpmem j))
  have hpos : ∀ (j : ℤ) (F : Fin n → SchwartzMap (RealVector n) ℝ),
      0 ≤ prismForm n 1 (by omega) (by omega)
        (fun y => M0 j y - M1 j y) (fun i => F i) := by
    intro j F
    have hquad := aux_whitney_lift_positive (K j) (hKpos j)
    have hform := formPos (show 1 ≤ n by omega) (aux_liftPlaneKernel (K j))
      (liftPlaneKernel_memW0 _ (hKmem j)) hquad F
    convert hform using 1
    congr 2
    funext y
    simp [M0, M1, aux_liftPlaneKernel, tensorSquare]
  have hpos1 : ∀ (j : ℤ) (F : Fin n → SchwartzMap (RealVector n) ℝ),
      0 ≤ prismForm n 1 (by omega) (by omega) (M1 j) (fun i => F i) := by
    intro j F
    change 0 ≤ prismForm n 1 (by omega) (by omega)
      (fun u => p j (u.1 0) * p j (u.2 0)) (fun i => F i)
    exact aux_formPos_tensorSquare (show 1 ≤ n by omega) (p j) (hpmem j) F
  have hEq : (fun j y => M0 j y - M1 j y) =
      (fun j => aux_liftPlaneKernel (K j)) := by
    ext j y
    simp [M0, M1, aux_liftPlaneKernel, tensorSquare]
  rw [← hEq]
  exact aux_whitney_seminorm_le_of_positive_difference hn M0 M1 hM0 hM1 hpos hpos1

theorem aux_whitney_fourierReal_even_of_even (f : ℝ → ℝ)
    (heven : ∀ x : ℝ, f (-x) = f x) (xi : ℝ) :
    aux_fourierReal f (-xi) = aux_fourierReal f xi := by
  rw [aux_fourierReal_eq_fourier, aux_fourierReal_eq_fourier]
  change FourierTransform.fourier (fun x : ℝ => (f x : ℂ))
      ((LinearIsometryEquiv.neg ℝ) xi) = _
  rw [← Real.fourier_comp_linearIsometry (LinearIsometryEquiv.neg ℝ)
    (fun x : ℝ => (f x : ℂ)) xi]
  apply Real.fourier_congr_ae
  filter_upwards [] with x
  change (f (-x) : ℂ) = (f x : ℂ)
  rw [heven x]

/-- The sequence of Whitney rescalings. -/
noncomputable def aux_whitneySequence (Psi : RealPlane → ℝ) (a : ℤ → ℝ) :
    KernelSequence 1 :=
  fun j => aux_liftPlaneKernel (aux_planeRescale (a j) Psi)

/-- The constant in the Whitney-with-gap reduction. -/
noncomputable def C_inductPositiveTermsReductionWhitneyGap (n : ℕ) : ℝ :=
  2 * C_inductPositiveTermsReductionNonWhitneySkip n +
    (2 : ℝ) ^ 19 * (C_uniPair ^ 2 + C_phiJProperties ^ 2) *
      C_diagonalBandReduction

/--
\begin{proposition}[induct positive terms - reduction variant, Whitney, with gap]
\label{P:induct-positive-terms-reduction-whitney-gap}
Let $a\in {\rm A}$ satisfy $a(j)\geq 2^{11}a(j-1)$ for every $j\in\mathbb Z$.
Let $M_j:\mathbb{R}^2\to \mathbb{R}$ be of the form
\begin{equation}\label{auto:Whitney-gap-kernel}
M_j=\Psi_{(a(j))}
\end{equation}
for every $j\in\Z$, where $\Psi:\mathbb{R}^2\to \mathbb{R}$ is a Schwartz function
satisfying $\Psi(v_0,v_1)=\Psi(v_1,v_0)$ for all $v=(v_0,v_1)\in\mathbb{R}^2$,
\begin{equation}\label{p1-on-W_pos}
\int_{\mathbb{R}^2} g(v_0){g(v_1)}\Psi(v)\,dv\ge 0
\end{equation}
for all bounded measurable $g:\mathbb{R}\to\mathbb{R}$,
\begin{equation}\label{p1-on-W_supp}
\mathrm{supp}(\widehat{\Psi}) \subset \mathrm{Ann}_1(1, 2^3)^2,
\end{equation}
for $m\in [3)$ and $\xi \in \R$,
\begin{equation}\label{p1-on-W_der}
\Big|\tfrac{d^m}{d\xi^{m}} \widehat{\Psi}(\xi,-\xi)\Big| \leq 1,
\end{equation}
and for all $v\in\mathbb{R}^2$,
\begin{equation}\label{p1-on-W_decay}
|\Psi(v)| \le \sum_{u=0}^1 \langle(W_u v)_0\rangle^{3/2} \langle (W_u v)_1\rangle^{3/2}.
\end{equation}
Then with $\M=(M_j)_{j\in\Z}$,
\begin{equation}\label{auto:Whitney-gap-reduction-bound}
\|\M\|_{\rm M(1)} \le C_{\text{P:induct-positive-terms-reduction-whitney-gap}}.
\end{equation}
where
\begin{equation}\label{auto:Whitney-gap-constant-definition}
C_{\text{P:induct-positive-terms-reduction-whitney-gap}}
=2C_{\text{P:induct-positive-terms-reduction-non-whitney-skip}}
+2^{19}(C_{\text{def:unipair}}^2+C_{\text{lem:Phij\_prop}}^2)C_{\text{P:diagonal-band-reduction}}.
\end{equation}
\end{proposition}

See also [`Codex.Reduction.OnDiagonalOffDiagonal.inductPositiveTermsReductionWhitneyGap`],
[`Codex.Reduction.OnDiagonalOffDiagonal.inductPositiveTermsReductionNonWhitneySkip`],
[`Codex.Reduction.WindowsAndPairs.uniPair`],
[`Codex.Reduction.Miscellany.phiJProperties`],
[`Codex.Reduction.OnDiagonalOffDiagonal.diagonalBandReduction`].
-/
theorem inductPositiveTermsReductionWhitneyGap {n : ℕ} (hn : 2 ≤ n)
    (a : ℤ → ℝ) (ha : SpacedSequence a)
    (hgap : ∀ j : ℤ, (2 : ℝ) ^ 11 * a (j - 1) ≤ a j)
    (phi0 phi1 : SchwartzMap ℝ ℝ) (hpair : uniPair phi0 phi1)
    (Psi : WhitneyKernelData) :
    kernelSequenceSeminorm n 1 (by omega) (by omega)
      (aux_whitneySequence Psi.kernel a) ≤
        ENNReal.ofReal (C_inductPositiveTermsReductionWhitneyGap n) := by
  classical
  rcases aux_whitney_phiJProperties phi0 phi1 hpair Psi with
    ⟨psi, hdiag, heven, hsupp, hderiv⟩
  have hCp : 0 ≤ C_phiJProperties := by
    rw [constantPhiJProposition]
    positivity
  have hpsiDecay : ∀ x : ℝ,
      |psi x| ≤ (2 : ℝ) ^ 9 * C_phiJProperties * bracketBump x ^ 2 := by
    intro x
    exact aux_whitney_psi_decay psi C_phiJProperties hCp hsupp hderiv x
  let K : ℤ → RealPlane → ℝ := fun j => aux_planeRescale (a j) Psi.kernel
  let p : ℤ → ℝ → ℝ := fun j => aux_windowRescale psi (a j)
  let f : ℤ → ℝ → ℝ := fun j x =>
    aux_windowRescale phi0 ((2 : ℝ) ^ (-5 : ℤ) * a j) x -
      aux_windowRescale phi1 ((2 : ℝ) ^ (5 : ℤ) * a j) x
  let M3 : ℤ → RealPlane → ℝ := fun j v =>
    K j v - (2 * tensorSquare (f j) v - tensorSquare (p j) v)
  have hKmem : ∀ j : ℤ, MemW0 (K j) := by
    intro j
    dsimp [K]
    exact aux_planeRescale_memW0 _ Psi.kernel_memW0 (ha j).1
  have hpmem : ∀ j : ℤ, MemW0 (p j) := by
    intro j
    dsimp [p]
    exact aux_windowRescale_memW0 psi (ha j).1
  have hfmem : ∀ j : ℤ, MemW0 (f j) := by
    intro j
    dsimp [f]
    exact aux_memW0_sub
      (aux_windowRescale_memW0 phi0
        (mul_pos (zpow_pos (by norm_num) _) (ha j).1))
      (aux_windowRescale_memW0 phi1
        (mul_pos (zpow_pos (by norm_num) _) (ha j).1))
  have hM3mem : ∀ j : ℤ, MemW0 (M3 j) := by
    intro j
    dsimp [M3]
    exact aux_memW0_sub (hKmem j)
      (aux_memW0_sub
        (aux_memW0_const_mul_nonneg (aux_memW0_tensorSquare _ (hfmem j)) 2 (by norm_num))
        (aux_memW0_tensorSquare _ (hpmem j)))
  have hpEven (j : ℤ) (xi : ℝ) :
      aux_fourierReal (p j) (-xi) = aux_fourierReal (p j) xi := by
    have ht : 0 < a j := (ha j).1
    calc
      aux_fourierReal (p j) (-xi) = aux_fourierReal psi (a j * (-xi)) := by
        dsimp [p]
        rw [aux_fourierReal_eq_fourier,
          aux_windowRescale_fourier (a j) ht psi (-xi),
          ← aux_fourierReal_eq_fourier psi]
      _ = aux_fourierReal psi (-(a j * xi)) := by congr 1; ring
      _ = aux_fourierReal psi (a j * xi) :=
        aux_whitney_fourierReal_even_of_even psi heven (a j * xi)
      _ = aux_fourierReal (p j) xi := by
        symm
        dsimp [p]
        rw [aux_fourierReal_eq_fourier,
          aux_windowRescale_fourier (a j) ht psi xi,
          ← aux_fourierReal_eq_fourier psi]
  have hfEven (j : ℤ) (xi : ℝ) :
      aux_fourierReal (f j) (-xi) = aux_fourierReal (f j) xi := by
    have ht0 : 0 < (2 : ℝ) ^ (-5 : ℤ) * a j :=
      mul_pos (zpow_pos (by norm_num) _) (ha j).1
    have ht1 : 0 < (2 : ℝ) ^ (5 : ℤ) * a j :=
      mul_pos (zpow_pos (by norm_num) _) (ha j).1
    dsimp [f]
    repeat' rw [aux_fourierReal_eq_fourier]
    rw [aux_fourier_sub_of_integrable _ _
      (aux_windowRescale_integrable phi0 _ ht0)
      (aux_windowRescale_integrable phi1 _ ht1) (-xi),
      aux_fourier_sub_of_integrable _ _
      (aux_windowRescale_integrable phi0 _ ht0)
      (aux_windowRescale_integrable phi1 _ ht1) xi,
      aux_windowRescale_fourier_even phi0 hpair.1 ht0 xi,
      aux_windowRescale_fourier_even phi1 hpair.2.1 ht1 xi]
  have hM3cancel : ∀ j xi, aux_fourierPlane (M3 j) (xi, -xi) = 0 := by
    intro j xi
    dsimp [M3]
    exact aux_whitneyM3_cancellation_of_square_identity (K j) (p j) (f j)
      (hKmem j) (hpmem j) (hfmem j) xi (hpEven j xi) (hfEven j xi)
      (aux_whitneyM3_square_identity a ha phi0 phi1 psi Psi hdiag j xi)
  let c : ℝ := (2 : ℝ) ^ 19 * (C_uniPair ^ 2 + C_phiJProperties ^ 2)
  have hc : 0 < c := by
    dsimp [c]
    have hCu : 0 < C_uniPair := by norm_num [C_uniPair]
    exact mul_pos (by positivity)
      (add_pos_of_pos_of_nonneg (sq_pos_of_pos hCu) (sq_nonneg _))
  have hM3decay : ∀ j v, |M3 j v| ≤ c *
      ∑ u : Fin 2,
        scaledBracketBumpReal (3 / 2 : ℝ) (a j) ((W u v).1) *
          scaledBracketBumpReal (3 / 2 : ℝ) (a j) ((W u v).2) := by
    intro j v
    dsimp [M3, K, p, f, c]
    exact aux_whitneyM3_decay a ha phi0 phi1 psi hpair Psi hpsiDecay j v
  let D : ReductionData := aux_whitneyData a ha M3 c hc hM3mem hM3cancel hM3decay
  have hDsupport : aux_frequencyDiagonalBound D := by
    intro j z hz
    change z ∈ Function.support
      (aux_planeFourier (fun v => c⁻¹ * M3 j v)) at hz
    have hnonzero : aux_planeFourier (fun v => c⁻¹ * M3 j v) z ≠ 0 :=
      Function.mem_support.mp hz
    rw [aux_planeFourier_const_mul] at hnonzero
    apply aux_whitneyM3_frequency_support a ha hgap phi0 phi1 psi hpair Psi hsupp j
    apply Function.mem_support.mpr
    intro hzero
    exact hnonzero (by rw [hzero, mul_zero])
  have hD := vanishingDiagonalReduction hn D hDsupport
  have hCdiag : 0 ≤ C_diagonalBandReduction := by
    unfold C_diagonalBandReduction
    exact add_nonneg
      (mul_nonneg (by positivity) (Real.sqrt_nonneg _))
      (mul_nonneg (by positivity) CincreaseDataReduction_nonneg)
  have hM3eq : (fun j => aux_liftPlaneKernel (M3 j)) =
      (fun j y => c * aux_liftPlaneKernel (D.kernel j) y) := by
    funext j y
    change M3 j (y.1 0, y.2 0) = c * (c⁻¹ * M3 j (y.1 0, y.2 0))
    field_simp [ne_of_gt hc]
  have hM3bound :
      kernelSequenceSeminorm n 1 (by omega) (by omega)
        (fun j => aux_liftPlaneKernel (M3 j)) ≤
        ENNReal.ofReal (c * C_diagonalBandReduction) := by
    rw [hM3eq, aux_kernelSequenceSeminorm_const_mul (by omega) (by omega) c hc.le]
    calc
      ENNReal.ofReal c * kernelSequenceSeminorm n 1 (by omega) (by omega)
          (fun j => aux_liftPlaneKernel (D.kernel j)) ≤
        ENNReal.ofReal c * ENNReal.ofReal C_diagonalBandReduction :=
          mul_le_mul_of_nonneg_left hD (by positivity)
      _ = ENNReal.ofReal (c * C_diagonalBandReduction) :=
        (ENNReal.ofReal_mul hc.le).symm
  let alpha : ℤ → ℝ := aux_whitneyAlpha a
  have halpha : SpacedSequence alpha := by
    dsimp [alpha]
    exact aux_whitneyAlpha_spaced a ha hgap
  have hskip := inductPositiveTermsReductionNonWhitneySkip hn alpha halpha phi0 phi1 hpair
  let M2 : KernelSequence 1 := fun j => aux_liftPlaneKernel (2 * tensorSquare (f j))
  have hM2mem : MemKernelSequence 1 M2 := by
    intro j
    dsimp [M2]
    exact liftPlaneKernel_memW0 _
      (aux_memW0_const_mul_nonneg (aux_memW0_tensorSquare _ (hfmem j)) 2 (by norm_num))
  have hM2eq : M2 = fun j y => 2 * aux_nonWhitneySkipSequence phi0 phi1 alpha j y := by
    funext j y
    dsimp [M2, f, alpha, aux_nonWhitneySkipSequence, aux_liftPlaneKernel]
    rw [aux_whitneyAlpha_even, aux_whitneyAlpha_odd]
  have hM2bound :
      kernelSequenceSeminorm n 1 (by omega) (by omega) M2 ≤
        ENNReal.ofReal (2 * C_inductPositiveTermsReductionNonWhitneySkip n) := by
    rw [hM2eq, aux_kernelSequenceSeminorm_const_mul (by omega) (by omega) 2 (by norm_num)]
    calc
      ENNReal.ofReal 2 * kernelSequenceSeminorm n 1 (by omega) (by omega)
          (aux_nonWhitneySkipSequence phi0 phi1 alpha) ≤
        ENNReal.ofReal 2 * ENNReal.ofReal
          (C_inductPositiveTermsReductionNonWhitneySkip n) :=
        mul_le_mul_of_nonneg_left hskip (by positivity)
      _ = ENNReal.ofReal (2 * C_inductPositiveTermsReductionNonWhitneySkip n) :=
        (ENNReal.ofReal_mul (by norm_num)).symm
  have hKpos : ∀ j g, aux_bounded g →
      0 ≤ ∫ v : RealPlane, g v.1 * g v.2 * K j v := by
    intro j g hg
    dsimp [K]
    exact aux_planeRescale_positive Psi.kernel Psi.positive (ha j).1 g hg
  let M0 : KernelSequence 1 := fun j =>
    aux_liftPlaneKernel (fun v => K j v + tensorSquare (p j) v)
  have hpositive :
      kernelSequenceSeminorm n 1 (by omega) (by omega)
        (aux_whitneySequence Psi.kernel a) ≤
      kernelSequenceSeminorm n 1 (by omega) (by omega) M0 := by
    change kernelSequenceSeminorm n 1 (by omega) (by omega)
        (fun j => aux_liftPlaneKernel (K j)) ≤ _
    exact aux_whitney_positive_comparison hn K p hKmem hpmem hKpos
  have hM3liftmem : MemKernelSequence 1
      (fun j => aux_liftPlaneKernel (M3 j)) := by
    intro j
    exact liftPlaneKernel_memW0 _ (hM3mem j)
  have hdecomp : M0 = fun j y => M2 j y + aux_liftPlaneKernel (M3 j) y := by
    funext j y
    dsimp [M0, M2, M3, aux_liftPlaneKernel, tensorSquare]
    ring
  have hCskip : 0 ≤ C_inductPositiveTermsReductionNonWhitneySkip n := by
    unfold C_inductPositiveTermsReductionNonWhitneySkip
    apply mul_nonneg
    · exact Real.rpow_nonneg (by norm_num) _
    · unfold C_inductPositiveTermsReductionNonWhitney
      apply add_nonneg
      · norm_num [C_oneScaleEstimateWindow, C_uniPair]
      · exact mul_nonneg (mul_nonneg (mul_nonneg (by positivity) (by positivity))
          (by positivity)) hCdiag
  have htwoSkip : 0 ≤ 2 * C_inductPositiveTermsReductionNonWhitneySkip n :=
    mul_nonneg (by norm_num) hCskip
  have hprod : 0 ≤ c * C_diagonalBandReduction := mul_nonneg hc.le hCdiag
  calc
    kernelSequenceSeminorm n 1 (by omega) (by omega)
        (aux_whitneySequence Psi.kernel a) ≤
      kernelSequenceSeminorm n 1 (by omega) (by omega) M0 := hpositive
    _ = kernelSequenceSeminorm n 1 (by omega) (by omega)
        (fun j y => M2 j y + aux_liftPlaneKernel (M3 j) y) := by rw [hdecomp]
    _ ≤ kernelSequenceSeminorm n 1 (by omega) (by omega) M2 +
        kernelSequenceSeminorm n 1 (by omega) (by omega)
          (fun j => aux_liftPlaneKernel (M3 j)) :=
      kernelSequenceSeminorm_add_le (by omega) (by omega) _ _ hM2mem hM3liftmem
    _ ≤ ENNReal.ofReal (2 * C_inductPositiveTermsReductionNonWhitneySkip n) +
        ENNReal.ofReal (c * C_diagonalBandReduction) :=
      add_le_add hM2bound hM3bound
    _ = ENNReal.ofReal
        (2 * C_inductPositiveTermsReductionNonWhitneySkip n +
          c * C_diagonalBandReduction) :=
      (ENNReal.ofReal_add htwoSkip hprod).symm
    _ = ENNReal.ofReal (C_inductPositiveTermsReductionWhitneyGap n) := by
      rfl

-- The explicit numerical calculation below contains powers through `2^553`.
set_option exponentiation.threshold 600 in
/--
\begin{lemma}[constant $C_{\text{P:induct-positive-terms-reduction-whitney-gap}}$ \auto]
\label{constant Whitney gap reduction}
\begin{equation}\label{constant Whitney gap reduction bound}
C_{\text{P:induct-positive-terms-reduction-whitney-gap}}
<\tfrac{127}{128}2^{553}<2^{553}.
\end{equation}
\end{lemma}

See also [`Codex.Reduction.OnDiagonalOffDiagonal.inductPositiveTermsReductionWhitneyGap`].
-/
theorem constantWhitneyGapReduction {n : ℕ} (hn : 2 ≤ n) :
    C_inductPositiveTermsReductionWhitneyGap n <
      (127 / 128 : ℝ) * (2 : ℝ) ^ 553 := by
  have hdiag_nonneg : 0 ≤ C_diagonalBandReduction := by
    unfold C_diagonalBandReduction
    exact add_nonneg
      (mul_nonneg (by positivity) (Real.sqrt_nonneg _))
      (mul_nonneg (by positivity) CincreaseDataReduction_nonneg)
  have hsum : C_uniPair ^ 2 + C_phiJProperties ^ 2 ≤
      (257 / 256 : ℝ) * (2 : ℝ) ^ 54 := by
    rw [constantPhiJProposition]
    norm_num [C_uniPair]
  have hcoef : (2 : ℝ) ^ 19 * (C_uniPair ^ 2 + C_phiJProperties ^ 2) ≤
      (257 / 256 : ℝ) * (2 : ℝ) ^ 73 := by
    calc
      (2 : ℝ) ^ 19 * (C_uniPair ^ 2 + C_phiJProperties ^ 2) ≤
          (2 : ℝ) ^ 19 * ((257 / 256 : ℝ) * (2 : ℝ) ^ 54) :=
        mul_le_mul_of_nonneg_left hsum (by positivity)
      _ = (257 / 256 : ℝ) * (2 : ℝ) ^ 73 := by
        calc
          (2 : ℝ) ^ 19 * ((257 / 256 : ℝ) * (2 : ℝ) ^ 54) =
              (257 / 256 : ℝ) * ((2 : ℝ) ^ 19 * (2 : ℝ) ^ 54) := by ring
          _ = (257 / 256 : ℝ) * (2 : ℝ) ^ 73 := by
            rw [← pow_add]
  have hcoef_pos : 0 < (257 / 256 : ℝ) * (2 : ℝ) ^ 73 := by positivity
  have hsecond : (2 : ℝ) ^ 19 * (C_uniPair ^ 2 + C_phiJProperties ^ 2) *
      C_diagonalBandReduction < (16191 / 16384 : ℝ) * (2 : ℝ) ^ 553 := by
    calc
      (2 : ℝ) ^ 19 * (C_uniPair ^ 2 + C_phiJProperties ^ 2) *
          C_diagonalBandReduction ≤
          ((257 / 256 : ℝ) * (2 : ℝ) ^ 73) * C_diagonalBandReduction :=
        mul_le_mul_of_nonneg_right hcoef hdiag_nonneg
      _ < ((257 / 256 : ℝ) * (2 : ℝ) ^ 73) *
          ((63 / 64 : ℝ) * (2 : ℝ) ^ 480) :=
        mul_lt_mul_of_pos_left constantDiagonalBandReduction hcoef_pos
      _ = (16191 / 16384 : ℝ) * (2 : ℝ) ^ 553 := by
        calc
          ((257 / 256 : ℝ) * (2 : ℝ) ^ 73) *
              ((63 / 64 : ℝ) * (2 : ℝ) ^ 480) =
              ((257 / 256 : ℝ) * (63 / 64 : ℝ)) *
                ((2 : ℝ) ^ 73 * (2 : ℝ) ^ 480) := by ring
          _ = (16191 / 16384 : ℝ) * (2 : ℝ) ^ 553 := by
            rw [← pow_add]
            norm_num
  have hfirst : 2 * C_inductPositiveTermsReductionNonWhitneySkip n <
      (1 / 256 : ℝ) * (2 : ℝ) ^ 553 := by
    calc
      2 * C_inductPositiveTermsReductionNonWhitneySkip n <
          2 * ((8 / 9 : ℝ) * (2 : ℝ) ^ 542) :=
        mul_lt_mul_of_pos_left (constantNonWhitneySkipReduction hn) (by norm_num)
      _ = (16 / 9 : ℝ) * (2 : ℝ) ^ 542 := by ring
      _ < 8 * (2 : ℝ) ^ 542 := by
        apply mul_lt_mul_of_pos_right
        · norm_num
        · positivity
      _ = (1 / 256 : ℝ) * (2 : ℝ) ^ 553 := by
        calc
          8 * (2 : ℝ) ^ 542 = ((1 / 256 : ℝ) * (2 : ℝ) ^ 11) *
              (2 : ℝ) ^ 542 := by norm_num
          _ = (1 / 256 : ℝ) * ((2 : ℝ) ^ 11 * (2 : ℝ) ^ 542) := by ring
          _ = (1 / 256 : ℝ) * (2 : ℝ) ^ 553 := by
            rw [← pow_add]
  unfold C_inductPositiveTermsReductionWhitneyGap
  calc
    2 * C_inductPositiveTermsReductionNonWhitneySkip n +
        (2 : ℝ) ^ 19 * (C_uniPair ^ 2 + C_phiJProperties ^ 2) *
          C_diagonalBandReduction <
      (1 / 256 : ℝ) * (2 : ℝ) ^ 553 +
        (16191 / 16384 : ℝ) * (2 : ℝ) ^ 553 :=
      add_lt_add hfirst hsecond
    _ = (16255 / 16384 : ℝ) * (2 : ℝ) ^ 553 := by ring
    _ < (127 / 128 : ℝ) * (2 : ℝ) ^ 553 := by
      apply mul_lt_mul_of_pos_right
      · norm_num
      · positivity

/-- The constant in the ordinary Whitney reduction. -/
noncomputable def C_inductPositiveTermsReductionWhitney (n : ℕ) : ℝ :=
  11 * C_inductPositiveTermsReductionWhitneyGap n

/-! Splitting a prefix into eleven residue classes transfers the Whitney-gap
estimate to an arbitrary spaced scale sequence. -/

theorem aux_whitney_residue_length (J q s : ℕ) :
    q < (J + 10 - s) / 11 ↔ 11 * q + s < J := by
  omega

theorem aux_whitney_residue_mod (s : Fin 11) (q : ℕ) :
    (⟨(11 * q + s.1) % 11, Nat.mod_lt _ (by omega)⟩ : Fin 11) = s := by
  apply Fin.ext
  change (11 * q + s.1) % 11 = s.1
  omega

theorem aux_whitney_residue_div (s : Fin 11) (q : ℕ) :
    (11 * q + s.1) / 11 = q := by
  omega

theorem aux_whitney_normalizer_antitone {n J K : ℕ} (hn : 2 ≤ n)
    (hK : 0 < K) (hKJ : K ≤ J) :
    min 1 (Real.rpow (J : ℝ)
      (-1 + (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1))) ≤
      min 1 (Real.rpow (K : ℝ)
        (-1 + (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1))) := by
  apply min_le_min_left
  apply Real.rpow_le_rpow_of_nonpos
  · exact_mod_cast hK
  · exact_mod_cast hKJ
  · have hnreal : (2 : ℝ) ≤ n := by exact_mod_cast hn
    have hbase : 2 - (n : ℝ) ≤ 0 := by linarith
    have hpow : (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1) =
        Real.rpow 2 (2 - (n : ℝ)) := by
      rw [← Real.rpow_intCast]
      congr 1
      push_cast
      ring
    rw [hpow]
    have hle : Real.rpow 2 (2 - (n : ℝ)) ≤ 1 :=
      Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) hbase
    linarith

theorem aux_whitney_residue_sum {α : Type*} [AddCommMonoid α]
    (f : ℕ → α) (J : ℕ) :
    (∑ j ∈ Finset.range J, f j) =
      ∑ s : Fin 11, ∑ q ∈ Finset.range ((J + 10 - s.1) / 11),
        f (11 * q + s.1) := by
  classical
  let S : Finset (Sigma fun _ : Fin 11 => ℕ) :=
    Finset.univ.sigma fun s => Finset.range ((J + 10 - s.1) / 11)
  have hsum : (∑ x ∈ S, f (11 * x.2 + x.1.1)) =
      ∑ s : Fin 11, ∑ q ∈ Finset.range ((J + 10 - s.1) / 11),
        f (11 * q + s.1) := by
    simp [S, Finset.sum_sigma]
  rw [← hsum]
  refine Finset.sum_bij' (fun j _ => ⟨⟨j % 11, Nat.mod_lt _ (by omega)⟩, j / 11⟩)
    (fun x _ => 11 * x.2 + x.1.1) ?_ ?_ ?_ ?_ ?_
  · intro j hj
    simp only [S, Finset.mem_sigma, Finset.mem_univ, true_and]
    simp only [Finset.mem_range]
    have hj' : j < J := Finset.mem_range.mp hj
    exact (aux_whitney_residue_length J (j / 11) (j % 11)).2 (by omega)
  · intro x hx
    simp only [Finset.mem_range]
    simp only [S, Finset.mem_sigma] at hx
    have hxq : x.2 < (J + 10 - x.1.1) / 11 := Finset.mem_range.mp hx.2
    exact (aux_whitney_residue_length J x.2 x.1.1).1 hxq
  · intro j hj
    change 11 * (j / 11) + j % 11 = j
    omega
  · intro x hx
    simp only [S, Finset.mem_sigma] at hx
    rcases x with ⟨⟨s, hs⟩, q⟩
    dsimp at hx ⊢
    exact Sigma.ext (aux_whitney_residue_mod ⟨s, hs⟩ q)
      (heq_of_eq (aux_whitney_residue_div ⟨s, hs⟩ q))
  · intro j hj
    change f j = f (11 * (j / 11) + j % 11)
    congr 1
    omega

theorem aux_whitney_residue_kernel_sum (M : KernelSequence 1) (J : ℕ) :
    (fun y => ∑ j ∈ Finset.range J, M (j : ℤ) y) =
      fun y => ∑ s : Fin 11, ∑ q ∈ Finset.range ((J + 10 - s.1) / 11),
        M (11 * (q : ℤ) + (s.1 : ℤ)) y := by
  funext y
  have hsum := aux_whitney_residue_sum (fun j : ℕ => M (j : ℤ) y) J
  rw [hsum]
  apply Finset.sum_congr rfl
  intro s hs
  apply Finset.sum_congr rfl
  intro q hq
  push_cast
  ring

theorem aux_whitney_prismForm_zero {n : ℕ} (hn : 1 ≤ n)
    (F : NormalizedFunctionTuple n) :
    prismForm n 1 (by omega) hn (fun _ => 0) (fun q => F.1 q) = 0 := by
  simp [prismForm, mToK, prismBrascampLiebForm]

theorem aux_whitney_ennreal_sum_eleven_ofReal (C : ℝ) :
    (∑ _ : Fin 11, ENNReal.ofReal C) = ENNReal.ofReal (11 * C) := by
  rw [Finset.sum_const]
  norm_num [ENNReal.ofReal_mul]

theorem aux_kernelSequenceSeminorm_residue_le {n : ℕ} (hn : 2 ≤ n)
    (M : KernelSequence 1) (hM : MemKernelSequence 1 M) (C : ℝ)
    (hbound : ∀ s : Fin 11,
      kernelSequenceSeminorm n 1 (by omega) (by omega)
        (fun j => M (11 * j + (s.1 : ℤ))) ≤ ENNReal.ofReal C) :
    kernelSequenceSeminorm n 1 (by omega) (by omega) M ≤
      ENNReal.ofReal (11 * C) := by
  classical
  unfold kernelSequenceSeminorm
  refine iSup_le fun J => ?_
  refine iSup_le fun F => ?_
  let K : Fin 11 → ℕ := fun s => (J.1 + 10 - s.1) / 11
  let N : Fin 11 → KernelSequence 1 :=
    fun s j => M (11 * j + (s.1 : ℤ))
  let p : Fin 11 → ℝ := fun s =>
    prismForm n 1 (by omega) (by omega)
      (fun y => ∑ q ∈ Finset.range (K s), N s (q : ℤ) y)
      (fun q => F.1 q)
  have hNmem (s : Fin 11) : MemKernelSequence 1 (N s) := by
    intro j
    dsimp [N]
    exact hM _
  have hK_le (s : Fin 11) : K s ≤ J.1 := by
    dsimp [K]
    omega
  have hlin :
      prismForm n 1 (by omega) (by omega)
        (fun y => ∑ j ∈ Finset.range J.1, M (j : ℤ) y)
        (fun q => F.1 q) = ∑ s, p s := by
    rw [aux_whitney_residue_kernel_sum M J.1]
    simpa [p, N, K] using
      (aux_prismForm_finset_sum (n := n) (k := 1) (by omega) (by omega)
        (Finset.univ : Finset (Fin 11))
        (fun s => fun y => ∑ q ∈ Finset.range (K s), N s (q : ℤ) y)
        (by
          intro s hs
          apply aux_memW0_finset_sum
          intro q hq
          exact hNmem s (q : ℤ)) F.1)
  let w : ℝ := min 1 (Real.rpow (J.1 : ℝ)
    (-1 + (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1)))
  let wK : Fin 11 → ℝ := fun s => min 1 (Real.rpow (K s : ℝ)
    (-1 + (2 : ℝ) ^ ((1 : ℤ) - (n : ℤ) + 1)))
  have hw : 0 ≤ w := by
    dsimp [w]
    exact le_min zero_le_one (Real.rpow_nonneg (Nat.cast_nonneg _) _)
  have hp_zero (s : Fin 11) (hKs : K s = 0) : p s = 0 := by
    dsimp [p]
    rw [hKs]
    simp only [Finset.sum_range_zero]
    exact aux_whitney_prismForm_zero (by omega) F
  have hweight (s : Fin 11) : w * |p s| ≤ wK s * |p s| := by
    by_cases hKs : K s = 0
    · rw [hp_zero s hKs]
      simp
    · exact mul_le_mul_of_nonneg_right
        (aux_whitney_normalizer_antitone hn (Nat.pos_of_ne_zero hKs) (hK_le s))
        (abs_nonneg _)
  have hreal : w * |∑ s, p s| ≤ ∑ s, wK s * |p s| := by
    calc
      w * |∑ s, p s| ≤ w * ∑ s, |p s| :=
        mul_le_mul_of_nonneg_left (Finset.abs_sum_le_sum_abs _ _) hw
      _ = ∑ s, w * |p s| := Finset.mul_sum _ _ _
      _ ≤ ∑ s, wK s * |p s| := by
        apply Finset.sum_le_sum
        intro s hs
        exact hweight s
  have hclassbound (s : Fin 11) (hKs : 0 < K s) :
      ENNReal.ofReal (wK s * |p s|) ≤ ENNReal.ofReal C := by
    calc
      ENNReal.ofReal (wK s * |p s|) ≤
          kernelSequenceSeminorm n 1 (by omega) (by omega) (N s) := by
        unfold kernelSequenceSeminorm
        let Ks : {q : ℕ // 0 < q} := ⟨K s, hKs⟩
        apply le_iSup_of_le Ks
        apply le_iSup_of_le F
        simp [Ks, wK, p]
      _ ≤ ENNReal.ofReal C := by
        simpa [N] using hbound s
  have hsumclass :
      (∑ s, ENNReal.ofReal (wK s * |p s|)) ≤ ∑ _ : Fin 11, ENNReal.ofReal C := by
    apply Finset.sum_le_sum
    intro s hs
    by_cases hKs : K s = 0
    · rw [hp_zero s hKs]
      simp
    · exact hclassbound s (Nat.pos_of_ne_zero hKs)
  rw [hlin]
  change ENNReal.ofReal (w * |∑ s, p s|) ≤ ENNReal.ofReal (11 * C)
  calc
    ENNReal.ofReal (w * |∑ s, p s|) ≤
        ENNReal.ofReal (∑ s, wK s * |p s|) :=
      ENNReal.ofReal_le_ofReal hreal
    _ = ∑ s, ENNReal.ofReal (wK s * |p s|) := by
      apply ENNReal.ofReal_sum_of_nonneg
      intro s hs
      exact mul_nonneg
        (le_min zero_le_one (Real.rpow_nonneg (Nat.cast_nonneg _) _))
        (abs_nonneg _)
    _ ≤ ∑ _ : Fin 11, ENNReal.ofReal C := hsumclass
    _ = ENNReal.ofReal (11 * C) := aux_whitney_ennreal_sum_eleven_ofReal C

/--
\begin{proposition}[induct positive terms - reduction variant, Whitney]
\label{P:induct-positive-terms-reduction-whitney}
Let $a\in {\rm A}$. Let $M_j:\mathbb{R}^2\to \mathbb{R}$ be of the form
\begin{equation}\label{auto:Whitney-kernel}
M_j=\Psi_{(a(j))}
\end{equation}
for every $j\in\Z$, where $\Psi:\mathbb{R}^2\to \mathbb{R}$ is a Schwartz function
satisfying $\Psi(u_0,u_1)=\Psi(u_1,u_0)$ for all $u=(u_0,u_1)\in\mathbb{R}^2$,
and \eqref{p1-on-W_pos}, \eqref{p1-on-W_supp}, \eqref{p1-on-W_der},
\eqref{p1-on-W_decay}. Then with $\M=(M_j)_{j\in\Z}$,
\begin{equation}\label{auto:Whitney-reduction-bound}
\|\M\|_{\rm M(1)} \le C_{\text{P:induct-positive-terms-reduction-whitney}},
\end{equation}
where
\begin{equation}\label{auto:Whitney-constant-definition}
C_{\text{P:induct-positive-terms-reduction-whitney}}
=11C_{\text{P:induct-positive-terms-reduction-whitney-gap}}.
\end{equation}
\end{proposition}

See also [`Codex.Reduction.OnDiagonalOffDiagonal.inductPositiveTermsReductionWhitney`],
[`Codex.Reduction.OnDiagonalOffDiagonal.inductPositiveTermsReductionWhitneyGap`].
-/
theorem inductPositiveTermsReductionWhitney {n : ℕ} (hn : 2 ≤ n)
    (a : ℤ → ℝ) (ha : SpacedSequence a)
    (phi0 phi1 : SchwartzMap ℝ ℝ) (hpair : uniPair phi0 phi1)
    (Psi : WhitneyKernelData) :
    kernelSequenceSeminorm n 1 (by omega) (by omega)
      (aux_whitneySequence Psi.kernel a) ≤
        ENNReal.ofReal (C_inductPositiveTermsReductionWhitney n) := by
  classical
  let aS : Fin 11 → ℤ → ℝ := fun s j => a (11 * j + (s.1 : ℤ))
  have haS (s : Fin 11) : SpacedSequence (aS s) := by
    intro j
    constructor
    · dsimp [aS]
      exact (ha _).1
    · calc
        2 * aS s j ≤ (2 : ℝ) ^ 11 * aS s j :=
          mul_le_mul_of_nonneg_right (by norm_num) (le_of_lt (ha _).1)
        _ ≤ aS s (j + 1) := by
          dsimp [aS]
          convert aux_pow_two_mul_le_shift ha (11 * j + (s.1 : ℤ)) 11 using 1; ring_nf
  have hgap (s : Fin 11) : ∀ j : ℤ,
      (2 : ℝ) ^ 11 * aS s (j - 1) ≤ aS s j := by
    intro j
    dsimp [aS]
    convert aux_pow_two_mul_shift_le ha (11 * j + (s.1 : ℤ)) 11 using 1; ring_nf
  have hM : MemKernelSequence 1 (aux_whitneySequence Psi.kernel a) := by
    intro j
    dsimp [aux_whitneySequence]
    exact liftPlaneKernel_memW0 _
      (aux_planeRescale_memW0 _ Psi.kernel_memW0 (ha j).1)
  have hbound (s : Fin 11) :
      kernelSequenceSeminorm n 1 (by omega) (by omega)
        (fun j => aux_whitneySequence Psi.kernel a (11 * j + (s.1 : ℤ))) ≤
          ENNReal.ofReal (C_inductPositiveTermsReductionWhitneyGap n) := by
    have hmain := inductPositiveTermsReductionWhitneyGap hn (aS s) (haS s)
      (hgap s) phi0 phi1 hpair Psi
    have hseq :
        (fun j => aux_whitneySequence Psi.kernel a (11 * j + (s.1 : ℤ))) =
          aux_whitneySequence Psi.kernel (aS s) := by
      funext j
      simp [aux_whitneySequence, aS]
    rw [hseq]
    exact hmain
  have hmain := aux_kernelSequenceSeminorm_residue_le hn
    (aux_whitneySequence Psi.kernel a) hM
    (C_inductPositiveTermsReductionWhitneyGap n) hbound
  simpa [C_inductPositiveTermsReductionWhitney] using hmain

-- The explicit numerical calculation below contains powers through `2^557`.
set_option exponentiation.threshold 600 in
/--
\begin{lemma}[constant $C_{\text{P:induct-positive-terms-reduction-whitney}}$ \auto]
\label{constant Whitney reduction}
\begin{equation}\label{constant Whitney reduction bound}
C_{\text{P:induct-positive-terms-reduction-whitney}}
<2^{557}.
\end{equation}
\end{lemma}

See also [`Codex.Reduction.OnDiagonalOffDiagonal.inductPositiveTermsReductionWhitney`].
-/
theorem constantWhitneyReduction {n : ℕ} (hn : 2 ≤ n) :
    C_inductPositiveTermsReductionWhitney n < (2 : ℝ) ^ 557 := by
  unfold C_inductPositiveTermsReductionWhitney
  calc
    11 * C_inductPositiveTermsReductionWhitneyGap n <
        11 * ((127 / 128 : ℝ) * (2 : ℝ) ^ 553) :=
      mul_lt_mul_of_pos_left (constantWhitneyGapReduction hn) (by norm_num)
    _ = (1397 / 128 : ℝ) * (2 : ℝ) ^ 553 := by ring
    _ < 16 * (2 : ℝ) ^ 553 :=
      mul_lt_mul_of_pos_right (by norm_num) (by positivity)
    _ = (2 : ℝ) ^ 557 := by
      calc
        16 * (2 : ℝ) ^ 553 = (2 : ℝ) ^ 4 * (2 : ℝ) ^ 553 := by norm_num
        _ = (2 : ℝ) ^ (4 + 553) := by rw [← pow_add]
        _ = (2 : ℝ) ^ 557 := by norm_num

/-- The product-type Whitney kernel sequence. -/
noncomputable def aux_whitneyProductSequence (psi : SchwartzMap ℝ ℝ) (a : ℤ → ℝ) :
    KernelSequence 1 :=
  fun j => aux_liftPlaneKernel
    (tensorSquare (aux_windowRescale psi (a j)))

/-- The constant in the product-type Whitney reduction. -/
noncomputable def C_inductPositiveTermsReductionWhitneyProduct (n : ℕ) : ℝ :=
  (2 : ℝ) ^ 12 * C_inductPositiveTermsReductionWhitney n

/-- Auxiliary Schwartz/Fourier package for the product Whitney kernel. -/
noncomputable def aux_whitneyProduct_zeta (psi : SchwartzMap ℝ ℝ) :
    SchwartzMap ℝ ℂ :=
  FourierTransform.fourier (SchwartzMap.postcompCLM Complex.ofRealCLM psi)

theorem aux_whitneyProduct_zeta_apply (psi : SchwartzMap ℝ ℝ) (x : ℝ) :
    aux_whitneyProduct_zeta psi x =
      FourierTransform.fourier (fun y : ℝ => (psi y : ℂ)) x := by
  rw [aux_whitneyProduct_zeta, SchwartzMap.fourier_coe]
  congr 1

theorem aux_whitneyProduct_ann3_compact :
    IsCompact (aux_annulusOne 1 ((2 : ℝ) ^ 3)) := by
  apply isCompact_Icc.of_isClosed_subset
  · change IsClosed {x : ℝ | 1 / ((2 : ℝ) ^ 3) ≤ |x| ∧ |x| ≤ ((2 : ℝ) ^ 3) * 1}
    exact (isClosed_le continuous_const continuous_abs).inter
      (isClosed_le continuous_abs continuous_const)
  · intro x hx
    change 1 / ((2 : ℝ) ^ 3) ≤ |x| ∧ |x| ≤ ((2 : ℝ) ^ 3) * 1 at hx
    constructor
    · exact neg_le_of_abs_le (by norm_num at hx ⊢; exact hx.2)
    · exact le_of_abs_le (by norm_num at hx ⊢; exact hx.2)

noncomputable def aux_whitneyProduct_planeEquiv :
    EuclideanSpace ℝ (Fin 2) ≃L[ℝ] (ℝ × ℝ) :=
  (EuclideanSpace.equiv (Fin 2) ℝ).trans
    (ContinuousLinearEquiv.finTwoArrow ℝ ℝ)

theorem aux_whitneyProduct_planeEquiv_apply (u : EuclideanSpace ℝ (Fin 2)) :
    aux_whitneyProduct_planeEquiv u = (u 0, u 1) := by
  simp [aux_whitneyProduct_planeEquiv]

noncomputable def aux_whitneyProduct_zetaTensorRaw (psi : SchwartzMap ℝ ℝ) :
    EuclideanSpace ℝ (Fin 2) → ℂ :=
  fun u => aux_whitneyProduct_zeta psi (u 0) * aux_whitneyProduct_zeta psi (u 1)

theorem aux_whitneyProduct_zetaTensorRaw_compact (psi : SchwartzMap ℝ ℝ)
    (hsupport : Function.support
      (FourierTransform.fourier (fun x : ℝ => (psi x : ℂ))) ⊆
        aux_annulusOne 1 ((2 : ℝ) ^ 3)) :
    HasCompactSupport (aux_whitneyProduct_zetaTensorRaw psi) := by
  let K : Set ℝ := aux_annulusOne 1 ((2 : ℝ) ^ 3)
  let e := aux_whitneyProduct_planeEquiv
  have hK : IsCompact K := aux_whitneyProduct_ann3_compact
  have hK2 : IsCompact (e ⁻¹' (K ×ˢ K)) := by
    exact (e.toHomeomorph.isCompact_preimage).mpr (hK.prod hK)
  have hzero (x : ℝ) (hx : x ∉ K) : aux_whitneyProduct_zeta psi x = 0 := by
    apply Function.notMem_support.mp
    intro hmem
    apply hx
    apply hsupport
    have heq : (aux_whitneyProduct_zeta psi : ℝ → ℂ) =
        FourierTransform.fourier (fun y : ℝ => (psi y : ℂ)) := by
      funext y
      exact aux_whitneyProduct_zeta_apply psi y
    rw [heq] at hmem
    exact hmem
  apply HasCompactSupport.intro hK2
  intro u hu
  have hu' : ¬ (u 0 ∈ K ∧ u 1 ∈ K) := by
    intro huu
    apply hu
    simp only [Set.mem_preimage, Set.mem_prod]
    exact huu
  rw [aux_whitneyProduct_zetaTensorRaw]
  by_cases h0 : u 0 ∈ K
  · have h1 : u 1 ∉ K := fun h1 => hu' ⟨h0, h1⟩
    rw [hzero (u 1) h1]
    ring
  · rw [hzero (u 0) h0]
    ring

theorem aux_whitneyProduct_zetaTensorRaw_smooth (psi : SchwartzMap ℝ ℝ) :
    ContDiff ℝ (⊤ : ℕ∞) (aux_whitneyProduct_zetaTensorRaw psi) := by
  unfold aux_whitneyProduct_zetaTensorRaw
  fun_prop

noncomputable def aux_whitneyProduct_zetaTensor (psi : SchwartzMap ℝ ℝ)
    (hsupport : Function.support
      (FourierTransform.fourier (fun x : ℝ => (psi x : ℂ))) ⊆
        aux_annulusOne 1 ((2 : ℝ) ^ 3)) :
    SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℂ :=
  (aux_whitneyProduct_zetaTensorRaw_compact psi hsupport).toSchwartzMap
    (aux_whitneyProduct_zetaTensorRaw_smooth psi)

theorem aux_whitneyProduct_zetaTensor_apply (psi : SchwartzMap ℝ ℝ)
    (hsupport : Function.support
      (FourierTransform.fourier (fun x : ℝ => (psi x : ℂ))) ⊆
        aux_annulusOne 1 ((2 : ℝ) ^ 3))
    (u : EuclideanSpace ℝ (Fin 2)) :
    aux_whitneyProduct_zetaTensor psi hsupport u = aux_whitneyProduct_zetaTensorRaw psi u := rfl

noncomputable def aux_whitneyProduct_tensorSchwartzC (psi : SchwartzMap ℝ ℝ)
    (hsupport : Function.support
      (FourierTransform.fourier (fun x : ℝ => (psi x : ℂ))) ⊆
        aux_annulusOne 1 ((2 : ℝ) ^ 3)) :
    SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℂ :=
  FourierTransform.fourierInv (aux_whitneyProduct_zetaTensor psi hsupport)

theorem aux_whitneyProduct_tensorSchwartzC_apply (psi : SchwartzMap ℝ ℝ)
    (hsupport : Function.support
      (FourierTransform.fourier (fun x : ℝ => (psi x : ℂ))) ⊆
        aux_annulusOne 1 ((2 : ℝ) ^ 3))
    (u : EuclideanSpace ℝ (Fin 2)) :
    aux_whitneyProduct_tensorSchwartzC psi hsupport u =
      (tensorSquare psi (u 0, u 1) : ℂ) := by
  let f : EuclideanSpace ℝ (Fin 2) → ℂ :=
    fun z => (tensorSquare psi (z 0, z 1) : ℂ)
  have hfmem : MemW0 f := by
    exact aux_memW0_complex_ofReal_vanishing _
      (aux_plane_memW0 _
        (aux_memW0_tensorSquare psi (aux_schwartzMap_memW0_real psi)))
  have hf : Integrable f := aux_memW0_integrable_of_addHaar hfmem
  have hcont : Continuous f := by
    dsimp [f, tensorSquare]
    fun_prop
  have hhat : FourierTransform.fourier f = aux_whitneyProduct_zetaTensor psi hsupport := by
    funext z
    dsimp only [f, tensorSquare]
    have hcast : (fun q : EuclideanSpace ℝ (Fin 2) =>
        ((psi (q 0) * psi (q 1) : ℝ) : ℂ)) =
        fun q => (psi (q 0) : ℂ) * (psi (q 1) : ℂ) := by
      funext q
      norm_cast
    rw [hcast]
    rw [aux_fourier_tensor_two_eq]
    simp only [aux_whitneyProduct_zetaTensor_apply,
      aux_whitneyProduct_zetaTensorRaw, aux_whitneyProduct_zeta_apply]
  have hhatint : Integrable (FourierTransform.fourier f) := by
    rw [hhat]
    exact (aux_whitneyProduct_zetaTensor psi hsupport).integrable
  have hinv := hcont.fourierInv_fourier_eq hf hhatint
  change FourierTransform.fourierInv (aux_whitneyProduct_zetaTensor psi hsupport) u = f u
  rw [SchwartzMap.fourierInv_coe]
  rw [← hhat]
  exact congrFun hinv u

noncomputable def aux_whitneyProduct_tensorSchwartz (psi : SchwartzMap ℝ ℝ)
    (hsupport : Function.support
      (FourierTransform.fourier (fun x : ℝ => (psi x : ℂ))) ⊆
        aux_annulusOne 1 ((2 : ℝ) ^ 3)) :
    SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℝ :=
  SchwartzMap.postcompCLM Complex.reCLM (aux_whitneyProduct_tensorSchwartzC psi hsupport)

theorem aux_whitneyProduct_tensorSchwartz_apply (psi : SchwartzMap ℝ ℝ)
    (hsupport : Function.support
      (FourierTransform.fourier (fun x : ℝ => (psi x : ℂ))) ⊆
        aux_annulusOne 1 ((2 : ℝ) ^ 3))
    (u : EuclideanSpace ℝ (Fin 2)) :
    aux_whitneyProduct_tensorSchwartz psi hsupport u = tensorSquare psi (u 0, u 1) := by
  rw [aux_whitneyProduct_tensorSchwartz, SchwartzMap.postcompCLM_apply,
    aux_whitneyProduct_tensorSchwartzC_apply]
  simp

noncomputable def aux_whitneyProduct_productC : ℝ := (2 : ℝ) ^ (-12 : ℤ)

theorem aux_whitneyProduct_productC_pos : 0 < aux_whitneyProduct_productC := by
  exact zpow_pos (by norm_num) _

theorem aux_whitneyProduct_product_positive (psi : SchwartzMap ℝ ℝ)
    (g : ℝ → ℝ) (hg : aux_bounded g) :
    0 ≤ ∫ v : RealPlane,
      g v.1 * g v.2 * (aux_whitneyProduct_productC * tensorSquare psi v) := by
  rcases hg with ⟨hgmeas, hgbounded⟩
  rcases hgbounded.exists_norm_le with ⟨C, hC⟩
  have hgp : Integrable (fun x : ℝ => g x * psi x) := by
    have hraw : Integrable (fun x : ℝ => psi x * g x) := by
      refine psi.integrable.mul_bdd hgmeas.aestronglyMeasurable (c := C) ?_
      filter_upwards [] with x
      simpa [Real.norm_eq_abs] using hC (g x) ⟨x, rfl⟩
    simpa [mul_comm] using hraw
  let A : ℝ → ℝ := fun x => g x * psi x
  have hprod : Integrable (fun v : RealPlane => A v.1 * A v.2) := hgp.mul_prod hgp
  have hcalc :
      (∫ v : RealPlane,
        g v.1 * g v.2 * (aux_whitneyProduct_productC * tensorSquare psi v)) =
        aux_whitneyProduct_productC * (∫ x : ℝ, A x) ^ 2 := by
    have hfun : (fun v : RealPlane =>
        g v.1 * g v.2 * (aux_whitneyProduct_productC * tensorSquare psi v)) =
        fun v => aux_whitneyProduct_productC * (A v.1 * A v.2) := by
      funext v
      simp [A, tensorSquare]
      ring
    calc
      (∫ v : RealPlane,
        g v.1 * g v.2 * (aux_whitneyProduct_productC * tensorSquare psi v)) =
          aux_whitneyProduct_productC * ∫ v : RealPlane, A v.1 * A v.2 := by
            rw [hfun, integral_const_mul]
      _ = aux_whitneyProduct_productC * ((∫ x : ℝ, A x) * ∫ x : ℝ, A x) := by
            rw [show (∫ v : RealPlane, A v.1 * A v.2) =
                (∫ x : ℝ, A x) * ∫ x : ℝ, A x by
              simpa only [Measure.volume_eq_prod] using integral_prod_mul A A]
      _ = aux_whitneyProduct_productC * (∫ x : ℝ, A x) ^ 2 := by ring
  rw [hcalc]
  exact mul_nonneg aux_whitneyProduct_productC_pos.le (sq_nonneg _)

theorem aux_whitneyProduct_product_fourier_support (psi : SchwartzMap ℝ ℝ)
    (hsupport : Function.support
      (FourierTransform.fourier (fun x : ℝ => (psi x : ℂ))) ⊆
        aux_annulusOne 1 ((2 : ℝ) ^ 3)) :
    Function.support
      (aux_planeFourier (fun v => aux_whitneyProduct_productC * tensorSquare psi v)) ⊆
      {v : EuclideanSpace ℝ (Fin 2) |
        v 0 ∈ aux_annulusOne 1 ((2 : ℝ) ^ 3) ∧
        v 1 ∈ aux_annulusOne 1 ((2 : ℝ) ^ 3)} := by
  intro z hz
  have hne := Function.mem_support.mp hz
  rw [aux_planeFourier_const_mul, aux_planeFourier_tensorSquare] at hne
  have h0 : FourierTransform.fourier (fun x : ℝ => (psi x : ℂ)) (z 0) ≠ 0 := by
    intro hzero
    simp [hzero] at hne
  have h1 : FourierTransform.fourier (fun x : ℝ => (psi x : ℂ)) (z 1) ≠ 0 := by
    intro hzero
    simp [hzero] at hne
  exact ⟨hsupport (Function.mem_support.mpr h0),
    hsupport (Function.mem_support.mpr h1)⟩

theorem aux_whitneyProduct_diagonal_product_deriv_bound
    (F : ℝ → ℂ) (hF : ContDiff ℝ 2 F)
    (hbound : ∀ m : ℕ, m < 3 → ∀ x : ℝ,
      ‖iteratedDeriv m F x‖ ≤ 1)
    (m : ℕ) (hm : m < 3) (xi : ℝ) :
    ‖iteratedDeriv m (fun z : ℝ => F z * F (-z)) xi‖ ≤ 4 := by
  let G : ℝ → ℂ := fun z => F (-z)
  have hG : ContDiff ℝ 2 G := by
    dsimp [G]
    fun_prop
  have hGbound (q : ℕ) (hq : q < 3) (x : ℝ) :
      ‖iteratedDeriv q G x‖ ≤ 1 := by
    rw [show G = fun z => F (-z) by rfl, iteratedDeriv_comp_neg, norm_smul]
    have hsign : ‖(-1 : ℝ) ^ q‖ = 1 := by
      rw [norm_pow]
      norm_num
    rw [hsign, one_mul]
    exact hbound q hq (-x)
  have hAat : DifferentiableAt ℝ F xi :=
    (hF.differentiable (by norm_num)).differentiableAt
  have hBat : DifferentiableAt ℝ G xi :=
    (hG.differentiable (by norm_num)).differentiableAt
  have hA2at : ContDiffAt ℝ 2 F xi := hF.contDiffAt
  have hB2at : ContDiffAt ℝ 2 G xi := hG.contDiffAt
  have hA0 : ‖F xi‖ ≤ 1 := by
    simpa only [iteratedDeriv_zero] using hbound 0 (by omega) xi
  have hA1 : ‖deriv F xi‖ ≤ 1 := by
    simpa only [iteratedDeriv_succ, iteratedDeriv_zero] using hbound 1 (by omega) xi
  have hA2 : ‖iteratedDeriv 2 F xi‖ ≤ 1 := hbound 2 (by omega) xi
  have hB0 : ‖G xi‖ ≤ 1 := by
    simpa only [iteratedDeriv_zero] using hGbound 0 (by omega) xi
  have hB1 : ‖deriv G xi‖ ≤ 1 := by
    simpa only [iteratedDeriv_succ, iteratedDeriv_zero] using hGbound 1 (by omega) xi
  have hB2 : ‖iteratedDeriv 2 G xi‖ ≤ 1 := hGbound 2 (by omega) xi
  change ‖iteratedDeriv m (F * G) xi‖ ≤ 4
  interval_cases m
  · change ‖F xi * G xi‖ ≤ 4
    rw [norm_mul]
    calc
      ‖F xi‖ * ‖G xi‖ ≤ 1 * 1 := by gcongr
      _ ≤ 4 := by norm_num
  · rw [iteratedDeriv_succ, iteratedDeriv_zero, deriv_mul hAat hBat]
    calc
      ‖deriv F xi * G xi + F xi * deriv G xi‖ ≤
          ‖deriv F xi * G xi‖ + ‖F xi * deriv G xi‖ := norm_add_le _ _
      _ = ‖deriv F xi‖ * ‖G xi‖ + ‖F xi‖ * ‖deriv G xi‖ := by
          rw [norm_mul, norm_mul]
      _ ≤ 1 * 1 + 1 * 1 := by gcongr
      _ ≤ 4 := by norm_num
  · rw [iteratedDeriv_mul hA2at hB2at]
    norm_num [Finset.sum_range_succ]
    calc
      ‖F xi * iteratedDeriv 2 G xi + 2 * deriv F xi * deriv G xi +
          iteratedDeriv 2 F xi * G xi‖ ≤
          ‖F xi * iteratedDeriv 2 G xi‖ + ‖2 * deriv F xi * deriv G xi‖ +
            ‖iteratedDeriv 2 F xi * G xi‖ := by
              calc
                _ ≤ ‖F xi * iteratedDeriv 2 G xi + 2 * deriv F xi * deriv G xi‖ +
                    ‖iteratedDeriv 2 F xi * G xi‖ := norm_add_le _ _
                _ ≤ _ := by gcongr; exact norm_add_le _ _
      _ = ‖F xi‖ * ‖iteratedDeriv 2 G xi‖ +
          2 * ‖deriv F xi‖ * ‖deriv G xi‖ +
          ‖iteratedDeriv 2 F xi‖ * ‖G xi‖ := by
            norm_num [norm_mul]
      _ ≤ 1 * 1 + 2 * 1 * 1 + 1 * 1 := by gcongr
      _ ≤ 4 := by norm_num

theorem aux_whitneyProduct_product_diagonal_derivative (psi : SchwartzMap ℝ ℝ)
    (hderiv : ∀ m : ℕ, m < 3 → ∀ xi : ℝ,
      ‖iteratedDeriv m
        (FourierTransform.fourier (fun x : ℝ => (psi x : ℂ))) xi‖ ≤ 1)
    (m : ℕ) (hm : m < 3) (xi : ℝ) :
    ‖iteratedDeriv m
      (fun z : ℝ => aux_planeFourier
        (fun v => aux_whitneyProduct_productC * tensorSquare psi v)
        (WithLp.toLp 2 ![z, -z])) xi‖ ≤ 1 := by
  let F : ℝ → ℂ := FourierTransform.fourier (fun x : ℝ => (psi x : ℂ))
  have hF : ContDiff ℝ 2 F := by
    let psiC : SchwartzMap ℝ ℂ :=
      SchwartzMap.postcompCLM Complex.ofRealCLM psi
    have hs : ContDiff ℝ 2 (FourierTransform.fourier psiC : ℝ → ℂ) :=
      (FourierTransform.fourier psiC).smooth 2
    have hpsiC : (psiC : ℝ → ℂ) = fun y : ℝ => (psi y : ℂ) := by
      funext y
      simp [psiC, SchwartzMap.postcompCLM_apply]
    rw [SchwartzMap.fourier_coe, hpsiC] at hs
    exact hs
  have hbound : ∀ q : ℕ, q < 3 → ∀ x : ℝ,
      ‖iteratedDeriv q F x‖ ≤ 1 := by
    intro q hq x
    exact hderiv q hq x
  have hformula :
      (fun z : ℝ => aux_planeFourier
        (fun v => aux_whitneyProduct_productC * tensorSquare psi v)
        (WithLp.toLp 2 ![z, -z])) =
      fun z => (aux_whitneyProduct_productC : ℂ) * (F z * F (-z)) := by
    funext z
    rw [aux_planeFourier_const_mul, aux_planeFourier_tensorSquare]
    rfl
  rw [hformula, iteratedDeriv_const_mul_field]
  rw [norm_mul, Complex.norm_real]
  have hprod := aux_whitneyProduct_diagonal_product_deriv_bound F hF hbound m hm xi
  calc
    |aux_whitneyProduct_productC| * ‖iteratedDeriv m (fun z : ℝ => F z * F (-z)) xi‖ ≤
        aux_whitneyProduct_productC * 4 := by
          rw [abs_of_pos aux_whitneyProduct_productC_pos]
          exact mul_le_mul_of_nonneg_left hprod aux_whitneyProduct_productC_pos.le
    _ ≤ 1 := by
      norm_num [aux_whitneyProduct_productC]

theorem aux_whitneyProduct_psi_decay (psi : SchwartzMap ℝ ℝ)
    (hsupp : Function.support
      (FourierTransform.fourier (fun x : ℝ => (psi x : ℂ))) ⊆
        aux_annulusOne 1 ((2 : ℝ) ^ 3))
    (hderiv : ∀ m : ℕ, m < 3 → ∀ xi : ℝ,
      ‖iteratedDeriv m
        (FourierTransform.fourier (fun x : ℝ => (psi x : ℂ))) xi‖ ≤ 1)
    (x : ℝ) :
    |psi x| ≤ (2 : ℝ) ^ 6 * bracketBump x ^ 2 := by
  let q : ℝ → ℂ := FourierTransform.fourier (fun y : ℝ => (psi y : ℂ))
  have hqCont : ContDiff ℝ 2 q := by
    let psiC : SchwartzMap ℝ ℂ :=
      SchwartzMap.postcompCLM Complex.ofRealCLM psi
    have hs : ContDiff ℝ 2 (FourierTransform.fourier psiC : ℝ → ℂ) :=
      (FourierTransform.fourier psiC).smooth 2
    have hpsiC : (psiC : ℝ → ℂ) = fun y : ℝ => (psi y : ℂ) := by
      funext y
      simp [psiC, SchwartzMap.postcompCLM_apply]
    rw [SchwartzMap.fourier_coe, hpsiC] at hs
    exact hs
  have hqSupp : tsupport q ⊆ Set.Icc (-((2 : ℝ) ^ 3)) ((2 : ℝ) ^ 3) := by
    apply closure_minimal
    · intro xi hxi
      have hx := hsupp hxi
      change 1 / ((2 : ℝ) ^ 3) ≤ |xi| ∧ |xi| ≤ ((2 : ℝ) ^ 3) * 1 at hx
      exact abs_le.mp (by simpa using hx.2)
    · exact isClosed_Icc
  have hqzero : ∀ xi : ℝ, ‖q xi‖ ≤ 1 := by
    intro xi
    by_cases hxi : xi ∈ Set.Icc (-((2 : ℝ) ^ 3)) ((2 : ℝ) ^ 3)
    · dsimp [q]
      simpa only [iteratedDeriv_zero] using hderiv 0 (by omega) xi
    · have hqSupp' : Function.support q ⊆
          Set.Icc (-((2 : ℝ) ^ 3)) ((2 : ℝ) ^ 3) :=
        (subset_tsupport _).trans hqSupp
      have hzero : q xi = 0 := by
        apply Function.notMem_support.mp
        intro hqxi
        exact hxi (hqSupp' hqxi)
      rw [hzero, norm_zero]
      norm_num
  have hfac : ((2 * Real.pi)⁻¹ : ℝ) ^ 2 ≤ 1 := by
    have hbase : (2 * Real.pi)⁻¹ ≤ 1 := by
      exact (le_of_lt aux_inv_two_pi_lt_sixth).trans (by norm_num)
    exact pow_le_one₀ (by positivity) hbase
  have hqNth : ∀ xi : ℝ,
      ((2 * Real.pi)⁻¹ : ℝ) ^ 2 * ‖iteratedDeriv 2 q xi‖ ≤ 1 := by
    intro xi
    have hderiv' : ‖iteratedDeriv 2 q xi‖ ≤ 1 := by
      dsimp [q]
      exact hderiv 2 (by omega) xi
    calc
      ((2 * Real.pi)⁻¹ : ℝ) ^ 2 * ‖iteratedDeriv 2 q xi‖ ≤
          1 * ‖iteratedDeriv 2 q xi‖ :=
        mul_le_mul_of_nonneg_right hfac (norm_nonneg _)
      _ = ‖iteratedDeriv 2 q xi‖ := one_mul _
      _ ≤ 1 := hderiv'
  have hqCompact : HasCompactSupport q :=
    isCompact_Icc.of_isClosed_subset isClosed_closure hqSupp
  have hphiCont : Continuous (fun y : ℝ => (psi y : ℂ)) :=
    Complex.ofRealCLM.continuous.comp psi.continuous
  have hphiInt : Integrable (fun y : ℝ => (psi y : ℂ)) := psi.integrable.ofReal
  have hqInt : Integrable q := hqCont.continuous.integrable_of_hasCompactSupport hqCompact
  have hinv : FourierTransformInv.fourierInv q = fun y : ℝ => (psi y : ℂ) := by
    dsimp [q]
    exact hphiCont.fourierInv_fourier_eq hphiInt hqInt
  have hqBounded : BddAbove (Set.range fun xi : ℝ => ‖q xi‖) := by
    refine ⟨1, ?_⟩
    rintro _ ⟨xi, rfl⟩
    exact hqzero xi
  have hqscale : 0 < ((2 * Real.pi)⁻¹ : ℝ) ^ 2 := by positivity
  have hdBounded : BddAbove (Set.range fun xi : ℝ => ‖iteratedDeriv 2 q xi‖) := by
    refine ⟨1 / ((2 * Real.pi)⁻¹ : ℝ) ^ 2, ?_⟩
    rintro _ ⟨xi, rfl⟩
    apply (le_div_iff₀ hqscale).2
    calc
      ‖iteratedDeriv 2 q xi‖ * ((2 * Real.pi)⁻¹ : ℝ) ^ 2 =
          ((2 * Real.pi)⁻¹ : ℝ) ^ 2 * ‖iteratedDeriv 2 q xi‖ := by ring
      _ ≤ 1 := hqNth xi
  have hqSup : sSup (Set.range fun xi : ℝ => ‖q xi‖) ≤ 1 := by
    apply csSup_le
    · exact Set.range_nonempty _
    rintro _ ⟨xi, rfl⟩
    exact hqzero xi
  have hdSupScaled : ((2 * Real.pi)⁻¹ : ℝ) ^ 2 *
      sSup (Set.range fun xi : ℝ => ‖iteratedDeriv 2 q xi‖) ≤ 1 := by
    have hdSup : sSup (Set.range fun xi : ℝ => ‖iteratedDeriv 2 q xi‖) ≤
        1 / ((2 * Real.pi)⁻¹ : ℝ) ^ 2 := by
      apply csSup_le
      · exact Set.range_nonempty _
      rintro _ ⟨xi, rfl⟩
      apply (le_div_iff₀ hqscale).2
      calc
        ‖iteratedDeriv 2 q xi‖ * ((2 * Real.pi)⁻¹ : ℝ) ^ 2 =
            ((2 * Real.pi)⁻¹ : ℝ) ^ 2 * ‖iteratedDeriv 2 q xi‖ := by ring
        _ ≤ 1 := hqNth xi
    calc
      ((2 * Real.pi)⁻¹ : ℝ) ^ 2 *
          sSup (Set.range fun xi : ℝ => ‖iteratedDeriv 2 q xi‖) ≤
          ((2 * Real.pi)⁻¹ : ℝ) ^ 2 *
            (1 / ((2 * Real.pi)⁻¹ : ℝ) ^ 2) :=
        mul_le_mul_of_nonneg_left hdSup hqscale.le
      _ = 1 := by field_simp [ne_of_gt hqscale]
  have hmax : max (sSup (Set.range fun xi : ℝ => ‖q xi‖))
      (((2 * Real.pi)⁻¹ : ℝ) ^ 2 *
        sSup (Set.range fun xi : ℝ => ‖iteratedDeriv 2 q xi‖)) ≤ 1 :=
    max_le hqSup hdSupScaled
  have hvol : (volume (tsupport q)).toReal ≤ (2 : ℝ) ^ 4 := by
    have hmeasure : volume (tsupport q) ≤
        volume (Set.Icc (-((2 : ℝ) ^ 3)) ((2 : ℝ) ^ 3)) :=
      MeasureTheory.measure_mono hqSupp
    have hfinite : volume (Set.Icc (-((2 : ℝ) ^ 3)) ((2 : ℝ) ^ 3)) ≠ ⊤ := by
      rw [Real.volume_Icc]
      norm_num
    calc
      (volume (tsupport q)).toReal ≤
          (volume (Set.Icc (-((2 : ℝ) ^ 3)) ((2 : ℝ) ^ 3))).toReal :=
        ENNReal.toReal_mono hfinite hmeasure
      _ = (2 : ℝ) ^ 4 := by
        rw [Real.volume_Icc]
        norm_num
  have hdecay := (smoothDecay2 2 (by omega) q hqCont hqCompact).2 x
  rw [hinv] at hdecay
  change |psi x| ≤ (2 : ℝ) ^ 6 * bracketBump x ^ 2
  rw [Complex.norm_real] at hdecay
  have hbracket : 0 ≤ bracketBump x ^ 2 := by positivity
  have hCsmooth : 0 ≤ C_smoothDecay2 2 := by norm_num [C_smoothDecay2]
  have hfirst : C_smoothDecay2 2 *
      max (sSup (Set.range fun xi : ℝ => ‖q xi‖))
        (((2 * Real.pi)⁻¹ : ℝ) ^ 2 *
          sSup (Set.range fun xi : ℝ => ‖iteratedDeriv 2 q xi‖)) ≤
        C_smoothDecay2 2 * 1 :=
    mul_le_mul_of_nonneg_left hmax hCsmooth
  have hsecond : (C_smoothDecay2 2 *
      max (sSup (Set.range fun xi : ℝ => ‖q xi‖))
        (((2 * Real.pi)⁻¹ : ℝ) ^ 2 *
          sSup (Set.range fun xi : ℝ => ‖iteratedDeriv 2 q xi‖))) *
        (volume (tsupport q)).toReal ≤
      (C_smoothDecay2 2 * 1) * (2 : ℝ) ^ 4 :=
    mul_le_mul hfirst hvol ENNReal.toReal_nonneg (mul_nonneg hCsmooth zero_le_one)
  calc
    |psi x| ≤ C_smoothDecay2 2 *
        max (sSup (Set.range fun xi : ℝ => ‖q xi‖))
          (((2 * Real.pi)⁻¹ : ℝ) ^ 2 *
            sSup (Set.range fun xi : ℝ => ‖iteratedDeriv 2 q xi‖)) *
          (volume (tsupport q)).toReal * bracketBump x ^ 2 := hdecay
    _ ≤ C_smoothDecay2 2 * 1 * ((2 : ℝ) ^ 4) * bracketBump x ^ 2 := by
      exact mul_le_mul_of_nonneg_right hsecond hbracket
    _ = (2 : ℝ) ^ 6 * bracketBump x ^ 2 := by
      norm_num [C_smoothDecay2]

theorem aux_whitneyProduct_bracket_sq_eq_scaled_two (x : ℝ) :
    bracketBump x ^ 2 = scaledBracketBumpReal 2 1 x := by
  unfold bracketBump scaledBracketBumpReal
  norm_num only [inv_one, one_mul]
  calc
    (1 + |x|)⁻¹ ^ 2 = ((1 + |x|) ^ 2)⁻¹ := inv_pow _ _
    _ = (Real.rpow (1 + |x|) (2 : ℝ))⁻¹ :=
      congrArg Inv.inv (Real.rpow_natCast (1 + |x|) 2).symm
    _ = Real.rpow (1 + |x|) (-(2 : ℝ)) :=
      (Real.rpow_neg (by positivity) _).symm

theorem aux_whitneyProduct_bracket_sq_le_scaled_three_halves (x : ℝ) :
    bracketBump x ^ 2 ≤ scaledBracketBumpReal (3 / 2 : ℝ) 1 x := by
  rw [aux_whitneyProduct_bracket_sq_eq_scaled_two]
  exact aux_scaledBracketBumpReal_exponent_reduce (3 / 2 : ℝ) 2 1 x
    (by norm_num) (by norm_num)

theorem aux_whitneyProduct_product_decay (psi : SchwartzMap ℝ ℝ)
    (hsupp : Function.support
      (FourierTransform.fourier (fun x : ℝ => (psi x : ℂ))) ⊆
        aux_annulusOne 1 ((2 : ℝ) ^ 3))
    (hderiv : ∀ m : ℕ, m < 3 → ∀ xi : ℝ,
      ‖iteratedDeriv m
        (FourierTransform.fourier (fun x : ℝ => (psi x : ℂ))) xi‖ ≤ 1)
    (v : RealPlane) :
    |aux_whitneyProduct_productC * tensorSquare psi v| ≤
      ∑ u : Fin 2,
        scaledBracketBumpReal (3 / 2 : ℝ) 1 ((W u v).1) *
          scaledBracketBumpReal (3 / 2 : ℝ) 1 ((W u v).2) := by
  have h0 := aux_whitneyProduct_psi_decay psi hsupp hderiv v.1
  have h1 := aux_whitneyProduct_psi_decay psi hsupp hderiv v.2
  have hb0 : 0 ≤ bracketBump v.1 ^ 2 := by positivity
  have hb1 : 0 ≤ bracketBump v.2 ^ 2 := by positivity
  have hterm0 : bracketBump v.1 ^ 2 * bracketBump v.2 ^ 2 ≤
      scaledBracketBumpReal (3 / 2 : ℝ) 1 v.1 *
        scaledBracketBumpReal (3 / 2 : ℝ) 1 v.2 := by
    exact mul_le_mul (aux_whitneyProduct_bracket_sq_le_scaled_three_halves v.1)
      (aux_whitneyProduct_bracket_sq_le_scaled_three_halves v.2)
      hb1 (aux_scaledBracketBumpReal_nonneg _ _ _ (by norm_num))
  have hterm1nonneg : 0 ≤
      scaledBracketBumpReal (3 / 2 : ℝ) 1 ((W (1 : Fin 2) v).1) *
        scaledBracketBumpReal (3 / 2 : ℝ) 1 ((W (1 : Fin 2) v).2) :=
    mul_nonneg (aux_scaledBracketBumpReal_nonneg _ _ _ (by norm_num))
      (aux_scaledBracketBumpReal_nonneg _ _ _ (by norm_num))
  rw [abs_mul, abs_of_pos aux_whitneyProduct_productC_pos, tensorSquare, abs_mul]
  calc
    aux_whitneyProduct_productC * (|psi v.1| * |psi v.2|) ≤
        aux_whitneyProduct_productC *
          (((2 : ℝ) ^ 6 * bracketBump v.1 ^ 2) *
            ((2 : ℝ) ^ 6 * bracketBump v.2 ^ 2)) := by
          apply mul_le_mul_of_nonneg_left
          · exact mul_le_mul h0 h1 (abs_nonneg _) (mul_nonneg (by positivity) hb0)
          · exact aux_whitneyProduct_productC_pos.le
    _ = bracketBump v.1 ^ 2 * bracketBump v.2 ^ 2 := by
          norm_num [aux_whitneyProduct_productC]
          ring
    _ ≤ scaledBracketBumpReal (3 / 2 : ℝ) 1 v.1 *
          scaledBracketBumpReal (3 / 2 : ℝ) 1 v.2 := hterm0
    _ = scaledBracketBumpReal (3 / 2 : ℝ) 1 ((W (0 : Fin 2) v).1) *
          scaledBracketBumpReal (3 / 2 : ℝ) 1 ((W (0 : Fin 2) v).2) := by
          simp [W]
    _ ≤ ∑ u : Fin 2,
        scaledBracketBumpReal (3 / 2 : ℝ) 1 ((W u v).1) *
          scaledBracketBumpReal (3 / 2 : ℝ) 1 ((W u v).2) := by
          rw [Fin.sum_univ_two]
          exact le_add_of_nonneg_right hterm1nonneg

noncomputable def aux_whitneyProduct_productData (psi : SchwartzMap ℝ ℝ)
    (hsupport : Function.support
      (FourierTransform.fourier (fun x : ℝ => (psi x : ℂ))) ⊆
        aux_annulusOne 1 ((2 : ℝ) ^ 3))
    (hderiv : ∀ m : ℕ, m < 3 → ∀ xi : ℝ,
      ‖iteratedDeriv m
        (FourierTransform.fourier (fun x : ℝ => (psi x : ℂ))) xi‖ ≤ 1)
    (hpsi : psi ≠ 0) : WhitneyKernelData where
  kernel := fun v => aux_whitneyProduct_productC * tensorSquare psi v
  kernel_schwartz := aux_whitneyProduct_productC • aux_whitneyProduct_tensorSchwartz psi hsupport
  kernel_schwartz_eq := by
    intro u
    rw [smul_apply, aux_whitneyProduct_tensorSchwartz_apply]
    simp [smul_eq_mul]
  kernel_memW0 := by
    exact aux_memW0_const_mul_nonneg
      (aux_memW0_tensorSquare psi (aux_schwartzMap_memW0_real psi))
      aux_whitneyProduct_productC aux_whitneyProduct_productC_pos.le
  kernel_nonzero := by
    intro hzero
    apply hpsi
    ext x
    have hx : aux_whitneyProduct_productC * (psi x * psi x) = 0 := by
      simpa [tensorSquare] using congrFun hzero (x, x)
    have hsq : psi x * psi x = 0 :=
      (mul_eq_zero.mp hx).resolve_left aux_whitneyProduct_productC_pos.ne'
    exact mul_self_eq_zero.mp hsq
  symmetric := by
    intro v
    simp [tensorSquare, mul_comm]
  positive := by
    intro g hg
    exact aux_whitneyProduct_product_positive psi g hg
  fourier_support := aux_whitneyProduct_product_fourier_support psi hsupport
  diagonal_derivative := aux_whitneyProduct_product_diagonal_derivative psi hderiv
  decay := aux_whitneyProduct_product_decay psi hsupport hderiv

/-- Generic positive tensor-product package for the ordinary Whitney reduction.
The caller supplies only the two problem-specific analytic fields. -/
noncomputable def aux_tensorWhitneyData
    (psi : SchwartzMap ℝ ℝ)
    (hsupport : Function.support
      (FourierTransform.fourier (fun x : ℝ => (psi x : ℂ))) ⊆
        aux_annulusOne 1 ((2 : ℝ) ^ 3))
    (c : ℝ) (hc : 0 < c) (hpsi : psi ≠ 0)
    (hdiag : ∀ m : ℕ, m < 3 → ∀ xi : ℝ,
      ‖iteratedDeriv m
        (fun z : ℝ => aux_planeFourier (fun v => c * tensorSquare psi v)
          (WithLp.toLp 2 ![z, -z])) xi‖ ≤ 1)
    (hdecay : ∀ v : RealPlane,
      |c * tensorSquare psi v| ≤
        ∑ u : Fin 2,
          scaledBracketBumpReal (3 / 2 : ℝ) 1 ((W u v).1) *
            scaledBracketBumpReal (3 / 2 : ℝ) 1 ((W u v).2)) :
    WhitneyKernelData where
  kernel := fun v => c * tensorSquare psi v
  kernel_schwartz := c • aux_whitneyProduct_tensorSchwartz psi hsupport
  kernel_schwartz_eq := by
    intro u
    rw [smul_apply, aux_whitneyProduct_tensorSchwartz_apply]
    simp [smul_eq_mul]
  kernel_memW0 := by
    exact aux_memW0_const_mul_nonneg
      (aux_memW0_tensorSquare psi (aux_schwartzMap_memW0_real psi)) c hc.le
  kernel_nonzero := by
    intro hzero
    apply hpsi
    ext x
    have hx : c * (psi x * psi x) = 0 := by
      simpa [tensorSquare] using congrFun hzero (x, x)
    have hsq : psi x * psi x = 0 :=
      (mul_eq_zero.mp hx).resolve_left hc.ne'
    exact mul_self_eq_zero.mp hsq
  symmetric := by
    intro v
    simp [tensorSquare, mul_comm]
  positive := by
    intro g hg
    let p : ℝ := aux_whitneyProduct_productC
    have hp : 0 < p := aux_whitneyProduct_productC_pos
    have hbase : 0 ≤ ∫ v : RealPlane,
        g v.1 * g v.2 * (p * tensorSquare psi v) := by
      exact aux_whitneyProduct_product_positive psi g hg
    have hfun : (fun v : RealPlane =>
        g v.1 * g v.2 * (c * tensorSquare psi v)) =
        fun v => (c / p) * (g v.1 * g v.2 * (p * tensorSquare psi v)) := by
      funext v
      field_simp [hp.ne']
    rw [hfun, integral_const_mul]
    exact mul_nonneg (div_nonneg hc.le hp.le) hbase
  fourier_support := by
    intro z hz
    have hne := Function.mem_support.mp hz
    rw [aux_planeFourier_const_mul, aux_planeFourier_tensorSquare] at hne
    have h0 : FourierTransform.fourier (fun x : ℝ => (psi x : ℂ)) (z 0) ≠ 0 := by
      intro hzero
      simp [hzero] at hne
    have h1 : FourierTransform.fourier (fun x : ℝ => (psi x : ℂ)) (z 1) ≠ 0 := by
      intro hzero
      simp [hzero] at hne
    exact ⟨hsupport (Function.mem_support.mpr h0),
      hsupport (Function.mem_support.mpr h1)⟩
  diagonal_derivative := hdiag
  decay := hdecay

theorem aux_whitneyProduct_product_sequence_eq (psi : SchwartzMap ℝ ℝ)
    (hsupport : Function.support
      (FourierTransform.fourier (fun x : ℝ => (psi x : ℂ))) ⊆
        aux_annulusOne 1 ((2 : ℝ) ^ 3))
    (hderiv : ∀ m : ℕ, m < 3 → ∀ xi : ℝ,
      ‖iteratedDeriv m
        (FourierTransform.fourier (fun x : ℝ => (psi x : ℂ))) xi‖ ≤ 1)
    (hpsi : psi ≠ 0) (a : ℤ → ℝ) :
    aux_whitneyProductSequence psi a =
      fun j y => (2 : ℝ) ^ 12 *
        aux_whitneySequence
          (aux_whitneyProduct_productData psi hsupport hderiv hpsi).kernel a j y := by
  funext j y
  simp only [aux_whitneyProductSequence, aux_whitneySequence, aux_liftPlaneKernel,
    aux_planeRescale, aux_whitneyProduct_productData]
  change (a j)⁻¹ * psi ((a j)⁻¹ * y.1 0) *
      ((a j)⁻¹ * psi ((a j)⁻¹ * y.2 0)) =
    (2 : ℝ) ^ 12 * ((a j)⁻¹ ^ 2 *
      (aux_whitneyProduct_productC * (psi ((a j)⁻¹ * y.1 0) * psi ((a j)⁻¹ * y.2 0))) )
  norm_num [aux_whitneyProduct_productC]
  ring

theorem aux_whitneyProduct_kernelSequenceSeminorm_zero {n k : ℕ}
    (hk : 1 ≤ k) (hkn : k ≤ n) :
    kernelSequenceSeminorm n k hk hkn (0 : KernelSequence k) = 0 := by
  unfold kernelSequenceSeminorm
  simp [prismForm, mToK, prismBrascampLiebForm]

theorem aux_whitneyProduct_whitneyProductSequence_zero (a : ℤ → ℝ) :
    aux_whitneyProductSequence (0 : SchwartzMap ℝ ℝ) a = 0 := by
  funext j y
  simp [aux_whitneyProductSequence, aux_liftPlaneKernel, aux_windowRescale,
    tensorSquare]


/--
\begin{proposition}[induct positive terms - reduction variant, Whitney, product-type]
\label{P:induct-positive-terms-reduction-whitney-product}
Let $a\in A$ and let
\begin{equation}\label{auto:Whitney-product-kernel}
M_j=(\psi_{(a(j))})^{\otimes2}
\end{equation}
for $j\in\Z$, where $\psi:\R\to\R$ is a Schwartz function satisfying
\begin{equation}\label{1-on-W_supp}
\operatorname{supp}(\widehat\psi)\subset\operatorname{Ann}_1(1,2^3),
\end{equation}
\begin{equation}\label{auto:Whitney-product-Fourier-derivative-assumption}
|\widehat\psi^{(m)}(\xi)|\le1,
\qquad
m\in[3),
\quad
\xi\in\R.
\end{equation}
Then, with $\M=(M_j)_{j\in\Z}$,
\begin{equation}\label{auto:Whitney-product-reduction-bound}
\|\M\|_{{\rm M}(1)}\le C_{\text{P:induct-positive-terms-reduction-whitney-product}},
\end{equation}
where
\begin{equation}\label{auto:Whitney-product-constant-definition}
C_{\text{P:induct-positive-terms-reduction-whitney-product}}
=2^{12}C_{\text{P:induct-positive-terms-reduction-whitney}}.
\end{equation}
\end{proposition}

See also [`Codex.Reduction.OnDiagonalOffDiagonal.inductPositiveTermsReductionWhitneyProduct`],
[`Codex.Reduction.OnDiagonalOffDiagonal.inductPositiveTermsReductionWhitney`].
-/
theorem inductPositiveTermsReductionWhitneyProduct {n : ℕ} (hn : 2 ≤ n)
    (a : ℤ → ℝ) (ha : SpacedSequence a) (psi : SchwartzMap ℝ ℝ)
    (hsupport : Function.support
      (FourierTransform.fourier (fun x : ℝ => (psi x : ℂ))) ⊆
        aux_annulusOne 1 ((2 : ℝ) ^ 3))
    (hderiv : ∀ m : ℕ, m < 3 → ∀ xi : ℝ,
      ‖iteratedDeriv m (FourierTransform.fourier (fun x : ℝ => (psi x : ℂ))) xi‖ ≤ 1) :
    kernelSequenceSeminorm n 1 (by omega) (by omega)
      (aux_whitneyProductSequence psi a) ≤
        ENNReal.ofReal (C_inductPositiveTermsReductionWhitneyProduct n) := by
  by_cases hpsi : psi = 0
  · subst psi
    rw [aux_whitneyProduct_whitneyProductSequence_zero a,
      aux_whitneyProduct_kernelSequenceSeminorm_zero]
    exact bot_le
  · obtain ⟨phi0, phi1, hpair⟩ := existsUniversalPair
    let Psi := aux_whitneyProduct_productData psi hsupport hderiv hpsi
    have hordinary := inductPositiveTermsReductionWhitney hn a ha phi0 phi1 hpair Psi
    rw [aux_whitneyProduct_product_sequence_eq psi hsupport hderiv hpsi a,
      aux_kernelSequenceSeminorm_const_mul (by omega) (by omega)
        ((2 : ℝ) ^ 12) (by positivity)]
    calc
      ENNReal.ofReal ((2 : ℝ) ^ 12) *
          kernelSequenceSeminorm n 1 (by omega) (by omega)
            (aux_whitneySequence Psi.kernel a) ≤
          ENNReal.ofReal ((2 : ℝ) ^ 12) *
            ENNReal.ofReal (C_inductPositiveTermsReductionWhitney n) := by
              exact mul_le_mul_of_nonneg_left hordinary bot_le
      _ = ENNReal.ofReal (C_inductPositiveTermsReductionWhitneyProduct n) := by
            rw [← ENNReal.ofReal_mul (by positivity)]
            rfl



/--
\begin{lemma}[constant $C_{\text{P:induct-positive-terms-reduction-whitney-product}}$ \auto]
\label{constant Whitney product reduction}
\begin{equation}\label{constant Whitney product reduction bound}
C_{\text{P:induct-positive-terms-reduction-whitney-product}}
<2^{569}.
\end{equation}
\end{lemma}

See also [`Codex.Reduction.OnDiagonalOffDiagonal.inductPositiveTermsReductionWhitneyProduct`].
-/
theorem constantWhitneyProductReduction {n : ℕ} (hn : 2 ≤ n) :
    C_inductPositiveTermsReductionWhitneyProduct n < (2 : ℝ) ^ 569 := by
  unfold C_inductPositiveTermsReductionWhitneyProduct
  calc
    (2 : ℝ) ^ 12 * C_inductPositiveTermsReductionWhitney n <
        (2 : ℝ) ^ 12 * (2 : ℝ) ^ 557 :=
      mul_lt_mul_of_pos_left (constantWhitneyReduction hn) (by positivity)
    _ = (2 : ℝ) ^ (12 + 557) := by rw [← pow_add]
    _ = (2 : ℝ) ^ 569 := by norm_num

end

