        Real.rpow 2 (-((x.1.natAbs : ℕ) : ℝ) / 2) *
          (1 + (x.1.natAbs : ℝ)) ^ (2 : ℕ)) ≤ (2 : ℝ) ^ (10 : ℕ) * D := by
    rw [aux_lMultiplier_truncation_decomp γ M hDM,
