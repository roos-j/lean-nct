          (1 + (x.1.natAbs : ℝ)) ^ (2 : ℕ) ≤ (2 : ℝ) ^ (10 : ℕ) * D := by
  have hneg := aux_sum_half_weight_neg_le N
  have hvert := aux_sum_vertical_one_le D hD
  have hpos := aux_sum_half_weight_pos_le N
  calc
    (∑ x ∈ aux_lMultiplierNegIndices N,
