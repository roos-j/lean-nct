private theorem aux_sum_multiplier_blocks_half_le (N D : ℕ) (hD : 1 ≤ D) :
    (∑ x ∈ aux_lMultiplierNegIndices N,
      Real.rpow 2 (-((x.1.natAbs : ℕ) : ℝ) / 2) *
