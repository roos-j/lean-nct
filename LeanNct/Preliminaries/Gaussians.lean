  have hpine : Real.pi ≠ 0 := ne_of_gt Real.pi_pos
  have hsqrtne : Real.sqrt Real.pi ≠ 0 := ne_of_gt (Real.sqrt_pos.2 Real.pi_pos)
  have hmoment : 12 * Real.pi ^ 2 * (2 * Real.pi)⁻¹ = 6 * Real.pi := by
