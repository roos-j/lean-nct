      have habsquad : |x| ≤ x ^ 2 + 1 / 4 := by
        rw [← sq_abs x]
        nlinarith [sq_nonneg (|x| - (1 / 2 : ℝ))]
      rw [Real.norm_eq_abs, auxiliaryFunctionBSecondDerivative, if_neg hx0]
      calc
        |((4 * Real.pi ^ 2 * x ^ 2 - 2 * Real.pi) * gaussian x) /
