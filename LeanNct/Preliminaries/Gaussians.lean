    filter_upwards [] with x
    simp only [Pi.add_apply]
  have hmoment_integral :
      (∫ x : ℝ, 12 * Real.pi ^ 2 * x ^ 2 * gaussian x) =
        12 * Real.pi ^ 2 * (∫ x : ℝ, x ^ 2 * gaussian x) := by
