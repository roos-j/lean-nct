theorem aux_one_sub_gaussian_nonneg (x : ℝ) : 0 ≤ 1 - gaussian x := by
  rw [show gaussian x = Real.exp (-Real.pi * x ^ 2) by rfl]
  apply sub_nonneg.mpr
  apply Real.exp_le_one_iff.mpr
  nlinarith [Real.pi_pos, sq_nonneg x]

