  have hpi : Real.pi ≤ 63 / 20 := by nlinarith [Real.pi_lt_d2]
  have hsqrt : Real.sqrt Real.pi ≤ 9 / 5 := by
    calc
      Real.sqrt Real.pi ≤ Real.sqrt ((9 / 5 : ℝ) ^ 2) :=
        Real.sqrt_le_sqrt (by nlinarith)
