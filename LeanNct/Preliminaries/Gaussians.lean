    have hquot := aux_BSecondGaussianPart_abs_le_outer hxhalf
    have habel_nonneg : 0 ≤ Real.pi * Real.exp (-|Real.sqrt Real.pi * x|) := by
      positivity
    have habel : Real.pi * Real.exp (-|Real.sqrt Real.pi * x|) ≤
