theorem aux_BSecondSharpMajorant_integral_le_fiftySix :
    (∫ x : ℝ,
      26 * (Set.Icc (-(1 / 2 : ℝ)) (1 / 2)).indicator (fun _ : ℝ => (1 : ℝ)) x +
