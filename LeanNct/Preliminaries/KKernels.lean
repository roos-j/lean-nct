/--
Auxiliary product-coordinate permutation.  The measure-parametric statement
is the form that composes without any ambiguity between product and Borel
measure-space instances in affine changes of variables.
-/
theorem aux_volume_preserving_prod_swap {E F : Type*}
    [MeasurableSpace E] [MeasurableSpace F] (μ : Measure E) (ν : Measure F)
    [SFinite μ] [SFinite ν] :
    MeasurePreserving (Prod.swap : E × F → F × E) (μ.prod ν) (ν.prod μ) :=
  Measure.measurePreserving_swap

/--
Auxiliary determinant-one cube change of variables
`(y^0,y^1) \mapsto (y^0,y^1-y^0)`.  It is the first affine step in the
cube Brascamp--Lieb estimate.
-/
def aux_cubeDifferenceEquiv (d : ℕ) :
    RealVector d × RealVector d ≃ᵐ RealVector d × RealVector d where
  toFun y := (y.1, y.2 - y.1)
  invFun y := (y.1, y.1 + y.2)
  left_inv y := by
    apply Prod.ext <;> simp
  right_inv y := by
    apply Prod.ext <;> simp
  measurable_toFun := (continuous_fst.prodMk (continuous_snd.sub continuous_fst)).measurable
  measurable_invFun := (continuous_fst.prodMk (continuous_fst.add continuous_snd)).measurable

/--
The inverse determinant-one cube change of variables
`(y^0,u) \mapsto (y^0,y^0+u)`, used to restore the original cube coordinates.
-/
theorem aux_measurePreserving_cubeDifference_symm (d : ℕ) :
    MeasurePreserving
      (fun y : RealVector d × RealVector d => (y.1, y.1 + y.2))
      ((volume : Measure (RealVector d)).prod (volume : Measure (RealVector d)))
      ((volume : Measure (RealVector d)).prod (volume : Measure (RealVector d))) := by
  simpa [add_comm] using
    (measurePreserving_prod_add_right (volume : Measure (RealVector d))
      (volume : Measure (RealVector d)))

/--
Auxiliary product extension of the cube shear.  It transports the full
`(y⁰,y¹,x)` integration space in the cube Brascamp--Lieb proof.
-/
theorem aux_measurePreserving_cubeDifferenceProd (d r : ℕ) :
    MeasurePreserving
      (fun p : (RealVector d × RealVector d) × RealVector r =>
        ((p.1.1, p.1.1 + p.1.2), p.2)) volume volume := by
  change MeasurePreserving
    (Prod.map (fun y : RealVector d × RealVector d => (y.1, y.1 + y.2)) id)
      volume volume
  simpa only [Measure.volume_eq_prod] using
    (aux_measurePreserving_cubeDifference_symm d).prod
      (MeasurePreserving.id (volume : Measure (RealVector r)))

/--
Auxiliary measurable equivalence that reorders `(u,(y⁰,x))` as
`((y⁰,u),x)`.  It is the final Fubini-coordinate rearrangement in the cube
Brascamp--Lieb estimate.
-/
noncomputable def aux_cubeReorderEquiv (d r : ℕ) :
    RealVector d × (RealVector d × RealVector r) ≃ᵐ
      (RealVector d × RealVector d) × RealVector r :=
  MeasurableEquiv.prodAssoc.symm.trans
    (MeasurableEquiv.prodCongr MeasurableEquiv.prodComm (MeasurableEquiv.refl _))

/-- The literal coordinate formula for the cube Fubini rearrangement. -/
theorem aux_cubeReorderEquiv_apply (d r : ℕ)
    (u : RealVector d) (y : RealVector d) (x : RealVector r) :
    aux_cubeReorderEquiv d r (u, (y, x)) = ((y, u), x) := rfl

/-- Haar preservation of the three-factor cube Fubini rearrangement. -/
theorem aux_measurePreserving_cubeReorder (d r : ℕ) :
    MeasurePreserving (aux_cubeReorderEquiv d r) volume volume := by
  have hassoc : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        RealVector d × (RealVector d × RealVector r) ≃ᵐ
          (RealVector d × RealVector d) × RealVector r) volume volume :=
    (volume_preserving_prodAssoc (α₁ := RealVector d) (β₁ := RealVector d)
      (γ₁ := RealVector r)).symm
  have hswap : MeasurePreserving
      (MeasurableEquiv.prodCongr
        (MeasurableEquiv.prodComm : RealVector d × RealVector d ≃ᵐ
          RealVector d × RealVector d)
        (MeasurableEquiv.refl (RealVector r))) volume volume := by
    change MeasurePreserving
      (Prod.map (Prod.swap : RealVector d × RealVector d → RealVector d × RealVector d)
        (id : RealVector r → RealVector r)) volume volume
    simpa only [Measure.volume_eq_prod] using
      (aux_volume_preserving_prod_swap
        (volume : Measure (RealVector d)) (volume : Measure (RealVector d))).prod
        (MeasurePreserving.id (volume : Measure (RealVector r)))
  change MeasurePreserving
    ((MeasurableEquiv.prodCongr
      (MeasurableEquiv.prodComm : RealVector d × RealVector d ≃ᵐ
        RealVector d × RealVector d)
      (MeasurableEquiv.refl (RealVector r))) ∘ MeasurableEquiv.prodAssoc.symm)
      volume volume
  exact hswap.comp hassoc

/--
Auxiliary invertible-linear part of the finite-dimensional affine changes of variables used in
the cube and prism estimates.  The result packages the radius comparison required by `MemW0`.
-/
theorem aux_memW0_comp_continuousLinearEquiv {E F K : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] [ProperSpace E]
    [MeasureSpace E] [BorelSpace E] [Measure.IsAddHaarMeasure (volume : Measure E)]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F] [ProperSpace F]
    [MeasureSpace F] [BorelSpace F] [Measure.IsAddHaarMeasure (volume : Measure F)]
    [NormedAddCommGroup K] {f : F → K} (hf : MemW0 f) (e : E ≃L[ℝ] F) :
    MemW0 (f ∘ e) := by
  apply hf.aux_comp_continuousLinearEquiv_between_of_integrable_radius e
  exact aux_integrable_wienerEnvelope_of_integrable' hf.aux_continuous zero_lt_one
    (norm_nonneg e.toContinuousLinearMap) hf.aux_integrable_envelope

/-- Auxiliary `L¹` consequence of `MemW0` for arbitrary finite-dimensional Haar spaces. -/
theorem aux_memW0_integrable_of_addHaar {E K : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] [ProperSpace E]
    [MeasureSpace E] [BorelSpace E] [Measure.IsAddHaarMeasure (volume : Measure E)]
    [NormedAddCommGroup K] {f : E → K} (hf : MemW0 f) : Integrable f := by
  refine hf.2.mono hf.1.aestronglyMeasurable (ae_of_all _ fun x => ?_)
  simpa only [Real.norm_eq_abs,
    abs_of_nonneg (aux_wienerEnvelope_nonneg hf.1 zero_le_one x)] using
    aux_norm_le_wienerEnvelope hf.1 zero_le_one x

/--
Auxiliary closure of `W₀` under the absolute value.  It is used to form the
positive measures occurring in the Cauchy--Schwarz steps without changing the
local Wiener envelope.
-/
theorem aux_memW0_abs {E : Type*} [NormedAddCommGroup E] [ProperSpace E]
    [MeasureSpace E] [BorelSpace E] {f : E → ℝ} (hf : MemW0 f) :
    MemW0 (fun x => |f x|) := by
  refine ⟨hf.1.abs, ?_⟩
  have hEnvelope : wienerEnvelope (fun x => |f x|) 1 = wienerEnvelope f 1 := by
    funext x
    simp [wienerEnvelope, Real.norm_eq_abs]
  rw [hEnvelope]
  exact hf.2

/--
Auxiliary closure of `W₀` under addition.  This is used for the finite sums
over the manuscript's kernel index sets.
-/
theorem aux_memW0_add {E : Type*} [NormedAddCommGroup E] [ProperSpace E]
    [MeasureSpace E] [BorelSpace E] {f g : E → ℝ} (hf : MemW0 f) (hg : MemW0 g) :
    MemW0 (fun x => f x + g x) := by
  let hcont : Continuous (fun x : E => f x + g x) := hf.1.add hg.1
  refine ⟨hcont, ?_⟩
  have hsum : Integrable (fun x : E => wienerEnvelope f 1 x + wienerEnvelope g 1 x) :=
    hf.2.add hg.2
  refine hsum.mono_nonneg (continuous_wienerEnvelope hcont 1).aestronglyMeasurable
    (ae_of_all _ fun x => aux_wienerEnvelope_nonneg hcont zero_le_one x)
    (ae_of_all _ fun x => ?_)
  unfold wienerEnvelope
  apply csSup_le ((Metric.nonempty_closedBall.mpr zero_le_one).image _)
  rintro _ ⟨z, hz, rfl⟩
  change ‖f (x + z) + g (x + z)‖ ≤
    sSup ((fun w : E => ‖f (x + w)‖) '' closedBall 0 1) +
      sSup ((fun w : E => ‖g (x + w)‖) '' closedBall 0 1)
  calc
    ‖f (x + z) + g (x + z)‖ ≤ ‖f (x + z)‖ + ‖g (x + z)‖ := norm_add_le _ _
    _ ≤ sSup ((fun w : E => ‖f (x + w)‖) '' closedBall 0 1) +
        sSup ((fun w : E => ‖g (x + w)‖) '' closedBall 0 1) :=
      add_le_add
        (aux_norm_le_wienerEnvelope_of_mem_closedBall hf.1 (by
          simpa [Metric.mem_closedBall, dist_eq_norm] using hz))
        (aux_norm_le_wienerEnvelope_of_mem_closedBall hg.1 (by
          simpa [Metric.mem_closedBall, dist_eq_norm] using hz))

/--
Auxiliary finite-sum closure of `W₀`, used for the manuscript's finite sums
of kernel pieces.
-/
theorem aux_memW0_finset_sum {E ι : Type*} [NormedAddCommGroup E] [ProperSpace E]
    [MeasureSpace E] [BorelSpace E] (s : Finset ι) (f : ι → E → ℝ)
    (hf : ∀ i ∈ s, MemW0 (f i)) :
    MemW0 (fun x => ∑ i ∈ s, f i x) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      refine ⟨continuous_zero, ?_⟩
      change Integrable (wienerEnvelope (fun _ : E => (0 : ℝ)) 1)
      have hzeroEnv : wienerEnvelope (fun _ : E => (0 : ℝ)) 1 = 0 := by
        funext x
        simp [wienerEnvelope]
      rw [hzeroEnv]
      exact integrable_zero E ℝ (volume : Measure E)
  | insert a s ha hs =>
      have hrest : MemW0 (fun x => ∑ i ∈ s, f i x) := by
        apply hs
        intro i hi
        exact hf i (Finset.mem_insert_of_mem hi)
      have hadd := aux_memW0_add (hf a (Finset.mem_insert_self _ _)) hrest
      convert hadd using 1
      funext x
      rw [Finset.sum_insert ha]

/--
Auxiliary continuity statement for integration along a coordinate fibre of a finite-dimensional
real Haar space.  It supplies the continuity part of the affine fibre-integration step used by
the kernel estimates.
-/
theorem aux_continuous_integral_slice_of_addHaar {E F K : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] [ProperSpace E]
    [MeasureSpace E] [BorelSpace E] [SFinite (volume : Measure E)]
    [Measure.IsAddHaarMeasure (volume : Measure E)]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F] [ProperSpace F]
    [MeasureSpace F] [BorelSpace F] [SFinite (volume : Measure F)]
    [Measure.IsAddHaarMeasure (volume : Measure F)]
    [NormedAddCommGroup K] [NormedSpace ℝ K] {f : E × F → K} (hf : MemW0 f) :
    Continuous (fun u : E => ∫ v, f (u, v)) := by
  rw [continuous_iff_continuousAt]
  intro u₀
  have hgood_ae : ∀ᵐ u' ∂(volume : Measure E),
      Integrable (fun v => wienerEnvelope f 1 (u', v)) := by
    exact hf.2.prod_right_ae
  obtain ⟨u', hu', hu'good⟩ := Measure.exists_mem_of_measure_ne_zero_of_ae
    (s := ball u₀ (1 / 2))
    ((measure_ball_pos (volume : Measure E) u₀ (by norm_num)).ne')
    (ae_restrict_of_ae hgood_ae)
  apply tendsto_integral_filter_of_dominated_convergence
    (fun v => wienerEnvelope f 1 (u', v))
  · filter_upwards [] with u
    exact (hf.1.comp (continuous_const.prodMk continuous_id)).aestronglyMeasurable
  · filter_upwards [Metric.ball_mem_nhds u₀ (by norm_num : 0 < (1 / 2 : ℝ))] with u hu
    filter_upwards [] with v
    apply aux_norm_le_wienerEnvelope_of_mem_closedBall hf.1
    apply Metric.mem_closedBall.mpr
    rw [Prod.dist_eq]
    apply max_le
    · change dist u u' ≤ 1
      apply le_of_lt
      calc
        dist u u' ≤ dist u u₀ + dist u₀ u' := dist_triangle _ _ _
        _ < 1 / 2 + 1 / 2 := add_lt_add (Metric.mem_ball.mp hu)
          (by simpa [dist_comm] using (Metric.mem_ball.mp hu'))
        _ = 1 := by norm_num
    · change dist v v ≤ 1
      simp
  · exact hu'good
  · filter_upwards [] with v
    exact hf.1.continuousAt.tendsto.comp
      (continuous_id.prodMk continuous_const).continuousAt

/--
Auxiliary finite-dimensional Haar-space fibre-integration theorem.  It is the form needed after
the explicit affine coordinate equivalences in the `K` and `M` kernel estimates.
-/
theorem aux_memW0_integral_slice_of_addHaar {E F K : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] [ProperSpace E]
    [MeasureSpace E] [BorelSpace E] [SFinite (volume : Measure E)]
    [Measure.IsAddHaarMeasure (volume : Measure E)]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F] [ProperSpace F]
    [MeasureSpace F] [BorelSpace F] [SFinite (volume : Measure F)]
    [Measure.IsAddHaarMeasure (volume : Measure F)]
    [NormedAddCommGroup K] [NormedSpace ℝ K] {f : E × F → K} (hf : MemW0 f) :
    MemW0 (fun u : E => ∫ v, f (u, v)) := by
  let : Measure.IsAddHaarMeasure (volume : Measure (E × F)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let F₀ : E × F → ℝ := wienerEnvelope f 1
  have hF₀ : MemW0 F₀ := hf.aux_mem_wienerEnvelope zero_le_one
  have hF₀_slice (u : E) : Integrable (fun v => F₀ (u, v)) :=
    aux_memW0_integrable_of_addHaar (hF₀.aux_memW0_slice_of_addHaar u)
  have hf_slice (u : E) : Integrable (fun v => f (u, v)) :=
    aux_memW0_integrable_of_addHaar (hf.aux_memW0_slice_of_addHaar u)
  have hcont : Continuous (fun u : E => ∫ v, f (u, v)) :=
    aux_continuous_integral_slice_of_addHaar hf
  refine ⟨hcont, ?_⟩
  have hH : Integrable (fun u : E => ∫ v, F₀ (u, v)) := hf.2.integral_prod_left
  refine hH.mono_nonneg (continuous_wienerEnvelope hcont 1).aestronglyMeasurable
    (ae_of_all _ fun u => aux_wienerEnvelope_nonneg hcont zero_le_one u)
    (ae_of_all _ fun u => ?_)
  unfold wienerEnvelope
  apply csSup_le ((Metric.nonempty_closedBall.mpr zero_le_one).image _)
  rintro _ ⟨w, hw, rfl⟩
  change ‖∫ v, f (u + w, v)‖ ≤ ∫ v, F₀ (u, v)
  calc
    ‖∫ v, f (u + w, v)‖ ≤ ∫ v, ‖f (u + w, v)‖ := norm_integral_le_integral_norm _
    _ ≤ ∫ v, F₀ (u, v) := by
      apply integral_mono (hf_slice (u + w)).norm (hF₀_slice u)
      intro v
      change ‖f (u + w, v)‖ ≤ wienerEnvelope f 1 (u, v)
      apply aux_norm_le_wienerEnvelope_of_mem_closedBall hf.1
      apply Metric.mem_closedBall.mpr
      rw [Prod.dist_eq]
      apply max_le
      · simpa [Metric.mem_closedBall, dist_eq_norm] using hw
      · simp

/--
Auxiliary `L¹` contraction of integration along a product fibre.  This is the
triangle-inequality/Fubini part of the `M`-to-`K` estimate and is also reused
by the kernel-form bounds.
-/
theorem aux_eLpNorm_one_integral_slice_le {E F K : Type*}
    [MeasurableSpace E] [MeasurableSpace F] (μ : Measure E) (ν : Measure F)
    [SFinite μ] [SFinite ν] [NormedAddCommGroup K] [NormedSpace ℝ K]
    {f : E × F → K} (hf : AEStronglyMeasurable f (μ.prod ν)) :
    eLpNorm (fun u : E => ∫ v, f (u, v) ∂ν) 1 μ ≤ eLpNorm f 1 (μ.prod ν) := by
  have hmeas : AEMeasurable (fun uv : E × F => ‖f uv‖ₑ) (μ.prod ν) :=
    hf.enorm
  rw [eLpNorm_one_eq_lintegral_enorm, eLpNorm_one_eq_lintegral_enorm]
  calc
    (∫⁻ u : E, ‖∫ v, f (u, v) ∂ν‖ₑ ∂μ) ≤
        ∫⁻ u : E, (∫⁻ v : F, ‖f (u, v)‖ₑ ∂ν) ∂μ := by
      apply lintegral_mono
      intro u
      exact enorm_integral_le_lintegral_enorm _
    _ = ∫⁻ uv : E × F, ‖f uv‖ₑ ∂(μ.prod ν) := by
      simpa using (lintegral_prod (fun uv : E × F => ‖f uv‖ₑ) hmeas).symm

/-- Concatenate a vector in `\mathbb R^k` with one in `\mathbb R^{n-k}`. -/
def concatVector (n k : ℕ) (hk : k ≤ n) (u : RealVector k)
    (v : RealVector (n - k)) : RealVector n :=
  fun i => if hi : i.1 < k then u ⟨i.1, hi⟩ else v ⟨i.1 - k, by omega⟩

/--
Auxiliary index equivalence used to split the first `k` coordinates from the
remaining `n-k` coordinates.  It underlies the Haar-preserving form of
`concatVector` needed for the cube estimate.
-/
noncomputable def aux_concatIndexEquiv (n k : ℕ) (hkn : k ≤ n) :
    Fin k ⊕ Fin (n - k) ≃ Fin n :=
  finSumFinEquiv.trans (finCongr (Nat.add_sub_of_le hkn))

/--
Auxiliary measurable equivalence implementing `concatVector` as a coordinate
reindexing followed by the standard product splitting of a finite Pi-space.
-/
noncomputable def aux_concatVectorEquiv (n k : ℕ) (hkn : k ≤ n) :
    (RealVector k × RealVector (n - k)) ≃ᵐ RealVector n :=
  (MeasurableEquiv.sumPiEquivProdPi
    (fun _ : Fin k ⊕ Fin (n - k) => ℝ)).symm.trans
    (MeasurableEquiv.piCongrLeft (fun _ : Fin n => ℝ)
      (aux_concatIndexEquiv n k hkn))

/-- The measurable-equivalence formula agrees with the manuscript's literal concatenation. -/
theorem aux_concatVectorEquiv_apply (n k : ℕ) (hkn : k ≤ n)
    (u : RealVector k) (v : RealVector (n - k)) :
    aux_concatVectorEquiv n k hkn (u, v) = concatVector n k hkn u v := by
  funext i
  by_cases hi : i.1 < k
  · let j : Fin k := ⟨i.1, hi⟩
    have he : aux_concatIndexEquiv n k hkn (Sum.inl j) = i := by
      apply Fin.ext
      simp [aux_concatIndexEquiv, j]
    rw [← he]
    change
      (MeasurableEquiv.piCongrLeft (fun _ : Fin n => ℝ)
        (aux_concatIndexEquiv n k hkn)
        ((MeasurableEquiv.sumPiEquivProdPi
          (fun _ : Fin k ⊕ Fin (n - k) => ℝ)).symm (u, v)))
        (aux_concatIndexEquiv n k hkn (Sum.inl j)) = _
    rw [MeasurableEquiv.piCongrLeft_apply_apply]
    change u j = _
    simp [aux_concatIndexEquiv, concatVector, j, hi]
  · let j : Fin (n - k) := ⟨i.1 - k, by omega⟩
    have he : aux_concatIndexEquiv n k hkn (Sum.inr j) = i := by
      apply Fin.ext
      simp [aux_concatIndexEquiv, j]; omega
    rw [← he]
    change
      (MeasurableEquiv.piCongrLeft (fun _ : Fin n => ℝ)
        (aux_concatIndexEquiv n k hkn)
        ((MeasurableEquiv.sumPiEquivProdPi
          (fun _ : Fin k ⊕ Fin (n - k) => ℝ)).symm (u, v)))
        (aux_concatIndexEquiv n k hkn (Sum.inr j)) = _
    rw [MeasurableEquiv.piCongrLeft_apply_apply]
    change v j = concatVector n k hkn u v
      (aux_concatIndexEquiv n k hkn (Sum.inr j))
    unfold concatVector
    have hnot : ¬ (aux_concatIndexEquiv n k hkn (Sum.inr j)).1 < k := by
      simp [aux_concatIndexEquiv, j]
    rw [dif_neg hnot]
    apply congrArg v
    apply Fin.ext
    simp [aux_concatIndexEquiv, j]

/-- Haar preservation of the coordinate concatenation used in the cube form. -/
theorem aux_measurePreserving_concatVector (n k : ℕ) (hkn : k ≤ n) :
    MeasurePreserving (aux_concatVectorEquiv n k hkn) volume volume := by
  let hsplit := volume_measurePreserving_sumPiEquivProdPi
    (fun _ : Fin k ⊕ Fin (n - k) => ℝ)
  let hreindex := volume_measurePreserving_piCongrLeft (fun _ : Fin n => ℝ)
    (aux_concatIndexEquiv n k hkn)
  exact hreindex.comp (hsplit.symm _)

/-- The translation vector selecting the `h`-corner displacement in the first `k` coordinates. -/
def cubeShiftVector (n k : ℕ) (hkn : k ≤ n) (h : Fin k → Fin 2)
    (u : RealVector k) : RealVector n :=
  let _hkn := hkn
  fun i => if hi : i.1 < k then
    if h ⟨i.1, hi⟩ = 0 then 0 else u ⟨i.1, hi⟩
  else 0

/-- The affine cube-coordinate map `x \mapsto \pi_h(x)` from the cube BL proof. -/
def cubeShift (n k : ℕ) (hkn : k ≤ n) (h : Fin k → Fin 2)
    (u : RealVector k) : RealVector n → RealVector n :=
  fun x => x + cubeShiftVector n k hkn h u

/-- Each cube-coordinate map is a Haar-preserving translation. -/
theorem aux_measurePreserving_cubeShift (n k : ℕ) (hkn : k ≤ n) (h : Fin k → Fin 2)
    (u : RealVector k) :
    MeasurePreserving (cubeShift n k hkn h u) (volume : Measure (RealVector n)) volume := by
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector n)) :=
    isAddHaarMeasure_volume_pi (Fin n)
  exact measurePreserving_add_right (volume : Measure (RealVector n)) _

/-- Delete one coordinate of a vector. -/
def eraseVector {d : ℕ} (i : Fin (d + 1)) (x : RealVector (d + 1)) : RealVector d :=
  fun j => x (i.succAbove j)

/-- The corner `y^h` of a coordinate cube. -/
def cubeCorner {k : ℕ} (y : RealVector k × RealVector k) (h : Fin k → Fin 2) :
    RealVector k :=
  fun i => if h i = 0 then y.1 i else y.2 i

/--
Auxiliary finite-index reindexing of cube corners by their final binary
coordinate.  It is used to separate the two copies of the new cube coordinate
in the A² calculation.
-/
theorem aux_prod_cubeCorners_snoc {M : Type*} [CommMonoid M] (k : ℕ)
    (f : (Fin (k + 1) → Fin 2) → M) :
    (∏ h : Fin (k + 1) → Fin 2, f h) =
      ∏ h : Fin k → Fin 2, ∏ a : Fin 2, f (Fin.snoc h a) := by
  classical
  let e : (Fin k → Fin 2) × Fin 2 ≃ (Fin (k + 1) → Fin 2) :=
    (Equiv.prodComm _ _).trans (Fin.snocEquiv fun _ => Fin 2)
  calc
    (∏ h : Fin (k + 1) → Fin 2, f h) =
        ∏ ha : (Fin k → Fin 2) × Fin 2, f (Fin.snoc ha.1 ha.2) := by
      symm
      apply Fintype.prod_equiv e (fun ha => f (Fin.snoc ha.1 ha.2)) f
      intro ha
      rfl
    _ = ∏ h : Fin k → Fin 2, ∏ a : Fin 2, f (Fin.snoc h a) := by
      simpa using
        (Fintype.prod_prod_type (fun ha : (Fin k → Fin 2) × Fin 2 =>
          f (Fin.snoc ha.1 ha.2)))

/--
Auxiliary two-valued form of `aux_prod_cubeCorners_snoc`, used to write the
two duplicated corner products in the singly-cancellative A² identity.
-/
theorem aux_prod_cubeCorners_snoc_two {M : Type*} [CommMonoid M] (k : ℕ)
    (f : (Fin (k + 1) → Fin 2) → M) :
    (∏ h : Fin (k + 1) → Fin 2, f h) =
      ∏ h : Fin k → Fin 2, f (Fin.snoc h 0) * f (Fin.snoc h 1) := by
  rw [aux_prod_cubeCorners_snoc]
  apply Finset.prod_congr rfl
  intro h _
  simp

/--
The literal cube corner after the difference substitution is the corresponding
translated copy of the base point.  This identifies the manuscript's
`F(y^h,x_{[k,n)})` with `F \circ \pi_h`.
-/
theorem aux_concat_cubeCorner_eq_cubeShift (n k : ℕ) (hkn : k ≤ n)
    (y₀ u : RealVector k) (x : RealVector (n - k)) (h : Fin k → Fin 2) :
    concatVector n k hkn (cubeCorner (y₀, y₀ + u) h) x =
      cubeShift n k hkn h u (concatVector n k hkn y₀ x) := by
  funext i
  by_cases hi : i.1 < k
  · simp [concatVector, cubeCorner, cubeShift, cubeShiftVector, hi]
    split_ifs <;> ring
  · simp [concatVector, cubeShift, cubeShiftVector, hi]

/-- The copy of the index `i\in[k-1,n)` in `Fin n`. -/
def prismIndex {n k : ℕ} (hk : 1 ≤ k) (hkn : k ≤ n) (i : Fin (n - k + 1)) : Fin n :=
  ⟨k - 1 + i.1, by omega⟩

/-- The `n`-dimensional input of `F_i` in the prism form. -/
def prismPoint {n k : ℕ} (hk : 1 ≤ k) (hkn : k ≤ n) (y : RealVector k × RealVector k)
    (x : RealVector (n - k + 1)) (h : Fin k → Fin 2) (i : Fin (n - k + 1)) :
    RealVector n :=
  let _hk := hk
  concatVector n k hkn (cubeCorner y h) (eraseVector i x)

/--
Auxiliary insertion of the distinguished simplex coordinate in the prism
change of variables.  Its first coordinate is the scalar called `s-\Sigma(x)`
in the manuscript.
-/
def aux_prismFiber {k d : ℕ} (s : ℝ) (a : RealVector k) (t : RealVector d) :
    RealVector (d + 1) :=
  Fin.cons (s - coordinateSum a - coordinateSum t) t

/-- The coordinate sum of the prism fibre is the distinguished scalar minus the base sum. -/
theorem aux_coordinateSum_prismFiber {k d : ℕ} (s : ℝ) (a : RealVector k)
    (t : RealVector d) :
    coordinateSum (aux_prismFiber s a t) = s - coordinateSum a := by
  simp [coordinateSum, aux_prismFiber, Fin.sum_univ_succ]

/--
Auxiliary tail-coordinate map in the prism Brascamp--Lieb change of
variables.  It is the map `t \mapsto (s-\Sigma(a)-\Sigma(t),t)\setminus i`.
-/
def aux_prismTailMap {k d : ℕ} (i : Fin (d + 1)) (s : ℝ) (a : RealVector k)
    (t : RealVector d) : RealVector d :=
  eraseVector i (aux_prismFiber s a t)

/--
Auxiliary affine coordinate map `\pi_{h,i}` from the proof of the prism
Brascamp--Lieb inequality.  It is kept separate from the form itself so its
Haar-preservation can be used in the Holder step.
-/
def aux_prismPullback (n k : ℕ) (hkn : k ≤ n) (h : Fin k → Fin 2)
    (i : Fin (n - k + 1)) (u : RealVector k) (s : ℝ) :
    RealVector n → RealVector n := fun z =>
  let z' := (aux_concatVectorEquiv n k hkn).symm z
  concatVector n k hkn (cubeCorner (z'.1, z'.1 + u) h)
    (aux_prismTailMap i s z'.1 z'.2)

/-- The literal formula identifying the prism points with the maps `\pi_{h,i}`. -/
theorem aux_prismPoint_eq_prismPullback (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n)
    (a : RealVector k) (t : RealVector (n - k)) (u : RealVector k) (s : ℝ)
    (h : Fin k → Fin 2) (i : Fin (n - k + 1)) :
    prismPoint hk hkn (a, a + u) (aux_prismFiber s a t) h i =
      aux_prismPullback n k hkn h i u s (concatVector n k hkn a t) := by
  rw [← aux_concatVectorEquiv_apply n k hkn a t]
  simp [prismPoint, aux_prismPullback, aux_prismTailMap, aux_prismFiber]

/--
Auxiliary successor embedding of the simplex index when the prism level rises
from `k` to `k+1`.  It keeps the dependent finite type explicit in the A²
corner calculation.
-/
def aux_succPrismIndex (n k : ℕ) (hkn : k + 1 ≤ n)
    (i : Fin (n - (k + 1) + 1)) : Fin (n - k + 1) :=
  Fin.cast (by omega) i.succ

/-- Explicit transport of the new prism fibre to the normalized `d+1` fibre. -/
def aux_newPrismFiber (k d : ℕ) (x : RealVector (d + 1)) :
    RealVector (k + 1 + d - (k + 1) + 1) :=
  fun a => x (Fin.cast (by omega) a)

/-- Explicit transport of the old prism tail to the normalized `d+1` fibre. -/
def aux_oldPrismTail (k d : ℕ) (x : RealVector (d + 1)) :
    RealVector (k + 1 + d - k) :=
  fun a => x (Fin.cast (by omega) a)

/--
Auxiliary transport of a successor finite index across equal fibre dimensions.
It is used in the normalized A² prism-corner identity.
-/
theorem aux_finCast_succ {a b : ℕ} (e : a = b) (i : Fin a) :
    Fin.cast (congrArg Nat.succ e) i.succ = (Fin.cast e i).succ := by
  cases e
  rfl

/--
Auxiliary transport of `succAbove` across equal fibre dimensions.  It keeps
the finite-coordinate casts local to the A² prism-corner calculation.
-/
theorem aux_finCast_succAbove {a b : ℕ} (e : a = b) (p : Fin (a + 1)) (i : Fin a) :
    Fin.cast (congrArg Nat.succ e) (p.succAbove i) =
      (Fin.cast (congrArg Nat.succ e) p).succAbove (Fin.cast e i) := by
  cases e
  rfl

/--
The literal prism point at level `k+1` is the level-`k` prism point with its
new corner scalar inserted into the simplex tail.  This normalized,
cast-aware coordinate identity is the finite-dimensional bridge in the A²
part of singly-cancellative Cauchy--Schwarz.
-/
theorem aux_prismPoint_succ_bridge_cast (k d : ℕ) (hk : 1 ≤ k)
    (y : RealVector k × RealVector k) (r0 r1 : ℝ) (x : RealVector (d + 1))
    (h : Fin (k + 1) → Fin 2) (i : Fin (d + 1)) :
    prismPoint (n := k + 1 + d) (k := k + 1) (by omega) (by omega)
      (Fin.lastCases r0 (fun l => y.1 l), Fin.lastCases r1 (fun l => y.2 l))
      (aux_newPrismFiber k d x) h (Fin.cast (by omega) i) =
    prismPoint (n := k + 1 + d) (k := k) hk (by omega) y
      (Fin.cons (if h (Fin.last k) = 0 then r0 else r1) (aux_oldPrismTail k d x))
      (fun l => h l.castSucc) (Fin.cast (by omega) i.succ) := by
  funext j
  by_cases hjk : j.1 < k
  · let jOld : Fin k := ⟨j.1, hjk⟩
    have hjNew : (⟨j.1, by omega⟩ : Fin (k + 1)) = jOld.castSucc := Fin.ext rfl
    unfold prismPoint
    simp only [concatVector]
    rw [dif_pos (by omega), dif_pos hjk]
    change cubeCorner
      (Fin.lastCases r0 (fun l => y.1 l), Fin.lastCases r1 (fun l => y.2 l)) h
        ⟨j.1, by omega⟩ = cubeCorner y (fun l => h l.castSucc) jOld
    rw [hjNew]
    simp [cubeCorner]
  · have hjge : k ≤ j.1 := Nat.le_of_not_gt hjk
    by_cases hjeq : j.1 = k
    · unfold prismPoint
      simp only [concatVector]
      rw [dif_pos (by omega), dif_neg hjk]
      let : NeZero (k + 1 + d - k) := ⟨by omega⟩
      have hjLast : (⟨j.1, by omega⟩ : Fin (k + 1)) = Fin.last k := by
        apply Fin.ext
        simp [hjeq]
      have hjZero : (⟨j.1 - k, by omega⟩ : Fin (k + 1 + d - k)) =
          (0 : Fin (k + 1 + d - k)) := by
        apply Fin.ext
        simp [hjeq]
      rw [hjLast, hjZero]
      have hiOldNe : (Fin.cast (by omega) i.succ : Fin (k + 1 + d - k + 1)) ≠ 0 := by
        intro hi
        have hx := congrArg Fin.val hi
        simp at hx
      unfold eraseVector
      rw [show (Fin.cast (by omega) i.succ : Fin (k + 1 + d - k + 1)).succAbove
          (0 : Fin (k + 1 + d - k)) = 0 from Fin.succAbove_ne_zero_zero hiOldNe]
      simp [cubeCorner]
    · have hjgt : k < j.1 := by omega
      have hjSub : j.1 - k = j.1 - (k + 1) + 1 := by omega
      have hlow : k + 1 + d - k = d + 1 := by omega
      have hnew : k + 1 + d - (k + 1) = d := by omega
      have hnewFiber : k + 1 + d - (k + 1) + 1 = d + 1 := by omega
      let lNew : Fin (k + 1 + d - (k + 1)) := ⟨j.1 - (k + 1), by omega⟩
      let lOld : Fin (k + 1 + d - k) := ⟨j.1 - k, by omega⟩
      unfold prismPoint
      simp only [concatVector]
      rw [dif_neg (by omega), dif_neg hjk]
      change eraseVector (Fin.cast (by omega) i) (aux_newPrismFiber k d x) lNew =
        eraseVector (Fin.cast (by omega) i.succ)
          (Fin.cons (if h (Fin.last k) = 0 then r0 else r1) (aux_oldPrismTail k d x)) lOld
      let l : Fin d := Fin.cast hnew lNew
      let q : Fin (k + 1 + d - k) := Fin.cast hlow.symm (i.succAbove l)
      have hLold : lOld = Fin.cast hlow.symm l.succ := by
        apply Fin.ext
        simp [lOld, l, hjSub]
        rfl
      have hIold : (Fin.cast (by omega) i.succ : Fin (k + 1 + d - k + 1)) =
          Fin.cast (congrArg Nat.succ hlow.symm) i.succ := by
        apply Fin.ext
        simp
      have hAbove :
          (Fin.cast (by omega) i.succ :
              Fin (k + 1 + d - k + 1)).succAbove lOld = q.succ := by
        rw [hIold, hLold, ← aux_finCast_succAbove hlow.symm i.succ l.succ,
          Fin.succ_succAbove_succ]
        exact aux_finCast_succ hlow.symm (i.succAbove l)
      have hLnew : lNew = Fin.cast hnew.symm l := by
        apply Fin.ext
        simp [l]
      have hInew : (Fin.cast (by omega) i : Fin (k + 1 + d - (k + 1) + 1)) =
          Fin.cast hnewFiber.symm i := by
        apply Fin.ext
        simp
      have hNewAbove :
          (Fin.cast (by omega) i : Fin (k + 1 + d - (k + 1) + 1)).succAbove lNew =
            Fin.cast hnewFiber.symm (i.succAbove l) := by
        rw [hInew, hLnew, ← aux_finCast_succAbove hnew.symm i l]
      unfold eraseVector
      rw [hAbove, Fin.cons_succ]
      unfold aux_newPrismFiber aux_oldPrismTail
      rw [hNewAbove]
      congr 1

/--
Auxiliary factorization of the level-`k+1` prism corner product into the two
level-`k` products obtained by fixing the new last corner coordinate.  This is
the pointwise finite-product identity in the A² calculation.
-/
theorem aux_singlyCancellative_a2CornerProduct (k d : ℕ) (hk : 1 ≤ k)
    (F : Fin (k + 1 + d) → RealVector (k + 1 + d) → ℝ)
    (y : RealVector k × RealVector k) (r0 r1 : ℝ) (x : RealVector (d + 1)) :
    (∏ h : Fin (k + 1) → Fin 2, ∏ i : Fin (d + 1),
      F (prismIndex (show 1 ≤ k + 1 by omega) (by omega) (Fin.cast (by omega) i))
        (prismPoint (n := k + 1 + d) (k := k + 1) (by omega) (by omega)
          (Fin.lastCases r0 (fun l => y.1 l), Fin.lastCases r1 (fun l => y.2 l))
          (aux_newPrismFiber k d x) h (Fin.cast (by omega) i))) =
      (∏ h : Fin k → Fin 2, ∏ i : Fin (d + 1),
        F (prismIndex hk (by omega) (Fin.cast (by omega) i.succ))
          (prismPoint (n := k + 1 + d) (k := k) hk (by omega) y
            (Fin.cons r0 (aux_oldPrismTail k d x)) h (Fin.cast (by omega) i.succ))) *
      (∏ h : Fin k → Fin 2, ∏ i : Fin (d + 1),
        F (prismIndex hk (by omega) (Fin.cast (by omega) i.succ))
          (prismPoint (n := k + 1 + d) (k := k) hk (by omega) y
            (Fin.cons r1 (aux_oldPrismTail k d x)) h (Fin.cast (by omega) i.succ))) := by
  rw [aux_prod_cubeCorners_snoc_two]
  rw [Finset.prod_mul_distrib]
  congr 1
  · apply Finset.prod_congr rfl
    intro h _
    apply Finset.prod_congr rfl
    intro i _
    have hidx :
        prismIndex (n := k + 1 + d) (k := k + 1) (show 1 ≤ k + 1 by omega)
          (by omega) (Fin.cast (by omega) i) =
          prismIndex (n := k + 1 + d) (k := k) hk (by omega)
            (Fin.cast (by omega) i.succ) := by
      apply Fin.ext
      simp [prismIndex]
      omega
    have hpt :
        prismPoint (n := k + 1 + d) (k := k + 1) (by omega) (by omega)
          (Fin.lastCases r0 (fun l => y.1 l), Fin.lastCases r1 (fun l => y.2 l))
          (aux_newPrismFiber k d x) (Fin.snoc h 0) (Fin.cast (by omega) i) =
        prismPoint (n := k + 1 + d) (k := k) hk (by omega) y
          (Fin.cons r0 (aux_oldPrismTail k d x)) h (Fin.cast (by omega) i.succ) := by
      simpa using aux_prismPoint_succ_bridge_cast k d hk y r0 r1 x (Fin.snoc h 0) i
    rw [hidx]
    exact congrArg (F _) hpt
  · apply Finset.prod_congr rfl
    intro h _
    apply Finset.prod_congr rfl
    intro i _
    have hidx :
        prismIndex (n := k + 1 + d) (k := k + 1) (show 1 ≤ k + 1 by omega)
          (by omega) (Fin.cast (by omega) i) =
          prismIndex (n := k + 1 + d) (k := k) hk (by omega)
            (Fin.cast (by omega) i.succ) := by
      apply Fin.ext
      simp [prismIndex]
      omega
    have hpt :
        prismPoint (n := k + 1 + d) (k := k + 1) (by omega) (by omega)
          (Fin.lastCases r0 (fun l => y.1 l), Fin.lastCases r1 (fun l => y.2 l))
          (aux_newPrismFiber k d x) (Fin.snoc h 1) (Fin.cast (by omega) i) =
        prismPoint (n := k + 1 + d) (k := k) hk (by omega) y
          (Fin.cons r1 (aux_oldPrismTail k d x)) h (Fin.cast (by omega) i.succ) := by
      simpa using aux_prismPoint_succ_bridge_cast k d hk y r0 r1 x (Fin.snoc h 1) i
    rw [hidx]
    exact congrArg (F _) hpt

/--
Auxiliary Fubini reordering which exposes the scalar being replaced in the
prism coordinate change.
-/
noncomputable def aux_prismScalarReorderEquiv (k d : ℕ) :
    RealVector k × (ℝ × RealVector d) ≃ᵐ ℝ × (RealVector k × RealVector d) :=
  MeasurableEquiv.prodAssoc.symm.trans
    ((MeasurableEquiv.prodCongr MeasurableEquiv.prodComm (MeasurableEquiv.refl _)).trans
      MeasurableEquiv.prodAssoc)

/--
Auxiliary four-block Fubini reordering.  It exposes a scalar kernel parameter
without changing the remaining Euclidean variables in the A² calculation.
-/
noncomputable def aux_fourBlockReorder (k d : ℕ) :
    (RealVector k × (ℝ × RealVector d)) × ℝ ≃ᵐ
      ((RealVector k × ℝ) × ℝ) × RealVector d := by
  let e1 : (RealVector k × (ℝ × RealVector d)) × ℝ ≃ᵐ
      RealVector k × ((ℝ × RealVector d) × ℝ) := MeasurableEquiv.prodAssoc
  let e2a : (ℝ × RealVector d) × ℝ ≃ᵐ ℝ × (RealVector d × ℝ) :=
    MeasurableEquiv.prodAssoc
  let e2b : ℝ × (RealVector d × ℝ) ≃ᵐ ℝ × (ℝ × RealVector d) :=
    MeasurableEquiv.prodCongr (MeasurableEquiv.refl _) MeasurableEquiv.prodComm
  let e2c : ℝ × (ℝ × RealVector d) ≃ᵐ (ℝ × ℝ) × RealVector d :=
    MeasurableEquiv.prodAssoc.symm
  let e2 := e2a.trans (e2b.trans e2c)
  let e3 : RealVector k × ((ℝ × ℝ) × RealVector d) ≃ᵐ
      (RealVector k × (ℝ × ℝ)) × RealVector d := MeasurableEquiv.prodAssoc.symm
  let e4 : (RealVector k × (ℝ × ℝ)) × RealVector d ≃ᵐ
      ((RealVector k × ℝ) × ℝ) × RealVector d :=
    MeasurableEquiv.prodCongr MeasurableEquiv.prodAssoc.symm (MeasurableEquiv.refl _)
  exact e1.trans ((MeasurableEquiv.prodCongr (MeasurableEquiv.refl _) e2).trans (e3.trans e4))

/-- Haar preservation of the four-block Fubini reordering. -/
theorem aux_measurePreserving_fourBlockReorder (k d : ℕ) :
    MeasurePreserving (aux_fourBlockReorder k d) volume volume := by
  have h1 : MeasurePreserving
      (MeasurableEquiv.prodAssoc :
        (RealVector k × (ℝ × RealVector d)) × ℝ ≃ᵐ
          RealVector k × ((ℝ × RealVector d) × ℝ)) volume volume :=
    volume_preserving_prodAssoc (α₁ := RealVector k) (β₁ := ℝ × RealVector d) (γ₁ := ℝ)
  have h2a : MeasurePreserving (MeasurableEquiv.prodAssoc :
      (ℝ × RealVector d) × ℝ ≃ᵐ ℝ × (RealVector d × ℝ)) volume volume :=
    volume_preserving_prodAssoc (α₁ := ℝ) (β₁ := RealVector d) (γ₁ := ℝ)
  have h2b : MeasurePreserving (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
      (MeasurableEquiv.prodComm : RealVector d × ℝ ≃ᵐ ℝ × RealVector d)) volume volume := by
    change MeasurePreserving (Prod.map (id : ℝ → ℝ)
      (Prod.swap : RealVector d × ℝ → ℝ × RealVector d)) volume volume
    simpa only [Measure.volume_eq_prod, id_eq] using
      (MeasurePreserving.id (volume : Measure ℝ)).prod
        (aux_volume_preserving_prod_swap (volume : Measure (RealVector d)) (volume : Measure ℝ))
  have h2c : MeasurePreserving (MeasurableEquiv.prodAssoc.symm :
      ℝ × (ℝ × RealVector d) ≃ᵐ (ℝ × ℝ) × RealVector d) volume volume :=
    (volume_preserving_prodAssoc (α₁ := ℝ) (β₁ := ℝ) (γ₁ := RealVector d)).symm
  let e2 : (ℝ × RealVector d) × ℝ ≃ᵐ (ℝ × ℝ) × RealVector d :=
    MeasurableEquiv.prodAssoc.trans
      ((MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
        (MeasurableEquiv.prodComm : RealVector d × ℝ ≃ᵐ ℝ × RealVector d)).trans
        MeasurableEquiv.prodAssoc.symm)
  have h2 : MeasurePreserving e2 volume volume := by
    change MeasurePreserving (MeasurableEquiv.prodAssoc.symm ∘
      ((MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
        (MeasurableEquiv.prodComm : RealVector d × ℝ ≃ᵐ ℝ × RealVector d)) ∘
        MeasurableEquiv.prodAssoc)) volume volume
    exact h2c.comp (h2b.comp h2a)
  have h2' : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (RealVector k)) e2) volume volume := by
    change MeasurePreserving (Prod.map (id : RealVector k → RealVector k) e2) volume volume
    simpa only [Measure.volume_eq_prod, id_eq] using
      (MeasurePreserving.id (volume : Measure (RealVector k))).prod h2
  have h3 : MeasurePreserving (MeasurableEquiv.prodAssoc.symm :
      RealVector k × ((ℝ × ℝ) × RealVector d) ≃ᵐ
        (RealVector k × (ℝ × ℝ)) × RealVector d) volume volume :=
    (volume_preserving_prodAssoc (α₁ := RealVector k) (β₁ := ℝ × ℝ) (γ₁ := RealVector d)).symm
  have hsplit : MeasurePreserving (MeasurableEquiv.prodAssoc.symm :
      RealVector k × (ℝ × ℝ) ≃ᵐ (RealVector k × ℝ) × ℝ) volume volume :=
    (volume_preserving_prodAssoc (α₁ := RealVector k) (β₁ := ℝ) (γ₁ := ℝ)).symm
  have h4 : MeasurePreserving (MeasurableEquiv.prodCongr
      (MeasurableEquiv.prodAssoc.symm : RealVector k × (ℝ × ℝ) ≃ᵐ (RealVector k × ℝ) × ℝ)
      (MeasurableEquiv.refl (RealVector d))) volume volume := by
    change MeasurePreserving
      (Prod.map (MeasurableEquiv.prodAssoc.symm :
        RealVector k × (ℝ × ℝ) → (RealVector k × ℝ) × ℝ)
        (id : RealVector d → RealVector d)) volume volume
    simpa only [Measure.volume_eq_prod, id_eq] using
      hsplit.prod (MeasurePreserving.id (volume : Measure (RealVector d)))
  have htotal := h4.comp (h3.comp (h2'.comp h1))
  convert htotal using 1; rfl

/--
Auxiliary scalar affine map over a real-vector base.  This is the fibrewise
reflection-and-translation calculation used to prove Haar preservation of the
prism tail maps.
-/
theorem aux_measurePreserving_scalarAffine (d : ℕ) (c : RealVector d → ℝ)
    (hc : Continuous c) :
    MeasurePreserving (fun p : ℝ × RealVector d => (c p.2 - p.1, p.2))
      volume volume := by
  have hskewProd : MeasurePreserving
      (fun p : RealVector d × ℝ => (p.1, p.2 + c p.1))
      ((volume : Measure (RealVector d)).prod (volume : Measure ℝ))
      ((volume : Measure (RealVector d)).prod (volume : Measure ℝ)) := by
    have h := MeasurePreserving.skew_product
      (μa := (volume : Measure (RealVector d))) (μb := (volume : Measure (RealVector d)))
      (μc := (volume : Measure ℝ)) (μd := (volume : Measure ℝ))
      (g := fun p q => q + c p)
      (MeasurePreserving.id (volume : Measure (RealVector d)))
      (continuous_snd.add (hc.comp continuous_fst)).measurable
      (ae_of_all _ fun p => (measurePreserving_add_right (volume : Measure ℝ) (c p)).map_eq)
    simpa only [id_eq] using h
  have hskew : MeasurePreserving
      (fun p : RealVector d × ℝ => (p.1, p.2 + c p.1))
      (volume : Measure (RealVector d × ℝ)) (volume : Measure (RealVector d × ℝ)) := by
    simpa only [Measure.volume_eq_prod] using hskewProd
  have hswap₁ : MeasurePreserving
      (Prod.swap : ℝ × RealVector d → RealVector d × ℝ) volume volume := by
    simpa only [Measure.volume_eq_prod] using
      (aux_volume_preserving_prod_swap (volume : Measure ℝ) (volume : Measure (RealVector d)))
  have hswap₂ : MeasurePreserving
      (Prod.swap : RealVector d × ℝ → ℝ × RealVector d) volume volume := by
    simpa only [Measure.volume_eq_prod] using
      (aux_volume_preserving_prod_swap (volume : Measure (RealVector d)) (volume : Measure ℝ))
  have htranslation : MeasurePreserving
      (fun p : ℝ × RealVector d => (p.1 + c p.2, p.2)) volume volume := by
    convert hswap₂.comp (hskew.comp hswap₁) using 1; rfl
  have hnegProd : MeasurePreserving
      (Prod.map (fun q : ℝ => -q) (id : RealVector d → RealVector d))
      ((volume : Measure ℝ).prod (volume : Measure (RealVector d)))
      ((volume : Measure ℝ).prod (volume : Measure (RealVector d))) :=
    (Measure.measurePreserving_neg (volume : Measure ℝ)).prod
      (MeasurePreserving.id (volume : Measure (RealVector d)))
  have hneg : MeasurePreserving
      (fun p : ℝ × RealVector d => (-p.1, p.2))
      (volume : Measure (ℝ × RealVector d)) (volume : Measure (ℝ × RealVector d)) := by
    convert hnegProd using 1 <;> rfl
  convert htranslation.comp hneg using 1
  funext p
  rcases p with ⟨q, t⟩
  apply Prod.ext
  · simp only [Function.comp_apply]
    ring
  · rfl

/--
Auxiliary Haar change of variables `(t,x) ↦ (x,x₀-t)` used in the
single-cancellative A² calculation.
-/
theorem aux_measurePreserving_a2AffineMap (d : ℕ) :
    MeasurePreserving
      (fun p : ℝ × RealVector (d + 1) => (p.2, p.2 0 - p.1)) volume volume := by
  have haff : MeasurePreserving
      (fun p : ℝ × RealVector (d + 1) => (p.2 0 - p.1, p.2)) volume volume :=
    aux_measurePreserving_scalarAffine (d + 1) (fun x => x 0)
      (continuous_apply (A := fun _ : Fin (d + 1) => ℝ) 0)
  have hswap : MeasurePreserving
      (Prod.swap : ℝ × RealVector (d + 1) → RealVector (d + 1) × ℝ) volume volume := by
    simpa only [Measure.volume_eq_prod] using
      (aux_volume_preserving_prod_swap (volume : Measure ℝ)
        (volume : Measure (RealVector (d + 1))))
  convert hswap.comp haff using 1
  rfl

/--
Auxiliary fibrewise scalar translation.  It is obtained from the preceding
reflection-and-translation map by one more Haar-preserving reflection.
-/
theorem aux_measurePreserving_scalarTranslation (d : ℕ) (c : RealVector d → ℝ)
    (hc : Continuous c) :
    MeasurePreserving (fun p : ℝ × RealVector d => (p.1 + c p.2, p.2))
      volume volume := by
  have hnegProd : MeasurePreserving
      (Prod.map (fun q : ℝ => -q) (id : RealVector d → RealVector d))
      ((volume : Measure ℝ).prod (volume : Measure (RealVector d)))
      ((volume : Measure ℝ).prod (volume : Measure (RealVector d))) :=
    (Measure.measurePreserving_neg (volume : Measure ℝ)).prod
      (MeasurePreserving.id (volume : Measure (RealVector d)))
  have hneg : MeasurePreserving
      (fun p : ℝ × RealVector d => (-p.1, p.2))
      (volume : Measure (ℝ × RealVector d)) (volume : Measure (ℝ × RealVector d)) := by
    convert hnegProd using 1 <;> rfl
  convert (aux_measurePreserving_scalarAffine d c hc).comp hneg using 1
  funext p
  rcases p with ⟨q, t⟩
  apply Prod.ext
  · simp only [Function.comp_apply]
    ring
  · rfl

/-- The scalar translation in a fixed prism tail fibre. -/
theorem aux_measurePreserving_prismTailScalarTranslation (k d : ℕ)
    (a : RealVector k) :
    MeasurePreserving
      (fun p : ℝ × RealVector d =>
        (p.1 - coordinateSum a - coordinateSum p.2, p.2)) volume volume := by
  convert aux_measurePreserving_scalarTranslation d
    (fun t => -coordinateSum a - coordinateSum t)
    ((continuous_const.sub (aux_continuous_coordinateSum d)))
    using 1
  funext p
  rcases p with ⟨q, t⟩
  apply Prod.ext <;> ring

/--
Auxiliary four-block coordinate reordering used in the global prism change of
variables.  It sends `(t,(u,s))` to `(u,(s,t))`.
-/
noncomputable def aux_prismInnerReorderEquiv (k d : ℕ) :
    RealVector d × (RealVector k × ℝ) ≃ᵐ RealVector k × (ℝ × RealVector d) :=
  MeasurableEquiv.prodAssoc.symm.trans
    ((MeasurableEquiv.prodCongr MeasurableEquiv.prodComm (MeasurableEquiv.refl _)).trans
      (MeasurableEquiv.prodAssoc.trans
        (MeasurableEquiv.prodCongr (MeasurableEquiv.refl _) MeasurableEquiv.prodComm)))

/-- Haar preservation of the inner four-block coordinate reordering. -/
theorem aux_measurePreserving_prismInnerReorder (k d : ℕ) :
    MeasurePreserving (aux_prismInnerReorderEquiv k d) volume volume := by
  have h₁ : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        RealVector d × (RealVector k × ℝ) ≃ᵐ (RealVector d × RealVector k) × ℝ)
      volume volume :=
    (volume_preserving_prodAssoc (α₁ := RealVector d) (β₁ := RealVector k)
      (γ₁ := ℝ)).symm
  have h₂ : MeasurePreserving
      (MeasurableEquiv.prodCongr
        (MeasurableEquiv.prodComm : RealVector d × RealVector k ≃ᵐ
          RealVector k × RealVector d)
        (MeasurableEquiv.refl ℝ)) volume volume := by
    change MeasurePreserving
      (Prod.map (Prod.swap : RealVector d × RealVector k → RealVector k × RealVector d)
        (id : ℝ → ℝ)) volume volume
    simpa only [Measure.volume_eq_prod] using
      (aux_volume_preserving_prod_swap
        (volume : Measure (RealVector d)) (volume : Measure (RealVector k))).prod
        (MeasurePreserving.id (volume : Measure ℝ))
  have h₃ : MeasurePreserving
      (MeasurableEquiv.prodAssoc :
        (RealVector k × RealVector d) × ℝ ≃ᵐ RealVector k × (RealVector d × ℝ))
      volume volume :=
    volume_preserving_prodAssoc (α₁ := RealVector k) (β₁ := RealVector d) (γ₁ := ℝ)
  have h₄ : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (RealVector k))
        (MeasurableEquiv.prodComm : RealVector d × ℝ ≃ᵐ ℝ × RealVector d)) volume volume := by
    change MeasurePreserving
      (Prod.map (id : RealVector k → RealVector k)
        (Prod.swap : RealVector d × ℝ → ℝ × RealVector d)) volume volume
    simpa only [Measure.volume_eq_prod] using
      (MeasurePreserving.id (volume : Measure (RealVector k))).prod
        (aux_volume_preserving_prod_swap
          (volume : Measure (RealVector d)) (volume : Measure ℝ))
  change MeasurePreserving
    ((MeasurableEquiv.prodCongr (MeasurableEquiv.refl (RealVector k))
      (MeasurableEquiv.prodComm : RealVector d × ℝ ≃ᵐ ℝ × RealVector d)) ∘
      (MeasurableEquiv.prodAssoc ∘
        ((MeasurableEquiv.prodCongr
          (MeasurableEquiv.prodComm : RealVector d × RealVector k ≃ᵐ
            RealVector k × RealVector d)
          (MeasurableEquiv.refl ℝ)) ∘ MeasurableEquiv.prodAssoc.symm))) volume volume
  exact h₄.comp (h₃.comp (h₂.comp h₁))

/--
The global block reordering for the prism change of variables.  It sends
`(u,(s,(a,t)))` to `((a,u),(s,t))`.
-/
noncomputable def aux_prismCoordinateReorderEquiv (k d : ℕ) :
    RealVector k × (ℝ × (RealVector k × RealVector d)) ≃ᵐ
      (RealVector k × RealVector k) × (ℝ × RealVector d) :=
  MeasurableEquiv.prodAssoc.symm.trans
    (MeasurableEquiv.prodComm.trans
      (MeasurableEquiv.prodAssoc.trans
        ((MeasurableEquiv.prodCongr (MeasurableEquiv.refl _)
          (aux_prismInnerReorderEquiv k d)).trans MeasurableEquiv.prodAssoc.symm)))

/-- Literal formula for the global prism block reordering. -/
theorem aux_prismCoordinateReorderEquiv_apply (k d : ℕ) (u a : RealVector k)
    (s : ℝ) (t : RealVector d) :
    aux_prismCoordinateReorderEquiv k d (u, (s, (a, t))) = ((a, u), (s, t)) := rfl

/-- Haar preservation of the global prism block reordering. -/
theorem aux_measurePreserving_prismCoordinateReorder (k d : ℕ) :
    MeasurePreserving (aux_prismCoordinateReorderEquiv k d) volume volume := by
  have h₁ : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        RealVector k × (ℝ × (RealVector k × RealVector d)) ≃ᵐ
          (RealVector k × ℝ) × (RealVector k × RealVector d)) volume volume :=
    (volume_preserving_prodAssoc (α₁ := RealVector k) (β₁ := ℝ)
      (γ₁ := RealVector k × RealVector d)).symm
  have h₂ : MeasurePreserving
      (MeasurableEquiv.prodComm :
        (RealVector k × ℝ) × (RealVector k × RealVector d) ≃ᵐ
          (RealVector k × RealVector d) × (RealVector k × ℝ)) volume volume := by
    change MeasurePreserving
      (Prod.swap : (RealVector k × ℝ) × (RealVector k × RealVector d) →
        (RealVector k × RealVector d) × (RealVector k × ℝ)) volume volume
    simpa only [Measure.volume_eq_prod] using
      aux_volume_preserving_prod_swap
        (volume : Measure (RealVector k × ℝ))
        (volume : Measure (RealVector k × RealVector d))
  have h₃ : MeasurePreserving
      (MeasurableEquiv.prodAssoc :
        (RealVector k × RealVector d) × (RealVector k × ℝ) ≃ᵐ
          RealVector k × (RealVector d × (RealVector k × ℝ))) volume volume :=
    volume_preserving_prodAssoc (α₁ := RealVector k) (β₁ := RealVector d)
      (γ₁ := RealVector k × ℝ)
  have h₄ : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (RealVector k))
        (aux_prismInnerReorderEquiv k d)) volume volume := by
    change MeasurePreserving
      (Prod.map (id : RealVector k → RealVector k) (aux_prismInnerReorderEquiv k d))
      volume volume
    simpa only [Measure.volume_eq_prod] using
      (MeasurePreserving.id (volume : Measure (RealVector k))).prod
        (aux_measurePreserving_prismInnerReorder k d)
  have h₅ : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        RealVector k × (RealVector k × (ℝ × RealVector d)) ≃ᵐ
          (RealVector k × RealVector k) × (ℝ × RealVector d)) volume volume :=
    (volume_preserving_prodAssoc (α₁ := RealVector k) (β₁ := RealVector k)
      (γ₁ := ℝ × RealVector d)).symm
  change MeasurePreserving
    (MeasurableEquiv.prodAssoc.symm ∘
      ((MeasurableEquiv.prodCongr (MeasurableEquiv.refl (RealVector k))
        (aux_prismInnerReorderEquiv k d)) ∘
        (MeasurableEquiv.prodAssoc ∘
          (MeasurableEquiv.prodComm ∘ MeasurableEquiv.prodAssoc.symm))) ) volume volume
  exact h₅.comp (h₄.comp (h₃.comp (h₂.comp h₁)))

/-- The scalar affine replacement in a fixed prism tail fibre. -/
theorem aux_measurePreserving_prismTailScalarAffine (k d : ℕ) (s : ℝ)
    (a : RealVector k) :
    MeasurePreserving
      (fun p : ℝ × RealVector d =>
        (s - coordinateSum a - coordinateSum p.2 - p.1, p.2)) volume volume := by
  exact aux_measurePreserving_scalarAffine d
    (fun t => s - coordinateSum a - coordinateSum t)
    ((continuous_const.sub continuous_const).sub (aux_continuous_coordinateSum d))

/--
Auxiliary coordinate splitting at a deleted tail coordinate.  This is the
standard `Fin.succAbove` equivalence made explicit for the prism proof.
-/
noncomputable def aux_prismTailSplitEquiv (d : ℕ) (j : Fin (d + 1)) :
    RealVector (d + 1) ≃ᵐ ℝ × RealVector d :=
  MeasurableEquiv.piFinSuccAbove (fun _ : Fin (d + 1) => ℝ) j

/-- The tail-coordinate splitting has the expected deleted-coordinate formula. -/
theorem aux_prismTailSplitEquiv_apply (d : ℕ) (j : Fin (d + 1))
    (t : RealVector (d + 1)) :
    aux_prismTailSplitEquiv d j t = (t j, eraseVector j t) := rfl

/-- Haar preservation of splitting a real vector at one coordinate. -/
theorem aux_measurePreserving_prismTailSplit (d : ℕ) (j : Fin (d + 1)) :
    MeasurePreserving (aux_prismTailSplitEquiv d j) volume volume :=
  volume_preserving_piFinSuccAbove (fun _ : Fin (d + 1) => ℝ) j

/--
The affine coordinate change used before Cauchy--Schwarz in the
singly-cancellative argument.  It sends the manuscript variables
`(y,t,r,x)` to the original unintegrated prism variables
`((y,(r,x)),r-t)`.
-/
def aux_singlyCancellativeBaseChange (k d : ℕ) :
    (RealVector k × RealVector k) × (ℝ × (ℝ × RealVector (d + 1))) →
      ((RealVector k × RealVector k) × RealVector (d + 2)) × ℝ :=
  fun p => ((p.1, Fin.cons p.2.2.1 p.2.2.2), p.2.2.1 - p.2.1)

/-- The coordinate sum after extracting one coordinate of a real vector. -/
theorem aux_coordinateSum_eraseVector (d : ℕ) (j : Fin (d + 1))
    (t : RealVector (d + 1)) :
    coordinateSum t = t j + coordinateSum (eraseVector j t) := by
  unfold coordinateSum eraseVector
  rw [Fin.sum_univ_succAbove _ j]

/-- The prism tail map is the identity when the distinguished coordinate is first. -/
theorem aux_prismTailMap_zero {k d : ℕ} (s : ℝ) (a : RealVector k)
    (t : RealVector d) :
    aux_prismTailMap (0 : Fin (d + 1)) s a t = t := by
  funext j
  simp [aux_prismTailMap, aux_prismFiber, eraseVector]

/--
Deleting a non-first distinguished coordinate inserts the affine scalar in the
first remaining tail coordinate.
-/
theorem aux_prismTailMap_succ {k d : ℕ} (j : Fin (d + 1)) (s : ℝ)
    (a : RealVector k) (t : RealVector (d + 1)) :
    aux_prismTailMap (Fin.succ j) s a t =
      Fin.cons (s - coordinateSum a - coordinateSum t) (eraseVector j t) := by
  funext l
  refine Fin.cases ?_ ?_ l
  · simp [aux_prismTailMap, aux_prismFiber, eraseVector]
  · intro r
    simp [aux_prismTailMap, aux_prismFiber, eraseVector, Fin.succ_succAbove_succ]

/-- Each prism tail-coordinate map is Haar preserving. -/
theorem aux_measurePreserving_prismTailMap (k d : ℕ) (i : Fin (d + 1))
    (s : ℝ) (a : RealVector k) :
    MeasurePreserving (aux_prismTailMap i s a) volume volume := by
  refine Fin.cases ?_ (fun j => ?_) i
  · have hmap : aux_prismTailMap (0 : Fin (d + 1)) s a = id := by
      funext t
      exact aux_prismTailMap_zero s a t
    rw [hmap]
    exact MeasurePreserving.id (volume : Measure (RealVector d))
  · cases d with
    | zero => exact Fin.elim0 j
    | succ d =>
      let e₀ := aux_prismTailSplitEquiv d (0 : Fin (d + 1))
      let eⱼ := aux_prismTailSplitEquiv d j
      let A : ℝ × RealVector d → ℝ × RealVector d := fun p =>
        (s - coordinateSum a - coordinateSum p.2 - p.1, p.2)
      have he₀ : MeasurePreserving e₀ volume volume := by
        simpa [e₀] using
          (aux_measurePreserving_prismTailSplit d (0 : Fin (d + 1)))
      have heⱼ : MeasurePreserving eⱼ volume volume := by
        simpa [eⱼ] using aux_measurePreserving_prismTailSplit d j
      have hA : MeasurePreserving A volume volume := by
        simpa [A] using aux_measurePreserving_prismTailScalarAffine k d s a
      have he₀symm : MeasurePreserving e₀.symm volume volume := he₀.symm e₀
      rw [show aux_prismTailMap (Fin.succ j) s a =
          fun t : RealVector (d + 1) =>
            Fin.cons (s - coordinateSum a - coordinateSum t) (eraseVector j t) by
        funext t
        exact aux_prismTailMap_succ j s a t]
      convert he₀symm.comp (hA.comp heⱼ) using 1
      funext t
      apply e₀.injective
      change e₀ (Fin.cons (s - coordinateSum a - coordinateSum t) (eraseVector j t)) =
        e₀ (e₀.symm (A (eⱼ t)))
      rw [MeasurableEquiv.apply_symm_apply]
      rw [aux_prismTailSplitEquiv_apply]
      rw [aux_prismTailSplitEquiv_apply]
      simp only [Fin.cons_zero]
      rw [aux_coordinateSum_eraseVector d j t]
      apply Prod.ext
      · ring
      · rfl

/-- The first block of a prism pullback is the corresponding cube translation. -/
theorem aux_cubeCorner_eq_cubeShift (k : ℕ) (h : Fin k → Fin 2)
    (a u : RealVector k) :
    cubeCorner (a, a + u) h = cubeShift k k le_rfl h u a := by
  funext j
  simp [cubeCorner, cubeShift, cubeShiftVector]
  split_ifs <;> ring

/-- Every affine map `\pi_{h,i}` in the prism Brascamp--Lieb proof is Haar preserving. -/
theorem aux_measurePreserving_prismPullback (n k : ℕ) (hkn : k ≤ n)
    (h : Fin k → Fin 2) (i : Fin (n - k + 1)) (u : RealVector k) (s : ℝ) :
    MeasurePreserving (aux_prismPullback n k hkn h i u s) volume volume := by
  let f : RealVector k → RealVector k := fun a => cubeCorner (a, a + u) h
  have hfEq : f = cubeShift k k le_rfl h u := by
    funext a
    exact aux_cubeCorner_eq_cubeShift k h a u
  have hf : MeasurePreserving f volume volume := by
    rw [hfEq]
    exact aux_measurePreserving_cubeShift k k le_rfl h u
  have hfiberCont : Continuous
      (fun p : RealVector k × RealVector (n - k) => aux_prismFiber s p.1 p.2) := by
    apply continuous_pi
    intro r
    refine Fin.cases ?_ ?_ r
    · exact (continuous_const.sub
        ((aux_continuous_coordinateSum k).comp continuous_fst)).sub
        ((aux_continuous_coordinateSum (n - k)).comp continuous_snd)
    · intro q
      exact (continuous_apply q).comp continuous_snd
  have htailCont : Continuous
      (fun p : RealVector k × RealVector (n - k) =>
        aux_prismTailMap i s p.1 p.2) := by
    apply continuous_pi
    intro r
    change Continuous (fun p : RealVector k × RealVector (n - k) =>
      aux_prismFiber s p.1 p.2 (i.succAbove r))
    exact (continuous_apply (i.succAbove r)).comp hfiberCont
  let B : RealVector k × RealVector (n - k) →
      RealVector k × RealVector (n - k) := fun p =>
    (f p.1, aux_prismTailMap i s p.1 p.2)
  have hBProd : MeasurePreserving B
      ((volume : Measure (RealVector k)).prod (volume : Measure (RealVector (n - k))))
      ((volume : Measure (RealVector k)).prod (volume : Measure (RealVector (n - k)))) := by
    have hB := MeasurePreserving.skew_product
      (μa := (volume : Measure (RealVector k))) (μb := (volume : Measure (RealVector k)))
      (μc := (volume : Measure (RealVector (n - k))))
      (μd := (volume : Measure (RealVector (n - k))))
      (g := fun a t => aux_prismTailMap i s a t) hf htailCont.measurable
      (ae_of_all _ fun a => (aux_measurePreserving_prismTailMap k (n - k) i s a).map_eq)
    simpa only [B, id_eq] using hB
  have hB : MeasurePreserving B
      (volume : Measure (RealVector k × RealVector (n - k)))
      (volume : Measure (RealVector k × RealVector (n - k))) := by
    simpa only [Measure.volume_eq_prod] using hBProd
  let e := aux_concatVectorEquiv n k hkn
  have he : MeasurePreserving e volume volume := by
    simpa [e] using aux_measurePreserving_concatVector n k hkn
  have hesymm : MeasurePreserving e.symm volume volume := he.symm e
  have hformula : aux_prismPullback n k hkn h i u s =
      fun z => e (B (e.symm z)) := by
    funext z
    change concatVector n k hkn
      (cubeCorner ((e.symm z).1, (e.symm z).1 + u) h)
      (aux_prismTailMap i s (e.symm z).1 (e.symm z).2) =
        e (B (e.symm z))
    simpa [e, B, f] using
      (aux_concatVectorEquiv_apply n k hkn
        (cubeCorner ((e.symm z).1, (e.symm z).1 + u) h)
        (aux_prismTailMap i s (e.symm z).1 (e.symm z).2)).symm
  rw [hformula]
  exact he.comp (hB.comp hesymm)

/--
Joint measurability of the prism pullback in its affine parameters and its
Euclidean input.  It is needed to form the measure-preserving skew product
used when proving integrability of prism-form integrands.
-/
theorem aux_measurable_prismPullback (n k : ℕ) (hkn : k ≤ n) (h : Fin k → Fin 2)
    (i : Fin (n - k + 1)) :
    Measurable (Function.uncurry
      (fun p : RealVector k × ℝ => aux_prismPullback n k hkn h i p.1 p.2)) := by
  let e := aux_concatVectorEquiv n k hkn
  have hz : Measurable (fun p : (RealVector k × ℝ) × RealVector n => e.symm p.2) :=
    e.symm.measurable.comp measurable_snd
  have ha : Measurable (fun p : (RealVector k × ℝ) × RealVector n => (e.symm p.2).1) :=
    measurable_fst.comp hz
  have ht : Measurable (fun p : (RealVector k × ℝ) × RealVector n => (e.symm p.2).2) :=
    measurable_snd.comp hz
  have hcorner : Measurable (fun p : (RealVector k × ℝ) × RealVector n =>
      cubeCorner ((e.symm p.2).1, (e.symm p.2).1 + p.1.1) h) := by
    unfold cubeCorner
    apply measurable_pi_lambda
    intro j
    split_ifs <;> fun_prop
  have htail : Measurable (fun p : (RealVector k × ℝ) × RealVector n =>
      aux_prismTailMap i p.1.2 (e.symm p.2).1 (e.symm p.2).2) := by
    unfold aux_prismTailMap eraseVector
    apply measurable_pi_lambda
    intro j
    change Measurable (fun p : (RealVector k × ℝ) × RealVector n =>
      aux_prismFiber p.1.2 (e.symm p.2).1 (e.symm p.2).2 (i.succAbove j))
    refine Fin.cases ?_ (fun r => ?_) (i.succAbove j)
    · have hscalar := ((measurable_snd.comp measurable_fst).sub
          ((aux_continuous_coordinateSum k).measurable.comp ha)).sub
            ((aux_continuous_coordinateSum (n - k)).measurable.comp ht)
      change Measurable (fun p : (RealVector k × ℝ) × RealVector n =>
        p.1.2 - coordinateSum (e.symm p.2).1 - coordinateSum (e.symm p.2).2)
      convert hscalar using 1; rfl
    · simpa [aux_prismFiber, Function.comp_def] using (continuous_apply r).measurable.comp ht
  change Measurable (fun p : (RealVector k × ℝ) × RealVector n =>
    concatVector n k hkn
      (cubeCorner ((e.symm p.2).1, (e.symm p.2).1 + p.1.1) h)
      (aux_prismTailMap i p.1.2 (e.symm p.2).1 (e.symm p.2).2))
  have heq : (fun p : (RealVector k × ℝ) × RealVector n =>
      concatVector n k hkn
        (cubeCorner ((e.symm p.2).1, (e.symm p.2).1 + p.1.1) h)
        (aux_prismTailMap i p.1.2 (e.symm p.2).1 (e.symm p.2).2)) =
      fun p : (RealVector k × ℝ) × RealVector n =>
        e (cubeCorner ((e.symm p.2).1, (e.symm p.2).1 + p.1.1) h,
          aux_prismTailMap i p.1.2 (e.symm p.2).1 (e.symm p.2).2) := by
    funext p
    rw [aux_concatVectorEquiv_apply]
  rw [heq]
  exact e.measurable.comp (hcorner.prodMk htail)

/--
The prism pullback is jointly measure preserving after adjoining its affine
parameters.  This packages the fibrewise Haar preservation into the skew
product required for integrability estimates.
-/
theorem aux_measurePreserving_prismPullbackSkew (n k : ℕ) (hkn : k ≤ n)
    (h : Fin k → Fin 2) (i : Fin (n - k + 1)) :
    MeasurePreserving
      (fun p : (RealVector k × ℝ) × RealVector n =>
        (p.1, aux_prismPullback n k hkn h i p.1.1 p.1.2 p.2)) volume volume := by
  change MeasurePreserving _
    ((volume : Measure (RealVector k × ℝ)).prod (volume : Measure (RealVector n)))
    ((volume : Measure (RealVector k × ℝ)).prod (volume : Measure (RealVector n)))
  let g : (RealVector k × ℝ) → RealVector n → RealVector n := fun p z =>
    aux_prismPullback n k hkn h i p.1 p.2 z
  have hg : Measurable (Function.uncurry g) := by
    simpa [g] using aux_measurable_prismPullback n k hkn h i
  have hskew := MeasurePreserving.skew_product
    (μa := (volume : Measure (RealVector k × ℝ)))
    (μb := (volume : Measure (RealVector k × ℝ)))
    (μc := (volume : Measure (RealVector n)))
    (μd := (volume : Measure (RealVector n)))
    (g := g) (MeasurePreserving.id (volume : Measure (RealVector k × ℝ))) hg
    (ae_of_all _ fun p =>
      (aux_measurePreserving_prismPullback n k hkn h i p.1 p.2).map_eq)
  simpa [g, id_eq] using hskew

/--
The prism pullback remains Haar preserving after adjoining one scalar kernel
parameter.  This is the exact skew product needed to prove integrability of
the unintegrated lifted-kernel term in single-cancellative Cauchy--Schwarz.
-/
theorem aux_measurePreserving_prismPullbackSkewScalar (n k : ℕ) (hkn : k ≤ n)
    (h : Fin k → Fin 2) (i : Fin (n - k + 1)) :
    MeasurePreserving
      (fun p : ((RealVector k × ℝ) × ℝ) × RealVector n =>
        (p.1, aux_prismPullback n k hkn h i p.1.1.1 p.1.1.2 p.2)) volume volume := by
  change MeasurePreserving _
    ((volume : Measure ((RealVector k × ℝ) × ℝ)).prod (volume : Measure (RealVector n)))
    ((volume : Measure ((RealVector k × ℝ) × ℝ)).prod (volume : Measure (RealVector n)))
  let g : ((RealVector k × ℝ) × ℝ) → RealVector n → RealVector n := fun p z =>
    aux_prismPullback n k hkn h i p.1.1 p.1.2 z
  have hg : Measurable (Function.uncurry g) := by
    have hparams : Measurable
        (fun p : ((RealVector k × ℝ) × ℝ) × RealVector n => (p.1.1, p.2)) :=
      (measurable_fst.comp measurable_fst).prodMk measurable_snd
    exact (aux_measurable_prismPullback n k hkn h i).comp hparams
  have hskew := MeasurePreserving.skew_product
    (μa := (volume : Measure ((RealVector k × ℝ) × ℝ)))
    (μb := (volume : Measure ((RealVector k × ℝ) × ℝ)))
    (μc := (volume : Measure (RealVector n)))
    (μd := (volume : Measure (RealVector n)))
    (g := g) (MeasurePreserving.id (volume : Measure ((RealVector k × ℝ) × ℝ))) hg
    (ae_of_all _ fun p =>
      (aux_measurePreserving_prismPullback n k hkn h i p.1.1 p.1.2).map_eq)
  simpa [g, id_eq] using hskew

/--
Auxiliary global coordinate map for the prism Brascamp--Lieb estimate.  It is
the inverse of the manuscript's substitution from `(y^1,x_{k-1})` to `(u,s)`
together with the relabelling of the remaining variables as a point of
`\mathbb R^n`.
-/
def aux_prismCoordinates (n k : ℕ) (hkn : k ≤ n) :
    RealVector k × (ℝ × RealVector n) →
      (RealVector k × RealVector k) × RealVector (n - k + 1) := fun w =>
  let z := (aux_concatVectorEquiv n k hkn).symm w.2.2
  ((z.1, z.1 + w.1), aux_prismFiber w.2.1 z.1 z.2)

/-- The literal form of the global prism coordinate substitution. -/
theorem aux_prismCoordinates_apply (n k : ℕ) (hkn : k ≤ n) (u a : RealVector k)
    (s : ℝ) (t : RealVector (n - k)) :
    aux_prismCoordinates n k hkn (u, (s, concatVector n k hkn a t)) =
      ((a, a + u), aux_prismFiber s a t) := by
  rw [← aux_concatVectorEquiv_apply n k hkn a t]
  simp [aux_prismCoordinates]

/--
The global prism coordinate substitution preserves Haar volume.  This packages
the change from `(y^1,x_{k-1})` to `(u,s)` and the remaining-coordinate
relabelling, so it can be used as a single change of variables in the prism
Brascamp--Lieb estimate.
-/
theorem aux_measurePreserving_prismCoordinates (n k : ℕ) (hkn : k ≤ n) :
    MeasurePreserving (aux_prismCoordinates n k hkn) volume volume := by
  let e := aux_concatVectorEquiv n k hkn
  let A : RealVector k × (ℝ × RealVector n) →
      RealVector k × (ℝ × (RealVector k × RealVector (n - k))) := fun w =>
    (w.1, (w.2.1, e.symm w.2.2))
  have he : MeasurePreserving e volume volume := by
    simpa [e] using aux_measurePreserving_concatVector n k hkn
  have hesymm : MeasurePreserving e.symm volume volume := he.symm e
  have hA : MeasurePreserving A volume volume := by
    change MeasurePreserving
      (Prod.map (id : RealVector k → RealVector k)
        (Prod.map (id : ℝ → ℝ) e.symm)) volume volume
    simpa only [Measure.volume_eq_prod] using
      (MeasurePreserving.id (volume : Measure (RealVector k))).prod
        ((MeasurePreserving.id (volume : Measure ℝ)).prod hesymm)
  have hR : MeasurePreserving (aux_prismCoordinateReorderEquiv k (n - k)) volume volume :=
    aux_measurePreserving_prismCoordinateReorder k (n - k)
  let B : (RealVector k × RealVector k) × (ℝ × RealVector (n - k)) →
      (RealVector k × RealVector k) × (ℝ × RealVector (n - k)) := fun p =>
    ((p.1.1, p.1.1 + p.1.2),
      (p.2.1 - coordinateSum p.1.1 - coordinateSum p.2.2, p.2.2))
  have hbase : MeasurePreserving
      (fun a : RealVector k × RealVector k => (a.1, a.1 + a.2)) volume volume := by
    simpa only [Measure.volume_eq_prod] using aux_measurePreserving_cubeDifference_symm k
  have hBcont : Continuous (fun p : (RealVector k × RealVector k) ×
      (ℝ × RealVector (n - k)) =>
      (p.2.1 - coordinateSum p.1.1 - coordinateSum p.2.2, p.2.2)) := by
    have hq : Continuous (fun p : (RealVector k × RealVector k) ×
        (ℝ × RealVector (n - k)) => p.2.1) :=
      continuous_fst.comp continuous_snd
    have ha : Continuous (fun p : (RealVector k × RealVector k) ×
        (ℝ × RealVector (n - k)) => coordinateSum p.1.1) :=
      (aux_continuous_coordinateSum k).comp (continuous_fst.comp continuous_fst)
    have ht : Continuous (fun p : (RealVector k × RealVector k) ×
        (ℝ × RealVector (n - k)) => coordinateSum p.2.2) :=
      (aux_continuous_coordinateSum (n - k)).comp (continuous_snd.comp continuous_snd)
    exact ((hq.sub ha).sub ht).prodMk (continuous_snd.comp continuous_snd)
  have hBprod : MeasurePreserving B
      ((volume : Measure (RealVector k × RealVector k)).prod
        (volume : Measure (ℝ × RealVector (n - k))))
      ((volume : Measure (RealVector k × RealVector k)).prod
        (volume : Measure (ℝ × RealVector (n - k)))) := by
    have h := MeasurePreserving.skew_product
      (μa := (volume : Measure (RealVector k × RealVector k)))
      (μb := (volume : Measure (RealVector k × RealVector k)))
      (μc := (volume : Measure (ℝ × RealVector (n - k))))
      (μd := (volume : Measure (ℝ × RealVector (n - k))))
      (g := fun a q =>
        (q.1 - coordinateSum a.1 - coordinateSum q.2, q.2))
      hbase hBcont.measurable
      (ae_of_all _ fun a =>
        (aux_measurePreserving_prismTailScalarTranslation k (n - k) a.1).map_eq)
    simpa only [B, id_eq] using h
  have hB : MeasurePreserving B volume volume := by
    simpa only [Measure.volume_eq_prod] using hBprod
  let e₀ := aux_prismTailSplitEquiv (n - k) (0 : Fin (n - k + 1))
  have he₀ : MeasurePreserving e₀ volume volume := by
    simpa [e₀] using aux_measurePreserving_prismTailSplit (n - k) (0 : Fin (n - k + 1))
  have he₀symm : MeasurePreserving e₀.symm volume volume := he₀.symm e₀
  let C : (RealVector k × RealVector k) × (ℝ × RealVector (n - k)) →
      (RealVector k × RealVector k) × RealVector (n - k + 1) := fun p =>
    (p.1, e₀.symm p.2)
  have hC : MeasurePreserving C volume volume := by
    change MeasurePreserving
      (Prod.map (id : RealVector k × RealVector k → RealVector k × RealVector k) e₀.symm)
      volume volume
    simpa only [Measure.volume_eq_prod] using
      (MeasurePreserving.id (volume : Measure (RealVector k × RealVector k))).prod he₀symm
  have hcomp : MeasurePreserving
      (C ∘ B ∘ aux_prismCoordinateReorderEquiv k (n - k) ∘ A) volume volume :=
    hC.comp (hB.comp (hR.comp hA))
  have htail (s : ℝ) (a : RealVector k) (t : RealVector (n - k)) :
      e₀.symm (s - coordinateSum a - coordinateSum t, t) = aux_prismFiber s a t := by
    apply e₀.injective
    rw [MeasurableEquiv.apply_symm_apply, aux_prismTailSplitEquiv_apply]
    apply Prod.ext
    · rfl
    · funext j
      simp [aux_prismFiber, eraseVector]
  convert hcomp using 1
  funext w
  rcases w with ⟨u, s, z⟩
  obtain ⟨p, rfl⟩ := e.surjective z
  rcases p with ⟨a, t⟩
  have hcoords : aux_prismCoordinates n k hkn (u, (s, e (a, t))) =
      ((a, a + u), aux_prismFiber s a t) := by
    change aux_prismCoordinates n k hkn
      (u, (s, (aux_concatVectorEquiv n k hkn) (a, t))) =
        ((a, a + u), aux_prismFiber s a t)
    rw [aux_concatVectorEquiv_apply]
    exact aux_prismCoordinates_apply n k hkn u a s t
  simp only [Function.comp_apply, A, e, MeasurableEquiv.symm_apply_apply,
    aux_prismCoordinateReorderEquiv_apply, B, C]
  rw [hcoords]
  exact Prod.ext (Prod.ext rfl rfl) (htail s a t).symm

/-- The kernel arguments become exactly `(u,s)` after the prism substitution. -/
theorem aux_prismCoordinates_kernelArguments (n k : ℕ) (hkn : k ≤ n)
    (u : RealVector k) (s : ℝ) (z : RealVector n) :
    ((aux_prismCoordinates n k hkn (u, (s, z))).1.2 -
        (aux_prismCoordinates n k hkn (u, (s, z))).1.1,
      coordinateSum (aux_prismCoordinates n k hkn (u, (s, z))).1.1 +
        coordinateSum (aux_prismCoordinates n k hkn (u, (s, z))).2) = (u, s) := by
  let e := aux_concatVectorEquiv n k hkn
  obtain ⟨p, rfl⟩ := e.surjective z
  rcases p with ⟨a, t⟩
  have hcoords : aux_prismCoordinates n k hkn (u, (s, e (a, t))) =
      ((a, a + u), aux_prismFiber s a t) := by
    change aux_prismCoordinates n k hkn
      (u, (s, (aux_concatVectorEquiv n k hkn) (a, t))) =
        ((a, a + u), aux_prismFiber s a t)
    rw [aux_concatVectorEquiv_apply]
    exact aux_prismCoordinates_apply n k hkn u a s t
  rw [hcoords]
  apply Prod.ext
  · funext j
    change a j + u j - a j = u j
    ring
  · rw [aux_coordinateSum_prismFiber]
    ring

/--
Under the global prism substitution, each manuscript factor is its affine
pullback `\pi_{h,i}`.  This identifies the integrand with the Hölder product.
-/
theorem aux_prismPoint_eq_prismPullbackCoordinates (n k : ℕ) (hk : 1 ≤ k)
    (hkn : k ≤ n) (u : RealVector k) (s : ℝ) (z : RealVector n)
    (h : Fin k → Fin 2) (i : Fin (n - k + 1)) :
    prismPoint hk hkn (aux_prismCoordinates n k hkn (u, (s, z))).1
      (aux_prismCoordinates n k hkn (u, (s, z))).2 h i =
        aux_prismPullback n k hkn h i u s z := by
  let e := aux_concatVectorEquiv n k hkn
  obtain ⟨p, rfl⟩ := e.surjective z
  rcases p with ⟨a, t⟩
  have hcoords : aux_prismCoordinates n k hkn (u, (s, e (a, t))) =
      ((a, a + u), aux_prismFiber s a t) := by
    change aux_prismCoordinates n k hkn
      (u, (s, (aux_concatVectorEquiv n k hkn) (a, t))) =
        ((a, a + u), aux_prismFiber s a t)
    rw [aux_concatVectorEquiv_apply]
    exact aux_prismCoordinates_apply n k hkn u a s t
  rw [hcoords]
  change prismPoint hk hkn (a, a + u) (aux_prismFiber s a t) h i =
    aux_prismPullback n k hkn h i u s (e (a, t))
  change prismPoint hk hkn (a, a + u) (aux_prismFiber s a t) h i =
    aux_prismPullback n k hkn h i u s (aux_concatVectorEquiv n k hkn (a, t))
  rw [aux_concatVectorEquiv_apply]
  exact aux_prismPoint_eq_prismPullback n k hk hkn a t u s h i

/-- The prism-factor product becomes the product over the affine pullbacks. -/
theorem aux_prismCoordinates_product_eq (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n)
    (F : Fin n → RealVector n → ℝ) (u : RealVector k) (s : ℝ) (z : RealVector n) :
    (∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
      ‖F (prismIndex hk hkn i)
        (prismPoint hk hkn (aux_prismCoordinates n k hkn (u, (s, z))).1
          (aux_prismCoordinates n k hkn (u, (s, z))).2 h i)‖ₑ) =
      ∏ hi : (Fin k → Fin 2) × Fin (n - k + 1),
        ‖F (prismIndex hk hkn hi.2)
          (aux_prismPullback n k hkn hi.1 hi.2 u s z)‖ₑ := by
  rw [← Fintype.prod_prod_type'
    (fun h i => ‖F (prismIndex hk hkn i)
      (prismPoint hk hkn (aux_prismCoordinates n k hkn (u, (s, z))).1
        (aux_prismCoordinates n k hkn (u, (s, z))).2 h i)‖ₑ)]
  apply Finset.prod_congr rfl
  intro hi _
  exact congrArg (fun x => ‖F (prismIndex hk hkn hi.2) x‖ₑ)
    (aux_prismPoint_eq_prismPullbackCoordinates n k hk hkn u s z hi.1 hi.2)

/-- Auxiliary multiplicativity of the extended norm over a finite product of real factors. -/
theorem aux_enorm_fintype_prod {ι : Type*} [Fintype ι] (f : ι → ℝ) :
    ‖∏ i, f i‖ₑ = ∏ i, ‖f i‖ₑ := by
  classical
  change ‖(Finset.univ : Finset ι).prod f‖ₑ =
    (Finset.univ : Finset ι).prod (fun i => ‖f i‖ₑ)
  induction (Finset.univ : Finset ι) using Finset.induction_on with
  | empty => simp
  | insert i s hi ih => simp [hi, ih, enorm_mul]

/--
Auxiliary finite Holder inequality with individual natural exponents.  The
reciprocal-sum hypothesis is exactly the exponent bookkeeping needed for the
prism Brascamp--Lieb factors.
-/
theorem aux_lintegral_prod_enorm_le_eLpNorm_of_reciprocal_sum
    {α ι : Type*} [MeasurableSpace α] [Fintype ι] (μ : Measure α)
    (f : ι → α → ℝ) (hf : ∀ i, AEMeasurable (f i) μ) (p : ι → ℕ)
    (hp : ∀ i, p i ≠ 0) (hsum : ∑ i, ((p i : ℝ)⁻¹) = 1) :
    ∫⁻ x, ∏ i, ‖f i x‖ₑ ∂μ ≤ ∏ i, eLpNorm (f i) (p i : ℝ≥0∞) μ := by
  have hpR (i : ι) : (p i : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (hp i)
  have hholder :
      ∫⁻ x, ∏ i, (‖f i x‖ₑ ^ (p i : ℝ)) ^ ((p i : ℝ)⁻¹) ∂μ ≤
        ∏ i, (∫⁻ x, ‖f i x‖ₑ ^ (p i : ℝ) ∂μ) ^ ((p i : ℝ)⁻¹) := by
    simpa using ENNReal.lintegral_prod_norm_pow_le (ι := ι) (μ := μ) Finset.univ
      (f := fun i x => ‖f i x‖ₑ ^ (p i : ℝ))
      (fun i _ => ENNReal.continuous_rpow_const.measurable.comp_aemeasurable
        (measurable_enorm.comp_aemeasurable (hf i)))
      (p := fun i => (p i : ℝ)⁻¹) hsum
      (fun i _ => inv_nonneg.mpr (by positivity))
  have hnorm (i : ι) :
      (∫⁻ x, ‖f i x‖ₑ ^ (p i : ℝ) ∂μ) ^ ((p i : ℝ)⁻¹) =
        eLpNorm (f i) (p i : ℝ≥0∞) μ := by
    symm
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal]
    · simp
    · exact_mod_cast hp i
    · exact ENNReal.coe_ne_top
  calc
    (∫⁻ x, ∏ i, ‖f i x‖ₑ ∂μ) =
        ∫⁻ x, ∏ i, (‖f i x‖ₑ ^ (p i : ℝ)) ^ ((p i : ℝ)⁻¹) ∂μ := by
          apply lintegral_congr
          intro x
          apply Finset.prod_congr rfl
          intro i _
          symm
          rw [← ENNReal.rpow_mul,
            mul_inv_cancel₀ (hpR i), ENNReal.rpow_one]
    _ ≤ ∏ i, (∫⁻ x, ‖f i x‖ₑ ^ (p i : ℝ) ∂μ) ^ ((p i : ℝ)⁻¹) := hholder
    _ = ∏ i, eLpNorm (f i) (p i : ℝ≥0∞) μ := by
      apply Finset.prod_congr rfl
      intro i _
      exact hnorm i

/-- The `L^p` exponent attached to one simplex index in the prism estimate. -/
def aux_prismLpExponent (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n)
    (i : Fin (n - k + 1)) : ℕ :=
  2 ^ ((prismIndex hk hkn i).1 + min (n - (prismIndex hk hkn i).1) 2)

/--
Explicit form of a prism exponent: all but the final simplex index receive the
ordinary `i+2` exponent, while the final one receives the exceptional exponent.
-/
theorem aux_prismLpExponent_eq (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n)
    (i : Fin (n - k + 1)) :
    aux_prismLpExponent n k hk hkn i =
      if i.1 < n - k then 2 ^ (k + i.1 + 1) else 2 ^ (k + (n - k)) := by
  by_cases hi : i.1 < n - k
  · rw [if_pos hi]
    change 2 ^ (k - 1 + i.1 + min (n - (k - 1 + i.1)) 2) = 2 ^ (k + i.1 + 1)
    congr 1
    have hmin : min (n - (k - 1 + i.1)) 2 = 2 := by omega
    omega
  · rw [if_neg hi]
    have hilast : i.1 = n - k := by omega
    change 2 ^ (k - 1 + i.1 + min (n - (k - 1 + i.1)) 2) = 2 ^ (k + (n - k))
    congr 1
    have hmin : min (n - (k - 1 + i.1)) 2 = 1 := by omega
    omega

/-- The simplex-indexed form of the dyadic Holder identity. -/
theorem aux_prism_weight_sum (m : ℕ) :
    (∑ i : Fin (m + 1),
      (if i.1 < m then ((2 : ℝ) ^ (i.1 + 1))⁻¹ else ((2 : ℝ) ^ m)⁻¹)) = 1 := by
  classical
  induction m with
  | zero => norm_num
  | succ m ih =>
      rw [Fin.sum_univ_succ]
      simp only [Fin.val_zero, Nat.zero_lt_succ, ↓reduceIte, zero_add, pow_one]
      have htail (i : Fin (m + 1)) :
          (if (Fin.succ i).1 < m + 1 then
              ((2 : ℝ) ^ ((Fin.succ i).1 + 1))⁻¹ else ((2 : ℝ) ^ (m + 1))⁻¹) =
            (2 : ℝ)⁻¹ *
              (if i.1 < m then ((2 : ℝ) ^ (i.1 + 1))⁻¹ else ((2 : ℝ) ^ m)⁻¹) := by
        simp only [Fin.val_succ]
        by_cases hi : i.1 < m
        · rw [if_pos (by omega), if_pos hi]
          rw [show i.1 + 1 + 1 = (i.1 + 1) + 1 by omega, pow_succ, mul_inv_rev]
        · rw [if_neg (by omega), if_neg hi, pow_succ, mul_inv_rev]
      calc
        (2 : ℝ)⁻¹ +
            ∑ i : Fin (m + 1),
              (if (Fin.succ i).1 < m + 1 then
                  ((2 : ℝ) ^ ((Fin.succ i).1 + 1))⁻¹ else
                    ((2 : ℝ) ^ (m + 1))⁻¹) =
            (2 : ℝ)⁻¹ +
              ∑ i : Fin (m + 1), (2 : ℝ)⁻¹ *
                (if i.1 < m then ((2 : ℝ) ^ (i.1 + 1))⁻¹ else ((2 : ℝ) ^ m)⁻¹) := by
              congr 2
              funext i
              exact htail i
        _ = (2 : ℝ)⁻¹ + (2 : ℝ)⁻¹ *
              ∑ i : Fin (m + 1),
                (if i.1 < m then ((2 : ℝ) ^ (i.1 + 1))⁻¹ else ((2 : ℝ) ^ m)⁻¹) := by
              rw [Finset.mul_sum]
        _ = 1 := by rw [ih]; norm_num

/-- The reciprocal prism exponents sum to the inverse cube cardinality. -/
theorem aux_prismLpExponent_simplex_sum (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n) :
    ∑ i : Fin (n - k + 1), ((aux_prismLpExponent n k hk hkn i : ℝ)⁻¹) =
      ((2 : ℝ) ^ k)⁻¹ := by
  let m := n - k
  have hfactor (r : ℕ) :
      ((2 : ℝ) ^ (k + r))⁻¹ = ((2 : ℝ) ^ k)⁻¹ * ((2 : ℝ) ^ r)⁻¹ := by
    rw [pow_add, mul_inv_rev]
    ring
  calc
    (∑ i : Fin (n - k + 1), ((aux_prismLpExponent n k hk hkn i : ℝ)⁻¹)) =
        ∑ i : Fin (n - k + 1),
          if i.1 < m then ((2 : ℝ) ^ (k + i.1 + 1))⁻¹ else
            ((2 : ℝ) ^ (k + m))⁻¹ := by
      apply Finset.sum_congr rfl
      intro i _
      rw [aux_prismLpExponent_eq n k hk hkn i]
      by_cases hi : i.1 < n - k <;> simp [m, hi, Nat.cast_pow]
    _ = ∑ i : Fin (n - k + 1), ((2 : ℝ) ^ k)⁻¹ *
          (if i.1 < m then ((2 : ℝ) ^ (i.1 + 1))⁻¹ else ((2 : ℝ) ^ m)⁻¹) := by
      apply Finset.sum_congr rfl
      intro i _
      by_cases hi : i.1 < m
      · simp only [hi, ↓reduceIte]
        simpa [Nat.add_assoc] using hfactor (i.1 + 1)
      · simp only [hi, ↓reduceIte]
        exact hfactor m
    _ = ((2 : ℝ) ^ k)⁻¹ *
        ∑ i : Fin (n - k + 1),
          (if i.1 < m then ((2 : ℝ) ^ (i.1 + 1))⁻¹ else ((2 : ℝ) ^ m)⁻¹) := by
      rw [Finset.mul_sum]
    _ = ((2 : ℝ) ^ k)⁻¹ := by
      dsimp [m]
      rw [aux_prism_weight_sum]
      simp

/-- The reciprocal exponents of all prism factors sum to one. -/
theorem aux_prismLpExponent_factor_sum (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n) :
    ∑ hi : (Fin k → Fin 2) × Fin (n - k + 1),
      ((aux_prismLpExponent n k hk hkn hi.2 : ℝ)⁻¹) = 1 := by
  classical
  rw [Fintype.sum_prod_type]
  calc
    (∑ h : Fin k → Fin 2, ∑ i : Fin (n - k + 1),
        ((aux_prismLpExponent n k hk hkn i : ℝ)⁻¹)) =
        ∑ _h : Fin k → Fin 2, ((2 : ℝ) ^ k)⁻¹ := by
      apply Finset.sum_congr rfl
      intro h _
      exact aux_prismLpExponent_simplex_sum n k hk hkn
    _ = 1 := by
      simp [Nat.cast_pow]

/-- Auxiliary name for the final coordinate in a positive-dimensional real vector. -/
def aux_topIndex (n : ℕ) (hn : 1 ≤ n) : Fin n := ⟨n - 1, by omega⟩

/-- The unique simplex index in the fibre occurring when the prism level is `n`. -/
def aux_topFiberIndex (n : ℕ) : Fin (n - n + 1) := ⟨0, by omega⟩

/-- The canonical copy of an `ℝ^1` vector in the top prism's singleton fibre. -/
def aux_topFiberVector (n : ℕ) (x : RealVector 1) : RealVector (n - n + 1) :=
  fun _ => x 0

/-- At the top prism level, the sole simplex index is the final function index. -/
theorem aux_prismIndex_top (n : ℕ) (hn : 1 ≤ n) :
    prismIndex (n := n) (k := n) hn le_rfl (aux_topFiberIndex n) = aux_topIndex n hn := by
  apply Fin.ext
  change n - 1 + (aux_topFiberIndex n).val = n - 1
  change n - 1 + 0 = n - 1
  omega

/-- Auxiliary version of the top-index fact for an arbitrary element of the singleton fibre. -/
theorem aux_prismIndex_top_apply (n : ℕ) (hn : 1 ≤ n) (i : Fin (n - n + 1)) :
    prismIndex (n := n) (k := n) hn le_rfl i = aux_topIndex n hn := by
  have hi : i = aux_topFiberIndex n := Fin.ext (by omega)
  rw [hi]
  exact aux_prismIndex_top n hn

/--
Auxiliary version of the top-point fact for an arbitrary singleton-fibre vector.
It is used to simplify the literal prism form before applying one-dimensional
cancellation.
-/
theorem aux_prismPoint_top_apply (n : ℕ) (hn : 1 ≤ n) (y : RealVector n × RealVector n)
    (x : RealVector (n - n + 1)) (h : Fin n → Fin 2) (i : Fin (n - n + 1)) :
    prismPoint (n := n) (k := n) hn le_rfl y x h i = cubeCorner y h := by
  funext j
  simp [prismPoint, concatVector, j.isLt]

/-- Auxiliary simplification of the coordinate sum in a one-dimensional fibre. -/
theorem aux_coordinateSum_finOne (x : RealVector 1) : coordinateSum x = x 0 := by
  simp [coordinateSum]

/-- The coordinate sum on the singleton top fibre is its unique coordinate. -/
theorem aux_coordinateSum_topFiber (n : ℕ) (x : RealVector (n - n + 1)) :
    coordinateSum x = x (aux_topFiberIndex n) := by
  unfold coordinateSum
  rw [Finset.sum_eq_single_of_mem (aux_topFiberIndex n) (Finset.mem_univ _)]
  intro i _ hi
  exact (hi (Fin.ext (by omega))).elim

/--
\begin{definition}[normalized function tuples]\label{normalized function tuples}
 Let $\mathfrak{F}$ be the set of tuples
$\F=(F_i)_{i\in [n)}$ of real-valued functions in $\mathcal{S}(\R^n)$
satisfying for $i\in [n)$ the normalization
 \[ \|F_{i}\|_{2^{i+\min(n-i,2)}}=1. \]
In other words,
 \begin{equation}\label{f-normalization}
  \|F_{i}\|_{2^{i+2}}=1\;\text{if}\;i\le n-2\;\text{and}\;\|F_{n-1}\|_{2^{n}}=1  \, .
 \end{equation}
\end{definition}
-/
def normalizedFunctionTuples (n : ℕ) : Set (Fin n → SchwartzMap (RealVector n) ℝ) :=
  {F | ∀ i, eLpNorm (F i) ((2 ^ (i.1 + min (n - i.1) 2) : ℕ) : ℝ≥0∞) volume = 1}

/-- A tuple belonging to `normalizedFunctionTuples n`. -/
abbrev NormalizedFunctionTuple (n : ℕ) := {F : Fin n → SchwartzMap (RealVector n) ℝ //
  F ∈ normalizedFunctionTuples n}

/--
Auxiliary preservation of normalized function tuples under the interchange of
the final two functions.  It is used by
`doublyCancellativeCauchySchwarz_bound`, where those two functions have the
same prescribed exponent.
-/
theorem aux_normalizedFunctionTuples_swap_lastTwo (n : ℕ) (hn : 2 ≤ n)
    (F : Fin n → SchwartzMap (RealVector n) ℝ)
    (hF : F ∈ normalizedFunctionTuples n) :
    (fun i => F (Equiv.swap (⟨n - 2, by omega⟩ : Fin n)
      (⟨n - 1, by omega⟩ : Fin n) i)) ∈
      normalizedFunctionTuples n := by
  classical
  let a : Fin n := ⟨n - 2, by omega⟩
  let b : Fin n := ⟨n - 1, by omega⟩
  have hab : (2 ^ (a.1 + min (n - a.1) 2) : ℕ) =
      2 ^ (b.1 + min (n - b.1) 2) := by
    dsimp [a, b]
    rw [Nat.sub_sub_self hn, Nat.sub_sub_self (by omega : 1 ≤ n)]
    norm_num
    rw [Nat.sub_add_cancel hn, Nat.sub_add_cancel (by omega : 1 ≤ n)]
  simp only [normalizedFunctionTuples, Set.mem_ofPred_eq] at hF ⊢
  change ∀ i : Fin n,
    eLpNorm (F (Equiv.swap a b i))
      ((2 ^ (i.1 + min (n - i.1) 2) : ℕ) : ℝ≥0∞) volume = 1
  intro i
  by_cases hia : i = a
  · subst i
    rw [Equiv.swap_apply_left, hab]
    exact hF b
  by_cases hib : i = b
  · subst i
    rw [Equiv.swap_apply_right, ← hab]
    exact hF a
  rw [Equiv.swap_apply_of_ne_of_ne hia hib]
  exact hF i

/--
\begin{definition}[cube Brascamp--Lieb form]\label{cube Brascamp--Lieb}
Define for $k\in\N$ with $1 \le k\le n$
and $L\in W_0(\R^k)$ and $F\in W_0(\R^n)$
\[ \Theta_{{\rm cube}}(k,L)(F) = \int_{(\R^2)^k} \int_{\R^{n-k}} L(y^1-y^0)
  \Big(\prod_{h\in [2)^k} F(y^h, x_{[k,n)})\Big)^{2^{\min(n-k,1)}}
  \;dx_{[k,n)}\,dy.\]
\end{definition}
-/
def cubeBrascampLiebForm (n k : ℕ) (_hk : 1 ≤ k) (hkn : k ≤ n) (L : CubeKernel k)
    (F : RealVector n → ℝ) : ℝ :=
  ∫ y : RealVector k × RealVector k, ∫ x : RealVector (n - k),
    L (y.2 - y.1) *
      (∏ h : Fin k → Fin 2, F (concatVector n k hkn (cubeCorner y h) x)) ^
        (2 ^ min (n - k) 1)

/--
Auxiliary normalized cube estimate.  This is the H\"older calculation in the
proof of the cube Brascamp--Lieb inequality, after the cube corners have
been expressed as the translated maps `cubeShift`.
-/
theorem aux_cube_lintegral_le_one (n k : ℕ) (hkn : k ≤ n)
    (F : RealVector n → ℝ) (hF : MemW0 F)
    (hFnorm : eLpNorm F ((2 ^ (k + min (n - k) 1) : ℕ) : ℝ≥0∞) volume = 1)
    (u : RealVector k) :
    ∫⁻ z : RealVector n,
      ‖(∏ h : Fin k → Fin 2, F (cubeShift n k hkn h u z)) ^
        (2 ^ min (n - k) 1)‖ₑ ∂volume ≤ 1 := by
  let a : ℝ := (2 ^ min (n - k) 1 : ℕ)
  have ha : 0 < a := by
    dsimp [a]
    positivity
  have hcardpos : 0 < Fintype.card (Fin k → Fin 2) := by
    exact Fintype.card_pos_iff.mpr inferInstance
  let g : (Fin k → Fin 2) → RealVector n → ℝ≥0∞ :=
    fun h z => ‖F (cubeShift n k hkn h u z)‖ₑ ^ a
  have hg (h : Fin k → Fin 2) : AEMeasurable (g h) volume := by
    have hshift : Continuous (cubeShift n k hkn h u) := by
      unfold cubeShift
      fun_prop
    dsimp [g]
    exact ENNReal.continuous_rpow_const.measurable.comp_aemeasurable
      (measurable_enorm.comp_aemeasurable
        ((hF.aux_continuous.comp hshift).aemeasurable))
  have hholder := aux_lintegral_prod_le_eLpNorm_fintype volume hcardpos g hg
  have hexponent :
      (Fintype.card (Fin k → Fin 2) : ℝ≥0∞) * ENNReal.ofReal a =
        ((2 ^ (k + min (n - k) 1) : ℕ) : ℝ≥0∞) := by
    have hp : ((2 ^ k : ℕ) : ℝ≥0∞) *
        ((2 ^ min (n - k) 1 : ℕ) : ℝ≥0∞) =
        ((2 ^ (k + min (n - k) 1) : ℕ) : ℝ≥0∞) := by
      rw [← Nat.cast_mul, ← pow_add]
    simpa [a, Fintype.card_fun] using hp
  have hshiftNorm (h : Fin k → Fin 2) :
      eLpNorm (fun z : RealVector n => F (cubeShift n k hkn h u z))
          ((2 ^ (k + min (n - k) 1) : ℕ) : ℝ≥0∞) volume =
        eLpNorm F ((2 ^ (k + min (n - k) 1) : ℕ) : ℝ≥0∞) volume := by
    simpa [Function.comp_def] using
      (eLpNorm_comp_measurePreserving
        (g := F) (f := cubeShift n k hkn h u)
        hF.aux_continuous.aestronglyMeasurable
        (aux_measurePreserving_cubeShift n k hkn h u))
  have hnorm (h : Fin k → Fin 2) :
      eLpNorm (g h) (Fintype.card (Fin k → Fin 2) : ℝ≥0∞) volume = 1 := by
    change eLpNorm (fun z : RealVector n =>
      ‖F (cubeShift n k hkn h u z)‖ₑ ^ a)
        (Fintype.card (Fin k → Fin 2) : ℝ≥0∞) volume = 1
    calc
      eLpNorm (fun z : RealVector n => ‖F (cubeShift n k hkn h u z)‖ₑ ^ a)
          (Fintype.card (Fin k → Fin 2) : ℝ≥0∞) volume =
          eLpNorm (fun z : RealVector n => F (cubeShift n k hkn h u z))
            ((Fintype.card (Fin k → Fin 2) : ℝ≥0∞) * ENNReal.ofReal a) volume ^ a :=
        eLpNorm_enorm_rpow _ ha
      _ = eLpNorm (fun z : RealVector n => F (cubeShift n k hkn h u z))
            ((2 ^ (k + min (n - k) 1) : ℕ) : ℝ≥0∞) volume ^ a := by
          rw [hexponent]
      _ = 1 := by
          rw [hshiftNorm h, hFnorm]
          simp
  calc
    (∫⁻ z : RealVector n,
      ‖(∏ h : Fin k → Fin 2, F (cubeShift n k hkn h u z)) ^
        (2 ^ min (n - k) 1)‖ₑ ∂volume) =
        ∫⁻ z : RealVector n, ∏ h : Fin k → Fin 2, g h z ∂volume := by
          apply lintegral_congr
          intro z
          symm
          dsimp [g]
          rw [ENNReal.prod_rpow_of_nonneg ha.le, ENNReal.rpow_natCast, enorm_pow]
          congr 1
          simp [enorm_eq_nnnorm]
    _ ≤ ∏ h : Fin k → Fin 2,
        eLpNorm (g h) (Fintype.card (Fin k → Fin 2) : ℝ≥0∞) volume := hholder
    _ = 1 := by
      simp_rw [hnorm]
      simp

/--
Auxiliary change-of-variables form of the normalized cube estimate.  It
packages the substitution `(y⁰,u,x) \mapsto (y⁰,y⁰+u,x)` together with the
coordinate concatenation, so the outer kernel integration can use the
pointwise cube bound.
-/
theorem aux_cube_corner_lintegral_le_one (n k : ℕ) (hkn : k ≤ n)
    (F : RealVector n → ℝ) (hF : MemW0 F)
    (hFnorm : eLpNorm F ((2 ^ (k + min (n - k) 1) : ℕ) : ℝ≥0∞) volume = 1)
    (u : RealVector k) :
    ∫⁻ y : RealVector k, ∫⁻ x : RealVector (n - k),
      ‖(∏ h : Fin k → Fin 2,
        F (concatVector n k hkn (cubeCorner (y, y + u) h) x)) ^
        (2 ^ min (n - k) 1)‖ₑ ∂volume ∂volume ≤ 1 := by
  let B : RealVector n → ℝ≥0∞ := fun z =>
    ‖(∏ h : Fin k → Fin 2, F (cubeShift n k hkn h u z)) ^
      (2 ^ min (n - k) 1)‖ₑ
  have hshiftCont (h : Fin k → Fin 2) : Continuous (cubeShift n k hkn h u) := by
    unfold cubeShift
    fun_prop
  have hprodCont : Continuous (fun z : RealVector n =>
      ∏ h : Fin k → Fin 2, F (cubeShift n k hkn h u z)) := by
    apply continuous_finsetProd Finset.univ
    intro h _
    exact hF.aux_continuous.comp (hshiftCont h)
  have hBmeas : Measurable B := by
    dsimp [B]
    exact (hprodCont.pow _).enorm.measurable
  let C : RealVector k × RealVector (n - k) → ℝ≥0∞ := fun p =>
    ‖(∏ h : Fin k → Fin 2,
      F (concatVector n k hkn (cubeCorner (p.1, p.1 + u) h) p.2)) ^
      (2 ^ min (n - k) 1)‖ₑ
  have hCeq : C = B ∘ aux_concatVectorEquiv n k hkn := by
    funext p
    rcases p with ⟨y, x⟩
    simp only [B, C, Function.comp_apply, aux_concatVectorEquiv_apply]
    congr 3
    funext h
    congr 1
    exact aux_concat_cubeCorner_eq_cubeShift n k hkn y u x h
  have hCmeas : Measurable C := by
    rw [hCeq]
    exact hBmeas.comp (aux_concatVectorEquiv n k hkn).measurable
  change ∫⁻ y : RealVector k, ∫⁻ x : RealVector (n - k), C (y, x) ∂volume ∂volume ≤ 1
  calc
    (∫⁻ y : RealVector k, ∫⁻ x : RealVector (n - k), C (y, x) ∂volume ∂volume) =
        ∫⁻ p : RealVector k × RealVector (n - k), C p ∂volume := by
          simpa only [Measure.volume_eq_prod] using
            (lintegral_prod C hCmeas.aemeasurable).symm
    _ = ∫⁻ z : RealVector n, B z ∂volume := by
          rw [hCeq]
          exact (aux_measurePreserving_concatVector n k hkn).lintegral_comp hBmeas
    _ ≤ 1 := aux_cube_lintegral_le_one n k hkn F hF hFnorm u

/--
\begin{proposition}[cube BL inequality]\label{cube BL inequality}
Let $k\in\N$ satisfy $1 \le k\le n$. Let $L\in W_0(\R^k)$. Then, for all
$F\in W_0(\R^n)$ with $\|F\|_{2^{k+\min(n-k,1)}}=1$,
\begin{equation}\label{cube-k-m-bound}
   |\Theta_{\rm cube}(k,L)(F)| \le\|L\|_1 .
\end{equation}
\end{proposition}
-/
theorem cubeBLInequality (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n)
    (L : CubeKernel k) (hL : MemW0 L) (F : RealVector n → ℝ) (hF : MemW0 F)
    (hFnorm : eLpNorm F ((2 ^ (k + min (n - k) 1) : ℕ) : ℝ≥0∞) volume = 1) :
    ‖cubeBrascampLiebForm n k hk hkn L F‖ₑ ≤ eLpNorm L 1 volume := by
  classical
  let H : ((RealVector k × RealVector k) × RealVector (n - k)) → ℝ≥0∞ := fun p =>
    ‖L (p.1.2 - p.1.1) *
      (∏ h : Fin k → Fin 2,
        F (concatVector n k hkn (cubeCorner p.1 h) p.2)) ^
        (2 ^ min (n - k) 1)‖ₑ
  have hcornerHCont (h : Fin k → Fin 2) : Continuous
      (fun p : (RealVector k × RealVector k) × RealVector (n - k) =>
        concatVector n k hkn (cubeCorner p.1 h) p.2) := by
    apply continuous_pi
    intro i
    unfold concatVector
    split_ifs with hi
    · unfold cubeCorner
      split_ifs <;> fun_prop
    · fun_prop
  have hprodHCont : Continuous
      (fun p : (RealVector k × RealVector k) × RealVector (n - k) =>
        ∏ h : Fin k → Fin 2,
          F (concatVector n k hkn (cubeCorner p.1 h) p.2)) := by
    apply continuous_finsetProd Finset.univ
    intro h _
    exact hF.aux_continuous.comp (hcornerHCont h)
  have hdiffCont : Continuous
      (fun p : (RealVector k × RealVector k) × RealVector (n - k) => p.1.2 - p.1.1) := by
    fun_prop
  have hHmeas : Measurable H := by
    dsimp [H]
    exact measurable_enorm.comp
      ((hL.aux_continuous.comp hdiffCont).mul (hprodHCont.pow _)).measurable
  let Q : RealVector k × (RealVector k × RealVector (n - k)) → ℝ≥0∞ := fun p =>
    ‖(∏ h : Fin k → Fin 2,
      F (concatVector n k hkn
        (cubeCorner (p.2.1, p.2.1 + p.1) h) p.2.2)) ^
      (2 ^ min (n - k) 1)‖ₑ
  have hcornerQCont (h : Fin k → Fin 2) : Continuous
      (fun p : RealVector k × (RealVector k × RealVector (n - k)) =>
        concatVector n k hkn
          (cubeCorner (p.2.1, p.2.1 + p.1) h) p.2.2) := by
    apply continuous_pi
    intro i
    unfold concatVector
    split_ifs with hi
    · unfold cubeCorner
      split_ifs <;> fun_prop
    · fun_prop
  have hprodQCont : Continuous
      (fun p : RealVector k × (RealVector k × RealVector (n - k)) =>
        ∏ h : Fin k → Fin 2,
          F (concatVector n k hkn
            (cubeCorner (p.2.1, p.2.1 + p.1) h) p.2.2)) := by
    apply continuous_finsetProd Finset.univ
    intro h _
    exact hF.aux_continuous.comp (hcornerQCont h)
  have hQmeas : Measurable Q := by
    dsimp [Q]
    exact (hprodQCont.pow _).enorm.measurable
  let G : RealVector k × (RealVector k × RealVector (n - k)) → ℝ≥0∞ := fun p =>
    ‖L p.1‖ₑ * Q p
  have hGmeas : Measurable G := by
    dsimp [G]
    exact (measurable_enorm.comp
      (hL.aux_continuous.comp continuous_fst).measurable).mul hQmeas
  let D : ((RealVector k × RealVector k) × RealVector (n - k)) →
      ((RealVector k × RealVector k) × RealVector (n - k)) := fun p =>
    ((p.1.1, p.1.1 + p.1.2), p.2)
  have hDmp : MeasurePreserving D volume volume := by
    simpa [D] using aux_measurePreserving_cubeDifferenceProd k (n - k)
  have hHDmeas : Measurable (H ∘ D) := hHmeas.comp hDmp.measurable
  have hDE : (fun w : RealVector k × (RealVector k × RealVector (n - k)) =>
      H (D (aux_cubeReorderEquiv k (n - k) w))) = G := by
    funext w
    rcases w with ⟨u, ⟨y, x⟩⟩
    simp [H, D, G, Q, aux_cubeReorderEquiv_apply]
  have hQuMeas (u : RealVector k) :
      Measurable (fun p : RealVector k × RealVector (n - k) => Q (u, p)) :=
    hQmeas.comp (continuous_const.prodMk continuous_id).measurable
  have hQbound (u : RealVector k) :
      ∫⁻ p : RealVector k × RealVector (n - k), Q (u, p) ∂volume ≤ 1 := by
    calc
      (∫⁻ p : RealVector k × RealVector (n - k), Q (u, p) ∂volume) =
          ∫⁻ y : RealVector k, ∫⁻ x : RealVector (n - k), Q (u, (y, x)) ∂volume ∂volume := by
            simpa only [Measure.volume_eq_prod] using
              (lintegral_prod (fun p : RealVector k × RealVector (n - k) => Q (u, p))
                (hQuMeas u).aemeasurable)
      _ ≤ 1 := by
        change ∫⁻ y : RealVector k, ∫⁻ x : RealVector (n - k),
          ‖(∏ h : Fin k → Fin 2,
            F (concatVector n k hkn (cubeCorner (y, y + u) h) x)) ^
            (2 ^ min (n - k) 1)‖ₑ ∂volume ∂volume ≤ 1
        exact aux_cube_corner_lintegral_le_one n k hkn F hF hFnorm u
  have hGinner (u : RealVector k) :
      ∫⁻ p : RealVector k × RealVector (n - k), G (u, p) ∂volume ≤ ‖L u‖ₑ := by
    change ∫⁻ p : RealVector k × RealVector (n - k), ‖L u‖ₑ * Q (u, p) ∂volume ≤ ‖L u‖ₑ
    calc
      (∫⁻ p : RealVector k × RealVector (n - k), ‖L u‖ₑ * Q (u, p) ∂volume) =
          ‖L u‖ₑ * ∫⁻ p : RealVector k × RealVector (n - k), Q (u, p) ∂volume :=
        lintegral_const_mul _ (hQuMeas u)
      _ ≤ ‖L u‖ₑ * 1 := mul_le_mul_right (hQbound u) _
      _ = ‖L u‖ₑ := mul_one _
  unfold cubeBrascampLiebForm
  calc
    ‖∫ y : RealVector k × RealVector k, ∫ x : RealVector (n - k),
      L (y.2 - y.1) *
        (∏ h : Fin k → Fin 2, F (concatVector n k hkn (cubeCorner y h) x)) ^
          (2 ^ min (n - k) 1)‖ₑ ≤
        ∫⁻ y : RealVector k × RealVector k,
          ‖∫ x : RealVector (n - k),
            L (y.2 - y.1) *
              (∏ h : Fin k → Fin 2, F (concatVector n k hkn (cubeCorner y h) x)) ^
                (2 ^ min (n - k) 1)‖ₑ ∂volume :=
      enorm_integral_le_lintegral_enorm _
    _ ≤ ∫⁻ y : RealVector k × RealVector k,
        ∫⁻ x : RealVector (n - k), H (y, x) ∂volume ∂volume := by
      apply lintegral_mono
      intro y
      change ‖∫ x : RealVector (n - k),
        L (y.2 - y.1) *
          (∏ h : Fin k → Fin 2, F (concatVector n k hkn (cubeCorner y h) x)) ^
            (2 ^ min (n - k) 1) ∂volume‖ₑ ≤
          ∫⁻ x : RealVector (n - k), ‖L (y.2 - y.1) *
            (∏ h : Fin k → Fin 2, F (concatVector n k hkn (cubeCorner y h) x)) ^
              (2 ^ min (n - k) 1)‖ₑ ∂volume
      exact enorm_integral_le_lintegral_enorm _
    _ = ∫⁻ p : (RealVector k × RealVector k) × RealVector (n - k), H p ∂volume := by
      simpa only [Measure.volume_eq_prod] using
        (lintegral_prod H hHmeas.aemeasurable).symm
    _ = ∫⁻ p : (RealVector k × RealVector k) × RealVector (n - k), H (D p) ∂volume :=
      (hDmp.lintegral_comp hHmeas).symm
    _ = ∫⁻ w : RealVector k × (RealVector k × RealVector (n - k)),
        H (D (aux_cubeReorderEquiv k (n - k) w)) ∂volume := by
      simpa [Function.comp_def] using
        ((aux_measurePreserving_cubeReorder k (n - k)).lintegral_comp hHDmeas).symm
    _ = ∫⁻ w : RealVector k × (RealVector k × RealVector (n - k)), G w ∂volume := by
      rw [hDE]
    _ = ∫⁻ u : RealVector k,
        ∫⁻ p : RealVector k × RealVector (n - k), G (u, p) ∂volume ∂volume := by
      simpa only [Measure.volume_eq_prod] using
        (lintegral_prod G hGmeas.aemeasurable)
    _ ≤ ∫⁻ u : RealVector k, ‖L u‖ₑ ∂volume := by
      apply lintegral_mono
      intro u
      exact hGinner u
    _ = eLpNorm L 1 volume := (eLpNorm_one_eq_lintegral_enorm).symm

/--
\begin{definition}[prism Brascamp--Lieb form]\label{prism Brascamp--Lieb}
Define for integers $1 \le k\le n$
and $K\in W_0(\R^{k+1})$ and $\F\in \mathfrak{F}$,
\[ \Theta_k(K)(\F) = \int_{(\R^{2})^k} \int_{\R^{n-k+1}}
K(y^1-y^0, \Sigma(y^0) + \Sigma(x_{[k-1,n)}))
\prod_{\substack{h\in [2)^k,\\i\in [k-1,n)}}
F_{i}( y^h, x_{[k-1,n)\setminus i})\;dx_{[k-1,n)}\;dy \]
\end{definition}
-/
def prismBrascampLiebForm (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n) (K : KKernel k)
    (F : Fin n → RealVector n → ℝ) : ℝ :=
  ∫ y : RealVector k × RealVector k, ∫ x : RealVector (n - k + 1),
    K (y.2 - y.1, coordinateSum y.1 + coordinateSum x) *
      ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
        F (prismIndex hk hkn i) (prismPoint hk hkn y x h i)

/--
Auxiliary absolute integrability of the raw prism-form integrand.  It combines
one integrable Schwartz factor with the kernel after the measure-preserving
prism pullback, and bounds all remaining Schwartz factors by their zeroth
Schwartz seminorms.  This supplies the Fubini hypotheses used in the
cancellation and positivity arguments.
-/
theorem aux_integrable_prismIntegrand (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n)
    (K : KKernel k) (hK : MemW0 K)
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    Integrable (fun p : (RealVector k × RealVector k) × RealVector (n - k + 1) =>
      K (p.1.2 - p.1.1, coordinateSum p.1.1 + coordinateSum p.2) *
        ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
          F (prismIndex hk hkn i) (prismPoint hk hkn p.1 p.2 h i)) := by
  classical
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k)) :=
    isAddHaarMeasure_volume_pi (Fin k)
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure ((RealVector k × ℝ) × RealVector n)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let I := (Fin k → Fin 2) × Fin (n - k + 1)
  let a : I := (fun _ => 0, 0)
  let P : I → (RealVector k × ℝ) × RealVector n → ℝ := fun hi w =>
    F (prismIndex hk hkn hi.2)
      (aux_prismPullback n k hkn hi.1 hi.2 w.1.1 w.1.2 w.2)
  let D : (RealVector k × ℝ) × RealVector n → ℝ := fun w =>
    K w.1 * P a w
  let R : (RealVector k × ℝ) × RealVector n → ℝ := fun w =>
    ∏ hi ∈ (Finset.univ.erase a), P hi w
  let C : ℝ := ∏ hi ∈ (Finset.univ.erase a),
    SchwartzMap.seminorm ℝ 0 0 (F (prismIndex hk hkn hi.2))
  let H : (RealVector k × ℝ) × RealVector n → ℝ := fun w =>
    K w.1 * ∏ hi : I, P hi w
  have hC : 0 ≤ C := by
    dsimp [C]
    positivity
  have hPmeas (hi : I) : Measurable (P hi) := by
    dsimp [P]
    exact (F (prismIndex hk hkn hi.2)).continuous.measurable.comp
      (aux_measurable_prismPullback n k hkn hi.1 hi.2)
  have hHmeas : Measurable H := by
    dsimp [H]
    apply (hK.aux_continuous.measurable.comp measurable_fst).mul
    apply Finset.measurable_fun_prod Finset.univ
    intro hi _
    exact hPmeas hi
  have hRbound (w : (RealVector k × ℝ) × RealVector n) : ‖R w‖ ≤ C := by
    dsimp [R, C]
    calc
      ‖∏ hi ∈ Finset.univ.erase a, P hi w‖ ≤
          ∏ hi ∈ Finset.univ.erase a, ‖P hi w‖ :=
        Finset.norm_prod_le _ _
      _ ≤ ∏ hi ∈ Finset.univ.erase a,
          SchwartzMap.seminorm ℝ 0 0 (F (prismIndex hk hkn hi.2)) := by
          gcongr with hi hhi
          exact (F (prismIndex hk hkn hi.2)).norm_le_seminorm ℝ _
  have hfactor (w : (RealVector k × ℝ) × RealVector n) : H w = D w * R w := by
    dsimp [H, D, R]
    rw [← Finset.mul_prod_erase Finset.univ (fun hi => P hi w)
      (Finset.mem_univ a)]
    ring
  have hbound (w : (RealVector k × ℝ) × RealVector n) : ‖H w‖ ≤ C * ‖D w‖ := by
    rw [hfactor]
    calc
      ‖D w * R w‖ = ‖D w‖ * ‖R w‖ := norm_mul _ _
      _ ≤ ‖D w‖ * C := mul_le_mul_of_nonneg_left (hRbound w) (norm_nonneg _)
      _ = C * ‖D w‖ := mul_comm _ _
  have hKint : Integrable K := aux_memW0_integrable_of_addHaar hK
  have hFint : Integrable (F (prismIndex hk hkn a.2) : RealVector n → ℝ) :=
    (F (prismIndex hk hkn a.2)).integrable
  have hTensorInt : Integrable (fun w : (RealVector k × ℝ) × RealVector n =>
      K w.1 * F (prismIndex hk hkn a.2) w.2) := hKint.mul_prod hFint
  have hD : Integrable D := by
    have hmp := aux_measurePreserving_prismPullbackSkew n k hkn a.1 a.2
    have hcomp := hmp.integrable_comp_of_integrable hTensorInt
    simpa [D, P, Function.comp_def] using hcomp
  have hH : Integrable H := by
    have hDom : Integrable (fun w => C * ‖D w‖) := hD.norm.const_mul C
    exact hDom.mono' hHmeas.aestronglyMeasurable (ae_of_all _ hbound)
  let G : (RealVector k × RealVector k) × RealVector (n - k + 1) → ℝ := fun p =>
    K (p.1.2 - p.1.1, coordinateSum p.1.1 + coordinateSum p.2) *
      ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
        F (prismIndex hk hkn i) (prismPoint hk hkn p.1 p.2 h i)
  have hpointCont (h : Fin k → Fin 2) (i : Fin (n - k + 1)) :
      Continuous (fun p : (RealVector k × RealVector k) × RealVector (n - k + 1) =>
        prismPoint hk hkn p.1 p.2 h i) := by
    apply continuous_pi
    intro j
    unfold prismPoint concatVector
    split_ifs with hj
    · unfold cubeCorner
      split_ifs <;> fun_prop
    · unfold eraseVector
      fun_prop
  have hprodGCont : Continuous
      (fun p : (RealVector k × RealVector k) × RealVector (n - k + 1) =>
        ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
          F (prismIndex hk hkn i) (prismPoint hk hkn p.1 p.2 h i)) := by
    apply continuous_finsetProd Finset.univ
    intro h _
    apply continuous_finsetProd Finset.univ
    intro i _
    exact (F (prismIndex hk hkn i)).continuous.comp (hpointCont h i)
  have hkernelArgCont : Continuous
      (fun p : (RealVector k × RealVector k) × RealVector (n - k + 1) =>
        (p.1.2 - p.1.1, coordinateSum p.1.1 + coordinateSum p.2)) := by
    have hu : Continuous (fun p : (RealVector k × RealVector k) ×
        RealVector (n - k + 1) => p.1.2 - p.1.1) :=
      (continuous_snd.comp continuous_fst).sub (continuous_fst.comp continuous_fst)
    have hs : Continuous (fun p : (RealVector k × RealVector k) ×
        RealVector (n - k + 1) => coordinateSum p.1.1 + coordinateSum p.2) :=
      ((aux_continuous_coordinateSum k).comp (continuous_fst.comp continuous_fst)).add
        ((aux_continuous_coordinateSum (n - k + 1)).comp continuous_snd)
    exact hu.prodMk hs
  have hGmeas : Measurable G := by
    dsimp [G]
    exact ((hK.aux_continuous.comp hkernelArgCont).mul hprodGCont).measurable
  have hAssoc : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm : RealVector k × (ℝ × RealVector n) ≃ᵐ
        (RealVector k × ℝ) × RealVector n) volume volume :=
    (volume_preserving_prodAssoc (α₁ := RealVector k) (β₁ := ℝ)
      (γ₁ := RealVector n)).symm
  have hGH : G ∘ aux_prismCoordinates n k hkn =
      H ∘ (MeasurableEquiv.prodAssoc.symm : RealVector k × (ℝ × RealVector n) ≃ᵐ
        (RealVector k × ℝ) × RealVector n) := by
    funext w
    dsimp [G, H, P]
    rw [aux_prismCoordinates_kernelArguments n k hkn w.1 w.2.1 w.2.2]
    congr 1
    rw [← Fintype.prod_prod_type'
      (fun h i => F (prismIndex hk hkn i)
        (prismPoint hk hkn (aux_prismCoordinates n k hkn w).1
          (aux_prismCoordinates n k hkn w).2 h i))]
    apply Finset.prod_congr rfl
    intro hi _
    exact congrArg (F (prismIndex hk hkn hi.2))
      (aux_prismPoint_eq_prismPullbackCoordinates n k hk hkn w.1 w.2.1 w.2.2 hi.1 hi.2)
  have hGcomp : Integrable (G ∘ aux_prismCoordinates n k hkn) := by
    rw [hGH]
    exact hAssoc.integrable_comp_of_integrable hH
  have hG := ((aux_measurePreserving_prismCoordinates n k hkn).integrable_comp
    hGmeas.aestronglyMeasurable).mp hGcomp
  simpa [G] using hG

/--
Auxiliary global-coordinate expression for the prism form.  It is the
Fubini/change-of-variables step used immediately in the cancellative
Cauchy--Schwarz argument: the kernel arguments become the independent
coordinates `(u,s)`, while each function factor becomes its prism pullback.
-/
theorem aux_prismBrascampLiebForm_eq_global (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n)
    (K : KKernel k) (hK : MemW0 K)
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    prismBrascampLiebForm n k hk hkn K (fun i x => F i x) =
      ∫ u : RealVector k, ∫ w : ℝ × RealVector n,
        K (u, w.1) * ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
          F (prismIndex hk hkn i) (aux_prismPullback n k hkn h i u w.1 w.2) := by
  classical
  let G : (RealVector k × RealVector k) × RealVector (n - k + 1) → ℝ := fun p =>
    K (p.1.2 - p.1.1, coordinateSum p.1.1 + coordinateSum p.2) *
      ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
        F (prismIndex hk hkn i) (prismPoint hk hkn p.1 p.2 h i)
  have hG : Integrable G := by
    simpa [G] using aux_integrable_prismIntegrand n k hk hkn K hK F
  have hcoords : G ∘ aux_prismCoordinates n k hkn =
      fun w : RealVector k × (ℝ × RealVector n) =>
        K (w.1, w.2.1) * ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
          F (prismIndex hk hkn i) (aux_prismPullback n k hkn h i w.1 w.2.1 w.2.2) := by
    funext w
    dsimp [G]
    rw [aux_prismCoordinates_kernelArguments n k hkn w.1 w.2.1 w.2.2]
    apply congrArg (fun P : ℝ => K (w.1, w.2.1) * P)
    rw [← Fintype.prod_prod_type'
      (fun h i => F (prismIndex hk hkn i)
        (prismPoint hk hkn (aux_prismCoordinates n k hkn w).1
          (aux_prismCoordinates n k hkn w).2 h i))]
    rw [← Fintype.prod_prod_type'
      (fun h i => F (prismIndex hk hkn i)
        (aux_prismPullback n k hkn h i w.1 w.2.1 w.2.2))]
    apply Finset.prod_congr rfl
    intro hi _
    exact congrArg (F (prismIndex hk hkn hi.2))
      (aux_prismPoint_eq_prismPullbackCoordinates n k hk hkn w.1 w.2.1 w.2.2 hi.1 hi.2)
  calc
    prismBrascampLiebForm n k hk hkn K (fun i x => F i x) =
        ∫ p : (RealVector k × RealVector k) × RealVector (n - k + 1), G p := by
          rw [show prismBrascampLiebForm n k hk hkn K (fun i x => F i x) =
              ∫ y : RealVector k × RealVector k, ∫ x : RealVector (n - k + 1), G (y, x) by
            rfl]
          simpa only [Measure.volume_eq_prod] using (integral_prod G hG).symm
    _ = ∫ w : RealVector k × (ℝ × RealVector n),
        G (aux_prismCoordinates n k hkn w) := by
          let T := aux_prismCoordinates n k hkn
          have hT : MeasurePreserving T volume volume :=
            aux_measurePreserving_prismCoordinates n k hkn
          have hchange := MeasureTheory.integral_map hT.measurable.aemeasurable
            (show AEStronglyMeasurable G ((volume : Measure (RealVector k ×
              (ℝ × RealVector n))).map T) by simpa [hT.map_eq] using hG.1)
          rw [hT.map_eq] at hchange
          simpa [T] using hchange
    _ = ∫ u : RealVector k, ∫ w : ℝ × RealVector n,
        K (u, w.1) * ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
          F (prismIndex hk hkn i) (aux_prismPullback n k hkn h i u w.1 w.2) := by
      change ∫ w : RealVector k × (ℝ × RealVector n),
        (G ∘ aux_prismCoordinates n k hkn) w = _
      rw [hcoords]
      have hglobal : Integrable (fun w : RealVector k × (ℝ × RealVector n) =>
          K (w.1, w.2.1) * ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
            F (prismIndex hk hkn i) (aux_prismPullback n k hkn h i w.1 w.2.1 w.2.2)) := by
        have hcomp :=
          (aux_measurePreserving_prismCoordinates n k hkn).integrable_comp_of_integrable hG
        change Integrable (G ∘ aux_prismCoordinates n k hkn) at hcomp
        rw [hcoords] at hcomp
        exact hcomp
      simpa only [Measure.volume_eq_prod] using
        (integral_prod (fun w : RealVector k × (ℝ × RealVector n) =>
          K (w.1, w.2.1) * ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
            F (prismIndex hk hkn i) (aux_prismPullback n k hkn h i w.1 w.2.1 w.2.2))
          hglobal)

/--
Auxiliary normalized prism estimate.  It is the finite Hölder step in the
proof of the prism Brascamp--Lieb inequality, after all prism factors have
been pulled back by their measure-preserving affine maps.
-/
theorem aux_prism_lintegral_le_one (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n)
    (F : Fin n → SchwartzMap (RealVector n) ℝ) (hF : F ∈ normalizedFunctionTuples n)
    (u : RealVector k) (s : ℝ) :
    ∫⁻ z : RealVector n, ∏ hi : (Fin k → Fin 2) × Fin (n - k + 1),
      ‖F (prismIndex hk hkn hi.2)
        (aux_prismPullback n k hkn hi.1 hi.2 u s z)‖ₑ ∂volume ≤ 1 := by
  let p : (Fin k → Fin 2) × Fin (n - k + 1) → ℕ := fun hi =>
    aux_prismLpExponent n k hk hkn hi.2
  let G : (Fin k → Fin 2) × Fin (n - k + 1) → RealVector n → ℝ := fun hi z =>
    F (prismIndex hk hkn hi.2) (aux_prismPullback n k hkn hi.1 hi.2 u s z)
  have hp (hi : (Fin k → Fin 2) × Fin (n - k + 1)) : p hi ≠ 0 := by
    dsimp [p, aux_prismLpExponent]
    positivity
  have hGmeas (hi : (Fin k → Fin 2) × Fin (n - k + 1)) :
      AEMeasurable (G hi) volume := by
    dsimp [G]
    exact (F (prismIndex hk hkn hi.2)).continuous.measurable.comp_aemeasurable
      (aux_measurePreserving_prismPullback n k hkn hi.1 hi.2 u s).measurable.aemeasurable
  have hsum : ∑ hi : (Fin k → Fin 2) × Fin (n - k + 1), ((p hi : ℝ)⁻¹) = 1 := by
    simpa [p] using aux_prismLpExponent_factor_sum n k hk hkn
  have hholder := aux_lintegral_prod_enorm_le_eLpNorm_of_reciprocal_sum
    volume G hGmeas p hp hsum
  have hGnorm (hi : (Fin k → Fin 2) × Fin (n - k + 1)) :
      eLpNorm (G hi) (p hi : ℝ≥0∞) volume = 1 := by
    calc
      eLpNorm (G hi) (p hi : ℝ≥0∞) volume =
          eLpNorm (F (prismIndex hk hkn hi.2)) (p hi : ℝ≥0∞) volume := by
        simpa [G, Function.comp_def] using
          (eLpNorm_comp_measurePreserving
            (g := F (prismIndex hk hkn hi.2))
            (f := aux_prismPullback n k hkn hi.1 hi.2 u s)
            (F (prismIndex hk hkn hi.2)).continuous.aestronglyMeasurable
            (aux_measurePreserving_prismPullback n k hkn hi.1 hi.2 u s))
      _ = 1 := by
        change eLpNorm (F (prismIndex hk hkn hi.2))
          ((2 ^ ((prismIndex hk hkn hi.2).1 +
            min (n - (prismIndex hk hkn hi.2).1) 2) : ℕ) : ℝ≥0∞) volume = 1
        exact hF (prismIndex hk hkn hi.2)
  calc
    (∫⁻ z : RealVector n, ∏ hi : (Fin k → Fin 2) × Fin (n - k + 1),
        ‖F (prismIndex hk hkn hi.2)
          (aux_prismPullback n k hkn hi.1 hi.2 u s z)‖ₑ ∂volume) =
        ∫⁻ z : RealVector n, ∏ hi, ‖G hi z‖ₑ ∂volume := by rfl
    _ ≤ ∏ hi, eLpNorm (G hi) (p hi : ℝ≥0∞) volume := hholder
    _ = 1 := by
      simp_rw [hGnorm]
      simp

/--
\begin{proposition}[prism BL inequality]\label{prism BL inequality}

Let $k\in\N$ satisfy $1\le k\le n$ and $K\in W_0(\R^{k+1})$ and $\F\in \mathfrak{F}$. Then
\begin{equation}\label{prism-k-bound}
   |\Theta_k(K)(\F)| \le \|K\|_1.
\end{equation}
\end{proposition}
-/
theorem prismBLInequality (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n)
    (K : KKernel k) (hK : MemW0 K)
    (F : Fin n → SchwartzMap (RealVector n) ℝ)
    (hF : F ∈ normalizedFunctionTuples n) :
    ‖prismBrascampLiebForm n k hk hkn K (fun i x => F i x)‖ₑ ≤ eLpNorm K 1 volume := by
  classical
  let H : ((RealVector k × RealVector k) × RealVector (n - k + 1)) → ℝ≥0∞ := fun p =>
    ‖K (p.1.2 - p.1.1, coordinateSum p.1.1 + coordinateSum p.2) *
      ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
        F (prismIndex hk hkn i) (prismPoint hk hkn p.1 p.2 h i)‖ₑ
  have hpointCont (h : Fin k → Fin 2) (i : Fin (n - k + 1)) :
      Continuous (fun p : (RealVector k × RealVector k) × RealVector (n - k + 1) =>
        prismPoint hk hkn p.1 p.2 h i) := by
    apply continuous_pi
    intro j
    unfold prismPoint concatVector
    split_ifs with hj
    · unfold cubeCorner
      split_ifs <;> fun_prop
    · unfold eraseVector
      fun_prop
  have hprodHCont : Continuous
      (fun p : (RealVector k × RealVector k) × RealVector (n - k + 1) =>
        ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
          F (prismIndex hk hkn i) (prismPoint hk hkn p.1 p.2 h i)) := by
    apply continuous_finsetProd Finset.univ
    intro h _
    apply continuous_finsetProd Finset.univ
    intro i _
    exact (F (prismIndex hk hkn i)).continuous.comp (hpointCont h i)
  have hkernelArgCont : Continuous
      (fun p : (RealVector k × RealVector k) × RealVector (n - k + 1) =>
        (p.1.2 - p.1.1, coordinateSum p.1.1 + coordinateSum p.2)) := by
    have hu : Continuous (fun p : (RealVector k × RealVector k) ×
        RealVector (n - k + 1) => p.1.2 - p.1.1) :=
      (continuous_snd.comp continuous_fst).sub (continuous_fst.comp continuous_fst)
    have hs : Continuous (fun p : (RealVector k × RealVector k) ×
        RealVector (n - k + 1) => coordinateSum p.1.1 + coordinateSum p.2) :=
      ((aux_continuous_coordinateSum k).comp (continuous_fst.comp continuous_fst)).add
        ((aux_continuous_coordinateSum (n - k + 1)).comp continuous_snd)
    exact hu.prodMk hs
  have hHmeas : Measurable H := by
    dsimp [H]
    exact ((hK.aux_continuous.comp hkernelArgCont).mul hprodHCont).enorm.measurable
  let Q : RealVector k × (ℝ × RealVector n) → ℝ≥0∞ := fun w =>
    ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
      ‖F (prismIndex hk hkn i)
        (prismPoint hk hkn (aux_prismCoordinates n k hkn w).1
          (aux_prismCoordinates n k hkn w).2 h i)‖ₑ
  have hQmeas : Measurable Q := by
    dsimp [Q]
    apply Finset.measurable_fun_prod Finset.univ
    intro h _
    apply Finset.measurable_fun_prod Finset.univ
    intro i _
    exact measurable_enorm.comp
      ((F (prismIndex hk hkn i)).continuous.measurable.comp
        ((hpointCont h i).measurable.comp
          (aux_measurePreserving_prismCoordinates n k hkn).measurable))
  have hQbound (u : RealVector k) (s : ℝ) :
      ∫⁻ z : RealVector n, Q (u, (s, z)) ∂volume ≤ 1 := by
    calc
      (∫⁻ z : RealVector n, Q (u, (s, z)) ∂volume) =
          ∫⁻ z : RealVector n, ∏ hi : (Fin k → Fin 2) × Fin (n - k + 1),
            ‖F (prismIndex hk hkn hi.2)
              (aux_prismPullback n k hkn hi.1 hi.2 u s z)‖ₑ ∂volume := by
            apply lintegral_congr
            intro z
            exact aux_prismCoordinates_product_eq n k hk hkn (fun i x => F i x) u s z
      _ ≤ 1 := aux_prism_lintegral_le_one n k hk hkn F hF u s
  have hHcoords (u : RealVector k) (s : ℝ) (z : RealVector n) :
      H (aux_prismCoordinates n k hkn (u, (s, z))) = ‖K (u, s)‖ₑ * Q (u, (s, z)) := by
    dsimp [H, Q]
    rw [aux_prismCoordinates_kernelArguments n k hkn u s z]
    rw [enorm_mul]
    congr 1
    rw [aux_enorm_fintype_prod]
    apply Finset.prod_congr rfl
    intro h _
    exact aux_enorm_fintype_prod _
  have hHcoordsMeas : Measurable (H ∘ aux_prismCoordinates n k hkn) :=
    hHmeas.comp (aux_measurePreserving_prismCoordinates n k hkn).measurable
  have hQsliceMeas (u : RealVector k) (s : ℝ) :
      Measurable (fun z : RealVector n => Q (u, (s, z))) :=
    hQmeas.comp
      (continuous_const.prodMk (continuous_const.prodMk continuous_id)).measurable
  have hQpairMeas (u : RealVector k) :
      Measurable (fun q : ℝ × RealVector n => Q (u, q)) :=
    hQmeas.comp (continuous_const.prodMk continuous_id).measurable
  have hKsliceMeas (u : RealVector k) :
      Measurable (fun q : ℝ × RealVector n => ‖K (u, q.1)‖ₑ) :=
    (hK.aux_continuous.comp (continuous_const.prodMk continuous_fst)).enorm.measurable
  have hJmeas (u : RealVector k) :
      Measurable (fun q : ℝ × RealVector n => ‖K (u, q.1)‖ₑ * Q (u, q)) :=
    (hKsliceMeas u).mul (hQpairMeas u)
  have hGinner (u : RealVector k) :
      ∫⁻ q : ℝ × RealVector n, ‖K (u, q.1)‖ₑ * Q (u, q) ∂volume ≤
        ∫⁻ s : ℝ, ‖K (u, s)‖ₑ ∂volume := by
    calc
      (∫⁻ q : ℝ × RealVector n, ‖K (u, q.1)‖ₑ * Q (u, q) ∂volume) =
          ∫⁻ s : ℝ, ∫⁻ z : RealVector n, ‖K (u, s)‖ₑ * Q (u, (s, z)) ∂volume ∂volume := by
            simpa only [Measure.volume_eq_prod] using
              (lintegral_prod (fun q : ℝ × RealVector n => ‖K (u, q.1)‖ₑ * Q (u, q))
                (hJmeas u).aemeasurable)
      _ = ∫⁻ s : ℝ, ‖K (u, s)‖ₑ *
          ∫⁻ z : RealVector n, Q (u, (s, z)) ∂volume ∂volume := by
            apply lintegral_congr
            intro s
            exact lintegral_const_mul _ (hQsliceMeas u s)
      _ ≤ ∫⁻ s : ℝ, ‖K (u, s)‖ₑ * 1 ∂volume := by
            apply lintegral_mono
            intro s
            exact mul_le_mul_right (hQbound u s) _
      _ = ∫⁻ s : ℝ, ‖K (u, s)‖ₑ ∂volume := by simp
  have hKmeas : Measurable (fun w : RealVector k × ℝ => ‖K w‖ₑ) :=
    hK.aux_continuous.enorm.measurable
  unfold prismBrascampLiebForm
  calc
    ‖∫ y : RealVector k × RealVector k, ∫ x : RealVector (n - k + 1),
      K (y.2 - y.1, coordinateSum y.1 + coordinateSum x) *
        ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
          F (prismIndex hk hkn i) (prismPoint hk hkn y x h i)‖ₑ ≤
        ∫⁻ y : RealVector k × RealVector k,
          ‖∫ x : RealVector (n - k + 1),
            K (y.2 - y.1, coordinateSum y.1 + coordinateSum x) *
              ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
                F (prismIndex hk hkn i) (prismPoint hk hkn y x h i)‖ₑ ∂volume :=
      enorm_integral_le_lintegral_enorm _
    _ ≤ ∫⁻ y : RealVector k × RealVector k,
        ∫⁻ x : RealVector (n - k + 1), H (y, x) ∂volume ∂volume := by
      apply lintegral_mono
      intro y
      change ‖∫ x : RealVector (n - k + 1),
        K (y.2 - y.1, coordinateSum y.1 + coordinateSum x) *
          ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
            F (prismIndex hk hkn i) (prismPoint hk hkn y x h i) ∂volume‖ₑ ≤
          ∫⁻ x : RealVector (n - k + 1),
            ‖K (y.2 - y.1, coordinateSum y.1 + coordinateSum x) *
              ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
                F (prismIndex hk hkn i) (prismPoint hk hkn y x h i)‖ₑ ∂volume
      exact enorm_integral_le_lintegral_enorm _
    _ = ∫⁻ p : (RealVector k × RealVector k) × RealVector (n - k + 1), H p ∂volume := by
      simpa only [Measure.volume_eq_prod] using (lintegral_prod H hHmeas.aemeasurable).symm
    _ = ∫⁻ w : RealVector k × (ℝ × RealVector n),
        H (aux_prismCoordinates n k hkn w) ∂volume :=
      ((aux_measurePreserving_prismCoordinates n k hkn).lintegral_comp hHmeas).symm
    _ = ∫⁻ u : RealVector k, ∫⁻ q : ℝ × RealVector n,
        H (aux_prismCoordinates n k hkn (u, q)) ∂volume ∂volume := by
      simpa only [Measure.volume_eq_prod] using
        (lintegral_prod (fun w : RealVector k × (ℝ × RealVector n) =>
          H (aux_prismCoordinates n k hkn w)) hHcoordsMeas.aemeasurable)
    _ = ∫⁻ u : RealVector k, ∫⁻ q : ℝ × RealVector n,
        ‖K (u, q.1)‖ₑ * Q (u, q) ∂volume ∂volume := by
      apply lintegral_congr
      intro u
      apply lintegral_congr
      intro q
      exact hHcoords u q.1 q.2
    _ ≤ ∫⁻ u : RealVector k, ∫⁻ s : ℝ, ‖K (u, s)‖ₑ ∂volume ∂volume := by
      apply lintegral_mono
      intro u
      exact hGinner u
    _ = ∫⁻ w : RealVector k × ℝ, ‖K w‖ₑ ∂volume := by
      simpa only [Measure.volume_eq_prod] using
        (lintegral_prod (fun w : RealVector k × ℝ => ‖K w‖ₑ) hKmeas.aemeasurable).symm
    _ = eLpNorm K 1 volume := (eLpNorm_one_eq_lintegral_enorm).symm

/-- The same singleton-fibre integration rule at the dependent top-prism index. -/
theorem aux_integral_topFiber (n : ℕ) (f : ℝ → ℝ) :
    (∫ x : RealVector (n - n + 1), f (x (aux_topFiberIndex n))) = ∫ q : ℝ, f q := by
  let : Unique (Fin (n - n + 1)) :=
    { default := aux_topFiberIndex n
      uniq := fun i => Fin.ext (by omega) }
  let e := MeasurableEquiv.piUnique (fun _ : Fin (n - n + 1) => ℝ)
  have he : MeasurePreserving e volume volume :=
    volume_preserving_piUnique (fun _ : Fin (n - n + 1) => ℝ)
  have hcoordinate (x : RealVector (n - n + 1)) : e x = x (aux_topFiberIndex n) := by
    change x default = x (aux_topFiberIndex n)
    congr 1
  calc
    (∫ x : RealVector (n - n + 1), f (x (aux_topFiberIndex n))) =
        ∫ x : RealVector (n - n + 1), f (e x) := by
          apply integral_congr_ae
          filter_upwards [] with x
          rw [hcoordinate]
    _ = ∫ q : ℝ, f q := he.integral_comp' f

/--
\begin{proposition}[simplification 1 prism]\label{simplification 1 prism}
    Let $K\in W_0(\R^{n+1})$. If for all $z\in \R^{n+1}$ we have
    \begin{equation}\label{1 prism mean zero assumption}
        \int_\R K(z+qe_n)\, dq=0\, ,
    \end{equation}
    then for all $\F\in \mathfrak{F}$,
    \begin{equation}
         \Theta_n(K)(\F)= 0\, .
    \end{equation}
\end{proposition}
-/
theorem simplificationOnePrism (n : ℕ) (hn : 1 ≤ n) (K : KKernel n) (_hK : MemW0 K)
    (hzero : ∀ z : RealVector n × ℝ, ∫ q : ℝ, K (z.1, z.2 + q) = 0)
    (F : Fin n → SchwartzMap (RealVector n) ℝ) (_hF : F ∈ normalizedFunctionTuples n) :
    prismBrascampLiebForm n n hn le_rfl K (fun i x => F i x) = 0 := by
  unfold prismBrascampLiebForm
  apply integral_eq_zero_of_ae
  filter_upwards [] with y
  have hproduct (x : RealVector (n - n + 1)) :
      (∏ h : Fin n → Fin 2, ∏ i : Fin (n - n + 1),
        F (prismIndex hn le_rfl i) (prismPoint hn le_rfl y x h i)) =
        ∏ h : Fin n → Fin 2, F (aux_topIndex n hn) (cubeCorner y h) := by
    apply Finset.prod_congr rfl
    intro h _
    rw [Finset.prod_eq_single_of_mem (aux_topFiberIndex n) (Finset.mem_univ _)]
    · rw [aux_prismIndex_top_apply n hn, aux_prismPoint_top_apply n hn y x h]
    · intro i _ hi
      exact (hi (Fin.ext (by omega))).elim
  simp_rw [hproduct]
  let P : ℝ := ∏ h : Fin n → Fin 2, F (aux_topIndex n hn) (cubeCorner y h)
  have hslice :
      (∫ x : RealVector (n - n + 1),
        K (y.2 - y.1, coordinateSum y.1 + coordinateSum x)) = 0 := by
    calc
      (∫ x : RealVector (n - n + 1),
        K (y.2 - y.1, coordinateSum y.1 + coordinateSum x)) =
          ∫ x : RealVector (n - n + 1),
            K (y.2 - y.1, coordinateSum y.1 + x (aux_topFiberIndex n)) := by
              simp only [aux_coordinateSum_topFiber]
      _ = ∫ q : ℝ, K (y.2 - y.1, coordinateSum y.1 + q) :=
        aux_integral_topFiber n (fun q => K (y.2 - y.1, coordinateSum y.1 + q))
      _ = 0 := hzero (y.2 - y.1, coordinateSum y.1)
  calc
    (∫ x : RealVector (n - n + 1),
      K (y.2 - y.1, coordinateSum y.1 + coordinateSum x) * P) =
        (∫ x : RealVector (n - n + 1),
          K (y.2 - y.1, coordinateSum y.1 + coordinateSum x)) * P :=
      integral_mul_const P _
    _ = 0 := by rw [hslice, zero_mul]

/--
Auxiliary determinant-one shear used to write a convolution in the final
kernel coordinate as an ordinary coordinate-fibre integral.
-/
noncomputable def aux_singlyCancellativeShear (k : ℕ) :
    ((RealVector k × ℝ) × ℝ) ≃L[ℝ] ((RealVector k × ℝ) × ℝ) where
  toFun := fun uq => ((uq.1.1, uq.1.2 - uq.2), uq.2)
  invFun := fun uq => ((uq.1.1, uq.1.2 + uq.2), uq.2)
  left_inv := by
    rintro ⟨⟨u, t⟩, q⟩
    apply Prod.ext
    · apply Prod.ext
      · rfl
      · exact sub_add_cancel t q
    · rfl
  right_inv := by
    rintro ⟨⟨u, t⟩, q⟩
    apply Prod.ext
    · apply Prod.ext
      · rfl
      · exact add_sub_cancel_right t q
    · rfl
  map_add' := by
    rintro ⟨⟨u, t⟩, q⟩ ⟨⟨v, s⟩, r⟩
    apply Prod.ext
    · apply Prod.ext
      · rfl
      · change t + s - (q + r) = (t - q) + (s - r)
        ring
    · rfl
  map_smul' := by
    rintro c ⟨⟨u, t⟩, q⟩
    apply Prod.ext
    · apply Prod.ext
      · rfl
      · change c * t - c * q = c * (t - q)
        ring
    · rfl
  continuous_toFun := by fun_prop
  continuous_invFun := by fun_prop

/--
Auxiliary `W₀` closure for one convolution summand.  It is the fibre-integral
part of the singly cancellative kernel construction.
-/
theorem aux_memW0_singlyCancellativeSummand (k : ℕ) (rho : KKernel k)
    (hrho : MemW0 rho) (phi : ℝ → ℝ) (hphi : MemW0 phi) :
    MemW0 (fun u : RealVector k × ℝ =>
      ∫ q : ℝ, rho (u.1, u.2 - q) * phi q) := by
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k)) :=
    isAddHaarMeasure_volume_pi (Fin k)
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure (volume : Measure ((RealVector k × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let G : ((RealVector k × ℝ) × ℝ) → ℝ := fun uq => rho uq.1 * phi uq.2
  have hG : MemW0 G := by
    simpa [G] using hrho.aux_mul_prod hphi
  have hGs : MemW0 (G ∘ aux_singlyCancellativeShear k) :=
    aux_memW0_comp_continuousLinearEquiv hG (aux_singlyCancellativeShear k)
  have hI := aux_memW0_integral_slice_of_addHaar hGs
  simpa [G, aux_singlyCancellativeShear, Function.comp_def] using hI

/-- Auxiliary definition for Proposition \ref{single cancellative Cauchy-Schwarz}; see
`singlyCancellativeCauchySchwarz_bound`. -/
def singlyCancellativeKernel (k J : ℕ) (rho : Fin J → KKernel k)
    (phi : Fin J → ℝ → ℝ) : KKernel k :=
  fun u => ∑ j, ∫ q : ℝ, rho j (u.1, u.2 - q) * phi j q

/--
\begin{proposition}[singly cancellative Cauchy-Schwarz]\label{single cancellative Cauchy-Schwarz}
Let $J\ge 1$ and $1\le k<n$ be integers. For
$(\rho_j)_{j\in [J)}\subset W_0(\R^{k+1})$, and
$(\phi_j)_{j\in [J)}\subset W_0(\R)$, define, for $u\in \R^{k+1}$,
\begin{equation}
    K(u):=\sum_{j\in[J)}\int_\R \rho_j(u_{[k)},u_k-q)\phi_j(q)\,dq.
\end{equation}
Then $K\in W_0(\R^{k+1})$.
\end{proposition}
-/
theorem singlyCancellativeKernel_memW0 (n k J : ℕ) (_hJ : 1 ≤ J) (_hk : 1 ≤ k)
    (_hkn : k < n) (rho : Fin J → KKernel k) (phi : Fin J → ℝ → ℝ)
    (hrho : ∀ j, MemW0 (rho j)) (hphi : ∀ j, MemW0 (phi j)) :
    MemW0 (singlyCancellativeKernel k J rho phi) := by
  unfold singlyCancellativeKernel
  apply aux_memW0_finset_sum Finset.univ
  intro j _
  exact aux_memW0_singlyCancellativeSummand k (rho j) (hrho j) (phi j) (hphi j)

/--
The unintegrated summand of the singly-cancellative kernel.  It is the raw
tensor/shear integrand used to justify the first Fubini expansion in the
singly-cancellative Cauchy--Schwarz proof.
-/
def aux_singlyCancellativeExpandedKernel (k : ℕ) (rho : KKernel k)
    (phi : ℝ → ℝ) : ((RealVector k × ℝ) × ℝ) → ℝ := fun p =>
  rho (p.1.1, p.1.2 - p.2) * phi p.2

/--
The unintegrated singly-cancellative summand belongs to `W₀`.  This is the
tensor-product/shear input for its prism-integrand Fubini certificate.
-/
theorem aux_memW0_singlyCancellativeExpandedKernel (k : ℕ) (rho : KKernel k)
    (hrho : MemW0 rho) (phi : ℝ → ℝ) (hphi : MemW0 phi) :
    MemW0 (aux_singlyCancellativeExpandedKernel k rho phi) := by
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k)) :=
    isAddHaarMeasure_volume_pi (Fin k)
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure (volume : Measure ((RealVector k × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let G : ((RealVector k × ℝ) × ℝ) → ℝ := fun p => rho p.1 * phi p.2
  have hG : MemW0 G := by
    simpa [G] using hrho.aux_mul_prod hphi
  have hGs : MemW0 (G ∘ aux_singlyCancellativeShear k) :=
    aux_memW0_comp_continuousLinearEquiv hG (aux_singlyCancellativeShear k)
  have hEq : aux_singlyCancellativeExpandedKernel k rho phi =
      G ∘ aux_singlyCancellativeShear k := by
    funext p
    rcases p with ⟨u, q⟩
    simp [aux_singlyCancellativeExpandedKernel, G, aux_singlyCancellativeShear]
  rw [hEq]
  exact hGs

/--
Absolute integrability of the raw singly-cancellative prism integrand.  This
is the Fubini certificate used to expand the original prism form into its
individual convolution summands before applying Cauchy--Schwarz.
-/
theorem aux_integrable_singlyCancellativeExpandedPrismIntegrand
    (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n)
    (rho : KKernel k) (hrho : MemW0 rho) (phi : ℝ → ℝ) (hphi : MemW0 phi)
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    Integrable (fun p : ((RealVector k × ℝ) × ℝ) × RealVector n =>
      aux_singlyCancellativeExpandedKernel k rho phi p.1 *
        ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
          F (prismIndex hk hkn i)
            (aux_prismPullback n k hkn h i p.1.1.1 p.1.1.2 p.2)) := by
  classical
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k)) :=
    isAddHaarMeasure_volume_pi (Fin k)
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure ((RealVector k × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let I := (Fin k → Fin 2) × Fin (n - k + 1)
  let a : I := (fun _ => 0, 0)
  let P : I → ((RealVector k × ℝ) × ℝ) × RealVector n → ℝ := fun hi w =>
    F (prismIndex hk hkn hi.2)
      (aux_prismPullback n k hkn hi.1 hi.2 w.1.1.1 w.1.1.2 w.2)
  let D : ((RealVector k × ℝ) × ℝ) × RealVector n → ℝ := fun w =>
    aux_singlyCancellativeExpandedKernel k rho phi w.1 * P a w
  let R : ((RealVector k × ℝ) × ℝ) × RealVector n → ℝ := fun w =>
    ∏ hi ∈ (Finset.univ.erase a), P hi w
  let C : ℝ := ∏ hi ∈ (Finset.univ.erase a),
    SchwartzMap.seminorm ℝ 0 0 (F (prismIndex hk hkn hi.2))
  let H : ((RealVector k × ℝ) × ℝ) × RealVector n → ℝ := fun w =>
    aux_singlyCancellativeExpandedKernel k rho phi w.1 * ∏ hi : I, P hi w
  have hExpanded : MemW0 (aux_singlyCancellativeExpandedKernel k rho phi) :=
    aux_memW0_singlyCancellativeExpandedKernel k rho hrho phi hphi
  have hC : 0 ≤ C := by
    dsimp [C]
    positivity
  have hPmeas (hi : I) : Measurable (P hi) := by
    dsimp [P]
    have hparams : Measurable
        (fun w : ((RealVector k × ℝ) × ℝ) × RealVector n => (w.1.1, w.2)) :=
      (measurable_fst.comp measurable_fst).prodMk measurable_snd
    exact (F (prismIndex hk hkn hi.2)).continuous.measurable.comp
      ((aux_measurable_prismPullback n k hkn hi.1 hi.2).comp hparams)
  have hHmeas : Measurable H := by
    dsimp [H]
    apply (hExpanded.aux_continuous.measurable.comp measurable_fst).mul
    apply Finset.measurable_fun_prod Finset.univ
    intro hi _
    exact hPmeas hi
  have hRbound (w : ((RealVector k × ℝ) × ℝ) × RealVector n) :
      ‖R w‖ ≤ C := by
    dsimp [R, C]
    calc
      ‖∏ hi ∈ Finset.univ.erase a, P hi w‖ ≤
          ∏ hi ∈ Finset.univ.erase a, ‖P hi w‖ :=
        Finset.norm_prod_le _ _
      _ ≤ ∏ hi ∈ Finset.univ.erase a,
          SchwartzMap.seminorm ℝ 0 0 (F (prismIndex hk hkn hi.2)) := by
          gcongr with hi hhi
          exact (F (prismIndex hk hkn hi.2)).norm_le_seminorm ℝ _
  have hfactor (w : ((RealVector k × ℝ) × ℝ) × RealVector n) :
      H w = D w * R w := by
    dsimp [H, D, R]
    rw [← Finset.mul_prod_erase Finset.univ (fun hi => P hi w)
      (Finset.mem_univ a)]
    ring
  have hbound (w : ((RealVector k × ℝ) × ℝ) × RealVector n) :
      ‖H w‖ ≤ C * ‖D w‖ := by
    rw [hfactor]
    calc
      ‖D w * R w‖ = ‖D w‖ * ‖R w‖ := norm_mul _ _
      _ ≤ ‖D w‖ * C := mul_le_mul_of_nonneg_left (hRbound w) (norm_nonneg _)
      _ = C * ‖D w‖ := mul_comm _ _
  have hExpandedInt : Integrable (aux_singlyCancellativeExpandedKernel k rho phi) :=
    aux_memW0_integrable_of_addHaar hExpanded
  have hFint : Integrable (F (prismIndex hk hkn a.2) : RealVector n → ℝ) :=
    (F (prismIndex hk hkn a.2)).integrable
  have hTensorInt : Integrable (fun w : ((RealVector k × ℝ) × ℝ) × RealVector n =>
      aux_singlyCancellativeExpandedKernel k rho phi w.1 *
        F (prismIndex hk hkn a.2) w.2) := hExpandedInt.mul_prod hFint
  have hD : Integrable D := by
    have hmp := aux_measurePreserving_prismPullbackSkewScalar n k hkn a.1 a.2
    have hcomp := hmp.integrable_comp_of_integrable hTensorInt
    simpa [D, P, Function.comp_def] using hcomp
  have hH : Integrable H := by
    have hDom : Integrable (fun w => C * ‖D w‖) := hD.norm.const_mul C
    exact hDom.mono' hHmeas.aestronglyMeasurable (ae_of_all _ hbound)
  convert hH using 1
  funext p
  dsimp [H, P]
  congr 1
  rw [← Fintype.prod_prod_type']

/--
Auxiliary Fubini expansion of the singly-cancellative prism form into the
individual unintegrated convolution summands.  This provides the common
product-measure expression to which the subsequent Cauchy--Schwarz argument
is applied.
-/
theorem aux_singlyCancellative_prismForm_expand
    (n k J : ℕ) (hJ : 1 ≤ J) (hk : 1 ≤ k) (hkn : k < n)
    (rho : Fin J → KKernel k) (phi : Fin J → ℝ → ℝ)
    (hrho : ∀ j, MemW0 (rho j)) (hphi : ∀ j, MemW0 (phi j))
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    prismBrascampLiebForm n k hk hkn.le (singlyCancellativeKernel k J rho phi)
      (fun i x => F i x) =
      ∑ j, ∫ p : ((RealVector k × ℝ) × ℝ) × RealVector n,
        aux_singlyCancellativeExpandedKernel k (rho j) (phi j) p.1 *
          ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
            F (prismIndex hk hkn.le i)
              (aux_prismPullback n k hkn.le h i p.1.1.1 p.1.1.2 p.2) := by
  classical
  let P : RealVector k → ℝ → RealVector n → ℝ := fun u s z =>
    ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
      F (prismIndex hk hkn.le i) (aux_prismPullback n k hkn.le h i u s z)
  let H : Fin J → ((RealVector k × ℝ) × ℝ) × RealVector n → ℝ := fun j p =>
    aux_singlyCancellativeExpandedKernel k (rho j) (phi j) p.1 *
      P p.1.1.1 p.1.1.2 p.2
  have hH (j : Fin J) : Integrable (H j) := by
    simpa [H, P] using
      aux_integrable_singlyCancellativeExpandedPrismIntegrand n k hk hkn.le
        (rho j) (hrho j) (phi j) (hphi j) F
  have hHs (j : Fin J) :
      Integrable (fun p : (RealVector k × (ℝ × RealVector n)) × ℝ =>
        H j (aux_fourBlockReorder k n p)) := by
    exact (aux_measurePreserving_fourBlockReorder k n).integrable_comp_of_integrable (hH j)
  let G : Fin J → (RealVector k × (ℝ × RealVector n)) × ℝ → ℝ := fun j p =>
    H j (aux_fourBlockReorder k n p)
  let Q : Fin J → RealVector k × (ℝ × RealVector n) → ℝ := fun j uw =>
    ∫ q : ℝ, G j (uw, q)
  have hG (j : Fin J) : Integrable (G j) := by
    simpa [G] using hHs j
  have hQ (j : Fin J) : Integrable (Q j) := by
    simpa [Q] using (hG j).integral_prod_left
  have hQsum : Integrable (fun uw : RealVector k × (ℝ × RealVector n) =>
      ∑ j, Q j uw) :=
    integrable_finsetSum Finset.univ (fun j _ => hQ j)
  have hQ_apply (j : Fin J) (u : RealVector k) (w : ℝ × RealVector n) :
      Q j (u, w) =
        (∫ q : ℝ, rho j (u, w.1 - q) * phi j q) * P u w.1 w.2 := by
    rcases w with ⟨s, z⟩
    change (∫ q : ℝ, H j (aux_fourBlockReorder k n ((u, (s, z)), q))) = _
    change (∫ q : ℝ, H j (((u, s), q), z)) = _
    dsimp [H]
    exact integral_mul_const _ _
  have hK : MemW0 (singlyCancellativeKernel k J rho phi) :=
    singlyCancellativeKernel_memW0 n k J hJ hk hkn rho phi hrho hphi
  rw [aux_prismBrascampLiebForm_eq_global n k hk hkn.le
    (singlyCancellativeKernel k J rho phi) hK F]
  change (∫ u : RealVector k, ∫ w : ℝ × RealVector n,
      (∑ j, ∫ q : ℝ, rho j (u, w.1 - q) * phi j q) * P u w.1 w.2) = _
  calc
    (∫ u : RealVector k, ∫ w : ℝ × RealVector n,
        (∑ j, ∫ q : ℝ, rho j (u, w.1 - q) * phi j q) * P u w.1 w.2) =
        ∫ u : RealVector k, ∫ w : ℝ × RealVector n, ∑ j, Q j (u, w) := by
          apply integral_congr_ae
          filter_upwards [] with u
          apply integral_congr_ae
          filter_upwards [] with w
          rw [Finset.sum_mul]
          apply Finset.sum_congr rfl
          intro j _
          rw [hQ_apply]
    _ = ∫ uw : RealVector k × (ℝ × RealVector n), ∑ j, Q j uw := by
      simpa only [Measure.volume_eq_prod] using
        (integral_prod (fun uw : RealVector k × (ℝ × RealVector n) =>
          ∑ j, Q j uw) hQsum).symm
    _ = ∑ j, ∫ uw : RealVector k × (ℝ × RealVector n), Q j uw := by
      exact integral_finsetSum Finset.univ (fun j _ => hQ j)
    _ = ∑ j, ∫ p : (RealVector k × (ℝ × RealVector n)) × ℝ, G j p := by
      apply Finset.sum_congr rfl
      intro j _
      simpa only [Measure.volume_eq_prod] using (integral_prod (G j) (hG j)).symm
    _ = ∑ j, ∫ p : ((RealVector k × ℝ) × ℝ) × RealVector n, H j p := by
      apply Finset.sum_congr rfl
      intro j _
      simpa [G] using
        (aux_measurePreserving_fourBlockReorder k n).integral_comp' (H j)
    _ = _ := by rfl

/--
The unintegrated singly-cancellative prism integrand in the original prism
coordinates.  This auxiliary raw form is used to make the manuscript's
successive Fubini substitutions explicit in
`singlyCancellativeCauchySchwarz_bound`.
-/
def aux_singlyCancellativeOriginalIntegrand (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n)
    (rho : KKernel k) (phi : ℝ → ℝ)
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    ((RealVector k × RealVector k) × RealVector (n - k + 1)) × ℝ → ℝ := fun p =>
  rho (p.1.1.2 - p.1.1.1, coordinateSum p.1.1.1 + coordinateSum p.1.2 - p.2) *
    phi p.2 *
      ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
        F (prismIndex hk hkn i) (prismPoint hk hkn p.1.1 p.1.2 h i)

/--
Measurability of the original-coordinate raw integrand.  It is needed to
transport its integrability through the global prism-coordinate map.
-/
theorem aux_measurable_singlyCancellativeOriginalIntegrand (n k : ℕ)
    (hk : 1 ≤ k) (hkn : k ≤ n) (rho : KKernel k) (hrho : MemW0 rho)
    (phi : ℝ → ℝ) (hphi : MemW0 phi)
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    Measurable (aux_singlyCancellativeOriginalIntegrand n k hk hkn rho phi F) := by
  unfold aux_singlyCancellativeOriginalIntegrand
  have hArg : Measurable (fun p :
      ((RealVector k × RealVector k) × RealVector (n - k + 1)) × ℝ =>
      (p.1.1.2 - p.1.1.1, coordinateSum p.1.1.1 + coordinateSum p.1.2 - p.2)) := by
    exact (((continuous_snd.comp (continuous_fst.comp continuous_fst)).sub
      (continuous_fst.comp (continuous_fst.comp continuous_fst))).prodMk
      ((((aux_continuous_coordinateSum k).comp
        (continuous_fst.comp (continuous_fst.comp continuous_fst))).add
        ((aux_continuous_coordinateSum (n - k + 1)).comp
          (continuous_snd.comp continuous_fst))).sub continuous_snd)).measurable
  have hProd : Measurable (fun p :
      ((RealVector k × RealVector k) × RealVector (n - k + 1)) × ℝ =>
      ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
        F (prismIndex hk hkn i) (prismPoint hk hkn p.1.1 p.1.2 h i)) := by
    apply Finset.measurable_fun_prod Finset.univ
    intro h _
    apply Finset.measurable_fun_prod Finset.univ
    intro i _
    have hpoint : Continuous (fun p :
        ((RealVector k × RealVector k) × RealVector (n - k + 1)) × ℝ =>
        prismPoint hk hkn p.1.1 p.1.2 h i) := by
      apply continuous_pi
      intro a
      by_cases ha : a.1 < k
      · by_cases hh : h ⟨a.1, ha⟩ = 0
        · simp only [prismPoint, concatVector, ha, ↓reduceDIte, cubeCorner, hh,
            Fin.isValue, ↓reduceIte]
          exact (continuous_apply (⟨a.1, ha⟩ : Fin k)).comp
            (continuous_fst.comp (continuous_fst.comp continuous_fst))
        · simp only [prismPoint, concatVector, ha, ↓reduceDIte, cubeCorner,
            Fin.isValue, hh, ↓reduceIte]
          exact (continuous_apply (⟨a.1, ha⟩ : Fin k)).comp
            (continuous_snd.comp (continuous_fst.comp continuous_fst))
      · simp only [prismPoint, concatVector, ha, ↓reduceDIte, eraseVector]
        exact (continuous_apply (i.succAbove ⟨a.1 - k, by omega⟩)).comp
          (continuous_snd.comp continuous_fst)
    exact (F (prismIndex hk hkn i)).continuous.measurable.comp hpoint.measurable
  exact ((hrho.aux_continuous.measurable.comp hArg).mul
    (hphi.aux_continuous.measurable.comp measurable_snd)).mul hProd

/--
The raw integrand in the global coordinates used by
`aux_singlyCancellative_prismForm_expand`.  It is introduced only to compare
that established Fubini certificate with the literal prism-coordinate form.
-/
def aux_singlyCancellativeGlobalOriginalIntegrand (n k : ℕ) (hk : 1 ≤ k)
    (hkn : k ≤ n) (rho : KKernel k) (phi : ℝ → ℝ)
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    ((RealVector k × ℝ) × ℝ) × RealVector n → ℝ := fun p =>
  aux_singlyCancellativeExpandedKernel k rho phi p.1 *
    ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
      F (prismIndex hk hkn i)
        (aux_prismPullback n k hkn h i p.1.1.1 p.1.1.2 p.2)

/--
The measure-preserving transport from global prism coordinates to the
original unintegrated prism coordinates, retaining the convolution scalar.
-/
def aux_singlyCancellativeGlobalToOriginal (n k : ℕ) (hkn : k ≤ n) :
    ((RealVector k × ℝ) × ℝ) × RealVector n →
      ((RealVector k × RealVector k) × RealVector (n - k + 1)) × ℝ := fun p =>
  let q := (aux_fourBlockReorder k n).symm p
  (aux_prismCoordinates n k hkn q.1, q.2)

/--
The global-to-original raw-coordinate transport preserves Haar volume.  It
combines the established prism-coordinate transformation with a Fubini block
reordering.
-/
theorem aux_measurePreserving_singlyCancellativeGlobalToOriginal (n k : ℕ)
    (hkn : k ≤ n) :
    MeasurePreserving (aux_singlyCancellativeGlobalToOriginal n k hkn) volume volume := by
  have hR : MeasurePreserving (aux_fourBlockReorder k n).symm volume volume :=
    (aux_measurePreserving_fourBlockReorder k n).symm _
  have hP : MeasurePreserving
      (Prod.map (aux_prismCoordinates n k hkn)
        (id : ℝ → ℝ)) volume volume := by
    simpa only [Measure.volume_eq_prod, id_eq] using
      (aux_measurePreserving_prismCoordinates n k hkn).prod
        (MeasurePreserving.id (volume : Measure ℝ))
  convert hP.comp hR using 1
  funext p
  rfl

/--
Pointwise compatibility of the original raw integrand with the global raw
integrand.  This is the finite-coordinate identity that transfers the
existing global integrability certificate.
-/
theorem aux_singlyCancellativeOriginalIntegrand_comp_globalToOriginal
    (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n) (rho : KKernel k) (phi : ℝ → ℝ)
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    aux_singlyCancellativeOriginalIntegrand n k hk hkn rho phi F ∘
      aux_singlyCancellativeGlobalToOriginal n k hkn =
        aux_singlyCancellativeGlobalOriginalIntegrand n k hk hkn rho phi F := by
  funext p
  rcases p with ⟨⟨⟨u, s⟩, q⟩, z⟩
  change rho
      ((aux_prismCoordinates n k hkn (u, (s, z))).1.2 -
        (aux_prismCoordinates n k hkn (u, (s, z))).1.1,
        coordinateSum (aux_prismCoordinates n k hkn (u, (s, z))).1.1 +
          coordinateSum (aux_prismCoordinates n k hkn (u, (s, z))).2 - q) * phi q *
      (∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
        F (prismIndex hk hkn i)
          (prismPoint hk hkn (aux_prismCoordinates n k hkn (u, (s, z))).1
            (aux_prismCoordinates n k hkn (u, (s, z))).2 h i)) =
      rho (u, s - q) * phi q *
      (∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
        F (prismIndex hk hkn i)
          (aux_prismPullback n k hkn h i u s z))
  have hargs := aux_prismCoordinates_kernelArguments n k hkn u s z
  have hu : (aux_prismCoordinates n k hkn (u, (s, z))).1.2 -
      (aux_prismCoordinates n k hkn (u, (s, z))).1.1 = u :=
    congrArg Prod.fst hargs
  have hs : coordinateSum (aux_prismCoordinates n k hkn (u, (s, z))).1.1 +
      coordinateSum (aux_prismCoordinates n k hkn (u, (s, z))).2 = s :=
    congrArg Prod.snd hargs
  rw [hu, hs]
  congr 1

/--
Absolute integrability of the original-coordinate raw integrand.  This is the
Fubini certificate used for the manuscript's direct `(y,t,r,x)` expansion in
`singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_integrable_singlyCancellativeOriginalIntegrand (n k : ℕ)
    (hk : 1 ≤ k) (hkn : k ≤ n) (rho : KKernel k) (hrho : MemW0 rho)
    (phi : ℝ → ℝ) (hphi : MemW0 phi)
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    Integrable (aux_singlyCancellativeOriginalIntegrand n k hk hkn rho phi F) := by
  have hglobal : Integrable
      (aux_singlyCancellativeGlobalOriginalIntegrand n k hk hkn rho phi F) := by
    change Integrable (fun p : ((RealVector k × ℝ) × ℝ) × RealVector n =>
      aux_singlyCancellativeExpandedKernel k rho phi p.1 *
        ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
          F (prismIndex hk hkn i)
            (aux_prismPullback n k hkn h i p.1.1.1 p.1.1.2 p.2))
    exact aux_integrable_singlyCancellativeExpandedPrismIntegrand n k hk hkn
      rho hrho phi hphi F
  have hcomp : Integrable (aux_singlyCancellativeOriginalIntegrand n k hk hkn rho phi F ∘
      aux_singlyCancellativeGlobalToOriginal n k hkn) := by
    rw [aux_singlyCancellativeOriginalIntegrand_comp_globalToOriginal]
    exact hglobal
  have hmeas : AEStronglyMeasurable
      (aux_singlyCancellativeOriginalIntegrand n k hk hkn rho phi F) volume :=
    (aux_measurable_singlyCancellativeOriginalIntegrand n k hk hkn rho hrho
      phi hphi F).aestronglyMeasurable
  exact ((aux_measurePreserving_singlyCancellativeGlobalToOriginal n k hkn).integrable_comp
    hmeas).mp hcomp

/--
The singly-cancellative prism form expanded into raw integrals in the original
prism coordinates.  This is the first literal Fubini form of the proof of
Proposition `\ref{single cancellative Cauchy-Schwarz}`.
-/
theorem aux_singlyCancellative_prismForm_expand_original
    (n k J : ℕ) (hJ : 1 ≤ J) (hk : 1 ≤ k) (hkn : k ≤ n)
    (rho : Fin J → KKernel k) (phi : Fin J → ℝ → ℝ)
    (hrho : ∀ j, MemW0 (rho j)) (hphi : ∀ j, MemW0 (phi j))
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    prismBrascampLiebForm n k hk hkn (singlyCancellativeKernel k J rho phi)
      (fun i x => F i x) =
      ∑ j, ∫ p : ((RealVector k × RealVector k) × RealVector (n - k + 1)) × ℝ,
        aux_singlyCancellativeOriginalIntegrand n k hk hkn (rho j) (phi j) F p := by
  classical
  have _hJ := hJ
  let P : (RealVector k × RealVector k) → RealVector (n - k + 1) → ℝ := fun y x =>
    ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
      F (prismIndex hk hkn i) (prismPoint hk hkn y x h i)
  let H : Fin J → ((RealVector k × RealVector k) × RealVector (n - k + 1)) × ℝ → ℝ :=
    fun j p => aux_singlyCancellativeOriginalIntegrand n k hk hkn (rho j) (phi j) F p
  have hH (j : Fin J) : Integrable (H j) := by
    simpa [H] using aux_integrable_singlyCancellativeOriginalIntegrand n k hk hkn
      (rho j) (hrho j) (phi j) (hphi j) F
  let Q : Fin J → (RealVector k × RealVector k) × RealVector (n - k + 1) → ℝ :=
    fun j yx => ∫ q : ℝ, H j (yx, q)
  have hQ (j : Fin J) : Integrable (Q j) := by
    simpa [Q] using (hH j).integral_prod_left
  have hQsum : Integrable (fun yx :
      (RealVector k × RealVector k) × RealVector (n - k + 1) => ∑ j, Q j yx) :=
    integrable_finsetSum Finset.univ (fun j _ => hQ j)
  have hQ_apply (j : Fin J) (y : RealVector k × RealVector k)
      (x : RealVector (n - k + 1)) :
      Q j (y, x) =
        (∫ q : ℝ, rho j (y.2 - y.1, coordinateSum y.1 + coordinateSum x - q) * phi j q) *
          P y x := by
    change (∫ q : ℝ, H j ((y, x), q)) = _
    change (∫ q : ℝ,
      (rho j (y.2 - y.1, coordinateSum y.1 + coordinateSum x - q) * phi j q) * P y x) = _
    exact integral_mul_const _ _
  unfold prismBrascampLiebForm singlyCancellativeKernel
  change (∫ y : RealVector k × RealVector k, ∫ x : RealVector (n - k + 1),
      (∑ j, ∫ q : ℝ,
        rho j (y.2 - y.1, coordinateSum y.1 + coordinateSum x - q) * phi j q) * P y x) = _
  calc
    (∫ y : RealVector k × RealVector k, ∫ x : RealVector (n - k + 1),
        (∑ j, ∫ q : ℝ,
          rho j (y.2 - y.1, coordinateSum y.1 + coordinateSum x - q) * phi j q) * P y x) =
        ∫ y : RealVector k × RealVector k, ∫ x : RealVector (n - k + 1),
          ∑ j, Q j (y, x) := by
          apply integral_congr_ae
          filter_upwards [] with y
          apply integral_congr_ae
          filter_upwards [] with x
          rw [Finset.sum_mul]
          apply Finset.sum_congr rfl
          intro j _
          rw [hQ_apply]
    _ = ∫ yx : (RealVector k × RealVector k) × RealVector (n - k + 1),
        ∑ j, Q j yx := by
          simpa only [Measure.volume_eq_prod] using
            (integral_prod (fun yx : (RealVector k × RealVector k) ×
              RealVector (n - k + 1) => ∑ j, Q j yx) hQsum).symm
    _ = ∑ j, ∫ yx : (RealVector k × RealVector k) × RealVector (n - k + 1), Q j yx := by
          exact integral_finsetSum Finset.univ (fun j _ => hQ j)
    _ = ∑ j, ∫ p : ((RealVector k × RealVector k) × RealVector (n - k + 1)) × ℝ,
        H j p := by
          apply Finset.sum_congr rfl
          intro j _
          simpa only [Measure.volume_eq_prod] using (integral_prod (H j) (hH j)).symm
    _ = _ := by rfl

/--
The determinant-one coordinate substitution
`(y,t,r,x) ↦ ((y,(r,x)),r-t)` used before the weighted Cauchy--Schwarz
inequality.  The tail dimension is stated in terms of `n-k`, avoiding any
dependent finite-coordinate casts in the raw Fubini expansion.
-/
def aux_singlyCancellativeBaseChangeGeneral (n k : ℕ) :
    (RealVector k × RealVector k) × (ℝ × (ℝ × RealVector (n - k))) →
      ((RealVector k × RealVector k) × RealVector (n - k + 1)) × ℝ := fun p =>
  ((p.1, Fin.cons p.2.2.1 p.2.2.2), p.2.2.1 - p.2.1)

/-- The general base coordinate substitution is Haar preserving. -/
theorem aux_measurePreserving_singlyCancellativeBaseChangeGeneral (n k : ℕ) :
    MeasurePreserving (aux_singlyCancellativeBaseChangeGeneral n k) volume volume := by
  let eTail : ℝ × RealVector (n - k) → RealVector (n - k + 1) :=
    (aux_prismTailSplitEquiv (n - k) (0 : Fin (n - k + 1))).symm
  have hTail : MeasurePreserving eTail volume volume :=
    (aux_measurePreserving_prismTailSplit (n - k) (0 : Fin (n - k + 1))).symm _
  have hA : MeasurePreserving
      (fun p : ℝ × RealVector (n - k + 1) => (p.2, p.2 0 - p.1)) volume volume :=
    aux_measurePreserving_a2AffineMap (n - k)
  have hprod : MeasurePreserving
      (Prod.map (id : RealVector k × RealVector k → RealVector k × RealVector k)
        (Prod.map (id : ℝ → ℝ) eTail)) volume volume := by
    simpa only [Measure.volume_eq_prod, id_eq] using
      (MeasurePreserving.id (volume : Measure (RealVector k × RealVector k))).prod
        ((MeasurePreserving.id (volume : Measure ℝ)).prod hTail)
  have hprodA : MeasurePreserving
      (Prod.map (id : RealVector k × RealVector k → RealVector k × RealVector k)
        (fun p : ℝ × RealVector (n - k + 1) => (p.2, p.2 0 - p.1)))
      volume volume := by
    simpa only [Measure.volume_eq_prod, id_eq] using
      (MeasurePreserving.id (volume : Measure (RealVector k × RealVector k))).prod hA
  have hassoc : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        (RealVector k × RealVector k) × (RealVector (n - k + 1) × ℝ) ≃ᵐ
          ((RealVector k × RealVector k) × RealVector (n - k + 1)) × ℝ)
      volume volume := by
    simpa using (volume_preserving_prodAssoc
      (α₁ := RealVector k × RealVector k) (β₁ := RealVector (n - k + 1))
      (γ₁ := ℝ)).symm
  convert hassoc.comp (hprodA.comp hprod) using 1
  funext p
  rcases p with ⟨y, t, r, x⟩
  change ((y, (Fin.cons r x : RealVector (n - k + 1))), r - t) =
    ((y, eTail (r, x)), eTail (r, x) 0 - t)
  rw [show eTail (r, x) = Fin.cons r x by
    apply (aux_prismTailSplitEquiv (n - k) (0 : Fin (n - k + 1))).injective
    rw [MeasurableEquiv.apply_symm_apply, aux_prismTailSplitEquiv_apply]
    apply Prod.ext
    · simp
    · funext i
      simp [eraseVector]]
  rfl

/--
The literal raw integrand after the base coordinate change.  It has the
manuscript variables `(y,t,r,x)`, ready to split the `i=0` factors from the
remaining product before Cauchy--Schwarz.
-/
def aux_singlyCancellativeBaseIntegrand (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n)
    (rho : KKernel k) (phi : ℝ → ℝ)
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    (RealVector k × RealVector k) × (ℝ × (ℝ × RealVector (n - k))) → ℝ := fun p =>
  rho (p.1.2 - p.1.1, coordinateSum p.1.1 + p.2.1 + coordinateSum p.2.2.2) *
    phi (p.2.2.1 - p.2.1) *
      ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
        F (prismIndex hk hkn i) (prismPoint hk hkn p.1 (Fin.cons p.2.2.1 p.2.2.2) h i)

/--
The product of the nonzero prism-coordinate factors in the `A` term of
Proposition `\ref{single cancellative Cauchy-Schwarz}`.  This is the product
over $i=1,\ldots,n-k$ after separating the $i=0$ factors.
It is used by `singlyCancellativeCauchySchwarz_bound`.
-/
def aux_singlyCancellativeAProduct (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n)
    (F : Fin n → SchwartzMap (RealVector n) ℝ)
    (y : RealVector k × RealVector k) (r : ℝ) (x : RealVector (n - k)) : ℝ :=
  ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k),
    F (prismIndex hk hkn i.succ) (prismPoint hk hkn y (Fin.cons r x) h i.succ)

/--
The product of the $i=0$ prism-coordinate factors in the `B` term of
Proposition `\ref{single cancellative Cauchy-Schwarz}`.
It is used by `singlyCancellativeCauchySchwarz_bound`.
-/
def aux_singlyCancellativeBProduct (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n)
    (F : Fin n → SchwartzMap (RealVector n) ℝ)
    (y : RealVector k × RealVector k) (x : RealVector (n - k)) : ℝ :=
  ∏ h : Fin k → Fin 2,
    F (prismIndex hk hkn (0 : Fin (n - k + 1)))
      (concatVector n k hkn (cubeCorner y h) x)

/--
The split of the prism product into its $i=0$ (`B`) and nonzero (`A`)
factors, used before Cauchy--Schwarz in Proposition
`\ref{single cancellative Cauchy-Schwarz}`.
It is used by `singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_singlyCancellative_product_split (n k : ℕ) (hk : 1 ≤ k)
    (hkn : k ≤ n) (F : Fin n → SchwartzMap (RealVector n) ℝ)
    (y : RealVector k × RealVector k) (r : ℝ) (x : RealVector (n - k)) :
    (∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
      F (prismIndex hk hkn i) (prismPoint hk hkn y (Fin.cons r x) h i)) =
    aux_singlyCancellativeBProduct n k hk hkn F y x *
      aux_singlyCancellativeAProduct n k hk hkn F y r x := by
  rw [show (∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
      F (prismIndex hk hkn i) (prismPoint hk hkn y (Fin.cons r x) h i)) =
      ∏ h : Fin k → Fin 2,
        F (prismIndex hk hkn (0 : Fin (n - k + 1)))
          (prismPoint hk hkn y (Fin.cons r x) h 0) *
        ∏ i : Fin (n - k), F (prismIndex hk hkn i.succ)
          (prismPoint hk hkn y (Fin.cons r x) h i.succ) by
    apply Finset.prod_congr rfl
    intro h _
    exact Fin.prod_univ_succ _]
  rw [Finset.prod_mul_distrib]
  unfold aux_singlyCancellativeBProduct aux_singlyCancellativeAProduct
  congr 1

/-- Pointwise compatibility of the general base change with the raw integrand. -/
theorem aux_singlyCancellativeOriginalIntegrand_comp_baseChangeGeneral
    (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n) (rho : KKernel k) (phi : ℝ → ℝ)
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    aux_singlyCancellativeOriginalIntegrand n k hk hkn rho phi F ∘
      aux_singlyCancellativeBaseChangeGeneral n k =
        aux_singlyCancellativeBaseIntegrand n k hk hkn rho phi F := by
  funext p
  rcases p with ⟨y, t, r, x⟩
  unfold aux_singlyCancellativeOriginalIntegrand aux_singlyCancellativeBaseIntegrand
    aux_singlyCancellativeBaseChangeGeneral
  simp only [Function.comp_apply]
  have hErase : eraseVector (0 : Fin (n - k + 1)) (Fin.cons r x) = x := by
    funext i
    simp [eraseVector]
  rw [aux_coordinateSum_eraseVector (n - k) (0 : Fin (n - k + 1)) (Fin.cons r x)]
  rw [hErase]
  have hscalar : coordinateSum y.1 +
      ((Fin.cons r x : RealVector (n - k + 1)) 0 + coordinateSum x) - (r - t) =
      coordinateSum y.1 + t + coordinateSum x := by
    simp
    ring
  rw [hscalar]

/--
The integral-level base coordinate substitution.  The measurability hypothesis
is explicit because the map is a raw map rather than packaged as a measurable
equivalence.
-/
theorem aux_singlyCancellativeOriginalIntegral_eq_baseIntegral (n k : ℕ)
    (hk : 1 ≤ k) (hkn : k ≤ n) (rho : KKernel k) (phi : ℝ → ℝ)
    (F : Fin n → SchwartzMap (RealVector n) ℝ)
    (hmeas : AEStronglyMeasurable
      (aux_singlyCancellativeOriginalIntegrand n k hk hkn rho phi F) volume) :
    (∫ p : ((RealVector k × RealVector k) × RealVector (n - k + 1)) × ℝ,
      aux_singlyCancellativeOriginalIntegrand n k hk hkn rho phi F p) =
    ∫ p : (RealVector k × RealVector k) × (ℝ × (ℝ × RealVector (n - k))),
      aux_singlyCancellativeBaseIntegrand n k hk hkn rho phi F p := by
  have hmp : MeasurePreserving (aux_singlyCancellativeBaseChangeGeneral n k)
      (volume : Measure ((RealVector k × RealVector k) ×
        (ℝ × (ℝ × RealVector (n - k)))))
      (volume : Measure (((RealVector k × RealVector k) ×
        RealVector (n - k + 1)) × ℝ)) :=
    aux_measurePreserving_singlyCancellativeBaseChangeGeneral n k
  have hchange := MeasureTheory.integral_map hmp.measurable.aemeasurable
    (show AEStronglyMeasurable
      (aux_singlyCancellativeOriginalIntegrand n k hk hkn rho phi F)
      (Measure.map (aux_singlyCancellativeBaseChangeGeneral n k) volume) by
        simpa [hmp.map_eq] using hmeas)
  rw [hmp.map_eq] at hchange
  calc
    (∫ p : ((RealVector k × RealVector k) × RealVector (n - k + 1)) × ℝ,
        aux_singlyCancellativeOriginalIntegrand n k hk hkn rho phi F p) =
      ∫ p : (RealVector k × RealVector k) × (ℝ × (ℝ × RealVector (n - k))),
        aux_singlyCancellativeOriginalIntegrand n k hk hkn rho phi F
          (aux_singlyCancellativeBaseChangeGeneral n k p) :=
          by simpa [aux_singlyCancellativeBaseChangeGeneral] using hchange
    _ = _ := by
      apply integral_congr_ae
      filter_upwards [] with p
      exact congrFun
        (aux_singlyCancellativeOriginalIntegrand_comp_baseChangeGeneral n k hk hkn rho phi F) p

/--
The raw `(y,t,r,x)` Fubini expansion of the singly-cancellative prism form.
This is the exact pre-Cauchy--Schwarz expression in the manuscript and feeds
the A² and B² identifications in `singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_singlyCancellative_prismForm_expand_base
    (n k J : ℕ) (hJ : 1 ≤ J) (hk : 1 ≤ k) (hkn : k ≤ n)
    (rho : Fin J → KKernel k) (phi : Fin J → ℝ → ℝ)
    (hrho : ∀ j, MemW0 (rho j)) (hphi : ∀ j, MemW0 (phi j))
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    prismBrascampLiebForm n k hk hkn (singlyCancellativeKernel k J rho phi)
      (fun i x => F i x) =
      ∑ j, ∫ p : (RealVector k × RealVector k) × (ℝ × (ℝ × RealVector (n - k))),
        aux_singlyCancellativeBaseIntegrand n k hk hkn (rho j) (phi j) F p := by
  rw [aux_singlyCancellative_prismForm_expand_original n k J hJ hk hkn rho phi hrho hphi F]
  apply Finset.sum_congr rfl
  intro j _
  exact aux_singlyCancellativeOriginalIntegral_eq_baseIntegral n k hk hkn (rho j) (phi j) F
    (aux_measurable_singlyCancellativeOriginalIntegrand n k hk hkn
      (rho j) (hrho j) (phi j) (hphi j) F).aestronglyMeasurable

/--
The outer pairing space with manuscript variables `(y,t,x)` in the proof of
Proposition `\ref{single cancellative Cauchy-Schwarz}`.  It is introduced to
put the remaining scalar variable `r` into a separate Fubini fibre for
`singlyCancellativeCauchySchwarz_bound`.
-/
abbrev aux_singlyCancellativeCSPairingSpace (n k : ℕ) :=
  (RealVector k × RealVector k) × (ℝ × RealVector (n - k))

/--
The Fubini reassociation `(y,t,r,x) \mapsto ((y,t,x),r)` used before applying
Cauchy--Schwarz in Proposition `\ref{single cancellative Cauchy-Schwarz}`.
It is used by `singlyCancellativeCauchySchwarz_bound`.
-/
def aux_singlyCancellativeCSFubiniReorder (n k : ℕ) :
    (RealVector k × RealVector k) × (ℝ × (ℝ × RealVector (n - k))) ≃ᵐ
      aux_singlyCancellativeCSPairingSpace n k × ℝ where
  toFun p := ((p.1, (p.2.1, p.2.2.2)), p.2.2.1)
  invFun q := (q.1.1, (q.1.2.1, (q.2, q.1.2.2)))
  left_inv := by rintro ⟨y, t, r, x⟩; rfl
  right_inv := by rintro ⟨⟨y, t, x⟩, r⟩; rfl
  measurable_toFun := by
    exact (measurable_fst.prodMk
      (measurable_snd.fst.prodMk measurable_snd.snd.snd)).prodMk
        measurable_snd.snd.fst
  measurable_invFun := by
    exact measurable_fst.fst.prodMk
      (measurable_fst.snd.fst.prodMk
        (measurable_snd.prodMk measurable_fst.snd.snd))

/--
The Fubini reassociation is Haar preserving.  This is the change of variables
used to expose the outer pairing in
`singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_measurePreserving_singlyCancellativeCSFubiniReorder (n k : ℕ) :
    MeasurePreserving (aux_singlyCancellativeCSFubiniReorder n k) volume volume := by
  let Y := RealVector k × RealVector k
  let X := RealVector (n - k)
  have h1 : MeasurePreserving (MeasurableEquiv.prodAssoc.symm :
      Y × (ℝ × (ℝ × X)) ≃ᵐ (Y × ℝ) × (ℝ × X)) volume volume :=
    volume_preserving_prodAssoc.symm
  have h2 : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (Y × ℝ))
        (MeasurableEquiv.prodComm : ℝ × X ≃ᵐ X × ℝ)) volume volume := by
    change MeasurePreserving
      (Prod.map (id : Y × ℝ → Y × ℝ) (Prod.swap : ℝ × X → X × ℝ)) volume volume
    simpa only [Measure.volume_eq_prod, id_eq] using
      (MeasurePreserving.id (volume : Measure (Y × ℝ))).prod
        (aux_volume_preserving_prod_swap (volume : Measure ℝ) (volume : Measure X))
  have h3 : MeasurePreserving (MeasurableEquiv.prodAssoc :
      (Y × ℝ) × (X × ℝ) ≃ᵐ Y × (ℝ × (X × ℝ))) volume volume :=
    volume_preserving_prodAssoc
  have h4 : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl Y) MeasurableEquiv.prodAssoc.symm :
        Y × (ℝ × (X × ℝ)) ≃ᵐ Y × ((ℝ × X) × ℝ)) volume volume := by
    exact (MeasurePreserving.id (volume : Measure Y)).prod volume_preserving_prodAssoc.symm
  have h5 : MeasurePreserving (MeasurableEquiv.prodAssoc.symm :
      Y × (ℝ × X) × ℝ ≃ᵐ (Y × (ℝ × X)) × ℝ) volume volume :=
    volume_preserving_prodAssoc.symm
  convert h5.comp (h4.comp (h3.comp (h2.comp h1))) using 1; rfl

/--
The unsquared kernel factor in the outer pairing of Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  It is used by
`singlyCancellativeCauchySchwarz_bound` before replacing it by its absolute
value as the positive Cauchy--Schwarz weight.
-/
def aux_singlyCancellativeCSRawR (n k : ℕ) (rho : KKernel k) :
    aux_singlyCancellativeCSPairingSpace n k → ℝ := fun p =>
  rho (p.1.2 - p.1.1, coordinateSum p.1.1 + p.2.1 + coordinateSum p.2.2)

/--
The inner `A` factor in the outer pairing of Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  It is the scalar `r` integral
of the nonzero prism-coordinate factors, and is used by
`singlyCancellativeCauchySchwarz_bound`.
-/
def aux_singlyCancellativeCSRawA (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n)
    (phi : ℝ → ℝ) (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    aux_singlyCancellativeCSPairingSpace n k → ℝ := fun p =>
  ∫ r : ℝ, phi (r - p.2.1) *
    aux_singlyCancellativeAProduct n k hk hkn F p.1 r p.2.2

/--
The `B` factor in the outer pairing of Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  It consists of the separated
zero prism-coordinate factors and is used by
`singlyCancellativeCauchySchwarz_bound`.
-/
def aux_singlyCancellativeCSRawB (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n)
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    aux_singlyCancellativeCSPairingSpace n k → ℝ := fun p =>
  aux_singlyCancellativeBProduct n k hk hkn F p.1 p.2.2

/--
The unintegrated `(y,t,x,r)` form of the `A`--`B` pairing in Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  It is a Fubini intermediary for
`singlyCancellativeCauchySchwarz_bound`.
-/
def aux_singlyCancellativeCSFubiniIntegrand (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n)
    (rho : KKernel k) (phi : ℝ → ℝ) (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    aux_singlyCancellativeCSPairingSpace n k × ℝ → ℝ := fun p =>
  aux_singlyCancellativeCSRawR n k rho p.1 *
    (phi (p.2 - p.1.2.1) *
      aux_singlyCancellativeAProduct n k hk hkn F p.1.1 p.2 p.1.2.2) *
        aux_singlyCancellativeCSRawB n k hk hkn F p.1

/--
Pointwise compatibility of the Fubini reassociation with the raw base
integrand in Proposition `\ref{single cancellative Cauchy-Schwarz}`.  It is
used by `singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_singlyCancellativeCSFubiniIntegrand_comp_reorder (n k : ℕ)
    (hk : 1 ≤ k) (hkn : k ≤ n) (rho : KKernel k) (phi : ℝ → ℝ)
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    aux_singlyCancellativeCSFubiniIntegrand n k hk hkn rho phi F ∘
      aux_singlyCancellativeCSFubiniReorder n k =
        aux_singlyCancellativeBaseIntegrand n k hk hkn rho phi F := by
  funext p
  rcases p with ⟨y, t, r, x⟩
  unfold Function.comp aux_singlyCancellativeCSFubiniIntegrand
    aux_singlyCancellativeCSRawR aux_singlyCancellativeCSRawB
  dsimp [aux_singlyCancellativeCSFubiniReorder]
  unfold aux_singlyCancellativeBaseIntegrand
  rw [aux_singlyCancellative_product_split n k hk hkn F y r x]
  ring

/--
The scalar fibre integral of the raw Fubini integrand is the product of the
outer `R`, `A`, and `B` factors in Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  It is used by
`singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_singlyCancellativeCSRawIntegral_apply (n k : ℕ) (hk : 1 ≤ k)
    (hkn : k ≤ n) (rho : KKernel k) (phi : ℝ → ℝ)
    (F : Fin n → SchwartzMap (RealVector n) ℝ)
    (p : aux_singlyCancellativeCSPairingSpace n k) :
    (∫ r : ℝ, aux_singlyCancellativeCSFubiniIntegrand n k hk hkn rho phi F (p, r)) =
      aux_singlyCancellativeCSRawR n k rho p *
        aux_singlyCancellativeCSRawA n k hk hkn phi F p *
          aux_singlyCancellativeCSRawB n k hk hkn F p := by
  unfold aux_singlyCancellativeCSFubiniIntegrand aux_singlyCancellativeCSRawR
    aux_singlyCancellativeCSRawA aux_singlyCancellativeCSRawB
  change (∫ r : ℝ,
      rho (p.1.2 - p.1.1, coordinateSum p.1.1 + p.2.1 + coordinateSum p.2.2) *
        (phi (r - p.2.1) * aux_singlyCancellativeAProduct n k hk hkn F p.1 r p.2.2) *
          aux_singlyCancellativeBProduct n k hk hkn F p.1 p.2.2) = _
  rw [integral_mul_const, integral_const_mul]

/--
Absolute integrability of the Fubini intermediary for Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  This supplies the Fubini
certificate in `singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_integrable_singlyCancellativeCSFubiniIntegrand (n k : ℕ)
    (hk : 1 ≤ k) (hkn : k ≤ n) (rho : KKernel k) (hrho : MemW0 rho)
    (phi : ℝ → ℝ) (hphi : MemW0 phi) (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    Integrable (aux_singlyCancellativeCSFubiniIntegrand n k hk hkn rho phi F) := by
  have hbase : Integrable
      (aux_singlyCancellativeBaseIntegrand n k hk hkn rho phi F) := by
    have horig := aux_integrable_singlyCancellativeOriginalIntegrand n k hk hkn
      rho hrho phi hphi F
    have hmp := aux_measurePreserving_singlyCancellativeBaseChangeGeneral n k
    have hcomp := hmp.integrable_comp_of_integrable horig
    rw [aux_singlyCancellativeOriginalIntegrand_comp_baseChangeGeneral] at hcomp
    exact hcomp
  have hcomp : Integrable (aux_singlyCancellativeCSFubiniIntegrand n k hk hkn rho phi F ∘
      aux_singlyCancellativeCSFubiniReorder n k) := by
    rw [aux_singlyCancellativeCSFubiniIntegrand_comp_reorder]
    exact hbase
  have hinv := (aux_measurePreserving_singlyCancellativeCSFubiniReorder n k).symm
    (aux_singlyCancellativeCSFubiniReorder n k)
  have htarget := hinv.integrable_comp_of_integrable hcomp
  simpa [Function.comp_def] using htarget

/--
Absolute integrability of the outer `R*A*B` pairing in Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  It supplies the integrability
input for the finite weighted Cauchy--Schwarz estimate in
`singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_integrable_singlyCancellativeCSRawPairing (n k : ℕ) (hk : 1 ≤ k)
    (hkn : k ≤ n) (rho : KKernel k) (hrho : MemW0 rho) (phi : ℝ → ℝ)
    (hphi : MemW0 phi) (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    Integrable (fun p : aux_singlyCancellativeCSPairingSpace n k =>
      aux_singlyCancellativeCSRawR n k rho p *
        aux_singlyCancellativeCSRawA n k hk hkn phi F p *
          aux_singlyCancellativeCSRawB n k hk hkn F p) := by
  have hH := aux_integrable_singlyCancellativeCSFubiniIntegrand n k hk hkn
    rho hrho phi hphi F
  have houter := hH.integral_prod_left
  convert houter using 1
  funext p
  exact (aux_singlyCancellativeCSRawIntegral_apply n k hk hkn rho phi F p).symm

/--
The exact base-integral to outer-pairing Fubini identity in Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  This is the direct input to
the finite weighted Cauchy--Schwarz estimate in
`singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_singlyCancellativeBaseIntegral_eq_rawPairing (n k : ℕ)
    (hk : 1 ≤ k) (hkn : k ≤ n) (rho : KKernel k) (hrho : MemW0 rho)
    (phi : ℝ → ℝ) (hphi : MemW0 phi) (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    (∫ p : (RealVector k × RealVector k) × (ℝ × (ℝ × RealVector (n - k))),
      aux_singlyCancellativeBaseIntegrand n k hk hkn rho phi F p) =
    ∫ p : aux_singlyCancellativeCSPairingSpace n k,
      aux_singlyCancellativeCSRawR n k rho p *
        aux_singlyCancellativeCSRawA n k hk hkn phi F p *
          aux_singlyCancellativeCSRawB n k hk hkn F p := by
  let H := aux_singlyCancellativeCSFubiniIntegrand n k hk hkn rho phi F
  have hH : Integrable H := aux_integrable_singlyCancellativeCSFubiniIntegrand n k hk hkn
    rho hrho phi hphi F
  calc
    (∫ p : (RealVector k × RealVector k) × (ℝ × (ℝ × RealVector (n - k))),
        aux_singlyCancellativeBaseIntegrand n k hk hkn rho phi F p) =
      ∫ p : (RealVector k × RealVector k) × (ℝ × (ℝ × RealVector (n - k))),
        H (aux_singlyCancellativeCSFubiniReorder n k p) := by
          apply integral_congr_ae
          filter_upwards [] with p
          exact congrFun
            (aux_singlyCancellativeCSFubiniIntegrand_comp_reorder n k hk hkn rho phi F).symm p
    _ = ∫ q : aux_singlyCancellativeCSPairingSpace n k × ℝ, H q :=
      (aux_measurePreserving_singlyCancellativeCSFubiniReorder n k).integral_comp' H
    _ = ∫ p : aux_singlyCancellativeCSPairingSpace n k, ∫ r : ℝ, H (p, r) := by
      simpa only [Measure.volume_eq_prod] using integral_prod H hH
    _ = _ := by
      apply integral_congr_ae
      filter_upwards [] with p
      exact aux_singlyCancellativeCSRawIntegral_apply n k hk hkn rho phi F p

/--
The exact raw outer-pairing expansion of the singly-cancellative prism form.
It combines the manuscript's Fubini substitutions and is used directly by
`singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_singlyCancellative_prismForm_eq_rawPairing
    (n k J : ℕ) (hJ : 1 ≤ J) (hk : 1 ≤ k) (hkn : k ≤ n)
    (rho : Fin J → KKernel k) (phi : Fin J → ℝ → ℝ)
    (hrho : ∀ j, MemW0 (rho j)) (hphi : ∀ j, MemW0 (phi j))
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    prismBrascampLiebForm n k hk hkn (singlyCancellativeKernel k J rho phi)
      (fun i x => F i x) =
    ∑ j, ∫ p : aux_singlyCancellativeCSPairingSpace n k,
      aux_singlyCancellativeCSRawR n k (rho j) p *
        aux_singlyCancellativeCSRawA n k hk hkn (phi j) F p *
          aux_singlyCancellativeCSRawB n k hk hkn F p := by
  rw [aux_singlyCancellative_prismForm_expand_base n k J hJ hk hkn rho phi hrho hphi F]
  apply Finset.sum_congr rfl
  intro j _
  exact aux_singlyCancellativeBaseIntegral_eq_rawPairing n k hk hkn
    (rho j) (hrho j) (phi j) (hphi j) F

/--
Auxiliary transport of the existing Schwartz-to-Wiener result to the raw
finite-coordinate model.  It is needed to apply `cubeBLInequality` to the
Schwartz factor in the B² term of Proposition
`\ref{single cancellative Cauchy-Schwarz}`, formalized by
`singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_memW0_schwartzMap (n : ℕ) (F : SchwartzMap (RealVector n) ℝ) :
    MemW0 F := by
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector n)) :=
    isAddHaarMeasure_volume_pi (Fin n)
  let e : EuclideanSpace ℝ (Fin n) ≃L[ℝ] RealVector n :=
    EuclideanSpace.equiv (Fin n) ℝ
  have hE : MemW0 (SchwartzMap.compCLMOfContinuousLinearEquiv ℝ e F) :=
    Codex.SchwartzMap.memW0 _
  have hraw := aux_memW0_comp_continuousLinearEquiv hE e.symm
  convert hraw using 1
  funext x
  change F x = F (e (e.symm x))
  rw [e.apply_symm_apply]

/--
The nonnegative slice kernel $L_j(u)=\int_\mathbb R |\rho_j(u,q)|\,dq$
from the B² term of Proposition `\ref{single cancellative Cauchy-Schwarz}`.
It is an immediate helper for `singlyCancellativeCauchySchwarz_bound`.
-/
def aux_singlyCancellativeSliceKernel (k : ℕ) (rho : KKernel k) : CubeKernel k :=
  fun u => ∫ q : ℝ, |rho (u, q)|

/--
The slice kernel is in $W_0$.  This supplies the kernel hypothesis of
`cubeBLInequality` in the B² term of Proposition
`\ref{single cancellative Cauchy-Schwarz}`, formalized by
`singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_memW0_singlyCancellativeSliceKernel (k : ℕ) (rho : KKernel k)
    (hrho : MemW0 rho) :
    MemW0 (aux_singlyCancellativeSliceKernel k rho) := by
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k)) :=
    isAddHaarMeasure_volume_pi (Fin k)
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  change MemW0 (fun u : RealVector k => ∫ q : ℝ, |rho (u, q)|)
  exact aux_memW0_integral_slice_of_addHaar (aux_memW0_abs hrho)

/--
The $L^1$ contraction for the slice kernel.  It bounds the B² factor in
Proposition `\ref{single cancellative Cauchy-Schwarz}`, formalized by
`singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_eLpNorm_one_singlyCancellativeSliceKernel_le (k : ℕ)
    (rho : KKernel k) (hrho : MemW0 rho) :
    eLpNorm (aux_singlyCancellativeSliceKernel k rho) 1 volume ≤
      eLpNorm rho 1 volume := by
  have hmeas : AEStronglyMeasurable (fun uv : RealVector k × ℝ => |rho uv|) volume :=
    (aux_memW0_abs hrho).aux_continuous.aestronglyMeasurable
  have hslice := aux_eLpNorm_one_integral_slice_le
    (volume : Measure (RealVector k)) (volume : Measure ℝ)
    (f := fun uv : RealVector k × ℝ => |rho uv|)
    (by simpa only [Measure.volume_eq_prod] using hmeas)
  change eLpNorm (fun u : RealVector k => ∫ q : ℝ, |rho (u, q)|) 1 volume ≤
    eLpNorm rho 1 volume
  have habs : eLpNorm (fun uv : RealVector k × ℝ => |rho uv|) 1
      ((volume : Measure (RealVector k)).prod volume) =
      eLpNorm rho 1 ((volume : Measure (RealVector k)).prod volume) := by
    apply eLpNorm_congr_norm_ae
    filter_upwards [] with uv
    simp
  simpa only [Measure.volume_eq_prod, habs] using hslice

/--
The real-valued form of the slice-kernel $L^1$ contraction.  It is the form
used after applying `cubeBLInequality` in the B² term of Proposition
`\ref{single cancellative Cauchy-Schwarz}`, formalized by
`singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_eLpNorm_one_toReal_singlyCancellativeSliceKernel_le (k : ℕ)
    (rho : KKernel k) (hrho : MemW0 rho) :
    (eLpNorm (aux_singlyCancellativeSliceKernel k rho) 1 volume).toReal ≤
      (eLpNorm rho 1 volume).toReal := by
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k)) :=
    isAddHaarMeasure_volume_pi (Fin k)
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  apply ENNReal.toReal_mono
  · exact (memLp_one_iff_integrable.mpr
      (aux_memW0_integrable_of_addHaar hrho)).eLpNorm_ne_top
  · exact aux_eLpNorm_one_singlyCancellativeSliceKernel_le k rho hrho

/--
The normalized cube-Brascamp--Lieb estimate for one slice kernel.  This is
the immediate B² estimate in Proposition `\ref{single cancellative
Cauchy-Schwarz}`, formalized by `singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_singlyCancellative_normalizedCubeBL (n k : ℕ) (hk : 1 ≤ k)
    (hkn : k < n) (rho : KKernel k) (hrho : MemW0 rho)
    (F : Fin n → SchwartzMap (RealVector n) ℝ)
    (hF : F ∈ normalizedFunctionTuples n) :
    |cubeBrascampLiebForm n k hk hkn.le (aux_singlyCancellativeSliceKernel k rho)
      (F ⟨k - 1, by omega⟩)| ≤
      (eLpNorm rho 1 volume).toReal := by
  let i0 : Fin n := ⟨k - 1, by omega⟩
  have hExp : k - 1 + min (n - (k - 1)) 2 = k + min (n - k) 1 := by
    omega
  have hFnorm : eLpNorm (F i0)
      ((2 ^ (k + min (n - k) 1) : ℕ) : ℝ≥0∞) volume = 1 := by
    simpa [i0, hExp] using hF i0
  have hcube := cubeBLInequality n k hk hkn.le
    (aux_singlyCancellativeSliceKernel k rho)
    (aux_memW0_singlyCancellativeSliceKernel k rho hrho) (F i0)
    (aux_memW0_schwartzMap n (F i0)) hFnorm
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k)) :=
    isAddHaarMeasure_volume_pi (Fin k)
  have hLtop : eLpNorm (aux_singlyCancellativeSliceKernel k rho) 1 volume ≠ ∞ := by
    exact (memLp_one_iff_integrable.mpr
      (aux_memW0_integrable_of_addHaar
        (aux_memW0_singlyCancellativeSliceKernel k rho hrho))).eLpNorm_ne_top
  have hreal : ‖cubeBrascampLiebForm n k hk hkn.le
      (aux_singlyCancellativeSliceKernel k rho) (F i0)‖ ≤
      (eLpNorm (aux_singlyCancellativeSliceKernel k rho) 1 volume).toReal := by
    simpa using ENNReal.toReal_mono hLtop hcube
  simpa only [Real.norm_eq_abs] using
    hreal.trans (aux_eLpNorm_one_toReal_singlyCancellativeSliceKernel_le k rho hrho)

/--
The aggregate normalized cube-Brascamp--Lieb estimate for all slice kernels.
It is the B² bound used immediately in Proposition
`\ref{single cancellative Cauchy-Schwarz}`, formalized by
`singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_singlyCancellative_sum_normalizedCubeBL (n k J : ℕ) (hk : 1 ≤ k)
    (hkn : k < n) (rho : Fin J → KKernel k) (hrho : ∀ j, MemW0 (rho j))
    (F : Fin n → SchwartzMap (RealVector n) ℝ)
    (hF : F ∈ normalizedFunctionTuples n) :
    (∑ j, cubeBrascampLiebForm n k hk hkn.le
      (aux_singlyCancellativeSliceKernel k (rho j)) (F ⟨k - 1, by omega⟩)) ≤
      ∑ j, (eLpNorm (rho j) 1 volume).toReal := by
  apply Finset.sum_le_sum
  intro j _
  calc
    cubeBrascampLiebForm n k hk hkn.le
        (aux_singlyCancellativeSliceKernel k (rho j)) (F ⟨k - 1, by omega⟩) ≤
        |cubeBrascampLiebForm n k hk hkn.le
          (aux_singlyCancellativeSliceKernel k (rho j))
          (F ⟨k - 1, by omega⟩)| := le_abs_self _
    _ ≤ (eLpNorm (rho j) 1 volume).toReal :=
      aux_singlyCancellative_normalizedCubeBL n k hk hkn (rho j) (hrho j) F hF

/--
The reordered raw B² integrand in the proof of Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  It is used by
`aux_singlyCancellativeB2_eq_cubeForm` to identify the B² factor.
-/
def aux_singlyCancellativeB2Integrand (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n)
    (rho : KKernel k) (F : RealVector n → ℝ) :
    ((RealVector k × RealVector k) × RealVector (n - k)) × ℝ → ℝ := fun p =>
  let _hk := hk
  |rho (p.1.1.2 - p.1.1.1, coordinateSum p.1.1.1 + p.2 + coordinateSum p.1.2)| *
    (∏ h : Fin k → Fin 2,
      F (concatVector n k hkn (cubeCorner p.1.1 h) p.1.2)) ^ 2

/--
The literal-order raw B² integrand in the proof of Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  It is the input of
`aux_singlyCancellativeB2Original_eq_cubeForm`.
-/
def aux_singlyCancellativeB2OriginalIntegrand (n k : ℕ) (hk : 1 ≤ k)
    (hkn : k ≤ n) (rho : KKernel k) (F : RealVector n → ℝ) :
    (RealVector k × RealVector k) × (ℝ × RealVector (n - k)) → ℝ := fun p =>
  let _hk := hk
  |rho (p.1.2 - p.1.1, coordinateSum p.1.1 + p.2.1 + coordinateSum p.2.2)| *
    (∏ h : Fin k → Fin 2,
      F (concatVector n k hkn (cubeCorner p.1 h) p.2.2)) ^ 2

/--
The Fubini reordering from the manuscript's literal B² variable order
`(y,(t,x))` to `((y,x),t)`.  It is used immediately by
`aux_singlyCancellativeB2Original_eq_cubeForm`.
-/
noncomputable def aux_singlyCancellativeB2Reorder (k d : ℕ) :
    (RealVector k × RealVector k) × (ℝ × RealVector d) ≃ᵐ
      ((RealVector k × RealVector k) × RealVector d) × ℝ :=
  (MeasurableEquiv.prodCongr (MeasurableEquiv.refl _) MeasurableEquiv.prodComm).trans
    MeasurableEquiv.prodAssoc.symm

/-- The literal formula for the B² Fubini reordering. -/
theorem aux_singlyCancellativeB2Reorder_apply (k d : ℕ)
    (y : RealVector k × RealVector k) (t : ℝ) (x : RealVector d) :
    aux_singlyCancellativeB2Reorder k d (y, (t, x)) = ((y, x), t) := rfl

/--
Haar preservation of the B² Fubini reordering.  This justifies the first
integral reordering in `aux_singlyCancellativeB2Original_eq_cubeForm`.
-/
theorem aux_measurePreserving_singlyCancellativeB2Reorder (k d : ℕ) :
    MeasurePreserving (aux_singlyCancellativeB2Reorder k d) volume volume := by
  have h1 : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (RealVector k × RealVector k))
        (MeasurableEquiv.prodComm : ℝ × RealVector d ≃ᵐ RealVector d × ℝ)) volume volume := by
    change MeasurePreserving
      (Prod.map (id : RealVector k × RealVector k → RealVector k × RealVector k)
        (Prod.swap : ℝ × RealVector d → RealVector d × ℝ)) volume volume
    simpa only [Measure.volume_eq_prod] using
      (MeasurePreserving.id (volume : Measure (RealVector k × RealVector k))).prod
        (aux_volume_preserving_prod_swap (volume : Measure ℝ)
          (volume : Measure (RealVector d)))
  have h2 : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        (RealVector k × RealVector k) × (RealVector d × ℝ) ≃ᵐ
          ((RealVector k × RealVector k) × RealVector d) × ℝ) volume volume :=
    (volume_preserving_prodAssoc (α₁ := RealVector k × RealVector k) (β₁ := RealVector d)
      (γ₁ := ℝ)).symm
  change MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm ∘
        MeasurableEquiv.prodCongr (MeasurableEquiv.refl (RealVector k × RealVector k))
          (MeasurableEquiv.prodComm : ℝ × RealVector d ≃ᵐ RealVector d × ℝ)) volume volume
  exact h2.comp h1

/--
Translation invariance of the scalar integral used to form the slice kernel
in the B² calculation of Proposition `\ref{single cancellative Cauchy-Schwarz}`.
-/
theorem aux_singlyCancellative_scalarTranslationIntegral (c : ℝ) (f : ℝ → ℝ) :
    (∫ q : ℝ, f (c + q)) = ∫ q : ℝ, f q := by
  have hmp : MeasurePreserving (MeasurableEquiv.addLeft c : ℝ ≃ᵐ ℝ) volume volume := by
    simpa using (measurePreserving_add_left (volume : Measure ℝ) c)
  simpa using hmp.integral_comp' f

/--
The reordered B² integral is the cube Brascamp--Lieb form with the slice
kernel.  The integrability hypothesis is precisely what permits the Fubini
step in Proposition `\ref{single cancellative Cauchy-Schwarz}`, formalized by
`singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_singlyCancellativeB2_eq_cubeForm (n k : ℕ) (hk : 1 ≤ k)
    (hkn : k < n) (rho : KKernel k) (F : RealVector n → ℝ)
    (hInt : Integrable (aux_singlyCancellativeB2Integrand n k hk hkn.le rho F)) :
    (∫ p : ((RealVector k × RealVector k) × RealVector (n - k)) × ℝ,
      aux_singlyCancellativeB2Integrand n k hk hkn.le rho F p) =
      cubeBrascampLiebForm n k hk hkn.le
        (aux_singlyCancellativeSliceKernel k rho) F := by
  let X := (RealVector k × RealVector k) × RealVector (n - k)
  let H : X × ℝ → ℝ := aux_singlyCancellativeB2Integrand n k hk hkn.le rho F
  have hH : Integrable H ((volume : Measure X).prod (volume : Measure ℝ)) := by
    simpa only [H, X, Measure.volume_eq_prod] using hInt
  have hinner (a : X) :
      (∫ q : ℝ, H (a, q)) =
        aux_singlyCancellativeSliceKernel k rho (a.1.2 - a.1.1) *
          (∏ h : Fin k → Fin 2,
            F (concatVector n k hkn.le (cubeCorner a.1 h) a.2)) ^ 2 := by
    dsimp [H, aux_singlyCancellativeB2Integrand]
    rw [integral_mul_const]
    have htranslate :
        (∫ q : ℝ, |rho (a.1.2 - a.1.1,
          coordinateSum a.1.1 + q + coordinateSum a.2)|) =
          ∫ q : ℝ, |rho (a.1.2 - a.1.1, q)| := by
      calc
        (∫ q : ℝ, |rho (a.1.2 - a.1.1,
          coordinateSum a.1.1 + q + coordinateSum a.2)|) =
          ∫ q : ℝ, |rho (a.1.2 - a.1.1,
            (coordinateSum a.1.1 + coordinateSum a.2) + q)| := by
              apply integral_congr_ae
              filter_upwards [] with q
              congr 1
              congr 1
              apply Prod.ext
              · rfl
              · ring
        _ = ∫ q : ℝ, |rho (a.1.2 - a.1.1, q)| :=
          aux_singlyCancellative_scalarTranslationIntegral
            (coordinateSum a.1.1 + coordinateSum a.2)
            (fun q : ℝ => |rho (a.1.2 - a.1.1, q)|)
    rw [htranslate]
    rfl
  let G : X → ℝ := fun a =>
    aux_singlyCancellativeSliceKernel k rho (a.1.2 - a.1.1) *
      (∏ h : Fin k → Fin 2,
        F (concatVector n k hkn.le (cubeCorner a.1 h) a.2)) ^ 2
  have hG : Integrable G (volume : Measure X) := by
    have h := hH.integral_prod_left
    convert h using 1
    funext a
    exact (hinner a).symm
  have hGprod : Integrable G
      ((volume : Measure (RealVector k × RealVector k)).prod
        (volume : Measure (RealVector (n - k)))) := by
    simpa only [X, Measure.volume_eq_prod] using hG
  have hmin : min (n - k) 1 = 1 := by omega
  change (∫ p : X × ℝ, H p) = _
  calc
    (∫ p : X × ℝ, H p) = ∫ a : X, ∫ q : ℝ, H (a, q) := by
      simpa only [Measure.volume_eq_prod] using (integral_prod H hH)
    _ = ∫ a : X, G a := by
      apply integral_congr_ae
      filter_upwards [] with a
      exact hinner a
    _ = ∫ y : RealVector k × RealVector k, ∫ x : RealVector (n - k), G (y, x) := by
      simpa only [X, Measure.volume_eq_prod] using (integral_prod G hGprod)
    _ = cubeBrascampLiebForm n k hk hkn.le
        (aux_singlyCancellativeSliceKernel k rho) F := by
      unfold cubeBrascampLiebForm
      simp only [G, hmin, pow_one]

/--
Absolute integrability of the literal-order B² integrand in Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  This supplies the Fubini
certificate for the B² calculation in `singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_integrable_singlyCancellativeB2OriginalIntegrand (n k : ℕ)
    (hk : 1 ≤ k) (hkn : k < n) (rho : KKernel k) (hrho : MemW0 rho)
    (F : SchwartzMap (RealVector n) ℝ) :
    Integrable (aux_singlyCancellativeB2OriginalIntegrand n k hk hkn.le rho F) := by
  classical
  let I := (Fin k → Fin 2) × Fin 2
  let a : I := (fun _ => 0, 0)
  let P : I → ((RealVector k × ℝ) × RealVector n) → ℝ := fun hi w =>
    F (aux_prismPullback n k hkn.le hi.1 (0 : Fin (n - k + 1)) w.1.1 w.1.2 w.2)
  let D : ((RealVector k × ℝ) × RealVector n) → ℝ := fun w =>
    |rho w.1| * P a w
  let R : ((RealVector k × ℝ) × RealVector n) → ℝ := fun w =>
    ∏ hi ∈ (Finset.univ.erase a), P hi w
  let C : ℝ := ∏ hi ∈ (Finset.univ.erase a), SchwartzMap.seminorm ℝ 0 0 F
  let H : ((RealVector k × ℝ) × RealVector n) → ℝ := fun w =>
    |rho w.1| * ∏ hi : I, P hi w
  have hPmeas (hi : I) : Measurable (P hi) := by
    dsimp [P]
    exact F.continuous.measurable.comp
      (aux_measurable_prismPullback n k hkn.le hi.1 (0 : Fin (n - k + 1)))
  have hHmeas : Measurable H := by
    dsimp [H]
    exact ((aux_memW0_abs hrho).aux_continuous.measurable.comp measurable_fst).mul
      (Finset.measurable_fun_prod Finset.univ (fun hi _ => hPmeas hi))
  have hRbound (w : ((RealVector k × ℝ) × RealVector n)) : ‖R w‖ ≤ C := by
    dsimp [R, C]
    calc
      ‖∏ hi ∈ Finset.univ.erase a, P hi w‖ ≤
          ∏ hi ∈ Finset.univ.erase a, ‖P hi w‖ := Finset.norm_prod_le _ _
      _ ≤ ∏ hi ∈ Finset.univ.erase a, SchwartzMap.seminorm ℝ 0 0 F := by
          gcongr with hi hhi
          exact F.norm_le_seminorm ℝ _
  have hfactor (w : ((RealVector k × ℝ) × RealVector n)) : H w = D w * R w := by
    dsimp [H, D, R]
    rw [← Finset.mul_prod_erase Finset.univ (fun hi => P hi w) (Finset.mem_univ a)]
    ring
  have hbound (w : ((RealVector k × ℝ) × RealVector n)) : ‖H w‖ ≤ C * ‖D w‖ := by
    rw [hfactor]
    calc
      ‖D w * R w‖ = ‖D w‖ * ‖R w‖ := norm_mul _ _
      _ ≤ ‖D w‖ * C := mul_le_mul_of_nonneg_left (hRbound w) (norm_nonneg _)
      _ = C * ‖D w‖ := mul_comm _ _
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k)) :=
    isAddHaarMeasure_volume_pi (Fin k)
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  have hrhoInt : Integrable (fun u : RealVector k × ℝ => |rho u|) :=
    aux_memW0_integrable_of_addHaar (aux_memW0_abs hrho)
  have hFint : Integrable (F : RealVector n → ℝ) := F.integrable
  have hTensorInt : Integrable (fun w : (RealVector k × ℝ) × RealVector n =>
      |rho w.1| * F w.2) :=
    hrhoInt.mul_prod hFint
  have hD : Integrable D := by
    have hmp := aux_measurePreserving_prismPullbackSkew n k hkn.le a.1
      (0 : Fin (n - k + 1))
    have hcomp := hmp.integrable_comp_of_integrable hTensorInt
    have hD_eq : D =
        (fun w : (RealVector k × ℝ) × RealVector n => |rho w.1| * F w.2) ∘
          fun p : (RealVector k × ℝ) × RealVector n =>
            (p.1, aux_prismPullback n k hkn.le a.1
              (0 : Fin (n - k + 1)) p.1.1 p.1.2 p.2) := by
      rfl
    rw [hD_eq]
    exact hcomp
  have hH : Integrable H := by
    have hDom : Integrable (fun w => C * ‖D w‖) := hD.norm.const_mul C
    exact hDom.mono' hHmeas.aestronglyMeasurable (ae_of_all _ hbound)
  let e : ((RealVector k × ℝ) × RealVector n) ≃ᵐ
      RealVector k × (ℝ × RealVector n) := MeasurableEquiv.prodAssoc
  let T : ((RealVector k × ℝ) × RealVector n) →
      (RealVector k × RealVector k) × (ℝ × RealVector (n - k)) := fun w =>
    let p := aux_prismCoordinates n k hkn.le (e w)
    (p.1, aux_prismTailSplitEquiv (n - k) 0 p.2)
  let O := aux_singlyCancellativeB2OriginalIntegrand n k hk hkn.le rho F
  have hOmeas : Measurable O := by
    have hpointCont (h : Fin k → Fin 2) : Continuous
        (fun p : (RealVector k × RealVector k) × (ℝ × RealVector (n - k)) =>
          concatVector n k hkn.le (cubeCorner p.1 h) p.2.2) := by
      apply continuous_pi
      intro i
      unfold concatVector
      split_ifs with hi
      · unfold cubeCorner
        split_ifs <;> fun_prop
      · fun_prop
    have hprodCont : Continuous
        (fun p : (RealVector k × RealVector k) × (ℝ × RealVector (n - k)) =>
          (∏ h : Fin k → Fin 2,
            F (concatVector n k hkn.le (cubeCorner p.1 h) p.2.2)) ^ 2) := by
      exact (continuous_finsetProd Finset.univ
        (fun h _ => F.continuous.comp (hpointCont h))).pow 2
    have hargCont : Continuous
        (fun p : (RealVector k × RealVector k) × (ℝ × RealVector (n - k)) =>
          (p.1.2 - p.1.1, coordinateSum p.1.1 + p.2.1 + coordinateSum p.2.2)) := by
      have hu : Continuous (fun p : (RealVector k × RealVector k) ×
          (ℝ × RealVector (n - k)) => p.1.2 - p.1.1) :=
        (continuous_snd.comp continuous_fst).sub (continuous_fst.comp continuous_fst)
      have hs : Continuous (fun p : (RealVector k × RealVector k) ×
          (ℝ × RealVector (n - k)) =>
          coordinateSum p.1.1 + p.2.1 + coordinateSum p.2.2) :=
        (((aux_continuous_coordinateSum k).comp (continuous_fst.comp continuous_fst)).add
          (continuous_fst.comp continuous_snd)).add
          ((aux_continuous_coordinateSum (n - k)).comp (continuous_snd.comp continuous_snd))
      exact hu.prodMk hs
    dsimp [O, aux_singlyCancellativeB2OriginalIntegrand]
    exact ((aux_memW0_abs hrho).aux_continuous.measurable.comp hargCont.measurable).mul
      hprodCont.measurable
  have hprism : MeasurePreserving (aux_prismCoordinates n k hkn.le) volume volume :=
    aux_measurePreserving_prismCoordinates n k hkn.le
  have htail : MeasurePreserving
      (Prod.map (id : RealVector k × RealVector k → RealVector k × RealVector k)
        (aux_prismTailSplitEquiv (n - k) 0)) volume volume := by
    simpa only [Measure.volume_eq_prod, id_eq] using
      (MeasurePreserving.id (volume : Measure (RealVector k × RealVector k))).prod
        (aux_measurePreserving_prismTailSplit (n - k) 0)
  have hAssoc : MeasurePreserving e volume volume :=
    volume_preserving_prodAssoc
  have hT : MeasurePreserving T volume volume := by
    change MeasurePreserving
      ((Prod.map (id : RealVector k × RealVector k → RealVector k × RealVector k)
        (aux_prismTailSplitEquiv (n - k) 0)) ∘ aux_prismCoordinates n k hkn.le ∘ e)
      volume volume
    exact htail.comp (hprism.comp hAssoc)
  have hOH : O ∘ T = H := by
    funext w
    rcases w with ⟨⟨u, s⟩, z⟩
    let p := aux_prismCoordinates n k hkn.le (u, (s, z))
    have hsum : coordinateSum p.1.1 +
        (aux_prismTailSplitEquiv (n - k) 0 p.2).1 +
          coordinateSum (aux_prismTailSplitEquiv (n - k) 0 p.2).2 =
        coordinateSum p.1.1 + coordinateSum p.2 := by
      rw [aux_prismTailSplitEquiv_apply, aux_coordinateSum_eraseVector]
      ring
    have hkernel : (p.1.2 - p.1.1, coordinateSum p.1.1 + coordinateSum p.2) = (u, s) := by
      exact aux_prismCoordinates_kernelArguments n k hkn.le u s z
    have hpoint (h : Fin k → Fin 2) :
        concatVector n k hkn.le (cubeCorner p.1 h)
          (aux_prismTailSplitEquiv (n - k) 0 p.2).2 =
        aux_prismPullback n k hkn.le h (0 : Fin (n - k + 1)) u s z := by
      rw [aux_prismTailSplitEquiv_apply]
      change prismPoint hk hkn.le p.1 p.2 h (0 : Fin (n - k + 1)) = _
      exact aux_prismPoint_eq_prismPullbackCoordinates n k hk hkn.le u s z h 0
    have hprod :
        (∏ h : Fin k → Fin 2,
          F (concatVector n k hkn.le (cubeCorner p.1 h)
            (aux_prismTailSplitEquiv (n - k) 0 p.2).2)) =
          ∏ h : Fin k → Fin 2,
            F (aux_prismPullback n k hkn.le h (0 : Fin (n - k + 1)) u s z) := by
      apply Finset.prod_congr rfl
      intro h _
      exact congrArg F (hpoint h)
    have hdup : (∏ hi : I, P hi ((u, s), z)) =
        (∏ h : Fin k → Fin 2,
          F (aux_prismPullback n k hkn.le h (0 : Fin (n - k + 1)) u s z)) ^ 2 := by
      rw [Fintype.prod_prod_type]
      simp only [Fin.prod_univ_two, P, pow_two]
      rw [Finset.prod_mul_distrib]
    dsimp [O, T, e, H, Function.comp_def]
    change |rho (p.1.2 - p.1.1,
      coordinateSum p.1.1 + (aux_prismTailSplitEquiv (n - k) 0 p.2).1 +
        coordinateSum (aux_prismTailSplitEquiv (n - k) 0 p.2).2)| *
        (∏ h : Fin k → Fin 2,
          F (concatVector n k hkn.le (cubeCorner p.1 h)
            (aux_prismTailSplitEquiv (n - k) 0 p.2).2)) ^ 2 =
      |rho (u, s)| * ∏ hi : I, P hi ((u, s), z)
    rw [hsum, hkernel, hprod, hdup]
  have hOcomp : Integrable (O ∘ T) := by
    rw [hOH]
    exact hH
  exact (hT.integrable_comp hOmeas.aestronglyMeasurable).mp hOcomp

/--
The literal-order B² integral is the cube Brascamp--Lieb form with the slice
kernel.  This is the B² identification in Proposition
`\ref{single cancellative Cauchy-Schwarz}`, formalized by
`singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_singlyCancellativeB2Original_eq_cubeForm (n k : ℕ) (hk : 1 ≤ k)
    (hkn : k < n) (rho : KKernel k) (F : RealVector n → ℝ)
    (hInt : Integrable (aux_singlyCancellativeB2OriginalIntegrand n k hk hkn.le rho F)) :
    (∫ p : (RealVector k × RealVector k) × (ℝ × RealVector (n - k)),
      aux_singlyCancellativeB2OriginalIntegrand n k hk hkn.le rho F p) =
      cubeBrascampLiebForm n k hk hkn.le
        (aux_singlyCancellativeSliceKernel k rho) F := by
  let e := aux_singlyCancellativeB2Reorder k (n - k)
  let H : ((RealVector k × RealVector k) × RealVector (n - k)) × ℝ → ℝ :=
    aux_singlyCancellativeB2Integrand n k hk hkn.le rho F
  let O : (RealVector k × RealVector k) × (ℝ × RealVector (n - k)) → ℝ :=
    aux_singlyCancellativeB2OriginalIntegrand n k hk hkn.le rho F
  have hcomp : Integrable (H ∘ e) := by
    convert hInt using 1
    funext p
    rcases p with ⟨y, t, x⟩
    change O (y, (t, x)) = H (e (y, (t, x)))
    rw [aux_singlyCancellativeB2Reorder_apply]
    dsimp [H, O, aux_singlyCancellativeB2Integrand,
      aux_singlyCancellativeB2OriginalIntegrand]
  have hmp := aux_measurePreserving_singlyCancellativeB2Reorder k (n - k)
  have hmpinv := hmp.symm e
  have hHcomp := hmpinv.integrable_comp_of_integrable hcomp
  have hH : Integrable H := by
    simpa [Function.comp_def] using hHcomp
  calc
    (∫ p : (RealVector k × RealVector k) × (ℝ × RealVector (n - k)),
        aux_singlyCancellativeB2OriginalIntegrand n k hk hkn.le rho F p) =
        ∫ p : (RealVector k × RealVector k) × (ℝ × RealVector (n - k)), H (e p) := by
          apply integral_congr_ae
          filter_upwards [] with p
          rcases p with ⟨y, t, x⟩
          change O (y, (t, x)) = H (e (y, (t, x)))
          rw [aux_singlyCancellativeB2Reorder_apply]
          rfl
    _ = ∫ q : ((RealVector k × RealVector k) × RealVector (n - k)) × ℝ, H q :=
      hmp.integral_comp' H
    _ = cubeBrascampLiebForm n k hk hkn.le
        (aux_singlyCancellativeSliceKernel k rho) F := by
      exact aux_singlyCancellativeB2_eq_cubeForm n k hk hkn rho F hH

/--
The finite sum of literal B² integrals is the corresponding sum of slice-kernel
cube Brascamp--Lieb forms.  This is the aggregate Fubini identity in
Proposition `\ref{single cancellative Cauchy-Schwarz}`, used by
`singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_singlyCancellativeB2Original_sum_eq_cubeForm
    (n k J : ℕ) (hk : 1 ≤ k) (hkn : k < n)
    (rho : Fin J → KKernel k) (hrho : ∀ j, MemW0 (rho j))
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    (∑ j : Fin J, ∫ p : (RealVector k × RealVector k) ×
        (ℝ × RealVector (n - k)),
      aux_singlyCancellativeB2OriginalIntegrand n k hk hkn.le (rho j)
        (F ⟨k - 1, by omega⟩) p) =
      ∑ j : Fin J, cubeBrascampLiebForm n k hk hkn.le
        (aux_singlyCancellativeSliceKernel k (rho j))
        (F ⟨k - 1, by omega⟩) := by
  apply Finset.sum_congr rfl
  intro j _
  exact aux_singlyCancellativeB2Original_eq_cubeForm n k hk hkn (rho j)
    (F ⟨k - 1, by omega⟩)
    (aux_integrable_singlyCancellativeB2OriginalIntegrand n k hk hkn
      (rho j) (hrho j) (F ⟨k - 1, by omega⟩))

/--
The aggregate B² estimate in Proposition `\ref{single cancellative
Cauchy-Schwarz}`.  It is the total B² bound used immediately in
`singlyCancellativeCauchySchwarz_bound` after the outer Cauchy--Schwarz split.
-/
theorem aux_singlyCancellativeB2Original_sum_le
    (n k J : ℕ) (hk : 1 ≤ k) (hkn : k < n)
    (rho : Fin J → KKernel k) (hrho : ∀ j, MemW0 (rho j))
    (F : Fin n → SchwartzMap (RealVector n) ℝ)
    (hF : F ∈ normalizedFunctionTuples n) :
    (∑ j : Fin J, ∫ p : (RealVector k × RealVector k) ×
        (ℝ × RealVector (n - k)),
      aux_singlyCancellativeB2OriginalIntegrand n k hk hkn.le (rho j)
        (F ⟨k - 1, by omega⟩) p) ≤
      ∑ j : Fin J, (eLpNorm (rho j) 1 volume).toReal := by
  rw [aux_singlyCancellativeB2Original_sum_eq_cubeForm n k J hk hkn rho hrho F]
  exact aux_singlyCancellative_sum_normalizedCubeBL n k J hk hkn rho hrho F hF

/--
The B-side `L²` certificate for the weighted Cauchy--Schwarz application in
Proposition `\ref{single cancellative Cauchy-Schwarz}`.  It is used directly
by `singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_memLp_singlyCancellativeCSRawB
    (n k J : ℕ) (hk : 1 ≤ k) (hkn : k < n)
    (rho : Fin J → KKernel k) (hrho : ∀ j, MemW0 (rho j))
    (F : Fin n → SchwartzMap (RealVector n) ℝ) (j : Fin J) :
    MemLp (fun p : aux_singlyCancellativeCSPairingSpace n k =>
      Real.sqrt |aux_singlyCancellativeCSRawR n k (rho j) p| *
        aux_singlyCancellativeCSRawB n k hk hkn.le F p) 2 volume := by
  let i0 : Fin n := ⟨k - 1, by omega⟩
  have hpointCont (h : Fin k → Fin 2) : Continuous
      (fun p : aux_singlyCancellativeCSPairingSpace n k =>
        concatVector n k hkn.le (cubeCorner p.1 h) p.2.2) := by
    apply continuous_pi
    intro i
    unfold concatVector
    split_ifs with hi
    · unfold cubeCorner
      split_ifs <;> fun_prop
    · fun_prop
  have hBCont : Continuous (aux_singlyCancellativeCSRawB n k hk hkn.le F) := by
    unfold aux_singlyCancellativeCSRawB aux_singlyCancellativeBProduct
    apply continuous_finsetProd Finset.univ
    intro h _
    exact (F (prismIndex hk hkn.le (0 : Fin (n - k + 1)))).continuous.comp
      (hpointCont h)
  have hargCont : Continuous
      (fun p : aux_singlyCancellativeCSPairingSpace n k =>
        (p.1.2 - p.1.1, coordinateSum p.1.1 + p.2.1 + coordinateSum p.2.2)) := by
    have hu : Continuous (fun p : aux_singlyCancellativeCSPairingSpace n k =>
        p.1.2 - p.1.1) :=
      (continuous_snd.comp continuous_fst).sub (continuous_fst.comp continuous_fst)
    have hs : Continuous (fun p : aux_singlyCancellativeCSPairingSpace n k =>
        coordinateSum p.1.1 + p.2.1 + coordinateSum p.2.2) :=
      (((aux_continuous_coordinateSum k).comp (continuous_fst.comp continuous_fst)).add
        (continuous_fst.comp continuous_snd)).add
        ((aux_continuous_coordinateSum (n - k)).comp (continuous_snd.comp continuous_snd))
    exact hu.prodMk hs
  have hRCont : Continuous (aux_singlyCancellativeCSRawR n k (rho j)) := by
    unfold aux_singlyCancellativeCSRawR
    exact (hrho j).aux_continuous.comp hargCont
  have hfMeas : AEStronglyMeasurable
      (fun p : aux_singlyCancellativeCSPairingSpace n k =>
        Real.sqrt |aux_singlyCancellativeCSRawR n k (rho j) p| *
          aux_singlyCancellativeCSRawB n k hk hkn.le F p) volume :=
    ((hRCont.abs.sqrt).mul hBCont).aestronglyMeasurable
  refine (memLp_two_iff_integrable_sq hfMeas).2 ?_
  have hInt := aux_integrable_singlyCancellativeB2OriginalIntegrand n k hk hkn
    (rho j) (hrho j) (F i0)
  let G : aux_singlyCancellativeCSPairingSpace n k → ℝ := fun p =>
    aux_singlyCancellativeB2OriginalIntegrand n k hk hkn.le (rho j) (F i0) p
  have hG : Integrable G := by
    dsimp [G]
    exact hInt
  have hEq : (fun p : aux_singlyCancellativeCSPairingSpace n k =>
      (Real.sqrt |aux_singlyCancellativeCSRawR n k (rho j) p| *
        aux_singlyCancellativeCSRawB n k hk hkn.le F p) ^ 2) = G := by
    funext p
    have hidx : prismIndex hk hkn.le (0 : Fin (n - k + 1)) = i0 := by
      apply Fin.ext
      simp [prismIndex, i0]
    dsimp [G]
    unfold aux_singlyCancellativeCSRawR aux_singlyCancellativeCSRawB
      aux_singlyCancellativeBProduct aux_singlyCancellativeB2OriginalIntegrand
    rw [hidx, mul_pow, Real.sq_sqrt (abs_nonneg _)]
  rw [hEq]
  exact hG

/--
The outer finite weighted Cauchy--Schwarz step in Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  The hypotheses retain the
separate `A²` certificate so that `singlyCancellativeCauchySchwarz_bound`
can identify it with the lifted prism form.
-/
theorem aux_singlyCancellativeCS_pairing_cauchy
    (n k J : ℕ) (hk : 1 ≤ k) (hkn : k < n)
    (rho : Fin J → KKernel k) (phi : Fin J → ℝ → ℝ)
    (hrho : ∀ j, MemW0 (rho j)) (hphi : ∀ j, MemW0 (phi j))
    (F : Fin n → SchwartzMap (RealVector n) ℝ)
    (hA : ∀ j, MemLp (fun p : aux_singlyCancellativeCSPairingSpace n k =>
      Real.sqrt |aux_singlyCancellativeCSRawR n k (rho j) p| *
        aux_singlyCancellativeCSRawA n k hk hkn.le (phi j) F p) 2 volume) :
    |∑ j, ∫ p : aux_singlyCancellativeCSPairingSpace n k,
      aux_singlyCancellativeCSRawR n k (rho j) p *
        aux_singlyCancellativeCSRawA n k hk hkn.le (phi j) F p *
          aux_singlyCancellativeCSRawB n k hk hkn.le F p| ^ 2 ≤
      (∑ j, ∫ p : aux_singlyCancellativeCSPairingSpace n k,
        |Real.sqrt |aux_singlyCancellativeCSRawR n k (rho j) p| *
          aux_singlyCancellativeCSRawA n k hk hkn.le (phi j) F p| ^ (2 : ℝ)) *
        (∑ j, ∫ p : aux_singlyCancellativeCSPairingSpace n k,
          |Real.sqrt |aux_singlyCancellativeCSRawR n k (rho j) p| *
            aux_singlyCancellativeCSRawB n k hk hkn.le F p| ^ (2 : ℝ)) := by
  exact aux_finite_weightedCauchySchwarz volume J
    (fun j => aux_singlyCancellativeCSRawR n k (rho j))
    (fun j p => |aux_singlyCancellativeCSRawR n k (rho j) p|)
    (fun j => aux_singlyCancellativeCSRawA n k hk hkn.le (phi j) F)
    (aux_singlyCancellativeCSRawB n k hk hkn.le F)
    (fun _ _ => abs_nonneg _)
    (fun _ _ => le_rfl)
    hA
    (fun j => aux_memLp_singlyCancellativeCSRawB n k J hk hkn rho hrho F j)
    (fun j => aux_integrable_singlyCancellativeCSRawPairing n k hk hkn.le
      (rho j) (hrho j) (phi j) (hphi j) F)

/--
Auxiliary continuous linear splitting of a finite coordinate vector into its
first `k` coordinates and its final coordinate.  It is used only to expose
the affine fibre coordinates in the lifted kernel.
-/
noncomputable def aux_lastCoordinateSplit (k : ℕ) :
    RealVector (k + 1) ≃L[ℝ] (RealVector k × ℝ) where
  toFun x := (fun i => x i.castSucc, x (Fin.last k))
  invFun p := Fin.lastCases p.2 (fun i => p.1 i)
  left_inv x := by
    funext i
    refine Fin.lastCases ?_ (fun j => ?_) i <;> simp
  right_inv p := by
    apply Prod.ext
    · funext i
      simp
    · simp
  map_add' x y := by
    apply Prod.ext
    · funext i
      simp
    · simp
  map_smul' c x := by
    apply Prod.ext
    · funext i
      simp
    · simp
  continuous_toFun := by
    exact (continuous_pi fun i => continuous_apply i.castSucc).prodMk
      (continuous_apply (Fin.last k))
  continuous_invFun := by
    apply continuous_pi
    intro i
    refine Fin.lastCases ?_ (fun j => ?_) i
    · simpa using (continuous_snd : Continuous (fun p : RealVector k × ℝ => p.2))
    · have hcoord : Continuous (fun p : RealVector k × ℝ => p.1 j) :=
        (continuous_apply (A := fun _ : Fin k => ℝ) j).comp continuous_fst
      simpa only [Fin.lastCases_castSucc, Function.comp_apply] using hcoord

/--
Auxiliary involutory scalar shear on the coordinates exposed by
`aux_lastCoordinateSplit`.  Its two nontrivial scalar coordinates are exactly
the changes `t \mapsto t-q` and `b \mapsto b+q` in the lifted kernel.
-/
noncomputable def aux_singlyCancellativeLiftScalarShear (k : ℕ) :
    (((RealVector k × ℝ) × ℝ) × ℝ) ≃L[ℝ] (((RealVector k × ℝ) × ℝ) × ℝ) where
  toFun := fun p => (((p.1.1.1, p.1.2 - p.2), p.1.1.2 + p.2), p.2)
  invFun := fun p => (((p.1.1.1, p.1.2 - p.2), p.1.1.2 + p.2), p.2)
  left_inv := by
    rintro ⟨⟨⟨a, b⟩, t⟩, q⟩
    apply Prod.ext
    · apply Prod.ext
      · apply Prod.ext
        · rfl
        · change (b + q) - q = b
          ring
      · change (t - q) + q = t
        ring
    · rfl
  right_inv := by
    rintro ⟨⟨⟨a, b⟩, t⟩, q⟩
    apply Prod.ext
    · apply Prod.ext
      · apply Prod.ext
        · rfl
        · change (b + q) - q = b
          ring
      · change (t - q) + q = t
        ring
    · rfl
  map_add' := by
    rintro ⟨⟨⟨a, b⟩, t⟩, q⟩ ⟨⟨⟨a', b'⟩, t'⟩, q'⟩
    apply Prod.ext
    · apply Prod.ext
      · apply Prod.ext
        · rfl
        · change t + t' - (q + q') = (t - q) + (t' - q')
          ring
      · change b + b' + (q + q') = (b + q) + (b' + q')
        ring
    · rfl
  map_smul' := by
    rintro c ⟨⟨⟨a, b⟩, t⟩, q⟩
    apply Prod.ext
    · apply Prod.ext
      · apply Prod.ext
        · rfl
        · change c * t - c * q = c * (t - q)
          ring
      · change c * b + c * q = c * (b + q)
        ring
    · rfl
  continuous_toFun := by fun_prop
  continuous_invFun := by fun_prop

/--
Auxiliary affine coordinate equivalence used to turn the lifted summand into
a coordinate-fibre integral of a three-factor tensor product.
-/
noncomputable def aux_singlyCancellativeLiftShear (k : ℕ) :
    ((RealVector (k + 1) × ℝ) × ℝ) ≃L[ℝ]
      (((RealVector k × ℝ) × ℝ) × ℝ) :=
  (((aux_lastCoordinateSplit k).prodCongr (ContinuousLinearEquiv.refl ℝ ℝ)).prodCongr
    (ContinuousLinearEquiv.refl ℝ ℝ)).trans (aux_singlyCancellativeLiftScalarShear k)

/--
The explicit coordinate formula for `aux_singlyCancellativeLiftShear`.
This records the identification used when transporting the tensor-product
`W₀` membership back to the literal lifted-kernel formula.
-/
theorem aux_singlyCancellativeLiftShear_apply (k : ℕ)
    (u : RealVector (k + 1) × ℝ) (q : ℝ) :
    aux_singlyCancellativeLiftShear k (u, q) =
      (((fun i => u.1 i.castSucc, u.2 - q), u.1 (Fin.last k) + q), q) := by
  simp [aux_singlyCancellativeLiftShear, aux_lastCoordinateSplit,
    aux_singlyCancellativeLiftScalarShear]

/-- Haar preservation of the final-coordinate splitting used in the lift shear. -/
theorem aux_measurePreserving_lastCoordinateSplit (k : ℕ) :
    MeasurePreserving (aux_lastCoordinateSplit k) volume volume := by
  have hsplit : MeasurePreserving
      (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (k + 1) => ℝ) (Fin.last k))
      (volume : Measure (RealVector (k + 1))) volume := by
    simpa using
      (volume_preserving_piFinSuccAbove (fun _ : Fin (k + 1) => ℝ) (Fin.last k))
  have hswap : MeasurePreserving
      (Prod.swap : ℝ × RealVector k → RealVector k × ℝ) volume volume := by
    simpa only [Measure.volume_eq_prod] using
      (aux_volume_preserving_prod_swap (volume : Measure ℝ)
        (volume : Measure (RealVector k)))
  convert hswap.comp hsplit using 1
  funext x
  simp only [Function.comp_apply, aux_lastCoordinateSplit,
    MeasurableEquiv.piFinSuccAbove, Fin.insertNthEquiv]
  apply Prod.ext
  · funext i
    simp [Fin.init]
  · rfl

/-- Haar preservation of the scalar part of the lifted-kernel shear. -/
theorem aux_measurePreserving_singlyCancellativeLiftScalarShear (k : ℕ) :
    MeasurePreserving (aux_singlyCancellativeLiftScalarShear k) volume volume := by
  have hassoc : MeasurePreserving
      (MeasurableEquiv.prodAssoc :
        (RealVector k × ℝ) × ℝ ≃ᵐ RealVector k × (ℝ × ℝ)) volume volume :=
    volume_preserving_prodAssoc
  have hswapProd : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (RealVector k))
        (MeasurableEquiv.prodComm : ℝ × ℝ ≃ᵐ ℝ × ℝ)) volume volume := by
    change MeasurePreserving
      (Prod.map (id : RealVector k → RealVector k) (Prod.swap : ℝ × ℝ → ℝ × ℝ))
      volume volume
    simpa only [Measure.volume_eq_prod] using
      (MeasurePreserving.id (volume : Measure (RealVector k))).prod
        (aux_volume_preserving_prod_swap (volume : Measure ℝ) (volume : Measure ℝ))
  have hassocSymm : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        RealVector k × (ℝ × ℝ) ≃ᵐ (RealVector k × ℝ) × ℝ) volume volume :=
    (volume_preserving_prodAssoc (α₁ := RealVector k) (β₁ := ℝ) (γ₁ := ℝ)).symm
  have hswapBt : MeasurePreserving
      (fun p : (RealVector k × ℝ) × ℝ => ((p.1.1, p.2), p.1.2)) volume volume := by
    convert hassocSymm.comp (hswapProd.comp hassoc) using 1
    rfl
  have hfiberAt (q : ℝ) : MeasurePreserving
      (fun p : (RealVector k × ℝ) × ℝ => ((p.1.1, p.1.2 + q), p.2 - q))
      volume volume := by
    have hprod : MeasurePreserving
        (Prod.map
          (Prod.map (id : RealVector k → RealVector k) (fun b : ℝ => b + q))
          (fun t : ℝ => t - q))
        ((volume : Measure (RealVector k × ℝ)).prod (volume : Measure ℝ))
        ((volume : Measure (RealVector k × ℝ)).prod (volume : Measure ℝ)) := by
      exact ((MeasurePreserving.id (volume : Measure (RealVector k))).prod
        (measurePreserving_add_right (volume : Measure ℝ) q)).prod
          (measurePreserving_sub_right (volume : Measure ℝ) q)
    convert hprod using 1 <;> rfl
  have hfiber : MeasurePreserving
      (fun p : ℝ × ((RealVector k × ℝ) × ℝ) =>
        (p.1, ((p.2.1.1, p.2.1.2 + p.1), p.2.2 - p.1))) volume volume := by
    have h := MeasurePreserving.skew_product
      (μa := (volume : Measure ℝ)) (μb := (volume : Measure ℝ))
      (μc := (volume : Measure ((RealVector k × ℝ) × ℝ)))
      (μd := (volume : Measure ((RealVector k × ℝ) × ℝ)))
      (f := id)
      (g := fun (q : ℝ) (p : (RealVector k × ℝ) × ℝ) =>
        ((p.1.1, p.1.2 + q), p.2 - q))
      (MeasurePreserving.id (volume : Measure ℝ))
      (((continuous_snd.fst.fst).prodMk
        (continuous_snd.fst.snd.add continuous_fst)).prodMk
          (continuous_snd.snd.sub continuous_fst)).measurable
      (ae_of_all _ fun q => (hfiberAt q).map_eq)
    simpa only [Measure.volume_eq_prod, id_eq] using h
  have hswapIn : MeasurePreserving
      (Prod.swap : ((RealVector k × ℝ) × ℝ) × ℝ →
        ℝ × ((RealVector k × ℝ) × ℝ)) volume volume := by
    simpa only [Measure.volume_eq_prod] using
      (aux_volume_preserving_prod_swap
        (volume : Measure ((RealVector k × ℝ) × ℝ)) (volume : Measure ℝ))
  have hswapOut : MeasurePreserving
      (Prod.swap : ℝ × ((RealVector k × ℝ) × ℝ) →
        ((RealVector k × ℝ) × ℝ) × ℝ) volume volume := by
    simpa only [Measure.volume_eq_prod] using
      (aux_volume_preserving_prod_swap (volume : Measure ℝ)
        (volume : Measure ((RealVector k × ℝ) × ℝ)))
  have hliftSwap : MeasurePreserving
      (Prod.map (fun p : (RealVector k × ℝ) × ℝ => ((p.1.1, p.2), p.1.2))
        (id : ℝ → ℝ)) volume volume := by
    simpa only [Measure.volume_eq_prod] using
      hswapBt.prod (MeasurePreserving.id (volume : Measure ℝ))
  convert hliftSwap.comp (hswapOut.comp (hfiber.comp hswapIn)) using 1
  funext p
  rcases p with ⟨⟨⟨a, b⟩, t⟩, q⟩
  rfl

/--
The grouped source space for the normalized A² coordinate change in
Proposition `\ref{single cancellative Cauchy-Schwarz}`.  It keeps the scalar
reflected by the change of variables as the final coordinate.
-/
abbrev aux_singlyCancellativeA2GroupedSource (k d : ℕ) :=
  (((RealVector k × ℝ) × (RealVector k × ℝ)) × RealVector (d + 1)) × ℝ

/--
The target space for the normalized A² coordinate change in Proposition
`\ref{single cancellative Cauchy-Schwarz}`.
-/
abbrev aux_singlyCancellativeA2Target (k d : ℕ) :=
  ((RealVector (k + 1) × RealVector (k + 1)) × ℝ) × RealVector (d + 1)

/--
The grouped A² coordinate map.  It inserts the two final cube coordinates
and makes the scalar replacement `t \mapsto r_0-t` used by the A² term of
`singlyCancellativeCauchySchwarz_bound`.
-/
noncomputable def aux_singlyCancellativeA2CoordinatesGrouped (k d : ℕ) :
    aux_singlyCancellativeA2GroupedSource k d → aux_singlyCancellativeA2Target k d := fun p =>
  (((Fin.lastCases p.1.1.1.2 p.1.1.1.1,
      Fin.lastCases p.1.1.2.2 p.1.1.2.1),
    p.1.1.1.2 - p.2), p.1.2)

/-- The literal coordinate formula for the grouped A² change of variables. -/
theorem aux_singlyCancellativeA2CoordinatesGrouped_apply (k d : ℕ)
    (y0 y1 : RealVector k) (r0 r1 t : ℝ) (x : RealVector (d + 1)) :
    aux_singlyCancellativeA2CoordinatesGrouped k d ((((y0, r0), (y1, r1)), x), t) =
      (((Fin.lastCases r0 y0, Fin.lastCases r1 y1), r0 - t), x) := rfl

/--
The involutory scalar reflection in the grouped A² source coordinates.  It
is one component of the Haar-preserving map used by
`aux_singlyCancellativeA2_integral_cornerProduct`.
-/
noncomputable def aux_singlyCancellativeA2GroupedScalarShearEquiv (k d : ℕ) :
    aux_singlyCancellativeA2GroupedSource k d ≃ᵐ aux_singlyCancellativeA2GroupedSource k d where
  toFun p := (p.1, p.1.1.1.2 - p.2)
  invFun p := (p.1, p.1.1.1.2 - p.2)
  left_inv p := by
    apply Prod.ext
    · rfl
    · dsimp
      ring
  right_inv p := by
    apply Prod.ext
    · rfl
    · dsimp
      ring
  measurable_toFun :=
    (continuous_fst.prodMk
      ((continuous_snd.comp (continuous_fst.comp (continuous_fst.comp continuous_fst))).sub
        continuous_snd)).measurable
  measurable_invFun :=
    (continuous_fst.prodMk
      ((continuous_snd.comp (continuous_fst.comp (continuous_fst.comp continuous_fst))).sub
        continuous_snd)).measurable

/--
The Fubini reassociation used in the grouped A² coordinate change.  It is an
immediate component of `aux_singlyCancellativeA2CoordinatesGroupedEquiv`.
-/
noncomputable def aux_singlyCancellativeA2GroupedReorder (k d : ℕ) :
    aux_singlyCancellativeA2GroupedSource k d ≃ᵐ
      (((RealVector k × ℝ) × (RealVector k × ℝ)) × ℝ) × RealVector (d + 1) :=
  MeasurableEquiv.prodAssoc.trans
    ((MeasurableEquiv.prodCongr (MeasurableEquiv.refl _)
      MeasurableEquiv.prodComm).trans MeasurableEquiv.prodAssoc.symm)

/--
Haar preservation of the A² Fubini reassociation.  This is used immediately
in `aux_measurePreserving_singlyCancellativeA2CoordinatesGrouped`.
-/
theorem aux_measurePreserving_singlyCancellativeA2GroupedReorder (k d : ℕ) :
    MeasurePreserving (aux_singlyCancellativeA2GroupedReorder k d) volume volume := by
  let P := (RealVector k × ℝ) × (RealVector k × ℝ)
  have hassoc₁ : MeasurePreserving (MeasurableEquiv.prodAssoc :
      (P × RealVector (d + 1)) × ℝ ≃ᵐ P × (RealVector (d + 1) × ℝ)) volume volume :=
    volume_preserving_prodAssoc
  have hswap : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl P)
        (MeasurableEquiv.prodComm : RealVector (d + 1) × ℝ ≃ᵐ ℝ × RealVector (d + 1)))
      volume volume := by
    change MeasurePreserving
      (Prod.map (id : P → P) (Prod.swap : RealVector (d + 1) × ℝ → ℝ × RealVector (d + 1)))
      volume volume
    simpa only [Measure.volume_eq_prod, id_eq] using
      (MeasurePreserving.id (volume : Measure P)).prod
        (aux_volume_preserving_prod_swap (volume : Measure (RealVector (d + 1)))
          (volume : Measure ℝ))
  have hassoc₂ : MeasurePreserving (MeasurableEquiv.prodAssoc.symm :
      P × (ℝ × RealVector (d + 1)) ≃ᵐ (P × ℝ) × RealVector (d + 1)) volume volume :=
    volume_preserving_prodAssoc.symm
  change MeasurePreserving
    (MeasurableEquiv.prodAssoc.symm ∘
      ((MeasurableEquiv.prodCongr (MeasurableEquiv.refl P)
        (MeasurableEquiv.prodComm : RealVector (d + 1) × ℝ ≃ᵐ ℝ × RealVector (d + 1))) ∘
        MeasurableEquiv.prodAssoc)) volume volume
  exact hassoc₂.comp (hswap.comp hassoc₁)

/--
The final-coordinate insertion in the grouped A² coordinate map.  It is used
only to establish Haar preservation of the map needed by
`aux_singlyCancellativeA2_integral_cornerProduct`.
-/
noncomputable def aux_singlyCancellativeA2GroupedLastCoordinateMap (k d : ℕ) :
    (((RealVector k × ℝ) × (RealVector k × ℝ)) × ℝ) × RealVector (d + 1) →
      aux_singlyCancellativeA2Target k d := fun p =>
  ((((aux_lastCoordinateSplit k).symm p.1.1.1,
      (aux_lastCoordinateSplit k).symm p.1.1.2), p.1.2), p.2)

/--
Haar preservation of the final-coordinate insertion used in the grouped A²
map.  This is an immediate component of
`aux_measurePreserving_singlyCancellativeA2CoordinatesGrouped`.
-/
theorem aux_measurePreserving_singlyCancellativeA2GroupedLastCoordinateMap (k d : ℕ) :
    MeasurePreserving (aux_singlyCancellativeA2GroupedLastCoordinateMap k d) volume volume := by
  let e := (aux_lastCoordinateSplit k).toHomeomorph.toMeasurableEquiv
  have hsplit : MeasurePreserving e volume volume := by
    simpa [e] using aux_measurePreserving_lastCoordinateSplit k
  have hinv : MeasurePreserving e.symm volume volume := hsplit.symm e
  have hpair : MeasurePreserving (Prod.map e.symm e.symm) volume volume := by
    simpa only [Measure.volume_eq_prod] using hinv.prod hinv
  have hpairq : MeasurePreserving
      (Prod.map (Prod.map e.symm e.symm) (id : ℝ → ℝ)) volume volume := by
    simpa only [Measure.volume_eq_prod, id_eq] using
      hpair.prod (MeasurePreserving.id (volume : Measure ℝ))
  have hwhole := hpairq.prod (MeasurePreserving.id (volume : Measure (RealVector (d + 1))))
  convert hwhole using 1 <;> rfl

/--
The grouped A² map preserves Haar measure.  This packages the scalar
reflection, Fubini reassociation, and two final-coordinate insertions used to
identify the A² factor in `singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_measurePreserving_singlyCancellativeA2CoordinatesGrouped (k d : ℕ) :
    MeasurePreserving (aux_singlyCancellativeA2CoordinatesGrouped k d) volume volume := by
  let B := ((RealVector k × ℝ) × (RealVector k × ℝ)) × RealVector (d + 1)
  let c : B → ℝ := fun b => b.1.1.2
  have hc : Continuous c := by
    dsimp [c]
    exact continuous_snd.comp (continuous_fst.comp continuous_fst)
  have hshearProd : MeasurePreserving
      (fun p : B × ℝ => (p.1, c p.1 - p.2))
      ((volume : Measure B).prod (volume : Measure ℝ))
      ((volume : Measure B).prod (volume : Measure ℝ)) := by
    have h := MeasurePreserving.skew_product
      (μa := (volume : Measure B)) (μb := (volume : Measure B))
      (μc := (volume : Measure ℝ)) (μd := (volume : Measure ℝ))
      (g := fun b t => c b - t)
      (MeasurePreserving.id (volume : Measure B))
      ((hc.comp continuous_fst).sub continuous_snd).measurable
      (ae_of_all _ fun b => by
        have hneg : MeasurePreserving (fun t : ℝ => -t) volume volume :=
          Measure.measurePreserving_neg (volume : Measure ℝ)
        have hadd : MeasurePreserving (fun t : ℝ => c b + t) volume volume :=
          measurePreserving_add_left (volume : Measure ℝ) (c b)
        have hreflect : MeasurePreserving (fun t : ℝ => c b - t) volume volume := by
          convert hadd.comp hneg using 1
          funext t
          simp only [Function.comp_apply]
          ring
        exact hreflect.map_eq)
    simpa only [id_eq] using h
  have hshear : MeasurePreserving
      (fun p : B × ℝ => (p.1, c p.1 - p.2))
      (volume : Measure (B × ℝ)) (volume : Measure (B × ℝ)) := by
    simpa only [Measure.volume_eq_prod] using hshearProd
  have htotal := (aux_measurePreserving_singlyCancellativeA2GroupedLastCoordinateMap k d).comp
    ((aux_measurePreserving_singlyCancellativeA2GroupedReorder k d).comp hshear)
  convert htotal using 1
  funext p
  rcases p with ⟨⟨⟨a0, a1⟩, x⟩, t⟩
  rcases a0 with ⟨y0, r0⟩
  rcases a1 with ⟨y1, r1⟩
  rfl

/--
The two final-coordinate insertions as a measurable equivalence.  It is used
to form the invertible grouped A² coordinate change below.
-/
noncomputable def aux_singlyCancellativeA2GroupedLastCoordinateEquiv (k d : ℕ) :
    (((RealVector k × ℝ) × (RealVector k × ℝ)) × ℝ) × RealVector (d + 1) ≃ᵐ
      aux_singlyCancellativeA2Target k d := by
  let e := (aux_lastCoordinateSplit k).toHomeomorph.toMeasurableEquiv
  exact MeasurableEquiv.prodCongr
    (MeasurableEquiv.prodCongr
      (MeasurableEquiv.prodCongr e.symm e.symm) (MeasurableEquiv.refl ℝ))
    (MeasurableEquiv.refl (RealVector (d + 1)))

/--
The full measurable equivalence for the grouped A² coordinate change.  It is
used immediately by `aux_singlyCancellativeA2_integral_cornerProduct`.
-/
noncomputable def aux_singlyCancellativeA2CoordinatesGroupedEquiv (k d : ℕ) :
    aux_singlyCancellativeA2GroupedSource k d ≃ᵐ aux_singlyCancellativeA2Target k d :=
  (aux_singlyCancellativeA2GroupedScalarShearEquiv k d).trans
    ((aux_singlyCancellativeA2GroupedReorder k d).trans
      (aux_singlyCancellativeA2GroupedLastCoordinateEquiv k d))

/-- The measurable-equivalence coercion is the literal grouped A² map. -/
theorem aux_singlyCancellativeA2CoordinatesGroupedEquiv_coe (k d : ℕ) :
    (aux_singlyCancellativeA2CoordinatesGroupedEquiv k d :
      aux_singlyCancellativeA2GroupedSource k d → aux_singlyCancellativeA2Target k d) =
      aux_singlyCancellativeA2CoordinatesGrouped k d := by
  funext p
  rcases p with ⟨⟨⟨a0, a1⟩, x⟩, t⟩
  rcases a0 with ⟨y0, r0⟩
  rcases a1 with ⟨y1, r1⟩
  rfl

/--
Haar preservation of the full grouped A² coordinate equivalence.  It is the
change-of-variables input for
`aux_singlyCancellativeA2_integral_cornerProduct`.
-/
theorem aux_measurePreserving_singlyCancellativeA2CoordinatesGroupedEquiv (k d : ℕ) :
    MeasurePreserving (aux_singlyCancellativeA2CoordinatesGroupedEquiv k d) volume volume := by
  rw [aux_singlyCancellativeA2CoordinatesGroupedEquiv_coe]
  exact aux_measurePreserving_singlyCancellativeA2CoordinatesGrouped k d

/--
The level-`k+1` corner product in the raw normalized A² coordinates.  It is
the target product in `aux_singlyCancellativeA2_integral_cornerProduct`.
-/
noncomputable def aux_singlyCancellativeA2TargetCornerProduct (k d : ℕ)
    (F : Fin (k + 1 + d) → RealVector (k + 1 + d) → ℝ)
    (z : aux_singlyCancellativeA2Target k d) : ℝ :=
  ∏ h : Fin (k + 1) → Fin 2, ∏ i : Fin (d + 1),
    F (prismIndex (show 1 ≤ k + 1 by omega) (by omega) (Fin.cast (by omega) i))
      (prismPoint (n := k + 1 + d) (k := k + 1) (by omega) (by omega)
        z.1.1 (aux_newPrismFiber k d z.2) h (Fin.cast (by omega) i))

/--
The two level-`k` corner products in the raw normalized A² coordinates.  It
is the source product in `aux_singlyCancellativeA2_integral_cornerProduct`.
-/
noncomputable def aux_singlyCancellativeA2SourceCornerProduct (k d : ℕ) (hk : 1 ≤ k)
    (F : Fin (k + 1 + d) → RealVector (k + 1 + d) → ℝ)
    (p : aux_singlyCancellativeA2GroupedSource k d) : ℝ :=
  (∏ h : Fin k → Fin 2, ∏ i : Fin (d + 1),
    F (prismIndex hk (by omega) (Fin.cast (by omega) i.succ))
      (prismPoint (n := k + 1 + d) (k := k) hk (by omega) (p.1.1.1.1, p.1.1.2.1)
        (Fin.cons p.1.1.1.2 (aux_oldPrismTail k d p.1.2)) h
        (Fin.cast (by omega) i.succ))) *
  (∏ h : Fin k → Fin 2, ∏ i : Fin (d + 1),
    F (prismIndex hk (by omega) (Fin.cast (by omega) i.succ))
      (prismPoint (n := k + 1 + d) (k := k) hk (by omega) (p.1.1.1.1, p.1.1.2.1)
        (Fin.cons p.1.1.2.2 (aux_oldPrismTail k d p.1.2)) h
        (Fin.cast (by omega) i.succ)))

/--
The grouped A² coordinate map takes the lifted corner product to the product
of the two level-`k` corner factors.  This is the pointwise form of the A²
identification in `singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_singlyCancellativeA2CoordinatesGrouped_cornerProduct (k d : ℕ) (hk : 1 ≤ k)
    (F : Fin (k + 1 + d) → RealVector (k + 1 + d) → ℝ)
    (p : aux_singlyCancellativeA2GroupedSource k d) :
    aux_singlyCancellativeA2TargetCornerProduct k d F
      (aux_singlyCancellativeA2CoordinatesGrouped k d p) =
      aux_singlyCancellativeA2SourceCornerProduct k d hk F p := by
  rcases p with ⟨⟨⟨a0, a1⟩, x⟩, t⟩
  rcases a0 with ⟨y0, r0⟩
  rcases a1 with ⟨y1, r1⟩
  simpa [aux_singlyCancellativeA2TargetCornerProduct,
    aux_singlyCancellativeA2SourceCornerProduct,
    aux_singlyCancellativeA2CoordinatesGrouped] using
    aux_singlyCancellative_a2CornerProduct k d hk F (y0, y1) r0 r1 x

/--
The raw normalized A² integral equality.  The measure-preserving coordinate
map and the corner-product factorization transport any remaining target
factor unchanged; this is used immediately in
`singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_singlyCancellativeA2_integral_cornerProduct (k d : ℕ) (hk : 1 ≤ k)
    (F : Fin (k + 1 + d) → RealVector (k + 1 + d) → ℝ)
    (G : aux_singlyCancellativeA2Target k d → ℝ) :
    (∫ p : aux_singlyCancellativeA2GroupedSource k d,
      G (aux_singlyCancellativeA2CoordinatesGrouped k d p) *
        aux_singlyCancellativeA2SourceCornerProduct k d hk F p) =
      ∫ z : aux_singlyCancellativeA2Target k d,
        G z * aux_singlyCancellativeA2TargetCornerProduct k d F z := by
  let H : aux_singlyCancellativeA2Target k d → ℝ := fun z =>
    G z * aux_singlyCancellativeA2TargetCornerProduct k d F z
  calc
    (∫ p : aux_singlyCancellativeA2GroupedSource k d,
        G (aux_singlyCancellativeA2CoordinatesGrouped k d p) *
          aux_singlyCancellativeA2SourceCornerProduct k d hk F p) =
        ∫ p : aux_singlyCancellativeA2GroupedSource k d,
          H (aux_singlyCancellativeA2CoordinatesGrouped k d p) := by
            apply integral_congr_ae
            filter_upwards [] with p
            dsimp [H]
            rw [← aux_singlyCancellativeA2CoordinatesGrouped_cornerProduct k d hk F p]
    _ = ∫ z : aux_singlyCancellativeA2Target k d,
        G z * aux_singlyCancellativeA2TargetCornerProduct k d F z := by
      have hcomp :
          (∫ p : aux_singlyCancellativeA2GroupedSource k d,
            H (aux_singlyCancellativeA2CoordinatesGroupedEquiv k d p)) =
            ∫ z : aux_singlyCancellativeA2Target k d, H z := by
        exact
          (aux_measurePreserving_singlyCancellativeA2CoordinatesGroupedEquiv k d).integral_comp' H
      rw [aux_singlyCancellativeA2CoordinatesGroupedEquiv_coe] at hcomp
      simpa [H] using hcomp

/--
Auxiliary coordinate-sum normalization for the grouped A² change of variables
in Proposition `\ref{single cancellative Cauchy-Schwarz}`.  It is used by
`aux_singlyCancellativeA2_kernelFactor_comp_coordinates` in the proof of
`singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_coordinateSum_lastCases (k : ℕ) (r : ℝ) (y : RealVector k) :
    coordinateSum (Fin.lastCases r (fun i => y i)) = coordinateSum y + r := by
  unfold coordinateSum
  rw [Fin.sum_univ_castSucc]
  simp

/--
The unintegrated lifted-kernel factor in the target coordinates for Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  It is used by
`aux_singlyCancellativeA2_raw_coordinate_identity` in the proof of
`singlyCancellativeCauchySchwarz_bound`.
-/
def aux_singlyCancellativeA2TargetKernelFactor (k d : ℕ) (rho : KKernel k)
    (phi : ℝ → ℝ) (z : aux_singlyCancellativeA2Target k d) : ℝ :=
  |rho (fun i => (z.1.1.2 - z.1.1.1) i.castSucc,
    coordinateSum z.1.1.1 + coordinateSum z.2 - z.1.2)| *
      phi ((z.1.1.2 - z.1.1.1) (Fin.last k) + z.1.2) * phi z.1.2

/--
The literal two-fibre kernel factor in the grouped source coordinates for
Proposition `\ref{single cancellative Cauchy-Schwarz}`.  It is used by
`aux_singlyCancellativeA2_raw_coordinate_identity` in the proof of
`singlyCancellativeCauchySchwarz_bound`.
-/
def aux_singlyCancellativeA2SourceKernelFactor (k d : ℕ) (rho : KKernel k)
    (phi : ℝ → ℝ) (p : aux_singlyCancellativeA2GroupedSource k d) : ℝ :=
  |rho (p.1.1.2.1 - p.1.1.1.1,
    coordinateSum p.1.1.1.1 + p.2 + coordinateSum p.1.2)| *
      phi (p.1.1.1.2 - p.2) * phi (p.1.1.2.2 - p.2)

/--
Auxiliary pointwise identification of the source and target kernel factors in
Proposition `\ref{single cancellative Cauchy-Schwarz}`.  It is used by
`aux_singlyCancellativeA2_raw_coordinate_identity` in the proof of
`singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_singlyCancellativeA2_kernelFactor_comp_coordinates (k d : ℕ)
    (rho : KKernel k) (phi : ℝ → ℝ)
    (p : aux_singlyCancellativeA2GroupedSource k d) :
    aux_singlyCancellativeA2TargetKernelFactor k d rho phi
      (aux_singlyCancellativeA2CoordinatesGrouped k d p) =
        aux_singlyCancellativeA2SourceKernelFactor k d rho phi p := by
  rcases p with ⟨⟨⟨a0, a1⟩, x⟩, t⟩
  rcases a0 with ⟨y0, r0⟩
  rcases a1 with ⟨y1, r1⟩
  simp only [aux_singlyCancellativeA2TargetKernelFactor,
    aux_singlyCancellativeA2SourceKernelFactor,
    aux_singlyCancellativeA2CoordinatesGrouped_apply]
  rw [aux_coordinateSum_lastCases]
  let Y0 : RealVector (k + 1) :=
    Fin.lastCases (n := k) (motive := fun _ => ℝ) r0 (fun l => y0 l)
  let Y1 : RealVector (k + 1) :=
    Fin.lastCases (n := k) (motive := fun _ => ℝ) r1 (fun l => y1 l)
  have hvec :
      (fun i : Fin k => ((Y1 - Y0) i.castSucc)) =
        y1 - y0 := by
    funext i
    simp [Y0, Y1]
  have hscalar : coordinateSum y0 + r0 + coordinateSum x - (r0 - t) =
      coordinateSum y0 + t + coordinateSum x := by ring
  have hlast :
      (Y1 - Y0) (Fin.last k) + (r0 - t) = r1 - t := by simp [Y0, Y1]
  change
    |rho (fun i => (Y1 - Y0) i.castSucc,
        coordinateSum y0 + r0 + coordinateSum x - (r0 - t))| *
      phi ((Y1 - Y0) (Fin.last k) + (r0 - t)) * phi (r0 - t) = _
  rw [hvec, hscalar, hlast]
  ring

/--
Auxiliary raw A² coordinate identity in Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  It transports the two-fibre
source integrand to the unintegrated lifted prism integrand, and is used in
the proof of `singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_singlyCancellativeA2_raw_coordinate_identity (k d : ℕ) (hk : 1 ≤ k)
    (rho : KKernel k) (phi : ℝ → ℝ)
    (F : Fin (k + 1 + d) → RealVector (k + 1 + d) → ℝ) :
    (∫ p : aux_singlyCancellativeA2GroupedSource k d,
      aux_singlyCancellativeA2SourceKernelFactor k d rho phi p *
        aux_singlyCancellativeA2SourceCornerProduct k d hk F p) =
      ∫ z : aux_singlyCancellativeA2Target k d,
        aux_singlyCancellativeA2TargetKernelFactor k d rho phi z *
          aux_singlyCancellativeA2TargetCornerProduct k d F z := by
  calc
    (∫ p : aux_singlyCancellativeA2GroupedSource k d,
        aux_singlyCancellativeA2SourceKernelFactor k d rho phi p *
          aux_singlyCancellativeA2SourceCornerProduct k d hk F p) =
        ∫ p : aux_singlyCancellativeA2GroupedSource k d,
          aux_singlyCancellativeA2TargetKernelFactor k d rho phi
            (aux_singlyCancellativeA2CoordinatesGrouped k d p) *
            aux_singlyCancellativeA2SourceCornerProduct k d hk F p := by
          apply integral_congr_ae
          filter_upwards [] with p
          rw [aux_singlyCancellativeA2_kernelFactor_comp_coordinates]
    _ = ∫ z : aux_singlyCancellativeA2Target k d,
          aux_singlyCancellativeA2TargetKernelFactor k d rho phi z *
            aux_singlyCancellativeA2TargetCornerProduct k d F z :=
      aux_singlyCancellativeA2_integral_cornerProduct k d hk F
        (aux_singlyCancellativeA2TargetKernelFactor k d rho phi)

/--
Auxiliary finite-index normalization for Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  It is used by
`aux_singlyCancellativeA2_sourceCorner_eq_AProduct` in the proof of
`aux_memLp_singlyCancellativeCSRawA_of_integrable_source`.
-/
private theorem aux_singlyCancellativeAProduct_normalize (k d : ℕ) (hk : 1 ≤ k)
    (F : Fin (k + 1 + d) → SchwartzMap (RealVector (k + 1 + d)) ℝ)
    (y : RealVector k × RealVector k) (r : ℝ) (x : RealVector (d + 1)) :
    aux_singlyCancellativeAProduct (k + 1 + d) k hk (by omega) F y r
      (aux_oldPrismTail k d x) =
      ∏ h : Fin k → Fin 2, ∏ i : Fin (d + 1),
        F (prismIndex hk (by omega) (Fin.cast (by omega) i.succ))
          (prismPoint (n := k + 1 + d) (k := k) hk (by omega) y
            (Fin.cons r (aux_oldPrismTail k d x)) h
            (Fin.cast (by omega) i.succ)) := by
  unfold aux_singlyCancellativeAProduct
  apply Finset.prod_congr rfl
  intro h _
  let e : Fin (d + 1) ≃ Fin (k + 1 + d - k) := finCongr (by omega)
  let g : Fin (k + 1 + d - k) → ℝ := fun i =>
    F (prismIndex hk (by omega) i.succ)
      (prismPoint (n := k + 1 + d) (k := k) hk (by omega) y
        (Fin.cons r (aux_oldPrismTail k d x)) h i.succ)
  rw [← e.prod_comp g]
  apply Finset.prod_congr rfl
  intro i _
  dsimp [g, e]
  have hsucc :
      (Fin.cast (by omega : d + 1 = k + 1 + d - k) i).succ =
        Fin.cast (by omega : d + 1 + 1 = k + 1 + d - k + 1) i.succ := by
    symm
    exact aux_finCast_succ (by omega) i
  simp [finCongr]

/--
Auxiliary identification of the two source corner products in Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  It is used by
`aux_singlyCancellativeA2_sourceIntegrand_eq_weightedAProduct` in the proof
of `aux_memLp_singlyCancellativeCSRawA_of_integrable_source`.
-/
private theorem aux_singlyCancellativeA2_sourceCorner_eq_AProduct (k d : ℕ) (hk : 1 ≤ k)
    (F : Fin (k + 1 + d) → SchwartzMap (RealVector (k + 1 + d)) ℝ)
    (p : aux_singlyCancellativeA2GroupedSource k d) :
    aux_singlyCancellativeA2SourceCornerProduct k d hk (fun i x => F i x) p =
      aux_singlyCancellativeAProduct (k + 1 + d) k hk (by omega) F
        (p.1.1.1.1, p.1.1.2.1) p.1.1.1.2 (aux_oldPrismTail k d p.1.2) *
      aux_singlyCancellativeAProduct (k + 1 + d) k hk (by omega) F
        (p.1.1.1.1, p.1.1.2.1) p.1.1.2.2 (aux_oldPrismTail k d p.1.2) := by
  rcases p with ⟨⟨⟨a0, a1⟩, x⟩, t⟩
  rcases a0 with ⟨y0, r0⟩
  rcases a1 with ⟨y1, r1⟩
  unfold aux_singlyCancellativeA2SourceCornerProduct
  rw [← aux_singlyCancellativeAProduct_normalize k d hk F (y0, y1) r0 x,
    ← aux_singlyCancellativeAProduct_normalize k d hk F (y0, y1) r1 x]

/--
Auxiliary Fubini-to-`L²` principle for the A-side of Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  It is used by
`aux_memLp_singlyCancellativeCSRawA_of_integrable_source`.
-/
private theorem aux_memLp_two_of_integrable_product_square
    {P : Type*} [MeasurableSpace P] (μ : Measure P)
    (a : P → ℝ → ℝ)
    (ha : AEStronglyMeasurable (fun p => ∫ r : ℝ, a p r) μ)
    (hH : Integrable (fun q : P × (ℝ × ℝ) =>
      a q.1 q.2.1 * a q.1 q.2.2) (μ.prod volume)) :
    MemLp (fun p => ∫ r : ℝ, a p r) 2 μ := by
  rw [memLp_two_iff_integrable_sq ha]
  have hI := hH.integral_prod_left
  refine hI.congr ?_
  filter_upwards [] with p
  change (∫ q : ℝ × ℝ, a p q.1 * a p q.2) = (∫ r : ℝ, a p r) ^ 2
  rw [show (∫ q : ℝ × ℝ, a p q.1 * a p q.2) =
    (∫ r : ℝ, a p r) * ∫ r : ℝ, a p r by
      simpa only [Measure.volume_eq_prod] using integral_prod_mul (a p) (a p)]
  ring

/--
Auxiliary continuity of a parameterized prism point.  It is used by
`aux_measurable_singlyCancellativeAProductFiber` for the A-side of
`singlyCancellativeCauchySchwarz_bound`.
-/
private theorem aux_continuous_prismPoint_parameterized (n k : ℕ)
    (hk : 1 ≤ k) (hkn : k ≤ n) (h : Fin k → Fin 2)
    (i : Fin (n - k + 1)) :
    Continuous (fun p : (RealVector k × RealVector k) × RealVector (n - k + 1) =>
      prismPoint hk hkn p.1 p.2 h i) := by
  apply continuous_pi
  intro a
  by_cases ha : a.1 < k
  · by_cases hh : h ⟨a.1, ha⟩ = 0
    · simp only [prismPoint, concatVector, ha, ↓reduceDIte, cubeCorner, hh,
        Fin.isValue, ↓reduceIte]
      exact (continuous_apply (⟨a.1, ha⟩ : Fin k)).comp
        (continuous_fst.comp continuous_fst)
    · simp only [prismPoint, concatVector, ha, ↓reduceDIte, cubeCorner,
        Fin.isValue, hh, ↓reduceIte]
      exact (continuous_apply (⟨a.1, ha⟩ : Fin k)).comp
        (continuous_snd.comp continuous_fst)
  · simp only [prismPoint, concatVector, ha, ↓reduceDIte, eraseVector]
    exact (continuous_apply (i.succAbove ⟨a.1 - k, by omega⟩)).comp continuous_snd

/--
Auxiliary measurability of the nonzero prism-coordinate product in Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  It is used by
`aux_measurable_singlyCancellativeWeightedAIntegrand`.
-/
private theorem aux_measurable_singlyCancellativeAProductFiber (n k : ℕ)
    (hk : 1 ≤ k) (hkn : k ≤ n)
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    Measurable (fun q : aux_singlyCancellativeCSPairingSpace n k × ℝ =>
      aux_singlyCancellativeAProduct n k hk hkn F q.1.1 q.2 q.1.2.2) := by
  unfold aux_singlyCancellativeAProduct
  apply Finset.measurable_fun_prod Finset.univ
  intro h _
  apply Finset.measurable_fun_prod Finset.univ
  intro i _
  have hfiber : Continuous (fun q : aux_singlyCancellativeCSPairingSpace n k × ℝ =>
      (Fin.cons q.2 q.1.2.2 : RealVector (n - k + 1))) := by
    apply continuous_pi
    intro a
    refine Fin.cases ?_ (fun b => ?_) a
    · simpa using (continuous_snd : Continuous (fun q :
        aux_singlyCancellativeCSPairingSpace n k × ℝ => q.2))
    · exact (continuous_apply b).comp
        (continuous_snd.comp (continuous_snd.comp continuous_fst))
  have hargs : Continuous (fun q : aux_singlyCancellativeCSPairingSpace n k × ℝ =>
      (q.1.1, (Fin.cons q.2 q.1.2.2 : RealVector (n - k + 1)))) :=
    (continuous_fst.comp continuous_fst).prodMk hfiber
  exact (F (prismIndex hk hkn i.succ)).continuous.measurable.comp
    ((aux_continuous_prismPoint_parameterized n k hk hkn h i.succ).comp hargs).measurable

/--
The weighted raw A-fibre integrand for Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  It is used by
`aux_memLp_singlyCancellativeCSRawA_of_integrable_source`.
-/
private noncomputable def aux_singlyCancellativeWeightedAIntegrand (n k : ℕ)
    (hk : 1 ≤ k) (hkn : k ≤ n) (rho : KKernel k) (phi : ℝ → ℝ)
    (F : Fin n → SchwartzMap (RealVector n) ℝ)
    (q : aux_singlyCancellativeCSPairingSpace n k × ℝ) : ℝ :=
  Real.sqrt |aux_singlyCancellativeCSRawR n k rho q.1| *
    (phi (q.2 - q.1.2.1) *
      aux_singlyCancellativeAProduct n k hk hkn F q.1.1 q.2 q.1.2.2)

/--
Auxiliary measurability of the weighted A-fibre integrand in Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  It is used by
`aux_memLp_singlyCancellativeCSRawA_of_integrable_source`.
-/
private theorem aux_measurable_singlyCancellativeWeightedAIntegrand (n k : ℕ)
    (hk : 1 ≤ k) (hkn : k ≤ n) (rho : KKernel k) (hrho : MemW0 rho)
    (phi : ℝ → ℝ) (hphi : MemW0 phi)
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    Measurable (aux_singlyCancellativeWeightedAIntegrand n k hk hkn rho phi F) := by
  unfold aux_singlyCancellativeWeightedAIntegrand aux_singlyCancellativeCSRawR
  apply Measurable.mul
  · have hArg : Measurable (fun q : aux_singlyCancellativeCSPairingSpace n k × ℝ =>
        (q.1.1.2 - q.1.1.1,
          coordinateSum q.1.1.1 + q.1.2.1 + coordinateSum q.1.2.2)) := by
      exact (((continuous_snd.comp (continuous_fst.comp continuous_fst)).sub
        (continuous_fst.comp (continuous_fst.comp continuous_fst))).prodMk
        ((((aux_continuous_coordinateSum k).comp
          (continuous_fst.comp (continuous_fst.comp continuous_fst))).add
          (continuous_fst.comp (continuous_snd.comp continuous_fst))).add
          ((aux_continuous_coordinateSum (n - k)).comp
            (continuous_snd.comp (continuous_snd.comp continuous_fst))))).measurable
    exact (hrho.aux_continuous.measurable.comp hArg).abs.sqrt
  · exact
      (hphi.aux_continuous.measurable.comp
        (continuous_snd.sub
          (continuous_fst.comp (continuous_snd.comp continuous_fst))).measurable).mul
        (aux_measurable_singlyCancellativeAProductFiber n k hk hkn F)

/--
Auxiliary measurable equivalence identifying the normalized old prism tail in
Proposition `\ref{single cancellative Cauchy-Schwarz}`.  It is used by
`aux_singlyCancellativeA2SourceSquareReorder`.
-/
private noncomputable def aux_oldPrismTailEquiv (k d : ℕ) :
    RealVector (d + 1) ≃ᵐ RealVector (k + 1 + d - k) :=
  MeasurableEquiv.piCongrLeft (fun _ : Fin (k + 1 + d - k) => ℝ)
    (finCongr (by omega))

/--
Auxiliary literal formula for `aux_oldPrismTailEquiv`, used by
`aux_singlyCancellativeA2SourceSquareReorder` in the proof of
`aux_memLp_singlyCancellativeCSRawA_of_integrable_source`.
-/
private theorem aux_oldPrismTailEquiv_apply (k d : ℕ) (x : RealVector (d + 1)) :
    aux_oldPrismTailEquiv k d x = aux_oldPrismTail k d x := by
  funext i
  let e : Fin (d + 1) ≃ Fin (k + 1 + d - k) := finCongr (by omega)
  change MeasurableEquiv.piCongrLeft (fun _ : Fin (k + 1 + d - k) => ℝ) e x i = _
  rw [← e.apply_symm_apply i]
  rw [MeasurableEquiv.piCongrLeft_apply_apply]
  unfold aux_oldPrismTail
  congr 1

/--
Auxiliary Haar preservation of `aux_oldPrismTailEquiv`, used by
`aux_measurePreserving_singlyCancellativeA2SourceSquareReorder`.
-/
private theorem aux_measurePreserving_oldPrismTailEquiv (k d : ℕ) :
    MeasurePreserving (aux_oldPrismTailEquiv k d) volume volume := by
  exact volume_measurePreserving_piCongrLeft (fun _ : Fin (k + 1 + d - k) => ℝ)
    (finCongr (by omega))

/--
Auxiliary product transport for the coordinate permutation in Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  It is used only by
`aux_measurePreserving_singlyCancellativeA2SourceSquareReorder`.
-/
private theorem aux_measurePreserving_prodCongr
    {A B C D : Type*} [MeasureSpace A] [MeasureSpace B]
    [MeasureSpace C] [MeasureSpace D]
    [SFinite (volume : Measure A)] [SFinite (volume : Measure B)]
    [SFinite (volume : Measure C)] [SFinite (volume : Measure D)]
    (e₁ : A ≃ᵐ B) (e₂ : C ≃ᵐ D)
    (h₁ : MeasurePreserving e₁ volume volume)
    (h₂ : MeasurePreserving e₂ volume volume) :
    MeasurePreserving (MeasurableEquiv.prodCongr e₁ e₂) volume volume := by
  change MeasurePreserving (Prod.map e₁ e₂) volume volume
  simpa only [Measure.volume_eq_prod] using h₁.prod h₂

/--
Auxiliary four-block coordinate transpose used only in
`aux_singlyCancellativeA2SourceSquareReorder` for Proposition
`\ref{single cancellative Cauchy-Schwarz}`.
-/
private noncomputable def aux_fourBlockTranspose
    (A B C D : Type*) [MeasurableSpace A] [MeasurableSpace B]
    [MeasurableSpace C] [MeasurableSpace D] :
    (A × B) × (C × D) ≃ᵐ (A × C) × (B × D) :=
  MeasurableEquiv.prodAssoc.trans
    ((MeasurableEquiv.prodCongr (MeasurableEquiv.refl A)
      MeasurableEquiv.prodAssoc.symm).trans
    ((MeasurableEquiv.prodCongr (MeasurableEquiv.refl A)
      (MeasurableEquiv.prodCongr MeasurableEquiv.prodComm (MeasurableEquiv.refl D))).trans
    (MeasurableEquiv.prodAssoc.symm.trans
    ((MeasurableEquiv.prodCongr MeasurableEquiv.prodAssoc.symm
      (MeasurableEquiv.refl D)).trans MeasurableEquiv.prodAssoc))))

/--
Auxiliary Haar preservation of the four-block transpose used only by
`aux_measurePreserving_singlyCancellativeA2SourceSquareReorder`.
-/
private theorem aux_measurePreserving_fourBlockTranspose
    (A B C D : Type*) [MeasureSpace A] [MeasureSpace B]
    [MeasureSpace C] [MeasureSpace D]
    [SFinite (volume : Measure A)] [SFinite (volume : Measure B)]
    [SFinite (volume : Measure C)] [SFinite (volume : Measure D)] :
    MeasurePreserving (aux_fourBlockTranspose A B C D) volume volume := by
  have h1 : MeasurePreserving (MeasurableEquiv.prodAssoc :
      (A × B) × (C × D) ≃ᵐ A × (B × (C × D))) volume volume :=
    volume_preserving_prodAssoc
  have h2 : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl A)
        (MeasurableEquiv.prodAssoc.symm : B × (C × D) ≃ᵐ (B × C) × D))
      volume volume :=
    aux_measurePreserving_prodCongr _ _ (MeasurePreserving.id volume)
      volume_preserving_prodAssoc.symm
  have h3 : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl A)
        (MeasurableEquiv.prodCongr (MeasurableEquiv.prodComm : B × C ≃ᵐ C × B)
          (MeasurableEquiv.refl D))) volume volume := by
    apply aux_measurePreserving_prodCongr
    · exact MeasurePreserving.id volume
    · apply aux_measurePreserving_prodCongr
      · exact aux_volume_preserving_prod_swap (volume : Measure B) (volume : Measure C)
      · exact MeasurePreserving.id volume
  have h4 : MeasurePreserving (MeasurableEquiv.prodAssoc.symm :
      A × ((C × B) × D) ≃ᵐ (A × (C × B)) × D) volume volume :=
    volume_preserving_prodAssoc.symm
  have h5 : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.prodAssoc.symm :
        A × (C × B) ≃ᵐ (A × C) × B) (MeasurableEquiv.refl D)) volume volume :=
    aux_measurePreserving_prodCongr _ _ volume_preserving_prodAssoc.symm
      (MeasurePreserving.id volume)
  have h6 : MeasurePreserving (MeasurableEquiv.prodAssoc :
      ((A × C) × B) × D ≃ᵐ (A × C) × (B × D)) volume volume :=
    volume_preserving_prodAssoc
  change MeasurePreserving
    (MeasurableEquiv.prodAssoc ∘
      ((MeasurableEquiv.prodCongr MeasurableEquiv.prodAssoc.symm
        (MeasurableEquiv.refl D)) ∘
      (MeasurableEquiv.prodAssoc.symm ∘
      ((MeasurableEquiv.prodCongr (MeasurableEquiv.refl A)
        (MeasurableEquiv.prodCongr MeasurableEquiv.prodComm (MeasurableEquiv.refl D))) ∘
      ((MeasurableEquiv.prodCongr (MeasurableEquiv.refl A)
        MeasurableEquiv.prodAssoc.symm) ∘ MeasurableEquiv.prodAssoc))))) volume volume
  exact h6.comp (h5.comp (h4.comp (h3.comp (h2.comp h1))))

/--
Auxiliary block reordering used only by
`aux_singlyCancellativeA2SourceSquareReorder` for the A-side of Proposition
`\ref{single cancellative Cauchy-Schwarz}`.
-/
private noncomputable def aux_outerSquareReorder
    (Y R X T : Type*) [MeasurableSpace Y] [MeasurableSpace R]
    [MeasurableSpace X] [MeasurableSpace T] :
    ((Y × R) × X) × T ≃ᵐ (Y × (T × X)) × R :=
  MeasurableEquiv.prodAssoc.trans
    (MeasurableEquiv.prodAssoc.trans
    ((MeasurableEquiv.prodCongr (MeasurableEquiv.refl Y)
      MeasurableEquiv.prodComm).trans
    ((MeasurableEquiv.prodCongr (MeasurableEquiv.refl Y)
      (MeasurableEquiv.prodCongr MeasurableEquiv.prodComm (MeasurableEquiv.refl R))).trans
    MeasurableEquiv.prodAssoc.symm)))

/--
Auxiliary Haar preservation of `aux_outerSquareReorder`, used only by
`aux_measurePreserving_singlyCancellativeA2SourceSquareReorder`.
-/
private theorem aux_measurePreserving_outerSquareReorder
    (Y R X T : Type*) [MeasureSpace Y] [MeasureSpace R]
    [MeasureSpace X] [MeasureSpace T]
    [SFinite (volume : Measure Y)] [SFinite (volume : Measure R)]
    [SFinite (volume : Measure X)] [SFinite (volume : Measure T)] :
    MeasurePreserving (aux_outerSquareReorder Y R X T) volume volume := by
  have h1 : MeasurePreserving (MeasurableEquiv.prodAssoc :
      ((Y × R) × X) × T ≃ᵐ (Y × R) × (X × T)) volume volume :=
    volume_preserving_prodAssoc
  have h2 : MeasurePreserving (MeasurableEquiv.prodAssoc :
      (Y × R) × (X × T) ≃ᵐ Y × (R × (X × T))) volume volume :=
    volume_preserving_prodAssoc
  have h3 : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl Y)
        (MeasurableEquiv.prodComm : R × (X × T) ≃ᵐ (X × T) × R))
      volume volume := by
    apply aux_measurePreserving_prodCongr
    · exact MeasurePreserving.id volume
    · exact aux_volume_preserving_prod_swap (volume : Measure R)
        (volume : Measure (X × T))
  have h4 : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl Y)
        (MeasurableEquiv.prodCongr (MeasurableEquiv.prodComm : X × T ≃ᵐ T × X)
          (MeasurableEquiv.refl R))) volume volume := by
    apply aux_measurePreserving_prodCongr
    · exact MeasurePreserving.id volume
    · apply aux_measurePreserving_prodCongr
      · exact aux_volume_preserving_prod_swap (volume : Measure X) (volume : Measure T)
      · exact MeasurePreserving.id volume
  have h5 : MeasurePreserving (MeasurableEquiv.prodAssoc.symm :
      Y × ((T × X) × R) ≃ᵐ (Y × (T × X)) × R) volume volume :=
    volume_preserving_prodAssoc.symm
  convert h5.comp (h4.comp (h3.comp (h2.comp h1))) using 1
  funext p
  rfl

/--
The six-block Fubini rearrangement used only in the A-side `L²` argument of
Proposition `\ref{single cancellative Cauchy-Schwarz}`.  It is used by
`aux_memLp_singlyCancellativeCSRawA_of_integrable_source`.
-/
private noncomputable def aux_singlyCancellativeA2SourceSquareReorder (k d : ℕ) :
    aux_singlyCancellativeA2GroupedSource k d ≃ᵐ
      aux_singlyCancellativeCSPairingSpace (k + 1 + d) k × (ℝ × ℝ) :=
  let Y := RealVector k
  let X' := RealVector (k + 1 + d - k)
  let A := (Y × ℝ) × (Y × ℝ)
  (MeasurableEquiv.prodCongr
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl A) (aux_oldPrismTailEquiv k d))
    (MeasurableEquiv.refl ℝ)).trans
  ((MeasurableEquiv.prodCongr
    (MeasurableEquiv.prodCongr (aux_fourBlockTranspose Y ℝ Y ℝ)
      (MeasurableEquiv.refl X')) (MeasurableEquiv.refl ℝ)).trans
    (aux_outerSquareReorder (Y × Y) (ℝ × ℝ) X' ℝ))

/--
Auxiliary literal formula for the six-block A-side rearrangement, used by
`aux_singlyCancellativeA2_sourceIntegrand_eq_weightedAProduct`.
-/
private theorem aux_singlyCancellativeA2SourceSquareReorder_apply (k d : ℕ)
    (y0 y1 : RealVector k) (r0 r1 t : ℝ) (x : RealVector (d + 1)) :
    aux_singlyCancellativeA2SourceSquareReorder k d ((((y0, r0), (y1, r1)), x), t) =
      (((y0, y1), (t, aux_oldPrismTail k d x)), (r0, r1)) := by
  change (((y0, y1), (t, aux_oldPrismTailEquiv k d x)), (r0, r1)) = _
  rw [aux_oldPrismTailEquiv_apply]

/--
Auxiliary Haar preservation of the six-block A-side rearrangement, used by
`aux_memLp_singlyCancellativeCSRawA_of_integrable_source`.
-/
private theorem aux_measurePreserving_singlyCancellativeA2SourceSquareReorder (k d : ℕ) :
    MeasurePreserving (aux_singlyCancellativeA2SourceSquareReorder k d) volume volume := by
  let Y := RealVector k
  let X' := RealVector (k + 1 + d - k)
  let A := (Y × ℝ) × (Y × ℝ)
  have h0 : MeasurePreserving
      (MeasurableEquiv.prodCongr
        (MeasurableEquiv.prodCongr (MeasurableEquiv.refl A) (aux_oldPrismTailEquiv k d))
        (MeasurableEquiv.refl ℝ)) volume volume := by
    apply aux_measurePreserving_prodCongr
    · apply aux_measurePreserving_prodCongr
      · exact MeasurePreserving.id volume
      · exact aux_measurePreserving_oldPrismTailEquiv k d
    · exact MeasurePreserving.id volume
  have h1 : MeasurePreserving
      (MeasurableEquiv.prodCongr
        (MeasurableEquiv.prodCongr (aux_fourBlockTranspose Y ℝ Y ℝ)
          (MeasurableEquiv.refl X')) (MeasurableEquiv.refl ℝ)) volume volume := by
    apply aux_measurePreserving_prodCongr
    · apply aux_measurePreserving_prodCongr
      · exact aux_measurePreserving_fourBlockTranspose Y ℝ Y ℝ
      · exact MeasurePreserving.id volume
    · exact MeasurePreserving.id volume
  have h2 : MeasurePreserving
      (aux_outerSquareReorder (Y × Y) (ℝ × ℝ) X' ℝ) volume volume :=
    aux_measurePreserving_outerSquareReorder (Y × Y) (ℝ × ℝ) X' ℝ
  convert h2.comp (h1.comp h0) using 1
  funext p
  rfl

/--
Auxiliary coordinate-sum transport along the old prism-tail equivalence.  It
is used by `aux_singlyCancellativeA2_sourceIntegrand_eq_weightedAProduct`.
-/
private theorem aux_coordinateSum_oldPrismTail (k d : ℕ) (x : RealVector (d + 1)) :
    coordinateSum (aux_oldPrismTail k d x) = coordinateSum x := by
  unfold coordinateSum aux_oldPrismTail
  let e : Fin (d + 1) ≃ Fin (k + 1 + d - k) := finCongr (by omega)
  have hcast : (fun i : Fin (k + 1 + d - k) =>
      x (Fin.cast (by omega) i)) = fun i => x (e.symm i) := by
    funext i
    congr 1
  rw [hcast]
  exact e.symm.sum_comp x

/--
Auxiliary pointwise source-square identification in Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  It is used by
`aux_memLp_singlyCancellativeCSRawA_of_integrable_source`.
-/
private theorem aux_singlyCancellativeA2_sourceIntegrand_eq_weightedAProduct (k d : ℕ)
    (hk : 1 ≤ k) (rho : KKernel k) (phi : ℝ → ℝ)
    (F : Fin (k + 1 + d) → SchwartzMap (RealVector (k + 1 + d)) ℝ)
    (s : aux_singlyCancellativeA2GroupedSource k d) :
    aux_singlyCancellativeA2SourceKernelFactor k d rho phi s *
      aux_singlyCancellativeA2SourceCornerProduct k d hk (fun i x => F i x) s =
      aux_singlyCancellativeWeightedAIntegrand (k + 1 + d) k hk (by omega) rho phi F
        ((aux_singlyCancellativeA2SourceSquareReorder k d s).1,
          (aux_singlyCancellativeA2SourceSquareReorder k d s).2.1) *
      aux_singlyCancellativeWeightedAIntegrand (k + 1 + d) k hk (by omega) rho phi F
        ((aux_singlyCancellativeA2SourceSquareReorder k d s).1,
          (aux_singlyCancellativeA2SourceSquareReorder k d s).2.2) := by
  rcases s with ⟨⟨⟨a0, a1⟩, x⟩, t⟩
  rcases a0 with ⟨y0, r0⟩
  rcases a1 with ⟨y1, r1⟩
  rw [aux_singlyCancellativeA2SourceSquareReorder_apply,
    aux_singlyCancellativeA2_sourceCorner_eq_AProduct]
  change
    (|rho (y1 - y0, coordinateSum y0 + t + coordinateSum x)| *
      phi (r0 - t) * phi (r1 - t)) *
        (aux_singlyCancellativeAProduct (k + 1 + d) k hk (by omega) F
          (y0, y1) r0 (aux_oldPrismTail k d x) *
        aux_singlyCancellativeAProduct (k + 1 + d) k hk (by omega) F
          (y0, y1) r1 (aux_oldPrismTail k d x)) =
      (Real.sqrt |rho (y1 - y0,
          coordinateSum y0 + t + coordinateSum (aux_oldPrismTail k d x))| *
        (phi (r0 - t) *
          aux_singlyCancellativeAProduct (k + 1 + d) k hk (by omega) F
            (y0, y1) r0 (aux_oldPrismTail k d x))) *
      (Real.sqrt |rho (y1 - y0,
          coordinateSum y0 + t + coordinateSum (aux_oldPrismTail k d x))| *
        (phi (r1 - t) *
          aux_singlyCancellativeAProduct (k + 1 + d) k hk (by omega) F
            (y0, y1) r1 (aux_oldPrismTail k d x)))
  rw [aux_coordinateSum_oldPrismTail]
  nth_rw 1 [← Real.mul_self_sqrt (abs_nonneg (rho (y1 - y0,
    coordinateSum y0 + t + coordinateSum x)))]
  ring

/--
Auxiliary `L²` certificate for the A-factor in Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  Given the absolute-integrability
certificate for the grouped source square, it is used by
`aux_memLp_singlyCancellativeCSRawA` in the proof of
`singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_memLp_singlyCancellativeCSRawA_of_integrable_source
    (k d : ℕ) (hk : 1 ≤ k) (rho : KKernel k) (hrho : MemW0 rho)
    (phi : ℝ → ℝ) (hphi : MemW0 phi)
    (F : Fin (k + 1 + d) → SchwartzMap (RealVector (k + 1 + d)) ℝ)
    (hsource : Integrable (fun s : aux_singlyCancellativeA2GroupedSource k d =>
      aux_singlyCancellativeA2SourceKernelFactor k d rho phi s *
        aux_singlyCancellativeA2SourceCornerProduct k d hk (fun i x => F i x) s)) :
    MemLp (fun p : aux_singlyCancellativeCSPairingSpace (k + 1 + d) k =>
      Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + d) k rho p| *
        aux_singlyCancellativeCSRawA (k + 1 + d) k hk (by omega) phi F p) 2 volume := by
  let e := aux_singlyCancellativeA2SourceSquareReorder k d
  let g : aux_singlyCancellativeCSPairingSpace (k + 1 + d) k → ℝ → ℝ := fun p r =>
    aux_singlyCancellativeWeightedAIntegrand (k + 1 + d) k hk (by omega) rho phi F (p, r)
  let Hs : aux_singlyCancellativeA2GroupedSource k d → ℝ := fun s =>
    aux_singlyCancellativeA2SourceKernelFactor k d rho phi s *
      aux_singlyCancellativeA2SourceCornerProduct k d hk (fun i x => F i x) s
  have hcomp : Integrable (Hs ∘ e.symm) := by
    have hinv := (aux_measurePreserving_singlyCancellativeA2SourceSquareReorder k d).symm e
    exact hinv.integrable_comp_of_integrable hsource
  have hH : Integrable (fun q :
      aux_singlyCancellativeCSPairingSpace (k + 1 + d) k × (ℝ × ℝ) =>
      g q.1 q.2.1 * g q.1 q.2.2) := by
    refine hcomp.congr ?_
    filter_upwards [] with q
    have hpoint := aux_singlyCancellativeA2_sourceIntegrand_eq_weightedAProduct
      k d hk rho phi F (e.symm q)
    change Hs (e.symm q) = _ at hpoint
    rw [e.apply_symm_apply q] at hpoint
    exact hpoint
  have hraw : AEStronglyMeasurable
      (aux_singlyCancellativeWeightedAIntegrand (k + 1 + d) k hk (by omega) rho phi F)
      (volume : Measure (aux_singlyCancellativeCSPairingSpace (k + 1 + d) k × ℝ)) :=
    (aux_measurable_singlyCancellativeWeightedAIntegrand (k + 1 + d) k hk (by omega)
      rho hrho phi hphi F).aestronglyMeasurable
  have hg : AEStronglyMeasurable (fun p :
      aux_singlyCancellativeCSPairingSpace (k + 1 + d) k => ∫ r : ℝ, g p r) volume := by
    simpa only [g, Measure.volume_eq_prod] using hraw.integral_prod_right'
  have hmem := aux_memLp_two_of_integrable_product_square volume g hg hH
  convert hmem using 1
  funext p
  unfold g aux_singlyCancellativeWeightedAIntegrand aux_singlyCancellativeCSRawA
  change Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + d) k rho p| *
      (∫ r : ℝ, phi (r - p.2.1) *
        aux_singlyCancellativeAProduct (k + 1 + d) k hk (by omega) F p.1 r p.2.2) =
      ∫ r : ℝ, Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + d) k rho p| *
        (phi (r - p.2.1) *
          aux_singlyCancellativeAProduct (k + 1 + d) k hk (by omega) F p.1 r p.2.2)
  exact (integral_const_mul _ _).symm

/-- Auxiliary definition for Proposition \ref{single cancellative Cauchy-Schwarz}; see
`singlyCancellativeCauchySchwarz_bound`. -/
def singlyCancellativeLift (k J : ℕ) (rho : Fin J → KKernel k)
    (phi : Fin J → ℝ → ℝ) : KKernel (k + 1) :=
  fun u => ∑ j, ∫ q : ℝ,
    |rho j (fun i => u.1 i.castSucc, u.2 - q)| *
      phi j (u.1 (Fin.last k) + q) * phi j q

/--
The unintegrated summand of the lifted singly-cancellative kernel.  This is
the raw tensor/shear integrand used for the Fubini justification in the
single-cancellative Cauchy--Schwarz proof.
-/
def aux_singlyCancellativeLiftExpandedKernel (k : ℕ) (rho : KKernel k)
    (phi : ℝ → ℝ) : ((RealVector (k + 1) × ℝ) × ℝ) → ℝ := fun p =>
  |rho (fun i => p.1.1 i.castSucc, p.1.2 - p.2)| *
    phi (p.1.1 (Fin.last k) + p.2) * phi p.2

/--
The unintegrated lifted summand is in `W₀`.  This is needed immediately to
justify Fubini before identifying the squared Cauchy--Schwarz term with the
lifted prism form.
-/
theorem aux_memW0_singlyCancellativeLiftExpandedKernel (k : ℕ) (rho : KKernel k)
    (hrho : MemW0 rho) (phi : ℝ → ℝ) (hphi : MemW0 phi) :
    MemW0 (aux_singlyCancellativeLiftExpandedKernel k rho phi) := by
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k)) :=
    isAddHaarMeasure_volume_pi (Fin k)
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector (k + 1))) :=
    isAddHaarMeasure_volume_pi (Fin (k + 1))
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector (k + 1) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure (volume : Measure ((RealVector k × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure (((RealVector k × ℝ) × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure ((RealVector (k + 1) × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let R : ((RealVector k × ℝ) × ℝ) → ℝ := fun p =>
    |rho p.1| * phi p.2
  have hR : MemW0 R := by
    simpa [R] using (aux_memW0_abs hrho).aux_mul_prod hphi
  let G : (((RealVector k × ℝ) × ℝ) × ℝ) → ℝ := fun p =>
    R p.1 * phi p.2
  have hG : MemW0 G := by
    simpa [G] using hR.aux_mul_prod hphi
  let H : (((RealVector k × ℝ) × ℝ) × ℝ) → ℝ := fun p =>
    |rho p.1.1| * phi p.1.2 * phi p.2
  have hH : MemW0 H := by
    simpa [H, G, R, mul_assoc] using hG
  have hHs : MemW0 (H ∘ aux_singlyCancellativeLiftShear k) :=
    aux_memW0_comp_continuousLinearEquiv hH (aux_singlyCancellativeLiftShear k)
  have hEq : aux_singlyCancellativeLiftExpandedKernel k rho phi =
      H ∘ aux_singlyCancellativeLiftShear k := by
    funext p
    rcases p with ⟨u, q⟩
    simp [aux_singlyCancellativeLiftExpandedKernel, H,
      aux_singlyCancellativeLiftShear_apply]
  rw [hEq]
  exact hHs

/--
Absolute integrability of the raw lifted-kernel prism integrand.  This is the
Fubini certificate used immediately to identify the first squared
Cauchy--Schwarz term with the level-`k+1` prism form.
-/
theorem aux_integrable_singlyCancellativeLiftExpandedPrismIntegrand
    (n k : ℕ) (hk1 : 1 ≤ k + 1) (hkn1 : k + 1 ≤ n)
    (rho : KKernel k) (hrho : MemW0 rho) (phi : ℝ → ℝ) (hphi : MemW0 phi)
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    Integrable (fun p : ((RealVector (k + 1) × ℝ) × ℝ) × RealVector n =>
      aux_singlyCancellativeLiftExpandedKernel k rho phi p.1 *
        ∏ h : Fin (k + 1) → Fin 2, ∏ i : Fin (n - (k + 1) + 1),
          F (prismIndex hk1 hkn1 i)
            (aux_prismPullback n (k + 1) hkn1 h i p.1.1.1 p.1.1.2 p.2)) := by
  classical
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector (k + 1))) :=
    isAddHaarMeasure_volume_pi (Fin (k + 1))
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector (k + 1) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure ((RealVector (k + 1) × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let I := (Fin (k + 1) → Fin 2) × Fin (n - (k + 1) + 1)
  let a : I := (fun _ => 0, 0)
  let P : I → ((RealVector (k + 1) × ℝ) × ℝ) × RealVector n → ℝ := fun hi w =>
    F (prismIndex hk1 hkn1 hi.2)
      (aux_prismPullback n (k + 1) hkn1 hi.1 hi.2 w.1.1.1 w.1.1.2 w.2)
  let D : ((RealVector (k + 1) × ℝ) × ℝ) × RealVector n → ℝ := fun w =>
    aux_singlyCancellativeLiftExpandedKernel k rho phi w.1 * P a w
  let R : ((RealVector (k + 1) × ℝ) × ℝ) × RealVector n → ℝ := fun w =>
    ∏ hi ∈ (Finset.univ.erase a), P hi w
  let C : ℝ := ∏ hi ∈ (Finset.univ.erase a),
    SchwartzMap.seminorm ℝ 0 0 (F (prismIndex hk1 hkn1 hi.2))
  let H : ((RealVector (k + 1) × ℝ) × ℝ) × RealVector n → ℝ := fun w =>
    aux_singlyCancellativeLiftExpandedKernel k rho phi w.1 * ∏ hi : I, P hi w
  have hExpanded : MemW0 (aux_singlyCancellativeLiftExpandedKernel k rho phi) :=
    aux_memW0_singlyCancellativeLiftExpandedKernel k rho hrho phi hphi
  have hC : 0 ≤ C := by
    dsimp [C]
    positivity
  have hPmeas (hi : I) : Measurable (P hi) := by
    dsimp [P]
    have hparams : Measurable
        (fun w : ((RealVector (k + 1) × ℝ) × ℝ) × RealVector n => (w.1.1, w.2)) :=
      (measurable_fst.comp measurable_fst).prodMk measurable_snd
    exact (F (prismIndex hk1 hkn1 hi.2)).continuous.measurable.comp
      ((aux_measurable_prismPullback n (k + 1) hkn1 hi.1 hi.2).comp hparams)
  have hHmeas : Measurable H := by
    dsimp [H]
    apply (hExpanded.aux_continuous.measurable.comp measurable_fst).mul
    apply Finset.measurable_fun_prod Finset.univ
    intro hi _
    exact hPmeas hi
  have hRbound (w : ((RealVector (k + 1) × ℝ) × ℝ) × RealVector n) :
      ‖R w‖ ≤ C := by
    dsimp [R, C]
    calc
      ‖∏ hi ∈ Finset.univ.erase a, P hi w‖ ≤
          ∏ hi ∈ Finset.univ.erase a, ‖P hi w‖ :=
        Finset.norm_prod_le _ _
      _ ≤ ∏ hi ∈ Finset.univ.erase a,
          SchwartzMap.seminorm ℝ 0 0 (F (prismIndex hk1 hkn1 hi.2)) := by
          gcongr with hi hhi
          exact (F (prismIndex hk1 hkn1 hi.2)).norm_le_seminorm ℝ _
  have hfactor (w : ((RealVector (k + 1) × ℝ) × ℝ) × RealVector n) :
      H w = D w * R w := by
    dsimp [H, D, R]
    rw [← Finset.mul_prod_erase Finset.univ (fun hi => P hi w)
      (Finset.mem_univ a)]
    ring
  have hbound (w : ((RealVector (k + 1) × ℝ) × ℝ) × RealVector n) :
      ‖H w‖ ≤ C * ‖D w‖ := by
    rw [hfactor]
    calc
      ‖D w * R w‖ = ‖D w‖ * ‖R w‖ := norm_mul _ _
      _ ≤ ‖D w‖ * C := mul_le_mul_of_nonneg_left (hRbound w) (norm_nonneg _)
      _ = C * ‖D w‖ := mul_comm _ _
  have hExpandedInt : Integrable (aux_singlyCancellativeLiftExpandedKernel k rho phi) :=
    aux_memW0_integrable_of_addHaar hExpanded
  have hFint : Integrable (F (prismIndex hk1 hkn1 a.2) : RealVector n → ℝ) :=
    (F (prismIndex hk1 hkn1 a.2)).integrable
  have hTensorInt : Integrable (fun w : ((RealVector (k + 1) × ℝ) × ℝ) × RealVector n =>
      aux_singlyCancellativeLiftExpandedKernel k rho phi w.1 *
        F (prismIndex hk1 hkn1 a.2) w.2) := hExpandedInt.mul_prod hFint
  have hD : Integrable D := by
    have hmp := aux_measurePreserving_prismPullbackSkewScalar n (k + 1) hkn1 a.1 a.2
    have hcomp := hmp.integrable_comp_of_integrable hTensorInt
    simpa [D, P, Function.comp_def] using hcomp
  have hH : Integrable H := by
    have hDom : Integrable (fun w => C * ‖D w‖) := hD.norm.const_mul C
    exact hDom.mono' hHmeas.aestronglyMeasurable (ae_of_all _ hbound)
  convert hH using 1
  funext p
  dsimp [H, P]
  congr 1
  rw [← Fintype.prod_prod_type']

/--
Auxiliary `W₀` closure for one lifted singly-cancellative summand.  The proof
uses the preceding affine equivalence to reduce it to a fibre integral of the
tensor product `|\rho|\otimes\phi\otimes\phi`.
-/
theorem aux_memW0_singlyCancellativeLiftSummand (k : ℕ) (rho : KKernel k)
    (hrho : MemW0 rho) (phi : ℝ → ℝ) (hphi : MemW0 phi) :
    MemW0 (fun u : RealVector (k + 1) × ℝ => ∫ q : ℝ,
      |rho (fun i => u.1 i.castSucc, u.2 - q)| *
        phi (u.1 (Fin.last k) + q) * phi q) := by
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k)) :=
    isAddHaarMeasure_volume_pi (Fin k)
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector (k + 1))) :=
    isAddHaarMeasure_volume_pi (Fin (k + 1))
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure (volume : Measure ((RealVector k × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure (((RealVector k × ℝ) × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector (k + 1) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure ((RealVector (k + 1) × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let R : KKernel k := fun v => |rho v|
  have hR : MemW0 R := by
    simpa [R] using aux_memW0_abs hrho
  let G : ((RealVector k × ℝ) × ℝ) → ℝ := fun p => R p.1 * phi p.2
  have hG : MemW0 G := by
    simpa [G] using hR.aux_mul_prod hphi
  let H : (((RealVector k × ℝ) × ℝ) × ℝ) → ℝ := fun p => G p.1 * phi p.2
  have hH : MemW0 H := by
    simpa [H] using hG.aux_mul_prod hphi
  have hHs : MemW0 (H ∘ aux_singlyCancellativeLiftShear k) :=
    aux_memW0_comp_continuousLinearEquiv hH (aux_singlyCancellativeLiftShear k)
  have hI := aux_memW0_integral_slice_of_addHaar hHs
  simpa [H, G, R, Function.comp_def, aux_singlyCancellativeLiftShear_apply] using hI

/--
\begin{proposition}[singly cancellative Cauchy-Schwarz]\label{single cancellative Cauchy-Schwarz}
For $u\in \R^{k+2}$, define
\begin{equation}
    \tilde{K}(u):=\sum_{j\in[J)}\int_\R
    |\rho_j|(u_{[k)},u_{k+1}-q)\phi_j(u_k+q)\phi_j(q)\,dq .
\end{equation}
Then $\tilde{K}\in W_0(\R^{k+2})$.
\end{proposition}
-/
theorem singlyCancellativeLift_memW0 (n k J : ℕ) (_hJ : 1 ≤ J) (_hk : 1 ≤ k)
    (_hkn : k < n) (rho : Fin J → KKernel k) (phi : Fin J → ℝ → ℝ)
    (hrho : ∀ j, MemW0 (rho j)) (hphi : ∀ j, MemW0 (phi j)) :
    MemW0 (singlyCancellativeLift k J rho phi) := by
  unfold singlyCancellativeLift
  apply aux_memW0_finset_sum Finset.univ
  intro j _
  exact aux_memW0_singlyCancellativeLiftSummand k (rho j) (hrho j) (phi j) (hphi j)

/--
Auxiliary tail-coordinate equivalence used to identify the raw lifted prism
coordinates with the A² target coordinates in Proposition
\ref{single cancellative Cauchy-Schwarz}; it is used in the proof of
`singlyCancellativeCauchySchwarz_bound`.
-/
private noncomputable def aux_singlyCancellativeLiftA2_newPrismTailEquiv (k d : ℕ) :
    RealVector (d + 1) ≃ᵐ RealVector (k + 1 + d - (k + 1) + 1) := by
  let h : k + 1 + d - (k + 1) + 1 = d + 1 := by omega
  exact (MeasurableEquiv.piCongrLeft (fun _ : Fin (d + 1) => ℝ)
    (Fin.castOrderIso h).toEquiv).symm

/--
Auxiliary evaluation rule for the tail-coordinate equivalence used in
Proposition \ref{single cancellative Cauchy-Schwarz}, for the proof of
`singlyCancellativeCauchySchwarz_bound`.
-/
private theorem aux_singlyCancellativeLiftA2_newPrismTailEquiv_apply (k d : ℕ)
    (x : RealVector (d + 1)) :
    aux_singlyCancellativeLiftA2_newPrismTailEquiv k d x = aux_newPrismFiber k d x := by
  let h : k + 1 + d - (k + 1) + 1 = d + 1 := by omega
  let e : Fin (k + 1 + d - (k + 1) + 1) ≃ Fin (d + 1) :=
    (Fin.castOrderIso h).toEquiv
  let E := MeasurableEquiv.piCongrLeft (fun _ : Fin (d + 1) => ℝ) e
  change E.symm x = aux_newPrismFiber k d x
  funext a
  calc
    E.symm x a = E (E.symm x) (e a) :=
      (MeasurableEquiv.piCongrLeft_apply_apply
        (β := fun _ : Fin (d + 1) => ℝ) e (E.symm x) a).symm
    _ = x (e a) := congrFun (E.apply_symm_apply x) (e a)
    _ = x (Fin.cast h a) := by simp [e]

/--
Auxiliary Haar-measure preservation for the tail-coordinate equivalence in
Proposition \ref{single cancellative Cauchy-Schwarz}; this supports the
coordinate transport in `singlyCancellativeCauchySchwarz_bound`.
-/
private theorem aux_measurePreserving_singlyCancellativeLiftA2_newPrismTailEquiv
    (k d : ℕ) :
    MeasurePreserving (aux_singlyCancellativeLiftA2_newPrismTailEquiv k d) volume volume := by
  let h : k + 1 + d - (k + 1) + 1 = d + 1 := by omega
  exact (volume_measurePreserving_piCongrLeft (fun _ : Fin (d + 1) => ℝ)
    (Fin.castOrderIso h).toEquiv).symm _

/--
Auxiliary coordinate-sum normalization for the new prism tail in Proposition
\ref{single cancellative Cauchy-Schwarz}, used by
`singlyCancellativeCauchySchwarz_bound`.
-/
private theorem aux_singlyCancellativeLiftA2_coordinateSum_newPrismFiber (k d : ℕ)
    (x : RealVector (d + 1)) :
    coordinateSum (aux_newPrismFiber k d x) = coordinateSum x := by
  let h : k + 1 + d - (k + 1) + 1 = d + 1 := by omega
  let e : Fin (d + 1) ≃ Fin (k + 1 + d - (k + 1) + 1) :=
    (Fin.castOrderIso h.symm).toEquiv
  unfold coordinateSum
  calc
    (∑ a, aux_newPrismFiber k d x a) =
        ∑ i, aux_newPrismFiber k d x (e i) := (Equiv.sum_comp e _).symm
    _ = ∑ i, x i := by
      apply Finset.sum_congr rfl
      intro i _
      simp [e, aux_newPrismFiber]

/--
Auxiliary raw-to-target coordinate map for the lifted A² calculation in
Proposition \ref{single cancellative Cauchy-Schwarz}.  It is used only to
transport the lift expansion in `singlyCancellativeCauchySchwarz_bound`.
-/
private noncomputable def aux_singlyCancellativeLiftA2_rawToTarget (k d : ℕ) :
    (((RealVector (k + 1) × ℝ) × ℝ) × RealVector (k + 1 + d)) →
      aux_singlyCancellativeA2Target k d := fun p =>
  let c := aux_prismCoordinates (k + 1 + d) (k + 1) (by omega)
    (p.1.1.1, (p.1.1.2, p.2))
  ((c.1, p.1.2), (aux_singlyCancellativeLiftA2_newPrismTailEquiv k d).symm c.2)

/--
Auxiliary evaluation rule for the raw-to-target map in Proposition
\ref{single cancellative Cauchy-Schwarz}, used in the proof of
`singlyCancellativeCauchySchwarz_bound`.
-/
private theorem aux_singlyCancellativeLiftA2_rawToTarget_apply (k d : ℕ)
    (u : RealVector (k + 1)) (s q : ℝ) (z : RealVector (k + 1 + d)) :
    aux_singlyCancellativeLiftA2_rawToTarget k d (((u, s), q), z) =
      let c := aux_prismCoordinates (k + 1 + d) (k + 1) (by omega) (u, (s, z))
      ((c.1, q), (aux_singlyCancellativeLiftA2_newPrismTailEquiv k d).symm c.2) := by
  rfl

/--
Auxiliary coordinate-sum rule for the inverse tail equivalence in Proposition
\ref{single cancellative Cauchy-Schwarz}, used in
`singlyCancellativeCauchySchwarz_bound`.
-/
private theorem aux_singlyCancellativeLiftA2_coordinateSum_newPrismTailEquiv_symm
    (k d : ℕ) (x : RealVector (k + 1 + d - (k + 1) + 1)) :
    coordinateSum ((aux_singlyCancellativeLiftA2_newPrismTailEquiv k d).symm x) =
      coordinateSum x := by
  rw [← aux_singlyCancellativeLiftA2_coordinateSum_newPrismFiber k d
    ((aux_singlyCancellativeLiftA2_newPrismTailEquiv k d).symm x)]
  rw [← aux_singlyCancellativeLiftA2_newPrismTailEquiv_apply]
  congr 1

/--
Auxiliary Haar-measure-preserving raw-to-target coordinate change for the
lifted A² calculation in Proposition \ref{single cancellative Cauchy-Schwarz}.
It is used by `singlyCancellativeCauchySchwarz_bound`.
-/
private theorem aux_measurePreserving_singlyCancellativeLiftA2_rawToTarget (k d : ℕ) :
    MeasurePreserving (aux_singlyCancellativeLiftA2_rawToTarget k d) volume volume := by
  let N := k + 1 + d
  let U := RealVector (k + 1)
  let Y := U × U
  let T := RealVector (N - (k + 1) + 1)
  let e1 : ((U × ℝ) × ℝ) × RealVector N → (U × (ℝ × RealVector N)) × ℝ :=
    (aux_fourBlockReorder (k + 1) N).symm
  let e2 := Prod.map (aux_prismCoordinates N (k + 1) (by omega)) (id : ℝ → ℝ)
  let e3 : (Y × T) × ℝ → Y × (ℝ × T) :=
    (aux_singlyCancellativeB2Reorder (k + 1) (N - (k + 1) + 1)).symm
  let e4 : Y × (ℝ × T) → (Y × ℝ) × T := MeasurableEquiv.prodAssoc.symm
  let e5 : (Y × ℝ) × T → (Y × ℝ) × RealVector (d + 1) :=
    Prod.map (id : Y × ℝ → Y × ℝ)
      (aux_singlyCancellativeLiftA2_newPrismTailEquiv k d).symm
  have h1 : MeasurePreserving e1 volume volume :=
    (aux_measurePreserving_fourBlockReorder (k + 1) N).symm _
  have h2 : MeasurePreserving e2 volume volume := by
    dsimp [e2]
    simpa only [Measure.volume_eq_prod, id_eq] using
      (aux_measurePreserving_prismCoordinates N (k + 1) (by omega)).prod
        (MeasurePreserving.id (volume : Measure ℝ))
  have h3 : MeasurePreserving e3 volume volume :=
    (aux_measurePreserving_singlyCancellativeB2Reorder (k + 1)
      (N - (k + 1) + 1)).symm _
  have h4 : MeasurePreserving e4 volume volume :=
    (volume_preserving_prodAssoc
      (α₁ := Y) (β₁ := ℝ) (γ₁ := T)).symm
  have h5 : MeasurePreserving e5 volume volume := by
    dsimp [e5]
    simpa only [Measure.volume_eq_prod, id_eq] using
      (MeasurePreserving.id (volume : Measure (Y × ℝ))).prod
        ((aux_measurePreserving_singlyCancellativeLiftA2_newPrismTailEquiv k d).symm _)
  change MeasurePreserving (e5 ∘ e4 ∘ e3 ∘ e2 ∘ e1) volume volume
  exact h5.comp (h4.comp (h3.comp (h2.comp h1)))

/--
Auxiliary pointwise identification of the raw lifted integrand with the A²
target integrand in Proposition \ref{single cancellative Cauchy-Schwarz}.
It is used to transport the lifted prism form in
`singlyCancellativeCauchySchwarz_bound`.
-/
private theorem aux_singlyCancellativeLiftA2TargetIntegrand_comp_rawToTarget
    (k d : ℕ) (rho : KKernel k) (phi : ℝ → ℝ)
    (F : Fin (k + 1 + d) → RealVector (k + 1 + d) → ℝ) :
    (fun z : aux_singlyCancellativeA2Target k d =>
      aux_singlyCancellativeA2TargetKernelFactor k d rho phi z *
        aux_singlyCancellativeA2TargetCornerProduct k d F z) ∘
        aux_singlyCancellativeLiftA2_rawToTarget k d =
      fun p : ((RealVector (k + 1) × ℝ) × ℝ) × RealVector (k + 1 + d) =>
        aux_singlyCancellativeLiftExpandedKernel k rho phi p.1 *
          ∏ h : Fin (k + 1) → Fin 2,
            ∏ i : Fin (k + 1 + d - (k + 1) + 1),
              F (prismIndex (show 1 ≤ k + 1 by omega) (by omega) i)
                (aux_prismPullback (k + 1 + d) (k + 1) (by omega)
                  h i p.1.1.1 p.1.1.2 p.2) := by
  funext p
  rcases p with ⟨⟨⟨u, s⟩, q⟩, z⟩
  change (aux_singlyCancellativeA2TargetKernelFactor k d rho phi
      (aux_singlyCancellativeLiftA2_rawToTarget k d (((u, s), q), z)) *
        aux_singlyCancellativeA2TargetCornerProduct k d F
          (aux_singlyCancellativeLiftA2_rawToTarget k d (((u, s), q), z))) = _
  rw [aux_singlyCancellativeLiftA2_rawToTarget_apply]
  let c := aux_prismCoordinates (k + 1 + d) (k + 1) (by omega) (u, (s, z))
  let x := (aux_singlyCancellativeLiftA2_newPrismTailEquiv k d).symm c.2
  have htail : aux_newPrismFiber k d x = c.2 := by
    rw [← aux_singlyCancellativeLiftA2_newPrismTailEquiv_apply]
    exact (aux_singlyCancellativeLiftA2_newPrismTailEquiv k d).apply_symm_apply c.2
  have hsum : coordinateSum x = coordinateSum c.2 :=
    aux_singlyCancellativeLiftA2_coordinateSum_newPrismTailEquiv_symm k d c.2
  have hkernel :
      (c.1.2 - c.1.1, coordinateSum c.1.1 + coordinateSum c.2) = (u, s) := by
    exact aux_prismCoordinates_kernelArguments (k + 1 + d) (k + 1) (by omega) u s z
  have hproduct :
      aux_singlyCancellativeA2TargetCornerProduct k d F ((c.1, q), x) =
        ∏ h : Fin (k + 1) → Fin 2,
          ∏ i : Fin (k + 1 + d - (k + 1) + 1),
            F (prismIndex (show 1 ≤ k + 1 by omega) (by omega) i)
              (aux_prismPullback (k + 1 + d) (k + 1) (by omega)
                h i u s z) := by
    unfold aux_singlyCancellativeA2TargetCornerProduct
    rw [htail]
    apply Finset.prod_congr rfl
    intro h _
    let e : Fin (d + 1) ≃ Fin (k + 1 + d - (k + 1) + 1) :=
      (Fin.castOrderIso (by omega)).toEquiv
    let g : Fin (k + 1 + d - (k + 1) + 1) → ℝ := fun i =>
      F (prismIndex (show 1 ≤ k + 1 by omega) (by omega) i)
        (aux_prismPullback (k + 1 + d) (k + 1) (by omega) h i u s z)
    rw [← e.prod_comp g]
    apply Finset.prod_congr rfl
    intro i _
    dsimp [e, g]
    exact congrArg (F _)
      (aux_prismPoint_eq_prismPullbackCoordinates (k + 1 + d) (k + 1)
        (by omega) (by omega) u s z h (Fin.cast (by omega) i))
  change aux_singlyCancellativeLiftExpandedKernel k rho phi
      ((c.1.2 - c.1.1, coordinateSum c.1.1 + coordinateSum x), q) *
        aux_singlyCancellativeA2TargetCornerProduct k d F ((c.1, q), x) = _
  rw [hsum, hkernel, hproduct]

/--
The A² target integrand is integrable.  This auxiliary fact supplies the
Fubini and measure-transport justification needed for Proposition
\ref{single cancellative Cauchy-Schwarz}, specifically for
`singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_integrable_singlyCancellativeLiftA2TargetIntegrand
    (k d : ℕ) (rho : KKernel k) (hrho : MemW0 rho)
    (phi : ℝ → ℝ) (hphi : MemW0 phi)
    (F : Fin (k + 1 + d) → SchwartzMap (RealVector (k + 1 + d)) ℝ) :
    Integrable (fun z : aux_singlyCancellativeA2Target k d =>
      aux_singlyCancellativeA2TargetKernelFactor k d rho phi z *
        aux_singlyCancellativeA2TargetCornerProduct k d (fun i x => F i x) z) := by
  let G : aux_singlyCancellativeA2Target k d → ℝ := fun z =>
    aux_singlyCancellativeA2TargetKernelFactor k d rho phi z *
      aux_singlyCancellativeA2TargetCornerProduct k d (fun i x => F i x) z
  let htail : d + 1 = k + 1 + d - (k + 1) + 1 := by omega
  have hpointCont (h : Fin (k + 1) → Fin 2) (i : Fin (d + 1)) : Continuous
      (fun z : aux_singlyCancellativeA2Target k d =>
        prismPoint (n := k + 1 + d) (k := k + 1) (by omega) (by omega)
          z.1.1 (aux_newPrismFiber k d z.2) h (Fin.cast htail i)) := by
    apply continuous_pi
    intro a
    unfold prismPoint concatVector
    split_ifs with ha
    · unfold cubeCorner
      split_ifs <;> fun_prop
    · unfold eraseVector aux_newPrismFiber
      fun_prop
  have hprodCont : Continuous
      (aux_singlyCancellativeA2TargetCornerProduct k d (fun i x => F i x)) := by
    unfold aux_singlyCancellativeA2TargetCornerProduct
    apply continuous_finsetProd Finset.univ
    intro h _
    apply continuous_finsetProd Finset.univ
    intro i _
    exact (F (prismIndex (show 1 ≤ k + 1 by omega) (by omega)
      (Fin.cast htail i))).continuous.comp (hpointCont h i)
  have hargCont : Continuous
      (fun z : aux_singlyCancellativeA2Target k d =>
        ((z.1.1.2 - z.1.1.1,
          coordinateSum z.1.1.1 + coordinateSum z.2), z.1.2)) := by
    have hu : Continuous (fun z : aux_singlyCancellativeA2Target k d =>
        z.1.1.2 - z.1.1.1) :=
      (continuous_snd.comp (continuous_fst.comp continuous_fst)).sub
        (continuous_fst.comp (continuous_fst.comp continuous_fst))
    have hs : Continuous (fun z : aux_singlyCancellativeA2Target k d =>
        coordinateSum z.1.1.1 + coordinateSum z.2) :=
      ((aux_continuous_coordinateSum (k + 1)).comp
        (continuous_fst.comp (continuous_fst.comp continuous_fst))).add
        ((aux_continuous_coordinateSum (d + 1)).comp continuous_snd)
    exact (hu.prodMk hs).prodMk (continuous_snd.comp continuous_fst)
  have hGmeas : Measurable G := by
    have hExpanded := aux_memW0_singlyCancellativeLiftExpandedKernel k rho hrho phi hphi
    dsimp [G, aux_singlyCancellativeA2TargetKernelFactor]
    exact ((hExpanded.aux_continuous.comp hargCont).mul hprodCont).measurable
  have hRaw := aux_integrable_singlyCancellativeLiftExpandedPrismIntegrand
    (k + 1 + d) k (by omega) (by omega) rho hrho phi hphi F
  have hcomp : Integrable (G ∘ aux_singlyCancellativeLiftA2_rawToTarget k d) := by
    rw [aux_singlyCancellativeLiftA2TargetIntegrand_comp_rawToTarget]
    exact hRaw
  exact ((aux_measurePreserving_singlyCancellativeLiftA2_rawToTarget k d).integrable_comp
    hGmeas.aestronglyMeasurable).mp hcomp

/--
Auxiliary expansion of the lifted prism form into the A² target coordinates.
It is the lifted-form comparison required by Proposition
\ref{single cancellative Cauchy-Schwarz} in the proof of
`singlyCancellativeCauchySchwarz_bound`.
-/
theorem aux_singlyCancellativeLift_prismForm_expand_A2Target
    (k d J : ℕ) (hJ : 1 ≤ J) (hk : 1 ≤ k)
    (rho : Fin J → KKernel k) (phi : Fin J → ℝ → ℝ)
    (hrho : ∀ j, MemW0 (rho j)) (hphi : ∀ j, MemW0 (phi j))
    (F : Fin (k + 1 + d) → SchwartzMap (RealVector (k + 1 + d)) ℝ) :
    prismBrascampLiebForm (k + 1 + d) (k + 1) (by omega) (by omega)
      (singlyCancellativeLift k J rho phi) (fun i x => F i x) =
      ∑ j : Fin J, ∫ z : aux_singlyCancellativeA2Target k d,
        aux_singlyCancellativeA2TargetKernelFactor k d (rho j) (phi j) z *
          aux_singlyCancellativeA2TargetCornerProduct k d (fun i x => F i x) z := by
  let N := k + 1 + d
  let U := RealVector (k + 1)
  let H : Fin J → (((U × ℝ) × ℝ) × RealVector N) → ℝ := fun j p =>
    aux_singlyCancellativeLiftExpandedKernel k (rho j) (phi j) p.1 *
      ∏ h : Fin (k + 1) → Fin 2,
        ∏ i : Fin (N - (k + 1) + 1),
          F (prismIndex (show 1 ≤ k + 1 by omega) (by omega) i)
            (aux_prismPullback N (k + 1) (by omega)
              h i p.1.1.1 p.1.1.2 p.2)
  have hH (j : Fin J) : Integrable (H j) := by
    dsimp [H, N, U]
    exact aux_integrable_singlyCancellativeLiftExpandedPrismIntegrand
      (k + 1 + d) k (by omega) (by omega) (rho j) (hrho j) (phi j) (hphi j) F
  let E := aux_fourBlockReorder (k + 1) N
  have hE : MeasurePreserving E volume volume :=
    aux_measurePreserving_fourBlockReorder (k + 1) N
  have hHE (j : Fin J) : Integrable (H j ∘ E) :=
    hE.integrable_comp_of_integrable (hH j)
  let Q : Fin J → U × (ℝ × RealVector N) → ℝ := fun j w =>
    ∫ q : ℝ, H j (E (w, q))
  have hQ (j : Fin J) : Integrable (Q j) := by
    dsimp [Q]
    exact (hHE j).integral_prod_left
  have hQapply (j : Fin J) (u : U) (w : ℝ × RealVector N) :
      Q j (u, w) =
        (∫ q : ℝ, aux_singlyCancellativeLiftExpandedKernel k (rho j) (phi j)
          ((u, w.1), q)) *
          (∏ h : Fin (k + 1) → Fin 2,
            ∏ i : Fin (N - (k + 1) + 1),
              F (prismIndex (show 1 ≤ k + 1 by omega) (by omega) i)
                (aux_prismPullback N (k + 1) (by omega) h i u w.1 w.2)) := by
    rcases w with ⟨s, z⟩
    change (∫ q : ℝ, H j (E ((u, (s, z)), q))) = _
    change (∫ q : ℝ, H j (((u, s), q), z)) = _
    dsimp [H]
    exact integral_mul_const _ _
  have hQsum : Integrable (fun w : U × (ℝ × RealVector N) => ∑ j, Q j w) :=
    integrable_finsetSum Finset.univ (fun j _ => hQ j)
  have hLift : MemW0 (singlyCancellativeLift k J rho phi) :=
    singlyCancellativeLift_memW0 N k J hJ hk (by omega) rho phi hrho hphi
  calc
    prismBrascampLiebForm N (k + 1) (by omega) (by omega)
        (singlyCancellativeLift k J rho phi) (fun i x => F i x) =
        ∫ u : U, ∫ w : ℝ × RealVector N,
          singlyCancellativeLift k J rho phi (u, w.1) *
            ∏ h : Fin (k + 1) → Fin 2,
              ∏ i : Fin (N - (k + 1) + 1),
                F (prismIndex (show 1 ≤ k + 1 by omega) (by omega) i)
                  (aux_prismPullback N (k + 1) (by omega)
                    h i u w.1 w.2) := by
          exact aux_prismBrascampLiebForm_eq_global N (k + 1) (by omega) (by omega)
            (singlyCancellativeLift k J rho phi) hLift F
    _ = ∫ u : U, ∫ w : ℝ × RealVector N, ∑ j, Q j (u, w) := by
      apply integral_congr_ae
      filter_upwards [] with u
      apply integral_congr_ae
      filter_upwards [] with w
      rcases w with ⟨s, z⟩
      change (∑ j : Fin J, ∫ q : ℝ,
        aux_singlyCancellativeLiftExpandedKernel k (rho j) (phi j) ((u, s), q)) *
          (∏ h : Fin (k + 1) → Fin 2,
            ∏ i : Fin (N - (k + 1) + 1),
              F (prismIndex (show 1 ≤ k + 1 by omega) (by omega) i)
                (aux_prismPullback N (k + 1) (by omega) h i u s z)) =
          ∑ j, Q j (u, (s, z))
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro j _
      exact (hQapply j u (s, z)).symm
    _ = ∫ w : U × (ℝ × RealVector N), ∑ j, Q j w := by
      simpa only [Measure.volume_eq_prod] using (integral_prod _ hQsum).symm
    _ = ∑ j, ∫ w : U × (ℝ × RealVector N), Q j w := by
      exact integral_finsetSum Finset.univ (fun j _ => hQ j)
    _ = ∑ j, ∫ p : (U × (ℝ × RealVector N)) × ℝ, H j (E p) := by
      apply Finset.sum_congr rfl
      intro j _
      simpa [Q, Function.comp_def, Measure.volume_eq_prod] using
        (integral_prod (H j ∘ E) (hHE j)).symm
    _ = ∑ j, ∫ p : ((U × ℝ) × ℝ) × RealVector N, H j p := by
      apply Finset.sum_congr rfl
      intro j _
      exact hE.integral_comp' (H j)
    _ = ∑ j : Fin J, ∫ z : aux_singlyCancellativeA2Target k d,
        aux_singlyCancellativeA2TargetKernelFactor k d (rho j) (phi j) z *
          aux_singlyCancellativeA2TargetCornerProduct k d (fun i x => F i x) z := by
      apply Finset.sum_congr rfl
      intro j _
      let G : aux_singlyCancellativeA2Target k d → ℝ := fun z =>
        aux_singlyCancellativeA2TargetKernelFactor k d (rho j) (phi j) z *
          aux_singlyCancellativeA2TargetCornerProduct k d (fun i x => F i x) z
      have hG : Integrable G :=
        aux_integrable_singlyCancellativeLiftA2TargetIntegrand k d (rho j) (hrho j)
          (phi j) (hphi j) F
      let hmp := aux_measurePreserving_singlyCancellativeLiftA2_rawToTarget k d
      have hchange := MeasureTheory.integral_map hmp.measurable.aemeasurable
        (show AEStronglyMeasurable G
          (Measure.map (aux_singlyCancellativeLiftA2_rawToTarget k d) volume) by
          simpa [hmp.map_eq] using hG.aestronglyMeasurable)
      rw [hmp.map_eq] at hchange
      change (∫ p : ((U × ℝ) × ℝ) × RealVector N, H j p) = ∫ z, G z
      calc
        (∫ p : ((U × ℝ) × ℝ) × RealVector N, H j p) =
            ∫ p : ((U × ℝ) × ℝ) × RealVector N,
              G (aux_singlyCancellativeLiftA2_rawToTarget k d p) := by
          apply integral_congr_ae
          filter_upwards [] with p
          simpa [G, H, N, U] using
            (congrFun
              (aux_singlyCancellativeLiftA2TargetIntegrand_comp_rawToTarget
                k d (rho j) (phi j) (fun i x => F i x)) p).symm
        _ = ∫ z, G z := hchange.symm

/--
Auxiliary `L²` certificate for the A-factor in Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  It is used by
`singlyCancellativeCauchySchwarz_bound` after normalizing the ambient
dimension as `k + 1 + d`.
-/
theorem aux_memLp_singlyCancellativeCSRawA
    (k d : ℕ) (hk : 1 ≤ k) (rho : KKernel k) (hrho : MemW0 rho)
    (phi : ℝ → ℝ) (hphi : MemW0 phi)
    (F : Fin (k + 1 + d) → SchwartzMap (RealVector (k + 1 + d)) ℝ) :
    MemLp (fun p : aux_singlyCancellativeCSPairingSpace (k + 1 + d) k =>
      Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + d) k rho p| *
        aux_singlyCancellativeCSRawA (k + 1 + d) k hk (by omega) phi F p) 2 volume := by
  apply aux_memLp_singlyCancellativeCSRawA_of_integrable_source
    k d hk rho hrho phi hphi F
  have hcomp : Integrable
      ((fun z : aux_singlyCancellativeA2Target k d =>
        aux_singlyCancellativeA2TargetKernelFactor k d rho phi z *
          aux_singlyCancellativeA2TargetCornerProduct k d (fun i x => F i x) z) ∘
        aux_singlyCancellativeA2CoordinatesGroupedEquiv k d) :=
    (aux_measurePreserving_singlyCancellativeA2CoordinatesGroupedEquiv
      k d).integrable_comp_of_integrable
      (aux_integrable_singlyCancellativeLiftA2TargetIntegrand k d rho hrho phi hphi F)
  refine hcomp.congr ?_
  filter_upwards [] with s
  simp only [Function.comp_apply]
  rw [aux_singlyCancellativeA2CoordinatesGroupedEquiv_coe]
  rw [aux_singlyCancellativeA2_kernelFactor_comp_coordinates,
    aux_singlyCancellativeA2CoordinatesGrouped_cornerProduct]

/--
Auxiliary Fubini identity for the A² term in Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  It is used by
`singlyCancellativeCauchySchwarz_bound` to replace the weighted raw A-square
by the grouped source integral.
-/
theorem aux_singlyCancellativeA2_weightedSquare_eq_source
    (k d : ℕ) (hk : 1 ≤ k) (rho : KKernel k) (phi : ℝ → ℝ)
    (F : Fin (k + 1 + d) → SchwartzMap (RealVector (k + 1 + d)) ℝ)
    (hsource : Integrable (fun s : aux_singlyCancellativeA2GroupedSource k d =>
      aux_singlyCancellativeA2SourceKernelFactor k d rho phi s *
        aux_singlyCancellativeA2SourceCornerProduct k d hk (fun i x => F i x) s)) :
    (∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + d) k,
      |Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + d) k rho p| *
        aux_singlyCancellativeCSRawA (k + 1 + d) k hk (by omega) phi F p| ^ (2 : ℝ)) =
      ∫ s : aux_singlyCancellativeA2GroupedSource k d,
        aux_singlyCancellativeA2SourceKernelFactor k d rho phi s *
          aux_singlyCancellativeA2SourceCornerProduct k d hk (fun i x => F i x) s := by
  let e := aux_singlyCancellativeA2SourceSquareReorder k d
  let g : aux_singlyCancellativeCSPairingSpace (k + 1 + d) k → ℝ → ℝ := fun p r =>
    aux_singlyCancellativeWeightedAIntegrand (k + 1 + d) k hk (by omega) rho phi F (p, r)
  let Hs : aux_singlyCancellativeA2GroupedSource k d → ℝ := fun s =>
    aux_singlyCancellativeA2SourceKernelFactor k d rho phi s *
      aux_singlyCancellativeA2SourceCornerProduct k d hk (fun i x => F i x) s
  have hcomp : Integrable (Hs ∘ e.symm) := by
    have hinv := (aux_measurePreserving_singlyCancellativeA2SourceSquareReorder k d).symm e
    exact hinv.integrable_comp_of_integrable hsource
  have hH : Integrable (fun q :
      aux_singlyCancellativeCSPairingSpace (k + 1 + d) k × (ℝ × ℝ) =>
      g q.1 q.2.1 * g q.1 q.2.2) := by
    refine hcomp.congr ?_
    filter_upwards [] with q
    have hpoint := aux_singlyCancellativeA2_sourceIntegrand_eq_weightedAProduct
      k d hk rho phi F (e.symm q)
    change Hs (e.symm q) = _ at hpoint
    rw [e.apply_symm_apply q] at hpoint
    exact hpoint
  have hg (p : aux_singlyCancellativeCSPairingSpace (k + 1 + d) k) :
      (∫ r : ℝ, g p r) =
        Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + d) k rho p| *
          aux_singlyCancellativeCSRawA (k + 1 + d) k hk (by omega) phi F p := by
    unfold g aux_singlyCancellativeWeightedAIntegrand aux_singlyCancellativeCSRawA
    change (∫ r : ℝ,
      Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + d) k rho p| *
        (phi (r - p.2.1) *
          aux_singlyCancellativeAProduct (k + 1 + d) k hk (by omega) F p.1 r p.2.2)) =
      Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + d) k rho p| *
        (∫ r : ℝ, phi (r - p.2.1) *
          aux_singlyCancellativeAProduct (k + 1 + d) k hk (by omega) F p.1 r p.2.2)
    exact integral_const_mul _ _
  have hpoint (p : aux_singlyCancellativeCSPairingSpace (k + 1 + d) k) :
      |Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + d) k rho p| *
        aux_singlyCancellativeCSRawA (k + 1 + d) k hk (by omega) phi F p| ^ (2 : ℝ) =
        ∫ q : ℝ × ℝ, g p q.1 * g p q.2 := by
    calc
      |Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + d) k rho p| *
          aux_singlyCancellativeCSRawA (k + 1 + d) k hk (by omega) phi F p| ^ (2 : ℝ) =
          (Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + d) k rho p| *
            aux_singlyCancellativeCSRawA (k + 1 + d) k hk (by omega) phi F p) ^ 2 := by
            rw [Real.rpow_two, sq_abs]
      _ = (∫ r : ℝ, g p r) ^ 2 := by rw [hg p]
      _ = (∫ r : ℝ, g p r) * ∫ r : ℝ, g p r := by ring
      _ = ∫ q : ℝ × ℝ, g p q.1 * g p q.2 := by
        simpa only [Measure.volume_eq_prod] using (integral_prod_mul (g p) (g p)).symm
  have hsourceEq :
      (∫ s : aux_singlyCancellativeA2GroupedSource k d, Hs s) =
        ∫ q : aux_singlyCancellativeCSPairingSpace (k + 1 + d) k × (ℝ × ℝ),
          g q.1 q.2.1 * g q.1 q.2.2 := by
    calc
      (∫ s : aux_singlyCancellativeA2GroupedSource k d, Hs s) =
          ∫ s : aux_singlyCancellativeA2GroupedSource k d,
            g (e s).1 (e s).2.1 * g (e s).1 (e s).2.2 := by
              apply integral_congr_ae
              filter_upwards [] with s
              have hpoint := aux_singlyCancellativeA2_sourceIntegrand_eq_weightedAProduct
                k d hk rho phi F s
              change Hs s = _ at hpoint
              exact hpoint
      _ = ∫ q : aux_singlyCancellativeCSPairingSpace (k + 1 + d) k × (ℝ × ℝ),
          g q.1 q.2.1 * g q.1 q.2.2 := by
        simpa [e] using
          ((aux_measurePreserving_singlyCancellativeA2SourceSquareReorder k d).integral_comp'
            (fun q : aux_singlyCancellativeCSPairingSpace (k + 1 + d) k × (ℝ × ℝ) =>
              g q.1 q.2.1 * g q.1 q.2.2))
  calc
    (∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + d) k,
      |Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + d) k rho p| *
        aux_singlyCancellativeCSRawA (k + 1 + d) k hk (by omega) phi F p| ^ (2 : ℝ)) =
        ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + d) k,
          ∫ q : ℝ × ℝ, g p q.1 * g p q.2 := by
            apply integral_congr_ae
            filter_upwards [] with p
            exact hpoint p
    _ = ∫ q : aux_singlyCancellativeCSPairingSpace (k + 1 + d) k × (ℝ × ℝ),
        g q.1 q.2.1 * g q.1 q.2.2 := by
          simpa only [Measure.volume_eq_prod] using
            (integral_prod (fun q :
              aux_singlyCancellativeCSPairingSpace (k + 1 + d) k × (ℝ × ℝ) =>
              g q.1 q.2.1 * g q.1 q.2.2) hH).symm
    _ = ∫ s : aux_singlyCancellativeA2GroupedSource k d, Hs s := hsourceEq.symm
    _ = ∫ s : aux_singlyCancellativeA2GroupedSource k d,
        aux_singlyCancellativeA2SourceKernelFactor k d rho phi s *
          aux_singlyCancellativeA2SourceCornerProduct k d hk (fun i x => F i x) s := by rfl

/--
Auxiliary integrability of the grouped A² source integrand in Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  This transports the already
integrable target expression back through the Haar-preserving grouped
coordinate equivalence, so that the raw A-square Fubini identity applies.
-/
theorem aux_integrable_singlyCancellativeA2SourceIntegrand
    (k d : ℕ) (hk : 1 ≤ k) (rho : KKernel k) (hrho : MemW0 rho)
    (phi : ℝ → ℝ) (hphi : MemW0 phi)
    (F : Fin (k + 1 + d) → SchwartzMap (RealVector (k + 1 + d)) ℝ) :
    Integrable (fun s : aux_singlyCancellativeA2GroupedSource k d =>
      aux_singlyCancellativeA2SourceKernelFactor k d rho phi s *
        aux_singlyCancellativeA2SourceCornerProduct k d hk (fun i x => F i x) s) := by
  have hcomp : Integrable
      ((fun z : aux_singlyCancellativeA2Target k d =>
        aux_singlyCancellativeA2TargetKernelFactor k d rho phi z *
          aux_singlyCancellativeA2TargetCornerProduct k d (fun i x => F i x) z) ∘
        aux_singlyCancellativeA2CoordinatesGroupedEquiv k d) :=
    (aux_measurePreserving_singlyCancellativeA2CoordinatesGroupedEquiv
      k d).integrable_comp_of_integrable
      (aux_integrable_singlyCancellativeLiftA2TargetIntegrand k d rho hrho phi hphi F)
  refine hcomp.congr ?_
  filter_upwards [] with s
  simp only [Function.comp_apply]
  rw [aux_singlyCancellativeA2CoordinatesGroupedEquiv_coe]
  rw [aux_singlyCancellativeA2_kernelFactor_comp_coordinates,
    aux_singlyCancellativeA2CoordinatesGrouped_cornerProduct]

/--
Auxiliary A² identification in Proposition
`\ref{single cancellative Cauchy-Schwarz}`.  It identifies the sum of the
weighted raw A-squares from the finite Cauchy--Schwarz step with the lifted
prism Brascamp--Lieb form.
-/
theorem aux_singlyCancellativeA2_eq_liftPrism
    (k d J : ℕ) (hJ : 1 ≤ J) (hk : 1 ≤ k)
    (rho : Fin J → KKernel k) (phi : Fin J → ℝ → ℝ)
    (hrho : ∀ j, MemW0 (rho j)) (hphi : ∀ j, MemW0 (phi j))
    (F : Fin (k + 1 + d) → SchwartzMap (RealVector (k + 1 + d)) ℝ) :
    (∑ j : Fin J, ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + d) k,
      |Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + d) k (rho j) p| *
        aux_singlyCancellativeCSRawA (k + 1 + d) k hk (by omega) (phi j) F p| ^
          (2 : ℝ)) =
      prismBrascampLiebForm (k + 1 + d) (k + 1) (by omega) (by omega)
        (singlyCancellativeLift k J rho phi) (fun i x => F i x) := by
  calc
    (∑ j : Fin J, ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + d) k,
      |Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + d) k (rho j) p| *
        aux_singlyCancellativeCSRawA (k + 1 + d) k hk (by omega) (phi j) F p| ^
          (2 : ℝ)) =
        ∑ j : Fin J, ∫ s : aux_singlyCancellativeA2GroupedSource k d,
          aux_singlyCancellativeA2SourceKernelFactor k d (rho j) (phi j) s *
            aux_singlyCancellativeA2SourceCornerProduct k d hk (fun i x => F i x) s := by
          apply Finset.sum_congr rfl
          intro j _
          exact aux_singlyCancellativeA2_weightedSquare_eq_source k d hk
            (rho j) (phi j) F
            (aux_integrable_singlyCancellativeA2SourceIntegrand k d hk
              (rho j) (hrho j) (phi j) (hphi j) F)
    _ = ∑ j : Fin J, ∫ z : aux_singlyCancellativeA2Target k d,
          aux_singlyCancellativeA2TargetKernelFactor k d (rho j) (phi j) z *
            aux_singlyCancellativeA2TargetCornerProduct k d (fun i x => F i x) z := by
          apply Finset.sum_congr rfl
          intro j _
          exact aux_singlyCancellativeA2_raw_coordinate_identity k d hk
            (rho j) (phi j) (fun i x => F i x)
    _ = prismBrascampLiebForm (k + 1 + d) (k + 1) (by omega) (by omega)
          (singlyCancellativeLift k J rho phi) (fun i x => F i x) :=
      (aux_singlyCancellativeLift_prismForm_expand_A2Target k d J hJ hk
        rho phi hrho hphi F).symm

/--
For all $\F\in\mathfrak{F}$,
\begin{equation}
    |\Theta_k(K)(\F)|^2
    \le \Theta_{k+1}(\tilde{K})(\F)\sum_{j\in[J)}\|\rho_j\|_1\, .
\end{equation}
-/
theorem singlyCancellativeCauchySchwarz_bound
    (n k J : ℕ) (hJ : 1 ≤ J) (hk : 1 ≤ k) (hkn : k < n)
    (rho : Fin J → KKernel k) (phi : Fin J → ℝ → ℝ)
    (hrho : ∀ j, MemW0 (rho j)) (hphi : ∀ j, MemW0 (phi j))
    (F : Fin n → SchwartzMap (RealVector n) ℝ)
    (hF : F ∈ normalizedFunctionTuples n) :
    |prismBrascampLiebForm n k hk hkn.le
      (singlyCancellativeKernel k J rho phi) (fun i x => F i x)| ^ 2 ≤
      prismBrascampLiebForm n (k + 1) (by omega) (by omega)
        (singlyCancellativeLift k J rho phi) (fun i x => F i x) *
          ∑ j : Fin J, (eLpNorm (rho j) 1 volume).toReal := by
  classical
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le (Nat.succ_le_iff.mpr hkn)
  let i0 : Fin (k + 1 + d) := ⟨k - 1, by omega⟩
  have hA (j : Fin J) : MemLp
      (fun p : aux_singlyCancellativeCSPairingSpace (k + 1 + d) k =>
        Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + d) k (rho j) p| *
          aux_singlyCancellativeCSRawA (k + 1 + d) k hk (by omega) (phi j) F p)
      2 volume :=
    aux_memLp_singlyCancellativeCSRawA k d hk (rho j) (hrho j) (phi j) (hphi j) F
  have hcs := aux_singlyCancellativeCS_pairing_cauchy (k + 1 + d) k J hk
    (by omega) rho phi hrho hphi F hA
  have hAeq := aux_singlyCancellativeA2_eq_liftPrism k d J hJ hk
    rho phi hrho hphi F
  have hBeq :
      (∑ j : Fin J, ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + d) k,
        |Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + d) k (rho j) p| *
          aux_singlyCancellativeCSRawB (k + 1 + d) k hk (by omega) F p| ^ (2 : ℝ)) =
        ∑ j : Fin J, ∫ p : (RealVector k × RealVector k) ×
          (ℝ × RealVector (k + 1 + d - k)),
          aux_singlyCancellativeB2OriginalIntegrand (k + 1 + d) k hk (by omega)
            (rho j) (F i0) p := by
    apply Finset.sum_congr rfl
    intro j _
    apply integral_congr_ae
    filter_upwards [] with p
    rw [Real.rpow_two, sq_abs]
    have hidx : prismIndex hk (by omega) (0 : Fin (k + 1 + d - k + 1)) = i0 := by
      apply Fin.ext
      simp [prismIndex, i0]
    unfold aux_singlyCancellativeCSRawR aux_singlyCancellativeCSRawB
      aux_singlyCancellativeBProduct aux_singlyCancellativeB2OriginalIntegrand
    rw [hidx, mul_pow, Real.sq_sqrt (abs_nonneg _)]
  have hA_nonneg : 0 ≤ prismBrascampLiebForm (k + 1 + d) (k + 1)
      (by omega) (by omega) (singlyCancellativeLift k J rho phi)
      (fun i x => F i x) := by
    rw [← hAeq]
    apply Finset.sum_nonneg
    intro j _
    apply integral_nonneg
    intro p
    exact Real.rpow_nonneg (abs_nonneg _) _
  have hBbound :
      (∑ j : Fin J, ∫ p : (RealVector k × RealVector k) ×
          (ℝ × RealVector (k + 1 + d - k)),
          aux_singlyCancellativeB2OriginalIntegrand (k + 1 + d) k hk (by omega)
            (rho j) (F i0) p) ≤
        ∑ j : Fin J, (eLpNorm (rho j) 1 volume).toReal := by
    simpa [i0] using
      (aux_singlyCancellativeB2Original_sum_le (k + 1 + d) k J hk (by omega)
        rho hrho F hF)
  rw [aux_singlyCancellative_prismForm_eq_rawPairing (k + 1 + d) k J hJ hk
    (by omega) rho phi hrho hphi F]
  calc
    |∑ j, ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + d) k,
      aux_singlyCancellativeCSRawR (k + 1 + d) k (rho j) p *
        aux_singlyCancellativeCSRawA (k + 1 + d) k hk (by omega) (phi j) F p *
          aux_singlyCancellativeCSRawB (k + 1 + d) k hk (by omega) F p| ^ 2 ≤
        (∑ j, ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + d) k,
          |Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + d) k (rho j) p| *
            aux_singlyCancellativeCSRawA (k + 1 + d) k hk (by omega) (phi j) F p| ^
              (2 : ℝ)) *
          (∑ j, ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + d) k,
            |Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + d) k (rho j) p| *
              aux_singlyCancellativeCSRawB (k + 1 + d) k hk (by omega) F p| ^
                (2 : ℝ)) := hcs
    _ = prismBrascampLiebForm (k + 1 + d) (k + 1) (by omega) (by omega)
          (singlyCancellativeLift k J rho phi) (fun i x => F i x) *
        (∑ j : Fin J, ∫ p : (RealVector k × RealVector k) ×
          (ℝ × RealVector (k + 1 + d - k)),
          aux_singlyCancellativeB2OriginalIntegrand (k + 1 + d) k hk (by omega)
            (rho j) (F i0) p) := by rw [hAeq, hBeq]
    _ ≤ prismBrascampLiebForm (k + 1 + d) (k + 1) (by omega) (by omega)
          (singlyCancellativeLift k J rho phi) (fun i x => F i x) *
        ∑ j : Fin J, (eLpNorm (rho j) 1 volume).toReal :=
      mul_le_mul_of_nonneg_left hBbound hA_nonneg

/-- Auxiliary definition for Proposition \ref{doubly cancellative Cauchy-Schwarz}; see
`doublyCancellativeCauchySchwarz_bound`. -/
def doublyCancellativeKernel (n J : ℕ) (rho : Fin J → KKernel (n - 1))
    (phi : Fin J → ℝ → ℝ) : KKernel (n - 1) :=
  fun u => ∑ j, ∫ r : ℝ, ∫ s : ℝ,
    rho j (u.1, u.2 - r - s) * phi j r * phi j s

/--
Auxiliary definition for Proposition `\ref{doubly cancellative Cauchy-Schwarz}`
and `doublyCancellativeCauchySchwarz_bound`.
-/
def aux_doublyCancellativeCSExpandedKernel (k : ℕ) (rho : KKernel k)
    (phi : ℝ → ℝ) : (((RealVector k × ℝ) × ℝ) × ℝ) → ℝ := fun p =>
  rho (p.1.1.1, p.1.1.2 - p.1.2 - p.2) * phi p.1.2 * phi p.2

/--
Auxiliary lemma for Proposition `\ref{doubly cancellative Cauchy-Schwarz}`
and `doublyCancellativeCauchySchwarz_bound`.
-/
theorem aux_memW0_doublyCancellativeCSExpandedKernel (k : ℕ) (rho : KKernel k)
    (hrho : MemW0 rho) (phi : ℝ → ℝ) (hphi : MemW0 phi) :
    MemW0 (aux_doublyCancellativeCSExpandedKernel k rho phi) := by
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k)) :=
    isAddHaarMeasure_volume_pi (Fin k)
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure ((RealVector k × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure (((RealVector k × ℝ) × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let scalarSwap : (((RealVector k × ℝ) × ℝ) × ℝ) ≃L[ℝ]
      (((RealVector k × ℝ) × ℝ) × ℝ) :=
    (ContinuousLinearEquiv.prodAssoc ℝ (RealVector k × ℝ) ℝ ℝ).trans
      (((ContinuousLinearEquiv.refl ℝ (RealVector k × ℝ)).prodCongr
        (ContinuousLinearEquiv.prodComm ℝ ℝ ℝ)).trans
        (ContinuousLinearEquiv.prodAssoc ℝ (RealVector k × ℝ) ℝ ℝ).symm)
  let e : (((RealVector k × ℝ) × ℝ) × ℝ) ≃L[ℝ]
      (((RealVector k × ℝ) × ℝ) × ℝ) :=
    ((aux_singlyCancellativeShear k).prodCongr
      (ContinuousLinearEquiv.refl ℝ ℝ)).trans scalarSwap
  let H : (((RealVector k × ℝ) × ℝ) × ℝ) → ℝ := fun p =>
    aux_singlyCancellativeExpandedKernel k rho phi p.1 * phi p.2
  have hH : MemW0 H := by
    simpa [H] using
      (aux_memW0_singlyCancellativeExpandedKernel k rho hrho phi hphi).aux_mul_prod hphi
  have hHs : MemW0 (H ∘ e) := aux_memW0_comp_continuousLinearEquiv hH e
  have hEq : aux_doublyCancellativeCSExpandedKernel k rho phi = H ∘ e := by
    funext p
    rcases p with ⟨⟨⟨u, t⟩, r⟩, s⟩
    simp [aux_doublyCancellativeCSExpandedKernel, H, e, scalarSwap,
      aux_singlyCancellativeExpandedKernel, aux_singlyCancellativeShear]
    ring
  rw [hEq]
  exact hHs

/--
Auxiliary lemma for Proposition `\ref{doubly cancellative Cauchy-Schwarz}`
and `doublyCancellativeCauchySchwarz_bound`.
-/
theorem aux_measurePreserving_prismPullbackSkewTwoScalars (n k : ℕ) (hkn : k ≤ n)
    (h : Fin k → Fin 2) (i : Fin (n - k + 1)) :
    MeasurePreserving
      (fun p : (((RealVector k × ℝ) × ℝ) × ℝ) × RealVector n =>
        (p.1, aux_prismPullback n k hkn h i p.1.1.1.1 p.1.1.1.2 p.2)) volume volume := by
  change MeasurePreserving _
    ((volume : Measure (((RealVector k × ℝ) × ℝ) × ℝ)).prod
      (volume : Measure (RealVector n)))
    ((volume : Measure (((RealVector k × ℝ) × ℝ) × ℝ)).prod
      (volume : Measure (RealVector n)))
  let g : (((RealVector k × ℝ) × ℝ) × ℝ) → RealVector n → RealVector n := fun p z =>
    aux_prismPullback n k hkn h i p.1.1.1 p.1.1.2 z
  have hg : Measurable (Function.uncurry g) := by
    have hparams : Measurable
        (fun p : (((RealVector k × ℝ) × ℝ) × ℝ) × RealVector n =>
          (p.1.1.1, p.2)) :=
      (measurable_fst.comp (measurable_fst.comp measurable_fst)).prodMk measurable_snd
    exact (aux_measurable_prismPullback n k hkn h i).comp hparams
  have hskew := MeasurePreserving.skew_product
    (μa := (volume : Measure (((RealVector k × ℝ) × ℝ) × ℝ)))
    (μb := (volume : Measure (((RealVector k × ℝ) × ℝ) × ℝ)))
    (μc := (volume : Measure (RealVector n)))
    (μd := (volume : Measure (RealVector n)))
    (g := g) (MeasurePreserving.id (volume : Measure (((RealVector k × ℝ) × ℝ) × ℝ))) hg
    (ae_of_all _ fun p =>
      (aux_measurePreserving_prismPullback n k hkn h i p.1.1.1 p.1.1.2).map_eq)
  simpa [g, id_eq] using hskew

/--
Auxiliary lemma for Proposition `\ref{doubly cancellative Cauchy-Schwarz}`
and `doublyCancellativeCauchySchwarz_bound`.
-/
theorem aux_integrable_doublyCancellativeCSExpandedIntegrand
    (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n)
    (rho : KKernel k) (hrho : MemW0 rho) (phi : ℝ → ℝ) (hphi : MemW0 phi)
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    Integrable (fun p : (((RealVector k × ℝ) × ℝ) × ℝ) × RealVector n =>
      aux_doublyCancellativeCSExpandedKernel k rho phi p.1 *
        ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
          F (prismIndex hk hkn i)
            (aux_prismPullback n k hkn h i p.1.1.1.1 p.1.1.1.2 p.2)) := by
  classical
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k)) :=
    isAddHaarMeasure_volume_pi (Fin k)
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure ((RealVector k × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure (((RealVector k × ℝ) × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let I := (Fin k → Fin 2) × Fin (n - k + 1)
  let a : I := (fun _ => 0, 0)
  let P : I → ((((RealVector k × ℝ) × ℝ) × ℝ) × RealVector n) → ℝ := fun hi w =>
    F (prismIndex hk hkn hi.2)
      (aux_prismPullback n k hkn hi.1 hi.2 w.1.1.1.1 w.1.1.1.2 w.2)
  let D : ((((RealVector k × ℝ) × ℝ) × ℝ) × RealVector n) → ℝ := fun w =>
    aux_doublyCancellativeCSExpandedKernel k rho phi w.1 * P a w
  let R : ((((RealVector k × ℝ) × ℝ) × ℝ) × RealVector n) → ℝ := fun w =>
    ∏ hi ∈ (Finset.univ.erase a), P hi w
  let C : ℝ := ∏ hi ∈ (Finset.univ.erase a),
    SchwartzMap.seminorm ℝ 0 0 (F (prismIndex hk hkn hi.2))
  let H : ((((RealVector k × ℝ) × ℝ) × ℝ) × RealVector n) → ℝ := fun w =>
    aux_doublyCancellativeCSExpandedKernel k rho phi w.1 * ∏ hi : I, P hi w
  have hExpanded : MemW0 (aux_doublyCancellativeCSExpandedKernel k rho phi) :=
    aux_memW0_doublyCancellativeCSExpandedKernel k rho hrho phi hphi
  have hC : 0 ≤ C := by
    dsimp [C]
    positivity
  have hPmeas (hi : I) : Measurable (P hi) := by
    dsimp [P]
    have hparams : Measurable
        (fun w : ((((RealVector k × ℝ) × ℝ) × ℝ) × RealVector n) =>
          (w.1.1.1, w.2)) :=
      (measurable_fst.comp (measurable_fst.comp measurable_fst)).prodMk measurable_snd
    exact (F (prismIndex hk hkn hi.2)).continuous.measurable.comp
      ((aux_measurable_prismPullback n k hkn hi.1 hi.2).comp hparams)
  have hHmeas : Measurable H := by
    dsimp [H]
    apply (hExpanded.aux_continuous.measurable.comp measurable_fst).mul
    apply Finset.measurable_fun_prod Finset.univ
    intro hi _
    exact hPmeas hi
  have hRbound (w : ((((RealVector k × ℝ) × ℝ) × ℝ) × RealVector n)) :
      ‖R w‖ ≤ C := by
    dsimp [R, C]
    calc
      ‖∏ hi ∈ Finset.univ.erase a, P hi w‖ ≤
          ∏ hi ∈ Finset.univ.erase a, ‖P hi w‖ :=
        Finset.norm_prod_le _ _
      _ ≤ ∏ hi ∈ Finset.univ.erase a,
          SchwartzMap.seminorm ℝ 0 0 (F (prismIndex hk hkn hi.2)) := by
          gcongr with hi hhi
          exact (F (prismIndex hk hkn hi.2)).norm_le_seminorm ℝ _
  have hfactor (w : ((((RealVector k × ℝ) × ℝ) × ℝ) × RealVector n)) :
      H w = D w * R w := by
    dsimp [H, D, R]
    rw [← Finset.mul_prod_erase Finset.univ (fun hi => P hi w)
      (Finset.mem_univ a)]
    ring
  have hbound (w : ((((RealVector k × ℝ) × ℝ) × ℝ) × RealVector n)) :
      ‖H w‖ ≤ C * ‖D w‖ := by
    rw [hfactor]
    calc
      ‖D w * R w‖ = ‖D w‖ * ‖R w‖ := norm_mul _ _
      _ ≤ ‖D w‖ * C := mul_le_mul_of_nonneg_left (hRbound w) (norm_nonneg _)
      _ = C * ‖D w‖ := mul_comm _ _
  have hExpandedInt : Integrable (aux_doublyCancellativeCSExpandedKernel k rho phi) :=
    aux_memW0_integrable_of_addHaar hExpanded
  have hFint : Integrable (F (prismIndex hk hkn a.2) : RealVector n → ℝ) :=
    (F (prismIndex hk hkn a.2)).integrable
  have hTensorInt : Integrable
      (fun w : (((RealVector k × ℝ) × ℝ) × ℝ) × RealVector n =>
        aux_doublyCancellativeCSExpandedKernel k rho phi w.1 *
          F (prismIndex hk hkn a.2) w.2) := hExpandedInt.mul_prod hFint
  have hD : Integrable D := by
    have hmp := aux_measurePreserving_prismPullbackSkewTwoScalars n k hkn a.1 a.2
    have hcomp := hmp.integrable_comp_of_integrable hTensorInt
    simpa [D, P, Function.comp_def] using hcomp
  have hH : Integrable H := by
    have hDom : Integrable (fun w => C * ‖D w‖) := hD.norm.const_mul C
    exact hDom.mono' hHmeas.aestronglyMeasurable (ae_of_all _ hbound)
  convert hH using 1
  funext p
  dsimp [H, P]
  congr 1
  rw [← Fintype.prod_prod_type']

/--
The original prism-coordinate space with both scalar convolution variables
retained. It is an auxiliary coordinate model for the Fubini calculation in
Proposition `\ref{doubly cancellative Cauchy-Schwarz}`.
-/
abbrev aux_doublyCancellativeCSOriginalSpace (n k : ℕ) :=
  (((RealVector k × RealVector k) × RealVector (n - k + 1)) × ℝ) × ℝ

/--
The fully unintegrated doubly-cancellative prism integrand in original prism
coordinates. It records the two scalar fibres before the substitutions used
in the raw pairing expansion.
-/
def aux_doublyCancellativeCSOriginalIntegrand (n k : ℕ) (hk : 1 ≤ k)
    (hkn : k ≤ n) (rho : KKernel k) (phi : ℝ → ℝ)
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    aux_doublyCancellativeCSOriginalSpace n k → ℝ := fun p =>
  rho (p.1.1.1.2 - p.1.1.1.1,
    coordinateSum p.1.1.1.1 + coordinateSum p.1.1.2 - p.1.2 - p.2) *
    phi p.1.2 * phi p.2 *
      ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
        F (prismIndex hk hkn i) (prismPoint hk hkn p.1.1.1 p.1.1.2 h i)

/--
Auxiliary Fubini block reordering for the global-to-original coordinate
transport with two scalar convolution variables.
-/
private noncomputable def aux_doublyCancellativeCSGlobalReorder (n k : ℕ) :
    (((RealVector k × ℝ) × ℝ) × ℝ) × RealVector n ≃ᵐ
      (((RealVector k × ℝ) × ℝ) × RealVector n) × ℝ :=
  (MeasurableEquiv.prodAssoc.trans
    ((MeasurableEquiv.refl ((RealVector k × ℝ) × ℝ)).prodCongr
      MeasurableEquiv.prodComm)).trans MeasurableEquiv.prodAssoc.symm

/-- Haar preservation of `aux_doublyCancellativeCSGlobalReorder`. -/
private theorem aux_measurePreserving_doublyCancellativeCSGlobalReorder
    (n k : ℕ) :
    MeasurePreserving (aux_doublyCancellativeCSGlobalReorder n k) volume volume := by
  let A := (RealVector k × ℝ) × ℝ
  have h1 : MeasurePreserving (MeasurableEquiv.prodAssoc :
      (A × ℝ) × RealVector n ≃ᵐ A × (ℝ × RealVector n)) volume volume :=
    volume_preserving_prodAssoc
  have h2 : MeasurePreserving
      ((MeasurableEquiv.refl A).prodCongr
        (MeasurableEquiv.prodComm : ℝ × RealVector n ≃ᵐ RealVector n × ℝ))
      volume volume := by
    change MeasurePreserving
      (Prod.map (id : A → A) (Prod.swap : ℝ × RealVector n → RealVector n × ℝ))
        volume volume
    simpa only [Measure.volume_eq_prod, id_eq] using
      (MeasurePreserving.id (volume : Measure A)).prod
        (aux_volume_preserving_prod_swap (volume : Measure ℝ)
          (volume : Measure (RealVector n)))
  have h3 : MeasurePreserving (MeasurableEquiv.prodAssoc.symm :
      A × (RealVector n × ℝ) ≃ᵐ (A × RealVector n) × ℝ) volume volume :=
    volume_preserving_prodAssoc.symm
  exact h3.comp (h2.comp h1)

/--
The global-to-original coordinate transport retaining both scalar convolution
variables in the raw doubly-cancellative calculation.
-/
def aux_doublyCancellativeCSGlobalToOriginal (n k : ℕ) (hkn : k ≤ n) :
    (((RealVector k × ℝ) × ℝ) × ℝ) × RealVector n →
      aux_doublyCancellativeCSOriginalSpace n k := fun p =>
  (aux_singlyCancellativeGlobalToOriginal n k hkn (p.1.1, p.2), p.1.2)

/--
Haar preservation of the doubled global-to-original prism-coordinate
transport.
-/
theorem aux_measurePreserving_doublyCancellativeCSGlobalToOriginal
    (n k : ℕ) (hkn : k ≤ n) :
    MeasurePreserving (aux_doublyCancellativeCSGlobalToOriginal n k hkn)
      volume volume := by
  have hmap : MeasurePreserving
      (Prod.map (aux_singlyCancellativeGlobalToOriginal n k hkn) (id : ℝ → ℝ))
      volume volume := by
    simpa only [Measure.volume_eq_prod, id_eq] using
      (aux_measurePreserving_singlyCancellativeGlobalToOriginal n k hkn).prod
        (MeasurePreserving.id (volume : Measure ℝ))
  have hEq : aux_doublyCancellativeCSGlobalToOriginal n k hkn =
      (Prod.map (aux_singlyCancellativeGlobalToOriginal n k hkn) (id : ℝ → ℝ)) ∘
        aux_doublyCancellativeCSGlobalReorder n k := by
    funext p
    rcases p with ⟨⟨⟨⟨u, t⟩, r⟩, s⟩, z⟩
    rfl
  rw [hEq]
  exact hmap.comp (aux_measurePreserving_doublyCancellativeCSGlobalReorder n k)

/--
Pointwise compatibility of the doubled global and original raw integrands.
It supplies the literal coordinate identity used to transfer the direct
integrability certificate into original prism coordinates.
-/
theorem aux_doublyCancellativeCSOriginalIntegrand_comp_globalToOriginal
    (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n) (rho : KKernel k)
    (phi : ℝ → ℝ) (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    aux_doublyCancellativeCSOriginalIntegrand n k hk hkn rho phi F ∘
      aux_doublyCancellativeCSGlobalToOriginal n k hkn =
    fun p : (((RealVector k × ℝ) × ℝ) × ℝ) × RealVector n =>
      aux_doublyCancellativeCSExpandedKernel k rho phi p.1 *
        ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
          F (prismIndex hk hkn i)
            (aux_prismPullback n k hkn h i p.1.1.1.1 p.1.1.1.2 p.2) := by
  funext p
  rcases p with ⟨⟨⟨⟨u, t⟩, r⟩, s⟩, z⟩
  let q := aux_prismCoordinates n k hkn (u, (t, z))
  have hargs := aux_prismCoordinates_kernelArguments n k hkn u t z
  have hu : q.1.2 - q.1.1 = u := congrArg Prod.fst hargs
  have ht : coordinateSum q.1.1 + coordinateSum q.2 = t := congrArg Prod.snd hargs
  have hprod :
      (∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
        F (prismIndex hk hkn i) (prismPoint hk hkn q.1 q.2 h i)) =
      ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
        F (prismIndex hk hkn i)
          (aux_prismPullback n k hkn h i u t z) := by
    apply Finset.prod_congr rfl
    intro h _
    apply Finset.prod_congr rfl
    intro i _
    exact congrArg (F (prismIndex hk hkn i))
      (aux_prismPoint_eq_prismPullbackCoordinates n k hk hkn u t z h i)
  change rho (q.1.2 - q.1.1, coordinateSum q.1.1 + coordinateSum q.2 - r - s) *
      phi r * phi s *
        (∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
          F (prismIndex hk hkn i) (prismPoint hk hkn q.1 q.2 h i)) = _
  rw [hu, ht, hprod]
  rfl

/--
Measurability of the fully unintegrated original-coordinate integrand used
in the doubly-cancellative raw Fubini expansion.
-/
theorem aux_measurable_doublyCancellativeCSOriginalIntegrand
    (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n) (rho : KKernel k)
    (hrho : MemW0 rho) (phi : ℝ → ℝ) (hphi : MemW0 phi)
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    Measurable (aux_doublyCancellativeCSOriginalIntegrand n k hk hkn rho phi F) := by
  unfold aux_doublyCancellativeCSOriginalIntegrand
  have hArg : Measurable (fun p : aux_doublyCancellativeCSOriginalSpace n k =>
      (p.1.1.1.2 - p.1.1.1.1,
        coordinateSum p.1.1.1.1 + coordinateSum p.1.1.2 - p.1.2 - p.2)) := by
    exact (((continuous_snd.comp (continuous_fst.comp
      (continuous_fst.comp continuous_fst))).sub
      (continuous_fst.comp (continuous_fst.comp
        (continuous_fst.comp continuous_fst)))).prodMk
      (((((aux_continuous_coordinateSum k).comp
        (continuous_fst.comp (continuous_fst.comp
          (continuous_fst.comp continuous_fst)))).add
        ((aux_continuous_coordinateSum (n - k + 1)).comp
          (continuous_snd.comp (continuous_fst.comp continuous_fst)))).sub
          (continuous_snd.comp continuous_fst)).sub continuous_snd)).measurable
  have hProd : Measurable (fun p : aux_doublyCancellativeCSOriginalSpace n k =>
      ∏ h : Fin k → Fin 2, ∏ i : Fin (n - k + 1),
        F (prismIndex hk hkn i) (prismPoint hk hkn p.1.1.1 p.1.1.2 h i)) := by
    apply Finset.measurable_fun_prod Finset.univ
    intro h _
    apply Finset.measurable_fun_prod Finset.univ
    intro i _
    have hpoint : Continuous (fun p : aux_doublyCancellativeCSOriginalSpace n k =>
        prismPoint hk hkn p.1.1.1 p.1.1.2 h i) := by
      apply continuous_pi
      intro a
      by_cases ha : a.1 < k
      · by_cases hh : h ⟨a.1, ha⟩ = 0
        · simp only [prismPoint, concatVector, ha, ↓reduceDIte, cubeCorner, hh,
            Fin.isValue, ↓reduceIte]
          exact (continuous_apply (⟨a.1, ha⟩ : Fin k)).comp
            (continuous_fst.comp (continuous_fst.comp
              (continuous_fst.comp continuous_fst)))
        · simp only [prismPoint, concatVector, ha, ↓reduceDIte, cubeCorner,
            Fin.isValue, hh, ↓reduceIte]
          exact (continuous_apply (⟨a.1, ha⟩ : Fin k)).comp
            (continuous_snd.comp (continuous_fst.comp
              (continuous_fst.comp continuous_fst)))
      · simp only [prismPoint, concatVector, ha, ↓reduceDIte, eraseVector]
        exact (continuous_apply (i.succAbove ⟨a.1 - k, by omega⟩)).comp
          (continuous_snd.comp (continuous_fst.comp continuous_fst))
    exact (F (prismIndex hk hkn i)).continuous.measurable.comp hpoint.measurable
  exact (((hrho.aux_continuous.measurable.comp hArg).mul
    (hphi.aux_continuous.measurable.comp (measurable_snd.comp measurable_fst))).mul
      (hphi.aux_continuous.measurable.comp measurable_snd)).mul hProd

/--
Absolute integrability of the original-coordinate doubled raw integrand.
This is the Fubini certificate for the raw pairing identity in Proposition
`\ref{doubly cancellative Cauchy-Schwarz}`.
-/
theorem aux_integrable_doublyCancellativeCSOriginalIntegrand
    (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n) (rho : KKernel k)
    (hrho : MemW0 rho) (phi : ℝ → ℝ) (hphi : MemW0 phi)
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    Integrable (aux_doublyCancellativeCSOriginalIntegrand n k hk hkn rho phi F) := by
  have hglobal := aux_integrable_doublyCancellativeCSExpandedIntegrand n k hk hkn
    rho hrho phi hphi F
  have hcomp : Integrable
      (aux_doublyCancellativeCSOriginalIntegrand n k hk hkn rho phi F ∘
        aux_doublyCancellativeCSGlobalToOriginal n k hkn) := by
    rw [aux_doublyCancellativeCSOriginalIntegrand_comp_globalToOriginal]
    exact hglobal
  have hmeas : AEStronglyMeasurable
      (aux_doublyCancellativeCSOriginalIntegrand n k hk hkn rho phi F) volume :=
    (aux_measurable_doublyCancellativeCSOriginalIntegrand n k hk hkn rho hrho
      phi hphi F).aestronglyMeasurable
  exact ((aux_measurePreserving_doublyCancellativeCSGlobalToOriginal n k hkn).integrable_comp
    hmeas).mp hcomp

/--
Auxiliary `W₀` closure for one doubly-cancellative summand.  It realizes the
two scalar integrations as two successive final-coordinate convolutions.
-/
theorem aux_memW0_doublyCancellativeSummand (k : ℕ) (rho : KKernel k)
    (hrho : MemW0 rho) (phi : ℝ → ℝ) (hphi : MemW0 phi) :
    MemW0 (fun u : RealVector k × ℝ => ∫ r : ℝ, ∫ s : ℝ,
      rho (u.1, u.2 - r - s) * phi r * phi s) := by
  let psi : KKernel k := fun v => ∫ s : ℝ, rho (v.1, v.2 - s) * phi s
  have hpsi : MemW0 psi :=
    aux_memW0_singlyCancellativeSummand k rho hrho phi hphi
  have houter : MemW0 (fun u : RealVector k × ℝ =>
      ∫ r : ℝ, psi (u.1, u.2 - r) * phi r) :=
    aux_memW0_singlyCancellativeSummand k psi hpsi phi hphi
  have hEq :
      (fun u : RealVector k × ℝ => ∫ r : ℝ, psi (u.1, u.2 - r) * phi r) =
        fun u : RealVector k × ℝ => ∫ r : ℝ, ∫ s : ℝ,
          rho (u.1, u.2 - r - s) * phi r * phi s := by
    funext u
    apply integral_congr_ae
    filter_upwards [] with r
    change (∫ s : ℝ, rho (u.1, u.2 - r - s) * phi s) * phi r =
      ∫ s : ℝ, rho (u.1, u.2 - r - s) * phi r * phi s
    calc
      (∫ s : ℝ, rho (u.1, u.2 - r - s) * phi s) * phi r =
          ∫ s : ℝ, (rho (u.1, u.2 - r - s) * phi s) * phi r :=
        (integral_mul_const (phi r) _).symm
      _ = ∫ s : ℝ, rho (u.1, u.2 - r - s) * phi r * phi s := by
        apply integral_congr_ae
        filter_upwards [] with s
        ring
  rw [← hEq]
  exact houter

/--
\begin{proposition}[doubly cancellative Cauchy-Schwarz, $k=n-1$]
\label{doubly cancellative Cauchy-Schwarz}
Let $J\ge 1$ be an integer. For $(\rho_j)_{j\in [J)}\subset W_0(\R^n)$ and
$(\phi_j)_{j\in [J)}\subset W_0(\R)$ define for $u\in \R^n$,
\begin{equation}
    K(u):=\sum_{j\in [J)}\int_{\R^2}
    \rho_j(u_{[n-1)}, u_{n-1}-r-s) \phi_j(r) \phi_j(s) \, ds \, dr .
\end{equation}
Then $K\in W_0(\R^n)$.
\end{proposition}
-/
theorem doublyCancellativeKernel_memW0 (n J : ℕ) (_hn : 1 ≤ n) (_hJ : 1 ≤ J)
    (rho : Fin J → KKernel (n - 1)) (phi : Fin J → ℝ → ℝ)
    (hrho : ∀ j, MemW0 (rho j)) (hphi : ∀ j, MemW0 (phi j)) :
    MemW0 (doublyCancellativeKernel n J rho phi) := by
  unfold doublyCancellativeKernel
  apply aux_memW0_finset_sum Finset.univ
  intro j _
  exact aux_memW0_doublyCancellativeSummand (n - 1) (rho j) (hrho j) (phi j) (hphi j)

/-- Auxiliary definition for Proposition \ref{doubly cancellative Cauchy-Schwarz}; see
`doublyCancellativeCauchySchwarz_bound`. -/
def doublyCancellativeLift (n J : ℕ) (hn : 1 ≤ n) (rho : Fin J → KKernel (n - 1))
    (phi : Fin J → ℝ → ℝ) : KKernel n :=
  fun u => ∑ j, ∫ q : ℝ,
    |rho j (fun i => u.1 ⟨i.1, by omega⟩, u.2 - q)| *
      phi j (u.1 ⟨n - 1, by omega⟩ + q) * phi j q

/--
Auxiliary successor-normalized identification of the doubly-cancellative lift
with the existing singly-cancellative lift in Proposition
\ref{doubly cancellative Cauchy-Schwarz}.  It lets
`doublyCancellativeCauchySchwarz_bound` reuse the single-lift expansion.
-/
theorem aux_doublyCancellativeLift_eq_singlyCancellativeLift
    (k J : ℕ) (rho : Fin J → KKernel k) (phi : Fin J → ℝ → ℝ) :
    doublyCancellativeLift (k + 1) J (by omega) rho phi =
      singlyCancellativeLift k J rho phi := by
  funext u
  unfold doublyCancellativeLift singlyCancellativeLift
  simp only [Nat.succ_sub_one]
  apply Finset.sum_congr rfl
  intro j _
  apply integral_congr_ae
  filter_upwards [] with q
  have hvec : (fun i : Fin k => u.1 ⟨i.1, by omega⟩) =
      fun i => u.1 i.castSucc := by
    funext i
    exact congrArg u.1 (Fin.ext rfl)
  have hlast : (⟨k, by omega⟩ : Fin (k + 1)) = Fin.last k := Fin.ext rfl
  rw [hvec, hlast]

/--
\begin{proposition}[doubly cancellative Cauchy-Schwarz, $k=n-1$]
\label{doubly cancellative Cauchy-Schwarz}
For $u\in\R^{n+1}$ let
\begin{equation}
    \tilde{K}(u):=\sum_{j\in[J)}\int_\R |\rho_j|(u_{[n-1)}, u_n-q)
    \phi_j(u_{n-1}+q) \phi_j(q) \, dq .
\end{equation}
Then $\tilde{K}\in W_0(\R^{n+1})$.
\end{proposition}
-/
theorem doublyCancellativeLift_memW0 (n J : ℕ) (hn : 1 ≤ n) (_hJ : 1 ≤ J)
    (rho : Fin J → KKernel (n - 1)) (phi : Fin J → ℝ → ℝ)
    (hrho : ∀ j, MemW0 (rho j)) (hphi : ∀ j, MemW0 (phi j)) :
    MemW0 (doublyCancellativeLift n J hn rho phi) := by
  cases n with
  | zero => omega
  | succ k =>
      simp only [Nat.succ_sub_one] at rho hrho ⊢
      unfold doublyCancellativeLift
      simp only [Nat.succ_sub_one]
      apply aux_memW0_finset_sum Finset.univ
      intro j _
      have hSummand :
          (fun u : RealVector (k + 1) × ℝ => ∫ q : ℝ,
            |rho j (fun i => u.1 ⟨i.1, by omega⟩, u.2 - q)| *
              phi j (u.1 ⟨k, by omega⟩ + q) * phi j q) =
            (fun u : RealVector (k + 1) × ℝ => ∫ q : ℝ,
              |rho j (fun i => u.1 i.castSucc, u.2 - q)| *
                phi j (u.1 (Fin.last k) + q) * phi j q) := by
        funext u
        apply integral_congr_ae
        filter_upwards [] with q
        have hvec : (fun i : Fin k => u.1 ⟨i.1, by omega⟩) =
            fun i => u.1 i.castSucc := by
          funext i
          exact congrArg u.1 (Fin.ext rfl)
        have hlast : (⟨k, by omega⟩ : Fin (k + 1)) = Fin.last k := Fin.ext rfl
        rw [hvec, hlast]
      rw [hSummand]
      exact aux_memW0_singlyCancellativeLiftSummand k (rho j) (hrho j) (phi j) (hphi j)

/--
Auxiliary uniform upper bound for the normalized top-prism forms of the
lifted kernel in Proposition \ref{doubly cancellative Cauchy-Schwarz}.  It
supplies the boundedness required to interpret the manuscript supremum in
`doublyCancellativeCauchySchwarz_bound`.
-/
theorem aux_bddAbove_doublyCancellativeLift_prismForms
    (n J : ℕ) (hn : 1 ≤ n) (hJ : 1 ≤ J)
    (rho : Fin J → KKernel (n - 1)) (phi : Fin J → ℝ → ℝ)
    (hrho : ∀ j, MemW0 (rho j)) (hphi : ∀ j, MemW0 (phi j)) :
    BddAbove (Set.range (fun G : NormalizedFunctionTuple n =>
      |prismBrascampLiebForm n n hn le_rfl
        (doublyCancellativeLift n J hn rho phi) (fun i x => G.1 i x)|)) := by
  classical
  let K := doublyCancellativeLift n J hn rho phi
  have hK : MemW0 K := by
    dsimp [K]
    exact doublyCancellativeLift_memW0 n J hn hJ rho phi hrho hphi
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector n)) :=
    isAddHaarMeasure_volume_pi (Fin n)
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector n × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  have hKtop : eLpNorm K 1 volume ≠ ∞ :=
    (memLp_one_iff_integrable.mpr
      (aux_memW0_integrable_of_addHaar hK)).eLpNorm_ne_top
  refine ⟨(eLpNorm K 1 volume).toReal, ?_⟩
  rintro _ ⟨G, rfl⟩
  have hprism := prismBLInequality n n hn le_rfl K hK G.1 G.2
  have hreal : ‖prismBrascampLiebForm n n hn le_rfl K
      (fun i x => G.1 i x)‖ ≤ (eLpNorm K 1 volume).toReal := by
    simpa using ENNReal.toReal_mono hKtop hprism
  simpa only [Real.norm_eq_abs] using hreal

/--
Auxiliary scalar swap for the top-level pairing in Proposition
`\ref{doubly cancellative Cauchy-Schwarz}`. It interchanges the outer scalar
and the unique coordinate of the remaining one-dimensional tail.
-/
noncomputable def aux_doublyCancellativeCSPairingScalarSwap (k : ℕ) :
    ((RealVector (k + 1) × RealVector (k + 1)) × (ℝ × RealVector 1)) →
      ((RealVector (k + 1) × RealVector (k + 1)) × (ℝ × RealVector 1)) :=
  fun p => (p.1,
    aux_prismTailSplitEquiv 1 (1 : Fin 2)
      ((aux_prismTailSplitEquiv 1 (0 : Fin 2)).symm p.2))

/--
Haar preservation of the scalar swap used by
`aux_doublyCancellativeCSPairingScalarSwap` in the proof of
`doublyCancellativeCauchySchwarz_bound`.
-/
theorem aux_measurePreserving_doublyCancellativeCSPairingScalarSwap
    (k : ℕ) :
    MeasurePreserving (aux_doublyCancellativeCSPairingScalarSwap k) volume volume := by
  let Y := RealVector (k + 1) × RealVector (k + 1)
  let e0 := aux_prismTailSplitEquiv 1 (0 : Fin 2)
  let e1 := aux_prismTailSplitEquiv 1 (1 : Fin 2)
  have he0 : MeasurePreserving e0 volume volume := by
    simpa [e0] using aux_measurePreserving_prismTailSplit 1 (0 : Fin 2)
  have he1 : MeasurePreserving e1 volume volume := by
    simpa [e1] using aux_measurePreserving_prismTailSplit 1 (1 : Fin 2)
  have hscalar : MeasurePreserving (e1 ∘ e0.symm) volume volume :=
    he1.comp (he0.symm e0)
  have hwhole : MeasurePreserving (Prod.map (id : Y → Y) (e1 ∘ e0.symm)) volume volume := by
    simpa only [Measure.volume_eq_prod, id_eq] using
      (MeasurePreserving.id (volume : Measure Y)).prod hscalar
  have hfun : aux_doublyCancellativeCSPairingScalarSwap k =
      Prod.map (id : Y → Y) (e1 ∘ e0.symm) := by
    funext p
    rfl
  rw [hfun]
  exact hwhole

/--
Auxiliary coordinate formula for `aux_doublyCancellativeCSPairingScalarSwap`.
It is used to identify the B-factor with the swapped A-factor in
`doublyCancellativeCauchySchwarz_bound`.
-/
theorem aux_doublyCancellativeCSPairingScalarSwap_apply (k : ℕ)
    (y : RealVector (k + 1) × RealVector (k + 1)) (t : ℝ) (x : RealVector 1) :
    aux_doublyCancellativeCSPairingScalarSwap k (y, (t, x)) =
      (y, (x 0, fun _ => t)) := by
  unfold aux_doublyCancellativeCSPairingScalarSwap
  congr 1
  let e0 := aux_prismTailSplitEquiv 1 (0 : Fin 2)
  have hsplit : e0.symm (t, x) = Fin.cons t x := by
    apply e0.injective
    rw [MeasurableEquiv.apply_symm_apply, aux_prismTailSplitEquiv_apply]
    apply Prod.ext
    · simp
    · funext i
      simp [eraseVector]
  rw [show (aux_prismTailSplitEquiv 1 (0 : Fin 2)).symm (t, x) = Fin.cons t x by
    exact hsplit]
  rw [aux_prismTailSplitEquiv_apply]
  apply Prod.ext
  · simp
  · funext i
    fin_cases i
    simp [eraseVector]

/--
The B-factor in the second Cauchy--Schwarz step of Proposition
`\ref{doubly cancellative Cauchy-Schwarz}`. It is used by
`doublyCancellativeCauchySchwarz_bound`.
-/
noncomputable def aux_doublyCancellativeCSRawB (k : ℕ) (phi : ℝ → ℝ)
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ) :
    aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) → ℝ := fun p =>
  ∫ s : ℝ, phi (s - coordinateSum p.2.2) *
    aux_singlyCancellativeBProduct (k + 1 + 1) (k + 1) (by omega) (by omega)
      F p.1 (fun _ => s)

/--
Auxiliary reindexing of the one-dimensional final tail. It is used only to
transport the scalar swap in `aux_doublyCancellativeCSPairingSwap`.
-/
private noncomputable def aux_doublyCancellativeTailEquiv (k : ℕ) :
    RealVector (k + 1 + 1 - (k + 1)) ≃ᵐ RealVector 1 :=
  MeasurableEquiv.piCongrLeft (fun _ : Fin 1 => ℝ)
    (finCongr (Nat.add_sub_cancel_left (k + 1) 1))

/--
Auxiliary rebracketing and reindexing used to transport the scalar swap in
`aux_doublyCancellativeCSPairingSwap`.
-/
private noncomputable def aux_doublyCancellativePairEquiv (k : ℕ) :
    aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) ≃ᵐ
      ((RealVector (k + 1) × RealVector (k + 1)) × (ℝ × RealVector 1)) :=
  (MeasurableEquiv.refl (RealVector (k + 1) × RealVector (k + 1))).prodCongr
    ((MeasurableEquiv.refl ℝ).prodCongr (aux_doublyCancellativeTailEquiv k))

/--
Auxiliary scalar swap on the natural pairing space for Proposition
`\ref{doubly cancellative Cauchy-Schwarz}`. It is the reindexed form of
`aux_doublyCancellativeCSPairingScalarSwap`.
-/
noncomputable def aux_doublyCancellativeCSPairingSwap (k : ℕ) :
    aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) →
      aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) := fun p =>
  (aux_doublyCancellativePairEquiv k).symm
    (aux_doublyCancellativeCSPairingScalarSwap k
      (aux_doublyCancellativePairEquiv k p))

/--
Auxiliary coordinate formula for the tail reindexing in
`aux_doublyCancellativeCSPairingSwap`.
-/
private theorem aux_doublyCancellativeTailEquiv_apply_zero (k : ℕ)
    (z : RealVector (k + 1 + 1 - (k + 1))) :
    aux_doublyCancellativeTailEquiv k z 0 = coordinateSum z := by
  let e : Fin (k + 1 + 1 - (k + 1)) ≃ Fin 1 :=
    finCongr (Nat.add_sub_cancel_left (k + 1) 1)
  let i0 : Fin (k + 1 + 1 - (k + 1)) := e.symm 0
  have hei : e i0 = 0 := e.apply_symm_apply 0
  rw [← hei]
  change (MeasurableEquiv.piCongrLeft (fun _ : Fin 1 => ℝ) e z) (e i0) = _
  rw [MeasurableEquiv.piCongrLeft_apply_apply]
  unfold coordinateSum
  symm
  rw [Finset.sum_eq_single i0]
  · intro i _ hi
    exfalso
    apply hi
    apply Fin.ext
    omega
  · simp

/--
Auxiliary constant-tail formula for the inverse reindexing in
`aux_doublyCancellativeCSPairingSwap`.
-/
private theorem aux_doublyCancellativeTailEquiv_symm_const (k : ℕ) (t : ℝ) :
    (aux_doublyCancellativeTailEquiv k).symm (fun _ : Fin 1 => t) =
      (fun _ : Fin (k + 1 + 1 - (k + 1)) => t) := by
  funext i
  change (Equiv.piCongrLeft (fun _ : Fin 1 => ℝ)
    (finCongr (Nat.add_sub_cancel_left (k + 1) 1))).symm (fun _ => t) i = t
  rw [Equiv.piCongrLeft_symm_apply]

/--
The natural-pairing scalar swap has the expected coordinate formula. It is
used by `aux_doublyCancellativeCSRawB_eq_swappedRawA`.
-/
theorem aux_doublyCancellativeCSPairingSwap_apply (k : ℕ)
    (y : RealVector (k + 1) × RealVector (k + 1)) (t : ℝ)
    (z : RealVector (k + 1 + 1 - (k + 1))) :
    aux_doublyCancellativeCSPairingSwap k (y, (t, z)) =
      (y, (coordinateSum z, fun _ : Fin (k + 1 + 1 - (k + 1)) => t)) := by
  unfold aux_doublyCancellativeCSPairingSwap aux_doublyCancellativePairEquiv
    aux_doublyCancellativeTailEquiv
  change
    ((MeasurableEquiv.refl (RealVector (k + 1) × RealVector (k + 1))).prodCongr
      ((MeasurableEquiv.refl ℝ).prodCongr
        (MeasurableEquiv.piCongrLeft (fun _ : Fin 1 => ℝ)
          (finCongr (Nat.add_sub_cancel_left (k + 1) 1))))).symm
      (aux_doublyCancellativeCSPairingScalarSwap k
        (y, (t, aux_doublyCancellativeTailEquiv k z))) = _
  rw [aux_doublyCancellativeCSPairingScalarSwap_apply]
  change (y, ((aux_doublyCancellativeTailEquiv k z) 0,
    (aux_doublyCancellativeTailEquiv k).symm (fun _ : Fin 1 => t))) = _
  rw [aux_doublyCancellativeTailEquiv_apply_zero,
    aux_doublyCancellativeTailEquiv_symm_const]

/--
Haar preservation of `aux_doublyCancellativeCSPairingSwap`, used to transport
the B-square in `aux_doublyCancellativeCSRawB2_eq_liftPrism`.
-/
theorem aux_measurePreserving_doublyCancellativeCSPairingSwap (k : ℕ) :
    MeasurePreserving (aux_doublyCancellativeCSPairingSwap k) volume volume := by
  let e := aux_doublyCancellativePairEquiv k
  have htail : MeasurePreserving (aux_doublyCancellativeTailEquiv k) volume volume := by
    simpa [aux_doublyCancellativeTailEquiv] using
      (volume_measurePreserving_piCongrLeft (fun _ : Fin 1 => ℝ)
        (finCongr (Nat.add_sub_cancel_left (k + 1) 1)))
  have htailProd : MeasurePreserving
      (Prod.map (id : ℝ → ℝ) (aux_doublyCancellativeTailEquiv k)) volume volume := by
    simpa only [Measure.volume_eq_prod, id_eq] using
      (MeasurePreserving.id (volume : Measure ℝ)).prod htail
  let Y := RealVector (k + 1) × RealVector (k + 1)
  have he : MeasurePreserving e volume volume := by
    have hfun : (e : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) →
        ((RealVector (k + 1) × RealVector (k + 1)) × (ℝ × RealVector 1))) =
        Prod.map (id : Y → Y) (Prod.map (id : ℝ → ℝ)
          (aux_doublyCancellativeTailEquiv k)) := by
      funext p
      rfl
    rw [hfun]
    exact (MeasurePreserving.id (volume : Measure Y)).prod htailProd
  have hs : MeasurePreserving (aux_doublyCancellativeCSPairingScalarSwap k)
      volume volume := aux_measurePreserving_doublyCancellativeCSPairingScalarSwap k
  have hcomp : MeasurePreserving
      ((e.symm : ((RealVector (k + 1) × RealVector (k + 1)) × (ℝ × RealVector 1)) →
        aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1)) ∘
        aux_doublyCancellativeCSPairingScalarSwap k ∘ e) volume volume :=
    (he.symm e).comp (hs.comp he)
  change MeasurePreserving (fun p => e.symm
    (aux_doublyCancellativeCSPairingScalarSwap k (e p))) volume volume
  exact hcomp

/--
The doubly-cancellative B-factor is the singly-cancellative raw A-factor for
the tuple with its final two entries swapped. This is used to identify the
B-square in `aux_doublyCancellativeCSRawB2_eq_liftPrism`.
-/
theorem aux_doublyCancellativeCSRawB_eq_swappedRawA (k : ℕ) (phi : ℝ → ℝ)
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ)
    (p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1)) :
    aux_doublyCancellativeCSRawB k phi F p =
      aux_singlyCancellativeCSRawA (k + 1 + 1) (k + 1) (by omega) (by omega) phi
        (fun i => F (Equiv.swap (⟨k, by omega⟩ : Fin (k + 1 + 1))
          (⟨k + 1, by omega⟩ : Fin (k + 1 + 1)) i))
        (aux_doublyCancellativeCSPairingSwap k p) := by
  classical
  rcases p with ⟨y, t, z⟩
  rw [aux_doublyCancellativeCSPairingSwap_apply]
  unfold aux_doublyCancellativeCSRawB aux_singlyCancellativeCSRawA
  apply integral_congr_ae
  filter_upwards [] with s
  congr 1
  unfold aux_singlyCancellativeBProduct aux_singlyCancellativeAProduct
  apply Finset.prod_congr rfl
  intro h _
  let i0 : Fin (k + 1 + 1 - (k + 1)) := ⟨0, by omega⟩
  let instUnique : Unique (Fin (k + 1 + 1 - (k + 1))) :=
    { default := i0
      uniq := by
        intro i
        apply Fin.ext
        omega }
  let : Unique (Fin (k + 1 + 1 - (k + 1))) := instUnique
  rw [Finset.univ_unique]
  rw [Finset.prod_singleton]
  change (F (prismIndex (by omega) (by omega)
      (0 : Fin (k + 1 + 1 - (k + 1) + 1)))
      (concatVector (k + 1 + 1) (k + 1) (by omega) (cubeCorner y h) (fun _ => s))) =
    F (Equiv.swap (⟨k, by omega⟩ : Fin (k + 1 + 1))
      (⟨k + 1, by omega⟩ : Fin (k + 1 + 1))
      (prismIndex (by omega) (by omega) i0.succ))
      (prismPoint (by omega) (by omega) y
        (Fin.cons s (fun _ : Fin (k + 1 + 1 - (k + 1)) => t)) h i0.succ)
  simp only [prismIndex, add_tsub_cancel_right, Fin.coe_ofNat_eq_mod,
    add_tsub_cancel_left, Nat.reduceAdd, Nat.zero_mod, add_zero, Fin.succ_mk,
    zero_add, Equiv.swap_apply_right, prismPoint, i0]
  congr 1
  congr 1
  funext q
  have hq : q = i0 := instUnique.uniq q
  subst q
  unfold eraseVector
  rw [Fin.succAbove_of_castSucc_lt]
  · simp [i0]
  · change (0 : ℕ) < 1
    omega

/--
Auxiliary measurable equivalence implementing the scalar swap on the
reindexed pairing space.  It is used only to transport `MemLp` and integrals
in `aux_doublyCancellativeCSRawB2_eq_liftPrism`.
-/
private noncomputable def aux_doublyCancellativeCSPairingScalarEquiv (k : ℕ) :
    ((RealVector (k + 1) × RealVector (k + 1)) × (ℝ × RealVector 1)) ≃ᵐ
      ((RealVector (k + 1) × RealVector (k + 1)) × (ℝ × RealVector 1)) :=
  (MeasurableEquiv.refl (RealVector (k + 1) × RealVector (k + 1))).prodCongr
    ((aux_prismTailSplitEquiv 1 (0 : Fin 2)).symm.trans
      (aux_prismTailSplitEquiv 1 (1 : Fin 2)))

/--
Auxiliary measurable equivalence whose underlying map is
`aux_doublyCancellativeCSPairingSwap`.  It provides the measure-preserving
change of variables needed for the B-square transport.
-/
private noncomputable def aux_doublyCancellativeCSPairingSwapEquiv (k : ℕ) :
    aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) ≃ᵐ
      aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) :=
  (aux_doublyCancellativePairEquiv k).trans
    ((aux_doublyCancellativeCSPairingScalarEquiv k).trans
      (aux_doublyCancellativePairEquiv k).symm)

/--
Auxiliary identification of the measurable-equivalence swap with the raw
pairing-space swap, used in `aux_doublyCancellativeCSRawB2_eq_liftPrism`.
-/
private theorem aux_doublyCancellativeCSPairingSwapEquiv_coe (k : ℕ) :
    (aux_doublyCancellativeCSPairingSwapEquiv k :
      aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) →
        aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1)) =
      aux_doublyCancellativeCSPairingSwap k := by
  funext p
  rfl

/--
Auxiliary evaluation of the coordinate sum of the constant one-dimensional
tail.  It is used to show that the raw kernel factor is invariant under the
pairing swap.
-/
private theorem aux_coordinateSum_doublyCancellativeConstTail (k : ℕ) (t : ℝ) :
    coordinateSum (fun _ : Fin (k + 1 + 1 - (k + 1)) => t) = t := by
  unfold coordinateSum
  let i0 : Fin (k + 1 + 1 - (k + 1)) := ⟨0, by omega⟩
  rw [Finset.sum_eq_single i0]
  · intro i _ hi
    exfalso
    apply hi
    apply Fin.ext
    omega
  · simp

/--
Auxiliary invariance of the raw kernel factor under the pairing swap.  It is
used in the B-square and `MemLp` transports to the singly-cancellative
A-factor.
-/
private theorem aux_doublyCancellativeCSRawR_swap (k : ℕ) (rho : KKernel (k + 1))
    (p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1)) :
    aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) rho
      (aux_doublyCancellativeCSPairingSwap k p) =
      aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) rho p := by
  rcases p with ⟨y, t, z⟩
  rw [aux_doublyCancellativeCSPairingSwap_apply]
  unfold aux_singlyCancellativeCSRawR
  rw [aux_coordinateSum_doublyCancellativeConstTail]
  congr 1
  change (y.2 - y.1, coordinateSum y.1 + coordinateSum z + t) =
    (y.2 - y.1, coordinateSum y.1 + t + coordinateSum z)
  congr 1
  ring

/--
Auxiliary one-summand B-square transport.  It is the change-of-variables
step used by `aux_doublyCancellativeCSRawB2_eq_liftPrism`.
-/
private theorem aux_doublyCancellativeCSRawB2_eq_swappedRawA2
    (k : ℕ) (rho : KKernel (k + 1)) (phi : ℝ → ℝ)
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ) :
    (∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1),
      |Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) rho p| *
        aux_doublyCancellativeCSRawB k phi F p| ^ (2 : ℝ)) =
      ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1),
        |Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) rho p| *
          aux_singlyCancellativeCSRawA (k + 1 + 1) (k + 1) (by omega) (by omega)
            phi
            (fun i => F (Equiv.swap (⟨k, by omega⟩ : Fin (k + 1 + 1))
              (⟨k + 1, by omega⟩ : Fin (k + 1 + 1)) i)) p| ^ (2 : ℝ) := by
  let e := aux_doublyCancellativeCSPairingSwapEquiv k
  have he : MeasurePreserving (e :
      aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) →
        aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1)) volume volume := by
    rw [aux_doublyCancellativeCSPairingSwapEquiv_coe]
    exact aux_measurePreserving_doublyCancellativeCSPairingSwap k
  let g : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) → ℝ := fun p =>
    |Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) rho p| *
      aux_singlyCancellativeCSRawA (k + 1 + 1) (k + 1) (by omega) (by omega) phi
        (fun i => F (Equiv.swap (⟨k, by omega⟩ : Fin (k + 1 + 1))
          (⟨k + 1, by omega⟩ : Fin (k + 1 + 1)) i)) p| ^ (2 : ℝ)
  have hpoint (p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1)) :
      |Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) rho p| *
        aux_doublyCancellativeCSRawB k phi F p| ^ (2 : ℝ) = g (e p) := by
    have hep : e p = aux_doublyCancellativeCSPairingSwap k p :=
      congrFun (aux_doublyCancellativeCSPairingSwapEquiv_coe k) p
    dsimp [g]
    rw [hep, aux_doublyCancellativeCSRawB_eq_swappedRawA,
      aux_doublyCancellativeCSRawR_swap]
  calc
    (∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1),
      |Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) rho p| *
        aux_doublyCancellativeCSRawB k phi F p| ^ (2 : ℝ)) =
        ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1), g (e p) := by
          apply integral_congr_ae
          filter_upwards [] with p
          exact hpoint p
    _ = ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1), g p :=
      he.integral_comp' g
    _ = _ := rfl

/--
Auxiliary `L²` certificate for the B-factor in Proposition
`\ref{doubly cancellative Cauchy-Schwarz}`.  It transports the corresponding
raw A-factor certificate through the pairing swap, for use in the finite
Cauchy--Schwarz step.
-/
theorem aux_memLp_doublyCancellativeCSRawB
    (k : ℕ) (rho : KKernel (k + 1)) (hrho : MemW0 rho)
    (phi : ℝ → ℝ) (hphi : MemW0 phi)
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ) :
    MemLp (fun p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) =>
      Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) rho p| *
        aux_doublyCancellativeCSRawB k phi F p) 2 volume := by
  let G : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) → ℝ := fun p =>
    Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) rho p| *
      aux_singlyCancellativeCSRawA (k + 1 + 1) (k + 1) (by omega) (by omega) phi
        (fun i => F (Equiv.swap (⟨k, by omega⟩ : Fin (k + 1 + 1))
          (⟨k + 1, by omega⟩ : Fin (k + 1 + 1)) i)) p
  have hG : MemLp G 2 volume := by
    dsimp [G]
    exact aux_memLp_singlyCancellativeCSRawA (k + 1) 0 (by omega) rho hrho phi hphi
      (fun i => F (Equiv.swap (⟨k, by omega⟩ : Fin (k + 1 + 1))
        (⟨k + 1, by omega⟩ : Fin (k + 1 + 1)) i))
  have hcomp := hG.comp_measurePreserving
    (aux_measurePreserving_doublyCancellativeCSPairingSwap k)
  convert hcomp using 1
  funext p
  unfold Function.comp G
  rw [aux_doublyCancellativeCSRawB_eq_swappedRawA,
    aux_doublyCancellativeCSRawR_swap]

/--
Auxiliary B-square identification in Proposition
`\ref{doubly cancellative Cauchy-Schwarz}`.  It transports the B-side of the
finite Cauchy--Schwarz estimate to the lifted prism Brascamp--Lieb form.
-/
theorem aux_doublyCancellativeCSRawB2_eq_liftPrism
    (k J : ℕ) (hJ : 1 ≤ J)
    (rho : Fin J → KKernel (k + 1)) (phi : Fin J → ℝ → ℝ)
    (hrho : ∀ j, MemW0 (rho j)) (hphi : ∀ j, MemW0 (phi j))
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ) :
    (∑ j : Fin J,
      ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1),
        |Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) (rho j) p| *
          aux_doublyCancellativeCSRawB k (phi j) F p| ^ (2 : ℝ)) =
      prismBrascampLiebForm (k + 1 + 1) (k + 1 + 1) (by omega) (by omega)
        (doublyCancellativeLift (k + 1 + 1) J (by omega) rho phi)
        (fun i x => F (Equiv.swap (⟨k, by omega⟩ : Fin (k + 1 + 1))
          (⟨k + 1, by omega⟩ : Fin (k + 1 + 1)) i) x) := by
  have hsum :
      (∑ j : Fin J,
        ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1),
          |Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) (rho j) p| *
            aux_doublyCancellativeCSRawB k (phi j) F p| ^ (2 : ℝ)) =
        ∑ j : Fin J,
          ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1),
            |Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) (rho j) p| *
              aux_singlyCancellativeCSRawA (k + 1 + 1) (k + 1) (by omega) (by omega)
                (phi j)
                (fun i => F (Equiv.swap (⟨k, by omega⟩ : Fin (k + 1 + 1))
                  (⟨k + 1, by omega⟩ : Fin (k + 1 + 1)) i)) p| ^ (2 : ℝ) := by
    apply Finset.sum_congr rfl
    intro j _
    exact aux_doublyCancellativeCSRawB2_eq_swappedRawA2 k (rho j) (phi j) F
  have hA := aux_singlyCancellativeA2_eq_liftPrism (k + 1) 0 J hJ (by omega)
    rho phi hrho hphi
    (fun i => F (Equiv.swap (⟨k, by omega⟩ : Fin (k + 1 + 1))
      (⟨k + 1, by omega⟩ : Fin (k + 1 + 1)) i))
  calc
    (∑ j : Fin J,
      ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1),
        |Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) (rho j) p| *
          aux_doublyCancellativeCSRawB k (phi j) F p| ^ (2 : ℝ)) =
        ∑ j : Fin J,
          ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1),
            |Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) (rho j) p| *
              aux_singlyCancellativeCSRawA (k + 1 + 1) (k + 1) (by omega) (by omega)
                (phi j)
                (fun i => F (Equiv.swap (⟨k, by omega⟩ : Fin (k + 1 + 1))
                  (⟨k + 1, by omega⟩ : Fin (k + 1 + 1)) i)) p| ^ (2 : ℝ) := hsum
    _ = prismBrascampLiebForm (k + 1 + 1) (k + 1 + 1) (by omega) (by omega)
          (singlyCancellativeLift (k + 1) J rho phi)
          (fun i x => F (Equiv.swap (⟨k, by omega⟩ : Fin (k + 1 + 1))
            (⟨k + 1, by omega⟩ : Fin (k + 1 + 1)) i) x) := by
              simpa using hA
    _ = prismBrascampLiebForm (k + 1 + 1) (k + 1 + 1) (by omega) (by omega)
          (doublyCancellativeLift (k + 1 + 1) J (by omega) rho phi)
          (fun i x => F (Equiv.swap (⟨k, by omega⟩ : Fin (k + 1 + 1))
            (⟨k + 1, by omega⟩ : Fin (k + 1 + 1)) i) x) := by
              rw [aux_doublyCancellativeLift_eq_singlyCancellativeLift]

/--
Auxiliary scalarization of the one-dimensional tail in the raw Fubini
pairing for Proposition `\ref{doubly cancellative Cauchy-Schwarz}`.  It is
introduced solely to express the determinant-one scalar shear without
changing the dependent tail dimension.
-/
private noncomputable def aux_doublyCancellativeRawPairingTailScalarEquiv (k : ℕ) :
    RealVector (k + 1 + 1 - (k + 1)) ≃ᵐ ℝ := by
  letI : Unique (Fin (k + 1 + 1 - (k + 1))) := by
    have hd : k + 1 + 1 - (k + 1) = 1 := by omega
    simpa only [hd] using (inferInstance : Unique (Fin 1))
  exact MeasurableEquiv.piUnique (fun _ : Fin (k + 1 + 1 - (k + 1)) => ℝ)

/--
Auxiliary determinant-one scalar shear used in the raw Fubini rearrangement
for Proposition `\ref{doubly cancellative Cauchy-Schwarz}`.
-/
private noncomputable def aux_doublyCancellativeRawPairingScalarShear :
    ℝ × ℝ ≃ᵐ ℝ × ℝ where
  toFun p := (p.1 - p.2, p.1)
  invFun p := (p.2, p.2 - p.1)
  left_inv := by rintro ⟨x, q⟩; ext <;> ring
  right_inv := by rintro ⟨x, q⟩; ext <;> ring
  measurable_toFun := (measurable_fst.sub measurable_snd).prodMk measurable_fst
  measurable_invFun := measurable_snd.prodMk (measurable_snd.sub measurable_fst)

/--
Auxiliary shear on the final scalar tail and the outer integration scalar in
the raw Fubini rearrangement for Proposition
`\ref{doubly cancellative Cauchy-Schwarz}`.
-/
private noncomputable def aux_doublyCancellativeRawPairingTailShear (k : ℕ) :
    (RealVector (k + 1 + 1 - (k + 1)) × ℝ) ≃ᵐ
      (RealVector (k + 1 + 1 - (k + 1)) × ℝ) :=
  (aux_doublyCancellativeRawPairingTailScalarEquiv k).prodCongr
    (MeasurableEquiv.refl ℝ) |>.trans
      (aux_doublyCancellativeRawPairingScalarShear.trans
        ((aux_doublyCancellativeRawPairingTailScalarEquiv k).symm.prodCongr
          (MeasurableEquiv.refl ℝ)))

/--
The exact raw pairing shear `(x,q) ↦ (x-q,x)` for the top-dimensional
doubly-cancellative Fubini expansion.  It moves the inner kernel variable
into the final bracket factor while retaining the dependent one-dimensional
tail used by `aux_singlyCancellativeCSPairingSpace`.
-/
noncomputable def aux_doublyCancellativeRawPairingShear (k : ℕ) :
    aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ ≃ᵐ
      aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ := by
  let Y := RealVector (k + 1) × RealVector (k + 1)
  let X := RealVector (k + 1 + 1 - (k + 1))
  let inner : (ℝ × X) × ℝ ≃ᵐ (ℝ × X) × ℝ :=
    (MeasurableEquiv.prodAssoc : (ℝ × X) × ℝ ≃ᵐ ℝ × (X × ℝ)).trans
      (((MeasurableEquiv.refl ℝ).prodCongr
        (aux_doublyCancellativeRawPairingTailShear k)).trans
          (MeasurableEquiv.prodAssoc.symm :
            ℝ × (X × ℝ) ≃ᵐ (ℝ × X) × ℝ))
  exact
    ((MeasurableEquiv.prodAssoc :
      (Y × (ℝ × X)) × ℝ ≃ᵐ Y × ((ℝ × X) × ℝ)).trans
        (((MeasurableEquiv.refl Y).prodCongr inner).trans
          (MeasurableEquiv.prodAssoc.symm :
            Y × ((ℝ × X) × ℝ) ≃ᵐ (Y × (ℝ × X)) × ℝ)))

/--
Coordinate formula for the scalarization of the final one-dimensional tail.
It is used to make the raw pairing shear literal.
-/
private theorem aux_doublyCancellativeRawPairingTailScalarEquiv_apply (k : ℕ)
    (x : RealVector (k + 1 + 1 - (k + 1))) :
    aux_doublyCancellativeRawPairingTailScalarEquiv k x = x ⟨0, by omega⟩ := by
  let : Unique (Fin (k + 1 + 1 - (k + 1))) := by
    have hd : k + 1 + 1 - (k + 1) = 1 := by omega
    simpa only [hd] using (inferInstance : Unique (Fin 1))
  let i0 : Fin (k + 1 + 1 - (k + 1)) := ⟨0, by omega⟩
  change x default = x i0
  exact congrArg x (Subsingleton.elim _ _)

/--
Literal coordinate formula for `aux_doublyCancellativeRawPairingShear`; it is
the substitution used to turn the inner kernel integral into the second
scalar bracket of the raw doubly-cancellative pairing.
-/
theorem aux_doublyCancellativeRawPairingShear_apply (k : ℕ)
    (y : RealVector (k + 1) × RealVector (k + 1))
    (t q : ℝ) (x : RealVector (k + 1 + 1 - (k + 1))) :
    aux_doublyCancellativeRawPairingShear k ((y, (t, x)), q) =
      ((y, (t, fun _ => x ⟨0, by omega⟩ - q)), x ⟨0, by omega⟩) := by
  dsimp [aux_doublyCancellativeRawPairingShear]
  simp only [MeasurableEquiv.trans, MeasurableEquiv.prodAssoc,
    MeasurableEquiv.prodCongr, MeasurableEquiv.refl_toEquiv,
    aux_doublyCancellativeRawPairingTailShear,
    aux_doublyCancellativeRawPairingScalarShear, MeasurableEquiv.symm_mk,
    MeasurableEquiv.coe_mk, Equiv.trans_apply, Equiv.prodAssoc_apply,
    Equiv.prodCongr_apply, Equiv.coe_refl, Equiv.coe_trans,
    MeasurableEquiv.coe_toEquiv, Equiv.coe_fn_mk, Prod.map_apply, id_eq,
    Function.comp_apply, Equiv.prodAssoc_symm_apply, Prod.mk.injEq, true_and]
  constructor
  · apply (aux_doublyCancellativeRawPairingTailScalarEquiv k).injective
    rw [MeasurableEquiv.apply_symm_apply]
    rw [aux_doublyCancellativeRawPairingTailScalarEquiv_apply]
    rfl
  · exact aux_doublyCancellativeRawPairingTailScalarEquiv_apply k x

/--
Haar preservation of the scalarization of the final one-dimensional tail.
This is an auxiliary change-of-variables fact for the raw pairing shear.
-/
private theorem aux_measurePreserving_doublyCancellativeRawPairingTailScalarEquiv
    (k : ℕ) :
    MeasurePreserving (aux_doublyCancellativeRawPairingTailScalarEquiv k)
      volume volume := by
  let : Unique (Fin (k + 1 + 1 - (k + 1))) := by
    have hd : k + 1 + 1 - (k + 1) = 1 := by omega
    simpa only [hd] using (inferInstance : Unique (Fin 1))
  simpa [aux_doublyCancellativeRawPairingTailScalarEquiv] using
    (volume_preserving_piUnique
      (fun _ : Fin (k + 1 + 1 - (k + 1)) => ℝ))

/--
Haar preservation of the determinant-one scalar shear used in the raw
doubly-cancellative pairing rearrangement.
-/
private theorem aux_measurePreserving_doublyCancellativeRawPairingScalarShear :
    MeasurePreserving aux_doublyCancellativeRawPairingScalarShear volume volume := by
  have h1 : MeasurePreserving
      (fun p : ℝ × ℝ => (p.2, -p.2 + p.1)) volume volume := by
    simpa only [Measure.volume_eq_prod] using
      (measurePreserving_prod_neg_add_swap (volume : Measure ℝ) (volume : Measure ℝ))
  have h2 : MeasurePreserving
      (fun p : ℝ × ℝ => (p.2, p.2 + p.1)) volume volume := by
    simpa only [Measure.volume_eq_prod] using
      (measurePreserving_prod_add_swap (volume : Measure ℝ) (volume : Measure ℝ))
  convert h2.comp h1 using 1
  funext p
  rcases p with ⟨x, q⟩
  simp [aux_doublyCancellativeRawPairingScalarShear, Function.comp_apply]
  ring

/--
Haar preservation of the scalar-tail shear used by
`aux_doublyCancellativeRawPairingShear`.
-/
private theorem aux_measurePreserving_doublyCancellativeRawPairingTailShear
    (k : ℕ) :
    MeasurePreserving (aux_doublyCancellativeRawPairingTailShear k)
      volume volume := by
  have hleft : MeasurePreserving
      ((aux_doublyCancellativeRawPairingTailScalarEquiv k).prodCongr
        (MeasurableEquiv.refl ℝ)) volume volume := by
    change MeasurePreserving
      (Prod.map (aux_doublyCancellativeRawPairingTailScalarEquiv k)
        (id : ℝ → ℝ)) volume volume
    simpa only [Measure.volume_eq_prod, id_eq] using
      (aux_measurePreserving_doublyCancellativeRawPairingTailScalarEquiv k).prod
        (MeasurePreserving.id (volume : Measure ℝ))
  have hright : MeasurePreserving
      ((aux_doublyCancellativeRawPairingTailScalarEquiv k).symm.prodCongr
        (MeasurableEquiv.refl ℝ)) volume volume := by
    change MeasurePreserving
      (Prod.map (aux_doublyCancellativeRawPairingTailScalarEquiv k).symm
        (id : ℝ → ℝ)) volume volume
    simpa only [Measure.volume_eq_prod, id_eq] using
      ((aux_measurePreserving_doublyCancellativeRawPairingTailScalarEquiv k).symm
        (aux_doublyCancellativeRawPairingTailScalarEquiv k)).prod
          (MeasurePreserving.id (volume : Measure ℝ))
  exact hright.comp
    (aux_measurePreserving_doublyCancellativeRawPairingScalarShear.comp hleft)

/--
The raw pairing shear is Haar preserving.  This is the change of variables
which converts the inner singly-cancellative kernel fibre into the second
bracketed scalar integral in the doubly-cancellative argument.
-/
theorem aux_measurePreserving_doublyCancellativeRawPairingShear (k : ℕ) :
    MeasurePreserving (aux_doublyCancellativeRawPairingShear k) volume volume := by
  let Y := RealVector (k + 1) × RealVector (k + 1)
  let X := RealVector (k + 1 + 1 - (k + 1))
  let inner : (ℝ × X) × ℝ ≃ᵐ (ℝ × X) × ℝ :=
    (MeasurableEquiv.prodAssoc : (ℝ × X) × ℝ ≃ᵐ ℝ × (X × ℝ)).trans
      (((MeasurableEquiv.refl ℝ).prodCongr
        (aux_doublyCancellativeRawPairingTailShear k)).trans
          (MeasurableEquiv.prodAssoc.symm :
            ℝ × (X × ℝ) ≃ᵐ (ℝ × X) × ℝ))
  have h1 : MeasurePreserving
      (MeasurableEquiv.prodAssoc : (ℝ × X) × ℝ ≃ᵐ ℝ × (X × ℝ)) volume volume :=
    volume_preserving_prodAssoc
  have h2 : MeasurePreserving
      ((MeasurableEquiv.refl ℝ).prodCongr
        (aux_doublyCancellativeRawPairingTailShear k)) volume volume := by
    change MeasurePreserving
      (Prod.map (id : ℝ → ℝ) (aux_doublyCancellativeRawPairingTailShear k))
        volume volume
    simpa only [Measure.volume_eq_prod, id_eq] using
      (MeasurePreserving.id (volume : Measure ℝ)).prod
        (aux_measurePreserving_doublyCancellativeRawPairingTailShear k)
  have h3 : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        ℝ × (X × ℝ) ≃ᵐ (ℝ × X) × ℝ) volume volume :=
    volume_preserving_prodAssoc.symm
  have hInner : MeasurePreserving inner volume volume := h3.comp (h2.comp h1)
  have h4 : MeasurePreserving
      (MeasurableEquiv.prodAssoc :
        (Y × (ℝ × X)) × ℝ ≃ᵐ Y × ((ℝ × X) × ℝ)) volume volume :=
    volume_preserving_prodAssoc
  have h5 : MeasurePreserving
      ((MeasurableEquiv.refl Y).prodCongr inner) volume volume := by
    change MeasurePreserving (Prod.map (id : Y → Y) inner) volume volume
    simpa only [Measure.volume_eq_prod, id_eq] using
      (MeasurePreserving.id (volume : Measure Y)).prod hInner
  have h6 : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        Y × ((ℝ × X) × ℝ) ≃ᵐ (Y × (ℝ × X)) × ℝ) volume volume :=
    volume_preserving_prodAssoc.symm
  change MeasurePreserving
    ((MeasurableEquiv.prodAssoc.trans
      (((MeasurableEquiv.refl Y).prodCongr inner).trans
        MeasurableEquiv.prodAssoc.symm) :
      (Y × (ℝ × X)) × ℝ ≃ᵐ (Y × (ℝ × X)) × ℝ)) volume volume
  exact h6.comp (h5.comp h4)

/--
The raw `(y,t,r,x)` base-coordinate space with the remaining kernel scalar
retained in the top-dimensional doubly-cancellative Fubini calculation.
-/
abbrev aux_doublyCancellativeCSRawBaseSpace (k : ℕ) :=
  (RealVector (k + 1) × RealVector (k + 1)) ×
    (ℝ × (ℝ × RealVector (k + 1 + 1 - (k + 1))))

/--
The product of the usual base-coordinate change with the remaining kernel
scalar. It is an auxiliary coordinate transport for the raw pairing
identity in Proposition `\ref{doubly cancellative Cauchy-Schwarz}`.
-/
def aux_doublyCancellativeCSRawBaseChange (k : ℕ) :
    aux_doublyCancellativeCSRawBaseSpace k × ℝ →
      aux_doublyCancellativeCSOriginalSpace (k + 1 + 1) (k + 1) := fun p =>
  (aux_singlyCancellativeBaseChangeGeneral (k + 1 + 1) (k + 1) p.1, p.2)

/--
Haar preservation of `aux_doublyCancellativeCSRawBaseChange`.
-/
theorem aux_measurePreserving_doublyCancellativeCSRawBaseChange (k : ℕ) :
    MeasurePreserving (aux_doublyCancellativeCSRawBaseChange k) volume volume := by
  change MeasurePreserving
    (Prod.map (aux_singlyCancellativeBaseChangeGeneral (k + 1 + 1) (k + 1))
      (id : ℝ → ℝ)) volume volume
  simpa only [Measure.volume_eq_prod, id_eq] using
    (aux_measurePreserving_singlyCancellativeBaseChangeGeneral (k + 1 + 1) (k + 1)).prod
      (MeasurePreserving.id (volume : Measure ℝ))

/--
The raw base integrand after the first top-dimensional Fubini substitution.
It keeps both scalar factors visible before the prism product is split into
the two manuscript brackets.
-/
def aux_doublyCancellativeCSRawBaseIntegrand (k : ℕ) (rho : KKernel (k + 1))
    (phi : ℝ → ℝ)
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ) :
    aux_doublyCancellativeCSRawBaseSpace k × ℝ → ℝ := fun p =>
  rho (p.1.1.2 - p.1.1.1,
    coordinateSum p.1.1.1 + p.1.2.1 + coordinateSum p.1.2.2.2 - p.2) *
      phi (p.1.2.2.1 - p.1.2.1) * phi p.2 *
        ∏ h : Fin (k + 1) → Fin 2,
          ∏ i : Fin ((k + 1 + 1) - (k + 1) + 1),
            F (prismIndex (by omega) (by omega) i)
              (prismPoint (by omega) (by omega) p.1.1
                (Fin.cons p.1.2.2.1 p.1.2.2.2) h i)

/--
Pointwise compatibility of the doubled original integrand with the first raw
base-coordinate change in the doubly-cancellative Fubini expansion.
-/
theorem aux_doublyCancellativeCSOriginalIntegrand_comp_rawBaseChange (k : ℕ)
    (rho : KKernel (k + 1)) (phi : ℝ → ℝ)
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ) :
    aux_doublyCancellativeCSOriginalIntegrand (k + 1 + 1) (k + 1)
      (by omega) (by omega) rho phi F ∘
        aux_doublyCancellativeCSRawBaseChange k =
      aux_doublyCancellativeCSRawBaseIntegrand k rho phi F := by
  funext p
  rcases p with ⟨⟨y, t, r, x⟩, q⟩
  unfold aux_doublyCancellativeCSOriginalIntegrand
    aux_doublyCancellativeCSRawBaseChange aux_doublyCancellativeCSRawBaseIntegrand
    Function.comp
  change rho (y.2 - y.1,
      coordinateSum y.1 + coordinateSum (Fin.cons r x) - (r - t) - q) *
      phi (r - t) * phi q *
        (∏ h : Fin (k + 1) → Fin 2,
          ∏ i : Fin ((k + 1 + 1) - (k + 1) + 1),
            F (prismIndex (by omega) (by omega) i)
              (prismPoint (by omega) (by omega) y (Fin.cons r x) h i)) = _
  have hsum : coordinateSum (Fin.cons r x : RealVector
      ((k + 1 + 1) - (k + 1) + 1)) = r + coordinateSum x := by
    simp [coordinateSum, Fin.sum_univ_succ]
  rw [hsum]
  have hscalar : coordinateSum y.1 + (r + coordinateSum x) - (r - t) - q =
      coordinateSum y.1 + t + coordinateSum x - q := by ring
  rw [hscalar]

/--
The Fubini reassociation
`(y,t,r,x,q) ↦ (((y,t,x),q),r)` used to expose the first scalar bracket in
the raw doubly-cancellative pairing.
-/
noncomputable def aux_doublyCancellativeCSRawFubiniReorder (k : ℕ) :
    aux_doublyCancellativeCSRawBaseSpace k × ℝ ≃ᵐ
      (aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ) × ℝ where
  toFun p := (((p.1.1, (p.1.2.1, p.1.2.2.2)), p.2), p.1.2.2.1)
  invFun q := ((q.1.1.1, (q.1.1.2.1, (q.2, q.1.1.2.2))), q.1.2)
  left_inv := by rintro ⟨⟨y, ⟨t, ⟨r, x⟩⟩⟩, q⟩; rfl
  right_inv := by rintro ⟨⟨⟨y, ⟨t, x⟩⟩, q⟩, r⟩; rfl
  measurable_toFun := by
    change Measurable (fun p : aux_doublyCancellativeCSRawBaseSpace k × ℝ =>
      (((p.1.1, (p.1.2.1, p.1.2.2.2)), p.2), p.1.2.2.1))
    fun_prop
  measurable_invFun := by
    change Measurable (fun q :
      (aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ) × ℝ =>
      ((q.1.1.1, (q.1.1.2.1, (q.2, q.1.1.2.2))), q.1.2))
    fun_prop

/--
Coordinate formula for `aux_doublyCancellativeCSRawFubiniReorder`.
-/
theorem aux_doublyCancellativeCSRawFubiniReorder_apply (k : ℕ)
    (y : RealVector (k + 1) × RealVector (k + 1)) (t r q : ℝ)
    (x : RealVector (k + 1 + 1 - (k + 1))) :
    aux_doublyCancellativeCSRawFubiniReorder k ((y, (t, (r, x))), q) =
      (((y, (t, x)), q), r) := rfl

/--
Haar preservation of the raw doubly-cancellative Fubini reassociation.
-/
theorem aux_measurePreserving_doublyCancellativeCSRawFubiniReorder (k : ℕ) :
    MeasurePreserving (aux_doublyCancellativeCSRawFubiniReorder k) volume volume := by
  let e1 : aux_doublyCancellativeCSRawBaseSpace k × ℝ ≃ᵐ
      (aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ) × ℝ :=
    (aux_singlyCancellativeCSFubiniReorder (k + 1 + 1) (k + 1)).prodCongr
      (MeasurableEquiv.refl ℝ)
  let e2 :
      ((aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ) × ℝ) ≃ᵐ
      ((aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ) × ℝ) :=
    (MeasurableEquiv.prodAssoc :
      (aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ) × ℝ ≃ᵐ
        aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × (ℝ × ℝ)).trans
      (((MeasurableEquiv.refl
        (aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1))).prodCongr
          (MeasurableEquiv.prodComm : ℝ × ℝ ≃ᵐ ℝ × ℝ)).trans
        (MeasurableEquiv.prodAssoc.symm :
          aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × (ℝ × ℝ) ≃ᵐ
            (aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ) × ℝ))
  have h1 : MeasurePreserving e1 volume volume := by
    change MeasurePreserving
      (Prod.map (aux_singlyCancellativeCSFubiniReorder (k + 1 + 1) (k + 1))
        (id : ℝ → ℝ)) volume volume
    simpa only [Measure.volume_eq_prod, id_eq] using
      (aux_measurePreserving_singlyCancellativeCSFubiniReorder (k + 1 + 1) (k + 1)).prod
        (MeasurePreserving.id (volume : Measure ℝ))
  have h2a : MeasurePreserving (MeasurableEquiv.prodAssoc :
      (aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ) × ℝ ≃ᵐ
        aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × (ℝ × ℝ))
      volume volume := volume_preserving_prodAssoc
  have h2b : MeasurePreserving
      ((MeasurableEquiv.refl
        (aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1))).prodCongr
          (MeasurableEquiv.prodComm : ℝ × ℝ ≃ᵐ ℝ × ℝ)) volume volume := by
    change MeasurePreserving
      (Prod.map (id : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) →
        aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1))
        (Prod.swap : ℝ × ℝ → ℝ × ℝ)) volume volume
    simpa only [Measure.volume_eq_prod, id_eq] using
      (MeasurePreserving.id (volume : Measure
        (aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1)))).prod
        (aux_volume_preserving_prod_swap (volume : Measure ℝ) (volume : Measure ℝ))
  have h2c : MeasurePreserving (MeasurableEquiv.prodAssoc.symm :
      aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × (ℝ × ℝ) ≃ᵐ
        (aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ) × ℝ)
      volume volume := volume_preserving_prodAssoc.symm
  have h2 : MeasurePreserving e2 volume volume := h2c.comp (h2b.comp h2a)
  have heq : aux_doublyCancellativeCSRawFubiniReorder k = e1.trans e2 := by
    apply MeasurableEquiv.ext
    funext p
    dsimp [e1, e2, aux_doublyCancellativeCSRawFubiniReorder]
    rfl
  rw [heq]
  exact h2.comp h1

/--
The unintegrated raw Fubini form on `((y,t,x),q,r)` in the top-dimensional
doubly-cancellative calculation.  Integrating `r` gives the first manuscript
bracket while the remaining scalar `q` stays in the kernel fibre.
-/
def aux_doublyCancellativeCSRawFubiniIntegrand (k : ℕ) (rho : KKernel (k + 1))
    (phi : ℝ → ℝ)
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ) :
    (aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ) × ℝ → ℝ :=
  fun p =>
    rho (p.1.1.1.2 - p.1.1.1.1,
      coordinateSum p.1.1.1.1 + p.1.1.2.1 + coordinateSum p.1.1.2.2 - p.1.2) *
      (phi (p.2 - p.1.1.2.1) *
        aux_singlyCancellativeAProduct (k + 1 + 1) (k + 1) (by omega) (by omega)
          F p.1.1.1 p.2 p.1.1.2.2) *
        (phi p.1.2 *
          aux_singlyCancellativeBProduct (k + 1 + 1) (k + 1) (by omega) (by omega)
            F p.1.1.1 p.1.1.2.2)

/--
Pointwise compatibility of the raw Fubini reassociation with the doubled
base integrand. This is the product splitting immediately before the two
scalar brackets in the manuscript.
-/
theorem aux_doublyCancellativeCSRawFubiniIntegrand_comp_reorder (k : ℕ)
    (rho : KKernel (k + 1)) (phi : ℝ → ℝ)
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ) :
    aux_doublyCancellativeCSRawFubiniIntegrand k rho phi F ∘
      aux_doublyCancellativeCSRawFubiniReorder k =
      aux_doublyCancellativeCSRawBaseIntegrand k rho phi F := by
  funext p
  rcases p with ⟨⟨y, t, r, x⟩, q⟩
  change aux_doublyCancellativeCSRawFubiniIntegrand k rho phi F
    (aux_doublyCancellativeCSRawFubiniReorder k ((y, (t, (r, x))), q)) = _
  rw [aux_doublyCancellativeCSRawFubiniReorder_apply]
  unfold aux_doublyCancellativeCSRawFubiniIntegrand
    aux_doublyCancellativeCSRawBaseIntegrand
  rw [aux_singlyCancellative_product_split (k + 1 + 1) (k + 1)
    (by omega) (by omega) F y r x]
  ring

/--
Absolute integrability of the unintegrated raw Fubini form for the
doubly-cancellative pairing. It is obtained from the established doubled
original-coordinate integrability certificate by the two literal changes of
variables above.
-/
theorem aux_integrable_doublyCancellativeCSRawFubiniIntegrand (k : ℕ)
    (rho : KKernel (k + 1)) (hrho : MemW0 rho) (phi : ℝ → ℝ) (hphi : MemW0 phi)
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ) :
    Integrable (aux_doublyCancellativeCSRawFubiniIntegrand k rho phi F) := by
  have horig := aux_integrable_doublyCancellativeCSOriginalIntegrand
    (k + 1 + 1) (k + 1) (by omega) (by omega) rho hrho phi hphi F
  have hbase : Integrable (aux_doublyCancellativeCSRawBaseIntegrand k rho phi F) := by
    have hcomp :=
      (aux_measurePreserving_doublyCancellativeCSRawBaseChange k).integrable_comp_of_integrable
      horig
    rw [aux_doublyCancellativeCSOriginalIntegrand_comp_rawBaseChange] at hcomp
    exact hcomp
  have hcomp : Integrable (aux_doublyCancellativeCSRawFubiniIntegrand k rho phi F ∘
      aux_doublyCancellativeCSRawFubiniReorder k) := by
    rw [aux_doublyCancellativeCSRawFubiniIntegrand_comp_reorder]
    exact hbase
  have hinv := (aux_measurePreserving_doublyCancellativeCSRawFubiniReorder k).symm
    (aux_doublyCancellativeCSRawFubiniReorder k)
  have htarget := hinv.integrable_comp_of_integrable hcomp
  simpa [Function.comp_def] using htarget

/--
The raw source-side pairing integrand on `((y,t,x),q)` after the first scalar
bracket has been integrated. It is the un-sheared version of display
`\eqref{ncs1}` in Proposition `\ref{doubly cancellative Cauchy-Schwarz}`.
-/
def aux_doublyCancellativeCSRawSourceIntegrand (k : ℕ) (rho : KKernel (k + 1))
    (phi : ℝ → ℝ)
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ) :
    aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ → ℝ := fun p =>
  rho (p.1.1.2 - p.1.1.1,
      coordinateSum p.1.1.1 + p.1.2.1 + coordinateSum p.1.2.2 - p.2) *
    phi p.2 *
    aux_singlyCancellativeCSRawA (k + 1 + 1) (k + 1) (by omega) (by omega) phi F p.1 *
    aux_singlyCancellativeCSRawB (k + 1 + 1) (k + 1) (by omega) (by omega) F p.1

/--
The `r`-fibre integral of the raw Fubini integrand is the source-side raw
pairing integrand.
-/
theorem aux_doublyCancellativeCSRawFubiniIntegral_apply (k : ℕ)
    (rho : KKernel (k + 1)) (phi : ℝ → ℝ)
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ)
    (p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ) :
    (∫ r : ℝ, aux_doublyCancellativeCSRawFubiniIntegrand k rho phi F (p, r)) =
      aux_doublyCancellativeCSRawSourceIntegrand k rho phi F p := by
  unfold aux_doublyCancellativeCSRawFubiniIntegrand
    aux_doublyCancellativeCSRawSourceIntegrand aux_singlyCancellativeCSRawA
    aux_singlyCancellativeCSRawB
  change (∫ r : ℝ,
      rho (p.1.1.2 - p.1.1.1,
        coordinateSum p.1.1.1 + p.1.2.1 + coordinateSum p.1.2.2 - p.2) *
        (phi (r - p.1.2.1) *
          aux_singlyCancellativeAProduct (k + 1 + 1) (k + 1) (by omega) (by omega)
            F p.1.1 r p.1.2.2) *
        (phi p.2 *
          aux_singlyCancellativeBProduct (k + 1 + 1) (k + 1) (by omega) (by omega)
            F p.1.1 p.1.2.2)) = _
  rw [integral_mul_const, integral_const_mul]
  ring

/--
Absolute integrability of the source-side raw pairing integrand. This is the
Fubini certificate used before shearing the inner kernel scalar into the
second bracket.
-/
theorem aux_integrable_doublyCancellativeCSRawSourceIntegrand (k : ℕ)
    (rho : KKernel (k + 1)) (hrho : MemW0 rho) (phi : ℝ → ℝ) (hphi : MemW0 phi)
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ) :
    Integrable (aux_doublyCancellativeCSRawSourceIntegrand k rho phi F) := by
  have hH := aux_integrable_doublyCancellativeCSRawFubiniIntegrand k rho hrho phi hphi F
  have houter := hH.integral_prod_left
  convert houter using 1
  funext p
  exact (aux_doublyCancellativeCSRawFubiniIntegral_apply k rho phi F p).symm

/--
The coordinate sum of the final one-dimensional tail is its unique
coordinate. This auxiliary identity removes the dependent tail notation in
the raw doubly-cancellative pairing shear.
-/
theorem aux_doublyCancellativeCS_coordinateSum_tail (k : ℕ)
    (x : RealVector (k + 1 + 1 - (k + 1))) :
    coordinateSum x = x ⟨0, by omega⟩ := by
  let i0 : Fin (k + 1 + 1 - (k + 1)) := ⟨0, by omega⟩
  let instUnique : Unique (Fin (k + 1 + 1 - (k + 1))) :=
    { default := i0
      uniq := by
        intro i
        apply Fin.ext
        omega }
  let : Unique (Fin (k + 1 + 1 - (k + 1))) := instUnique
  unfold coordinateSum
  rw [Finset.univ_unique]
  simp only [Finset.sum_singleton]
  exact (congrArg x (instUnique.uniq i0)).symm

/--
The first scalar bracket is independent of the one-dimensional final tail.
This is used when the raw pairing shear changes that tail while preserving
the first bracket in the doubly-cancellative argument.
-/
theorem aux_doublyCancellativeCSRawA_tail_independent (k : ℕ) (phi : ℝ → ℝ)
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ)
    (y : RealVector (k + 1) × RealVector (k + 1)) (t : ℝ)
    (x z : RealVector (k + 1 + 1 - (k + 1))) :
    aux_singlyCancellativeCSRawA (k + 1 + 1) (k + 1) (by omega) (by omega) phi F
      (y, (t, x)) =
    aux_singlyCancellativeCSRawA (k + 1 + 1) (k + 1) (by omega) (by omega) phi F
      (y, (t, z)) := by
  unfold aux_singlyCancellativeCSRawA
  apply integral_congr_ae
  filter_upwards [] with r
  apply congrArg (fun q => phi (r - t) * q)
  unfold aux_singlyCancellativeAProduct
  apply Finset.prod_congr rfl
  intro h _
  apply Finset.prod_congr rfl
  intro i _
  congr 1
  unfold prismPoint
  congr 1
  apply funext
  intro l
  let i0 : Fin (k + 1 + 1 - (k + 1)) := ⟨0, by omega⟩
  let l0 : Fin (k + 1 + 1 - (k + 1)) := ⟨0, by omega⟩
  have hi : i = i0 := Fin.ext (by omega)
  have hl : l = l0 := Fin.ext (by omega)
  subst i
  subst l
  let z0 : Fin (k + 1 + 1 - (k + 1) + 1) := ⟨0, by omega⟩
  have hindex : i0.succ.succAbove l0 = z0 := by
    apply Fin.ext
    simp [i0, l0, z0, Fin.succAbove]
  change (Fin.cons r x : RealVector (k + 1 + 1 - (k + 1) + 1))
      (i0.succ.succAbove l0) =
    (Fin.cons r z : RealVector (k + 1 + 1 - (k + 1) + 1))
      (i0.succ.succAbove l0)
  rw [hindex]
  simp [z0]

/--
The target-side unintegrated raw pairing on `((y,t,x),s)`. Integrating `s`
is exactly the second bracket in display `\eqref{ncs1}` of Proposition
`\ref{doubly cancellative Cauchy-Schwarz}`.
-/
def aux_doublyCancellativeCSRawTargetIntegrand (k : ℕ) (rho : KKernel (k + 1))
    (phi : ℝ → ℝ)
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ) :
    aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ → ℝ := fun p =>
  aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) rho p.1 *
    aux_singlyCancellativeCSRawA (k + 1 + 1) (k + 1) (by omega) (by omega) phi F p.1 *
      (phi (p.2 - coordinateSum p.1.2.2) *
        aux_singlyCancellativeBProduct (k + 1 + 1) (k + 1) (by omega) (by omega)
          F p.1.1 (fun _ => p.2))

/--
The scalar fibre integral of the target raw pairing is the product of the
kernel factor and the two scalar brackets in the doubly-cancellative
manuscript calculation.
-/
theorem aux_doublyCancellativeCSRawTargetIntegral_apply (k : ℕ)
    (rho : KKernel (k + 1)) (phi : ℝ → ℝ)
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ)
    (p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1)) :
    (∫ s : ℝ, aux_doublyCancellativeCSRawTargetIntegrand k rho phi F (p, s)) =
      aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) rho p *
        aux_singlyCancellativeCSRawA (k + 1 + 1) (k + 1) (by omega) (by omega) phi F p *
          aux_doublyCancellativeCSRawB k phi F p := by
  unfold aux_doublyCancellativeCSRawTargetIntegrand aux_doublyCancellativeCSRawB
  change (∫ s : ℝ,
      aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) rho p *
        aux_singlyCancellativeCSRawA (k + 1 + 1) (k + 1) (by omega) (by omega) phi F p *
          (phi (s - coordinateSum p.2.2) *
            aux_singlyCancellativeBProduct (k + 1 + 1) (k + 1) (by omega) (by omega)
              F p.1 (fun _ => s))) = _
  rw [integral_const_mul]

/--
The raw pairing shear converts the source-side Fubini integrand into the
target-side pairing integrand. This is the literal change of variables that
creates the second scalar bracket in the doubly-cancellative proof.
-/
theorem aux_doublyCancellativeCSRawTargetIntegrand_comp_shear (k : ℕ)
    (rho : KKernel (k + 1)) (phi : ℝ → ℝ)
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ) :
    aux_doublyCancellativeCSRawTargetIntegrand k rho phi F ∘
      aux_doublyCancellativeRawPairingShear k =
      aux_doublyCancellativeCSRawSourceIntegrand k rho phi F := by
  funext p
  rcases p with ⟨⟨y, ⟨t, x⟩⟩, q⟩
  change aux_doublyCancellativeCSRawTargetIntegrand k rho phi F
    (aux_doublyCancellativeRawPairingShear k ((y, (t, x)), q)) = _
  rw [aux_doublyCancellativeRawPairingShear_apply]
  let i0 : Fin (k + 1 + 1 - (k + 1)) := ⟨0, by omega⟩
  have hsumx : coordinateSum x = x i0 := by
    simpa [i0] using aux_doublyCancellativeCS_coordinateSum_tail k x
  have hsumconst :
      coordinateSum (fun _ : Fin (k + 1 + 1 - (k + 1)) => x i0 - q) = x i0 - q := by
    simpa [i0] using aux_doublyCancellativeCS_coordinateSum_tail k
      (fun _ : Fin (k + 1 + 1 - (k + 1)) => x i0 - q)
  have hxconst : x = fun _ : Fin (k + 1 + 1 - (k + 1)) => x i0 := by
    funext i
    congr 1
    apply Fin.ext
    omega
  have hA := aux_doublyCancellativeCSRawA_tail_independent k phi F y t x
    (fun _ : Fin (k + 1 + 1 - (k + 1)) => x i0 - q)
  unfold aux_doublyCancellativeCSRawTargetIntegrand
    aux_doublyCancellativeCSRawSourceIntegrand aux_singlyCancellativeCSRawR
    aux_singlyCancellativeCSRawB
  rw [hsumx, hsumconst, ← hA, hxconst]
  ring

/--
Absolute integrability of the target-side unintegrated raw pairing. It is
transported from the source-side Fubini certificate by the Haar-preserving
raw pairing shear.
-/
theorem aux_integrable_doublyCancellativeCSRawTargetIntegrand (k : ℕ)
    (rho : KKernel (k + 1)) (hrho : MemW0 rho) (phi : ℝ → ℝ) (hphi : MemW0 phi)
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ) :
    Integrable (aux_doublyCancellativeCSRawTargetIntegrand k rho phi F) := by
  have hsource := aux_integrable_doublyCancellativeCSRawSourceIntegrand
    k rho hrho phi hphi F
  have hinv := (aux_measurePreserving_doublyCancellativeRawPairingShear k).symm
    (aux_doublyCancellativeRawPairingShear k)
  have htarget := hinv.integrable_comp_of_integrable hsource
  have hEq : aux_doublyCancellativeCSRawSourceIntegrand k rho phi F ∘
      ((aux_doublyCancellativeRawPairingShear k).symm :
        aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ →
          aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ) =
      aux_doublyCancellativeCSRawTargetIntegrand k rho phi F := by
    funext p
    have h := congrFun (aux_doublyCancellativeCSRawTargetIntegrand_comp_shear
      k rho phi F) ((aux_doublyCancellativeRawPairingShear k).symm p)
    simpa [Function.comp_def] using h.symm
  rw [hEq] at htarget
  exact htarget

/--
Absolute integrability of the exact raw product in display `\eqref{ncs1}`:
the kernel factor, the first scalar bracket, and the second scalar bracket.
It is the Fubini certificate for the doubly-cancellative raw pairing.
-/
theorem aux_integrable_doublyCancellativeCSRawPairing (k : ℕ)
    (rho : KKernel (k + 1)) (hrho : MemW0 rho) (phi : ℝ → ℝ) (hphi : MemW0 phi)
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ) :
    Integrable (fun p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) =>
      aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) rho p *
        aux_singlyCancellativeCSRawA (k + 1 + 1) (k + 1) (by omega) (by omega)
          phi F p *
          aux_doublyCancellativeCSRawB k phi F p) := by
  have hH := aux_integrable_doublyCancellativeCSRawTargetIntegrand k rho hrho phi hphi F
  have houter := hH.integral_prod_left
  convert houter using 1
  funext p
  exact (aux_doublyCancellativeCSRawTargetIntegral_apply k rho phi F p).symm

/--
Auxiliary expansion of the top-dimensional doubly-cancellative prism form
into integrals of the original-coordinate raw integrand. It isolates the
finite-sum/Fubini rearrangement needed to reach the two Cauchy--Schwarz
brackets.
-/
theorem aux_doublyCancellativeCS_prismForm_expand_original
    (k J : ℕ) (rho : Fin J → KKernel (k + 1))
    (phi : Fin J → ℝ → ℝ) (hrho : ∀ j, MemW0 (rho j))
    (hphi : ∀ j, MemW0 (phi j))
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ) :
    prismBrascampLiebForm (k + 1 + 1) (k + 1) (by omega) (by omega)
      (doublyCancellativeKernel (k + 1 + 1) J rho phi) (fun i x => F i x) =
      ∑ j, ∫ p : aux_doublyCancellativeCSOriginalSpace (k + 1 + 1) (k + 1),
        aux_doublyCancellativeCSOriginalIntegrand (k + 1 + 1) (k + 1)
          (by omega) (by omega) (rho j) (phi j) F p := by
  classical
  let P : (RealVector (k + 1) × RealVector (k + 1)) →
      RealVector (k + 1 + 1 - (k + 1) + 1) → ℝ := fun y x =>
    ∏ h : Fin (k + 1) → Fin 2, ∏ i : Fin (k + 1 + 1 - (k + 1) + 1),
      F (prismIndex (by omega) (by omega) i)
        (prismPoint (by omega) (by omega) y x h i)
  let H : Fin J → aux_doublyCancellativeCSOriginalSpace (k + 1 + 1) (k + 1) → ℝ :=
    fun j p => aux_doublyCancellativeCSOriginalIntegrand (k + 1 + 1) (k + 1)
      (by omega) (by omega) (rho j) (phi j) F p
  have hH (j : Fin J) : Integrable (H j) := by
    simpa [H] using aux_integrable_doublyCancellativeCSOriginalIntegrand
      (k + 1 + 1) (k + 1) (by omega) (by omega) (rho j) (hrho j)
        (phi j) (hphi j) F
  let Q : Fin J → (RealVector (k + 1) × RealVector (k + 1)) ×
      RealVector (k + 1 + 1 - (k + 1) + 1) → ℝ := fun j yx =>
    ∫ r : ℝ, ∫ s : ℝ, H j ((yx, r), s)
  have hQ (j : Fin J) : Integrable (Q j) := by
    simpa [Q] using ((hH j).integral_prod_left).integral_prod_left
  have hQsum : Integrable (fun yx : (RealVector (k + 1) × RealVector (k + 1)) ×
      RealVector (k + 1 + 1 - (k + 1) + 1) => ∑ j, Q j yx) :=
    integrable_finsetSum Finset.univ (fun j _ => hQ j)
  have hQ_apply (j : Fin J) (y : RealVector (k + 1) × RealVector (k + 1))
      (x : RealVector (k + 1 + 1 - (k + 1) + 1)) :
      Q j (y, x) =
        (∫ r : ℝ, ∫ s : ℝ,
          rho j (y.2 - y.1, coordinateSum y.1 + coordinateSum x - r - s) *
            phi j r * phi j s) * P y x := by
    change (∫ r : ℝ, ∫ s : ℝ, H j (((y, x), r), s)) = _
    change (∫ r : ℝ, ∫ s : ℝ,
      (rho j (y.2 - y.1, coordinateSum y.1 + coordinateSum x - r - s) *
        phi j r * phi j s) * P y x) = _
    calc
      (∫ r : ℝ, ∫ s : ℝ,
        (rho j (y.2 - y.1, coordinateSum y.1 + coordinateSum x - r - s) *
          phi j r * phi j s) * P y x) =
          ∫ r : ℝ, (∫ s : ℝ,
            rho j (y.2 - y.1, coordinateSum y.1 + coordinateSum x - r - s) *
              phi j r * phi j s) * P y x := by
            apply integral_congr_ae
            filter_upwards [] with r
            exact integral_mul_const (P y x) _
      _ = _ := integral_mul_const (P y x) _
  unfold prismBrascampLiebForm doublyCancellativeKernel
  change (∫ y : RealVector (k + 1) × RealVector (k + 1),
      ∫ x : RealVector (k + 1 + 1 - (k + 1) + 1),
        (∑ j, ∫ r : ℝ, ∫ s : ℝ,
          rho j (y.2 - y.1, coordinateSum y.1 + coordinateSum x - r - s) *
            phi j r * phi j s) * P y x) = _
  calc
    (∫ y : RealVector (k + 1) × RealVector (k + 1),
      ∫ x : RealVector (k + 1 + 1 - (k + 1) + 1),
        (∑ j, ∫ r : ℝ, ∫ s : ℝ,
          rho j (y.2 - y.1, coordinateSum y.1 + coordinateSum x - r - s) *
            phi j r * phi j s) * P y x) =
        ∫ y : RealVector (k + 1) × RealVector (k + 1),
          ∫ x : RealVector (k + 1 + 1 - (k + 1) + 1), ∑ j, Q j (y, x) := by
            apply integral_congr_ae
            filter_upwards [] with y
            apply integral_congr_ae
            filter_upwards [] with x
            rw [Finset.sum_mul]
            apply Finset.sum_congr rfl
            intro j _
            rw [hQ_apply]
    _ = ∫ yx : (RealVector (k + 1) × RealVector (k + 1)) ×
        RealVector (k + 1 + 1 - (k + 1) + 1), ∑ j, Q j yx := by
          simpa only [Measure.volume_eq_prod] using
            (integral_prod (fun yx : (RealVector (k + 1) × RealVector (k + 1)) ×
              RealVector (k + 1 + 1 - (k + 1) + 1) => ∑ j, Q j yx) hQsum).symm
    _ = ∑ j, ∫ yx : (RealVector (k + 1) × RealVector (k + 1)) ×
        RealVector (k + 1 + 1 - (k + 1) + 1), Q j yx :=
          integral_finsetSum Finset.univ (fun j _ => hQ j)
    _ = ∑ j, ∫ p : ((RealVector (k + 1) × RealVector (k + 1)) ×
        RealVector (k + 1 + 1 - (k + 1) + 1)) × ℝ,
          ∫ s : ℝ, H j (p, s) := by
          apply Finset.sum_congr rfl
          intro j _
          simpa only [Measure.volume_eq_prod] using
            (integral_prod (fun p : ((RealVector (k + 1) × RealVector (k + 1)) ×
              RealVector (k + 1 + 1 - (k + 1) + 1)) × ℝ =>
                ∫ s : ℝ, H j (p, s)) ((hH j).integral_prod_left)).symm
    _ = ∑ j, ∫ p : aux_doublyCancellativeCSOriginalSpace (k + 1 + 1) (k + 1),
        H j p := by
          apply Finset.sum_congr rfl
          intro j _
          simpa only [Measure.volume_eq_prod] using (integral_prod (H j) (hH j)).symm
    _ = _ := by rfl

/--
Auxiliary Haar change of variables from the original-coordinate integrand to
the raw base integrand used in the top-dimensional Fubini expansion.
-/
theorem aux_doublyCancellativeCS_originalIntegral_eq_rawBaseIntegral (k : ℕ)
    (rho : KKernel (k + 1)) (phi : ℝ → ℝ)
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ)
    (hmeas : AEStronglyMeasurable
      (aux_doublyCancellativeCSOriginalIntegrand (k + 1 + 1) (k + 1)
        (by omega) (by omega) rho phi F) volume) :
    (∫ p : aux_doublyCancellativeCSOriginalSpace (k + 1 + 1) (k + 1),
      aux_doublyCancellativeCSOriginalIntegrand (k + 1 + 1) (k + 1)
        (by omega) (by omega) rho phi F p) =
      ∫ p : aux_doublyCancellativeCSRawBaseSpace k × ℝ,
        aux_doublyCancellativeCSRawBaseIntegrand k rho phi F p := by
  have hmp : MeasurePreserving (aux_doublyCancellativeCSRawBaseChange k)
      (volume : Measure (aux_doublyCancellativeCSRawBaseSpace k × ℝ))
      (volume : Measure (aux_doublyCancellativeCSOriginalSpace (k + 1 + 1) (k + 1))) :=
    aux_measurePreserving_doublyCancellativeCSRawBaseChange k
  have hchange := MeasureTheory.integral_map hmp.measurable.aemeasurable
    (show AEStronglyMeasurable
      (aux_doublyCancellativeCSOriginalIntegrand (k + 1 + 1) (k + 1)
        (by omega) (by omega) rho phi F)
      (Measure.map (aux_doublyCancellativeCSRawBaseChange k) volume) by
        simpa [hmp.map_eq] using hmeas)
  rw [hmp.map_eq] at hchange
  calc
    (∫ p : aux_doublyCancellativeCSOriginalSpace (k + 1 + 1) (k + 1),
      aux_doublyCancellativeCSOriginalIntegrand (k + 1 + 1) (k + 1)
        (by omega) (by omega) rho phi F p) =
      ∫ p : aux_doublyCancellativeCSRawBaseSpace k × ℝ,
        aux_doublyCancellativeCSOriginalIntegrand (k + 1 + 1) (k + 1)
          (by omega) (by omega) rho phi F (aux_doublyCancellativeCSRawBaseChange k p) := by
          simpa [aux_doublyCancellativeCSRawBaseChange] using hchange
    _ = _ := by
      apply integral_congr_ae
      filter_upwards [] with p
      exact congrFun
        (aux_doublyCancellativeCSOriginalIntegrand_comp_rawBaseChange k rho phi F) p

/--
Auxiliary Fubini reassociation from raw base variables to the source-side raw
pairing integrand. It records the exact integral identity before the final
Haar shear.
-/
theorem aux_doublyCancellativeCS_rawBaseIntegral_eq_rawSourceIntegral (k : ℕ)
    (rho : KKernel (k + 1)) (hrho : MemW0 rho) (phi : ℝ → ℝ)
    (hphi : MemW0 phi)
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ) :
    (∫ p : aux_doublyCancellativeCSRawBaseSpace k × ℝ,
      aux_doublyCancellativeCSRawBaseIntegrand k rho phi F p) =
      ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ,
        aux_doublyCancellativeCSRawSourceIntegrand k rho phi F p := by
  let H := aux_doublyCancellativeCSRawFubiniIntegrand k rho phi F
  have hH : Integrable H := by
    dsimp [H]
    exact aux_integrable_doublyCancellativeCSRawFubiniIntegrand k rho hrho phi hphi F
  calc
    (∫ p : aux_doublyCancellativeCSRawBaseSpace k × ℝ,
      aux_doublyCancellativeCSRawBaseIntegrand k rho phi F p) =
        ∫ p : aux_doublyCancellativeCSRawBaseSpace k × ℝ,
          H (aux_doublyCancellativeCSRawFubiniReorder k p) := by
            apply integral_congr_ae
            filter_upwards [] with p
            exact congrFun
              (aux_doublyCancellativeCSRawFubiniIntegrand_comp_reorder k rho phi F).symm p
    _ = ∫ q : (aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ) × ℝ,
        H q :=
      (aux_measurePreserving_doublyCancellativeCSRawFubiniReorder k).integral_comp' H
    _ = ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ,
        ∫ r : ℝ, H (p, r) := by
          simpa only [Measure.volume_eq_prod] using (integral_prod H hH)
    _ = ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ,
        aux_doublyCancellativeCSRawSourceIntegrand k rho phi F p := by
          apply integral_congr_ae
          filter_upwards [] with p
          exact aux_doublyCancellativeCSRawFubiniIntegral_apply k rho phi F p

/--
Auxiliary Haar-shear transport from the source-side raw integral to the exact
raw pairing of the two scalar brackets in the doubly-cancellative argument.
-/
theorem aux_doublyCancellativeCS_rawSourceIntegral_eq_rawPairing (k : ℕ)
    (rho : KKernel (k + 1)) (hrho : MemW0 rho) (phi : ℝ → ℝ)
    (hphi : MemW0 phi)
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ) :
    (∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ,
      aux_doublyCancellativeCSRawSourceIntegrand k rho phi F p) =
      ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1),
        aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) rho p *
          aux_singlyCancellativeCSRawA (k + 1 + 1) (k + 1) (by omega) (by omega)
            phi F p * aux_doublyCancellativeCSRawB k phi F p := by
  let H := aux_doublyCancellativeCSRawTargetIntegrand k rho phi F
  have hH : Integrable H := by
    dsimp [H]
    exact aux_integrable_doublyCancellativeCSRawTargetIntegrand k rho hrho phi hphi F
  calc
    (∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ,
      aux_doublyCancellativeCSRawSourceIntegrand k rho phi F p) =
        ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ,
          H (aux_doublyCancellativeRawPairingShear k p) := by
            apply integral_congr_ae
            filter_upwards [] with p
            simpa [H, Function.comp_def] using
              (congrFun (aux_doublyCancellativeCSRawTargetIntegrand_comp_shear k rho phi F) p).symm
    _ = ∫ q : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ, H q :=
      (aux_measurePreserving_doublyCancellativeRawPairingShear k).integral_comp' H
    _ = ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1),
        ∫ s : ℝ, H (p, s) := by
          simpa only [Measure.volume_eq_prod] using (integral_prod H hH)
    _ = _ := by
      apply integral_congr_ae
      filter_upwards [] with p
      exact aux_doublyCancellativeCSRawTargetIntegral_apply k rho phi F p

/--
Auxiliary complete raw pairing identity for the top-dimensional
doubly-cancellative Cauchy--Schwarz calculation. It is used to apply the
finite weighted Cauchy--Schwarz estimate to the exact manuscript integrand.
-/
theorem aux_doublyCancellativeCS_prismForm_eq_rawPairing
    (k J : ℕ) (rho : Fin J → KKernel (k + 1))
    (phi : Fin J → ℝ → ℝ) (hrho : ∀ j, MemW0 (rho j))
    (hphi : ∀ j, MemW0 (phi j))
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ) :
    prismBrascampLiebForm (k + 1 + 1) (k + 1) (by omega) (by omega)
      (doublyCancellativeKernel (k + 1 + 1) J rho phi) (fun i x => F i x) =
      ∑ j, ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1),
        aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) (rho j) p *
          aux_singlyCancellativeCSRawA (k + 1 + 1) (k + 1) (by omega) (by omega)
            (phi j) F p * aux_doublyCancellativeCSRawB k (phi j) F p := by
  rw [aux_doublyCancellativeCS_prismForm_expand_original k J rho phi hrho hphi F]
  apply Finset.sum_congr rfl
  intro j _
  calc
    (∫ p : aux_doublyCancellativeCSOriginalSpace (k + 1 + 1) (k + 1),
      aux_doublyCancellativeCSOriginalIntegrand (k + 1 + 1) (k + 1)
        (by omega) (by omega) (rho j) (phi j) F p) =
        ∫ p : aux_doublyCancellativeCSRawBaseSpace k × ℝ,
          aux_doublyCancellativeCSRawBaseIntegrand k (rho j) (phi j) F p :=
      aux_doublyCancellativeCS_originalIntegral_eq_rawBaseIntegral k (rho j) (phi j) F
        (aux_measurable_doublyCancellativeCSOriginalIntegrand
          (k + 1 + 1) (k + 1) (by omega) (by omega) (rho j) (hrho j)
            (phi j) (hphi j) F).aestronglyMeasurable
    _ = ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1) × ℝ,
        aux_doublyCancellativeCSRawSourceIntegrand k (rho j) (phi j) F p :=
      aux_doublyCancellativeCS_rawBaseIntegral_eq_rawSourceIntegral k (rho j) (hrho j)
        (phi j) (hphi j) F
    _ = ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1),
        aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) (rho j) p *
          aux_singlyCancellativeCSRawA (k + 1 + 1) (k + 1) (by omega) (by omega)
            (phi j) F p * aux_doublyCancellativeCSRawB k (phi j) F p :=
      aux_doublyCancellativeCS_rawSourceIntegral_eq_rawPairing k (rho j) (hrho j)
        (phi j) (hphi j) F

/--
Auxiliary successor-normalized proof of Proposition
`\ref{doubly cancellative Cauchy-Schwarz}`.  It isolates the `n = k + 2`
coordinate normalization used by `doublyCancellativeCauchySchwarz_bound`.
-/
theorem aux_doublyCancellativeCauchySchwarz_bound_succSucc
    (k J : ℕ) (hJ : 1 ≤ J) (rho : Fin J → KKernel (k + 1))
    (phi : Fin J → ℝ → ℝ) (hrho : ∀ j, MemW0 (rho j))
    (hphi : ∀ j, MemW0 (phi j))
    (F : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ)
    (hF : F ∈ normalizedFunctionTuples (k + 1 + 1)) :
    |prismBrascampLiebForm (k + 1 + 1) (k + 1) (by omega) (by omega)
      (doublyCancellativeKernel (k + 1 + 1) J rho phi) (fun i x => F i x)| ≤
      sSup (Set.range (fun G : NormalizedFunctionTuple (k + 1 + 1) =>
        |prismBrascampLiebForm (k + 1 + 1) (k + 1 + 1) (by omega) le_rfl
          (doublyCancellativeLift (k + 1 + 1) J (by omega) rho phi)
          (fun i x => G.1 i x)|)) := by
  let IA : ℝ := ∑ j, ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1),
    |Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) (rho j) p| *
      aux_singlyCancellativeCSRawA (k + 1 + 1) (k + 1) (by omega) (by omega)
        (phi j) F p| ^ (2 : ℝ)
  let IB : ℝ := ∑ j, ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1),
    |Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) (rho j) p| *
      aux_doublyCancellativeCSRawB k (phi j) F p| ^ (2 : ℝ)
  let Fswap : Fin (k + 1 + 1) → SchwartzMap (RealVector (k + 1 + 1)) ℝ :=
    fun i => F (Equiv.swap (⟨k, by omega⟩ : Fin (k + 1 + 1))
      (⟨k + 1, by omega⟩ : Fin (k + 1 + 1)) i)
  let a : NormalizedFunctionTuple (k + 1 + 1) := ⟨F, hF⟩
  have hFswap : Fswap ∈ normalizedFunctionTuples (k + 1 + 1) := by
    dsimp [Fswap]
    exact aux_normalizedFunctionTuples_swap_lastTwo (k + 1 + 1) (by omega) F hF
  let b : NormalizedFunctionTuple (k + 1 + 1) := ⟨Fswap, hFswap⟩
  let f : NormalizedFunctionTuple (k + 1 + 1) → ℝ := fun G =>
    |prismBrascampLiebForm (k + 1 + 1) (k + 1 + 1) (by omega) le_rfl
      (doublyCancellativeLift (k + 1 + 1) J (by omega) rho phi)
      (fun i x => G.1 i x)|
  let M : ℝ := sSup (Set.range f)
  have hA (j : Fin J) : MemLp (fun p : aux_singlyCancellativeCSPairingSpace
      (k + 1 + 1) (k + 1) =>
      Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) (rho j) p| *
        aux_singlyCancellativeCSRawA (k + 1 + 1) (k + 1) (by omega) (by omega)
          (phi j) F p) 2 volume :=
    aux_memLp_singlyCancellativeCSRawA (k + 1) 0 (by omega) (rho j) (hrho j)
      (phi j) (hphi j) F
  have hB (j : Fin J) : MemLp (fun p : aux_singlyCancellativeCSPairingSpace
      (k + 1 + 1) (k + 1) =>
      Real.sqrt |aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) (rho j) p| *
        aux_doublyCancellativeCSRawB k (phi j) F p) 2 volume :=
    aux_memLp_doublyCancellativeCSRawB k (rho j) (hrho j) (phi j) (hphi j) F
  have hcs :
      |∑ j, ∫ p : aux_singlyCancellativeCSPairingSpace (k + 1 + 1) (k + 1),
        aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) (rho j) p *
          aux_singlyCancellativeCSRawA (k + 1 + 1) (k + 1) (by omega) (by omega)
            (phi j) F p * aux_doublyCancellativeCSRawB k (phi j) F p| ^ 2 ≤ IA * IB := by
    dsimp [IA, IB]
    exact aux_finite_weightedCauchySchwarz_indexed volume J
      (fun j => aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) (rho j))
      (fun j p => |aux_singlyCancellativeCSRawR (k + 1 + 1) (k + 1) (rho j) p|)
      (fun j => aux_singlyCancellativeCSRawA (k + 1 + 1) (k + 1) (by omega) (by omega)
        (phi j) F)
      (fun j => aux_doublyCancellativeCSRawB k (phi j) F)
      (fun _ _ => abs_nonneg _) (fun _ _ => le_rfl) hA hB
      (fun j => aux_integrable_doublyCancellativeCSRawPairing k (rho j) (hrho j)
        (phi j) (hphi j) F)
  have hIA_nonneg : 0 ≤ IA := by
    dsimp [IA]
    apply Finset.sum_nonneg
    intro j _
    apply integral_nonneg
    intro p
    exact Real.rpow_nonneg (abs_nonneg _) _
  have hIB_nonneg : 0 ≤ IB := by
    dsimp [IB]
    apply Finset.sum_nonneg
    intro j _
    apply integral_nonneg
    intro p
    exact Real.rpow_nonneg (abs_nonneg _) _
  have hIAform : IA =
      prismBrascampLiebForm (k + 1 + 1) (k + 1 + 1) (by omega) (by omega)
        (doublyCancellativeLift (k + 1 + 1) J (by omega) rho phi)
        (fun i x => F i x) := by
    dsimp [IA]
    rw [aux_doublyCancellativeLift_eq_singlyCancellativeLift]
    simpa using aux_singlyCancellativeA2_eq_liftPrism (k + 1) 0 J hJ (by omega)
      rho phi hrho hphi F
  have hIBform : IB =
      prismBrascampLiebForm (k + 1 + 1) (k + 1 + 1) (by omega) (by omega)
        (doublyCancellativeLift (k + 1 + 1) J (by omega) rho phi)
        (fun i x => Fswap i x) := by
    dsimp [IB, Fswap]
    simpa using aux_doublyCancellativeCSRawB2_eq_liftPrism k J hJ rho phi hrho hphi F
  have hIAeq : IA = f a := by
    dsimp [f, a]
    calc
      IA = prismBrascampLiebForm (k + 1 + 1) (k + 1 + 1) (by omega) (by omega)
          (doublyCancellativeLift (k + 1 + 1) J (by omega) rho phi)
          (fun i x => F i x) := hIAform
      _ = |prismBrascampLiebForm (k + 1 + 1) (k + 1 + 1) (by omega) le_rfl
          (doublyCancellativeLift (k + 1 + 1) J (by omega) rho phi)
          (fun i x => F i x)| := by
            apply (abs_of_nonneg _).symm
            rw [← hIAform]
            exact hIA_nonneg
  have hIBeq : IB = f b := by
    dsimp [f, b]
    calc
      IB = prismBrascampLiebForm (k + 1 + 1) (k + 1 + 1) (by omega) (by omega)
          (doublyCancellativeLift (k + 1 + 1) J (by omega) rho phi)
          (fun i x => Fswap i x) := hIBform
      _ = |prismBrascampLiebForm (k + 1 + 1) (k + 1 + 1) (by omega) le_rfl
          (doublyCancellativeLift (k + 1 + 1) J (by omega) rho phi)
          (fun i x => Fswap i x)| := by
            apply (abs_of_nonneg _).symm
            rw [← hIBform]
            exact hIB_nonneg
  have hBdd : BddAbove (Set.range f) := by
    dsimp [f]
    exact aux_bddAbove_doublyCancellativeLift_prismForms (k + 1 + 1) J
      (by omega) hJ rho phi hrho hphi
  have hraw :
      |prismBrascampLiebForm (k + 1 + 1) (k + 1) (by omega) (by omega)
        (doublyCancellativeKernel (k + 1 + 1) J rho phi) (fun i x => F i x)| ^ 2 ≤ IA * IB := by
    rw [aux_doublyCancellativeCS_prismForm_eq_rawPairing k J rho phi hrho hphi F]
    exact hcs
  have hA_le : IA ≤ M := by
    rw [hIAeq]
    dsimp [M]
    exact le_csSup hBdd ⟨a, rfl⟩
  have hB_le : IB ≤ M := by
    rw [hIBeq]
    dsimp [M]
    exact le_csSup hBdd ⟨b, rfl⟩
  have hM_nonneg : 0 ≤ M := hIA_nonneg.trans hA_le
  have hprod : IA * IB ≤ M * M := by
    calc
      IA * IB ≤ M * IB := mul_le_mul_of_nonneg_right hA_le hIB_nonneg
      _ ≤ M * M := mul_le_mul_of_nonneg_left hB_le hM_nonneg
  have hsquared :
      |prismBrascampLiebForm (k + 1 + 1) (k + 1) (by omega) (by omega)
        (doublyCancellativeKernel (k + 1 + 1) J rho phi) (fun i x => F i x)| ^ 2 ≤ M ^ 2 := by
    simpa [pow_two] using hraw.trans hprod
  change |prismBrascampLiebForm (k + 1 + 1) (k + 1) (by omega) (by omega)
      (doublyCancellativeKernel (k + 1 + 1) J rho phi) (fun i x => F i x)| ≤ M
  exact (sq_le_sq₀ (abs_nonneg _) hM_nonneg).mp hsquared

/--
For all $\F\in\mathfrak{F}$,
\begin{equation}
    |\Theta_{n-1}(K)(\F)| \le \sup_{\mathbf{\tilde{F}}\in\mathfrak{F}}
    |\Theta_{n}(\tilde{K})(\mathbf{\tilde{F}})|.
\end{equation}
-/
theorem doublyCancellativeCauchySchwarz_bound
    (n J : ℕ) (hn : 2 ≤ n) (hJ : 1 ≤ J)
    (rho : Fin J → KKernel (n - 1)) (phi : Fin J → ℝ → ℝ)
    (hrho : ∀ j, MemW0 (rho j)) (hphi : ∀ j, MemW0 (phi j))
    (F : Fin n → SchwartzMap (RealVector n) ℝ)
    (hF : F ∈ normalizedFunctionTuples n) :
    |prismBrascampLiebForm n (n - 1) (by omega) (by omega)
      (doublyCancellativeKernel n J rho phi) (fun i x => F i x)| ≤
      sSup (Set.range (fun G : NormalizedFunctionTuple n =>
        |prismBrascampLiebForm n n (by omega) le_rfl
          (doublyCancellativeLift n J (by omega) rho phi)
          (fun i x => G.1 i x)|)) := by
  cases n with
  | zero => omega
  | succ n =>
    cases n with
    | zero => omega
    | succ k =>
      simpa only [Nat.succ_sub_one] using
        aux_doublyCancellativeCauchySchwarz_bound_succSucc k J hJ rho phi hrho hphi F hF

/--
Auxiliary continuous linear splitting of an arbitrary coordinate from a real
finite vector.  It realizes the manuscript's notation
`u_{[k+1)\setminus i}` together with the removed coordinate `u_i`.
-/
noncomputable def aux_eraseCoordinateSplit (k : ℕ) (i : Fin (k + 1)) :
    RealVector (k + 1) ≃L[ℝ] (RealVector k × ℝ) where
  toFun x := (eraseVector i x, x i)
  invFun p := i.insertNth p.2 p.1
  left_inv x := by
    funext j
    refine i.succAboveCases ?_ (fun l => ?_) j
    · simp
    · simp [eraseVector]
  right_inv p := by
    apply Prod.ext
    · funext l
      simp [eraseVector]
    · simp
  map_add' x y := by
    apply Prod.ext
    · funext l
      simp [eraseVector]
    · simp
  map_smul' c x := by
    apply Prod.ext
    · funext l
      simp [eraseVector]
    · simp
  continuous_toFun := by
    exact (continuous_pi fun l => continuous_apply (i.succAbove l)).prodMk
      (continuous_apply i)
  continuous_invFun := by
    apply continuous_pi
    intro j
    refine i.succAboveCases ?_ (fun l => ?_) j
    · simpa [Fin.succAboveCases] using
        (continuous_snd : Continuous (fun p : RealVector k × ℝ => p.2))
    · have hcoord : Continuous (fun p : RealVector k × ℝ => p.1 l) :=
        (continuous_apply (A := fun _ : Fin k => ℝ) l).comp continuous_fst
      simpa [Fin.succAboveCases, Function.comp_apply] using hcoord

/--
The coordinate splitting `aux_eraseCoordinateSplit` is Haar preserving.  This
is the coordinate-permutation step used to isolate the distinguished cube
coordinate in the positivity and monotonicity arguments.
-/
theorem aux_measurePreserving_eraseCoordinateSplit (k : ℕ) (i : Fin (k + 1)) :
    MeasurePreserving (aux_eraseCoordinateSplit k i) volume volume := by
  have hsplit : MeasurePreserving
      (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (k + 1) => ℝ) i)
      (volume : Measure (RealVector (k + 1))) volume := by
    simpa using
      (volume_preserving_piFinSuccAbove (fun _ : Fin (k + 1) => ℝ) i)
  have hswap : MeasurePreserving
      (Prod.swap : ℝ × RealVector k → RealVector k × ℝ) volume volume := by
    simpa only [Measure.volume_eq_prod] using
      (aux_volume_preserving_prod_swap (volume : Measure ℝ)
        (volume : Measure (RealVector k)))
  convert hswap.comp hsplit using 1
  funext x
  rfl

/--
Auxiliary affine coordinate equivalence for the positivity-kernel fibre
integral, obtained by splitting the coordinate selected by `i` and applying
the scalar shear already used for the lifted kernel.
-/
noncomputable def aux_positivityKernelShear (k : ℕ) (i : Fin (k + 1)) :
    ((RealVector (k + 1) × ℝ) × ℝ) ≃L[ℝ]
      (((RealVector k × ℝ) × ℝ) × ℝ) :=
  (((aux_eraseCoordinateSplit k i).prodCongr (ContinuousLinearEquiv.refl ℝ ℝ)).prodCongr
    (ContinuousLinearEquiv.refl ℝ ℝ)).trans (aux_singlyCancellativeLiftScalarShear k)

/-- The literal coordinate formula for the positivity-kernel affine shear. -/
theorem aux_positivityKernelShear_apply (k : ℕ) (i : Fin (k + 1))
    (u : RealVector (k + 1) × ℝ) (q : ℝ) :
    aux_positivityKernelShear k i (u, q) =
      (((eraseVector i u.1, u.2 - q), u.1 i + q), q) := by
  simp [aux_positivityKernelShear, aux_eraseCoordinateSplit,
    aux_singlyCancellativeLiftScalarShear]
  constructor <;> rfl

/-- Auxiliary kernel definition for Proposition \ref{Positivity K}; see
`positivityKernel_nonnegative`. -/
def positivityKernel (k : ℕ) (rho : KKernel k) (phi : ℝ → ℝ) (i : Fin (k + 1)) :
    KKernel (k + 1) :=
  fun u => ∫ q : ℝ,
    rho (eraseVector i u.1, u.2 - q) * phi (u.1 i + q) * phi q

/--
Auxiliary unintegrated kernel in the positivity argument.  It records the
literal `(u,q)` integrand before its scalar fibre is integrated, so that the
Fubini rearrangement proving positivity has an explicit integrable function.
-/
def aux_positivityExpandedKernel (k : ℕ) (rho : KKernel k) (phi : ℝ → ℝ)
    (i : Fin (k + 1)) : ((RealVector (k + 1) × ℝ) × ℝ) → ℝ := fun p =>
  rho (eraseVector i p.1.1, p.1.2 - p.2) * phi (p.1.1 i + p.2) * phi p.2

/--
The unintegrated positivity kernel belongs to `W₀`.  This is the tensor
product `\rho\otimes\phi\otimes\phi` transported by the affine shear used
in the manuscript's positivity proof.
-/
theorem aux_memW0_positivityExpandedKernel (k : ℕ) (rho : KKernel k)
    (hrho : MemW0 rho) (phi : ℝ → ℝ) (hphi : MemW0 phi) (i : Fin (k + 1)) :
    MemW0 (aux_positivityExpandedKernel k rho phi i) := by
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k)) :=
    isAddHaarMeasure_volume_pi (Fin k)
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector (k + 1))) :=
    isAddHaarMeasure_volume_pi (Fin (k + 1))
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure (volume : Measure ((RealVector k × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure (((RealVector k × ℝ) × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector (k + 1) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure ((RealVector (k + 1) × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let G : ((RealVector k × ℝ) × ℝ) → ℝ := fun p => rho p.1 * phi p.2
  have hG : MemW0 G := by
    simpa [G] using hrho.aux_mul_prod hphi
  let H : (((RealVector k × ℝ) × ℝ) × ℝ) → ℝ := fun p => G p.1 * phi p.2
  have hH : MemW0 H := by
    simpa [H] using hG.aux_mul_prod hphi
  have hHs : MemW0 (H ∘ aux_positivityKernelShear k i) :=
    aux_memW0_comp_continuousLinearEquiv hH (aux_positivityKernelShear k i)
  have hEq : aux_positivityExpandedKernel k rho phi i =
      H ∘ aux_positivityKernelShear k i := by
    funext p
    rcases p with ⟨u, q⟩
    simp [aux_positivityExpandedKernel, H, G,
      aux_positivityKernelShear_apply]
  rw [hEq]
  exact hHs

/--
Auxiliary `W₀` closure for the kernel in the positivity proposition.  It is a
coordinate-fibre integral of `\rho\otimes\phi\otimes\phi` after the explicit
affine shear `aux_positivityKernelShear`.
-/
theorem aux_memW0_positivityKernel (k : ℕ) (rho : KKernel k) (hrho : MemW0 rho)
    (phi : ℝ → ℝ) (hphi : MemW0 phi) (i : Fin (k + 1)) :
    MemW0 (positivityKernel k rho phi i) := by
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k)) :=
    isAddHaarMeasure_volume_pi (Fin k)
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector (k + 1))) :=
    isAddHaarMeasure_volume_pi (Fin (k + 1))
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure (volume : Measure ((RealVector k × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure (((RealVector k × ℝ) × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector (k + 1) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure ((RealVector (k + 1) × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let G : ((RealVector k × ℝ) × ℝ) → ℝ := fun p => rho p.1 * phi p.2
  have hG : MemW0 G := by
    simpa [G] using hrho.aux_mul_prod hphi
  let H : (((RealVector k × ℝ) × ℝ) × ℝ) → ℝ := fun p => G p.1 * phi p.2
  have hH : MemW0 H := by
    simpa [H] using hG.aux_mul_prod hphi
  have hHs : MemW0 (H ∘ aux_positivityKernelShear k i) :=
    aux_memW0_comp_continuousLinearEquiv hH (aux_positivityKernelShear k i)
  have hI := aux_memW0_integral_slice_of_addHaar hHs
  change MemW0 (fun u : RealVector (k + 1) × ℝ => ∫ q : ℝ,
    rho (eraseVector i u.1, u.2 - q) * phi (u.1 i + q) * phi q)
  simpa [H, G, Function.comp_def, aux_positivityKernelShear_apply] using hI

/--
\begin{proposition}[Positivity]\label{Positivity K}
 Let $1\le k\le n-1$. Let $\rho\in W_0(\R^{k+1})$ be non-negative and
$\phi\in W_0(\R)$. Set for $u\in\R^{k+2}$ and $i\in [k+1)$
\begin{equation}
    K(u):=\int_\R
    \rho(u_{[k+1)\setminus i}, u_{k+1}-q) \phi(u_i+q) \phi(q) \, dq .
\end{equation}
Then $K\in W_0(\R^{k+2})$.
\end{proposition}
-/
theorem positivityKernel_memW0 (n k : ℕ) (_hk : 1 ≤ k) (_hkn : k + 1 ≤ n)
    (rho : KKernel k) (hrho : MemW0 rho) (_hrho_nonneg : ∀ u, 0 ≤ rho u)
    (phi : ℝ → ℝ) (hphi : MemW0 phi) (i : Fin (k + 1)) :
    MemW0 (positivityKernel k rho phi i) :=
  aux_memW0_positivityKernel k rho hrho phi hphi i

/--
Auxiliary permutation of the first `k + 1` coordinates which moves the
distinguished coordinate `i` to the final coordinate while preserving the
order of all remaining coordinates.  It transports the arbitrary-coordinate
positivity kernel to the final-coordinate form used by the square identity.
-/
noncomputable def aux_positivityIndexPerm (k : ℕ) (i : Fin (k + 1)) :
    Fin (k + 1) ≃ Fin (k + 1) :=
  (finSuccEquiv' i).trans (finSuccEquiv' (Fin.last k)).symm

/-- Auxiliary formula saying that `aux_positivityIndexPerm` sends `i` to the last index. -/
theorem aux_positivityIndexPerm_apply_self (k : ℕ) (i : Fin (k + 1)) :
    aux_positivityIndexPerm k i i = Fin.last k := by
  simp [aux_positivityIndexPerm]

/--
Auxiliary formula for the remaining coordinates of `aux_positivityIndexPerm`;
it is used to preserve the literal erased vector in the kernel.
-/
theorem aux_positivityIndexPerm_apply_succAbove (k : ℕ) (i : Fin (k + 1))
    (j : Fin k) : aux_positivityIndexPerm k i (i.succAbove j) = j.castSucc := by
  simp [aux_positivityIndexPerm]

/--
Auxiliary continuous linear coordinate permutation induced by
`aux_positivityIndexPerm`.  It is the change of variables in the positivity
proof.
-/
noncomputable def aux_positivityCoordinatePerm (k : ℕ) (i : Fin (k + 1)) :
    RealVector (k + 1) ≃L[ℝ] RealVector (k + 1) :=
  ContinuousLinearEquiv.piCongrLeft ℝ (fun _ : Fin (k + 1) => ℝ)
    (aux_positivityIndexPerm k i)

/--
Auxiliary coordinate formula for `aux_positivityCoordinatePerm`; it makes the
permutation usable pointwise in cube corners and kernel arguments.
-/
theorem aux_positivityCoordinatePerm_apply_index (k : ℕ) (i : Fin (k + 1))
    (x : RealVector (k + 1)) (j : Fin (k + 1)) :
    aux_positivityCoordinatePerm k i x (aux_positivityIndexPerm k i j) = x j := by
  change (Equiv.piCongrLeft (fun _ : Fin (k + 1) => ℝ)
    (aux_positivityIndexPerm k i) x) (aux_positivityIndexPerm k i j) = x j
  exact Equiv.piCongrLeft_apply_apply (fun _ : Fin (k + 1) => ℝ)
    (aux_positivityIndexPerm k i) x j

/--
Auxiliary preservation of the erased coordinate vector under the positivity
permutation.  This is why the original kernel `rho` does not need to be
reindexed.
-/
theorem aux_erase_positivityCoordinatePerm (k : ℕ) (i : Fin (k + 1))
    (x : RealVector (k + 1)) :
    eraseVector (Fin.last k) (aux_positivityCoordinatePerm k i x) = eraseVector i x := by
  funext j
  rw [eraseVector, eraseVector]
  have hidx : aux_positivityIndexPerm k i (i.succAbove j) =
      (Fin.last k).succAbove j := by
    rw [aux_positivityIndexPerm_apply_succAbove]
    simp
  rw [← hidx]
  exact aux_positivityCoordinatePerm_apply_index k i x (i.succAbove j)

/--
Auxiliary formula for the final coordinate after the positivity permutation.
It identifies it with the distinguished original coordinate `i`.
-/
theorem aux_positivityCoordinatePerm_last (k : ℕ) (i : Fin (k + 1))
    (x : RealVector (k + 1)) :
    aux_positivityCoordinatePerm k i x (Fin.last k) = x i := by
  rw [← aux_positivityIndexPerm_apply_self]
  exact aux_positivityCoordinatePerm_apply_index k i x i

/--
Auxiliary invariance of the coordinate sum under the positivity permutation.
This preserves the scalar kernel coordinate in the prism form.
-/
theorem aux_coordinateSum_positivityCoordinatePerm (k : ℕ) (i : Fin (k + 1))
    (x : RealVector (k + 1)) :
    coordinateSum (aux_positivityCoordinatePerm k i x) = coordinateSum x := by
  unfold coordinateSum
  calc
    ∑ j, aux_positivityCoordinatePerm k i x j =
        ∑ j, aux_positivityCoordinatePerm k i x (aux_positivityIndexPerm k i j) := by
          exact ((aux_positivityIndexPerm k i).sum_comp _).symm
    _ = ∑ j, x j := by
      apply Finset.sum_congr rfl
      intro j _
      exact aux_positivityCoordinatePerm_apply_index k i x j

/--
Auxiliary extension of the positivity coordinate permutation to all `n`
ambient coordinates; it acts as the identity on the prism tail coordinates.
-/
noncomputable def aux_positivityFullIndexPerm (n k : ℕ) (hkn : k + 1 ≤ n)
    (i : Fin (k + 1)) : Fin n ≃ Fin n :=
  let E := aux_concatIndexEquiv n (k + 1) hkn
  E.symm.trans ((Equiv.sumCongr (aux_positivityIndexPerm k i)
    (Equiv.refl (Fin (n - (k + 1))))).trans E)

/--
Auxiliary ambient continuous linear permutation associated to
`aux_positivityFullIndexPerm`; it keeps the function tuple in the Schwartz
class after precomposition by its inverse.
-/
noncomputable def aux_positivityFullCoordinatePerm (n k : ℕ) (hkn : k + 1 ≤ n)
    (i : Fin (k + 1)) : RealVector n ≃L[ℝ] RealVector n :=
  ContinuousLinearEquiv.piCongrLeft ℝ (fun _ : Fin n => ℝ)
    (aux_positivityFullIndexPerm n k hkn i)

/--
Auxiliary formula for the ambient index permutation on the head--tail
concatenation indices.
-/
theorem aux_positivityFullIndexPerm_apply_concatIndex (n k : ℕ) (hkn : k + 1 ≤ n)
    (i : Fin (k + 1)) (s : Fin (k + 1) ⊕ Fin (n - (k + 1))) :
    aux_positivityFullIndexPerm n k hkn i (aux_concatIndexEquiv n (k + 1) hkn s) =
      aux_concatIndexEquiv n (k + 1) hkn
        ((Equiv.sumCongr (aux_positivityIndexPerm k i)
          (Equiv.refl (Fin (n - (k + 1)))) ) s) := by
  simp [aux_positivityFullIndexPerm]

/--
Auxiliary pointwise formula for the ambient positivity permutation.
-/
theorem aux_positivityFullCoordinatePerm_apply_index (n k : ℕ) (hkn : k + 1 ≤ n)
    (i : Fin (k + 1)) (x : RealVector n) (j : Fin n) :
    aux_positivityFullCoordinatePerm n k hkn i x
      (aux_positivityFullIndexPerm n k hkn i j) = x j := by
  change (Equiv.piCongrLeft (fun _ : Fin n => ℝ)
    (aux_positivityFullIndexPerm n k hkn i)) x
      (aux_positivityFullIndexPerm n k hkn i j) = x j
  exact Equiv.piCongrLeft_apply_apply (fun _ : Fin n => ℝ)
    (aux_positivityFullIndexPerm n k hkn i) x j

/--
Auxiliary evaluation of `concatVector` at a head index.  It keeps the proof of
the ambient permutation independent of implementation details of the index
equivalence.
-/
theorem aux_positivityConcatVector_apply_inl (n m : ℕ) (hmn : m ≤ n)
    (c : RealVector m) (t : RealVector (n - m)) (s : Fin m) :
    concatVector n m hmn c t (aux_concatIndexEquiv n m hmn (Sum.inl s)) = c s := by
  have hE : aux_concatIndexEquiv n m hmn (Sum.inl s) = ⟨s.1, by omega⟩ := by
    apply Fin.ext
    simp [aux_concatIndexEquiv]
  rw [hE]
  simp [concatVector]

/--
Auxiliary evaluation of `concatVector` at a tail index, used alongside
`aux_positivityConcatVector_apply_inl`.
-/
theorem aux_positivityConcatVector_apply_inr (n m : ℕ) (hmn : m ≤ n)
    (c : RealVector m) (t : RealVector (n - m)) (s : Fin (n - m)) :
    concatVector n m hmn c t (aux_concatIndexEquiv n m hmn (Sum.inr s)) = t s := by
  have hE : aux_concatIndexEquiv n m hmn (Sum.inr s) = ⟨m + s.1, by omega⟩ := by
    apply Fin.ext
    simp [aux_concatIndexEquiv]
  rw [hE]
  simp [concatVector]

/--
Auxiliary compatibility of the ambient positivity permutation with the
head--tail coordinate concatenation.
-/
theorem aux_positivityFullCoordinatePerm_concatVector (n k : ℕ) (hkn : k + 1 ≤ n)
    (i : Fin (k + 1)) (c : RealVector (k + 1))
    (t : RealVector (n - (k + 1))) :
    aux_positivityFullCoordinatePerm n k hkn i (concatVector n (k + 1) hkn c t) =
      concatVector n (k + 1) hkn (aux_positivityCoordinatePerm k i c) t := by
  funext q
  obtain ⟨j, rfl⟩ := (aux_positivityFullIndexPerm n k hkn i).surjective q
  obtain ⟨s, rfl⟩ := (aux_concatIndexEquiv n (k + 1) hkn).surjective j
  rw [aux_positivityFullCoordinatePerm_apply_index,
    aux_positivityFullIndexPerm_apply_concatIndex]
  rcases s with s | s
  · rw [aux_positivityConcatVector_apply_inl]
    change c s = concatVector n (k + 1) hkn (aux_positivityCoordinatePerm k i c) t
      (aux_concatIndexEquiv n (k + 1) hkn (Sum.inl (aux_positivityIndexPerm k i s)))
    rw [aux_positivityConcatVector_apply_inl]
    exact (aux_positivityCoordinatePerm_apply_index k i c s).symm
  · rw [aux_positivityConcatVector_apply_inr]
    change t s = concatVector n (k + 1) hkn (aux_positivityCoordinatePerm k i c) t
      (aux_concatIndexEquiv n (k + 1) hkn (Sum.inr s))
    rw [aux_positivityConcatVector_apply_inr]

/--
Auxiliary reindexing equivalence for the cube vertices in the positivity
argument.
-/
noncomputable def aux_positivityCubeEquiv (k : ℕ) (i : Fin (k + 1)) :
    (Fin (k + 1) → Fin 2) ≃ (Fin (k + 1) → Fin 2) :=
  Equiv.piCongrLeft (fun _ : Fin (k + 1) => Fin 2) (aux_positivityIndexPerm k i)

/--
Auxiliary pointwise formula for the cube-vertex reindexing.
-/
theorem aux_positivityCubeEquiv_apply_index (k : ℕ) (i : Fin (k + 1))
    (h : Fin (k + 1) → Fin 2) (j : Fin (k + 1)) :
    aux_positivityCubeEquiv k i h (aux_positivityIndexPerm k i j) = h j := by
  exact Equiv.piCongrLeft_apply_apply (fun _ : Fin (k + 1) => Fin 2)
    (aux_positivityIndexPerm k i) h j

/--
Auxiliary compatibility of the positivity coordinate permutation with a cube
corner; it is the finite-dimensional part of the prism-form transport.
-/
theorem aux_positivityCoordinatePerm_cubeCorner (k : ℕ) (i : Fin (k + 1))
    (y : RealVector (k + 1) × RealVector (k + 1))
    (h : Fin (k + 1) → Fin 2) :
    aux_positivityCoordinatePerm k i (cubeCorner y h) =
      cubeCorner (aux_positivityCoordinatePerm k i y.1,
        aux_positivityCoordinatePerm k i y.2) (aux_positivityCubeEquiv k i h) := by
  funext q
  obtain ⟨j, rfl⟩ := (aux_positivityIndexPerm k i).surjective q
  rw [aux_positivityCoordinatePerm_apply_index]
  unfold cubeCorner
  rw [aux_positivityCubeEquiv_apply_index]
  change (if h j = 0 then y.1 j else y.2 j) =
    if h j = 0 then aux_positivityCoordinatePerm k i y.1 (aux_positivityIndexPerm k i j)
    else aux_positivityCoordinatePerm k i y.2 (aux_positivityIndexPerm k i j)
  rw [aux_positivityCoordinatePerm_apply_index, aux_positivityCoordinatePerm_apply_index]

/--
Auxiliary transport of one prism point under the ambient positivity
permutation.
-/
theorem aux_positivityFullCoordinatePerm_prismPoint (n k : ℕ) (hkn : k + 1 ≤ n)
    (i : Fin (k + 1)) (y : RealVector (k + 1) × RealVector (k + 1))
    (x : RealVector (n - (k + 1) + 1)) (h : Fin (k + 1) → Fin 2)
    (j : Fin (n - (k + 1) + 1)) :
    aux_positivityFullCoordinatePerm n k hkn i
      (prismPoint (n := n) (k := k + 1) (by omega) hkn y x h j) =
      prismPoint (n := n) (k := k + 1) (by omega) hkn
        (aux_positivityCoordinatePerm k i y.1, aux_positivityCoordinatePerm k i y.2) x
        (aux_positivityCubeEquiv k i h) j := by
  unfold prismPoint
  rw [aux_positivityFullCoordinatePerm_concatVector]
  rw [aux_positivityCoordinatePerm_cubeCorner]

/--
Auxiliary reindexing of the full prism product under the positivity coordinate
permutation.  It is needed to turn the original function tuple into a
Schwartz tuple precomposed with the inverse ambient permutation.
-/
theorem aux_positivityFullCoordinatePerm_prismProduct (n k : ℕ) (hkn : k + 1 ≤ n)
    (i : Fin (k + 1)) (F : Fin n → RealVector n → ℝ)
    (y : RealVector (k + 1) × RealVector (k + 1))
    (x : RealVector (n - (k + 1) + 1)) :
    (∏ h : Fin (k + 1) → Fin 2,
      ∏ j : Fin (n - (k + 1) + 1),
        F (prismIndex (by omega) hkn j)
          (aux_positivityFullCoordinatePerm n k hkn i
            (prismPoint (by omega) hkn y x h j))) =
      ∏ h : Fin (k + 1) → Fin 2,
        ∏ j : Fin (n - (k + 1) + 1),
          F (prismIndex (by omega) hkn j)
            (prismPoint (by omega) hkn
              (aux_positivityCoordinatePerm k i y.1,
                aux_positivityCoordinatePerm k i y.2) x h j) := by
  apply Fintype.prod_equiv (aux_positivityCubeEquiv k i)
  intro h
  apply Finset.prod_congr rfl
  intro j _
  rw [aux_positivityFullCoordinatePerm_prismPoint]

/--
Auxiliary inverse form of the prism-product transport.  This is the exact
identity used in the prism-form change of variables below.
-/
theorem aux_positivityFullCoordinatePerm_prismProduct_symm (n k : ℕ) (hkn : k + 1 ≤ n)
    (i : Fin (k + 1)) (F : Fin n → RealVector n → ℝ)
    (y : RealVector (k + 1) × RealVector (k + 1))
    (x : RealVector (n - (k + 1) + 1)) :
    (∏ h : Fin (k + 1) → Fin 2,
      ∏ j : Fin (n - (k + 1) + 1),
        F (prismIndex (by omega) hkn j)
          ((aux_positivityFullCoordinatePerm n k hkn i).symm
            (prismPoint (by omega) hkn
              (aux_positivityCoordinatePerm k i y.1,
                aux_positivityCoordinatePerm k i y.2) x h j))) =
      ∏ h : Fin (k + 1) → Fin 2,
        ∏ j : Fin (n - (k + 1) + 1),
          F (prismIndex (by omega) hkn j)
            (prismPoint (by omega) hkn y x h j) := by
  let G : Fin n → RealVector n → ℝ := fun a z =>
    F a ((aux_positivityFullCoordinatePerm n k hkn i).symm z)
  have h := aux_positivityFullCoordinatePerm_prismProduct n k hkn i G y x
  simpa only [G, ContinuousLinearEquiv.symm_apply_apply] using h.symm

/--
Auxiliary kernel conjugacy for the positivity argument.  It identifies the
literal arbitrary-coordinate kernel with the final-coordinate kernel after
the coordinate permutation.
-/
theorem aux_positivityKernel_conj_coordinatePerm (k : ℕ) (rho : KKernel k)
    (phi : ℝ → ℝ) (i : Fin (k + 1)) (u : RealVector (k + 1) × ℝ) :
    positivityKernel k rho phi i u =
      positivityKernel k rho phi (Fin.last k)
        (aux_positivityCoordinatePerm k i u.1, u.2) := by
  unfold positivityKernel
  apply integral_congr_ae
  filter_upwards [] with q
  rw [aux_erase_positivityCoordinatePerm, aux_positivityCoordinatePerm_last]

/--
Auxiliary measurable equivalence underlying the positivity coordinate
permutation.  The measurable-equivalence presentation is used to transport
outer integrals without separate integrability hypotheses.
-/
noncomputable def aux_positivityCoordinateMeasurableEquiv (k : ℕ) (i : Fin (k + 1)) :
    RealVector (k + 1) ≃ᵐ RealVector (k + 1) :=
  MeasurableEquiv.piCongrLeft (fun _ : Fin (k + 1) => ℝ) (aux_positivityIndexPerm k i)

/--
Auxiliary measurable equivalence applying the positivity permutation to both
cube vertex vectors.
-/
noncomputable def aux_positivityCubePairEquiv (k : ℕ) (i : Fin (k + 1)) :
    (RealVector (k + 1) × RealVector (k + 1)) ≃ᵐ
      (RealVector (k + 1) × RealVector (k + 1)) :=
  MeasurableEquiv.prodCongr (aux_positivityCoordinateMeasurableEquiv k i)
    (aux_positivityCoordinateMeasurableEquiv k i)

/--
Auxiliary pointwise formula for `aux_positivityCubePairEquiv`.  Keeping this
formula opaque prevents unnecessary unfolding of the coordinate equivalences
in the raw prism integrand calculation.
-/
theorem aux_positivityCubePairEquiv_apply (k : ℕ) (i : Fin (k + 1))
    (y : RealVector (k + 1) × RealVector (k + 1)) :
    aux_positivityCubePairEquiv k i y =
      (aux_positivityCoordinatePerm k i y.1, aux_positivityCoordinatePerm k i y.2) := by
  rfl

/--
Auxiliary Haar preservation of the cube-pair measurable equivalence.  It is
the outer change of variables in the positivity proof.
-/
theorem aux_measurePreserving_positivityCubePairEquiv (k : ℕ) (i : Fin (k + 1)) :
    MeasurePreserving (aux_positivityCubePairEquiv k i) volume volume := by
  let E := aux_positivityCoordinateMeasurableEquiv k i
  have hE : MeasurePreserving E (volume : Measure (RealVector (k + 1))) volume := by
    simpa [E, aux_positivityCoordinateMeasurableEquiv] using
      (volume_measurePreserving_piCongrLeft (fun _ : Fin (k + 1) => ℝ)
        (aux_positivityIndexPerm k i))
  have hpair : MeasurePreserving (Prod.map E E)
      (volume : Measure (RealVector (k + 1) × RealVector (k + 1))) volume := by
    simpa only [Measure.volume_eq_prod] using hE.prod hE
  convert hpair using 1
  funext y
  rfl

/--
Auxiliary Schwartz tuple obtained by precomposing each function with the
inverse ambient positivity permutation.
-/
noncomputable def aux_positivityPrecomposeTuple (n k : ℕ) (hkn : k + 1 ≤ n)
    (i : Fin (k + 1)) (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    Fin n → SchwartzMap (RealVector n) ℝ := fun a =>
  SchwartzMap.compCLMOfContinuousLinearEquiv ℝ
    (aux_positivityFullCoordinatePerm n k hkn i).symm (F a)

/--
Auxiliary pointwise formula for the precomposed Schwartz tuple.
-/
theorem aux_positivityPrecomposeTuple_apply (n k : ℕ) (hkn : k + 1 ≤ n)
    (i : Fin (k + 1)) (F : Fin n → SchwartzMap (RealVector n) ℝ)
    (a : Fin n) (z : RealVector n) :
    aux_positivityPrecomposeTuple n k hkn i F a z =
      F a ((aux_positivityFullCoordinatePerm n k hkn i).symm z) := by
  rfl

/--
Auxiliary raw integrand of the `(k+1)`-prism form.  It is separated out so
the positivity coordinate substitution can be checked pointwise before the
outer integral is transported.
-/
def aux_positivityPrismRawIntegrand (n k : ℕ) (hkn : k + 1 ≤ n)
    (K : KKernel (k + 1)) (F : Fin n → RealVector n → ℝ)
    (y : RealVector (k + 1) × RealVector (k + 1))
    (x : RealVector (n - (k + 1) + 1)) : ℝ :=
  K (y.2 - y.1, coordinateSum y.1 + coordinateSum x) *
    ∏ h : Fin (k + 1) → Fin 2, ∏ j : Fin (n - (k + 1) + 1),
      F (prismIndex (by omega) hkn j) (prismPoint (by omega) hkn y x h j)

/--
Auxiliary pointwise raw-integrand conjugacy.  It combines the kernel
conjugacy with the cube-product reindexing, and is the core equality in the
positivity change of variables.
-/
theorem aux_positivityPrismRawIntegrand_comp_cubePairEquiv
    (n k : ℕ) (hkn : k + 1 ≤ n) (rho : KKernel k) (phi : ℝ → ℝ)
    (i : Fin (k + 1)) (F : Fin n → SchwartzMap (RealVector n) ℝ)
    (y : RealVector (k + 1) × RealVector (k + 1))
    (x : RealVector (n - (k + 1) + 1)) :
    aux_positivityPrismRawIntegrand n k hkn
      (positivityKernel k rho phi (Fin.last k))
      (fun a z => aux_positivityPrecomposeTuple n k hkn i F a z)
      (aux_positivityCubePairEquiv k i y) x =
    aux_positivityPrismRawIntegrand n k hkn
      (positivityKernel k rho phi i) (fun a z => F a z) y x := by
  rw [aux_positivityCubePairEquiv_apply]
  dsimp only [aux_positivityPrismRawIntegrand]
  rw [← (aux_positivityCoordinatePerm k i).map_sub]
  rw [aux_coordinateSum_positivityCoordinatePerm]
  have hkernel :
      positivityKernel k rho phi (Fin.last k)
        (aux_positivityCoordinatePerm k i (y.2 - y.1),
          coordinateSum y.1 + coordinateSum x) =
        positivityKernel k rho phi i
          (y.2 - y.1, coordinateSum y.1 + coordinateSum x) := by
    simpa using
      (aux_positivityKernel_conj_coordinatePerm k rho phi i
        (y.2 - y.1, coordinateSum y.1 + coordinateSum x)).symm
  rw [hkernel]
  simp_rw [aux_positivityPrecomposeTuple_apply]
  congr 1
  simpa using
    (aux_positivityFullCoordinatePerm_prismProduct_symm n k hkn i
      (fun a z => F a z) y x)

/--
Auxiliary existential prism-form conjugacy for the positivity proposition.  It
transports the arbitrary distinguished coordinate to the final one and
produces the precomposed Schwartz tuple needed for the final-coordinate
square identity.
-/
theorem aux_positivityKernel_prismForm_exists_coordinatePerm
    (n k : ℕ) (_hk : 1 ≤ k) (hkn : k + 1 ≤ n)
    (rho : KKernel k) (phi : ℝ → ℝ) (i : Fin (k + 1))
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    ∃ Fpre : Fin n → SchwartzMap (RealVector n) ℝ,
      prismBrascampLiebForm n (k + 1) (by omega) hkn
        (positivityKernel k rho phi i) (fun a z => F a z) =
      prismBrascampLiebForm n (k + 1) (by omega) hkn
        (positivityKernel k rho phi (Fin.last k)) (fun a z => Fpre a z) := by
  classical
  let Fpre := aux_positivityPrecomposeTuple n k hkn i F
  refine ⟨Fpre, ?_⟩
  calc
    prismBrascampLiebForm n (k + 1) (by omega) hkn
        (positivityKernel k rho phi i) (fun a z => F a z) =
      ∫ y, ∫ x,
        aux_positivityPrismRawIntegrand n k hkn
          (positivityKernel k rho phi i) (fun a z => F a z) y x := by rfl
    _ = ∫ y, ∫ x,
        aux_positivityPrismRawIntegrand n k hkn
          (positivityKernel k rho phi (Fin.last k))
          (fun a z => Fpre a z) (aux_positivityCubePairEquiv k i y) x := by
      apply integral_congr_ae
      filter_upwards [] with y
      apply integral_congr_ae
      filter_upwards [] with x
      exact (aux_positivityPrismRawIntegrand_comp_cubePairEquiv n k hkn rho phi i F y x).symm
    _ = ∫ y, ∫ x,
        aux_positivityPrismRawIntegrand n k hkn
          (positivityKernel k rho phi (Fin.last k)) (fun a z => Fpre a z) y x :=
      (aux_measurePreserving_positivityCubePairEquiv k i).integral_comp'
        (fun y => ∫ x,
          aux_positivityPrismRawIntegrand n k hkn
            (positivityKernel k rho phi (Fin.last k)) (fun a z => Fpre a z) y x)
    _ = prismBrascampLiebForm n (k + 1) (by omega) hkn
        (positivityKernel k rho phi (Fin.last k)) (fun a z => Fpre a z) := by rfl

/--
Auxiliary identification of the final-coordinate positivity kernel with the
one-summand singly-cancellative lift.  This exposes the pre-existing square
identity for the final-coordinate case.
-/
theorem aux_positivityKernel_last_eq_singlyCancellativeLift
    (k : ℕ) (rho : KKernel k) (hrho_nonneg : ∀ u, 0 ≤ rho u)
    (phi : ℝ → ℝ) :
    positivityKernel k rho phi (Fin.last k) =
      singlyCancellativeLift k 1 (fun _ => rho) (fun _ => phi) := by
  funext u
  unfold positivityKernel singlyCancellativeLift
  rw [Fin.sum_univ_one]
  apply integral_congr_ae
  filter_upwards [] with q
  rw [abs_of_nonneg]
  · congr 3
    apply Prod.ext
    · funext j
      simp [eraseVector]
    · rfl
  · exact hrho_nonneg _

/--
Auxiliary nonnegativity of the final-coordinate positivity kernel.  It is the
weighted square identity furnished by the singly-cancellative lift theorem.
-/
theorem aux_positivityKernel_last_nonnegative
    (n k : ℕ) (hk : 1 ≤ k) (hkn : k + 1 ≤ n)
    (rho : KKernel k) (hrho : MemW0 rho) (hrho_nonneg : ∀ u, 0 ≤ rho u)
    (phi : ℝ → ℝ) (hphi : MemW0 phi)
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    0 ≤ prismBrascampLiebForm n (k + 1) (by omega) hkn
      (positivityKernel k rho phi (Fin.last k)) (fun j x => F j x) := by
  obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le hkn
  cases hd
  rw [aux_positivityKernel_last_eq_singlyCancellativeLift k rho hrho_nonneg phi]
  rw [← aux_singlyCancellativeA2_eq_liftPrism k d 1 (by omega) hk
    (fun _ => rho) (fun _ => phi) (fun _ => hrho) (fun _ => hphi) F]
  apply Finset.sum_nonneg
  intro j _
  apply integral_nonneg
  intro p
  exact Real.rpow_nonneg (abs_nonneg _) _

/--
For all $\mathbf{F}\in\mathfrak{F}$
\begin{equation}
    \Theta_{k+1}(K)(\F)\ge 0\, .
\end{equation}
-/
theorem positivityKernel_nonnegative
    (n k : ℕ) (hk : 1 ≤ k) (hkn : k + 1 ≤ n)
    (rho : KKernel k) (hrho : MemW0 rho) (hrho_nonneg : ∀ u, 0 ≤ rho u)
    (phi : ℝ → ℝ) (hphi : MemW0 phi) (i : Fin (k + 1))
    (F : Fin n → SchwartzMap (RealVector n) ℝ)
    (_hF : F ∈ normalizedFunctionTuples n) :
    0 ≤ prismBrascampLiebForm n (k + 1) (by omega) hkn
      (positivityKernel k rho phi i) (fun j x => F j x) := by
  obtain ⟨Fpre, hconj⟩ :=
    aux_positivityKernel_prismForm_exists_coordinatePerm n k hk hkn rho phi i F
  rw [hconj]
  exact aux_positivityKernel_last_nonnegative n k hk hkn rho hrho hrho_nonneg phi hphi Fpre

/-- Auxiliary definition for Proposition \ref{Monotonicity K}; see `monotonicityK`. -/
def monotonicityKernel (k : ℕ) (rho : KKernel k) (phi : ℝ → ℝ) : KKernel (k + 1) :=
  positivityKernel k rho phi (Fin.last k)

/--
Auxiliary for Proposition \ref{Monotonicity K}, formalized as `monotonicityK`.
It supplies the closure of `W₀` under negation needed to form the kernel
difference.
-/
theorem aux_memW0_neg {E : Type*} [NormedAddCommGroup E] [ProperSpace E]
    [MeasureSpace E] [BorelSpace E] {f : E → ℝ} (hf : MemW0 f) :
    MemW0 (fun x => -f x) := by
  refine ⟨hf.aux_continuous.neg, ?_⟩
  have hEnvelope : wienerEnvelope (fun x : E => -f x) 1 = wienerEnvelope f 1 := by
    funext x
    simp [wienerEnvelope]
  rw [hEnvelope]
  exact hf.aux_integrable_envelope

/--
Auxiliary for Proposition \ref{Monotonicity K}, formalized as `monotonicityK`.
It forms the `W₀` difference to which positivity is applied.
-/
theorem aux_memW0_sub {E : Type*} [NormedAddCommGroup E] [ProperSpace E]
    [MeasureSpace E] [BorelSpace E] {f g : E → ℝ} (hf : MemW0 f) (hg : MemW0 g) :
    MemW0 (fun x => f x - g x) := by
  have hneg : MemW0 (fun x => -g x) := aux_memW0_neg hg
  simpa [sub_eq_add_neg] using aux_memW0_add hf hneg

/--
Auxiliary for Proposition \ref{Monotonicity K}, formalized as `monotonicityK`.
It gives the kernel-linearity identity for the prism Brascamp--Lieb form.
-/
theorem aux_prismBrascampLiebForm_sub (n l : ℕ) (hl : 1 ≤ l) (hln : l ≤ n)
    (K₁ K₂ : KKernel l) (hK₁ : MemW0 K₁) (hK₂ : MemW0 K₂)
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    prismBrascampLiebForm n l hl hln K₁ (fun i x => F i x) -
      prismBrascampLiebForm n l hl hln K₂ (fun i x => F i x) =
      prismBrascampLiebForm n l hl hln (fun u => K₁ u - K₂ u) (fun i x => F i x) := by
  let P : KKernel l → ((RealVector l × RealVector l) × RealVector (n - l + 1)) → ℝ :=
    fun K p => K (p.1.2 - p.1.1, coordinateSum p.1.1 + coordinateSum p.2) *
      ∏ h : Fin l → Fin 2, ∏ i : Fin (n - l + 1),
        F (prismIndex hl hln i) (prismPoint hl hln p.1 p.2 h i)
  have hP₁ : Integrable (P K₁) := by
    simpa [P] using aux_integrable_prismIntegrand n l hl hln K₁ hK₁ F
  have hP₂ : Integrable (P K₂) := by
    simpa [P] using aux_integrable_prismIntegrand n l hl hln K₂ hK₂ F
  have hKsub : MemW0 (fun u => K₁ u - K₂ u) := aux_memW0_sub hK₁ hK₂
  have hPsub : Integrable (P (fun u => K₁ u - K₂ u)) := by
    simpa [P] using
      aux_integrable_prismIntegrand n l hl hln (fun u => K₁ u - K₂ u) hKsub F
  change (∫ y : RealVector l × RealVector l, ∫ x : RealVector (n - l + 1), P K₁ (y, x)) -
      (∫ y : RealVector l × RealVector l, ∫ x : RealVector (n - l + 1), P K₂ (y, x)) =
      ∫ y : RealVector l × RealVector l, ∫ x : RealVector (n - l + 1),
        P (fun u => K₁ u - K₂ u) (y, x)
  calc
    _ = (∫ p, P K₁ p) - (∫ p, P K₂ p) := by
      rw [show (∫ y : RealVector l × RealVector l, ∫ x : RealVector (n - l + 1),
          P K₁ (y, x)) = ∫ p, P K₁ p by
        simpa only [Measure.volume_eq_prod] using (integral_prod (P K₁) hP₁).symm]
      rw [show (∫ y : RealVector l × RealVector l, ∫ x : RealVector (n - l + 1),
          P K₂ (y, x)) = ∫ p, P K₂ p by
        simpa only [Measure.volume_eq_prod] using (integral_prod (P K₂) hP₂).symm]
    _ = ∫ p, P K₁ p - P K₂ p := (integral_sub hP₁ hP₂).symm
    _ = ∫ p, P (fun u => K₁ u - K₂ u) p := by
      apply integral_congr_ae
      filter_upwards [] with p
      dsimp [P]
      ring
    _ = ∫ y : RealVector l × RealVector l, ∫ x : RealVector (n - l + 1),
        P (fun u => K₁ u - K₂ u) (y, x) := by
      simpa only [Measure.volume_eq_prod] using
        (integral_prod (P (fun u => K₁ u - K₂ u)) hPsub)

/--
Auxiliary for Proposition \ref{Monotonicity K}, formalized as `monotonicityK`.
It identifies the difference of the two monotonicity kernels with the kernel
of the pointwise difference.
-/
theorem aux_monotonicityKernel_sub (k : ℕ)
    (rho rhotilde : KKernel k) (hrho : MemW0 rho) (hrhotilde : MemW0 rhotilde)
    (phi : ℝ → ℝ) (hphi : MemW0 phi) :
    (fun u => monotonicityKernel k rhotilde phi u - monotonicityKernel k rho phi u) =
      monotonicityKernel k (fun x => rhotilde x - rho x) phi := by
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k)) :=
    isAddHaarMeasure_volume_pi (Fin k)
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector (k + 1))) :=
    isAddHaarMeasure_volume_pi (Fin (k + 1))
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure (volume : Measure ((RealVector k × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure (((RealVector k × ℝ) × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector (k + 1) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure ((RealVector (k + 1) × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  have htildeW := aux_memW0_positivityExpandedKernel k rhotilde hrhotilde phi hphi
    (Fin.last k)
  have hrhoW := aux_memW0_positivityExpandedKernel k rho hrho phi hphi (Fin.last k)
  have htildeI (u : RealVector (k + 1) × ℝ) :
      Integrable (fun q : ℝ =>
        aux_positivityExpandedKernel k rhotilde phi (Fin.last k) (u, q)) :=
    aux_memW0_integrable_of_addHaar (htildeW.aux_memW0_slice_of_addHaar u)
  have hrhoI (u : RealVector (k + 1) × ℝ) :
      Integrable (fun q : ℝ =>
        aux_positivityExpandedKernel k rho phi (Fin.last k) (u, q)) :=
    aux_memW0_integrable_of_addHaar (hrhoW.aux_memW0_slice_of_addHaar u)
  funext u
  change (∫ q : ℝ,
      rhotilde (eraseVector (Fin.last k) u.1, u.2 - q) * phi (u.1 (Fin.last k) + q) * phi q) -
      (∫ q : ℝ,
        rho (eraseVector (Fin.last k) u.1, u.2 - q) * phi (u.1 (Fin.last k) + q) * phi q) =
      ∫ q : ℝ,
        (rhotilde (eraseVector (Fin.last k) u.1, u.2 - q) -
          rho (eraseVector (Fin.last k) u.1, u.2 - q)) * phi (u.1 (Fin.last k) + q) * phi q
  rw [← integral_sub]
  · apply integral_congr_ae
    filter_upwards [] with q
    ring
  · simpa [aux_positivityExpandedKernel] using htildeI u
  · simpa [aux_positivityExpandedKernel] using hrhoI u

/--
\begin{proposition}[Monotonicity]\label{Monotonicity K}
In the situation of Proposition \ref{Positivity K},
in particular, if $\rho\le \tilde{\rho}$ and 
\[ K_\rho(u):=\int_\R \rho(u_{[k)}, u_{k+1}-q) \phi(u_{k}+q) \phi(q) \, dq\]
then
\[ \Theta_{k+1}(K_\rho)(\F) \le \Theta_{k+1}(K_{\tilde{\rho}})(\F) \]
\end{proposition}
-/
theorem monotonicityK (n k : ℕ) (hk : 1 ≤ k)
    (hkn : k + 1 ≤ n) (rho rhotilde : KKernel k)
    (hrho : MemW0 rho) (hrhotilde : MemW0 rhotilde)
    (_hrho_nonneg : ∀ u, 0 ≤ rho u) (hrho_le : ∀ u, rho u ≤ rhotilde u)
    (phi : ℝ → ℝ) (hphi : MemW0 phi)
    (F : Fin n → SchwartzMap (RealVector n) ℝ)
    (hF : F ∈ normalizedFunctionTuples n) :
    prismBrascampLiebForm n (k + 1) (by omega) hkn
      (monotonicityKernel k rho phi) (fun i x => F i x) ≤
      prismBrascampLiebForm n (k + 1) (by omega) hkn
        (monotonicityKernel k rhotilde phi) (fun i x => F i x) := by
  have hdelta : MemW0 (fun x => rhotilde x - rho x) := aux_memW0_sub hrhotilde hrho
  have hdelta_nonneg (x : RealVector k × ℝ) : 0 ≤ rhotilde x - rho x :=
    sub_nonneg.mpr (hrho_le x)
  have hKrho : MemW0 (monotonicityKernel k rho phi) :=
    aux_memW0_positivityKernel k rho hrho phi hphi (Fin.last k)
  have hKrhotilde : MemW0 (monotonicityKernel k rhotilde phi) :=
    aux_memW0_positivityKernel k rhotilde hrhotilde phi hphi (Fin.last k)
  have hlinear := aux_prismBrascampLiebForm_sub n (k + 1) (by omega) hkn
    (monotonicityKernel k rhotilde phi) (monotonicityKernel k rho phi)
    hKrhotilde hKrho F
  have hkernel := aux_monotonicityKernel_sub k rho rhotilde hrho hrhotilde phi hphi
  have hpositive : 0 ≤
      prismBrascampLiebForm n (k + 1) (by omega) hkn
        (monotonicityKernel k (fun x => rhotilde x - rho x) phi) (fun i x => F i x) := by
    exact positivityKernel_nonnegative n k hk hkn (fun x => rhotilde x - rho x) hdelta
      hdelta_nonneg phi hphi (Fin.last k) F hF
  have hdifference :
      prismBrascampLiebForm n (k + 1) (by omega) hkn
          (monotonicityKernel k rhotilde phi) (fun i x => F i x) -
        prismBrascampLiebForm n (k + 1) (by omega) hkn
          (monotonicityKernel k rho phi) (fun i x => F i x) =
        prismBrascampLiebForm n (k + 1) (by omega) hkn
          (monotonicityKernel k (fun x => rhotilde x - rho x) phi) (fun i x => F i x) := by
    rw [hlinear, hkernel]
  linarith

end

