    (aux_mToKContinuousLinearEquiv k hk)
  have hI := aux_memW0_integral_slice_of_addHaar hG
  change MemW0 (fun z : RealVector k × ℝ =>
    ∫ p : RealVector (k - 1), M (mToKPoint k hk z p)) at hI
  exact hI

/--
\[ \|K_k(M)\|_1 \le \|M\|_1. \]
-/
theorem mToK_eLpNorm_one_le (n k : ℕ) (hk : 1 ≤ k) (_hkn : k ≤ n) (M : MKernel k)
    (hM : MemW0 M) :
    eLpNorm (mToK k hk M) 1 volume ≤ eLpNorm M 1 volume := by
  let G : ((RealVector k × ℝ) × RealVector (k - 1)) → ℝ :=
    M ∘ fun q => mToKPoint k hk q.1 q.2
  have hmeasure := aux_measurePreserving_mToKPoint k hk
  have hG_meas_volume : AEStronglyMeasurable G volume :=
    hM.1.aestronglyMeasurable.comp_measurePreserving hmeasure
  have hG_meas : AEStronglyMeasurable G
      (((volume : Measure (RealVector k)).prod (volume : Measure ℝ)).prod
        (volume : Measure (RealVector (k - 1)))) := by
    simpa only [Measure.volume_eq_prod] using hG_meas_volume
  have hslice := aux_eLpNorm_one_integral_slice_le
    ((volume : Measure (RealVector k)).prod (volume : Measure ℝ))
    (volume : Measure (RealVector (k - 1))) hG_meas
  have hG_norm_volume : eLpNorm G 1 volume = eLpNorm M 1 volume := by
    simpa [G, Function.comp_def] using
      (eLpNorm_comp_measurePreserving (p := (1 : ℝ≥0∞)) hM.1.aestronglyMeasurable hmeasure)
  have hG_norm : eLpNorm G 1
      (((volume : Measure (RealVector k)).prod (volume : Measure ℝ)).prod
        (volume : Measure (RealVector (k - 1)))) =
      eLpNorm M 1 ((volume : Measure (RealVector k)).prod
        (volume : Measure (RealVector k))) := by
    simpa only [Measure.volume_eq_prod] using hG_norm_volume
  change eLpNorm (mToK k hk M) 1
      ((volume : Measure (RealVector k)).prod (volume : Measure ℝ)) ≤
    eLpNorm M 1 ((volume : Measure (RealVector k)).prod (volume : Measure (RealVector k)))
  calc
    eLpNorm (mToK k hk M) 1
        ((volume : Measure (RealVector k)).prod (volume : Measure ℝ)) =
        eLpNorm (fun z : RealVector k × ℝ => ∫ p : RealVector (k - 1), G (z, p)) 1
          ((volume : Measure (RealVector k)).prod (volume : Measure ℝ)) := by
            rfl
    _ ≤ eLpNorm G 1
        (((volume : Measure (RealVector k)).prod (volume : Measure ℝ)).prod
          (volume : Measure (RealVector (k - 1)))) := hslice
    _ = eLpNorm M 1 ((volume : Measure (RealVector k)).prod
        (volume : Measure (RealVector k))) := hG_norm

/-- Auxiliary definition for Proposition \ref{Positivity M}; see `positivityM_memW0`. -/
def tensorSquare (phi : ℝ → ℝ) : ℝ × ℝ → ℝ := fun y => phi y.1 * phi y.2

/-- Auxiliary for Proposition \ref{Positivity M}, formalized as `positivityM_memW0`. -/
theorem aux_memW0_tensorSquare (phi : ℝ → ℝ) (hphi : MemW0 phi) :
    MemW0 (tensorSquare phi) := by
  change MemW0 (fun y : ℝ × ℝ => phi y.1 * phi y.2)
  exact hphi.aux_mul_prod hphi

/-- The simultaneous shift of the two coordinates in the direction $e_i^0+e_i^1$. -/
def aux_diagonalShift {k : ℕ} (y : RealVector k × RealVector k) (i : Fin k) (q : ℝ) :
    RealVector k × RealVector k :=
  (Function.update y.1 i (y.1 i - q), Function.update y.2 i (y.2 i - q))

/-- Auxiliary definition for Propositions \ref{Cauchy-Schwarz at k} and
\ref{Cauchy-Schwarz at n-1}; see `cauchySchwarzAtK_bound` and
`cauchySchwarzAtNMinusOne`. -/
def diagonalConvolution {k : ℕ} (rho : MKernel k) (i : Fin k) (phi : ℝ → ℝ) :
    MKernel k :=
  fun y => ∫ q : ℝ, rho (aux_diagonalShift y i q) * phi q

/-- Auxiliary definition for Proposition \ref{Cauchy-Schwarz at n-1}; see
`cauchySchwarzAtNMinusOne`. -/
def realConvolution (phi psi : ℝ → ℝ) : ℝ → ℝ :=
  fun x => ∫ q : ℝ, phi (x - q) * psi q

/--
Auxiliary determinant-one shear for convolution along a fixed vector.  It is
used to express a one-dimensional convolution as integration of a tensor
product after an affine coordinate change.
-/
noncomputable def aux_convolutionAlongShear {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] (alpha : E) : (E × ℝ) ≃L[ℝ] (E × ℝ) where
  toFun p := (p.1 - p.2 • alpha, p.2)
  invFun p := (p.1 + p.2 • alpha, p.2)
  left_inv p := by
    rcases p with ⟨x, q⟩
    apply Prod.ext
    · exact sub_add_cancel x (q • alpha)
    · rfl
  right_inv p := by
    rcases p with ⟨x, q⟩
    apply Prod.ext
    · exact add_sub_cancel_right x (q • alpha)
    · rfl
  map_add' p q := by
    rcases p with ⟨x, r⟩
    rcases q with ⟨y, s⟩
    apply Prod.ext
    · change x + y - (r + s) • alpha = (x - r • alpha) + (y - s • alpha)
      rw [add_smul]
      abel
    · rfl
  map_smul' c p := by
    rcases p with ⟨x, q⟩
    apply Prod.ext
    · change c • x - (c * q) • alpha = c • (x - q • alpha)
      rw [smul_sub, smul_smul]
    · rfl
  continuous_toFun := by fun_prop
  continuous_invFun := by fun_prop

/--
Auxiliary `W₀` closure for convolution along a vector.  It is used below for
the manuscript's convolution direction $e_i^0+e_i^1$.
-/
theorem aux_memW0_convolutionAlong {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [FiniteDimensional ℝ E] [ProperSpace E] [MeasureSpace E]
    [BorelSpace E] [Measure.IsAddHaarMeasure (volume : Measure E)]
    (rho : E → ℝ) (hrho : MemW0 rho) (phi : ℝ → ℝ) (hphi : MemW0 phi)
    (alpha : E) :
    MemW0 (fun x : E => ∫ q : ℝ, rho (x - q • alpha) * phi q) := by
  let : Measure.IsAddHaarMeasure (volume : Measure (E × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let H : E × ℝ → ℝ := fun p => rho p.1 * phi p.2
  have hH : MemW0 H := by
    simpa [H] using hrho.aux_mul_prod hphi
  have hShear : MemW0 (H ∘ aux_convolutionAlongShear alpha) :=
    aux_memW0_comp_continuousLinearEquiv hH (aux_convolutionAlongShear alpha)
  have hIntegral := aux_memW0_integral_slice_of_addHaar hShear
  simpa [H, Function.comp_def, aux_convolutionAlongShear] using hIntegral

/-- Auxiliary definition for Propositions \ref{Cauchy-Schwarz at k} and
\ref{Cauchy-Schwarz at n-1}; see `cauchySchwarzAtK_bound` and
`cauchySchwarzAtNMinusOne`. -/
def diagonalDirection (k : ℕ) (i : Fin k) : RealVector k × RealVector k :=
  (Pi.single i 1, Pi.single i 1)

/-- The affine formula relating `diagonalDirection` to `aux_diagonalShift`. -/
theorem aux_sub_smul_diagonalDirection (k : ℕ) (i : Fin k)
    (y : RealVector k × RealVector k) (q : ℝ) :
    y - q • diagonalDirection k i = aux_diagonalShift y i q := by
  apply Prod.ext
  · funext j
    change y.1 j - q * (Pi.single i 1 : RealVector k) j =
      Function.update y.1 i (y.1 i - q) j
    by_cases h : j = i
    · subst j
      simp
    · simp [h]
  · funext j
    change y.2 j - q * (Pi.single i 1 : RealVector k) j =
      Function.update y.2 i (y.2 i - q) j
    by_cases h : j = i
    · subst j
      simp
    · simp [h]

/-- Auxiliary for Propositions \ref{Cauchy-Schwarz at k} and
\ref{Cauchy-Schwarz at n-1}, formalized as `cauchySchwarzKernel_memW0` and
`doublyCauchySchwarzKernel_memW0`. -/
theorem diagonalConvolution_memW0 (k : ℕ) (rho : MKernel k) (hrho : MemW0 rho)
    (i : Fin k) (phi : ℝ → ℝ) (hphi : MemW0 phi) :
    MemW0 (diagonalConvolution rho i phi) := by
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k)) :=
    isAddHaarMeasure_volume_pi (Fin k)
  let : Measure.IsAddHaarMeasure
      (volume : Measure (RealVector k × RealVector k)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  change MemW0 (fun y : RealVector k × RealVector k =>
    ∫ q : ℝ, rho (aux_diagonalShift y i q) * phi q)
  have h := aux_memW0_convolutionAlong rho hrho phi hphi (diagonalDirection k i)
  have hEq :
      (fun y : RealVector k × RealVector k =>
        ∫ q : ℝ, rho (y - q • diagonalDirection k i) * phi q) =
      fun y : RealVector k × RealVector k =>
        ∫ q : ℝ, rho (aux_diagonalShift y i q) * phi q := by
    funext y
    apply integral_congr_ae
    filter_upwards [] with q
    rw [aux_sub_smul_diagonalDirection]
  rw [← hEq]
  exact h

/-- Auxiliary `W₀` closure for ordinary one-dimensional convolution. -/
theorem aux_realConvolution_memW0 (phi psi : ℝ → ℝ) (hphi : MemW0 phi)
    (hpsi : MemW0 psi) : MemW0 (realConvolution phi psi) := by
  change MemW0 (fun x : ℝ => ∫ q : ℝ, phi (x - q) * psi q)
  have h := aux_memW0_convolutionAlong phi hphi psi hpsi (1 : ℝ)
  simpa using h

/-- Auxiliary definition for Propositions \ref{Cauchy-Schwarz at k} and
\ref{Cauchy-Schwarz at n-1}; see `cauchySchwarzLift_memW0` and
`cauchySchwarzAtNMinusOne`. -/
def cauchySchwarzLift {k J : ℕ} (rho : Fin J → MKernel k)
    (phi : Fin J → ℝ → ℝ) : MKernel (k + 1) :=
  fun y => ∑ j,
    |rho j (fun i => y.1 i.castSucc, fun i => y.2 i.castSucc)| *
      tensorSquare (phi j) (y.1 (Fin.last k), y.2 (Fin.last k))

/--
Auxiliary reassociation of the two split coordinate vectors in the
`M`-kernel Cauchy--Schwarz lift.  It separates the old `M` coordinates from
the two newly exposed scalar coordinates.
-/
noncomputable def aux_cauchySchwarzLiftReassociate (k : ℕ) :
    ((RealVector k × ℝ) × (RealVector k × ℝ)) ≃L[ℝ]
      ((RealVector k × RealVector k) × (ℝ × ℝ)) where
  toFun p := ((p.1.1, p.2.1), (p.1.2, p.2.2))
  invFun p := ((p.1.1, p.2.1), (p.1.2, p.2.2))
  left_inv p := by
    rcases p with ⟨⟨a, r⟩, ⟨b, s⟩⟩
    rfl
  right_inv p := by
    rcases p with ⟨⟨a, b⟩, ⟨r, s⟩⟩
    rfl
  map_add' p q := by
    rcases p with ⟨⟨a, r⟩, ⟨b, s⟩⟩
    rcases q with ⟨⟨a', r'⟩, ⟨b', s'⟩⟩
    rfl
  map_smul' c p := by
    rcases p with ⟨⟨a, r⟩, ⟨b, s⟩⟩
    rfl
  continuous_toFun := by fun_prop
  continuous_invFun := by fun_prop

/--
Auxiliary continuous linear equivalence underlying the literal coordinate
formula for `cauchySchwarzLift`.
-/
noncomputable def aux_cauchySchwarzLiftEquiv (k : ℕ) :
    (RealVector (k + 1) × RealVector (k + 1)) ≃L[ℝ]
      ((RealVector k × RealVector k) × (ℝ × ℝ)) :=
  ((aux_lastCoordinateSplit k).prodCongr (aux_lastCoordinateSplit k)).trans
    (aux_cauchySchwarzLiftReassociate k)

/-- The explicit coordinates of `aux_cauchySchwarzLiftEquiv`. -/
theorem aux_cauchySchwarzLiftEquiv_apply (k : ℕ)
    (y : RealVector (k + 1) × RealVector (k + 1)) :
    aux_cauchySchwarzLiftEquiv k y =
      ((fun i => y.1 i.castSucc, fun i => y.2 i.castSucc),
        (y.1 (Fin.last k), y.2 (Fin.last k))) := by
  simp [aux_cauchySchwarzLiftEquiv, aux_lastCoordinateSplit,
    aux_cauchySchwarzLiftReassociate]

/--
Auxiliary `W₀` closure for one summand of the `M`-kernel Cauchy--Schwarz
lift.  It pulls back `|\rho|\otimes\phi^{\otimes 2}` by the preceding
coordinate equivalence.
-/
theorem aux_memW0_cauchySchwarzLiftSummand (k : ℕ) (rho : MKernel k)
    (hrho : MemW0 rho) (phi : ℝ → ℝ) (hphi : MemW0 phi) :
    MemW0 (fun y : RealVector (k + 1) × RealVector (k + 1) =>
      |rho (fun i => y.1 i.castSucc, fun i => y.2 i.castSucc)| *
        tensorSquare phi (y.1 (Fin.last k), y.2 (Fin.last k))) := by
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k)) :=
    isAddHaarMeasure_volume_pi (Fin k)
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector (k + 1))) :=
    isAddHaarMeasure_volume_pi (Fin (k + 1))
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k × RealVector k)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure (volume : Measure (ℝ × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure ((RealVector k × RealVector k) × (ℝ × ℝ))) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure (RealVector (k + 1) × RealVector (k + 1))) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let R : MKernel k := fun x => |rho x|
  have hR : MemW0 R := by
    simpa [R] using aux_memW0_abs hrho
  have hPhi2 : MemW0 (tensorSquare phi) := aux_memW0_tensorSquare phi hphi
  let H : ((RealVector k × RealVector k) × (ℝ × ℝ)) → ℝ :=
    fun p => R p.1 * tensorSquare phi p.2
  have hH : MemW0 H := by
    simpa [H] using hR.aux_mul_prod hPhi2
  have hPullback : MemW0 (H ∘ aux_cauchySchwarzLiftEquiv k) :=
    aux_memW0_comp_continuousLinearEquiv hH (aux_cauchySchwarzLiftEquiv k)
  simpa [H, R, Function.comp_def, aux_cauchySchwarzLiftEquiv_apply] using hPullback

/--
\begin{proposition}[Cauchy-Schwarz at $k$]\label{Cauchy-Schwarz at k}
For $y\in (\R^2)^{k+1}$,
\begin{equation}
\tilde{M}(y)=\sum_{j\in [J)}|\rho_j(y_{[k)})| \varphi_j^{\otimes 2}(y_k).
\end{equation}
Then $\tilde{M}\in W_0((\R^2)^{k+1})$.
\end{proposition}
-/
theorem cauchySchwarzLift_memW0 (k J : ℕ) (rho : Fin J → MKernel k)
    (phi : Fin J → ℝ → ℝ) (hrho : ∀ j, MemW0 (rho j))
    (hphi : ∀ j, MemW0 (phi j)) :
    MemW0 (cauchySchwarzLift rho phi) := by
  unfold cauchySchwarzLift
  apply aux_memW0_finset_sum Finset.univ
  intro j _
  exact aux_memW0_cauchySchwarzLiftSummand k (rho j) (hrho j) (phi j) (hphi j)

/-- Auxiliary for Proposition \ref{Positivity M}, formalized as `positivityM_memW0`. -/
noncomputable def aux_tensorSquareExtensionEquiv (d : ℕ) (i : Fin (d + 1)) :
    (RealVector (d + 1) × RealVector (d + 1)) ≃L[ℝ]
      ((RealVector d × RealVector d) × (ℝ × ℝ)) :=
  ((aux_eraseCoordinateSplit d i).prodCongr (aux_eraseCoordinateSplit d i)).trans
    (aux_cauchySchwarzLiftReassociate d)

/-- Auxiliary for Proposition \ref{Positivity M}, formalized as `positivityM_memW0`. -/
theorem aux_tensorSquareExtensionEquiv_apply (d : ℕ) (i : Fin (d + 1))
    (y : RealVector (d + 1) × RealVector (d + 1)) :
    aux_tensorSquareExtensionEquiv d i y =
      ((eraseVector i y.1, eraseVector i y.2), (y.1 i, y.2 i)) := by
  simp [aux_tensorSquareExtensionEquiv, aux_eraseCoordinateSplit,
    aux_cauchySchwarzLiftReassociate]
  constructor <;> constructor <;> rfl

/-- Auxiliary for Proposition \ref{Positivity M}, formalized as `positivityM_memW0`. -/
theorem aux_memW0_tensorSquareExtensionSucc (d : ℕ) (i : Fin (d + 1))
    (tildeM : MKernel d) (htildeM : MemW0 tildeM) (phi : ℝ → ℝ)
    (hphi : MemW0 phi) :
    MemW0 (fun y : RealVector (d + 1) × RealVector (d + 1) =>
      tildeM (eraseVector i y.1, eraseVector i y.2) * tensorSquare phi (y.1 i, y.2 i)) := by
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector d)) :=
    isAddHaarMeasure_volume_pi (Fin d)
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector (d + 1))) :=
    isAddHaarMeasure_volume_pi (Fin (d + 1))
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector d × RealVector d)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure (volume : Measure (ℝ × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure ((RealVector d × RealVector d) × (ℝ × ℝ))) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure (RealVector (d + 1) × RealVector (d + 1))) :=
    Measure.prod.instIsAddHaarMeasure _ _
  have hPhi2 : MemW0 (tensorSquare phi) := aux_memW0_tensorSquare phi hphi
  let H : ((RealVector d × RealVector d) × (ℝ × ℝ)) → ℝ :=
    fun p => tildeM p.1 * tensorSquare phi p.2
  have hH : MemW0 H := by
    simpa [H] using htildeM.aux_mul_prod hPhi2
  have hPullback : MemW0 (H ∘ aux_tensorSquareExtensionEquiv d i) :=
    aux_memW0_comp_continuousLinearEquiv hH (aux_tensorSquareExtensionEquiv d i)
  simpa [H, Function.comp_def, aux_tensorSquareExtensionEquiv_apply] using hPullback

/-- Auxiliary definition for Proposition \ref{Cauchy-Schwarz at k}; see
`cauchySchwarzAtK_bound`. -/
def cauchySchwarzKernel {k J : ℕ} (rho : Fin J → MKernel k) (phi : Fin J → ℝ → ℝ)
    (i : Fin k) : MKernel k :=
  fun y => ∑ j, diagonalConvolution (rho j) i (phi j) y

/-- Auxiliary definition for Proposition \ref{Cauchy-Schwarz at n-1}; see
`cauchySchwarzAtNMinusOne`. -/
def doublyCauchySchwarzKernel {k J : ℕ} (rho : Fin J → MKernel k)
    (phi : Fin J → ℝ → ℝ) (i : Fin k) : MKernel k :=
  fun y => ∑ j, diagonalConvolution (rho j) i (realConvolution (phi j) (phi j)) y

/--
\begin{proposition}[Cauchy-Schwarz at $k$]\label{Cauchy-Schwarz at k}
Let $k\in\N$ with $1\le k< n-1$ and $J\in \N_{>0}$. For $j\in [J)$, let
$\rho_j\in W_0((\R^2)^k)$ and let $\varphi_j\in W_0(\R)$ be real valued with
$\|\rho_j\|_1\le 1$. Let $i\in [k)$. Let
\begin{equation}\label{before CS}
M = \sum_{j\in [J)} \rho_j *_{e_i^0+e_i^1} \varphi_j.
\end{equation}
Then $M\in W_0((\R^2)^k)$.
\end{proposition}
-/
theorem cauchySchwarzKernel_memW0 (n k J : ℕ) (_hk : 1 ≤ k) (_hkn : k < n - 1)
    (_hJ : 1 ≤ J) (rho : Fin J → MKernel k) (phi : Fin J → ℝ → ℝ)
    (hrho : ∀ j, MemW0 (rho j))
    (hphi : ∀ j, MemW0 (phi j)) (i : Fin k) :
    MemW0 (cauchySchwarzKernel rho phi i) := by
  unfold cauchySchwarzKernel
  apply aux_memW0_finset_sum Finset.univ
  intro j _
  exact diagonalConvolution_memW0 k (rho j) (hrho j) i (phi j) (hphi j)

/--
\begin{proposition}[Cauchy-Schwarz at $n-1$]\label{Cauchy-Schwarz at n-1}
Let $J\in\N_{>0}$ and for $j\in [J)$, let
$\rho_j\in W_0((\R^2)^{n-1})$ and $\varphi_j\in W_0(\R)$ be real valued.
Let $i \in [n-1)$. Define
\begin{equation}\label{before CS 2}
    M=\sum_{j\in [J)} \rho_j *_{e_i^0+e_i^1} (\varphi_j * \varphi_j),
\end{equation}
Then $M\in W_0((\R^2)^{n-1})$.
\end{proposition}
-/
theorem doublyCauchySchwarzKernel_memW0 (n J : ℕ) (_hn : 1 ≤ n) (_hJ : 1 ≤ J)
    (rho : Fin J → MKernel (n - 1)) (phi : Fin J → ℝ → ℝ)
    (hrho : ∀ j, MemW0 (rho j)) (hphi : ∀ j, MemW0 (phi j)) (i : Fin (n - 1)) :
    MemW0 (doublyCauchySchwarzKernel rho phi i) := by
  unfold doublyCauchySchwarzKernel
  apply aux_memW0_finset_sum Finset.univ
  intro j _
  exact diagonalConvolution_memW0 (n - 1) (rho j) (hrho j) i
    (realConvolution (phi j) (phi j)) (aux_realConvolution_memW0 _ _ (hphi j) (hphi j))

/-- Auxiliary definition for Proposition \ref{Positivity M}; see `positivityM_nonnegative`. -/
def tensorSquareExtension (k : ℕ) (hk : 1 ≤ k) (i : Fin k) (tildeM : MKernel (k - 1))
    (phi : ℝ → ℝ) : MKernel k :=
  fun y => tildeM (aux_eraseVector k hk i y.1, aux_eraseVector k hk i y.2) *
    tensorSquare phi (y.1 i, y.2 i)

/-- Auxiliary for Proposition \ref{Positivity M}, formalized as `positivityM_memW0`. -/
theorem aux_tensorSquareExtension_memW0 (n k : ℕ) (hk : 1 ≤ k) (_hkn : k ≤ n)
    (i : Fin k) (tildeM : MKernel (k - 1)) (htildeM : MemW0 tildeM)
    (_htildeM_nonneg : ∀ y, 0 ≤ tildeM y) (phi : ℝ → ℝ) (hphi : MemW0 phi) :
    MemW0 (tensorSquareExtension k hk i tildeM phi) := by
  cases k with
  | zero => omega
  | succ d =>
      simp only [Nat.succ_sub_one] at tildeM htildeM ⊢
      have hErase (x : RealVector (d + 1)) :
          aux_eraseVector (d + 1) hk i x = eraseVector i x := by
        funext j
        simp [aux_eraseVector, eraseVector]
      have h := aux_memW0_tensorSquareExtensionSucc d i tildeM htildeM phi hphi
      change MemW0 (fun y : RealVector (d + 1) × RealVector (d + 1) =>
        tildeM (aux_eraseVector (d + 1) hk i y.1,
          aux_eraseVector (d + 1) hk i y.2) * tensorSquare phi (y.1 i, y.2 i))
      simpa only [hErase] using h

/--
\begin{proposition}[Positivity]\label{Positivity M}
Let $1\le k\le n$ and $i\in [k)$. Let $\tilde{M}\in W_0((\R^2)^{k-1})$ be nonnegative
and let $\phi\in W_0(\R)$ be real valued. Define for $y\in (\R^2)^k$,
\begin{equation}
    M(y)=\tilde{M}(y_{[k)\setminus i}) \phi^{\otimes 2}(y_i).
\end{equation}
Then $M\in W_0((\R^2)^k)$.
\end{proposition}
-/
theorem positivityM_memW0 (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n)
    (i : Fin k) (tildeM : MKernel (k - 1)) (htildeM : MemW0 tildeM)
    (htildeM_nonneg : ∀ y, 0 ≤ tildeM y) (phi : ℝ → ℝ) (hphi : MemW0 phi) :
    MemW0 (tensorSquareExtension k hk i tildeM phi) :=
  aux_tensorSquareExtension_memW0 n k hk hkn i tildeM htildeM htildeM_nonneg phi hphi

/--
\begin{definition}[prism form]\label{auto:prism-form-definition}
Let $1\le k\le n$. We define for $M\in W_0((\R^2)^k)$ and $\mathbf{F}\in\mathfrak{F}$,
\begin{equation}\label{auto:prism-form-formula}
\Lambda_k(M)(\mathbf{F}) := \Theta_k(K_k(M))(\mathbf{F}).
\end{equation}
\end{definition}
-/
def prismForm (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n) (M : MKernel k)
    (F : Fin n → RealVector n → ℝ) : ℝ :=
  prismBrascampLiebForm n k hk hkn (mToK k hk M) F

/-- Auxiliary for Proposition \ref{Positivity M}, formalized as `positivityM_nonnegative`. -/
def aux_nonlastIndex (n : ℕ) (i : Fin (n + 1)) (hi : i ≠ Fin.last n) : Fin n :=
  ⟨i.1, by
    by_contra h
    have hge : n ≤ i.1 := Nat.le_of_not_gt h
    have hle : i.1 ≤ n := Nat.le_of_lt_succ i.2
    have : i = Fin.last n := by
      apply Fin.ext
      simp only [Fin.last]
      omega
    exact hi this⟩

/-- Auxiliary for Proposition \ref{Positivity M}, formalized as `positivityM_nonnegative`. -/
theorem aux_nonlastIndex_castSucc (n : ℕ) (i : Fin (n + 1)) (hi : i ≠ Fin.last n) :
    (aux_nonlastIndex n i hi).castSucc = i := by
  apply Fin.ext
  rfl

/-- Auxiliary for Proposition \ref{Positivity M}, formalized as `positivityM_nonnegative`. -/
theorem aux_nonlastIndex_lt (n : ℕ) (i : Fin (n + 1)) (hi : i ≠ Fin.last n) :
    i.1 < n := by
  by_contra h
  have hge : n ≤ i.1 := Nat.le_of_not_gt h
  have hle : i.1 ≤ n := Nat.le_of_lt_succ i.2
  apply hi
  apply Fin.ext
  simp only [Fin.val_last]
  omega

/-- Auxiliary for Proposition \ref{Positivity M}, formalized as `positivityM_nonnegative`. -/
theorem aux_coordinateSum_insertNth (d : ℕ) (j : Fin (d + 1))
    (r : RealVector d) (q : ℝ) :
    coordinateSum (j.insertNth q r) = q + coordinateSum r := by
  unfold coordinateSum
  rw [Fin.sum_univ_succAbove]
  rw [Fin.insertNth_apply_same]
  congr 1
  apply Finset.sum_congr rfl
  intro a _
  exact Fin.insertNth_apply_succAbove (α := fun _ : Fin (d + 1) => ℝ) j q r a

/-- Auxiliary for Proposition \ref{Positivity M}, formalized as `positivityM_nonnegative`. -/
theorem aux_succAbove_last (d : ℕ) (i : Fin (d + 2))
    (hi : i ≠ Fin.last (d + 1)) :
    i.succAbove (Fin.last d) = Fin.last (d + 1) := by
  have hilt : i.1 < d + 1 := by
    by_contra h
    have hge : d + 1 ≤ i.1 := Nat.le_of_not_gt h
    have hle : i.1 ≤ d + 1 := Nat.le_of_lt_succ i.2
    apply hi
    apply Fin.ext
    simp only [Fin.val_last]
    omega
  have hnot : ¬ (Fin.last d).castSucc < i := by
    intro h
    have hlt : d < i.1 := by
      change d < i.1 at h
      exact h
    omega
  rw [Fin.succAbove_of_le_castSucc]
  · rfl
  · exact le_of_not_gt hnot

/-- Auxiliary for Proposition \ref{Positivity M}, formalized as `positivityM_nonnegative`. -/
theorem aux_succAbove_nonlast_comm (d : ℕ) (i : Fin (d + 2))
    (hi : i ≠ Fin.last (d + 1)) (a : Fin (d + 1)) (ha : a ≠ Fin.last d) :
    i.succAbove a =
      ((aux_nonlastIndex (d + 1) i hi).succAbove
        (aux_nonlastIndex d a ha)).castSucc := by
  have hi_eq : aux_nonlastIndex (d + 1) i hi = i.castPred hi := Fin.ext rfl
  have ha_eq : aux_nonlastIndex d a ha = a.castPred ha := Fin.ext rfl
  rw [hi_eq, ha_eq]
  exact (congrArg Fin.castSucc (Fin.castPred_succAbove_castPred hi ha)).symm

/-- Auxiliary for Proposition \ref{Positivity M}, formalized as `positivityM_nonnegative`. -/
theorem aux_mToKPoint_erase_nonlast (d : ℕ)
    (i : Fin (d + 2)) (hi : i ≠ Fin.last (d + 1))
    (z : RealVector (d + 2) × ℝ) (r : RealVector d) (q : ℝ) :
    (eraseVector i (mToKPoint (d + 2) (by omega) z
      ((aux_nonlastIndex (d + 1) i hi).insertNth q r)).1,
      eraseVector i (mToKPoint (d + 2) (by omega) z
        ((aux_nonlastIndex (d + 1) i hi).insertNth q r)).2) =
      mToKPoint (d + 1) (by omega) (eraseVector i z.1, z.2 - q) r := by
  let j : Fin (d + 1) := aux_nonlastIndex (d + 1) i hi
  have hsum : coordinateSum (j.insertNth q r) = q + coordinateSum r :=
    aux_coordinateSum_insertNth d j r q
  apply Prod.ext <;> funext a
  · by_cases ha : a = Fin.last d
    · subst a
      have hlast := aux_succAbove_last d i hi
      have htop : (⟨d + 1, by omega⟩ : Fin (d + 2)) = Fin.last (d + 1) := Fin.ext rfl
      have hbottom : (⟨d, by omega⟩ : Fin (d + 1)) = Fin.last d := Fin.ext rfl
      simp [eraseVector, mToKPoint, lastIndex, j, hlast, hsum, htop, hbottom]
      ring
    · let b : Fin d := aux_nonlastIndex d a ha
      have hcomm := aux_succAbove_nonlast_comm d i hi a ha
      have htop : (⟨d + 1, by omega⟩ : Fin (d + 2)) = Fin.last (d + 1) := Fin.ext rfl
      have hbottom : (⟨d, by omega⟩ : Fin (d + 1)) = Fin.last d := Fin.ext rfl
      have hglobal : i.succAbove a ≠ Fin.last (d + 1) := by
        rw [hcomm]
        exact Fin.ne_last_of_lt (j.succAbove b).castSucc_lt_last
      have hglobal_lt : (i.succAbove a).1 < d + 1 := by
        rw [hcomm]
        exact (j.succAbove b).isLt
      have hcast : (⟨(i.succAbove a).1, hglobal_lt⟩ : Fin (d + 1)) = j.succAbove b := by
        apply Fin.eq_of_val_eq
        change (i.succAbove a).1 = (j.succAbove b).1
        simpa [j, b] using congrArg (fun x : Fin (d + 2) => x.1) hcomm
      simp [eraseVector, mToKPoint, lastIndex, j, b, aux_nonlastIndex, ha, htop,
        hbottom, hglobal, hcast]
  · by_cases ha : a = Fin.last d
    · subst a
      have hlast := aux_succAbove_last d i hi
      have htop : (⟨d + 1, by omega⟩ : Fin (d + 2)) = Fin.last (d + 1) := Fin.ext rfl
      have hbottom : (⟨d, by omega⟩ : Fin (d + 1)) = Fin.last d := Fin.ext rfl
      simp [eraseVector, mToKPoint, lastIndex, j, hlast, hsum, htop, hbottom]
      ring
    · let b : Fin d := aux_nonlastIndex d a ha
      have hcomm := aux_succAbove_nonlast_comm d i hi a ha
      have htop : (⟨d + 1, by omega⟩ : Fin (d + 2)) = Fin.last (d + 1) := Fin.ext rfl
      have hbottom : (⟨d, by omega⟩ : Fin (d + 1)) = Fin.last d := Fin.ext rfl
      have hglobal : i.succAbove a ≠ Fin.last (d + 1) := by
        rw [hcomm]
        exact Fin.ne_last_of_lt (j.succAbove b).castSucc_lt_last
      have hglobal_lt : (i.succAbove a).1 < d + 1 := by
        rw [hcomm]
        exact (j.succAbove b).isLt
      have hcast : (⟨(i.succAbove a).1, hglobal_lt⟩ : Fin (d + 1)) = j.succAbove b := by
        apply Fin.eq_of_val_eq
        change (i.succAbove a).1 = (j.succAbove b).1
        simpa [j, b] using congrArg (fun x : Fin (d + 2) => x.1) hcomm
      simp [eraseVector, mToKPoint, lastIndex, j, b, aux_nonlastIndex, ha, htop,
        hbottom, hglobal, hcast]

/-- Auxiliary for Proposition \ref{Positivity M}, formalized as `positivityM_nonnegative`. -/
theorem aux_eraseVector_eq (d : ℕ) (i : Fin (d + 2))
    (x : RealVector (d + 2)) :
    aux_eraseVector (d + 2) (by omega) i x = eraseVector i x := by
  funext a
  simp [aux_eraseVector, eraseVector]

/-- Auxiliary for Proposition \ref{Positivity M}, formalized as `positivityM_nonnegative`. -/
theorem aux_mToKPoint_at_nonlast (d : ℕ)
    (i : Fin (d + 2)) (hi : i ≠ Fin.last (d + 1))
    (z : RealVector (d + 2) × ℝ) (r : RealVector d) (q : ℝ) :
    ((mToKPoint (d + 2) (by omega) z
        ((aux_nonlastIndex (d + 1) i hi).insertNth q r)).1 i,
      (mToKPoint (d + 2) (by omega) z
        ((aux_nonlastIndex (d + 1) i hi).insertNth q r)).2 i) =
      (z.1 i + q, q) := by
  let j : Fin (d + 1) := aux_nonlastIndex (d + 1) i hi
  have hj : j.castSucc = i := aux_nonlastIndex_castSucc (d + 1) i hi
  have htop : (⟨d + 1, by omega⟩ : Fin (d + 2)) = Fin.last (d + 1) := Fin.ext rfl
  have hi_top : i ≠ (⟨d + 1, by omega⟩ : Fin (d + 2)) := by
    rw [htop]
    exact hi
  have hi_lt := aux_nonlastIndex_lt (d + 1) i hi
  have hcast : (⟨i.1, hi_lt⟩ : Fin (d + 1)) = j := by
    apply Fin.eq_of_val_eq
    change i.1 = j.1
    simp [j, aux_nonlastIndex]
  have hins : (j.insertNth q r : RealVector (d + 1)) j = q := by
    exact Fin.insertNth_apply_same (α := fun _ : Fin (d + 1) => ℝ) j q r
  have hins' : ((aux_nonlastIndex (d + 1) i hi).insertNth q r : RealVector (d + 1)) j = q := by
    simp [j]
  apply Prod.ext
  · simp [mToKPoint, lastIndex, hi_top, hcast, hins']
  · simp [mToKPoint, lastIndex, hi_top, hcast, hins']

