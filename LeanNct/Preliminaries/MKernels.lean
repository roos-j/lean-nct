        (∫ r : RealVector d,
          tildeM (mToKPoint (d + 1) (by omega)
            (eraseVector (Fin.last (d + 1)) z.1, z.2 - q) r)) *
            phi (z.1 (Fin.last (d + 1)) + q) * phi q := by
      apply integral_congr_ae
      filter_upwards [] with q
      calc
        (∫ r : RealVector d, B (q, r)) = ∫ r : RealVector d,
            tildeM (mToKPoint (d + 1) (by omega)
              (eraseVector (Fin.last (d + 1)) z.1, z.2 - q) r) *
              phi (z.1 (Fin.last (d + 1)) + q) * phi q := by
          apply integral_congr_ae
          filter_upwards [] with r
          exact hB_eq q r
        _ = (∫ r : RealVector d,
            tildeM (mToKPoint (d + 1) (by omega)
              (eraseVector (Fin.last (d + 1)) z.1, z.2 - q) r)) *
              phi (z.1 (Fin.last (d + 1)) + q) * phi q := by
          rw [integral_mul_const, integral_mul_const]

