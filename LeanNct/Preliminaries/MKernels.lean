  let j : Fin (d + 1) := aux_nonlastIndex (d + 1) i hi
  have hM : MemW0 (tensorSquareExtension (d + 2) (by omega) i tildeM phi) := by
    have hErase (x : RealVector (d + 2)) :
        aux_eraseVector (d + 2) (by omega) i x = eraseVector i x := by
      funext a
      simp [aux_eraseVector, eraseVector]
    have h := aux_memW0_tensorSquareExtensionSucc (d + 1) i tildeM htildeM phi hphi
    change MemW0 (fun y : RealVector (d + 2) × RealVector (d + 2) =>
      tildeM (aux_eraseVector (d + 2) (by omega) i y.1,
        aux_eraseVector (d + 2) (by omega) i y.2) * tensorSquare phi (y.1 i, y.2 i))
    simpa only [hErase] using h
