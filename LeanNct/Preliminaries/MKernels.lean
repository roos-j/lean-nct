      M (mToKPoint (d + 1) (by omega) (z.1, sp.1) sp.2)) :=
    aux_memW0_integrable_of_addHaar hslice
  let t : ℝ × RealVector d → ℝ × RealVector d := fun qp => (z.2 - qp.1, qp.2)
