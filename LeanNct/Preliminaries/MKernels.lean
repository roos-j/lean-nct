theorem aux_measurePreserving_baseReorderOne (n : ℕ) :
    MeasurePreserving (aux_baseReorderOne n) volume volume := by
  let e1 := MeasurableEquiv.piUnique (fun _ : Fin 1 => ℝ)
  have he1 : MeasurePreserving e1 volume volume := by
    simpa [e1] using volume_preserving_piUnique (fun _ : Fin 1 => ℝ)
  have hpairs : MeasurePreserving (Prod.map e1 e1) volume volume := by
    simpa only [Measure.volume_eq_prod] using he1.prod he1
  have hright : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (RealVector (n - 1 + 1)))
        (MeasurableEquiv.prodCongr e1 e1)) volume volume := by
    change MeasurePreserving (Prod.map (id : RealVector (n - 1 + 1) → RealVector (n - 1 + 1))
      (Prod.map e1 e1)) volume volume
    simpa only [Measure.volume_eq_prod] using
      (MeasurePreserving.id (volume : Measure (RealVector (n - 1 + 1)))).prod hpairs
  have hswap : MeasurePreserving
      (MeasurableEquiv.prodComm :
        ((RealVector 1 × RealVector 1) × RealVector (n - 1 + 1)) ≃ᵐ
          (RealVector (n - 1 + 1) × (RealVector 1 × RealVector 1))) volume volume := by
    change MeasurePreserving (Prod.swap :
      ((RealVector 1 × RealVector 1) × RealVector (n - 1 + 1)) →
        (RealVector (n - 1 + 1) × (RealVector 1 × RealVector 1))) volume volume
    exact aux_volume_preserving_prod_swap
      (volume : Measure (RealVector 1 × RealVector 1))
      (volume : Measure (RealVector (n - 1 + 1)))
  change MeasurePreserving
    ((MeasurableEquiv.prodCongr (MeasurableEquiv.refl (RealVector (n - 1 + 1)))
      (MeasurableEquiv.prodCongr e1 e1)) ∘ MeasurableEquiv.prodComm) volume volume
  exact hright.comp hswap

