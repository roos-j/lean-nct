theorem aux_integral_product_square_nonnegative
    {P : Type*} [MeasurableSpace P] (μ : Measure P) [SFinite μ]
    (a : P → ℝ → ℝ)
    (hH : Integrable (fun q : P × (ℝ × ℝ) =>
      a q.1 q.2.1 * a q.1 q.2.2) (μ.prod volume)) :
    0 ≤ ∫ q : P × (ℝ × ℝ), a q.1 q.2.1 * a q.1 q.2.2 ∂(μ.prod volume) := by
  calc
    (∫ q : P × (ℝ × ℝ), a q.1 q.2.1 * a q.1 q.2.2 ∂(μ.prod volume)) =
        ∫ p : P, ∫ q : ℝ × ℝ, a p q.1 * a p q.2 ∂(volume : Measure (ℝ × ℝ)) ∂μ := by
          simpa only [Measure.volume_eq_prod] using
            (integral_prod (fun q : P × (ℝ × ℝ) => a q.1 q.2.1 * a q.1 q.2.2) hH)
    _ = ∫ p : P, (∫ r : ℝ, a p r) ^ 2 ∂μ := by
          apply integral_congr_ae
          filter_upwards [] with p
          rw [show (∫ q : ℝ × ℝ, a p q.1 * a p q.2 ∂(volume : Measure (ℝ × ℝ))) =
              (∫ r : ℝ, a p r) * ∫ r : ℝ, a p r by
            simpa only [Measure.volume_eq_prod] using integral_prod_mul (a p) (a p)]
          ring
    _ ≥ 0 := integral_nonneg fun p => sq_nonneg _

