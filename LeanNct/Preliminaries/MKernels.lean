/-- Auxiliary for Proposition \ref{Positivity M}, formalized as `positivityM_nonnegative`. -/
theorem aux_mToK_tensorSquareExtension_eq_positivity_last (d : ℕ)
    (tildeM : MKernel (d + 1)) (htildeM : MemW0 tildeM)
    (phi : ℝ → ℝ) (hphi : MemW0 phi) :
    mToK (d + 1 + 1) (by omega)
      (tensorSquareExtension (d + 1 + 1) (by omega) (Fin.last (d + 1)) tildeM phi) =
      positivityKernel (d + 1) (mToK (d + 1) (by omega) tildeM) phi
        (Fin.last (d + 1)) := by
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector d)) :=
    isAddHaarMeasure_volume_pi (Fin d)
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector (d + 1))) :=
    isAddHaarMeasure_volume_pi (Fin (d + 1))
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector (d + 1 + 1))) :=
    isAddHaarMeasure_volume_pi (Fin (d + 1 + 1))
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector d × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector (d + 1) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : NormedSpace ℝ (RealVector (d + 1)) := Pi.normedSpace
  have hM : MemW0
      (tensorSquareExtension (d + 1 + 1) (by omega) (Fin.last (d + 1)) tildeM phi) := by
    have hErase (x : RealVector (d + 1 + 1)) :
        aux_eraseVector (d + 1 + 1) (by omega) (Fin.last (d + 1)) x =
          eraseVector (Fin.last (d + 1)) x := by
      funext a
      simp [aux_eraseVector, eraseVector]
    have h := aux_memW0_tensorSquareExtensionSucc (d + 1) (Fin.last (d + 1))
      tildeM htildeM phi hphi
    change MemW0 (fun y : RealVector (d + 1 + 1) × RealVector (d + 1 + 1) =>
      tildeM (aux_eraseVector (d + 1 + 1) (by omega) (Fin.last (d + 1)) y.1,
        aux_eraseVector (d + 1 + 1) (by omega) (Fin.last (d + 1)) y.2) *
        tensorSquare phi (y.1 (Fin.last (d + 1)), y.2 (Fin.last (d + 1))))
    simpa only [hErase] using h
  funext z
  let e := aux_lastFibreEquiv d z.2
  have hE : MeasurePreserving e
      (volume : Measure (RealVector (d + 1)))
      ((volume : Measure ℝ).prod (volume : Measure (RealVector d))) :=
    aux_measurePreserving_lastFibreEquiv d z.2
  have hEinv := hE.symm e
  let A : RealVector (d + 1) → ℝ := fun p =>
    tensorSquareExtension (d + 1 + 1) (by omega) (Fin.last (d + 1)) tildeM phi
      (mToKPoint (d + 1 + 1) (by omega) z p)
  have hA : Integrable A := by
    have hW := mToK_integrand_memW0 (d + 1 + 1) (d + 1 + 1) (by omega) le_rfl
