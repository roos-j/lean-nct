    have hInt := aux_memW0_integrable_of_addHaar
      (E := RealVector (d + 1)) (K := ℝ) hW
    simpa [A] using hInt
  let B : RealVector d × ℝ → ℝ := fun rq =>
    A (j.insertNth rq.2 rq.1 : RealVector (d + 1))
  let C : ℝ × RealVector d → ℝ := fun qr =>
    A (j.insertNth qr.1 qr.2 : RealVector (d + 1))
  have hB : Integrable B := by
    have h := hinv.integrable_comp_of_integrable hA
    change Integrable (fun rq : RealVector d × ℝ =>
      A (((aux_eraseCoordinateSplit d j).toHomeomorph.toMeasurableEquiv).symm rq)) at h
    change Integrable (fun rq : RealVector d × ℝ =>
      A (j.insertNth rq.2 rq.1 : RealVector (d + 1)))
    exact h
  have hC : Integrable C := by
    have h := hswap.integrable_comp_of_integrable hB
    change Integrable (fun qr : ℝ × RealVector d =>
