  have hsum0 : coordinateSum p.1.1 = p.1.1 0 := aux_coordinateSum_finOne p.1.1
  have hcorner0 : cubeCorner p.1 (Fin.snoc (default : Fin 0 → Fin 2) (0 : Fin 2)) =
      (fun _ : Fin 1 => p.1.1 0) := by
    funext j
    fin_cases j
    simp [Fin.snoc_zero, cubeCorner]
  have hcorner1 : cubeCorner p.1 (Fin.snoc (default : Fin 0 → Fin 2) (1 : Fin 2)) =
      (fun _ : Fin 1 => p.1.2 0) := by
    funext j
    fin_cases j
    simp [Fin.snoc_zero, cubeCorner]
  have hprod :
      (∏ h : Fin 1 → Fin 2, ∏ i : Fin (n - 1 + 1),
        F (prismIndex (n := n) (k := 1) (by omega) hn i)
          (prismPoint (n := n) (k := 1) (by omega) hn p.1 p.2 h i)) =
      (∏ i : Fin (n - 1 + 1),
        F (prismIndex (n := n) (k := 1) (by omega) hn i)
          (concatVector n 1 hn (fun _ : Fin 1 => p.1.1 0) (eraseVector i p.2))) *
      (∏ i : Fin (n - 1 + 1),
        F (prismIndex (n := n) (k := 1) (by omega) hn i)
          (concatVector n 1 hn (fun _ : Fin 1 => p.1.2 0) (eraseVector i p.2))) := by
    rw [aux_prod_cubeCorners_snoc_two]
    simp only [Fintype.prod_unique]
    congr 1
    · apply Finset.prod_congr rfl
      intro i _
      rw [prismPoint]
      congr 2
    · apply Finset.prod_congr rfl
      intro i _
      rw [prismPoint]
      congr 2
  rw [hsum0, hprod]
  simp only [aux_rankOneRawIntegrand, aux_rankOneFactor]
  have hdiff : (p.1.2 - p.1.1 : RealVector 1) 0 = p.1.2 0 - p.1.1 0 := by rfl
  rw [hdiff]
  ring

/-- Auxiliary for Proposition \ref{Positivity M}, formalized as `positivityM_nonnegative`. -/
theorem aux_prism_one_rankOne_nonnegative
    (n : ℕ) (hn : 1 ≤ n) (c : ℝ) (hc : 0 ≤ c) (phi : ℝ → ℝ)
    (F : Fin n → SchwartzMap (RealVector n) ℝ)
    (K : KKernel 1) (hKmem : MemW0 K)
    (hK : ∀ u : RealVector 1 × ℝ,
      K u = c * phi (u.1 0 + u.2) * phi u.2) :
    0 ≤ prismBrascampLiebForm n 1 (by omega) hn K (fun i x => F i x) := by
  let A : RealVector (n - 1 + 1) → ℝ → ℝ :=
    fun x r => Real.sqrt c * aux_rankOneFactor n hn phi F x r
  let G : RealVector (n - 1 + 1) × (ℝ × ℝ) → ℝ :=
    fun q => A q.1 q.2.1 * A q.1 q.2.2
  let H : (RealVector 1 × RealVector 1) × RealVector (n - 1 + 1) → ℝ :=
    fun p => K (p.1.2 - p.1.1, coordinateSum p.1.1 + coordinateSum p.2) *
      ∏ h : Fin 1 → Fin 2, ∏ i : Fin (n - 1 + 1),
        F (prismIndex (n := n) (k := 1) (by omega) hn i)
          (prismPoint (n := n) (k := 1) (by omega) hn p.1 p.2 h i)
  have hH : Integrable H := by
    simpa [H] using aux_integrable_prismIntegrand n 1 (by omega) hn K hKmem F
  have hpoint (p : (RealVector 1 × RealVector 1) × RealVector (n - 1 + 1)) :
      H p = G (aux_baseReorderOne n p) := by
    dsimp [H]
    rw [aux_prism_one_integrand_eq_rankOneRaw n hn c phi F K hK p]
    rw [aux_baseReorderOne_apply]
    dsimp [aux_rankOneRawIntegrand, G, A]
    have hsqrt : Real.sqrt c ^ 2 = c := Real.sq_sqrt hc
    nth_rewrite 1 [← hsqrt]
    ring
  have hGcomp : Integrable (G ∘ aux_baseReorderOne n) := by
    refine hH.congr ?_
    filter_upwards [] with p
    exact hpoint p
  have hG : Integrable G := by
    let e := aux_baseReorderOne n
    have hinv : MeasurePreserving e.symm volume volume :=
      (aux_measurePreserving_baseReorderOne n).symm e
    have h := hinv.integrable_comp_of_integrable hGcomp
    refine h.congr ?_
    filter_upwards [] with q
    simp [e, Function.comp_def]
  have hGprod : Integrable (fun q : RealVector (n - 1 + 1) × (ℝ × ℝ) =>
      A q.1 q.2.1 * A q.1 q.2.2)
      ((volume : Measure (RealVector (n - 1 + 1))).prod volume) := by
    simpa only [G, Measure.volume_eq_prod] using hG
  have hnonneg :
      0 ≤ ∫ q : RealVector (n - 1 + 1) × (ℝ × ℝ),
        A q.1 q.2.1 * A q.1 q.2.2 := by
    simpa only [Measure.volume_eq_prod] using
      aux_integral_product_square_nonnegative (volume : Measure (RealVector (n - 1 + 1))) A hGprod
  change 0 ≤ ∫ y : RealVector 1 × RealVector 1,
    ∫ x : RealVector (n - 1 + 1), H (y, x)
  calc
    (∫ y : RealVector 1 × RealVector 1,
      ∫ x : RealVector (n - 1 + 1), H (y, x)) =
        ∫ p : (RealVector 1 × RealVector 1) × RealVector (n - 1 + 1), H p := by
          simpa only [Measure.volume_eq_prod] using
            (integral_prod H hH).symm
    _ = ∫ p : (RealVector 1 × RealVector 1) × RealVector (n - 1 + 1),
        G (aux_baseReorderOne n p) := by
          apply integral_congr_ae
          filter_upwards [] with p
          exact hpoint p
    _ = ∫ q : RealVector (n - 1 + 1) × (ℝ × ℝ), G q :=
      (aux_measurePreserving_baseReorderOne n).integral_comp' G
    _ ≥ 0 := by simpa only [G] using hnonneg

/-- Auxiliary for Proposition \ref{Positivity M}, formalized as `positivityM_nonnegative`. -/
theorem aux_integral_realVector_zero (f : RealVector 0 → ℝ) :
    (∫ p : RealVector 0, f p) = f default := by
  rw [integral_unique]
  have hvolume : (volume : Measure (RealVector 0)).real Set.univ = 1 := by
    rw [Measure.volume_pi_eq_dirac]
    simp
  rw [hvolume, one_smul]
  congr 1
  exact Subsingleton.elim _ _

/-- Auxiliary for Proposition \ref{Positivity M}, formalized as `positivityM_nonnegative`. -/
theorem aux_mToK_tensorSquareExtension_one_eq
    (tildeM : MKernel 0) (phi : ℝ → ℝ)
    (u : RealVector 1 × ℝ) :
    mToK 1 (by omega) (tensorSquareExtension 1 (by omega) (0 : Fin 1) tildeM phi) u =
      tildeM default * phi (u.1 0 + u.2) * phi u.2 := by
  have htilde (x : RealVector 0 × RealVector 0) : tildeM x = tildeM default := by
    congr 1
    exact Subsingleton.elim _ _
  unfold mToK
  rw [aux_integral_realVector_zero]
  simp only [tensorSquareExtension, Nat.add_one_sub_one, aux_eraseVector, mToKPoint, lastIndex,
    tsub_self, Fin.zero_eta, Fin.isValue, coordinateSum, Finset.univ_eq_empty, Pi.default_def,
    Finset.sum_const, Finset.card_empty, zero_nsmul, sub_zero, Fin.val_eq_zero, dite_eq_ite,
    Nat.reduceAdd, Fin.cast_eq_self, Fin.zero_succAbove, Fin.succ_ne_zero, ↓reduceIte, tensorSquare]
  rw [htilde]
  ring

/--
For all $\F\in {\mathfrak{F}}$,
\begin{equation}
    \Lambda_k(M)(\F)\ge 0.
\end{equation}
-/
theorem positivityM_nonnegative
    (n k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n)
    (i : Fin k) (tildeM : MKernel (k - 1)) (htildeM : MemW0 tildeM)
    (htildeM_nonneg : ∀ y, 0 ≤ tildeM y) (phi : ℝ → ℝ) (hphi : MemW0 phi)
    (F : Fin n → SchwartzMap (RealVector n) ℝ)
    (hF : F ∈ normalizedFunctionTuples n) :
    0 ≤ prismForm n k hk hkn (tensorSquareExtension k hk i tildeM phi) (fun a z => F a z) := by
  cases k with
  | zero => omega
  | succ k =>
    cases k with
    | zero =>
      have hi : i = (0 : Fin 1) := Fin.eq_zero i
      subst i
      have hM : MemW0 (tensorSquareExtension 1 hk 0 tildeM phi) :=
        positivityM_memW0 n 1 hk hkn 0 tildeM htildeM htildeM_nonneg phi hphi
      let K : KKernel 1 := mToK 1 hk (tensorSquareExtension 1 hk 0 tildeM phi)
      have hKmem : MemW0 K := by
        exact mToK_memW0 n 1 hk hkn (tensorSquareExtension 1 hk 0 tildeM phi) hM
      have hK : ∀ u : RealVector 1 × ℝ,
          K u = tildeM default * phi (u.1 0 + u.2) * phi u.2 := by
        intro u
        simpa [K] using aux_mToK_tensorSquareExtension_one_eq tildeM phi u
      have hc : 0 ≤ tildeM default := htildeM_nonneg default
      change 0 ≤ prismBrascampLiebForm n 1 hk hkn K (fun a z => F a z)
      exact aux_prism_one_rankOne_nonnegative n (by omega) (tildeM default) hc phi F K hKmem hK
    | succ d =>
      have hrho : MemW0 (mToK (d + 1) (by omega) tildeM) :=
        mToK_memW0 n (d + 1) (by omega) (by omega) tildeM htildeM
      have hrho_nonneg : ∀ u, 0 ≤ mToK (d + 1) (by omega) tildeM u := by
        intro u
        exact aux_mToK_nonnegative (d + 1) (by omega) tildeM htildeM_nonneg u
      by_cases hi : i = Fin.last (d + 1)
      · subst i
        unfold prismForm
        rw [aux_mToK_tensorSquareExtension_eq_positivity_last d tildeM htildeM phi hphi]
        exact positivityKernel_nonnegative n (d + 1) (by omega) (by omega)
          (mToK (d + 1) (by omega) tildeM) hrho hrho_nonneg phi hphi (Fin.last (d + 1)) F hF
      · unfold prismForm
        rw [aux_mToK_tensorSquareExtension_eq_positivity_nonlast d i hi tildeM htildeM phi hphi]
        exact positivityKernel_nonnegative n (d + 1) (by omega) (by omega)
          (mToK (d + 1) (by omega) tildeM) hrho hrho_nonneg phi hphi i F hF

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It translates a predecessor fibre to compensate a
diagonal shift in a nonfinal coordinate. -/
def aux_fibreTranslate (d : ℕ) (j : Fin d) (q : ℝ) (p : RealVector d) :
    RealVector d :=
  p + q • Pi.single j 1

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It records the coordinate-sum change under
`aux_fibreTranslate`. -/
theorem aux_coordinateSum_fibreTranslate (d : ℕ) (j : Fin d) (q : ℝ)
    (p : RealVector d) :
    coordinateSum (aux_fibreTranslate d j q p) = coordinateSum p + q := by
  rw [aux_fibreTranslate, aux_coordinateSum_add]
  congr 1
  change ∑ x : Fin d, q * (Pi.single j (1 : ℝ) : RealVector d) x = q
  rw [← Finset.mul_sum, Fintype.sum_pi_single', mul_one]

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It unfolds the final first coordinate of the
`mToKPoint` change of variables. -/
theorem aux_mToKPoint_fst_last (d : ℕ) (z : RealVector (d + 1) × ℝ)
    (p : RealVector d) :
    (mToKPoint (d + 1) (by omega) z p).1 (Fin.last d) =
      z.1 (Fin.last d) + z.2 - coordinateSum p := by
  have hlast : lastIndex (d + 1) (by omega) = Fin.last d := Fin.ext rfl
  simp [mToKPoint, hlast]

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It unfolds the final second coordinate of the
`mToKPoint` change of variables. -/
theorem aux_mToKPoint_snd_last (d : ℕ) (z : RealVector (d + 1) × ℝ)
    (p : RealVector d) :
    (mToKPoint (d + 1) (by omega) z p).2 (Fin.last d) =
      z.2 - coordinateSum p := by
  have hlast : lastIndex (d + 1) (by omega) = Fin.last d := Fin.ext rfl
  simp [mToKPoint, hlast]

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It unfolds a nonfinal first coordinate of the
`mToKPoint` change of variables. -/
theorem aux_mToKPoint_fst_castSucc (d : ℕ) (a : Fin d)
    (z : RealVector (d + 1) × ℝ) (p : RealVector d) :
    (mToKPoint (d + 1) (by omega) z p).1 a.castSucc =
      z.1 a.castSucc + p a := by
  have hlast : lastIndex (d + 1) (by omega) = Fin.last d := Fin.ext rfl
  have hne : a.castSucc ≠ Fin.last d := Fin.ne_last_of_lt a.castSucc_lt_last
  simp [mToKPoint, hlast, hne]

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It unfolds a nonfinal second coordinate of the
`mToKPoint` change of variables. -/
theorem aux_mToKPoint_snd_castSucc (d : ℕ) (a : Fin d)
    (z : RealVector (d + 1) × ℝ) (p : RealVector d) :
    (mToKPoint (d + 1) (by omega) z p).2 a.castSucc = p a := by
  have hlast : lastIndex (d + 1) (by omega) = Fin.last d := Fin.ext rfl
  have hne : a.castSucc ≠ Fin.last d := Fin.ne_last_of_lt a.castSucc_lt_last
  simp [mToKPoint, hlast, hne]

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It transports a diagonal shift in a nonfinal
coordinate through `mToKPoint`. -/
theorem aux_mToKPoint_diagonalShift_nonlast (d : ℕ) (j : Fin d)
    (z : RealVector (d + 1) × ℝ) (p : RealVector d) (q : ℝ) :
    aux_diagonalShift
      (mToKPoint (d + 1) (by omega) z (aux_fibreTranslate d j q p))
      j.castSucc q =
    mToKPoint (d + 1) (by omega) (z.1, z.2 - q) p := by
  have hsum := aux_coordinateSum_fibreTranslate d j q p
  apply Prod.ext <;> funext a
  · refine Fin.lastCases ?_ (fun a => ?_) a
    · have hne : (Fin.last d) ≠ j.castSucc :=
        (Fin.ne_last_of_lt j.castSucc_lt_last).symm
      simp [aux_diagonalShift, hne, aux_mToKPoint_fst_last, hsum]; ring
    · by_cases haj : a = j
      · subst a
        simp [aux_diagonalShift, aux_mToKPoint_fst_castSucc, aux_fibreTranslate]; ring
      · have hne : a.castSucc ≠ j.castSucc := by
          intro h
          apply haj
          apply Fin.ext
          simpa using congrArg Fin.val h
        simp [aux_diagonalShift, hne, aux_mToKPoint_fst_castSucc, aux_fibreTranslate, haj]
  · refine Fin.lastCases ?_ (fun a => ?_) a
    · have hne : (Fin.last d) ≠ j.castSucc :=
        (Fin.ne_last_of_lt j.castSucc_lt_last).symm
      simp [aux_diagonalShift, hne, aux_mToKPoint_snd_last, hsum]; ring
    · by_cases haj : a = j
      · subst a
        simp [aux_diagonalShift, aux_mToKPoint_snd_castSucc, aux_fibreTranslate]
      · have hne : a.castSucc ≠ j.castSucc := by
          intro h
          apply haj
          apply Fin.ext
          simpa using congrArg Fin.val h
        simp [aux_diagonalShift, hne, aux_mToKPoint_snd_castSucc, aux_fibreTranslate, haj]

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It transports a diagonal shift in the final
coordinate through `mToKPoint`. -/
theorem aux_mToKPoint_diagonalShift_last (d : ℕ)
    (z : RealVector (d + 1) × ℝ) (p : RealVector d) (q : ℝ) :
    aux_diagonalShift
      (mToKPoint (d + 1) (by omega) z p)
      (Fin.last d) q =
    mToKPoint (d + 1) (by omega) (z.1, z.2 - q) p := by
  apply Prod.ext <;> funext a
  · refine Fin.lastCases ?_ (fun a => ?_) a
    · simp [aux_diagonalShift, aux_mToKPoint_fst_last]
      ring
    · have hne : a.castSucc ≠ Fin.last d := Fin.ne_last_of_lt a.castSucc_lt_last
      simp [aux_diagonalShift, hne, aux_mToKPoint_fst_castSucc]
  · refine Fin.lastCases ?_ (fun a => ?_) a
    · simp [aux_diagonalShift, aux_mToKPoint_snd_last]
      ring
    · have hne : a.castSucc ≠ Fin.last d := Fin.ne_last_of_lt a.castSucc_lt_last
      simp [aux_diagonalShift, hne, aux_mToKPoint_snd_castSucc]

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It names the external variables in the raw
diagonal-convolution change of variables. -/
abbrev aux_mToKDiagonalZSpace (k : ℕ) := RealVector k × ℝ

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It names the predecessor fibre in the raw
diagonal-convolution change of variables. -/
abbrev aux_mToKDiagonalPSpace (k : ℕ) := RealVector (k - 1)

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It groups the variables needed for the raw
diagonal-convolution Fubini calculation. -/
abbrev aux_mToKDiagonalQSpace (k : ℕ) :=
  aux_mToKDiagonalZSpace k × (aux_mToKDiagonalPSpace k × ℝ)

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It reassociates the variables of the raw
diagonal-convolution change of variables. -/
noncomputable def aux_mToKDiagonalRawAssoc (k : ℕ) :
    aux_mToKDiagonalQSpace k ≃L[ℝ]
      ((aux_mToKDiagonalZSpace k × aux_mToKDiagonalPSpace k) × ℝ) :=
  (ContinuousLinearEquiv.prodAssoc ℝ (RealVector k × ℝ) (RealVector (k - 1)) ℝ).symm

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It is the global linear change of variables whose
fibres give the raw diagonal-convolution integrands. -/
noncomputable def aux_mToKDiagonalRawEquiv (k : ℕ) (hk : 1 ≤ k) (i : Fin k) :
    aux_mToKDiagonalQSpace k ≃L[ℝ]
      ((RealVector k × RealVector k) × ℝ) :=
  ((aux_mToKDiagonalRawAssoc k).trans
    ((aux_mToKContinuousLinearEquiv k hk).prodCongr (ContinuousLinearEquiv.refl ℝ ℝ))).trans
    (aux_convolutionAlongShear (diagonalDirection k i))

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It gives the coordinate formula for
`aux_mToKDiagonalRawEquiv`. -/
theorem aux_mToKDiagonalRawEquiv_apply (k : ℕ) (hk : 1 ≤ k) (i : Fin k)
    (z : RealVector k × ℝ) (p : RealVector (k - 1)) (q : ℝ) :
    aux_mToKDiagonalRawEquiv k hk i (z, (p, q)) =
      (aux_diagonalShift (mToKPoint k hk z p) i q, q) := by
  simp [aux_mToKDiagonalRawEquiv, aux_mToKDiagonalRawAssoc, aux_convolutionAlongShear,
    aux_mToKContinuousLinearEquiv, aux_mToKLinearEquiv,
    aux_sub_smul_diagonalDirection]

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It supplies the Fubini integrability certificate
for the raw diagonal-convolution calculation. -/
theorem aux_integrable_mToKDiagonalRaw (k : ℕ) (hk : 1 ≤ k)
    (rho : MKernel k) (hrho : MemW0 rho) (phi : ℝ → ℝ) (hphi : MemW0 phi)
    (i : Fin k) (z : RealVector k × ℝ) :
    Integrable (fun pq : RealVector (k - 1) × ℝ =>
      rho (aux_diagonalShift (mToKPoint k hk z pq.1) i pq.2) * phi pq.2) := by
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k)) :=
    isAddHaarMeasure_volume_pi (Fin k)
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector (k - 1))) :=
    isAddHaarMeasure_volume_pi (Fin (k - 1))
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure (RealVector (k - 1) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure ((RealVector k × ℝ) × (RealVector (k - 1) × ℝ))) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure (RealVector k × RealVector k)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure ((RealVector k × RealVector k) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let H : (RealVector k × RealVector k) × ℝ → ℝ := fun yq => rho yq.1 * phi yq.2
  have hH : MemW0 H := by
    simpa [H] using hrho.aux_mul_prod hphi
  have hG : MemW0 (H ∘ aux_mToKDiagonalRawEquiv k hk i) :=
    aux_memW0_comp_continuousLinearEquiv hH (aux_mToKDiagonalRawEquiv k hk i)
  have hs := hG.aux_memW0_slice_of_addHaar z
  change MemW0 (fun pq : RealVector (k - 1) × ℝ =>
    rho ((aux_mToKDiagonalRawEquiv k hk i) (z, pq)).1 *
      phi ((aux_mToKDiagonalRawEquiv k hk i) (z, pq)).2) at hs
  have hs' : MemW0 (fun pq : RealVector (k - 1) × ℝ =>
      rho (aux_diagonalShift (mToKPoint k hk z pq.1) i pq.2) * phi pq.2) := by
    have heq : (fun pq : RealVector (k - 1) × ℝ =>
        rho ((aux_mToKDiagonalRawEquiv k hk i) (z, pq)).1 *
          phi ((aux_mToKDiagonalRawEquiv k hk i) (z, pq)).2) =
        fun pq : RealVector (k - 1) × ℝ =>
          rho (aux_diagonalShift (mToKPoint k hk z pq.1) i pq.2) * phi pq.2 := by
      funext pq
      rcases pq with ⟨p, q⟩
      simp [aux_mToKDiagonalRawEquiv_apply]
    rw [heq] at hs
    exact hs
  exact aux_memW0_integrable_of_addHaar hs'

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It proves the M-to-K convolution identity when
the shifted coordinate is final. -/
theorem aux_mToK_diagonalConvolution_last (d : ℕ)
    (rho : MKernel (d + 1)) (hrho : MemW0 rho)
    (phi : ℝ → ℝ) (hphi : MemW0 phi) :
    mToK (d + 1) (by omega) (diagonalConvolution rho (Fin.last d) phi) =
      fun z => ∫ q : ℝ, mToK (d + 1) (by omega) rho (z.1, z.2 - q) * phi q := by
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector d)) :=
    isAddHaarMeasure_volume_pi (Fin d)
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector (d + 1))) :=
    isAddHaarMeasure_volume_pi (Fin (d + 1))
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector d × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure (volume : Measure (ℝ × RealVector d)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  funext z
  let A : RealVector d × ℝ → ℝ := fun pq =>
    rho (aux_diagonalShift (mToKPoint (d + 1) (by omega) z pq.1)
      (Fin.last d) pq.2) * phi pq.2
  have hA : Integrable A := by
    convert aux_integrable_mToKDiagonalRaw (d + 1) (by omega)
      rho hrho phi hphi (Fin.last d) z using 1 <;> rfl
  let C : ℝ × RealVector d → ℝ := fun qp => A (qp.2, qp.1)
  have hswap : MeasurePreserving
      (MeasurableEquiv.prodComm : ℝ × RealVector d ≃ᵐ RealVector d × ℝ)
      volume volume := by
    change MeasurePreserving (Prod.swap : ℝ × RealVector d → RealVector d × ℝ)
      ((volume : Measure ℝ).prod (volume : Measure (RealVector d)))
      ((volume : Measure (RealVector d)).prod (volume : Measure ℝ))
    exact aux_volume_preserving_prod_swap (volume : Measure ℝ) (volume : Measure (RealVector d))
  have hC : Integrable C := by
    have h := hswap.integrable_comp_of_integrable hA
    change Integrable (fun qp : ℝ × RealVector d => A (MeasurableEquiv.prodComm qp)) at h
    exact h
  have hFubini :
      (∫ p : RealVector d, ∫ q : ℝ, A (p, q)) =
        ∫ q : ℝ, ∫ p : RealVector d, A (p, q) := by
    calc
      (∫ p : RealVector d, ∫ q : ℝ, A (p, q)) =
          ∫ pq : RealVector d × ℝ, A pq := by
            simpa only [Measure.volume_eq_prod] using (integral_prod A hA).symm
      _ = ∫ qp : ℝ × RealVector d, C qp := by
            exact (hswap.integral_comp' A).symm
      _ = ∫ q : ℝ, ∫ p : RealVector d, A (p, q) := by
            simpa only [C, Measure.volume_eq_prod] using integral_prod C hC
  unfold mToK diagonalConvolution
  change (∫ p : RealVector d, ∫ q : ℝ,
      rho (aux_diagonalShift (mToKPoint (d + 1) (by omega) z p) (Fin.last d) q) *
        phi q) =
      ∫ q : ℝ, (∫ p : RealVector d,
        rho (mToKPoint (d + 1) (by omega) (z.1, z.2 - q) p)) * phi q
  rw [show (∫ p : RealVector d, ∫ q : ℝ,
      rho (aux_diagonalShift (mToKPoint (d + 1) (by omega) z p) (Fin.last d) q) *
        phi q) = ∫ p : RealVector d, ∫ q : ℝ, A (p, q) by rfl]
  rw [hFubini]
  apply integral_congr_ae
  filter_upwards [] with q
  calc
    (∫ p : RealVector d, A (p, q)) = ∫ p : RealVector d,
        rho (mToKPoint (d + 1) (by omega) (z.1, z.2 - q) p) * phi q := by
      apply integral_congr_ae
      filter_upwards [] with p
      rw [show A (p, q) =
        rho (aux_diagonalShift (mToKPoint (d + 1) (by omega) z p) (Fin.last d) q) * phi q by
          rfl, aux_mToKPoint_diagonalShift_last]
    _ = (∫ p : RealVector d,
        rho (mToKPoint (d + 1) (by omega) (z.1, z.2 - q) p)) * phi q := by
      rw [integral_mul_const]

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It proves the M-to-K convolution identity when
the shifted coordinate is nonfinal. -/
theorem aux_mToK_diagonalConvolution_nonlast (d : ℕ) (j : Fin d)
    (rho : MKernel (d + 1)) (hrho : MemW0 rho)
    (phi : ℝ → ℝ) (hphi : MemW0 phi) :
    mToK (d + 1) (by omega) (diagonalConvolution rho j.castSucc phi) =
      fun z => ∫ q : ℝ, mToK (d + 1) (by omega) rho (z.1, z.2 - q) * phi q := by
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector d)) :=
    isAddHaarMeasure_volume_pi (Fin d)
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector (d + 1))) :=
    isAddHaarMeasure_volume_pi (Fin (d + 1))
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector d × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure (volume : Measure (ℝ × RealVector d)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  funext z
  let A : RealVector d × ℝ → ℝ := fun pq =>
    rho (aux_diagonalShift (mToKPoint (d + 1) (by omega) z pq.1)
      j.castSucc pq.2) * phi pq.2
  have hA : Integrable A := by
    convert aux_integrable_mToKDiagonalRaw (d + 1) (by omega)
      rho hrho phi hphi j.castSucc z using 1 <;> rfl
  let C : ℝ × RealVector d → ℝ := fun qp => A (qp.2, qp.1)
  have hswap : MeasurePreserving
      (MeasurableEquiv.prodComm : ℝ × RealVector d ≃ᵐ RealVector d × ℝ)
      volume volume := by
    change MeasurePreserving (Prod.swap : ℝ × RealVector d → RealVector d × ℝ)
      ((volume : Measure ℝ).prod (volume : Measure (RealVector d)))
      ((volume : Measure (RealVector d)).prod (volume : Measure ℝ))
    exact aux_volume_preserving_prod_swap (volume : Measure ℝ) (volume : Measure (RealVector d))
  have hC : Integrable C := by
    have h := hswap.integrable_comp_of_integrable hA
    change Integrable (fun qp : ℝ × RealVector d => A (MeasurableEquiv.prodComm qp)) at h
    exact h
  have hFubini :
      (∫ p : RealVector d, ∫ q : ℝ, A (p, q)) =
        ∫ q : ℝ, ∫ p : RealVector d, A (p, q) := by
    calc
      (∫ p : RealVector d, ∫ q : ℝ, A (p, q)) =
          ∫ pq : RealVector d × ℝ, A pq := by
            simpa only [Measure.volume_eq_prod] using (integral_prod A hA).symm
      _ = ∫ qp : ℝ × RealVector d, C qp := by
            exact (hswap.integral_comp' A).symm
      _ = ∫ q : ℝ, ∫ p : RealVector d, A (p, q) := by
            simpa only [C, Measure.volume_eq_prod] using integral_prod C hC
  unfold mToK diagonalConvolution
  change (∫ p : RealVector d, ∫ q : ℝ,
      rho (aux_diagonalShift (mToKPoint (d + 1) (by omega) z p) j.castSucc q) *
        phi q) =
      ∫ q : ℝ, (∫ p : RealVector d,
        rho (mToKPoint (d + 1) (by omega) (z.1, z.2 - q) p)) * phi q
  rw [show (∫ p : RealVector d, ∫ q : ℝ,
      rho (aux_diagonalShift (mToKPoint (d + 1) (by omega) z p) j.castSucc q) *
        phi q) = ∫ p : RealVector d, ∫ q : ℝ, A (p, q) by rfl]
  rw [hFubini]
  apply integral_congr_ae
  filter_upwards [] with q
  let e : MeasurableEquiv (RealVector d) (RealVector d) :=
    MeasurableEquiv.addRight (q • Pi.single j 1)
  have he : MeasurePreserving e volume volume := by
    change MeasurePreserving (fun p : RealVector d => p + q • Pi.single j 1) volume volume
    exact measurePreserving_add_right (volume : Measure (RealVector d)) _
  calc
    (∫ p : RealVector d, A (p, q)) = ∫ p : RealVector d, A (e p, q) := by
      exact (he.integral_comp' (fun p : RealVector d => A (p, q))).symm
    _ = ∫ p : RealVector d,
        rho (mToKPoint (d + 1) (by omega) (z.1, z.2 - q) p) * phi q := by
      apply integral_congr_ae
      filter_upwards [] with p
      change rho (aux_diagonalShift
        (mToKPoint (d + 1) (by omega) z (aux_fibreTranslate d j q p))
        j.castSucc q) * phi q = _
      rw [aux_mToKPoint_diagonalShift_nonlast]
    _ = (∫ p : RealVector d,
        rho (mToKPoint (d + 1) (by omega) (z.1, z.2 - q) p)) * phi q := by
      rw [integral_mul_const]

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It identifies diagonal convolution on an arbitrary
M-coordinate with one-dimensional convolution after the M-to-K map. -/
theorem aux_mToK_diagonalConvolution
    (k : ℕ) (hk : 1 ≤ k) (rho : MKernel k) (hrho : MemW0 rho)
    (phi : ℝ → ℝ) (hphi : MemW0 phi) (i : Fin k) :
    mToK k hk (diagonalConvolution rho i phi) =
      fun z => ∫ q : ℝ, mToK k hk rho (z.1, z.2 - q) * phi q := by
  cases k with
  | zero => exact Fin.elim0 i
  | succ d =>
    refine Fin.lastCases ?_ (fun j => ?_) i
    · simpa using aux_mToK_diagonalConvolution_last d rho hrho phi hphi
    · simpa using aux_mToK_diagonalConvolution_nonlast d j rho hrho phi hphi

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It bounds the absolute value of an M-to-K fibre
integral by the M-to-K image of the absolute kernel. -/
theorem aux_abs_mToK_le_mToK_abs (k : ℕ) (hk : 1 ≤ k) (M : MKernel k)
    (z : RealVector k × ℝ) :
    |mToK k hk M z| ≤ mToK k hk (fun y => |M y|) z := by
  unfold mToK
  simpa using
    (abs_integral_le_integral_abs
      (f := fun p : RealVector (k - 1) => M (mToKPoint k hk z p)))

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It gives the pointwise nonnegativity of the M-to-K
image of an absolute kernel. -/
theorem aux_mToK_abs_nonnegative (k : ℕ) (hk : 1 ≤ k) (M : MKernel k)
    (z : RealVector k × ℝ) :
    0 ≤ mToK k hk (fun y => |M y|) z := by
  unfold mToK
  apply integral_nonneg
  intro p
  exact abs_nonneg _

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It writes the K-level Cauchy--Schwarz lift as a
finite sum of monotonicity kernels. -/
theorem aux_singlyCancellativeLift_eq_sum_monotonicity
    (k J : ℕ) (rho : Fin J → KKernel k) (phi : Fin J → ℝ → ℝ) :
    singlyCancellativeLift k J rho phi = fun u =>
      ∑ j, monotonicityKernel k (fun v => |rho j v|) (phi j) u := by
  funext u
  unfold singlyCancellativeLift monotonicityKernel positivityKernel
  apply Finset.sum_congr rfl
  intro j _
  apply integral_congr_ae
  filter_upwards [] with q
  congr 3
  congr 1
  apply Prod.ext
  · funext a
    simp [eraseVector]
  · rfl

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It rewrites the M-level Cauchy--Schwarz lift as a
sum of tensor-square extensions. -/
theorem aux_cauchySchwarzLift_eq_sum_tensorSquareExtension
    (k J : ℕ) (rho : Fin J → MKernel k) (phi : Fin J → ℝ → ℝ) :
    cauchySchwarzLift rho phi = fun y => ∑ j,
      tensorSquareExtension (k + 1) (by omega) (Fin.last k)
        (fun x => |rho j x|) (phi j) y := by
  have herase (x : RealVector (k + 1)) :
      aux_eraseVector (k + 1) (by omega) (Fin.last k) x =
        fun i => x i.castSucc := by
    funext i
    simp [aux_eraseVector]
  funext y
  unfold cauchySchwarzLift tensorSquareExtension
  simp only [herase]
  rfl

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It commutes the M-to-K map with the finite kernel
sum used in the Cauchy--Schwarz decomposition. -/
theorem aux_mToK_finset_sum
    (k J : ℕ) (hk : 1 ≤ k) (M : Fin J → MKernel k)
    (hM : ∀ j, MemW0 (M j)) :
    mToK k hk (fun y => ∑ j, M j y) = fun z => ∑ j, mToK k hk (M j) z := by
  funext z
  unfold mToK
  rw [integral_finsetSum]
  intro j _
  exact aux_memW0_integrable_of_addHaar
    (mToK_integrand_memW0 k k hk le_rfl (M j) (hM j) z)

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It identifies the M-to-K image of the original
Cauchy--Schwarz kernel with the singly cancellative K-kernel. -/
theorem aux_mToK_cauchySchwarzKernel_eq_singlyCancellative
    (k J : ℕ) (hk : 1 ≤ k) (rho : Fin J → MKernel k) (phi : Fin J → ℝ → ℝ)
    (hrho : ∀ j, MemW0 (rho j)) (hphi : ∀ j, MemW0 (phi j)) (i : Fin k) :
    mToK k hk (cauchySchwarzKernel rho phi i) =
      singlyCancellativeKernel k J (fun j => mToK k hk (rho j)) phi := by
  unfold cauchySchwarzKernel
  rw [aux_mToK_finset_sum k J hk]
  · funext z
    unfold singlyCancellativeKernel
    apply Finset.sum_congr rfl
    intro j _
    exact congrFun (aux_mToK_diagonalConvolution k hk (rho j) (hrho j)
      (phi j) (hphi j) i) z
  · intro j
    exact diagonalConvolution_memW0 k (rho j) (hrho j) i (phi j) (hphi j)

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It identifies the M-to-K image of the
Cauchy--Schwarz lift in successor dimension. -/
theorem aux_mToK_cauchySchwarzLift_succ
    (d J : ℕ) (rho : Fin J → MKernel (d + 1)) (phi : Fin J → ℝ → ℝ)
    (hrho : ∀ j, MemW0 (rho j)) (hphi : ∀ j, MemW0 (phi j)) :
    mToK (d + 1 + 1) (by omega) (cauchySchwarzLift rho phi) =
      singlyCancellativeLift (d + 1) J
        (fun j => mToK (d + 1) (by omega) (fun y => |rho j y|)) phi := by
  have hSummand (j : Fin J) :
      MemW0 (tensorSquareExtension (d + 1 + 1) (by omega) (Fin.last (d + 1))
        (fun y => |rho j y|) (phi j)) := by
    exact positivityM_memW0 (d + 1 + 1) (d + 1 + 1) (by omega) le_rfl
      (Fin.last (d + 1)) (fun y => |rho j y|) (aux_memW0_abs (hrho j))
      (fun y => abs_nonneg _) (phi j) (hphi j)
  rw [aux_cauchySchwarzLift_eq_sum_tensorSquareExtension (d + 1) J rho phi]
  rw [aux_mToK_finset_sum (d + 1 + 1) J (by omega)
    (fun j => tensorSquareExtension (d + 1 + 1) (by omega) (Fin.last (d + 1))
      (fun y => |rho j y|) (phi j)) hSummand]
  rw [aux_singlyCancellativeLift_eq_sum_monotonicity]
  have hKabs_nonneg (j : Fin J) (v : RealVector (d + 1) × ℝ) :
      0 ≤ mToK (d + 1) (by omega) (fun y => |rho j y|) v :=
    aux_mToK_abs_nonnegative (d + 1) (by omega) (rho j) v
  have habs (j : Fin J) :
      (fun v => |mToK (d + 1) (by omega) (fun y => |rho j y|) v|) =
        fun v => mToK (d + 1) (by omega) (fun y => |rho j y|) v := by
    funext v
    exact abs_of_nonneg (hKabs_nonneg j v)
  simp_rw [habs]
  funext z
  apply Finset.sum_congr rfl
  intro j _
  change mToK (d + 1 + 1) (by omega)
      (tensorSquareExtension (d + 1 + 1) (by omega) (Fin.last (d + 1))
        (fun y => |rho j y|) (phi j)) z =
    positivityKernel (d + 1) (mToK (d + 1) (by omega) (fun y => |rho j y|))
      (phi j) (Fin.last (d + 1)) z
  exact congrFun
    (aux_mToK_tensorSquareExtension_eq_positivity_last d
      (fun y => |rho j y|) (aux_memW0_abs (hrho j)) (phi j) (hphi j)) z

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It identifies the M-to-K image of the
Cauchy--Schwarz lift in every positive dimension. -/
theorem aux_mToK_cauchySchwarzLift
    (k J : ℕ) (hk : 1 ≤ k) (rho : Fin J → MKernel k) (phi : Fin J → ℝ → ℝ)
    (hrho : ∀ j, MemW0 (rho j)) (hphi : ∀ j, MemW0 (phi j)) :
    mToK (k + 1) (by omega) (cauchySchwarzLift rho phi) =
      singlyCancellativeLift k J
        (fun j => mToK k hk (fun y => |rho j y|)) phi := by
  cases k with
  | zero => omega
  | succ d =>
      simpa [Nat.succ_eq_add_one] using
        aux_mToK_cauchySchwarzLift_succ d J rho phi hrho hphi

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at k}, formalized as
`cauchySchwarzAtK_bound`.  It gives the finite-sum linearity of the prism
Brascamp--Lieb form needed to apply monotonicity term by term. -/
theorem aux_prismBrascampLiebForm_finset_sum
    (n l J : ℕ) (hl : 1 ≤ l) (hln : l ≤ n)
    (K : Fin J → KKernel l) (hK : ∀ j, MemW0 (K j))
    (F : Fin n → SchwartzMap (RealVector n) ℝ) :
    prismBrascampLiebForm n l hl hln (fun u => ∑ j, K j u) (fun i x => F i x) =
      ∑ j, prismBrascampLiebForm n l hl hln (K j) (fun i x => F i x) := by
  let P : KKernel l → ((RealVector l × RealVector l) × RealVector (n - l + 1)) → ℝ :=
    fun L p => L (p.1.2 - p.1.1, coordinateSum p.1.1 + coordinateSum p.2) *
      ∏ h : Fin l → Fin 2, ∏ i : Fin (n - l + 1),
        F (prismIndex hl hln i) (prismPoint hl hln p.1 p.2 h i)
  have hKsum : MemW0 (fun u => ∑ j, K j u) :=
    aux_memW0_finset_sum Finset.univ K (fun j _ => hK j)
  have hPsum : Integrable (P (fun u => ∑ j, K j u)) := by
    simpa [P] using aux_integrable_prismIntegrand n l hl hln
      (fun u => ∑ j, K j u) hKsum F
  have hP (j : Fin J) : Integrable (P (K j)) := by
    simpa [P] using aux_integrable_prismIntegrand n l hl hln (K j) (hK j) F
  change (∫ y : RealVector l × RealVector l, ∫ x : RealVector (n - l + 1),
      P (fun u => ∑ j, K j u) (y, x)) =
    ∑ j, ∫ y : RealVector l × RealVector l, ∫ x : RealVector (n - l + 1), P (K j) (y, x)
  calc
    (∫ y : RealVector l × RealVector l, ∫ x : RealVector (n - l + 1),
        P (fun u => ∑ j, K j u) (y, x)) =
      ∫ p, P (fun u => ∑ j, K j u) p := by
        simpa only [Measure.volume_eq_prod] using
          (integral_prod (P (fun u => ∑ j, K j u)) hPsum).symm
    _ = ∫ p, ∑ j, P (K j) p := by
      apply integral_congr_ae
      filter_upwards [] with p
      dsimp [P]
      rw [Finset.sum_mul]
    _ = ∑ j, ∫ p, P (K j) p := by
      rw [integral_finsetSum]
      intro j _
      exact hP j
    _ = ∑ j, ∫ y : RealVector l × RealVector l, ∫ x : RealVector (n - l + 1),
        P (K j) (y, x) := by
      apply Finset.sum_congr rfl
      intro j _
      simpa only [Measure.volume_eq_prod] using (integral_prod (P (K j)) (hP j))

/--
\begin{proposition}[Cauchy-Schwarz at $k$]\label{Cauchy-Schwarz at k}
\using{single cancellative Cauchy-Schwarz}\using{Monotonicity K}\using{M to K}
Let $k,J\in\N$ with $1\le k<n-1$ and $J\ge1$. For $j\in[J)$, let $\rho_j\in W_0((\R^2)^k)$
and let $\varphi_j\in W_0(\R)$ be real valued. Let $i\in[k)$. Let $M\in W_0((\R^2)^k)$
and $\widetilde M\in W_0((\R^2)^{k+1})$ be defined by
\begin{equation}\label{before CS}
M=\sum_{j\in[J)}\rho_j*_{e_i^0+e_i^1}\varphi_j,
\end{equation}
and, for $y\in(\R^2)^{k+1}$,
\begin{equation}\label{Cauchy Schwarz tilde M definition}
\widetilde M(y)=\sum_{j\in[J)}|\rho_j(y_{[k)})|\varphi_j^{\otimes2}(y_k).
\end{equation}
Then for all $\F\in\mathfrak F$,
\begin{equation}\label{Cauchy Schwarz at k estimate}
|\Lambda_k(M)(\F)|
\le
|\Lambda_{k+1}(\widetilde M)(\F)|^{1/2}
\Big(\sum_{j\in[J)}\|\rho_j\|_1\Big)^{1/2}.
\end{equation}
\end{proposition}
-/
theorem cauchySchwarzAtK_bound
    (n k J : ℕ) (hk : 1 ≤ k) (hkn : k < n - 1) (hJ : 1 ≤ J)
    (rho : Fin J → MKernel k) (phi : Fin J → ℝ → ℝ)
    (hrho : ∀ j, MemW0 (rho j))
    (hphi : ∀ j, MemW0 (phi j)) (i : Fin k)
    (F : Fin n → SchwartzMap (RealVector n) ℝ)
    (hF : F ∈ normalizedFunctionTuples n) :
    |prismForm n k hk (by omega)
      (cauchySchwarzKernel rho phi i) (fun a x => F a x)| ≤
      Real.sqrt |prismForm n (k + 1) (by omega) (by omega)
        (cauchySchwarzLift rho phi) (fun a x => F a x)| *
        Real.sqrt (∑ j, (eLpNorm (rho j) 1 volume).toReal) := by
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k)) :=
    isAddHaarMeasure_volume_pi (Fin k)
  let : Measure.IsAddHaarMeasure
      (volume : Measure (RealVector k × RealVector k)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let Krho : Fin J → KKernel k := fun j => mToK k hk (rho j)
  let Kabs : Fin J → KKernel k := fun j => mToK k hk (fun y => |rho j y|)
  have hKrho (j : Fin J) : MemW0 (Krho j) := by
    dsimp [Krho]
    exact mToK_memW0 n k hk (by omega) (rho j) (hrho j)
  have hKabs (j : Fin J) : MemW0 (Kabs j) := by
    dsimp [Kabs]
    exact mToK_memW0 n k hk (by omega) (fun y => |rho j y|)
      (aux_memW0_abs (hrho j))
  have hCS := singlyCancellativeCauchySchwarz_bound n k J hJ hk (by omega)
    Krho phi hKrho hphi F hF
  have hCS' :
      |prismForm n k hk (by omega)
        (cauchySchwarzKernel rho phi i) (fun a x => F a x)| ^ 2 ≤
        prismBrascampLiebForm n (k + 1) (by omega) (by omega)
          (singlyCancellativeLift k J Krho phi) (fun a x => F a x) *
          ∑ j, (eLpNorm (Krho j) 1 volume).toReal := by
    change |prismBrascampLiebForm n k hk (by omega)
      (mToK k hk (cauchySchwarzKernel rho phi i))
        (fun a x => F a x)| ^ 2 ≤ _
    rw [aux_mToK_cauchySchwarzKernel_eq_singlyCancellative k J hk rho phi hrho hphi i]
    simpa [Krho] using hCS
  have hKabs_nonneg (j : Fin J) (u : RealVector k × ℝ) : 0 ≤ Kabs j u := by
    dsimp [Kabs]
    exact aux_mToK_abs_nonnegative k hk (rho j) u
  have hKabs_ge_abs (j : Fin J) (u : RealVector k × ℝ) :
      |Krho j u| ≤ Kabs j u := by
    dsimp [Krho, Kabs]
    exact aux_abs_mToK_le_mToK_abs k hk (rho j) u
  have hMono (j : Fin J) :
      prismBrascampLiebForm n (k + 1) (by omega) (by omega)
          (monotonicityKernel k (fun u => |Krho j u|) (phi j)) (fun a x => F a x) ≤
        prismBrascampLiebForm n (k + 1) (by omega) (by omega)
          (monotonicityKernel k (Kabs j) (phi j)) (fun a x => F a x) := by
    exact monotonicityK n k hk (by omega) (fun u => |Krho j u|) (Kabs j)
      (aux_memW0_abs (hKrho j)) (hKabs j) (fun u => abs_nonneg _)
      (hKabs_ge_abs j) (phi j) (hphi j) F hF
  have hMonoLeftW (j : Fin J) :
      MemW0 (monotonicityKernel k (fun u => |Krho j u|) (phi j)) := by
    simpa [monotonicityKernel] using aux_memW0_positivityKernel k
      (fun u => |Krho j u|) (aux_memW0_abs (hKrho j)) (phi j) (hphi j) (Fin.last k)
  have hMonoRightW (j : Fin J) :
      MemW0 (monotonicityKernel k (Kabs j) (phi j)) := by
    simpa [monotonicityKernel] using aux_memW0_positivityKernel k
      (Kabs j) (hKabs j) (phi j) (hphi j) (Fin.last k)
  have hPos (j : Fin J) :
      0 ≤ prismBrascampLiebForm n (k + 1) (by omega) (by omega)
        (monotonicityKernel k (fun u => |Krho j u|) (phi j)) (fun a x => F a x) := by
    simpa [monotonicityKernel] using positivityKernel_nonnegative n k hk (by omega)
      (fun u => |Krho j u|) (aux_memW0_abs (hKrho j)) (fun u => abs_nonneg _)
      (phi j) (hphi j) (Fin.last k) F hF
  have hLiftKabs : singlyCancellativeLift k J Kabs phi = fun u =>
      ∑ j, monotonicityKernel k (Kabs j) (phi j) u := by
    rw [aux_singlyCancellativeLift_eq_sum_monotonicity]
    have habs (j : Fin J) : (fun u => |Kabs j u|) = Kabs j := by
      funext u
      exact abs_of_nonneg (hKabs_nonneg j u)
    simp_rw [habs]
  have hAeq :
      prismBrascampLiebForm n (k + 1) (by omega) (by omega)
          (singlyCancellativeLift k J Krho phi) (fun a x => F a x) =
        ∑ j, prismBrascampLiebForm n (k + 1) (by omega) (by omega)
          (monotonicityKernel k (fun u => |Krho j u|) (phi j)) (fun a x => F a x) := by
    rw [aux_singlyCancellativeLift_eq_sum_monotonicity]
    exact aux_prismBrascampLiebForm_finset_sum n (k + 1) J (by omega) (by omega)
      (fun j => monotonicityKernel k (fun u => |Krho j u|) (phi j)) hMonoLeftW F
  have hBeq :
      prismBrascampLiebForm n (k + 1) (by omega) (by omega)
          (singlyCancellativeLift k J Kabs phi) (fun a x => F a x) =
        ∑ j, prismBrascampLiebForm n (k + 1) (by omega) (by omega)
          (monotonicityKernel k (Kabs j) (phi j)) (fun a x => F a x) := by
    rw [hLiftKabs]
    exact aux_prismBrascampLiebForm_finset_sum n (k + 1) J (by omega) (by omega)
      (fun j => monotonicityKernel k (Kabs j) (phi j)) hMonoRightW F
  have hA_nonneg : 0 ≤ prismBrascampLiebForm n (k + 1) (by omega) (by omega)
      (singlyCancellativeLift k J Krho phi) (fun a x => F a x) := by
    rw [hAeq]
    exact Finset.sum_nonneg (fun j _ => hPos j)
  have hA_le_B :
      prismBrascampLiebForm n (k + 1) (by omega) (by omega)
          (singlyCancellativeLift k J Krho phi) (fun a x => F a x) ≤
        prismBrascampLiebForm n (k + 1) (by omega) (by omega)
          (singlyCancellativeLift k J Kabs phi) (fun a x => F a x) := by
    rw [hAeq, hBeq]
    exact Finset.sum_le_sum (fun j _ => hMono j)
  have hNormSum : ∑ j, (eLpNorm (Krho j) 1 volume).toReal ≤
      ∑ j, (eLpNorm (rho j) 1 volume).toReal := by
    apply Finset.sum_le_sum
    intro j _
    have hcontract : eLpNorm (Krho j) 1 volume ≤ eLpNorm (rho j) 1 volume := by
      dsimp [Krho]
      exact mToK_eLpNorm_one_le n k hk (by omega) (rho j) (hrho j)
    have htop : eLpNorm (rho j) 1 volume ≠ ∞ :=
      (memLp_one_iff_integrable.mpr
        (aux_memW0_integrable_of_addHaar (hrho j))).eLpNorm_ne_top
    exact ENNReal.toReal_mono htop hcontract
  have hMLift : mToK (k + 1) (by omega) (cauchySchwarzLift rho phi) =
      singlyCancellativeLift k J Kabs phi := by
    simpa [Kabs] using aux_mToK_cauchySchwarzLift k J hk rho phi hrho hphi
  have hB_nonneg : 0 ≤ prismBrascampLiebForm n (k + 1) (by omega) (by omega)
      (singlyCancellativeLift k J Kabs phi) (fun a x => F a x) :=
    hA_nonneg.trans hA_le_B
  have hNorm_nonneg : 0 ≤ ∑ j, (eLpNorm (Krho j) 1 volume).toReal := by
    exact Finset.sum_nonneg (fun j _ => ENNReal.toReal_nonneg)
  have hSquareB :
      |prismForm n k hk (by omega)
        (cauchySchwarzKernel rho phi i) (fun a x => F a x)| ^ 2 ≤
        prismBrascampLiebForm n (k + 1) (by omega) (by omega)
          (singlyCancellativeLift k J Kabs phi) (fun a x => F a x) *
            ∑ j, (eLpNorm (rho j) 1 volume).toReal := by
    calc
      |prismForm n k hk (by omega)
        (cauchySchwarzKernel rho phi i) (fun a x => F a x)| ^ 2 ≤
          prismBrascampLiebForm n (k + 1) (by omega) (by omega)
            (singlyCancellativeLift k J Krho phi) (fun a x => F a x) *
              ∑ j, (eLpNorm (Krho j) 1 volume).toReal := hCS'
      _ ≤ prismBrascampLiebForm n (k + 1) (by omega) (by omega)
            (singlyCancellativeLift k J Kabs phi) (fun a x => F a x) *
              ∑ j, (eLpNorm (Krho j) 1 volume).toReal :=
          mul_le_mul_of_nonneg_right hA_le_B hNorm_nonneg
      _ ≤ prismBrascampLiebForm n (k + 1) (by omega) (by omega)
            (singlyCancellativeLift k J Kabs phi) (fun a x => F a x) *
              ∑ j, (eLpNorm (rho j) 1 volume).toReal :=
          mul_le_mul_of_nonneg_left hNormSum hB_nonneg
  have hSquare :
      |prismForm n k hk (by omega)
        (cauchySchwarzKernel rho phi i) (fun a x => F a x)| ^ 2 ≤
      prismForm n (k + 1) (by omega) (by omega)
          (cauchySchwarzLift rho phi) (fun a x => F a x) *
            ∑ j, (eLpNorm (rho j) 1 volume).toReal := by
    change _ ≤ prismBrascampLiebForm n (k + 1) (by omega) (by omega)
      (mToK (k + 1) (by omega) (cauchySchwarzLift rho phi)) (fun a x => F a x) * _
    rw [hMLift]
    exact hSquareB
  have hLiftM_nonneg : 0 ≤ prismForm n (k + 1) (by omega) (by omega)
      (cauchySchwarzLift rho phi) (fun a x => F a x) := by
    change 0 ≤ prismBrascampLiebForm n (k + 1) (by omega) (by omega)
      (mToK (k + 1) (by omega) (cauchySchwarzLift rho phi)) (fun a x => F a x)
    rw [hMLift]
    exact hB_nonneg
  have hTarget_nonneg : 0 ≤
      Real.sqrt |prismForm n (k + 1) (by omega) (by omega)
        (cauchySchwarzLift rho phi) (fun a x => F a x)| *
        Real.sqrt (∑ j, (eLpNorm (rho j) 1 volume).toReal) :=
    mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
  have hTarget_sq :
      (Real.sqrt |prismForm n (k + 1) (by omega) (by omega)
        (cauchySchwarzLift rho phi) (fun a x => F a x)| *
        Real.sqrt (∑ j, (eLpNorm (rho j) 1 volume).toReal)) ^ 2 =
        prismForm n (k + 1) (by omega) (by omega)
          (cauchySchwarzLift rho phi) (fun a x => F a x) *
            ∑ j, (eLpNorm (rho j) 1 volume).toReal := by
    rw [mul_pow, Real.sq_sqrt (abs_nonneg _), Real.sq_sqrt (by positivity)]
    rw [abs_of_nonneg hLiftM_nonneg]
  apply (sq_le_sq₀ (abs_nonneg _) hTarget_nonneg).mp
  rw [hTarget_sq]
  exact hSquare

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at n-1}, formalized as
`cauchySchwarzAtNMinusOne`. -/
theorem aux_measurePreserving_scalarCauchyShear :
    MeasurePreserving (fun p : ℝ × ℝ => (p.2, p.1 - p.2)) volume volume := by
  have hswap : MeasurePreserving
      (Prod.swap : ℝ × ℝ → ℝ × ℝ) volume volume := by
    exact aux_volume_preserving_prod_swap (volume : Measure ℝ) (volume : Measure ℝ)
  have hshear : MeasurePreserving (fun p : ℝ × ℝ => (p.1, p.2 - p.1)) volume volume := by
    change MeasurePreserving (fun p : ℝ × ℝ => (p.1, p.2 - p.1))
      ((volume : Measure ℝ).prod (volume : Measure ℝ))
      ((volume : Measure ℝ).prod (volume : Measure ℝ))
    refine MeasurePreserving.skew_product
      (μa := (volume : Measure ℝ)) (μb := (volume : Measure ℝ))
      (μc := (volume : Measure ℝ)) (μd := (volume : Measure ℝ))
      (f := id) (g := fun p t => t - p)
      (MeasurePreserving.id (volume : Measure ℝ)) ?_ ?_
    · exact (continuous_snd.sub continuous_fst).measurable
    · filter_upwards [] with p
      simpa [sub_eq_add_neg] using
        (measurePreserving_add_right (volume : Measure ℝ) (-p)).map_eq
  change MeasurePreserving (fun p : ℝ × ℝ => (p.2, p.1 - p.2)) volume volume
  exact hshear.comp hswap

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at n-1}, formalized as
`cauchySchwarzAtNMinusOne`. -/
theorem aux_realConvolution_to_doubleIntegral
    (k : ℕ) (rho : KKernel k) (hrho : MemW0 rho)
    (phi : ℝ → ℝ) (hphi : MemW0 phi) (u : RealVector k × ℝ) :
    (∫ q : ℝ, rho (u.1, u.2 - q) * realConvolution phi phi q) =
      ∫ r : ℝ, ∫ s : ℝ, rho (u.1, u.2 - r - s) * phi r * phi s := by
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k)) :=
    isAddHaarMeasure_volume_pi (Fin k)
  let : NormedSpace ℝ (RealVector k) := Pi.normedSpace
  let : Measure.IsAddHaarMeasure (volume : Measure (RealVector k × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure (volume : Measure (ℝ × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure ((RealVector k × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure ((RealVector k × ℝ) × (ℝ × ℝ))) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let : Measure.IsAddHaarMeasure
      (volume : Measure (((RealVector k × ℝ) × ℝ) × ℝ)) :=
    Measure.prod.instIsAddHaarMeasure _ _
  let E : ((RealVector k × ℝ) × ℝ) × ℝ → ℝ :=
    aux_doublyCancellativeCSExpandedKernel k rho phi
  have hE : MemW0 E := by
    simpa [E] using aux_memW0_doublyCancellativeCSExpandedKernel k rho hrho phi hphi
  let assoc :=
    (ContinuousLinearEquiv.prodAssoc ℝ (RealVector k × ℝ) ℝ ℝ).symm
  let H : ℝ × ℝ → ℝ := fun rs =>
    rho (u.1, u.2 - rs.1 - rs.2) * phi rs.1 * phi rs.2
  let shear : ℝ × ℝ ≃ᵐ ℝ × ℝ :=
    { toFun := fun p => (p.2, p.1 - p.2)
      invFun := fun p => (p.1 + p.2, p.1)
      left_inv := by
        intro p
        rcases p with ⟨q, r⟩
        ext <;> ring
      right_inv := by
        intro p
        rcases p with ⟨r, s⟩
        ext <;> ring
      measurable_toFun := measurable_snd.prodMk (measurable_fst.sub measurable_snd)
      measurable_invFun := (measurable_fst.add measurable_snd).prodMk measurable_fst }
  have hShear : MeasurePreserving shear volume volume := by
    change MeasurePreserving (fun p : ℝ × ℝ => (p.2, p.1 - p.2)) volume volume
    exact aux_measurePreserving_scalarCauchyShear
  have hH_w0 : MemW0 H := by
    have hEA : MemW0 (E ∘ assoc) :=
      aux_memW0_comp_continuousLinearEquiv hE assoc
    have hSlice := hEA.aux_memW0_slice_of_addHaar u
    convert hSlice using 1
    funext rs
    rcases rs with ⟨r, s⟩
    rfl
  have hH : Integrable H :=
    aux_memW0_integrable_of_addHaar hH_w0
  let G : ℝ × ℝ → ℝ := fun qr =>
    rho (u.1, u.2 - qr.1) * phi (qr.1 - qr.2) * phi qr.2
  have hG_eq : G = H ∘ shear := by
    funext qr
    rcases qr with ⟨q, r⟩
    simp [G, H, shear]
    ring
  have hG : Integrable G := by
    rw [hG_eq]
    exact hShear.integrable_comp_of_integrable hH
  have hLeft :
      (∫ q : ℝ, rho (u.1, u.2 - q) * realConvolution phi phi q) =
        ∫ q : ℝ, ∫ r : ℝ, G (q, r) := by
    apply integral_congr_ae
    filter_upwards [] with q
    unfold realConvolution
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards [] with r
    dsimp [G]
    ring
  have hG_fubini : (∫ q : ℝ, ∫ r : ℝ, G (q, r)) = ∫ qr : ℝ × ℝ, G qr := by
    simpa only [Measure.volume_eq_prod] using (integral_prod G hG).symm
  have hChange : (∫ qr : ℝ × ℝ, G qr) = ∫ rs : ℝ × ℝ, H rs := by
    rw [hG_eq]
    exact hShear.integral_comp' H
  have hH_fubini : (∫ rs : ℝ × ℝ, H rs) = ∫ r : ℝ, ∫ s : ℝ, H (r, s) := by
    simpa only [Measure.volume_eq_prod] using integral_prod H hH
  calc
    (∫ q : ℝ, rho (u.1, u.2 - q) * realConvolution phi phi q) =
        ∫ q : ℝ, ∫ r : ℝ, G (q, r) := hLeft
    _ = ∫ qr : ℝ × ℝ, G qr := hG_fubini
    _ = ∫ rs : ℝ × ℝ, H rs := hChange
    _ = ∫ r : ℝ, ∫ s : ℝ, H (r, s) := hH_fubini
    _ = ∫ r : ℝ, ∫ s : ℝ, rho (u.1, u.2 - r - s) * phi r * phi s := by rfl

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at n-1}, formalized as
`cauchySchwarzAtNMinusOne`. -/
theorem aux_mToK_doublyCauchySchwarzKernel
    (k J : ℕ) (hk : 1 ≤ k) (rho : Fin J → MKernel k)
    (phi : Fin J → ℝ → ℝ) (hrho : ∀ j, MemW0 (rho j))
    (hphi : ∀ j, MemW0 (phi j)) (i : Fin k) :
    mToK k hk (doublyCauchySchwarzKernel rho phi i) =
      doublyCancellativeKernel (k + 1) J (fun j => mToK k hk (rho j)) phi := by
  let psi : Fin J → ℝ → ℝ := fun j => realConvolution (phi j) (phi j)
  have hpsi (j : Fin J) : MemW0 (psi j) :=
    aux_realConvolution_memW0 (phi j) (phi j) (hphi j) (hphi j)
  have hK (j : Fin J) : MemW0 (mToK k hk (rho j)) :=
    mToK_memW0 k k hk le_rfl (rho j) (hrho j)
  calc
    mToK k hk (doublyCauchySchwarzKernel rho phi i) =
        mToK k hk (cauchySchwarzKernel rho psi i) := by rfl
    _ = singlyCancellativeKernel k J (fun j => mToK k hk (rho j)) psi :=
      aux_mToK_cauchySchwarzKernel_eq_singlyCancellative k J hk rho psi hrho hpsi i
    _ = doublyCancellativeKernel (k + 1) J (fun j => mToK k hk (rho j)) phi := by
      funext u
      unfold singlyCancellativeKernel doublyCancellativeKernel
      apply Finset.sum_congr rfl
      intro j _
      exact aux_realConvolution_to_doubleIntegral k (mToK k hk (rho j))
        (hK j) (phi j) (hphi j) u

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at n-1}, formalized as
`cauchySchwarzAtNMinusOne`. -/
theorem aux_mToK_cauchySchwarzLift_eq_doublyCancellativeLift
    (k J : ℕ) (hk : 1 ≤ k) (rho : Fin J → MKernel k)
    (phi : Fin J → ℝ → ℝ) (hrho : ∀ j, MemW0 (rho j))
    (hphi : ∀ j, MemW0 (phi j)) :
    mToK (k + 1) (by omega) (cauchySchwarzLift rho phi) =
      doublyCancellativeLift (k + 1) J (by omega)
        (fun j => mToK k hk (fun y => |rho j y|)) phi := by
  calc
    mToK (k + 1) (by omega) (cauchySchwarzLift rho phi) =
        singlyCancellativeLift k J
          (fun j => mToK k hk (fun y => |rho j y|)) phi :=
      aux_mToK_cauchySchwarzLift k J hk rho phi hrho hphi
    _ = doublyCancellativeLift (k + 1) J (by omega)
          (fun j => mToK k hk (fun y => |rho j y|)) phi :=
      (aux_doublyCancellativeLift_eq_singlyCancellativeLift k J
        (fun j => mToK k hk (fun y => |rho j y|)) phi).symm

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at n-1}, formalized as
`cauchySchwarzAtNMinusOne`. -/
theorem aux_doublyCancellativeLift_eq_sum_monotonicity
    (k J : ℕ) (rho : Fin J → KKernel k) (phi : Fin J → ℝ → ℝ) :
    doublyCancellativeLift (k + 1) J (by omega) rho phi = fun u =>
      ∑ j, monotonicityKernel k (fun v => |rho j v|) (phi j) u := by
  calc
    doublyCancellativeLift (k + 1) J (by omega) rho phi =
        singlyCancellativeLift k J rho phi :=
      aux_doublyCancellativeLift_eq_singlyCancellativeLift k J rho phi
    _ = fun u => ∑ j, monotonicityKernel k (fun v => |rho j v|) (phi j) u :=
      aux_singlyCancellativeLift_eq_sum_monotonicity k J rho phi

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at n-1}, formalized as
`cauchySchwarzAtNMinusOne`. -/
theorem aux_doublyCancellativeLift_prism_le
    (n J : ℕ) (hn : 2 ≤ n) (rho rhotilde : Fin J → KKernel (n - 1))
    (phi : Fin J → ℝ → ℝ) (hrho : ∀ j, MemW0 (rho j))
    (hrhotilde : ∀ j, MemW0 (rhotilde j)) (hphi : ∀ j, MemW0 (phi j))
    (hle : ∀ j u, |rho j u| ≤ |rhotilde j u|)
    (F : Fin n → SchwartzMap (RealVector n) ℝ)
    (hF : F ∈ normalizedFunctionTuples n) :
    prismBrascampLiebForm n n (by omega) le_rfl
      (doublyCancellativeLift n J (by omega) rho phi) (fun i x => F i x) ≤
      prismBrascampLiebForm n n (by omega) le_rfl
        (doublyCancellativeLift n J (by omega) rhotilde phi) (fun i x => F i x) := by
  cases n with
  | zero => omega
  | succ k =>
    simp only [Nat.succ_sub_one] at rho rhotilde hrho hrhotilde hle ⊢
    let A : Fin J → KKernel (k + 1) := fun j =>
      monotonicityKernel k (fun u => |rho j u|) (phi j)
    let B : Fin J → KKernel (k + 1) := fun j =>
      monotonicityKernel k (fun u => |rhotilde j u|) (phi j)
    have hA (j : Fin J) : MemW0 (A j) := by
      simpa [A, monotonicityKernel] using aux_memW0_positivityKernel k
        (fun u => |rho j u|) (aux_memW0_abs (hrho j)) (phi j) (hphi j) (Fin.last k)
    have hB (j : Fin J) : MemW0 (B j) := by
      simpa [B, monotonicityKernel] using aux_memW0_positivityKernel k
        (fun u => |rhotilde j u|) (aux_memW0_abs (hrhotilde j)) (phi j) (hphi j) (Fin.last k)
    have hMono (j : Fin J) :
        prismBrascampLiebForm (k + 1) (k + 1) (by omega) le_rfl
            (A j) (fun i x => F i x) ≤
          prismBrascampLiebForm (k + 1) (k + 1) (by omega) le_rfl
            (B j) (fun i x => F i x) := by
      simpa [A, B] using monotonicityK (k + 1) k (by omega) (by omega)
        (fun u => |rho j u|) (fun u => |rhotilde j u|)
        (aux_memW0_abs (hrho j)) (aux_memW0_abs (hrhotilde j))
        (fun u => abs_nonneg _) (hle j) (phi j) (hphi j) F hF
    rw [aux_doublyCancellativeLift_eq_sum_monotonicity k J rho phi]
    rw [aux_doublyCancellativeLift_eq_sum_monotonicity k J rhotilde phi]
    change prismBrascampLiebForm (k + 1) (k + 1) (by omega) le_rfl
        (fun u => ∑ j, A j u) (fun i x => F i x) ≤
      prismBrascampLiebForm (k + 1) (k + 1) (by omega) le_rfl
        (fun u => ∑ j, B j u) (fun i x => F i x)
    rw [aux_prismBrascampLiebForm_finset_sum (k + 1) (k + 1) J
      (by omega) le_rfl A hA F]
    rw [aux_prismBrascampLiebForm_finset_sum (k + 1) (k + 1) J
      (by omega) le_rfl B hB F]
    exact Finset.sum_le_sum fun j _ => hMono j

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at n-1}, formalized as
`cauchySchwarzAtNMinusOne`. -/
theorem aux_doublyCancellativeLift_prism_nonnegative
    (n J : ℕ) (hn : 2 ≤ n) (rho : Fin J → KKernel (n - 1))
    (phi : Fin J → ℝ → ℝ) (hrho : ∀ j, MemW0 (rho j))
    (hphi : ∀ j, MemW0 (phi j))
    (F : Fin n → SchwartzMap (RealVector n) ℝ)
    (hF : F ∈ normalizedFunctionTuples n) :
    0 ≤ prismBrascampLiebForm n n (by omega) le_rfl
      (doublyCancellativeLift n J (by omega) rho phi) (fun i x => F i x) := by
  cases n with
  | zero => omega
  | succ k =>
    simp only [Nat.succ_sub_one] at rho hrho ⊢
    let A : Fin J → KKernel (k + 1) := fun j =>
      monotonicityKernel k (fun u => |rho j u|) (phi j)
    have hA (j : Fin J) : MemW0 (A j) := by
      simpa [A, monotonicityKernel] using aux_memW0_positivityKernel k
        (fun u => |rho j u|) (aux_memW0_abs (hrho j)) (phi j) (hphi j) (Fin.last k)
    have hPos (j : Fin J) : 0 ≤
        prismBrascampLiebForm (k + 1) (k + 1) (by omega) le_rfl
          (A j) (fun i x => F i x) := by
      simpa [A, monotonicityKernel] using positivityKernel_nonnegative
        (k + 1) k (by omega) (by omega) (fun u => |rho j u|)
          (aux_memW0_abs (hrho j)) (fun u => abs_nonneg _) (phi j) (hphi j)
          (Fin.last k) F hF
    rw [aux_doublyCancellativeLift_eq_sum_monotonicity k J rho phi]
    change 0 ≤ prismBrascampLiebForm (k + 1) (k + 1) (by omega) le_rfl
      (fun u => ∑ j, A j u) (fun i x => F i x)
    rw [aux_prismBrascampLiebForm_finset_sum (k + 1) (k + 1) J
      (by omega) le_rfl A hA F]
    exact Finset.sum_nonneg fun j _ => hPos j

/-- Auxiliary for Proposition \ref{Cauchy-Schwarz at n-1}, formalized as
`cauchySchwarzAtNMinusOne`. -/
theorem aux_doublyCancellativeLift_sSup_le
    (n J : ℕ) (hn : 2 ≤ n) (hJ : 1 ≤ J)
    (rho rhotilde : Fin J → KKernel (n - 1))
    (phi : Fin J → ℝ → ℝ) (hrho : ∀ j, MemW0 (rho j))
    (hrhotilde : ∀ j, MemW0 (rhotilde j)) (hphi : ∀ j, MemW0 (phi j))
    (hle : ∀ j u, |rho j u| ≤ |rhotilde j u|)
    (F0 : Fin n → SchwartzMap (RealVector n) ℝ)
    (hF0 : F0 ∈ normalizedFunctionTuples n) :
    sSup (Set.range (fun G : NormalizedFunctionTuple n =>
      |prismBrascampLiebForm n n (by omega) le_rfl
        (doublyCancellativeLift n J (by omega) rho phi) (fun i x => G.1 i x)|)) ≤
      sSup (Set.range (fun G : NormalizedFunctionTuple n =>
        |prismBrascampLiebForm n n (by omega) le_rfl
          (doublyCancellativeLift n J (by omega) rhotilde phi) (fun i x => G.1 i x)|)) := by
  have hBdd := aux_bddAbove_doublyCancellativeLift_prismForms n J (by omega) hJ
    rhotilde phi hrhotilde hphi
  apply csSup_le
  · exact ⟨_, ⟨⟨F0, hF0⟩, rfl⟩⟩
  rintro _ ⟨G, rfl⟩
  have hLeftNonneg := aux_doublyCancellativeLift_prism_nonnegative n J hn
    rho phi hrho hphi G.1 G.2
  have hRightNonneg := aux_doublyCancellativeLift_prism_nonnegative n J hn
    rhotilde phi hrhotilde hphi G.1 G.2
  have hPoint := aux_doublyCancellativeLift_prism_le n J hn rho rhotilde phi
    hrho hrhotilde hphi hle G.1 G.2
  calc
    |prismBrascampLiebForm n n (by omega) le_rfl
        (doublyCancellativeLift n J (by omega) rho phi) (fun i x => G.1 i x)| =
        prismBrascampLiebForm n n (by omega) le_rfl
          (doublyCancellativeLift n J (by omega) rho phi) (fun i x => G.1 i x) :=
      abs_of_nonneg hLeftNonneg
    _ ≤ prismBrascampLiebForm n n (by omega) le_rfl
          (doublyCancellativeLift n J (by omega) rhotilde phi) (fun i x => G.1 i x) := hPoint
    _ = |prismBrascampLiebForm n n (by omega) le_rfl
          (doublyCancellativeLift n J (by omega) rhotilde phi) (fun i x => G.1 i x)| :=
      (abs_of_nonneg hRightNonneg).symm
    _ ≤ sSup (Set.range (fun G : NormalizedFunctionTuple n =>
          |prismBrascampLiebForm n n (by omega) le_rfl
            (doublyCancellativeLift n J (by omega) rhotilde phi)
              (fun i x => G.1 i x)|)) :=
      le_csSup hBdd ⟨G, rfl⟩

/--
\begin{equation}
|\Lambda_{n-1}(M)(\F)| \le
  \sup_{\mathbf{\tilde{F}}\in\mathfrak{F}}|\Lambda_{n}(\tilde{M})(\mathbf{\tilde{F}})|.
\end{equation}
-/
theorem cauchySchwarzAtNMinusOne_bound
    (k J : ℕ) (hk : 1 ≤ k) (hJ : 1 ≤ J)
    (rho : Fin J → MKernel k) (phi : Fin J → ℝ → ℝ)
    (hrho : ∀ j, MemW0 (rho j)) (hphi : ∀ j, MemW0 (phi j))
    (i : Fin k) (F : Fin (k + 1) → SchwartzMap (RealVector (k + 1)) ℝ)
    (hF : F ∈ normalizedFunctionTuples (k + 1)) :
    |prismForm (k + 1) k hk (by omega)
      (doublyCauchySchwarzKernel rho phi i) (fun a x => F a x)| ≤
      sSup (Set.range (fun G : NormalizedFunctionTuple (k + 1) =>
        |prismForm (k + 1) (k + 1) (by omega) le_rfl
          (cauchySchwarzLift rho phi) (fun a x => G.1 a x)|)) := by
  let Krho : Fin J → KKernel k := fun j => mToK k hk (rho j)
  let Kabs : Fin J → KKernel k := fun j => mToK k hk (fun y => |rho j y|)
  have hKrho (j : Fin J) : MemW0 (Krho j) := by
    dsimp [Krho]
    exact mToK_memW0 (k + 1) k hk (by omega) (rho j) (hrho j)
  have hKabs (j : Fin J) : MemW0 (Kabs j) := by
    dsimp [Kabs]
    exact mToK_memW0 (k + 1) k hk (by omega) (fun y => |rho j y|)
      (aux_memW0_abs (hrho j))
  have hKabs_nonneg (j : Fin J) (u : RealVector k × ℝ) : 0 ≤ Kabs j u := by
    dsimp [Kabs]
    exact aux_mToK_abs_nonnegative k hk (rho j) u
  have hle (j : Fin J) (u : RealVector k × ℝ) :
      |Krho j u| ≤ |Kabs j u| := by
    calc
      |Krho j u| ≤ Kabs j u := by
        dsimp [Krho, Kabs]
        exact aux_abs_mToK_le_mToK_abs k hk (rho j) u
      _ = |Kabs j u| := (abs_of_nonneg (hKabs_nonneg j u)).symm
  have hKernelTransport := aux_mToK_doublyCauchySchwarzKernel k J hk rho phi hrho hphi i
  have hLiftTransport :=
    aux_mToK_cauchySchwarzLift_eq_doublyCancellativeLift k J hk rho phi hrho hphi
  have hKbound := doublyCancellativeCauchySchwarz_bound (k + 1) J (by omega) hJ
    Krho phi hKrho hphi F hF
  have hSup := aux_doublyCancellativeLift_sSup_le (k + 1) J (by omega) hJ
    Krho Kabs phi hKrho hKabs hphi hle F hF
  calc
    |prismForm (k + 1) k hk (by omega)
        (doublyCauchySchwarzKernel rho phi i) (fun a x => F a x)| =
        |prismBrascampLiebForm (k + 1) k hk (by omega)
          (doublyCancellativeKernel (k + 1) J Krho phi) (fun a x => F a x)| := by
      unfold prismForm
      rw [hKernelTransport]
    _ ≤ sSup (Set.range (fun G : NormalizedFunctionTuple (k + 1) =>
        |prismBrascampLiebForm (k + 1) (k + 1) (by omega) le_rfl
          (doublyCancellativeLift (k + 1) J (by omega) Krho phi)
          (fun a x => G.1 a x)|)) := hKbound
    _ ≤ sSup (Set.range (fun G : NormalizedFunctionTuple (k + 1) =>
        |prismBrascampLiebForm (k + 1) (k + 1) (by omega) le_rfl
          (doublyCancellativeLift (k + 1) J (by omega) Kabs phi)
          (fun a x => G.1 a x)|)) := hSup
    _ = sSup (Set.range (fun G : NormalizedFunctionTuple (k + 1) =>
        |prismForm (k + 1) (k + 1) (by omega) le_rfl
          (cauchySchwarzLift rho phi) (fun a x => G.1 a x)|)) := by
      congr 1
      funext G
      unfold prismForm
      rw [hLiftTransport]

/--
\begin{proposition}[Cauchy-Schwarz at $n-1$]\label{Cauchy-Schwarz at n-1}
Let $J\in\N_{>0}$ and for $j\in [J)$, let 
$\rho_j\in W_0((\R^2)^{n-1})$  and $\varphi_j\in W_0(\R)$ be real valued.
Let $i \in [n-1)$.
Define
\begin{equation}\label{before CS 2}
    M=\sum_{j\in [J)} \rho_j *_{e_i^0+e_i^1} (\varphi_j * \varphi_j),
\end{equation}
and for $y\in (\R^2)^n$,
\begin{equation}
    \tilde{M}(y)=\sum_{j\in [J)} |\rho_j(y_{[n-1)})| \varphi_j^{\otimes 2}(y_{n-1}).
\end{equation}
Then $M\in W_0((\R^2)^{n-1})$ and $\tilde{M}\in W_0((\R^2)^n)$ and for all $\F\in\mathfrak{F}$
\begin{equation}
|\Lambda_{n-1}(M)(\F)| \le
  \sup_{\mathbf{\tilde{F}}\in\mathfrak{F}}|\Lambda_{n}(\tilde{M})(\mathbf{\tilde{F}})|.
\end{equation}
\end{proposition}
-/
theorem cauchySchwarzAtNMinusOne
    (k J : ℕ) (hk : 1 ≤ k) (hJ : 1 ≤ J)
    (rho : Fin J → MKernel k) (phi : Fin J → ℝ → ℝ)
    (hrho : ∀ j, MemW0 (rho j)) (hphi : ∀ j, MemW0 (phi j))
    (i : Fin k) (F : Fin (k + 1) → SchwartzMap (RealVector (k + 1)) ℝ)
    (hF : F ∈ normalizedFunctionTuples (k + 1)) :
    MemW0 (doublyCauchySchwarzKernel rho phi i) ∧
      MemW0 (cauchySchwarzLift rho phi) ∧
      |prismForm (k + 1) k hk (by omega)
        (doublyCauchySchwarzKernel rho phi i) (fun a x => F a x)| ≤
        sSup (Set.range (fun G : NormalizedFunctionTuple (k + 1) =>
          |prismForm (k + 1) (k + 1) (by omega) le_rfl
            (cauchySchwarzLift rho phi) (fun a x => G.1 a x)|)) := by
  refine ⟨?_, ?_, cauchySchwarzAtNMinusOne_bound k J hk hJ rho phi
    hrho hphi i F hF⟩
  · exact doublyCauchySchwarzKernel_memW0 (k + 1) J (by omega) hJ rho phi hrho hphi i
  · exact cauchySchwarzLift_memW0 k J rho phi hrho hphi

end

