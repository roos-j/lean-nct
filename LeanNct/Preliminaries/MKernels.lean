    have hInt := aux_memW0_integrable_of_addHaar
      (E := RealVector (d + 1)) (K := ℝ) hW
    simpa [A] using hInt
  let B : ℝ × RealVector d → ℝ := A ∘ e.symm
  have hB : Integrable B := by
    exact hEinv.integrable_comp_of_integrable hA
  have hB_eq (q : ℝ) (r : RealVector d) :
      B (q, r) =
        tildeM (mToKPoint (d + 1) (by omega)
          (eraseVector (Fin.last (d + 1)) z.1, z.2 - q) r) *
          phi (z.1 (Fin.last (d + 1)) + q) * phi q := by
    change tensorSquareExtension (d + 1 + 1) (by omega) (Fin.last (d + 1)) tildeM phi
      (mToKPoint (d + 1 + 1) (by omega) z (e.symm (q, r))) = _
    have hErase (x : RealVector (d + 1 + 1)) :
        aux_eraseVector (d + 1 + 1) (by omega) (Fin.last (d + 1)) x =
          eraseVector (Fin.last (d + 1)) x := by
      funext a
      simp [aux_eraseVector, eraseVector]
    have herase :
        (eraseVector (Fin.last (d + 1))
            (mToKPoint (d + 1 + 1) (by omega) z (e.symm (q, r))).1,
          eraseVector (Fin.last (d + 1))
            (mToKPoint (d + 1 + 1) (by omega) z (e.symm (q, r))).2) =
          mToKPoint (d + 1) (by omega)
            (eraseVector (Fin.last (d + 1)) z.1, z.2 - q) r := by
      simpa [e] using aux_mToKPoint_erase_last d z q r
    have hat :
        ((mToKPoint (d + 1 + 1) (by omega) z (e.symm (q, r))).1 (Fin.last (d + 1)),
          (mToKPoint (d + 1 + 1) (by omega) z (e.symm (q, r))).2 (Fin.last (d + 1))) =
