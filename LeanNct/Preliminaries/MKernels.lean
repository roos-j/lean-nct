noncomputable def aux_baseReorderOne (n : ℕ) :
    ((RealVector 1 × RealVector 1) × RealVector (n - 1 + 1)) ≃ᵐ
      (RealVector (n - 1 + 1) × (ℝ × ℝ)) :=
  (MeasurableEquiv.prodComm :
    ((RealVector 1 × RealVector 1) × RealVector (n - 1 + 1)) ≃ᵐ
      (RealVector (n - 1 + 1) × (RealVector 1 × RealVector 1))).trans
  (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (RealVector (n - 1 + 1)))
    (MeasurableEquiv.prodCongr
      (MeasurableEquiv.piUnique (fun _ : Fin 1 => ℝ))
      (MeasurableEquiv.piUnique (fun _ : Fin 1 => ℝ))))

