  have hFubini :
      (∫ q : ℝ, ∫ r : RealVector d, B (q, r)) = ∫ qr : ℝ × RealVector d, B qr := by
    simpa only [Measure.volume_eq_prod] using (integral_prod B hB).symm
  change (∫ p : RealVector (d + 1), A p) = ∫ q : ℝ,
    (∫ r : RealVector d,
      tildeM (mToKPoint (d + 1) (by omega)
        (eraseVector (Fin.last (d + 1)) z.1, z.2 - q) r)) *
        phi (z.1 (Fin.last (d + 1)) + q) * phi q
  calc
    (∫ p : RealVector (d + 1), A p) = ∫ p : RealVector (d + 1), B (e p) := by
      apply integral_congr_ae
